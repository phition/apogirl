/* 〈마지막 학기〉 그레이박스 테마 — 낮은 채도, 어두운 바탕 (문서 2장) */

:root {
    --bg: #1d1f22;
    --panel: #272a2e;
    --panel-light: #33373c;
    --line: #444950;
    --text: #e4e1da;
    --text-dim: #8d8a84;
    --accent: #b9a37a;
    --accent-soft: #5b5242;
    --warn: #d0894f;
    --danger: #c9584f;
    --ok: #7fa37a;
    --locked: #3a3f55;
}

.hidden {
    display: none;
}

.screen {
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    padding: 12px;
}

.font-small { font-size: 14px; }
.font-normal { font-size: 17px; }
.font-large { font-size: 21px; }

Label { color: var(--text); white-space: normal; }

Button {
    background-color: var(--panel-light);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 4px;
    color: var(--text);
    -unity-font-style: normal;
    padding: 4px 10px;
    margin: 2px;
}

Button:hover { background-color: #3f444a; }
Button:disabled { opacity: 0.45; }
Button.selected { border-color: var(--accent); background-color: var(--accent-soft); }

.panel {
    background-color: var(--panel);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
}

/* ── 허브: 다섯 겹 (Docs/UI_REDESIGN_PROPOSAL.md) ── */
.screen.hub { padding: 0; }

/* 0겹 장면: 화면 전체 */
.scene { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: #2b2e30;
    align-items: center;
    justify-content: center;
}
.backdrop-label { color: var(--text-dim); }
/* 장면의 아래쪽을 어둡게 눌러 1겹 글자가 읽히게 */
.scene-shade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 40%;
    background-color: rgba(8, 9, 12, 0.35);
}

/* 1겹: 위쪽 띠 */
.hud-top {
    position: absolute; left: 0; top: 0; right: 0;
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 14px;
    background-color: rgba(18, 19, 22, 0.82);
    border-bottom-width: 1px;
    border-color: rgba(185, 163, 122, 0.25);
}
.calendar { -unity-font-style: bold; font-size: 20px; min-width: 300px; }
.resources { flex-direction: row; flex-grow: 1; flex-shrink: 1; align-items: center; overflow: hidden; }
.resource { margin-right: 16px; }
.blackout { color: var(--warn); -unity-font-style: bold; }
.hud-button { min-width: 84px; height: 34px; background-color: rgba(51, 55, 60, 0.9); }
.hud-button.selected { background-color: var(--accent-soft); border-color: var(--accent); }

/* 1겹: 주인공 입상 + 생명 수치 요약 (왼쪽 아래) */
.standing-area {
    position: absolute; left: 18px; bottom: 96px;
    flex-direction: row;
    align-items: flex-end;
}
.standing {
    width: 380px;
    height: 600px;
}
.standing.fallback {
    width: 300px;
    height: 400px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(185, 163, 122, 0.45);
    background-color: rgba(18, 19, 22, 0.6);
}
.standing-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.vitals-mini {
    width: 230px;
    margin-left: 10px;
    margin-bottom: 4px;
    padding: 8px 10px;
    background-color: rgba(18, 19, 22, 0.78);
    border-radius: 6px;
}
.vitals-mini .vital-bar { height: 20px; margin: 2px 0; }
.vitals-mini .unity-progress-bar__title { font-size: 14px; }
.mini-flag { color: var(--danger); font-size: 14px; margin-top: 2px; }
.mini-flag.warn { color: var(--warn); }

/* 1겹: 선생님 한마디 (오른쪽 아래) */
.teacher-box {
    position: absolute; right: 18px; bottom: 96px;
    width: 560px;
    min-height: 92px;
    padding: 12px 96px 12px 16px;
    background-color: rgba(24, 26, 30, 0.88);
    border-radius: 8px;
    border-left-width: 4px;
    border-color: var(--accent);
}
.teacher-name { -unity-font-style: bold; color: var(--accent); }
.teacher-line { margin-top: 4px; }
.teacher-avatar { position: absolute; right: 12px; top: 12px; width: 70px; height: 70px; }

/* 1겹: 실행 중 흘러가는 결과 한 줄 */
.ticker {
    position: absolute; left: 30%; right: 30%; top: 72px;
    align-items: center;
}
.ticker-line {
    margin: 3px 0;
    padding: 6px 16px;
    background-color: rgba(18, 19, 22, 0.86);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(185, 163, 122, 0.35);
    -unity-text-align: middle-center;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}
.ticker-line.great { border-color: var(--accent); color: #f0dfb8; }
.ticker-line.fail { border-color: var(--danger); }
.ticker-line.fading { opacity: 0; translate: 0 -10px; }

/* 1겹: 맨 아래 14칸 도크 */
.dock {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 84px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    background-color: rgba(18, 19, 22, 0.92);
    border-top-width: 1px;
    border-color: rgba(185, 163, 122, 0.25);
}
.dock-plan { width: 140px; height: 58px; -unity-font-style: bold; }
.dock-plan.selected { background-color: var(--accent-soft); border-color: var(--accent); }
.dock-slots { flex-direction: row; flex-grow: 1; height: 66px; margin: 0 10px; }
.dock-day { flex-grow: 1; flex-basis: 0; margin: 0 3px; }
.dock-day-label { font-size: 13px; color: var(--text-dim); -unity-text-align: middle-center; height: 16px; }
.dock-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin: 1px 0;
    padding: 0 4px;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    border-radius: 3px;
    background-color: rgba(51, 55, 60, 0.85);
    border-width: 0;
    color: var(--text);
}
.dock-cell.night { background-color: rgba(38, 42, 62, 0.9); }
.dock-cell.empty { color: var(--text-dim); }
.dock-cell.locked { background-color: var(--locked); }
.dock-cell.forced { border-width: 1px; border-color: var(--warn); }
.dock-cell.warned { border-width: 1px; border-color: var(--danger); }
.dock-cell.done { opacity: 0.4; }
.dock-cell.current { border-width: 2px; border-color: var(--accent); background-color: var(--accent-soft); }
.dock-speed { flex-direction: row; margin-right: 8px; }
.dock-speed .small-button { height: 30px; }
.run-button {
    width: 170px;
    height: 58px;
    -unity-font-style: bold;
    background-color: var(--accent-soft);
    border-color: var(--accent);
}

/* 2겹: 서랍 (왼쪽 = 생활기록부, 오른쪽 = 거점·사람) */
.drawer {
    position: absolute; top: 60px; bottom: 92px;
    width: 440px;
    padding: 10px 12px;
    background-color: rgba(30, 32, 36, 0.96);
    border-color: var(--line);
    border-width: 1px;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}
.drawer-left { left: 0; border-left-width: 0; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
.drawer-right { right: 0; border-right-width: 0; border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
.drawer-left.closed { translate: -460px 0; opacity: 0; }
.drawer-right.closed { translate: 460px 0; opacity: 0; }
.drawer-head, .board-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.drawer-title, .board-title { -unity-font-style: bold; font-size: 20px; color: var(--accent); flex-grow: 1; }
.drawer-close { width: 34px; height: 30px; padding: 0; }
.drawer-body { flex-grow: 1; }

/* 2겹: 계획 보드 (아래에서 올라온다) */
.board {
    position: absolute; left: 336px; right: 0; bottom: 84px;
    height: 600px;
    padding: 10px 14px;
    background-color: rgba(26, 28, 32, 0.97);
    border-top-width: 1px;
    border-color: var(--accent-soft);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    transition-property: translate, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}
.board.closed { translate: 0 620px; opacity: 0; }
/* 보드가 열리면 입상은 왼쪽에 그대로 두고, 선생님 한마디는 보드 위로 올린다 */
.board-open .teacher-box { bottom: 700px; transition-property: bottom; transition-duration: 0.25s; }
.board-open .vitals-mini { display: none; }
.board-hint { color: var(--text-dim); font-size: 14px; margin-right: 10px; }
.board-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.palette { width: 420px; margin-right: 12px; }
.planner { flex-grow: 1; margin-right: 12px; }
.plan-side { width: 360px; }

.section-header {
    -unity-font-style: bold;
    color: var(--accent);
    margin-top: 8px;
    margin-bottom: 2px;
}

.status-row { margin: 1px 0; }
.status-row.dim { color: var(--text-dim); }
.status-row.danger { color: var(--danger); }
.status-row.derived { color: var(--text-dim); font-size: 15px; }

.vital-bar { margin: 2px 0; height: 22px; }
.vital-bar .unity-progress-bar__background { background-color: #1a1c1f; border-color: var(--line); }
.vital-bar .unity-progress-bar__progress { background-color: var(--accent-soft); }
.vital-hp .unity-progress-bar__progress { background-color: #6f8f68; }
.vital-stress .unity-progress-bar__progress { background-color: #8f5a54; }
.vital-bar .unity-progress-bar__title { color: var(--text); font-size: 15px; }

.palette-tabs { flex-direction: row; }
.tab { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-left: 1px; margin-right: 1px; }
.palette-hint { color: var(--text-dim); font-size: 14px; margin: 4px 2px; }
.palette-list { flex-grow: 1; }

.action-card {
    flex-direction: column;
    align-items: flex-start;
    padding: 6px 10px;
    margin: 3px 2px;
}

.action-card.unaffordable { opacity: 0.55; }
.action-name { -unity-font-style: bold; }
.action-info { color: var(--text-dim); font-size: 15px; }
.action-gains { color: var(--ok); font-size: 15px; }

.planner-row { flex-direction: row; flex-grow: 1; }
.planner-day, .planner-phase {
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.planner-day { flex-grow: 1; flex-basis: 0; height: 26px; }
.planner-phase { width: 44px; }

.slot {
    flex-grow: 1;
    flex-basis: 0;
    margin: 3px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 15px;
}

.slot.empty { color: var(--text-dim); }
.slot.forced { border-color: var(--warn); border-width: 2px; }
.slot.locked { background-color: var(--locked); }
.slot.warned { border-color: var(--danger); border-width: 2px; }
.slot.done { opacity: 0.4; }
.slot.current { border-color: var(--accent); border-width: 3px; }
.slot:disabled { opacity: 1; }
.slot.done:disabled { opacity: 0.4; }

.warnings { flex-grow: 1; min-height: 64px; }
.warning { color: var(--warn); font-size: 15px; }
.warning-none { color: var(--text-dim); font-size: 15px; }
.forecast { margin: 4px 0; }
.forecast.danger { color: var(--danger); }
.button-row { flex-direction: row; flex-wrap: wrap; }
.small-button { font-size: 15px; padding: 2px 8px; }

/* ── 토스트·디버그·오버레이 ── */
.toast {
    position: absolute;
    bottom: 200px;
    left: 35%;
    right: 35%;
    padding: 8px 14px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 6px;
    -unity-text-align: middle-center;
}

.debug-panel {
    position: absolute;
    top: 70px;
    right: 600px;
    width: 260px;
    padding: 8px;
    background-color: rgba(20, 20, 30, 0.95);
    border-color: #6a6aa0;
    border-width: 1px;
    border-radius: 6px;
}

.debug-status { color: var(--text-dim); font-size: 13px; margin-top: 6px; }

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.card {
    width: 640px;
    min-height: 220px;
    padding: 20px 24px;
    background-color: var(--panel);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 8px;
}

.card-title { font-size: 21px; -unity-font-style: bold; color: var(--accent); margin-bottom: 10px; }
.card-body { min-height: 80px; margin-bottom: 10px; }
.card-buttons { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; }
.card-button { min-width: 110px; height: 36px; }
.preset-row { flex-direction: row; align-items: center; }
.preset-name { flex-grow: 1; }
.preset-field { margin-bottom: 8px; }

/* ── 대화 (M3) ── */
.dialogue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 28px;
}

.dialogue-box {
    width: 90%;
    max-width: 1100px;
    min-height: 200px;
    padding: 18px 26px;
    background-color: rgba(30, 32, 36, 0.96);
    border-color: var(--accent-soft);
    border-width: 1px;
    border-radius: 8px;
}

.dialogue-speaker { font-size: 20px; -unity-font-style: bold; color: var(--accent); margin-bottom: 8px; }
.dialogue-text { font-size: 19px; white-space: normal; min-height: 70px; }
.dialogue-next { position: absolute; right: 18px; bottom: 10px; color: var(--accent); }
.dialogue-options { margin-top: 10px; }
.dialogue-option { height: 40px; margin: 3px 0; -unity-text-align: middle-left; padding-left: 14px; font-size: 17px; }
.dialogue-tools { width: 90%; max-width: 1100px; flex-direction: row; justify-content: flex-end; margin-bottom: 6px; }
.dialogue-tool { min-width: 64px; height: 28px; font-size: 14px; }
.dialogue-tool.selected { background-color: var(--accent-soft); }
.dialogue-log {
    width: 90%;
    max-width: 1100px;
    max-height: 460px;
    margin-bottom: 8px;
    padding: 10px 16px;
    background-color: rgba(20, 21, 24, 0.97);
    border-radius: 6px;
}
.dialogue-log-line { color: var(--text-dim); margin-bottom: 4px; white-space: normal; }

/* ── 타이틀 ── */
.title-screen { align-items: center; justify-content: center; }
.title-label { font-size: 48px; -unity-font-style: bold; color: var(--accent); }
.subtitle-label { color: var(--text-dim); margin-bottom: 32px; }
.title-buttons { width: 320px; }
.title-button { height: 46px; margin: 5px 0; font-size: 19px; }
.title-message { color: var(--text-dim); margin-top: 12px; }

/* ── M4: 프롤로그 입력, 출정 준비 ── */
.prologue-input {
    width: 90%;
    max-width: 1100px;
    margin-bottom: 8px;
    padding: 14px 20px;
    background-color: rgba(30, 32, 36, 0.97);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 8px;
}
.prologue-input-title { color: var(--accent); margin-bottom: 8px; }
.prologue-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.prologue-field { flex-grow: 1; min-width: 200px; }
.prologue-axis { min-width: 120px; height: 34px; }
.prologue-axis.selected { background-color: var(--accent-soft); }
.record-card-line { white-space: normal; margin-bottom: 2px; }

.prep-row { flex-direction: row; align-items: center; margin-bottom: 4px; flex-wrap: wrap; }
.prep-row > Label { min-width: 90px; }
.prep-field { min-width: 220px; }
.prep-quick { min-width: 130px; }
.prep-info { color: var(--text-dim); margin-left: 8px; font-size: 14px; }
.title-screen .overlay { position: absolute; }
.title-screen .dialogue { position: absolute; }

/* 입력 칸·드롭다운: 어두운 테마에서 글자가 보이도록 */
.prologue-field > .unity-base-text-field__input,
.prologue-field > .unity-base-popup-field__input,
.prep-field > .unity-base-popup-field__input,
.prep-quick > .unity-base-popup-field__input,
.debug-dropdown > .unity-base-popup-field__input {
    background-color: var(--panel-light);
    border-color: var(--line);
    color: var(--text);
}

.prologue-field .unity-text-element,
.prep-field .unity-text-element,
.prep-quick .unity-text-element,
.debug-dropdown .unity-text-element {
    color: var(--text);
}

/* ── M5 엔딩 연출·1년의 기록·갤러리 ── */
.ending-view {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    padding: 48px;
}
.ending-stage {
    max-width: 1100px;
    width: 100%;
    align-items: center;
}
.ending-category { color: var(--text-dim); font-size: 20px; margin-bottom: 12px; }
.ending-title { color: var(--text); font-size: 44px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ending-new { color: var(--accent); font-size: 18px; margin-top: 18px; }
.ending-cut {
    color: var(--text);
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 1040px;
}
.ending-counter { color: var(--text-dim); font-size: 14px; margin-top: 28px; }
.ending-hint { position: absolute; bottom: 24px; color: var(--text-dim); font-size: 14px; }
.ending-record { align-items: stretch; height: 100%; }
.ending-record-title { color: var(--accent); font-size: 30px; -unity-font-style: bold; margin-bottom: 12px; -unity-text-align: middle-center; }
.ending-record-scroll { flex-grow: 1; background-color: rgba(0, 0, 0, 0.28); border-radius: 6px; padding: 12px 18px; }
.ending-record-ending { color: var(--text); font-size: 22px; -unity-font-style: bold; margin-bottom: 4px; }
.ending-record-section { color: var(--accent); font-size: 18px; -unity-font-style: bold; margin-top: 16px; margin-bottom: 6px; }
.ending-record-line { color: var(--text); font-size: 17px; white-space: normal; margin: 2px 0; }
.ending-record-diary { color: var(--text-dim); font-size: 15px; white-space: normal; margin: 1px 0; }
.ending-graph-box { flex-direction: row; align-items: stretch; }
.ending-graph { height: 220px; flex-grow: 1; background-color: rgba(0, 0, 0, 0.25); border-radius: 4px; }
.ending-legend { width: 150px; margin-left: 12px; justify-content: center; }
.ending-legend-item { font-size: 15px; margin: 1px 0; }
.ending-button { margin-top: 14px; min-width: 200px; height: 40px; align-self: center; font-size: 17px; }

.gallery-view {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--bg);
    padding: 32px 64px;
}
.gallery-progress { color: var(--text-dim); font-size: 16px; -unity-text-align: middle-center; margin-bottom: 12px; }
.gallery-scroll { flex-grow: 1; }
.gallery-card { border-radius: 6px; padding: 10px 14px; margin: 4px 0; background-color: var(--panel); border-width: 1px; border-color: var(--line); }
.gallery-card.locked { opacity: 0.55; }
.gallery-category { color: var(--text-dim); font-size: 13px; }
.gallery-title { color: var(--text); font-size: 20px; -unity-font-style: bold; }
.gallery-cut { color: var(--text); font-size: 15px; white-space: normal; margin-top: 4px; }
.gallery-info { color: var(--text-dim); font-size: 13px; margin-top: 4px; }

/* ── M6 허브 표시 ── */
.companion-button { -unity-text-align: middle-left; margin: 1px 0; white-space: normal; }
.rescue-countdown { color: var(--accent); -unity-font-style: bold; }

/* 엔딩: 그 뒤의 이야기 (세력·동료 후일담) */
.ending-epilogue-line {
    color: var(--text);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 1040px;
}

/* ── 그림 (M6-5) ── */
.dialogue-portrait {
    position: absolute;
    left: 4%;
    bottom: 250px;
    width: 300px;
    height: 400px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--accent-soft);
}

.title-logo {
    width: 560px;
    height: 360px;
}

.ending-view.with-art .ending-stage {
    background-color: rgba(10, 12, 18, 0.66);
    padding: 24px 36px;
    border-radius: 10px;
}

.ending-view.with-art .ending-hint {
    background-color: rgba(0, 0, 0, 0.6);
    color: var(--text);
    padding: 4px 12px;
    border-radius: 12px;
}

.gallery-card.with-art > Label {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 4px;
    align-self: flex-start;
}

.prep-location-art {
    height: 180px;
    border-radius: 6px;
    margin-bottom: 8px;
}
.gallery-card.with-art { min-height: 96px; }

/* UI 아이콘 (M6-5): 글자 왼쪽에 아이콘 (StoryArt.SetIcon이 배경 그림을 깐다) */
.with-icon { padding-left: 32px; min-height: 24px; }
.tab.with-icon { padding-left: 24px; padding-right: 4px; }
.companion-button.with-icon { padding-left: 38px; min-height: 32px; }
.calendar.with-icon { padding-left: 36px; }
.vital-bar.with-icon { padding-left: 28px; }
