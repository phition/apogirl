/* 〈마지막 학기〉 그레이박스 테마 — 낮은 채도, 어두운 바탕 (문서 2장) */

:root {
    --bg: #1d1f22;
    --panel: #272a2e;
    --panel-light: #33373c;
    --line: #444950;
    --text: #e4e1da;
    --text-dim: #8d8a84;
    --accent: #b9a37a;
    --accent-soft: #5b5242;
    --warn: #d0894f;
    --danger: #c9584f;
    --ok: #7fa37a;
    --locked: #3a3f55;
    --day-card: #d9cdb1;
    --day-text: #2f2a22;
    --day-dim: #6f6656;
    --night-card: #1c2444;
    --night-text: #e3e6f0;
    --night-dim: #8f97b6;
    --weekday-sat: #7fc3ea;
    --weekday-sun: #e2685e;
}

.hidden {
    display: none;
}

.screen {
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    padding: 12px;
}

.font-small { font-size: 14px; }
.font-normal { font-size: 17px; }
.font-large { font-size: 21px; }

Label { color: var(--text); white-space: normal; }

Button {
    background-color: var(--panel-light);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 4px;
    color: var(--text);
    -unity-font-style: normal;
    padding: 4px 10px;
    margin: 2px;
}

Button:hover { background-color: #3f444a; }
Button:disabled { opacity: 0.45; }
Button.selected { border-color: var(--accent); background-color: var(--accent-soft); }

.panel {
    background-color: var(--panel);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
}

/* ── 허브: 다섯 겹 (Docs/UI_REDESIGN_PROPOSAL.md) ── */
.screen.hub { padding: 0; }

/* 0겹 장면: 화면 전체 */
.scene { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: #2b2e30;
    align-items: center;
    justify-content: center;
}
.backdrop-label { color: var(--text-dim); }
/* 장면의 아래쪽을 어둡게 눌러 1겹 글자가 읽히게 */
.scene-shade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 40%;
    background-color: rgba(8, 9, 12, 0.35);
}

/* 1겹: 위쪽 띠 */
.hud-top {
    position: absolute; left: 0; top: 0; right: 0;
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 14px;
    background-color: rgba(18, 19, 22, 0.82);
    border-bottom-width: 1px;
    border-color: rgba(185, 163, 122, 0.25);
}
.calendar { -unity-font-style: bold; font-size: 20px; min-width: 300px; }
.resources { flex-direction: row; flex-grow: 1; flex-shrink: 1; align-items: center; overflow: hidden; }
.resource { margin-right: 16px; }
.blackout { color: var(--warn); -unity-font-style: bold; }
.hud-button { min-width: 84px; height: 34px; background-color: rgba(51, 55, 60, 0.9); }
.hud-button.selected { background-color: var(--accent-soft); border-color: var(--accent); }

/* 1겹: 주인공 입상 + 생명 수치 요약 (왼쪽 아래) */
.standing-area {
    position: absolute; left: 18px; bottom: 112px;
    flex-direction: row;
    align-items: flex-end;
}
.standing {
    width: 380px;
    height: 600px;
}
.standing.fallback {
    width: 300px;
    height: 400px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(185, 163, 122, 0.45);
    background-color: rgba(18, 19, 22, 0.6);
}
.standing-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.standing-eyes { -unity-background-scale-mode: stretch-to-fill; }
.vitals-mini {
    width: 230px;
    margin-left: 10px;
    margin-bottom: 4px;
    padding: 8px 10px;
    background-color: rgba(18, 19, 22, 0.78);
    border-radius: 6px;
}
.vitals-mini .vital-bar { height: 20px; margin: 2px 0; }
.vitals-mini .unity-progress-bar__title { font-size: 14px; }
.mini-flag { color: var(--danger); font-size: 14px; margin-top: 2px; }
.mini-flag.warn { color: var(--warn); }

/* 1겹: 선생님 한마디 (오른쪽 아래) */
.teacher-box {
    position: absolute; right: 18px; bottom: 112px;
    width: 560px;
    min-height: 92px;
    padding: 12px 96px 12px 16px;
    background-color: rgba(24, 26, 30, 0.88);
    border-radius: 8px;
    border-left-width: 4px;
    border-color: var(--accent);
}
.teacher-name { -unity-font-style: bold; color: var(--accent); }
.teacher-line { margin-top: 4px; }
.teacher-avatar { position: absolute; right: 12px; top: 12px; width: 70px; height: 70px; }

/* 1겹: 실행 중 흘러가는 결과 한 줄 */
.ticker {
    position: absolute; left: 30%; right: 30%; top: 72px;
    align-items: center;
}
.ticker-line {
    margin: 3px 0;
    padding: 6px 16px;
    background-color: rgba(18, 19, 22, 0.86);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(185, 163, 122, 0.35);
    -unity-text-align: middle-center;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}
.ticker-line.great { border-color: var(--accent); color: #f0dfb8; }
.ticker-line.fail { border-color: var(--danger); }
.ticker-line.fading { opacity: 0; translate: 0 -10px; }

/* 1겹: 맨 아래 14칸 도크 */
.dock {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 100px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    background-color: rgba(18, 19, 22, 0.92);
    border-top-width: 1px;
    border-color: rgba(185, 163, 122, 0.25);
}
.dock-plan { width: 140px; height: 58px; -unity-font-style: bold; }
.dock-plan.selected { background-color: var(--accent-soft); border-color: var(--accent); }
.dock-slots { flex-direction: row; flex-grow: 1; height: 84px; margin: 0 10px; }
.dock-day { flex-grow: 1; flex-basis: 0; margin: 0 3px; }
.dock-day-label { font-size: 14px; color: var(--text-dim); -unity-text-align: middle-center; height: 16px; }
.dock-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin: 1px 0;
    padding: 0 4px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    border-radius: 3px;
    background-color: rgba(51, 55, 60, 0.85);
    border-width: 0;
    color: var(--text);
}
.dock-cell.day { background-color: rgba(201, 188, 159, 0.95); color: #15120c; }
.dock-cell.day.empty { color: var(--day-dim); }
.dock-cell.night { background-color: rgba(28, 36, 68, 0.94); color: #ffffff; }
.dock-cell.night.empty { color: var(--night-dim); }
.dock-cell.empty { color: var(--text-dim); }
.dock-cell.locked, .dock-cell.locked.empty { background-color: var(--locked); color: var(--text-dim); }
.dock-cell.forced { border-width: 1px; border-color: var(--warn); }
.dock-cell.warned { border-width: 1px; border-color: var(--danger); }
.dock-cell.done { opacity: 0.4; }
.dock-cell.current { border-width: 2px; border-color: var(--accent); background-color: var(--accent-soft); }
.dock-speed { flex-direction: row; margin-right: 8px; }
.dock-speed .small-button { height: 30px; }
.run-button {
    width: 170px;
    height: 58px;
    -unity-font-style: bold;
    background-color: var(--accent-soft);
    border-color: var(--accent);
}

/* 2겹: 서랍 (왼쪽 = 생활기록부, 오른쪽 = 거점·사람) */
.drawer {
    position: absolute; top: 60px; bottom: 108px;
    width: 440px;
    padding: 10px 12px;
    /* 선형 색공간에서는 반투명이 생각보다 많이 비쳐서, 글이 많은 서랍·보드는 불투명으로 */
    background-color: rgb(30, 32, 36);
    border-color: var(--line);
    border-width: 1px;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}
.drawer-left { left: 0; border-left-width: 0; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
.drawer-right { right: 0; border-right-width: 0; border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
.drawer-left.closed { translate: -460px 0; opacity: 0; }
.drawer-right.closed { translate: 460px 0; opacity: 0; }
.drawer-head, .board-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.drawer-title, .board-title { -unity-font-style: bold; font-size: 20px; color: var(--accent); flex-grow: 1; }
.drawer-close { width: 34px; height: 30px; padding: 0; }
.drawer-body { flex-grow: 1; }

/* 2겹: 계획 보드 (아래에서 올라온다) */
.board {
    position: absolute; left: 336px; right: 0; bottom: 100px;
    height: 600px;
    padding: 10px 14px;
    background-color: rgb(26, 28, 32);
    border-top-width: 1px;
    border-color: var(--accent-soft);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    transition-property: translate, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}
.board.closed { translate: 0 720px; opacity: 0; }
/* 보드가 열리면 입상은 왼쪽에 그대로 두고, 선생님 한마디는 보드 위로 올린다 */
.board-open .teacher-box { bottom: 700px; transition-property: bottom, right; transition-duration: 0.25s; }
.board-open .vitals-mini { display: none; }
.board-hint { color: var(--text-dim); font-size: 14px; margin-right: 10px; }
.board-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.palette { width: 420px; margin-right: 12px; }
.planner { flex-grow: 1; margin-right: 12px; }
.plan-side { width: 360px; }

.section-header {
    -unity-font-style: bold;
    color: var(--accent);
    margin-top: 8px;
    margin-bottom: 2px;
}

.status-row { margin: 1px 0; }
.status-row.dim { color: var(--text-dim); }
.status-row.danger { color: var(--danger); }
.status-row.derived { color: var(--text-dim); font-size: 15px; }

.vital-bar { margin: 2px 0; height: 22px; }
.vital-bar .unity-progress-bar__background { background-color: #1a1c1f; border-color: var(--line); }
.vital-bar .unity-progress-bar__progress { background-color: var(--accent-soft); }
.vital-hp .unity-progress-bar__progress { background-color: #6f8f68; }
.vital-stress .unity-progress-bar__progress { background-color: #8f5a54; }
.vital-bar .unity-progress-bar__title { color: var(--text); font-size: 15px; }

.palette-tabs { flex-direction: row; }
.tab { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-left: 1px; margin-right: 1px; }
.palette-hint { color: var(--text-dim); font-size: 14px; margin: 4px 2px; }
.palette-list { flex-grow: 1; }

.action-card {
    flex-direction: column;
    align-items: flex-start;
    padding: 6px 10px;
    margin: 3px 2px;
}

.action-card.unaffordable { opacity: 0.55; }
.action-name { -unity-font-style: bold; }
.action-info { color: var(--text-dim); font-size: 15px; }
.action-gains { color: var(--ok); font-size: 15px; }

/* 낮·밤 카드 (PlanLook): 낮 전용 상아색, 밤 전용 짙은 남색, 둘 다 되면 사선으로 반씩 */
.action-card { overflow: hidden; border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.action-card.phase-day { background-color: var(--day-card); }
/* 카드 글자는 모두 굵게, 바탕과 대비가 큰 색으로 */
.action-card.phase-day .action-info,
.action-card.phase-day .action-gains,
.action-card.phase-night .action-info,
.action-card.phase-night .action-gains,
.action-card.phase-both .action-info,
.action-card.phase-both .action-gains { -unity-font-style: bold; }
.action-card.phase-day .action-name { color: #15120c; }
.action-card.phase-day .action-info { color: #3a3226; }
.action-card.phase-day .action-gains { color: #24521f; }
.action-card.phase-night { background-color: var(--night-card); }
.action-card.phase-night .action-name { color: #ffffff; }
.action-card.phase-night .action-info { color: #d2d7ea; }
.action-card.phase-night .action-gains { color: #9fe08f; }
.action-card.phase-both { background-color: var(--day-card); }
.phase-split { position: absolute; left: 0; top: 0; right: 0; bottom: 0; --split-color: #1c2444; }
/* 둘 다 되는 카드: 사선 위에서도 읽히게 글씨 띠 */
.action-card.phase-both .action-name,
.action-card.phase-both .action-info,
.action-card.phase-both .action-gains,
.action-card.phase-both .action-phases {
    background-color: rgba(14, 16, 24, 0.88);
    border-radius: 3px;
    padding: 0 5px;
    margin: 1px 0;
}
.action-card.phase-both .action-name { color: #ffffff; }
.action-card.phase-both .action-info { color: #e0e3ee; }
.action-card.phase-both .action-gains { color: #9fe08f; }
/* 지역 탐험 카드: 얻을 수 있는 물자 칩 (아이콘 + 이름, 드문 것은 흐리게) */
.action-loot { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 2px 0; }
.action-loot-head { font-size: 14px; -unity-font-style: bold; margin-right: 6px; }
.loot-chip { font-size: 14px; -unity-font-style: bold; padding: 1px 6px 1px 4px; margin: 1px 4px 1px 0; border-radius: 3px; min-height: 22px; -unity-text-align: middle-left; }
.loot-chip.with-icon { padding-left: 25px; }
.action-card.phase-day .action-loot-head { color: #3a3226; }
.action-card.phase-day .loot-chip { background-color: rgba(21, 18, 12, 0.12); color: #15120c; }
.action-card.phase-night .action-loot-head { color: #d2d7ea; }
.action-card.phase-night .loot-chip { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
.action-card.phase-both .action-loot { background-color: rgba(14, 16, 24, 0.88); border-radius: 3px; padding: 2px 5px; margin: 1px 0; }
.action-card.phase-both .action-loot-head { color: #e0e3ee; }
.action-card.phase-both .loot-chip { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
.loot-chip.rare { opacity: 0.6; }
.action-card:hover { border-color: rgba(231, 176, 74, 0.55); }
.action-card.selected { border-color: #e7b04a; border-width: 3px; }
.card-icon { position: absolute; left: 4px; top: 50%; -unity-background-scale-mode: scale-to-fit; }
.action-phases { flex-direction: row; padding: 2px 0; }
.phase-chip { font-size: 14px; padding: 0 6px; margin-right: 4px; border-radius: 3px; -unity-font-style: bold; }
.phase-chip-day { background-color: var(--day-card); color: var(--day-text); }
.phase-chip-night { background-color: var(--night-card); color: var(--night-text); border-width: 1px; border-color: #3a4670; }
.phase-chip.off { opacity: 0.3; }
.weekday-sat { color: var(--weekday-sat); }
.weekday-sun { color: var(--weekday-sun); }

.planner-row { flex-direction: row; flex-grow: 1; }
.planner-header { flex-grow: 0; }
.planner-day, .planner-phase {
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.planner-day { flex-grow: 1; flex-basis: 0; height: 26px; }
.planner-phase { width: 44px; }

.slot {
    flex-grow: 1;
    flex-basis: 0;
    margin: 3px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 15px;
}

/* 칸 안: 아이콘(위) + 굵은 이름(아래). 글씨는 자식 라벨이 그린다 */
.slot { flex-direction: column; align-items: center; justify-content: center; padding: 2px; }
.slot-icon { width: 34px; height: 34px; flex-shrink: 0; margin-bottom: 2px; }
.slot-label {
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}
.slot.empty .slot-label { font-size: 15px; -unity-font-style: normal; }
.slot.slot-day { background-color: #c9bc9f; }
.slot.slot-night { background-color: #222b4b; }
.slot.slot-day .slot-label { color: #15120c; }
.slot.slot-night .slot-label { color: #ffffff; }
.slot.slot-day.empty .slot-label { color: var(--day-dim); }
.slot.slot-night.empty .slot-label { color: var(--night-dim); }
.slot.locked .slot-label { color: var(--text-dim); }
.slot:hover { border-color: rgba(231, 176, 74, 0.6); border-width: 2px; }
.slot.forced { border-color: var(--warn); border-width: 2px; }
.slot.locked, .slot.locked.empty { background-color: var(--locked); color: var(--text-dim); }
.slot.warned { border-color: var(--danger); border-width: 2px; }
.slot.done { opacity: 0.4; }
.slot.current { border-color: var(--accent); border-width: 3px; }
.slot:disabled { opacity: 1; }
.slot.done:disabled { opacity: 0.4; }

/* 선생님 추천 편성 (Docs/TEACHER_PLAN_PROPOSAL.md): 보드 머리 단추, 흐름 띠, 분필 밑줄·고정 꼬리표·끌기, 메모 */
.board-tools { flex-direction: row; align-items: center; margin-right: 8px; }
.board-tool { height: 30px; margin-left: 6px; padding: 0 10px; font-size: 15px; }
.board-tool.teacher { background-color: #3d3a2c; border-color: var(--accent); color: #f1e6c8; -unity-font-style: bold; }
.board-tool:disabled { opacity: 0.35; }
.board-tool.teacher.dim { opacity: 0.45; border-color: #6b6658; }
.planner-col { flex-grow: 1; margin-right: 12px; min-width: 0; }
.planner-col > .planner { margin-right: 0; position: relative; }
.plan-flow { height: 128px; flex-shrink: 0; margin-top: 4px; }
.plan-flow-strip { flex-direction: row; flex-grow: 1; }
.plan-flow-graph { flex-grow: 1; margin: 0 3px; background-color: rgba(255, 255, 255, 0.03); border-radius: 6px; }
.plan-flow-bottom { flex-direction: row; align-items: center; height: 30px; }
.flow-legend { font-size: 13px; margin-right: 8px; }
.flow-legend.fatigue { color: rgb(232, 176, 74); }
.flow-legend.stress { color: rgb(204, 115, 217); }
.flow-legend.debt { color: rgb(107, 156, 224); }
.plan-flow-stats { flex-direction: row; flex-grow: 1; overflow: hidden; }
.flow-chip { font-size: 13px; padding: 1px 6px; margin-right: 4px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.07); }
.flow-chip.up { background-color: rgba(110, 170, 90, 0.35); }
.flow-chip.down { background-color: rgba(200, 90, 80, 0.35); }
.flow-chip.none { color: var(--text-dim); }
.plan-flow-summary { font-size: 13px; color: var(--text-dim); }
.plan-flow-summary.danger { color: var(--danger); }
.slot { position: relative; transition-property: opacity, scale; transition-duration: 0.18s; }
.slot-chalk { position: absolute; left: 22%; right: 22%; bottom: 4px; height: 3px; border-radius: 2px; opacity: 0; transition-property: opacity; transition-duration: 0.3s; }
.slot.slot-day .slot-chalk { background-color: rgba(70, 55, 30, 0.75); }
.slot.slot-night .slot-chalk { background-color: rgba(240, 236, 222, 0.85); }
.slot.teacher .slot-chalk { opacity: 1; }
.slot.chalk-pre { opacity: 0.25; scale: 0.92 0.92; }
.slot-pin { position: absolute; top: 2px; right: 3px; font-size: 11px; padding: 0 4px; border-radius: 6px; color: var(--text-dim); background-color: rgba(0, 0, 0, 0.25); opacity: 0; }
.slot:hover .slot-pin { opacity: 0.7; }
.slot-pin.on { opacity: 1; color: #1b1407; background-color: var(--accent); }
.slot-pin:hover { opacity: 1; }
.slot.drop-ok { border-color: rgba(120, 200, 120, 0.7); border-width: 2px; }
.slot.drop-bad { opacity: 0.45; }
.slot.drop-target { border-color: var(--accent); border-width: 3px; }
.slot.drag-source { opacity: 0.5; }
.slot-drag-ghost { position: absolute; padding: 4px 10px; border-radius: 6px; background-color: rgba(231, 176, 74, 0.9); color: #1b1407; -unity-font-style: bold; font-size: 15px; }
.teacher-memo { margin-bottom: 6px; padding: 6px 8px; border-radius: 6px; background-color: rgba(185, 163, 122, 0.12); border-left-width: 3px; border-color: var(--accent); }
.teacher-memo-title { -unity-font-style: bold; color: var(--accent); font-size: 15px; margin-bottom: 2px; }
.teacher-memo-line { font-size: 14px; white-space: normal; }
.slot-detail { font-size: 14px; white-space: normal; color: var(--text-dim); min-height: 64px; margin-bottom: 4px; }
.slot-detail.on { color: #e8e2d4; }

.warnings { flex-grow: 1; min-height: 64px; }
.warning { color: var(--warn); font-size: 15px; }
.warning-none { color: var(--text-dim); font-size: 15px; }
.forecast { margin: 4px 0; }
.forecast.danger { color: var(--danger); }
.button-row { flex-direction: row; flex-wrap: wrap; }
.small-button { font-size: 15px; padding: 2px 8px; }

/* ── 토스트·디버그·오버레이 ── */
.toast {
    position: absolute;
    bottom: 200px;
    left: 35%;
    right: 35%;
    padding: 8px 14px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 6px;
    -unity-text-align: middle-center;
}

.debug-panel {
    position: absolute;
    top: 70px;
    right: 600px;
    width: 260px;
    padding: 8px;
    background-color: rgba(20, 20, 30, 0.95);
    border-color: #6a6aa0;
    border-width: 1px;
    border-radius: 6px;
}

.debug-status { color: var(--text-dim); font-size: 13px; margin-top: 6px; }

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.card {
    width: 640px;
    min-height: 220px;
    padding: 20px 24px;
    background-color: var(--panel);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 8px;
}

.card-title { font-size: 21px; -unity-font-style: bold; color: var(--accent); margin-bottom: 10px; }
.card-body { min-height: 80px; margin-bottom: 10px; }
.card-buttons { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; }
.card-button { min-width: 110px; height: 36px; }
.preset-row { flex-direction: row; align-items: center; }
.preset-name { flex-grow: 1; }
.preset-field { margin-bottom: 8px; }

/* ── 대화 (M3) ── */
.dialogue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 28px;
}

.dialogue-box {
    width: 90%;
    max-width: 1100px;
    min-height: 200px;
    padding: 18px 26px;
    background-color: rgba(30, 32, 36, 0.96);
    border-color: var(--accent-soft);
    border-width: 1px;
    border-radius: 8px;
}

.dialogue-speaker { font-size: 20px; -unity-font-style: bold; color: var(--accent); margin-bottom: 8px; }
.dialogue-text { font-size: 19px; white-space: normal; min-height: 70px; }
.dialogue-next { position: absolute; right: 18px; bottom: 10px; color: var(--accent); }
.dialogue-options { margin-top: 10px; }
.dialogue-option { height: 40px; margin: 3px 0; -unity-text-align: middle-left; padding-left: 14px; font-size: 17px; }
.dialogue-tools { width: 90%; max-width: 1100px; flex-direction: row; justify-content: flex-end; margin-bottom: 6px; }
.dialogue-tool { min-width: 64px; height: 28px; font-size: 14px; }
.dialogue-tool.selected { background-color: var(--accent-soft); }
.dialogue-log {
    width: 90%;
    max-width: 1100px;
    max-height: 460px;
    margin-bottom: 8px;
    padding: 10px 16px;
    background-color: rgba(20, 21, 24, 0.97);
    border-radius: 6px;
}
.dialogue-log-line { color: var(--text-dim); margin-bottom: 4px; white-space: normal; }

/* ── 타이틀 ── */
.title-screen { align-items: center; justify-content: center; }
.title-label { font-size: 48px; -unity-font-style: bold; color: var(--accent); }
.subtitle-label { color: var(--text-dim); margin-bottom: 32px; }
.title-buttons { width: 320px; }
.title-button { height: 46px; margin: 5px 0; font-size: 19px; }
.title-message { color: var(--text-dim); margin-top: 12px; }

/* ── M4: 프롤로그 입력, 출정 준비 ── */
.prologue-input {
    width: 90%;
    max-width: 1100px;
    margin-bottom: 8px;
    padding: 14px 20px;
    background-color: rgba(30, 32, 36, 0.97);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 8px;
}
.prologue-input-title { color: var(--accent); margin-bottom: 8px; }
.prologue-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.prologue-field { flex-grow: 1; min-width: 200px; }
.prologue-axis { min-width: 120px; height: 34px; }
.prologue-axis.selected { background-color: var(--accent-soft); }
.record-card-line { white-space: normal; margin-bottom: 2px; }

.prep-row { flex-direction: row; align-items: center; margin-bottom: 4px; flex-wrap: wrap; }
.prep-row > Label { min-width: 90px; }
.prep-field { min-width: 220px; }
.prep-quick { min-width: 130px; }
.prep-info { color: var(--text-dim); margin-left: 8px; font-size: 14px; }
.title-screen .overlay { position: absolute; }
.title-screen .dialogue { position: absolute; }

/* 입력 칸·드롭다운: 어두운 테마에서 글자가 보이도록 */
.prologue-field > .unity-base-text-field__input,
.prologue-field > .unity-base-popup-field__input,
.prep-field > .unity-base-popup-field__input,
.prep-quick > .unity-base-popup-field__input,
.debug-dropdown > .unity-base-popup-field__input,
.preset-field > .unity-base-text-field__input,
.lab-window .unity-base-text-field__input {
    background-color: var(--panel-light);
    border-color: var(--line);
    color: var(--text);
}

/* 입력 칸 안의 글자와 커서·선택 색 (밸런스 표·프리셋 이름) */
.preset-field > .unity-base-text-field__input > .unity-text-element,
.lab-window .unity-base-text-field__input > .unity-text-element {
    color: var(--text);
}

.preset-field > .unity-base-text-field__input,
.lab-window .unity-base-text-field__input {
    --unity-cursor-color: var(--text);
    --unity-selection-color: rgba(231, 176, 74, 0.45);
}

.preset-field > Label,
.lab-window .unity-base-field > Label {
    color: var(--text-dim);
}

.prologue-field .unity-text-element,
.prep-field .unity-text-element,
.prep-quick .unity-text-element,
.debug-dropdown .unity-text-element {
    color: var(--text);
}

/* ── M5 엔딩 연출·1년의 기록·갤러리 ── */
.ending-view {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    padding: 48px;
}
.ending-stage {
    max-width: 1100px;
    width: 100%;
    align-items: center;
}
.ending-category { color: var(--text-dim); font-size: 20px; margin-bottom: 12px; }
.ending-title { color: var(--text); font-size: 44px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ending-new { color: var(--accent); font-size: 18px; margin-top: 18px; }
.ending-cut {
    color: var(--text);
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 1040px;
}
.ending-counter { color: var(--text-dim); font-size: 14px; margin-top: 28px; }
.ending-hint { position: absolute; bottom: 24px; color: var(--text-dim); font-size: 14px; }
.ending-record { align-items: stretch; height: 100%; }
.ending-record-title { color: var(--accent); font-size: 30px; -unity-font-style: bold; margin-bottom: 12px; -unity-text-align: middle-center; }
.ending-record-scroll { flex-grow: 1; background-color: rgba(0, 0, 0, 0.28); border-radius: 6px; padding: 12px 18px; }
.ending-record-ending { color: var(--text); font-size: 22px; -unity-font-style: bold; margin-bottom: 4px; }
.ending-record-section { color: var(--accent); font-size: 18px; -unity-font-style: bold; margin-top: 16px; margin-bottom: 6px; }
.ending-record-line { color: var(--text); font-size: 17px; white-space: normal; margin: 2px 0; }
.ending-record-diary { color: var(--text-dim); font-size: 15px; white-space: normal; margin: 1px 0; }
.ending-graph-box { flex-direction: row; align-items: stretch; }
.ending-graph { height: 220px; flex-grow: 1; background-color: rgba(0, 0, 0, 0.25); border-radius: 4px; }
.ending-legend { width: 150px; margin-left: 12px; justify-content: center; }
.ending-legend-item { font-size: 15px; margin: 1px 0; }
.ending-button { margin-top: 14px; min-width: 200px; height: 40px; align-self: center; font-size: 17px; }

.gallery-view {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--bg);
    padding: 32px 64px;
}
.gallery-progress { color: var(--text-dim); font-size: 16px; -unity-text-align: middle-center; margin-bottom: 12px; }
.gallery-scroll { flex-grow: 1; }
.gallery-card { border-radius: 6px; padding: 10px 14px; margin: 4px 0; background-color: var(--panel); border-width: 1px; border-color: var(--line); }
.gallery-card.locked { opacity: 0.55; }
.gallery-category { color: var(--text-dim); font-size: 13px; }
.gallery-title { color: var(--text); font-size: 20px; -unity-font-style: bold; }
.gallery-cut { color: var(--text); font-size: 15px; white-space: normal; margin-top: 4px; }
.gallery-info { color: var(--text-dim); font-size: 13px; margin-top: 4px; }

/* ── M6 허브 표시 ── */
.companion-button { -unity-text-align: middle-left; margin: 1px 0; white-space: normal; }
.rescue-countdown { color: var(--accent); -unity-font-style: bold; }

/* 엔딩: 그 뒤의 이야기 (세력·동료 후일담) */
.ending-epilogue-line {
    color: var(--text);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 1040px;
}

/* ── 그림 (M6-5) ── */
/* 대화창 = [초상 액자 | 이름·글·선택지] 가로 줄. 액자는 가는 둥근 테두리만, 안은 비워 둔다. */
.dialogue-box { flex-direction: row; align-items: stretch; }
.dialogue-body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.dialogue-box.with-portrait { min-height: 276px; padding-left: 18px; }
.dialogue-portrait {
    width: 180px;
    height: 240px;
    flex-shrink: 0;
    margin-right: 22px;
    padding: 4px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--accent-soft);
    background-color: rgba(0, 0, 0, 0);
}
.dialogue-portrait-image { flex-grow: 1; border-radius: 8px; }

.title-logo {
    width: 560px;
    height: 360px;
}

.ending-view.with-art .ending-stage {
    background-color: rgba(10, 12, 18, 0.66);
    padding: 24px 36px;
    border-radius: 10px;
}

.ending-view.with-art .ending-hint {
    background-color: rgba(0, 0, 0, 0.6);
    color: var(--text);
    padding: 4px 12px;
    border-radius: 12px;
}

.gallery-card.with-art > Label {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 4px;
    align-self: flex-start;
}

.prep-location-art {
    height: 180px;
    border-radius: 6px;
    margin-bottom: 8px;
}
.gallery-card.with-art { min-height: 96px; }

/* UI 아이콘 (M6-5): 글자 왼쪽에 아이콘 (StoryArt.SetIcon이 배경 그림을 깐다) */
.with-icon { padding-left: 32px; min-height: 24px; }
.tab.with-icon { padding-left: 24px; padding-right: 4px; }
.companion-button.with-icon { padding-left: 38px; min-height: 32px; }
.calendar.with-icon { padding-left: 36px; }
.vital-bar.with-icon { padding-left: 28px; }

/* ── 허브 0겹: 학교 단면도 (HubSectionView) ── */
.section-frame {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(120, 146, 168);
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0 22px 92px 0;
}
.section-frame.night { background-color: rgb(14, 18, 30); }
.section { position: relative; }
.hub-sky { position: absolute; left: -2000px; right: -2000px; top: -400px; bottom: 0; }
.hub-sky-origin { position: absolute; left: 2000px; top: 400px; width: 0; height: 0; overflow: visible; }
.hub-star { background-color: rgb(235, 238, 255); }
.hub-sun.heat { -unity-background-image-tint-color: rgb(255, 214, 150); scale: 1.3 1.3; }
.hub-rain { width: 2px; height: 22px; background-color: rgba(200, 214, 232, 0.7); rotate: 7deg; }
.hub-snow { width: 6px; height: 6px; border-radius: 3px; background-color: rgba(250, 252, 255, 0.9); }
.hub-building { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hub-actors { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hub-shell { -unity-background-image-tint-color: rgb(150, 150, 150); }
.hub-ground { background-color: rgb(46, 44, 40); }
.hub-stairs { background-color: rgb(28, 30, 36); border-left-width: 2px; border-color: rgb(70, 72, 76); }
.hub-room { overflow: hidden; background-color: rgb(58, 56, 54); }
.hub-room.roof { background-color: rgba(0, 0, 0, 0); }
.hub-room.roof.locked > .hub-room-name { color: var(--text-dim); }
.hub-room.roof.night .hub-prop, .hub-room.roof.night .hub-fence { -unity-background-image-tint-color: rgb(96, 104, 132); }
.hub-wall { background-color: rgb(74, 72, 70); border-left-width: 1px; border-right-width: 1px; border-color: rgb(40, 38, 36); }
.hub-door-line { background-color: rgb(136, 96, 58); }
.hub-door-frame { background-color: rgb(52, 48, 44); }
.hub-door-panel { background-color: rgb(150, 108, 66); border-width: 1px; border-color: rgb(58, 40, 24); }
.hub-outer-wall { -unity-background-image-tint-color: rgb(160, 150, 150); border-left-width: 1px; border-right-width: 1px; border-color: rgb(40, 30, 28); }
.hub-room.roof { overflow: visible; }
.hub-room:hover > .hub-room-name { background-color: rgba(185, 163, 122, 0.85); color: rgb(20, 20, 22); }
.hub-room.locked > .hub-dark { background-color: rgba(6, 7, 10, 0.86); }
.hub-slab { background-color: rgb(40, 40, 44); }
.hub-parapet { background-color: rgb(96, 96, 98); }
.hub-prop { }
.hub-dark { background-color: rgba(6, 8, 16, 0); transition-property: background-color; transition-duration: 0.6s; }
.hub-dark.dim { background-color: rgba(6, 8, 16, 0.25); }
.hub-dark.night { background-color: rgba(6, 8, 16, 0.62); }
.hub-dark.blackout { background-color: rgba(4, 5, 10, 0.8); }
.hub-glow { background-color: rgba(255, 186, 110, 0); transition-property: background-color; transition-duration: 0.6s; }
.hub-glow.on { background-color: rgba(255, 186, 110, 0.1); }
.hub-room-name {
    position: absolute; left: 6px; top: 12px;
    padding: 1px 6px;
    font-size: 14px;
    color: rgb(230, 225, 214);
    background-color: rgba(14, 15, 18, 0.72);
    border-radius: 3px;
}
.hub-room.shelter > .hub-room-name { border-left-width: 3px; border-color: var(--accent); }
.hub-room.locked > .hub-room-name { color: var(--text-dim); }
.hub-actor { position: absolute; }
.hub-actor.away { display: none; }
.hub-room.away > .hub-room-name { color: var(--accent); }
.hub-room-panel {
    position: absolute;
    width: 260px;
    padding: 8px 10px;
    background-color: rgb(30, 32, 36);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 6px;
}
.hub-room-panel-title { -unity-font-style: bold; color: var(--accent); font-size: 17px; margin-bottom: 4px; }
.hub-room-panel-note { color: var(--text-dim); font-size: 14px; margin-bottom: 4px; }
.hub-room-action { -unity-text-align: middle-left; height: 32px; margin: 2px 0; }

/* 단면도가 있을 때: 입상은 왼쪽 열(요약 위·입상 아래), 선생님 한마디는 오른쪽 위 */
.with-section .standing-area { flex-direction: column-reverse; align-items: flex-start; }
.with-section .vitals-mini { margin-left: 0; margin-bottom: 8px; }
.with-section .teacher-box { top: 64px; bottom: auto; }
.with-section.board-open .teacher-box { top: 64px; bottom: auto; }
.with-section .scene-shade { display: none; }

/* ── 입상 그림 (전신 한 장) ── */
.with-section .standing { width: 300px; height: 452px; }
.standing.fallback { width: 300px; height: 400px; }

/* ── 3겹 전용 화면 공통 ── */
.sheet {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 7, 10, 0.95);
    align-items: center;
    justify-content: center;
}

/* 주간 결산: 펼친 일기장 (그림 비율 1920x1086) */
.settle-book {
    width: 1600px;
    height: 905px;
    flex-direction: row;
}
.settle-page { position: absolute; top: 13%; bottom: 17%; }
.settle-left { left: 7.6%; width: 39.4%; padding: 6px 18px; }
.settle-stamp { position: absolute; right: 6px; top: -18px; width: 150px; height: 96px; -unity-background-scale-mode: scale-to-fit; rotate: -9deg; opacity: 0.85;
    font-size: 22px; -unity-font-style: bold; color: rgb(178, 46, 40); -unity-text-align: middle-center; }
.settle-right { left: 53.4%; width: 39.4%; padding: 6px 18px; }
.settle-title { font-size: 30px; -unity-font-style: bold; color: rgb(44, 38, 32); margin-bottom: 12px; }
.settle-diary { font-size: 21px; color: rgb(52, 46, 40); white-space: normal; margin-bottom: 14px; }
.settle-head { font-size: 18px; -unity-font-style: bold; color: rgb(70, 84, 120); margin-top: 10px; margin-bottom: 4px; }
.settle-line { font-size: 17px; color: rgb(52, 46, 40); white-space: normal; margin: 1px 0; }
.settle-line.strong { -unity-font-style: bold; color: rgb(60, 92, 60); }
.settle-stat { flex-direction: row; align-items: center; margin: 1px 0; }
.settle-stat-name { width: 150px; font-size: 17px; color: rgb(52, 46, 40); }
.settle-stat-bar { height: 10px; background-color: rgb(96, 128, 84); border-radius: 3px; }
.settle-stat-bar.down { background-color: rgb(170, 80, 70); }
.settle-teacher {
    margin-top: 16px;
    font-size: 19px;
    color: rgb(178, 44, 40);
    -unity-font-style: italic;
    white-space: normal;
    border-left-width: 3px;
    border-color: rgb(178, 44, 40);
    padding-left: 10px;
}
.settle-foot { position: absolute; bottom: -6px; left: 18px; font-size: 14px; color: rgb(110, 100, 90); }
.settle-buttons { flex-direction: row; justify-content: center; margin-top: -40px; }
.settle-next { min-width: 260px; height: 50px; font-size: 19px; -unity-font-style: bold; background-color: var(--accent-soft); border-color: var(--accent); }
.settle-undo { min-width: 200px; height: 50px; font-size: 16px; }

/* 출정 준비: 왼쪽 지역 그림, 오른쪽 입상 + 장비 */
.expedition-sheet { flex-direction: row; align-items: stretch; justify-content: flex-start; background-color: rgb(14, 15, 18); }
.exp-art { flex-grow: 1; background-color: rgb(30, 32, 36); justify-content: flex-end; }
.exp-art-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 70%; }
.expedition-sheet.night .exp-art { -unity-background-image-tint-color: rgb(120, 130, 170); }
.exp-info { padding: 0 56px 56px 56px; }
.exp-kicker { color: var(--accent); font-size: 18px; -unity-font-style: bold; }
.exp-location { color: rgb(240, 236, 226); font-size: 44px; -unity-font-style: bold; margin-bottom: 6px; }
.exp-time { align-self: flex-start; padding: 3px 12px; border-radius: 12px; background-color: rgb(196, 168, 96); color: rgb(30, 26, 20); font-size: 16px; margin-bottom: 14px; }
.exp-time.night { background-color: rgb(60, 70, 120); color: rgb(220, 226, 245); }
.exp-line { color: rgb(220, 216, 206); font-size: 18px; white-space: normal; margin: 3px 0; max-width: 900px; }
.exp-warning { color: rgb(232, 120, 104); font-size: 18px; -unity-font-style: bold; margin-top: 12px; }
.exp-side { width: 840px; flex-direction: row; background-color: rgb(24, 26, 30); border-left-width: 1px; border-color: var(--line); }
.exp-standing { width: 380px; margin: 30px 0 30px 10px; }
.exp-panel { flex-grow: 1; padding: 40px 24px 32px 12px; justify-content: space-between; }
.exp-loadout { }
.exp-slot { flex-direction: row; align-items: center; padding: 8px; margin-bottom: 8px; background-color: rgb(34, 36, 41); border-radius: 6px; border-width: 1px; border-color: var(--line); }
.exp-icon { width: 56px; height: 56px; margin-right: 10px; background-color: rgb(22, 23, 27); border-radius: 4px; }
.exp-slot-text { flex-grow: 1; }
.exp-slot-kind { color: var(--text-dim); font-size: 13px; }
.exp-slot-name { font-size: 18px; -unity-font-style: bold; }
.exp-slot-info { color: var(--ok); font-size: 14px; }
.exp-arrow { width: 36px; height: 44px; padding: 0; font-size: 14px; }
.exp-quick-label { color: var(--text-dim); font-size: 14px; margin-top: 8px; }
.exp-quick-row { flex-direction: row; flex-wrap: wrap; }
.exp-quick-on { border-color: var(--accent); background-color: var(--accent-soft); }
.exp-quick { width: 92px; height: 104px; padding: 6px; margin: 4px 6px 0 0; align-items: center; flex-direction: column; }
.exp-quick .exp-icon { margin-right: 0; }
.exp-quick-name { font-size: 12px; -unity-text-align: middle-center; white-space: normal; }
.exp-buttons { }
.exp-depart { height: 60px; font-size: 22px; -unity-font-style: bold; background-color: var(--accent-soft); border-color: var(--accent); }
.exp-dispatch { height: 40px; font-size: 16px; margin-top: 6px; }

/* 단면도 방 패널의 방 그림 */
.hub-room-art { height: 130px; margin: 2px 0 6px 0; border-radius: 4px; }

/* P4 설비 그림: 방 패널 그림 아래쪽에 나란히, 행동 카드 아이콘 */
.hub-room-built { position: absolute; left: 4px; right: 4px; bottom: 2px; height: 74px; flex-direction: row; justify-content: flex-end; }
.hub-room-built-item { width: 74px; height: 74px; margin-left: 2px; }
.action-card.with-icon { padding-left: 56px; background-position-y: center; }
.dock-cell.with-icon { padding-left: 34px; -unity-text-align: middle-left; }
.hud-button.with-icon { padding-left: 32px; }
.dock-plan.with-icon { padding-left: 38px; }
.dock-speed .small-button.with-icon { padding-left: 26px; }
.hub-room-action.with-icon { padding-left: 36px; }

/* CD 진열장·플레이어 (기획 A) */
.hub-cd-slot { background-color: rgba(0, 0, 0, 0.22); border-width: 1px; border-color: rgba(255, 255, 255, 0.10); }
.hub-cd-slot.owned { background-color: rgba(0, 0, 0, 0); border-color: rgba(20, 16, 12, 0.85); -unity-background-scale-mode: scale-and-crop; }
.hub-cd-slot.owned:hover { border-color: var(--accent); }
.hub-cd-head { -unity-font-style: bold; margin-top: 6px; }
/* CD 상세: 벽 자켓을 누르면 크게 + 설명 + 틀기 */
.hub-cd-detail {
    position: absolute;
    width: 520px;
    flex-direction: row;
    padding: 12px;
    background-color: rgb(30, 32, 36);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 6px;
}
.hub-cd-detail-jacket { width: 220px; height: 220px; flex-shrink: 0; margin-right: 14px; }
.hub-cd-detail-side { flex-grow: 1; flex-shrink: 1; }
.hub-cd-detail-desc { white-space: normal; font-size: 15px; color: var(--text); margin: 6px 0 10px 0; }
.hub-cd-detail-buttons { flex-direction: row; margin-top: 4px; }
.hub-cd-detail-play { height: 34px; min-width: 110px; margin: 0 6px 0 0; -unity-font-style: bold; }
.hub-cd-detail-play.playing { background-color: rgb(52, 70, 62); }
.hub-cd-detail-close { height: 34px; min-width: 70px; margin: 0; }
.hub-cd-track { border-left-width: 6px; }
.hub-cd-track.playing { background-color: rgb(52, 70, 62); }
.hub-cd-hint { font-size: 13px; opacity: 0.7; }
.hub-room-built.standalone { position: relative; left: 0; right: 0; bottom: 0; justify-content: flex-start; margin-bottom: 6px; }

/* ── 3겹 세력 화면 (FactionView) ── */
/* 설계도 (제작 P7, CraftTreeView) */
.ct-open { margin: 2px 2px 8px 2px; padding: 6px 10px; font-size: 16px; -unity-font-style: bold; color: var(--accent); border-color: var(--accent-soft); }
.ct-panel { width: 1500px; height: 880px; background-color: rgb(26, 28, 32); border-width: 1px; border-color: var(--accent-soft); border-radius: 10px; padding: 22px 26px; }
.ct-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.ct-title { font-size: 30px; -unity-font-style: bold; color: rgb(240, 236, 226); margin-right: 16px; }
.ct-hint { flex-grow: 1; flex-shrink: 1; font-size: 15px; color: var(--text-dim); white-space: normal; }
.ct-close { padding: 6px 16px; font-size: 16px; }
.ct-body { flex-grow: 1; }
.ct-row { flex-direction: row; align-items: center; padding: 8px 0; border-bottom-width: 1px; border-color: var(--line); }
.ct-line { width: 120px; flex-shrink: 0; font-size: 18px; -unity-font-style: bold; color: var(--accent); }
.ct-cells { flex-direction: row; flex-wrap: wrap; align-items: center; flex-grow: 1; flex-shrink: 1; }
.ct-arrow { font-size: 22px; color: var(--text-dim); margin: 0 6px; }
.ct-cell { width: 270px; min-height: 84px; margin: 4px 0; padding: 8px 10px; flex-direction: column; align-items: stretch; background-color: rgb(34, 36, 41); border-width: 1px; border-color: var(--line); border-radius: 6px; }
.ct-cell.open { border-color: var(--accent); }
.ct-cell.built { background-color: rgb(36, 46, 40); border-color: rgb(110, 160, 120); }
.ct-cell.locked { opacity: 0.6; }
.ct-cell-top { flex-direction: row; align-items: center; }
.ct-icon { width: 40px; height: 40px; margin-right: 8px; flex-shrink: 0; }
.ct-names { flex-grow: 1; flex-shrink: 1; }
.ct-name { font-size: 17px; -unity-font-style: bold; color: rgb(240, 236, 226); white-space: normal; }
.ct-status { font-size: 13px; color: var(--text-dim); }
.ct-cell.open .ct-status { color: var(--accent); }
.ct-cell.built .ct-status { color: rgb(140, 200, 150); }
.ct-detail { font-size: 13px; color: var(--text-dim); white-space: normal; margin-top: 4px; -unity-text-align: upper-left; }

.fac-panel { width: 1400px; height: 860px; background-color: rgb(26, 28, 32); border-width: 1px; border-color: var(--accent-soft); border-radius: 10px; padding: 24px 28px; }
.fac-head { flex-direction: row; margin-bottom: 18px; }
.fac-portrait { width: 200px; height: 240px; border-radius: 8px; background-color: rgb(40, 42, 48); margin-right: 24px; align-items: center; justify-content: center; }
.fac-initial { font-size: 96px; -unity-font-style: bold; color: var(--accent); }
.fac-intro { flex-grow: 1; flex-shrink: 1; }
.fac-title-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.fac-name { font-size: 34px; -unity-font-style: bold; color: rgb(240, 236, 226); margin-right: 14px; }
.fac-tier { padding: 3px 12px; border-radius: 12px; font-size: 15px; color: rgb(20, 20, 22); }
.fac-desc { font-size: 17px; color: var(--text-dim); white-space: normal; margin-bottom: 12px; }
.fac-status { font-size: 17px; white-space: normal; margin-top: 8px; }
.fac-effect { font-size: 15px; color: var(--ok); white-space: normal; margin-top: 2px; }
.fac-gauge { flex-direction: row; height: 58px; margin-top: 10px; overflow: visible; }
.fac-band { height: 34px; justify-content: center; }
.fac-band-label { font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-center; height: 34px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7); }
.fac-marker { position: absolute; top: -5px; width: 6px; height: 44px; margin-left: -3px; background-color: rgb(255, 255, 255); border-width: 1px; border-color: rgb(20, 20, 22); border-radius: 2px; }
.fac-marker-value { position: absolute; top: 42px; left: -22px; width: 50px; -unity-text-align: middle-center; font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.tier-hostile { background-color: rgb(176, 72, 64); }
.tier-wary { background-color: rgb(196, 140, 80); }
.tier-neutral { background-color: rgb(150, 150, 140); }
.tier-friendly { background-color: rgb(120, 168, 110); }
.tier-allied { background-color: rgb(96, 150, 196); }
.tier-gone { background-color: rgb(90, 90, 96); color: rgb(220, 220, 220); }
.fac-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.fac-trades { flex-grow: 1; margin-right: 18px; }
.fac-log { width: 380px; background-color: rgb(32, 34, 39); border-radius: 6px; padding: 10px 14px; }
.fac-section { font-size: 18px; -unity-font-style: bold; color: var(--accent); margin-bottom: 8px; }
.fac-dim { color: var(--text-dim); font-size: 15px; }
.fac-trade { flex-direction: column; padding: 12px 14px; margin-bottom: 10px; background-color: rgb(34, 36, 41); border-width: 1px; border-color: var(--line); border-radius: 6px; }
.fac-trade.blocked { opacity: 0.7; }
.fac-trade-row { flex-direction: row; align-items: center; }
.fac-side { flex-grow: 1; flex-basis: 0; }
.fac-side-label { font-size: 13px; color: var(--text-dim); margin-bottom: 4px; }
.fac-chips { flex-direction: row; flex-wrap: wrap; }
.fac-chip { padding: 3px 10px 3px 30px; margin: 2px 6px 2px 0; background-color: rgb(46, 49, 55); border-radius: 12px; font-size: 16px; }
.fac-chip.short { color: var(--danger); }
.fac-arrow { font-size: 26px; color: var(--accent); margin: 0 16px; }
.fac-trade-note { font-size: 13px; color: var(--text-dim); margin-top: 6px; }
.fac-trade-desc { font-size: 15px; white-space: normal; margin-top: 2px; }
.fac-trade-blocker { font-size: 15px; color: var(--warn); white-space: normal; margin-top: 2px; }
.fac-trade-button { align-self: flex-end; min-width: 120px; height: 36px; margin-top: 6px; background-color: var(--accent-soft); border-color: var(--accent); }
.fac-log-row { flex-direction: row; margin-bottom: 6px; }
.fac-log-week { width: 70px; color: var(--text-dim); font-size: 14px; }
.fac-log-text { flex-shrink: 1; font-size: 15px; white-space: normal; }

/* ── 생활기록부 다이어리 (RecordDiaryView) ── */
.drawer-left.diary { width: 560px; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 30px 34px 48px 40px; }
.drawer-left.diary.closed { translate: -600px 0; }
.drawer-left.diary .drawer-title { color: rgb(110, 70, 40); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(110, 70, 40); }
.drawer-left.diary .drawer-close { background-color: rgba(120, 90, 60, 0.25); border-color: rgba(110, 70, 40, 0.5); color: rgb(80, 50, 30); }
.diary-date { font-size: 20px; color: rgb(35, 28, 22); -unity-text-outline-width: 0.6px; -unity-text-outline-color: rgb(35, 28, 22); margin-bottom: 4px; }
.diary-top { flex-direction: row; align-items: flex-start; margin-bottom: 8px; }
.diary-polaroid { width: 168px; height: 210px; margin-right: 12px; rotate: -3deg; -unity-background-scale-mode: stretch-to-fill; }
.diary-photo { position: absolute; }
.diary-photo-caption { position: absolute; left: 6%; right: 6%; font-size: 14px; color: rgb(45, 38, 34); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(45, 38, 34); -unity-text-align: middle-center; white-space: normal; }
.diary-tape { position: absolute; top: -12px; left: 60px; width: 84px; height: 30px; rotate: 4deg; -unity-background-scale-mode: stretch-to-fill; }
.diary-note { padding: 14px 16px 12px 16px; -unity-background-scale-mode: stretch-to-fill; }
.diary-note-body { flex-grow: 1; rotate: 1.5deg; min-height: 0; }
.diary-note-stats { rotate: -0.6deg; margin-bottom: 8px; }
.diary-section { font-size: 16px; color: rgb(30, 24, 20); -unity-text-outline-width: 0.6px; -unity-text-outline-color: rgb(30, 24, 20); margin-bottom: 3px; }
.diary-body-row { flex-direction: row; align-items: center; height: 18px; }
.diary-body-name { width: 62px; font-size: 14px; color: rgb(40, 32, 26); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(40, 32, 26); }
.diary-body-word { flex-grow: 1; font-size: 14px; }
.diary-body-value { width: 36px; font-size: 12px; color: rgb(60, 52, 45); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(60, 52, 45); -unity-text-align: middle-right; }
.tone-ok { color: rgb(30, 90, 35); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(30, 90, 35); }
.tone-warn { color: rgb(150, 85, 10); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(150, 85, 10); }
.tone-danger { color: rgb(165, 30, 25); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(165, 30, 25); }
.diary-alert { font-size: 13px; color: rgb(160, 30, 25); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(160, 30, 25); white-space: normal; margin-top: 2px; }
.diary-dots { flex-direction: row; align-items: center; margin-top: 3px; }
.diary-dots-label { font-size: 13px; color: rgb(40, 32, 26); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(40, 32, 26); margin-right: 6px; }
.diary-dot-row { flex-direction: row; align-items: center; }
.diary-dot { width: 9px; height: 9px; border-radius: 5px; border-width: 1.5px; border-color: rgb(60, 48, 38); margin-right: 3px; }
.diary-dot.filled { background-color: rgb(60, 48, 38); }
.diary-stat-grid { flex-direction: column; }
.diary-stat-row { flex-direction: row; align-items: center; height: 19px; padding: 0 4px; }
.diary-stat-row:hover { background-color: rgba(255, 255, 255, 0.35); border-radius: 4px; }
.diary-stat-name { width: 96px; font-size: 15px; color: rgb(20, 28, 50); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(20, 28, 50); }
.diary-stat-name.with-icon { padding-left: 22px; }
.diary-stat-boxes { flex-grow: 1; flex-direction: row; align-items: center; }
.diary-box { width: 11px; height: 11px; border-width: 1.5px; border-color: rgb(25, 45, 100); margin-right: 3px; }
.diary-box.filled { background-color: rgb(25, 45, 100); }
.diary-stat-value { width: 40px; font-size: 13px; color: rgb(35, 45, 70); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(35, 45, 70); -unity-text-align: middle-right; }
.diary-stat-delta { width: 40px; height: 20px; font-size: 14px; color: rgb(30, 95, 35); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(30, 95, 35); -unity-text-align: middle-center; -unity-background-scale-mode: stretch-to-fill; }
.diary-stat-delta.circled { color: rgb(170, 30, 25); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(170, 30, 25); }
.diary-derived { font-size: 12px; color: rgb(35, 45, 70); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(35, 45, 70); margin-top: 4px; }
.diary-stickers { margin: 2px 0 8px 0; }
.diary-sticker-row { flex-direction: row; flex-wrap: wrap; }
.diary-sticker { width: 50px; align-items: center; margin: 0 1px 4px 0; }
.diary-sticker:hover { background-color: rgba(255, 255, 255, 0.4); border-radius: 6px; }
.diary-sticker-badge { width: 34px; height: 34px; border-radius: 17px; background-color: rgb(200, 226, 190); border-width: 2px; border-color: rgb(255, 255, 255); -unity-background-scale-mode: scale-to-fit; }
.diary-sticker.empty .diary-sticker-badge { background-color: rgba(0, 0, 0, 0.06); border-color: rgba(110, 90, 70, 0.4); -unity-background-image-tint-color: rgba(255, 255, 255, 0.35); }
.diary-sticker-name { font-size: 12px; color: rgb(40, 32, 26); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(40, 32, 26); -unity-text-align: middle-center; white-space: normal; }
.diary-sticker-level { font-size: 10px; height: 12px; color: rgb(185, 115, 10); }
.diary-sticker.empty .diary-sticker-level { color: rgb(110, 100, 90); }
.diary-teacher { margin-top: 0; padding: 2px 4px; }
.diary-teacher-head { font-size: 13px; color: rgb(95, 60, 40); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(95, 60, 40); }
.diary-teacher-text { font-size: 16px; color: rgb(155, 28, 25); -unity-text-outline-width: 0.6px; -unity-text-outline-color: rgb(155, 28, 25); white-space: normal; -unity-font-style: italic; }
.diary-underline { height: 14px; width: 60%; -unity-background-scale-mode: stretch-to-fill; opacity: 0.75; }
.diary-hint { position: absolute; width: 320px; padding: 8px 10px; background-color: rgb(255, 250, 230); border-width: 1px; border-color: rgb(190, 160, 110); border-radius: 6px; font-size: 14px; color: rgb(35, 28, 22); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(35, 28, 22); white-space: normal; }

/* ── 인물 서랍 (PeopleDrawerView, 기획 D.1) ── */
.person-card { padding: 10px 12px; margin-bottom: 10px; background-color: rgb(36, 38, 43); border-width: 1px; border-color: var(--line); border-radius: 8px; }
.person-top { flex-direction: row; align-items: center; margin-bottom: 6px; }
.person-badge { border-radius: 50%; background-color: rgb(29, 31, 34); border-width: 2px; border-color: var(--accent); margin-right: 12px; flex-shrink: 0; align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; }
.person-initial { font-size: 26px; -unity-font-style: bold; color: var(--accent); }
.person-info { flex-grow: 1; flex-shrink: 1; }
.person-name-row { flex-direction: row; align-items: center; }
.person-name { font-size: 19px; -unity-font-style: bold; color: rgb(240, 236, 226); margin-right: 8px; }
.person-role { font-size: 13px; padding: 1px 8px; border-radius: 10px; background-color: var(--accent-soft); color: var(--text); }
.person-bond { font-size: 15px; color: var(--accent); -unity-font-style: italic; white-space: normal; margin-top: 2px; }
.person-bar { height: 20px; margin: 1px 0; }
.person-bar .unity-progress-bar__title { font-size: 13px; }
.person-flag { font-size: 14px; color: var(--danger); margin-top: 3px; white-space: normal; }
.person-outing { font-size: 14px; color: var(--accent); margin-top: 3px; white-space: normal; }
.person-stay { margin: 6px 0 0 0; padding: 3px 10px; font-size: 14px; align-self: flex-start; }
.person-stay.on { border-color: var(--accent); color: var(--accent); }
.people-dim { font-size: 14px; color: var(--text-dim); white-space: normal; margin: 6px 2px; }

/* ── 이번 주 배분하기 (GiveSheetView, 기획 D.3) ── */
.give-panel { width: 1360px; height: 860px; background-color: rgb(26, 28, 32); border-width: 1px; border-color: var(--accent-soft); border-radius: 10px; padding: 22px 28px; }
.give-head { flex-shrink: 0; flex-direction: row; align-items: flex-end; margin-bottom: 4px; }
.give-title { font-size: 30px; -unity-font-style: bold; color: var(--accent); flex-grow: 1; }
.give-stock { font-size: 18px; color: var(--text); }
.give-hint { flex-shrink: 0; font-size: 15px; color: var(--text-dim); white-space: normal; margin-bottom: 12px; }
/* 동료가 늘면 목록만 스크롤 (식단·단추 칸은 줄지 않는다) */
.give-list { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 120px; }
.give-list .unity-scroll-view__content-container { flex-shrink: 0; }
.give-list .unity-scroll-view__vertical-scroller { margin-left: 6px; }
.give-diet { flex-shrink: 0; padding: 10px 12px; margin-bottom: 10px; background-color: rgb(38, 36, 30); border-width: 1px; border-color: var(--accent-soft); border-radius: 8px; }
.give-diet-title { font-size: 18px; -unity-font-style: bold; color: var(--accent); margin-bottom: 4px; }
.give-diet-row { flex-shrink: 0; flex-direction: row; align-items: center; margin: 2px 0; }
.give-diet-name { width: 90px; font-size: 16px; color: var(--text); }
.give-diet-need { font-size: 15px; color: var(--text-dim); margin-left: 10px; }
.give-diet-need.short { color: rgb(236, 140, 120); }
.give-diet-note { font-size: 13px; color: var(--text-dim); white-space: normal; margin-top: 4px; }
.give-empty { font-size: 15px; color: var(--text-dim); margin: 8px 4px; }
.give-row { flex-shrink: 0; flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 8px; background-color: rgb(34, 36, 41); border-width: 1px; border-color: var(--line); border-radius: 8px; }
.give-info { width: 300px; flex-shrink: 0; }
.give-condition { font-size: 13px; color: var(--text-dim); white-space: normal; margin-top: 2px; }
.give-choices { flex-grow: 1; flex-shrink: 1; }
.give-basics { flex-direction: row; margin-bottom: 4px; }
.give-gifts { flex-direction: row; flex-wrap: wrap; }
.give-choice { height: 34px; font-size: 15px; margin: 2px 6px 2px 0; padding: 2px 10px; border-radius: 6px; }
.give-choice.with-icon { padding-left: 32px; }
.give-choice.liked { color: rgb(236, 178, 170); }
.give-choice.selected { background-color: var(--accent-soft); border-color: var(--accent); color: rgb(250, 246, 236); }
.give-buttons { flex-shrink: 0; flex-direction: row; justify-content: flex-end; margin-top: 12px; }
.give-confirm { min-width: 220px; }

/* 단면도 말풍선 */
.hub-bubble { position: absolute; width: 300px; padding: 6px 12px; background-color: rgb(244, 240, 230); color: rgb(30, 28, 26); border-radius: 12px; border-width: 2px; border-color: rgb(60, 56, 50); font-size: 20px; -unity-text-align: middle-center; white-space: normal; }

/* ── 밸런스 표 (BalanceLabView, Docs/BALANCE_LAB_PROPOSAL.md) ── */
.lab-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); align-items: center; justify-content: center; }
.lab-window { width: 94%; height: 92%; padding: 10px 14px; background-color: #171a24; border-width: 1px; border-color: #6a6aa0; border-radius: 6px; }
.lab-header { flex-direction: row; align-items: center; }
.lab-title { font-size: 20px; -unity-font-style: bold; color: var(--accent); flex-grow: 1; }
.lab-search { width: 280px; margin-right: 8px; }
.lab-search > Label { min-width: 40px; }
.lab-tabs { flex-direction: row; flex-wrap: wrap; margin: 8px 0 4px 0; }
.lab-tab { margin-right: 4px; }
.lab-tab.selected { background-color: var(--accent-soft); border-color: var(--accent); border-width: 1px; }
.lab-hint { color: var(--text-dim); font-size: 14px; margin: 2px 0 6px 2px; }
.lab-body { flex-grow: 1; background-color: rgba(255, 255, 255, 0.02); }
.lab-row { flex-direction: row; align-items: center; min-height: 26px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.lab-row:hover { background-color: rgba(255, 255, 255, 0.04); }
.lab-row-dirty { background-color: rgba(231, 176, 74, 0.08); }
.lab-head { background-color: #232838; }
.lab-head .lab-cell { color: var(--accent); -unity-font-style: bold; }
.lab-group { margin-top: 10px; padding: 3px 6px; -unity-font-style: bold; color: #e3e6f0; background-color: rgba(106, 106, 160, 0.25); }
.lab-cell { font-size: 14px; padding: 0 6px; white-space: nowrap; overflow: hidden; }
.lab-c-name { width: 280px; }
.lab-c-base { width: 80px; color: var(--text-dim); -unity-text-align: middle-right; }
.lab-c-value { width: 100px; }
.lab-c-summary { width: 420px; color: var(--text-dim); }
.lab-c-unit { width: 70px; color: var(--text-dim); }
.lab-c-when { width: 90px; color: #9fb7e0; }
.lab-c-note { flex-grow: 1; color: var(--text-dim); font-size: 13px; }
.lab-c-region { width: 120px; -unity-font-style: bold; }
.lab-c-time { width: 40px; }
.lab-c-range { width: 112px; flex-direction: row; align-items: center; }
.lab-c-num { width: 76px; }
.lab-mini { width: 46px; }
.lab-tilde { padding: 0 1px; color: var(--text-dim); }
.lab-day .lab-c-time { color: #e7d9b0; }
.lab-night .lab-c-time { color: #8fa4e0; }
.lab-night { background-color: rgba(28, 36, 68, 0.35); }
.lab-current { background-color: rgba(231, 176, 74, 0.1); }
.lab-edit { margin: 1px 2px; }
.lab-edit > .unity-text-field__input, .lab-edit .unity-base-text-field__input { font-size: 14px; padding: 0 4px; -unity-text-align: middle-right; background-color: #2a2f40; color: #f1ede2; }
.lab-dirty > .unity-text-field__input, .lab-dirty .unity-base-text-field__input { background-color: #5a4515; color: #ffe08a; -unity-font-style: bold; }
.lab-changed { margin-top: 6px; padding: 4px 6px; font-size: 14px; color: var(--text-dim); white-space: normal; }
.lab-changed.lab-changed-on { color: #ffe08a; background-color: rgba(231, 176, 74, 0.12); }
.lab-help { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
.lab-save { background-color: #3d5a34; }
.lab-status { font-size: 13px; color: #9fe08f; margin-top: 2px; white-space: normal; }
.lab-status.lab-status-warn { color: #f0a070; }
.lab-bot { margin-top: 6px; padding: 6px 8px; background-color: rgba(106, 106, 160, 0.12); border-top-width: 1px; border-color: #6a6aa0; }
.lab-bot-bar { flex-direction: row; align-items: center; flex-wrap: wrap; }
.lab-bot-title { font-size: 16px; -unity-font-style: bold; color: var(--accent); margin-right: 10px; }
.lab-bot-strategies { flex-direction: row; flex-wrap: wrap; margin-right: 8px; }
.lab-bot-toggle { margin-right: 8px; }
.lab-bot-toggle > Label { min-width: 0; font-size: 13px; }
.lab-bot-int { width: 130px; margin-right: 4px; }
.lab-bot-int > Label { min-width: 0; margin-right: 4px; }
.lab-bot-difficulty { width: 170px; margin: 0 6px; }
.lab-bot-difficulty > Label { min-width: 0; margin-right: 4px; }
.lab-bot-progress { margin-top: 4px; }
.lab-bot-table { margin-top: 4px; }
.lab-bot-name { width: 160px; -unity-font-style: bold; }
.lab-bot-num { width: 110px; -unity-text-align: middle-right; }
.lab-bot-in { color: #9fe08f; -unity-font-style: bold; }
.lab-bot-out { color: #f07a6a; -unity-font-style: bold; }
.lab-log { margin-top: 4px; }
.lab-log-text { height: 260px; }
.lab-log-text > .unity-text-field__input, .lab-log-text .unity-base-text-field__input { font-size: 13px; white-space: normal; -unity-text-align: upper-left; background-color: #0f1118; }

/* 보관함: 생활기록부 서랍(왼쪽 다이어리)과 함께 열린다 (StorageView) */
.drawer-storage {
    position: absolute; left: 568px; bottom: 108px;
    width: 400px; max-height: 62%;
    padding: 10px 12px;
    background-color: rgb(30, 32, 36);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 8px;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}
.drawer-storage.closed { translate: -1000px 0; opacity: 0; }
.storage-title { -unity-font-style: bold; font-size: 20px; color: var(--accent); margin-bottom: 4px; }
.storage-list { flex-shrink: 1; }
.storage-head { font-size: 14px; -unity-font-style: bold; color: var(--text-dim); margin: 8px 0 3px 0; border-bottom-width: 1px; border-color: var(--line); }
.storage-chips { flex-direction: row; flex-wrap: wrap; }
.storage-chip { font-size: 15px; -unity-font-style: bold; padding: 2px 8px 2px 4px; margin: 2px 4px 2px 0; border-radius: 4px; background-color: rgba(255, 255, 255, 0.07); min-height: 26px; -unity-text-align: middle-left; }
.storage-chip.with-icon { padding-left: 28px; }
.storage-chip.zero { opacity: 0.5; }
.storage-row { flex-direction: row; align-items: center; min-height: 34px; padding: 1px 0; }
.storage-icon { width: 30px; height: 30px; margin-right: 8px; flex-shrink: 0; }
.storage-name { flex-grow: 1; font-size: 15px; }
.storage-note { font-size: 13px; color: var(--text-dim); }
.storage-note.equipped { color: var(--accent); -unity-font-style: bold; }

/* 거점 상황판 (Docs/BASE_TAB_PROPOSAL.md P1, BaseBoardView): 거점 서랍 맨 위 */
.base-board { margin-bottom: 4px; }
.base-alerts { background-color: rgba(201, 88, 79, 0.18); border-left-width: 3px; border-color: var(--danger); border-radius: 4px; padding: 4px 8px; margin-bottom: 6px; }
.base-alert { color: #f3aaa3; white-space: normal; font-size: 15px; margin: 1px 0; }
.base-card { background-color: rgb(38, 41, 46); border-width: 1px; border-color: var(--line); border-radius: 6px; margin-bottom: 6px; }
.base-card-head { flex-direction: row; align-items: center; min-height: 36px; margin: 0; padding: 2px 8px; background-color: transparent; border-width: 0; }
.base-card-head:hover { background-color: rgba(255, 255, 255, 0.05); }
.base-card-title { flex-grow: 1; -unity-font-style: bold; color: var(--accent); -unity-text-align: middle-left; }
.base-card-title.with-icon { padding-left: 32px; }
.base-verdict { font-size: 14px; padding: 1px 9px; margin-right: 6px; border-radius: 9px; }
.base-verdict.ok { background-color: rgba(127, 163, 122, 0.25); color: #a9cfa3; }
.base-verdict.warn { background-color: rgba(208, 137, 79, 0.28); color: #f0b88a; }
.base-verdict.bad { background-color: rgba(201, 88, 79, 0.32); color: #f3aaa3; }
.base-fold { color: var(--text-dim); width: 14px; -unity-text-align: middle-center; }
.base-card-body { padding: 0 10px 8px 10px; }
.base-line { white-space: normal; font-size: 15px; margin: 1px 0; }
.base-line.dim { color: var(--text-dim); }
.base-line.ok, .base-line.good { color: #a9cfa3; }
.base-line.warn { color: #f0b88a; }
.base-line.bad { color: #f3aaa3; }
.base-supply-head { -unity-font-style: bold; font-size: 16px; margin-top: 4px; }
.base-supply-head.with-icon { padding-left: 26px; min-height: 22px; }
.base-bar { height: 20px; margin: 2px 0; }
.base-bar .unity-progress-bar__background { background-color: #1a1c1f; border-color: var(--line); }
.base-bar-defense .unity-progress-bar__progress { background-color: #6f8f68; }
.base-bar-threat .unity-progress-bar__progress { background-color: #8f5a54; }
.base-power-row { flex-direction: row; align-items: center; margin: 3px 0; }
.base-power-cells { flex-direction: row; margin-right: 8px; }
.base-power-cell { width: 18px; height: 14px; margin-right: 3px; border-width: 1px; border-color: var(--line); border-radius: 2px; }
.base-power-cell.used { background-color: var(--accent); }
.base-power-cell.free { background-color: rgba(127, 163, 122, 0.65); }
.base-power-cell.none { opacity: 0.35; }
.base-power-cell.broken { background-color: var(--danger); }
.base-actions { flex-direction: row; flex-wrap: wrap; margin-top: 5px; }
.base-action { margin: 2px 4px 2px 0; }
.base-action.with-icon { padding-left: 28px; }
/* 거점 단추의 빨간 점 */
.hud-alert-dot { position: absolute; right: 3px; top: 3px; width: 10px; height: 10px; border-radius: 5px; border-width: 1px; border-color: #1d1f22; background-color: var(--danger); }
/* 거점 상황판 시설 칸 (BASE_TAB_PROPOSAL P2): 방마다 한 줄, 누르면 단면도의 그 방 */
.base-room { flex-direction: row; align-items: flex-start; margin: 1px 0; padding: 3px 6px; min-height: 26px; background-color: transparent; border-width: 0; border-radius: 4px; }
.base-room:hover { background-color: rgba(185, 163, 122, 0.14); }
.base-room-name { width: 92px; flex-shrink: 0; font-size: 15px; -unity-font-style: bold; color: var(--text); -unity-text-align: upper-left; white-space: normal; margin: 0; padding: 0; }
.base-room-text { flex-grow: 1; flex-shrink: 1; font-size: 14px; color: #a9cfa3; -unity-text-align: upper-left; white-space: normal; margin: 0; padding: 0; }
.base-room.locked .base-room-name { color: var(--text-dim); -unity-font-style: normal; }
.base-room-text.use { color: var(--text); }
.base-room.locked .base-room-text { color: var(--text-dim); }
/* 단면도: 상황판에서 가리킨 방의 빛 테두리 */
.hub-ring { border-width: 0; border-color: rgba(255, 214, 140, 0); transition-property: border-color, border-width; transition-duration: 0.25s; }
.hub-ring.on { border-width: 6px; border-color: rgba(255, 220, 150, 1); background-color: rgba(255, 214, 140, 0.2); }
.hub-room-panel-effect { color: #a9cfa3; font-size: 14px; white-space: normal; margin-bottom: 2px; }
/* 거점 상황판 역할 판 (BASE_TAB_PROPOSAL P3): 역할마다 한 줄, 자리 뱃지·빈 자리 [+], 후보 고르기, 쉬는 사람 */
.base-role { margin: 3px 0; padding: 4px 6px; border-radius: 4px; background-color: rgba(185, 163, 122, 0.06); }
.base-role.locked { opacity: 0.55; }
.base-role-head { flex-direction: row; align-items: center; }
.base-role-name { font-size: 15px; -unity-font-style: bold; color: var(--text); margin: 0; padding: 0 0 0 2px; min-height: 22px; -unity-text-align: middle-left; }
.base-role-name.with-icon { padding-left: 27px; }
.base-role-rooms { font-size: 13px; color: var(--text-dim); white-space: normal; margin: 1px 0 0 0; padding: 0; }
.base-role-slots { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 3px; }
.base-person { flex-direction: row; align-items: center; margin: 2px 6px 2px 0; padding: 1px 6px 1px 1px; border-radius: 14px; border-width: 1px; border-color: var(--line); background-color: rgba(0, 0, 0, 0.18); }
.base-person.weak { border-color: #b0865a; }
.base-person.overflow { opacity: 0.5; border-color: var(--danger); }
.base-person.pick { background-color: rgba(127, 163, 122, 0.12); }
.base-person.pick:hover { background-color: rgba(127, 163, 122, 0.3); }
.base-person-name { font-size: 13px; color: var(--text); margin: 0 0 0 4px; padding: 0; }
.base-role-tag { font-size: 12px; color: var(--text-dim); margin: 0 0 0 4px; padding: 0; }
.base-role-add { width: 28px; height: 28px; margin: 2px 6px 2px 0; padding: 0; border-radius: 14px; border-width: 1px; border-color: var(--line); background-color: transparent; color: var(--text-dim); font-size: 16px; -unity-text-align: middle-center; }
.base-role-add:hover { border-color: var(--accent); color: var(--text); }
.base-role-add.on { background-color: var(--accent-soft); border-color: var(--accent); color: var(--text); }
.base-role-pick { margin: 4px 0 2px 0; padding: 4px 6px; border-radius: 4px; border-width: 1px; border-color: var(--accent); background-color: rgba(0, 0, 0, 0.22); flex-direction: row; flex-wrap: wrap; align-items: center; }
.base-role-pick-title { width: 100%; font-size: 13px; color: var(--text-dim); margin: 0 0 3px 0; padding: 0; }
.base-role-rest { margin-top: 6px; padding-top: 4px; border-top-width: 1px; border-color: var(--line); flex-direction: row; flex-wrap: wrap; align-items: center; }
.base-role-rest-title { font-size: 13px; color: var(--text-dim); margin: 0 8px 0 0; padding: 0; }
/* 누르면 역할 판으로 넘어가는 글 (인물 서랍 역할·방 패널 자리 줄) */
.person-role.clickable:hover, .hub-room-panel-note.clickable:hover { color: var(--accent); }
.hub-room-panel-note.clickable { -unity-font-style: bold; }
/* P1 화면 확인 손질 (BASE_TAB_PROPOSAL): 서랍 스크롤바는 가늘게 테마색, 상황판 막대 글자는 왼쪽, 오른쪽 서랍이 열리면 선생님 한 줄을 비켜 둔다 */
.drawer-body .unity-scroller--vertical , .people-factions-list .unity-scroller--vertical { width: 8px; margin-left: 4px; }
.drawer-body .unity-scroller--vertical .unity-scroller__low-button, .people-factions-list .unity-scroller--vertical .unity-scroller__low-button,
.drawer-body .unity-scroller--vertical .unity-scroller__high-button , .people-factions-list .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.drawer-body .unity-scroller--vertical .unity-scroller__slider , .people-factions-list .unity-scroller--vertical .unity-scroller__slider { width: 8px; margin: 0; padding: 0; }
.drawer-body .unity-scroller--vertical .unity-base-slider__drag-container , .people-factions-list .unity-scroller--vertical .unity-base-slider__drag-container { width: 8px; margin: 0; }
.drawer-body .unity-scroller--vertical .unity-base-slider__tracker , .people-factions-list .unity-scroller--vertical .unity-base-slider__tracker { width: 8px; left: 0; border-width: 0; border-radius: 4px; background-color: rgba(185, 163, 122, 0.08); }
.drawer-body .unity-scroller--vertical .unity-base-slider__dragger , .people-factions-list .unity-scroller--vertical .unity-base-slider__dragger { width: 8px; left: 0; border-width: 0; border-radius: 4px; background-color: rgba(185, 163, 122, 0.45); }
.drawer-body .unity-scroller--vertical .unity-base-slider__dragger:hover , .people-factions-list .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: var(--accent); }
.base-bar .unity-progress-bar__title-container { justify-content: flex-start; align-items: center; padding-left: 8px; }
.base-bar .unity-progress-bar__title { -unity-text-align: middle-left; font-size: 14px; color: var(--text); }
.teacher-box { transition-property: right, bottom; transition-duration: 0.25s; }
.right-drawer-open .teacher-box { right: 458px; }
.base-repel-parts { font-size: 13px; }
/* 거점 상황판 다음 할 일 (BASE_TAB_PROPOSAL P4): 알림 아래 선생님 한마디, 누르면 계획 보드·역할 칸 */
.base-advice { flex-direction: row; align-items: flex-start; margin: 0 0 8px 0; padding: 6px 8px; border-radius: 6px; border-left-width: 3px; border-color: var(--accent); background-color: rgba(185, 163, 122, 0.1); }
.base-advice-face { margin: 2px 8px 0 0; flex-shrink: 0; }
.base-advice-lines { flex-grow: 1; flex-shrink: 1; }
.base-advice-line { font-size: 15px; color: var(--text); white-space: normal; -unity-text-align: upper-left; margin: 2px 0; padding: 2px 4px; border-width: 0; border-radius: 4px; background-color: transparent; }
Button.base-advice-line:hover { background-color: rgba(185, 163, 122, 0.18); color: var(--accent); }
/* ── 거점 서랍 글꼴 (사용자 결정 2026-11-25): 제목·칸 머리·판정 칩은 학교안심 엣지, 그 밖의 내용 글은 부산단디손글씨 (UI/Fonts, ArtInbox에서 받음) ──
   #drawer-right 범위라 인물 서랍(같은 drawer-right 클래스)에는 안 번진다. BaseBoardView는 이 때문에 KoreanFont.ApplyDeep을 쓰지 않는다. */
#drawer-right .unity-text-element { -unity-font-definition: url("Fonts/BusanDandiHand.ttf"); }
#drawer-right .drawer-title, #drawer-right .base-card-title, #drawer-right .section-header, #drawer-right .base-verdict, #drawer-right .base-supply-head { -unity-font-definition: url("Fonts/HakgyoansimEdge.ttf"); }
/* 손글씨는 같은 크기에서 작고 가늘어 보여 1px씩 키운다 */
#drawer-right .base-line, #drawer-right .base-alert, #drawer-right .base-advice-line, #drawer-right .base-room-name { font-size: 16px; }
#drawer-right .base-room-text { font-size: 15px; }
#drawer-right .base-repel-parts { font-size: 14px; }
/* 거점 서랍은 상황판이라 더 넓게 (인물 서랍은 440 그대로) — 열리면 선생님 한 줄도 그만큼 더 비킨다 */
#drawer-right { width: 520px; }
#drawer-right.closed { translate: 540px 0; }
.base-drawer-open .teacher-box { right: 538px; }
/* 생활기록부 서랍도 거점 서랍과 같은 글꼴 (사용자 요청 2026-11-25): 제목·날짜·칸 머리는 학교안심 엣지, 내용은 부산단디손글씨.
   RecordDiaryView는 그래서 KoreanFont.ApplyDeep을 쓰지 않는다. */
#drawer-left .unity-text-element { -unity-font-definition: url("Fonts/BusanDandiHand.ttf"); }
#drawer-left .drawer-title, #drawer-left .diary-date, #drawer-left .diary-section, #drawer-left .diary-teacher-head, #drawer-left .diary-dots-label { -unity-font-definition: url("Fonts/HakgyoansimEdge.ttf"); }
/* 학교안심 엣지는 글자 윗부분이 높아 종이 윗가장자리에 잘려 보였다: 제목 줄을 조금 내린다 */
#drawer-left .drawer-head { margin-top: 8px; }
/* 인물 서랍 단추·역할 글: 자기 padding이 .with-icon의 아이콘 자리를 덮어 아이콘과 글자가 겹쳤다 — 아이콘이 있으면 왼쪽을 비워 그만큼 넓힌다 */
.person-stay.with-icon { padding-left: 30px; padding-right: 12px; min-height: 26px; }
.person-role.with-icon { padding-left: 26px; padding-right: 10px; min-height: 22px; }
/* 세력 덧판 (FactionAddonView): 인물 서랍 왼쪽 가장자리에 붙은 화살표 탭, 누르면 왼쪽으로 펼친다.
   선생님 한 줄(위쪽)과 겹치지 않게 서랍 위에서 150px 아래. 서랍이 닫히면 함께 숨는다(닫힌 서랍은 화면 밖이라 덧판만 남지 않게). */
.people-factions { position: absolute; top: 150px; right: 100%; flex-direction: row; align-items: flex-start; }
.drawer-people.closed .people-factions { display: none; }
.people-factions-tab {
    margin: 0; padding: 10px 8px; min-width: 34px;
    font-size: 15px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center;
    color: var(--accent); background-color: rgb(30, 32, 36);
    border-width: 1px; border-right-width: 0; border-color: var(--line);
    border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 0; border-bottom-right-radius: 0;
}
.people-factions-tab:hover { background-color: rgb(44, 46, 52); }
.people-factions.expanded .people-factions-tab { color: var(--text-dim); }
.people-factions-sheet {
    width: 340px; max-height: 760px; padding: 10px 12px;
    background-color: rgb(30, 32, 36); border-width: 1px; border-right-width: 0; border-color: var(--line);
    border-top-left-radius: 8px; border-bottom-left-radius: 8px;
}
.people-factions-list { flex-shrink: 1; }
/* 접힌 탭의 초록 점: 지금 거래할 수 있는 세력이 있을 때 */
.people-factions-dot { display: none; position: absolute; top: 4px; left: 4px; width: 8px; height: 8px; border-radius: 4px; background-color: rgb(120, 200, 110); }
.people-factions.trade-ready .people-factions-dot { display: flex; }
.people-factions.expanded .people-factions-dot { display: none; }
/* 세력 카드 (FactionAddonView.Card): 누르면 거래 화면 */
.fac-mini {
    margin: 0 0 6px 0; padding: 7px 10px;
    background-color: rgb(38, 40, 46); border-width: 1px; border-color: var(--line); border-radius: 6px;
}
.fac-mini:hover { background-color: rgb(46, 49, 56); border-color: var(--accent); }
.fac-mini.gone { opacity: 0.6; }
.fac-mini-head { flex-direction: row; align-items: center; }
.fac-mini-face {
    width: 44px; height: 44px; margin-right: 10px; flex-shrink: 0;
    border-radius: 22px; border-width: 2px; border-color: rgb(20, 20, 22);
    align-items: center; justify-content: center; overflow: hidden;
}
.fac-mini-initial { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7); }
.fac-mini-side { flex-grow: 1; flex-shrink: 1; }
.fac-mini-title { flex-direction: row; align-items: center; }
.fac-mini-name { font-size: 16px; -unity-font-style: bold; color: var(--text); margin-right: 6px; flex-shrink: 1; }
.fac-mini-tier { padding: 1px 8px; border-radius: 9px; font-size: 13px; -unity-font-style: bold; color: rgb(20, 20, 22); }
.fac-mini-trend { margin-left: auto; font-size: 13px; -unity-font-style: bold; }
.fac-mini-trend.up { color: rgb(130, 200, 120); }
.fac-mini-trend.down { color: rgb(220, 110, 100); }
.fac-mini-gauge { flex-direction: row; height: 8px; margin: 6px 0 2px 0; border-radius: 3px; overflow: visible; }
.fac-mini-band { height: 8px; opacity: 0.75; }
.fac-mini-marker {
    position: absolute; top: -3px; width: 4px; height: 14px; margin-left: -2px;
    background-color: rgb(255, 255, 255); border-width: 1px; border-color: rgb(20, 20, 22); border-radius: 1px;
}
.fac-mini-next { font-size: 12px; color: var(--text-dim); }
.fac-mini-status { margin-top: 5px; font-size: 14px; color: var(--text); white-space: normal; }
.fac-mini-effect { margin-top: 1px; font-size: 12px; color: var(--text-dim); white-space: normal; }
.fac-mini-foot {
    flex-direction: row; align-items: center; justify-content: space-between;
    margin-top: 6px; padding-top: 5px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.fac-mini-trade { font-size: 13px; flex-shrink: 1; white-space: normal; }
.fac-mini-trade.dim { color: var(--text-dim); }
.fac-mini-trade.ready { color: rgb(130, 200, 120); -unity-font-style: bold; }
.fac-mini-trade.warn { color: rgb(220, 160, 90); }
.fac-mini-link { font-size: 13px; color: var(--accent); -unity-font-style: bold; flex-shrink: 0; margin-left: 8px; }
.fac-mini-pending { margin-top: 3px; font-size: 12px; color: rgb(140, 180, 220); white-space: normal; }
/* 세력 덧판을 펼치면 판이 인물 서랍에 틈 없이 붙고, 접기 탭은 판 왼쪽으로 (자식 순서: 판, 탭 → 거꾸로 놓아 판이 서랍 쪽) */
.people-factions.expanded { flex-direction: row-reverse; }
.people-factions.expanded .people-factions-sheet { border-top-left-radius: 0; }
