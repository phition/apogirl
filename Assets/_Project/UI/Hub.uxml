<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:Label name="calendar-label" class="calendar" />
            <ui:VisualElement name="resources" class="resources" />
            <ui:Button name="save-button" class="top-button" />
            <ui:Button name="menu-button" class="top-button" />
        </ui:VisualElement>

        <ui:VisualElement name="middle" class="middle">
            <ui:ScrollView name="status-panel" class="panel status-panel" />
            <ui:VisualElement name="center" class="center">
                <ui:VisualElement name="backdrop" class="backdrop">
                    <ui:Label name="backdrop-label" class="backdrop-label" />
                </ui:VisualElement>
                <ui:VisualElement name="teacher-box" class="teacher-box">
                    <ui:Label name="teacher-name" class="teacher-name" />
                    <ui:Label name="teacher-line" class="teacher-line" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="palette" class="panel palette">
                <ui:VisualElement name="palette-tabs" class="palette-tabs" />
                <ui:Label name="palette-hint" class="palette-hint" />
                <ui:ScrollView name="palette-list" class="palette-list" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bottom" class="bottom">
            <ui:VisualElement name="planner" class="panel planner" />
            <ui:VisualElement name="plan-side" class="panel plan-side">
                <ui:ScrollView name="warnings" class="warnings" />
                <ui:Label name="forecast" class="forecast" />
                <ui:VisualElement name="plan-buttons" class="button-row" />
                <ui:VisualElement name="speed-buttons" class="button-row" />
                <ui:Button name="run-button" class="run-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" class="toast hidden" />

        <ui:VisualElement name="debug-panel" class="debug-panel hidden" />

        <ui:VisualElement name="dialogue" class="dialogue hidden">
            <ui:ScrollView name="dialogue-log" class="dialogue-log hidden" />
            <ui:VisualElement class="dialogue-tools">
                <ui:Button name="dialogue-log-button" class="dialogue-tool" />
                <ui:Button name="dialogue-auto" class="dialogue-tool" />
                <ui:Button name="dialogue-skip" class="dialogue-tool" />
            </ui:VisualElement>
            <ui:VisualElement name="dialogue-box" class="dialogue-box">
                <ui:Label name="dialogue-speaker" class="dialogue-speaker" />
                <ui:Label name="dialogue-text" class="dialogue-text" />
                <ui:VisualElement name="dialogue-options" class="dialogue-options" />
                <ui:Label name="dialogue-next" class="dialogue-next hidden" text="▼" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="overlay" class="overlay hidden">
            <ui:VisualElement name="card" class="card">
                <ui:Label name="card-title" class="card-title" />
                <ui:Label name="card-body" class="card-body" />
                <ui:VisualElement name="card-extra" class="card-extra" />
                <ui:VisualElement name="card-buttons" class="card-buttons" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
