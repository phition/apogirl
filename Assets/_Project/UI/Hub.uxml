<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <!--
        허브는 다섯 겹이다 (Docs/UI_REDESIGN_PROPOSAL.md).
        0겹 장면(scene) → 1겹 상시 표시(hud-top·standing·teacher-box·dock·ticker)
        → 2겹 서랍과 계획 보드(drawer-left·drawer-right·board) → 3겹 카드(overlay) → 4겹 대화(dialogue).
    -->
    <ui:VisualElement name="screen" class="screen hub">
        <!-- 0겹: 장면 -->
        <ui:VisualElement name="scene" class="scene">
            <ui:VisualElement name="backdrop" class="backdrop">
                <ui:Label name="backdrop-label" class="backdrop-label" />
            </ui:VisualElement>
            <ui:VisualElement name="scene-shade" class="scene-shade" picking-mode="Ignore" />
            <!-- 학교 단면도 (선생님을 만난 뒤부터; 그 전에는 위의 거처 그림) -->
            <ui:VisualElement name="section-frame" class="section-frame hidden">
                <ui:VisualElement name="section" class="section" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 1겹: 상시 표시 -->
        <ui:VisualElement name="hud-top" class="hud-top">
            <ui:Label name="calendar-label" class="calendar" />
            <ui:VisualElement name="resources" class="resources" />
            <ui:Button name="record-button" class="hud-button" />
            <ui:Button name="base-button" class="hud-button" />
            <ui:Button name="people-button" class="hud-button" />
            <ui:Button name="save-button" class="hud-button" />
            <ui:Button name="menu-button" class="hud-button" />
        </ui:VisualElement>

        <ui:VisualElement name="standing-area" class="standing-area">
            <ui:VisualElement name="standing" class="standing" />
            <ui:VisualElement name="vitals-mini" class="vitals-mini" />
        </ui:VisualElement>

        <ui:VisualElement name="teacher-box" class="teacher-box">
            <ui:Label name="teacher-name" class="teacher-name" />
            <ui:Label name="teacher-line" class="teacher-line" />
        </ui:VisualElement>

        <ui:VisualElement name="ticker" class="ticker" picking-mode="Ignore" />

        <ui:VisualElement name="dock" class="dock">
            <ui:Button name="plan-open-button" class="dock-plan" />
            <ui:VisualElement name="dock-slots" class="dock-slots" />
            <ui:VisualElement name="speed-buttons" class="dock-speed" />
            <ui:Button name="run-button" class="run-button" />
        </ui:VisualElement>

        <!-- 2겹: 서랍과 계획 보드 -->
        <ui:VisualElement name="drawer-left" class="drawer drawer-left closed">
            <ui:VisualElement class="drawer-head">
                <ui:Label name="drawer-left-title" class="drawer-title" />
                <ui:Button name="drawer-left-close" class="drawer-close" />
            </ui:VisualElement>
            <ui:ScrollView name="status-panel" class="drawer-body status-panel" />
        </ui:VisualElement>

        <!-- 보관함: 생활기록부 서랍과 함께 열린다 (StorageView) -->
        <ui:VisualElement name="drawer-storage" class="drawer-storage closed">
            <ui:Label name="storage-title" class="storage-title" />
            <ui:ScrollView name="storage-list" class="storage-list" />
        </ui:VisualElement>

        <ui:VisualElement name="drawer-right" class="drawer drawer-right closed">
            <ui:VisualElement class="drawer-head">
                <ui:Label name="drawer-right-title" class="drawer-title" />
                <ui:Button name="drawer-right-close" class="drawer-close" />
            </ui:VisualElement>
            <ui:ScrollView name="base-panel" class="drawer-body base-panel" />
        </ui:VisualElement>

        <ui:VisualElement name="drawer-people" class="drawer drawer-right drawer-people closed">
            <ui:VisualElement class="drawer-head">
                <ui:Label name="drawer-people-title" class="drawer-title" />
                <ui:Button name="drawer-people-close" class="drawer-close" />
            </ui:VisualElement>
            <ui:ScrollView name="people-panel" class="drawer-body people-panel" />
            <!-- 세력 덧판: 인물 서랍 왼쪽 가장자리의 화살표 탭을 누르면 왼쪽으로 펼쳐진다 (FactionAddonView) -->
            <ui:VisualElement name="people-factions" class="people-factions hidden">
                <ui:VisualElement name="people-factions-sheet" class="people-factions-sheet hidden">
                    <ui:Label name="people-factions-title" class="section-header" />
                    <ui:ScrollView name="people-factions-list" class="people-factions-list" />
                </ui:VisualElement>
                <ui:Button name="people-factions-tab" class="people-factions-tab" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="board" class="board closed">
            <ui:VisualElement class="board-head">
                <ui:Label name="board-title" class="board-title" />
                <ui:Label name="board-hint" class="board-hint" />
                <!-- 선생님 추천 · 되돌리기 · 다시 하기 · 전부 비우기 (HubScreen.BindBoardTools) -->
                <ui:VisualElement name="board-tools" class="board-tools" />
                <ui:Button name="board-close" class="drawer-close" />
            </ui:VisualElement>
            <ui:VisualElement class="board-body">
                <ui:VisualElement name="palette" class="palette">
                    <ui:VisualElement name="palette-tabs" class="palette-tabs" />
                    <ui:Label name="palette-hint" class="palette-hint" />
                    <ui:ScrollView name="palette-list" class="palette-list" />
                </ui:VisualElement>
                <ui:VisualElement class="planner-col">
                    <ui:VisualElement name="planner" class="planner" />
                    <!-- 흐름 띠: 칸마다 예상 피로·스트레스·수면 부채, 아래 능력치 기대 증감 (PlanFlowView) -->
                    <ui:VisualElement name="plan-flow" class="plan-flow" />
                </ui:VisualElement>
                <ui:VisualElement name="plan-side" class="plan-side">
                    <ui:VisualElement name="teacher-memo" class="teacher-memo hidden" />
                    <ui:Label name="slot-detail" class="slot-detail" />
                    <ui:ScrollView name="warnings" class="warnings" />
                    <ui:Label name="forecast" class="forecast" />
                    <ui:VisualElement name="plan-buttons" class="button-row" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" class="toast hidden" />

        <ui:VisualElement name="debug-panel" class="debug-panel hidden" />

        <!-- 3겹 전용 화면: 주간 결산(일기장), 출정 준비 -->
        <ui:VisualElement name="settlement" class="sheet settlement hidden">
            <ui:VisualElement name="settle-book" class="settle-book">
                <ui:VisualElement name="settle-left" class="settle-page settle-left" />
                <ui:VisualElement name="settle-right" class="settle-page settle-right" />
            </ui:VisualElement>
            <ui:VisualElement name="settle-buttons" class="settle-buttons" />
        </ui:VisualElement>

        <ui:VisualElement name="expedition-sheet" class="sheet expedition-sheet hidden">
            <ui:VisualElement name="exp-art" class="exp-art">
                <ui:VisualElement class="exp-art-shade" picking-mode="Ignore" />
                <ui:VisualElement name="exp-info" class="exp-info" />
            </ui:VisualElement>
            <ui:VisualElement name="exp-side" class="exp-side">
                <ui:VisualElement name="exp-standing" class="exp-standing" />
                <ui:VisualElement name="exp-panel" class="exp-panel">
                    <ui:VisualElement name="exp-loadout" class="exp-loadout" />
                    <ui:VisualElement name="exp-buttons" class="exp-buttons" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="faction-sheet" class="sheet faction-sheet hidden">
            <ui:VisualElement class="fac-panel">
                <ui:VisualElement class="fac-head">
                    <ui:VisualElement name="fac-portrait" class="fac-portrait" />
                    <ui:VisualElement name="fac-intro" class="fac-intro" />
                    <ui:Button name="fac-close" class="drawer-close" />
                </ui:VisualElement>
                <ui:VisualElement class="fac-body">
                    <ui:ScrollView name="fac-trades" class="fac-trades" />
                    <ui:ScrollView name="fac-log" class="fac-log" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3겹: 이번 주 배분하기 (한 주 실행 직전) -->
        <ui:VisualElement name="give-sheet" class="sheet give-sheet hidden">
            <ui:VisualElement class="give-panel">
                <ui:VisualElement class="give-head">
                    <ui:Label name="give-title" class="give-title" />
                    <ui:Label name="give-stock" class="give-stock" />
                </ui:VisualElement>
                <ui:VisualElement name="give-diet" class="give-diet" />
                <ui:Label name="give-hint" class="give-hint" />
                <ui:ScrollView name="give-list" class="give-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                <ui:VisualElement name="give-buttons" class="give-buttons" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4겹: 대화 -->
        <ui:VisualElement name="dialogue" class="dialogue hidden">
            <ui:ScrollView name="dialogue-log" class="dialogue-log hidden" />
            <ui:VisualElement class="dialogue-tools">
                <ui:Button name="dialogue-log-button" class="dialogue-tool" />
                <ui:Button name="dialogue-auto" class="dialogue-tool" />
                <ui:Button name="dialogue-skip" class="dialogue-tool" />
            </ui:VisualElement>
            <ui:VisualElement name="dialogue-box" class="dialogue-box">
                <ui:Label name="dialogue-speaker" class="dialogue-speaker" />
                <ui:Label name="dialogue-text" class="dialogue-text" />
                <ui:VisualElement name="dialogue-options" class="dialogue-options" />
                <ui:Label name="dialogue-next" class="dialogue-next hidden" text="▼" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3겹: 카드 (결과·결산·세력 등, 전용 화면으로 나누기 전까지) -->
        <ui:VisualElement name="overlay" class="overlay hidden">
            <ui:VisualElement name="card" class="card">
                <ui:Label name="card-title" class="card-title" />
                <ui:Label name="card-body" class="card-body" />
                <ui:VisualElement name="card-extra" class="card-extra" />
                <ui:VisualElement name="card-buttons" class="card-buttons" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
