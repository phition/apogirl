/* 탐험 HUD — 어두운 분위기 + 최소 UI (문서 10장) */

.exp-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    color: var(--text);
}

.exp-top { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.exp-location-label { font-size: 20px; -unity-font-style: bold; color: var(--accent); }
.exp-room-label { color: var(--text-dim); }

/* 유랑자 나침반 뱃지: 위치 정보 아래에 늘 붙는 백의 한마디 (나가는 길) */
.exp-compass-badge {
    flex-direction: row; align-items: center; align-self: flex-start; margin-top: 6px;
    padding: 3px 12px 3px 4px; background-color: rgba(30, 24, 16, 0.78);
    border-width: 1px; border-color: rgba(240, 207, 107, 0.6); border-radius: 14px;
}
.exp-compass-icon { width: 24px; height: 24px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }
.exp-compass-label { color: #e6d2a8; font-size: 15px; }

.exp-clock { width: 420px; }
.exp-clock-row { flex-direction: row; justify-content: flex-end; align-items: center; }
.exp-clock-phase { -unity-font-style: bold; margin-right: 10px; }
.exp-clock-time { font-size: 20px; min-width: 70px; -unity-text-align: middle-right; }
.exp-debug { color: #9a9ae0; margin-left: 8px; }
.exp-clock-bar { height: 16px; margin: 4px 0; }
.exp-clock-bar .unity-progress-bar__background { background-color: rgba(0, 0, 0, 0.6); border-color: var(--line); }
.exp-clock-bar .unity-progress-bar__progress { background-color: #f0cf6b; }
.exp-clock-bar.late .unity-progress-bar__progress { background-color: #c9584f; }

.exp-spacer { flex-grow: 1; }

.exp-prompt { align-items: center; margin-bottom: 18px; }
.exp-prompt-label {
    font-size: 19px;
    padding: 4px 14px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
}
.exp-search-bar { width: 260px; height: 12px; margin-top: 6px; }

/* 스태미너: 초록 = 지금, 붉은 칸 = 피로·부상으로 이번 탐험 동안 깎인 최대치, 숨이 차면 주황 */
.exp-stamina { flex-direction: row; align-items: center; margin: 2px 0 4px 0; }
.exp-stamina-label { font-size: 14px; color: rgb(220, 220, 214); margin-right: 8px; -unity-text-align: middle-left; }
.exp-stamina-track { width: 160px; height: 10px; background-color: rgba(20, 20, 22, 0.85); border-width: 1px; border-color: rgba(200, 200, 190, 0.5); }
.exp-stamina-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(118, 196, 112); }
.exp-stamina-fill.exhausted { background-color: rgb(226, 150, 60); }
.exp-stamina-lost { position: absolute; top: 0; bottom: 0; background-color: rgba(190, 52, 46, 0.85); }
.exp-sleep-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.72); }
.exp-search-bar .unity-progress-bar__progress { background-color: var(--ok); }

.exp-bottom { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.exp-status-label {
    padding: 2px 10px;
    background-color: rgba(0, 0, 0, 0.5);
    margin-top: 2px;
}
.exp-status-label.danger { color: var(--danger); }
.exp-controls { color: var(--text-dim); font-size: 14px; max-width: 900px; -unity-text-align: lower-right; }

.exp-panel {
    position: absolute;
    padding: 12px;
    background-color: rgba(28, 40, 36, 0.95);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 6px;
}
.exp-panel-title { -unity-font-style: bold; color: var(--accent); margin-bottom: 6px; }
.exp-panel-buttons { flex-direction: row; justify-content: flex-end; margin-top: 6px; }

.exp-loot { left: 30%; top: 22%; width: 420px; max-height: 420px; }
.exp-loot-list { max-height: 300px; }
.loot-row { -unity-text-align: middle-left; height: 34px; }

.exp-backpack { right: 16px; top: 110px; }
.bp-grid { position: relative; }
.bp-cell { background-color: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.12); border-width: 1px; }
.bp-item {
    background-color: #55532e;
    border-color: #f0cf6b;
    border-width: 1px;
    border-radius: 3px;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.bp-item.selected { background-color: #77733c; border-color: #ffffff; }

.exp-message {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 40%;
    padding: 12px 18px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 6px;
    -unity-text-align: middle-center;
    font-size: 19px;
}

.exp-activity { -unity-text-align: middle-right; color: var(--text-dim); }
.exp-activity.danger { color: var(--danger); }
.exp-status-label.danger { color: var(--danger); }
.exp-stir-bar { width: 320px; height: 16px; margin-bottom: 6px; }
.exp-stir-bar .unity-progress-bar__background { background-color: rgba(0, 0, 0, 0.6); }
.exp-stir-bar .unity-progress-bar__progress { background-color: #c9584f; }
.exp-stir-bar .unity-progress-bar__title { font-size: 12px; color: var(--text); }
.exp-hidden { color: #9ad0ff; -unity-font-style: bold; margin-bottom: 6px; }

.world-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.zzz {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(178, 204, 230);
}

/* ── M4: 튜토리얼 안내, 조우 ── */
.exp-tutorial {
    color: #f0d89a;
    background-color: rgba(30, 28, 20, 0.85);
    padding: 6px 14px;
    border-radius: 6px;
    margin-bottom: 8px;
    font-size: 18px;
}

.exp-encounter {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 28%;
    padding: 16px 20px;
}

.exp-encounter-text { white-space: normal; font-size: 18px; margin-bottom: 12px; }
.exp-encounter-choices { flex-direction: column; }
.exp-encounter-choice { height: 38px; margin: 3px 0; -unity-text-align: middle-left; padding-left: 12px; }

/* 밝은 벽 위에서도 읽히도록 상단 정보에 어두운 바탕 */
.exp-location, .exp-clock {
    background-color: rgba(10, 10, 12, 0.62);
    padding: 4px 10px;
    border-radius: 4px;
}

/* 아이템 그림 (M6-5) */
.loot-row.with-icon { padding-left: 36px; }
.bp-item.with-item-icon {
    -unity-text-align: lower-center;
    font-size: 11px;
    color: #ffffff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

/* 하단 장비 칸 (무기·가방·도구): 배낭에서 고른 장비를 놓으면 장착, 우클릭하면 벗는다 */
.exp-equip-slots { flex-direction: row; align-items: flex-end; margin: 0 12px; }
.exp-equip-slot {
    width: 108px;
    height: 112px;
    margin: 0 4px;
    padding: 4px;
    align-items: center;
    background-color: rgba(10, 10, 12, 0.72);
    border-width: 2px;
    border-color: rgba(240, 207, 107, 0.45);
    border-radius: 6px;
}
.exp-equip-slot:hover { border-color: rgba(240, 207, 107, 0.8); }
.exp-equip-slot.empty .exp-equip-name { color: var(--text-dim); }
.exp-equip-slot.droppable { border-color: #f0cf6b; background-color: rgba(90, 70, 30, 0.8); }
.exp-equip-head { font-size: 13px; color: var(--accent); -unity-font-style: bold; }
.exp-equip-icon { width: 54px; height: 54px; margin: 2px 0; }
.exp-equip-name { font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; color: #ffffff; }
.bp-hint { font-size: 12px; color: var(--text-dim); margin-top: 6px; white-space: normal; max-width: 420px; }

/* 배낭 물건 미니창: 좌클릭한 물건의 설명·분류·효과와 사용/장착/버리기 (ExpeditionHud.ShowInfo) */
.bp-info {
    padding: 10px 12px;
    background-color: rgba(18, 27, 24, 0.96);
    border-width: 2px;
    border-color: rgba(240, 207, 107, 0.75);
    border-radius: 6px;
}
.bp-info-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.bp-info-name { font-size: 17px; -unity-font-style: bold; color: #ffffff; flex-shrink: 1; }
.bp-info-cat { font-size: 13px; -unity-font-style: bold; color: var(--accent); margin-left: 6px; flex-grow: 1; }
.bp-info-close { width: 26px; height: 26px; padding: 0; margin: 0; font-size: 13px; background-color: rgba(255, 255, 255, 0.06); border-width: 0; }
.bp-info-desc { font-size: 13px; color: #d8d2c4; white-space: normal; margin-bottom: 4px; }
.bp-info-effect { font-size: 14px; -unity-font-style: bold; color: #cfe3c0; white-space: normal; margin-bottom: 2px; }
.bp-info-effect.consumable { color: #8fe07a; }
.bp-info-size { font-size: 12px; color: var(--text-dim); margin-bottom: 6px; }
.bp-info-buttons { flex-direction: row; }
.bp-info-button { flex-grow: 1; height: 32px; margin: 0 3px 0 0; font-size: 14px; -unity-font-style: bold; background-color: rgba(255, 255, 255, 0.08); border-color: rgba(240, 207, 107, 0.45); }
.bp-info-button.primary { background-color: rgba(150, 110, 40, 0.85); color: #ffffff; border-color: #f0cf6b; }
.bp-info-button:hover { border-color: #f0cf6b; }

/* ══ fablable 0.1 — 탐험 HUD: 분위기를 가리지 않는 분필 글씨와 얇은 칠판 띠 (Docs/UI_FABLABLE_DESIGN.md) ══ */
.exp-location-label, .exp-panel-title, .exp-equip-head { -unity-font-definition: url("Fonts/HakgyoansimEdge.ttf"); }
.exp-location-label { color: var(--text); font-size: 22px; }
.exp-location, .exp-clock {
    background-color: rgba(18, 27, 24, 0.72);
    border-radius: 3px;
    border-bottom-width: 2px;
    border-color: rgba(155, 116, 72, 0.8);
}
.exp-clock-bar .unity-progress-bar__background, .exp-stir-bar .unity-progress-bar__background { border-color: var(--chalk-line); border-radius: 3px; }
.exp-prompt-label { background-color: rgba(18, 27, 24, 0.82); border-radius: 3px; border-bottom-width: 2px; border-color: var(--chalk-line); }
.exp-status-label { background-color: rgba(18, 27, 24, 0.62); border-radius: 3px; }
.exp-panel {
    background-color: rgb(22, 32, 28);
    border-width: 3px;
    border-color: var(--wood);
    border-radius: 4px;
}
.exp-panel-title { color: var(--text); font-size: 19px; }
.bp-cell { background-color: rgba(238, 236, 225, 0.05); border-color: rgba(238, 236, 225, 0.14); }
.bp-item { border-radius: 2px; }
.bp-item.selected { border-color: #ffffff; }
.exp-equip-slot { border-radius: 4px; border-color: var(--chalk-line); background-color: rgba(18, 27, 24, 0.78); }
.exp-equip-slot:hover { border-color: var(--accent); }
.exp-equip-slot.droppable { border-color: var(--accent); background-color: rgba(85, 83, 46, 0.9); }
.bp-info { border-radius: 4px; border-color: var(--accent); }
.bp-info-button.primary { background-color: var(--accent); color: var(--ink); border-color: #fff3c4; }
.exp-message { background-color: rgba(18, 27, 24, 0.9); border-radius: 3px; border-top-width: 3px; border-color: var(--wood); }
/* 튜토리얼 안내는 노란 포스트잇 */
.exp-tutorial { background-color: var(--note); color: var(--ink); border-radius: 2px; border-bottom-width: 2px; border-color: rgba(120, 100, 20, 0.4); }
.exp-encounter-choice { background-color: rgba(238, 236, 225, 0.05); border-width: 0; border-bottom-width: 1px; border-color: var(--chalk-line); border-radius: 0; }
.exp-encounter-choice:hover { background-color: rgba(240, 207, 107, 0.24); border-color: var(--accent); color: var(--accent); }
