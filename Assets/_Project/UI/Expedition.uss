/* 탐험 HUD — 어두운 분위기 + 최소 UI (문서 10장) */

.exp-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    color: var(--text);
}

.exp-top { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.exp-location-label { font-size: 20px; -unity-font-style: bold; color: var(--accent); }
.exp-room-label { color: var(--text-dim); }

.exp-clock { width: 420px; }
.exp-clock-row { flex-direction: row; justify-content: flex-end; align-items: center; }
.exp-clock-phase { -unity-font-style: bold; margin-right: 10px; }
.exp-clock-time { font-size: 20px; min-width: 70px; -unity-text-align: middle-right; }
.exp-debug { color: #9a9ae0; margin-left: 8px; }
.exp-clock-bar { height: 16px; margin: 4px 0; }
.exp-clock-bar .unity-progress-bar__background { background-color: rgba(0, 0, 0, 0.6); border-color: var(--line); }
.exp-clock-bar .unity-progress-bar__progress { background-color: #b9a37a; }
.exp-clock-bar.late .unity-progress-bar__progress { background-color: #c9584f; }

.exp-spacer { flex-grow: 1; }

.exp-prompt { align-items: center; margin-bottom: 18px; }
.exp-prompt-label {
    font-size: 19px;
    padding: 4px 14px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
}
.exp-search-bar { width: 260px; height: 12px; margin-top: 6px; }

/* 스태미너: 초록 = 지금, 붉은 칸 = 피로·부상으로 이번 탐험 동안 깎인 최대치, 숨이 차면 주황 */
.exp-stamina { flex-direction: row; align-items: center; margin: 2px 0 4px 0; }
.exp-stamina-label { font-size: 14px; color: rgb(220, 220, 214); margin-right: 8px; -unity-text-align: middle-left; }
.exp-stamina-track { width: 160px; height: 10px; background-color: rgba(20, 20, 22, 0.85); border-width: 1px; border-color: rgba(200, 200, 190, 0.5); }
.exp-stamina-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(118, 196, 112); }
.exp-stamina-fill.exhausted { background-color: rgb(226, 150, 60); }
.exp-stamina-lost { position: absolute; top: 0; bottom: 0; background-color: rgba(190, 52, 46, 0.85); }
.exp-sleep-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.72); }
.exp-search-bar .unity-progress-bar__progress { background-color: var(--ok); }

.exp-bottom { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.exp-status-label {
    padding: 2px 10px;
    background-color: rgba(0, 0, 0, 0.5);
    margin-top: 2px;
}
.exp-status-label.danger { color: var(--danger); }
.exp-controls { color: var(--text-dim); font-size: 14px; max-width: 900px; -unity-text-align: lower-right; }

.exp-panel {
    position: absolute;
    padding: 12px;
    background-color: rgba(30, 32, 36, 0.95);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 6px;
}
.exp-panel-title { -unity-font-style: bold; color: var(--accent); margin-bottom: 6px; }
.exp-panel-buttons { flex-direction: row; justify-content: flex-end; margin-top: 6px; }

.exp-loot { left: 30%; top: 22%; width: 420px; max-height: 420px; }
.exp-loot-list { max-height: 300px; }
.loot-row { -unity-text-align: middle-left; height: 34px; }

.exp-backpack { right: 16px; top: 110px; }
.bp-grid { position: relative; }
.bp-cell { background-color: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.12); border-width: 1px; }
.bp-item {
    background-color: #5b5242;
    border-color: #b9a37a;
    border-width: 1px;
    border-radius: 3px;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.bp-item.selected { background-color: #7a6a4a; border-color: #ffffff; }

.exp-message {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 40%;
    padding: 12px 18px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 6px;
    -unity-text-align: middle-center;
    font-size: 19px;
}

.exp-activity { -unity-text-align: middle-right; color: var(--text-dim); }
.exp-activity.danger { color: var(--danger); }
.exp-status-label.danger { color: var(--danger); }
.exp-stir-bar { width: 320px; height: 16px; margin-bottom: 6px; }
.exp-stir-bar .unity-progress-bar__background { background-color: rgba(0, 0, 0, 0.6); }
.exp-stir-bar .unity-progress-bar__progress { background-color: #c9584f; }
.exp-stir-bar .unity-progress-bar__title { font-size: 12px; color: var(--text); }
.exp-hidden { color: #9ad0ff; -unity-font-style: bold; margin-bottom: 6px; }

.world-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.zzz {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(178, 204, 230);
}

/* ── M4: 튜토리얼 안내, 조우 ── */
.exp-tutorial {
    color: #f0d89a;
    background-color: rgba(30, 28, 20, 0.85);
    padding: 6px 14px;
    border-radius: 6px;
    margin-bottom: 8px;
    font-size: 18px;
}

.exp-encounter {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 28%;
    padding: 16px 20px;
}

.exp-encounter-text { white-space: normal; font-size: 18px; margin-bottom: 12px; }
.exp-encounter-choices { flex-direction: column; }
.exp-encounter-choice { height: 38px; margin: 3px 0; -unity-text-align: middle-left; padding-left: 12px; }

/* 밝은 벽 위에서도 읽히도록 상단 정보에 어두운 바탕 */
.exp-location, .exp-clock {
    background-color: rgba(10, 10, 12, 0.62);
    padding: 4px 10px;
    border-radius: 4px;
}

/* 아이템 그림 (M6-5) */
.loot-row.with-icon { padding-left: 36px; }
.bp-item.with-item-icon {
    -unity-text-align: lower-center;
    font-size: 11px;
    color: #ffffff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

/* 하단 장비 칸 (무기·가방·도구): 배낭에서 고른 장비를 놓으면 장착, 우클릭하면 벗는다 */
.exp-equip-slots { flex-direction: row; align-items: flex-end; margin: 0 12px; }
.exp-equip-slot {
    width: 108px;
    height: 112px;
    margin: 0 4px;
    padding: 4px;
    align-items: center;
    background-color: rgba(10, 10, 12, 0.72);
    border-width: 2px;
    border-color: rgba(185, 163, 122, 0.45);
    border-radius: 6px;
}
.exp-equip-slot:hover { border-color: rgba(231, 176, 74, 0.8); }
.exp-equip-slot.empty .exp-equip-name { color: var(--text-dim); }
.exp-equip-slot.droppable { border-color: #e7b04a; background-color: rgba(90, 70, 30, 0.8); }
.exp-equip-head { font-size: 13px; color: var(--accent); -unity-font-style: bold; }
.exp-equip-icon { width: 54px; height: 54px; margin: 2px 0; }
.exp-equip-name { font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; color: #ffffff; }
.bp-hint { font-size: 12px; color: var(--text-dim); margin-top: 6px; white-space: normal; max-width: 420px; }
