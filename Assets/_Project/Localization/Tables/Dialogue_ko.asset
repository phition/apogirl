%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 33f6960b278f4ad429ad72f31ea481ac, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 315716585930780
    m_Localized: "\uBCF8\uAD00 \uCC3D\uACE0 \uCCA0\uBB38\uC774 \uB2EB\uD788\uC790 \uB458 \uB2E4 \uD55C\uCC38 \uC228\uB9CC \uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930779
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uBE68\uB9AC \uBABB \uC6C0\uC9C1\uC5EC. \uB124\uAC00 \uC55E\uC7A5\uC11C \uC918\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930778
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBCF8\uAD00 \uCC3D\uACE0\uC5D0 \uBB3C\uC774\uB791 \uBA39\uC744 \uAC8C \uC870\uAE08 \uC788\uC5B4. \uAC70\uAE30\uAE4C\uC9C0\uB9CC \uAC19\uC774 \uAC00\uC790. \uC18C\uB9AC \uB0B4\uC9C0 \uB9D0\uACE0, \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213192
    m_Localized: "\uC624\uB298\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213191
    m_Localized: "\uB3C4\uC11C\uAD00\uC5D0\uC11C \uAC00\uC838\uC628 \uC2E0\uBB38 \uC0AC\uC774\uC5D0 \uC804\uB2E8\uC9C0\uAC00 \uB07C\uC5B4 \uC788\uC5C8\uB2E4. \uC0C8\uBCBD\uC2DC \uC5EC\uB984 \uCD95\uC81C, 7\uC6D4 28\uC77C, \uAC15\uBCC0 \uBD88\uAF43\uB180\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930777
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0AE\uC5D0\uB294 \uC800\uB807\uAC8C \uC7A0\uB4E4\uC5B4 \uC788\uC5B4. \uBC24\uC5D0\uB294\u2026 \uB098\uC911\uC5D0 \uC598\uAE30\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930776
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5 \uB300\uC2E0 \uCC3D\uACE0 \uBC16 \uBCF5\uB3C4\uB97C \uAC00\uB9AC\uCF30\uB2E4. \uBCF5\uB3C4 \uB05D\uC5D0 \uBB34\uC5B8\uAC00 \uC11C \uC788\uC5C8\uB2E4. \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uACE0, \uACE0\uAC1C\uB9CC \uC219\uC778 \uCC44."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930775
    m_Localized: "{0}: \u2026\uBC16\uC5D0, \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930774
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBB3C\uC790\uB97C \uCC3E\uB2E4\uAC00 \uC18C\uB9AC\uB97C \uB4E4\uC5C8\uC5B4. \uC77C\uC8FC\uC77C \uB3D9\uC548 \uD63C\uC790 \uC788\uC5C8\uB358 \uAC70\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213190
    m_Localized: "\uB3D9\uADF8\uB77C\uBBF8 \uC2DC\uAC04\uD45C\uB97C \uADF8\uB838\uB2E4. \uACF5\uBD80, \uD0D0\uD5D8, \uD734\uC2DD, \uADF8\uB9AC\uACE0 \uB9E8 \uC544\uB798 '\uC625\uC0C1\uC5D0\uC11C \uBCC4 \uBCF4\uAE30'."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213189
    m_Localized: "\uBC29\uD559 \uACC4\uD68D\uD45C\uB97C \uC9E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212686
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uB294 \uADF8\uB807\uAC8C \uB0A8\uB294 \uAC70\uC57C. \uC885\uC774\uAC00 \uC5C6\uC5B4\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930773
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4\uB2F4\uB2F9 \uC724\uC601\uD604\uC774\uC57C. 1\uD559\uB144 \uC218\uC5C5\uC740 \uC544\uC9C1 \uD55C \uBC88\uB3C4 \uBABB \uB4E4\uC5B4\uAC14\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930772
    m_Localized: "\uBAA9\uC18C\uB9AC\uC758 \uC8FC\uC778\uC740 \uBC14\uB2E5\uC5D0 \uC549\uC740 \uCC44 \uBCBD\uC5D0 \uB4F1\uC744 \uAE30\uB300\uACE0 \uC788\uC5C8\uB2E4. \uD55C\uCABD \uBC14\uC9C0 \uC790\uB77D\uC774 \uBB34\uB98E \uC544\uB798\uC5D0\uC11C \uBD95\uB300\uB85C \uBB36\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930771
    m_Localized: "???: \u2026\uC0B4\uC544 \uC788\uAD6C\uB098. \uB2E4\uD589\uC774\uB2E4. \uC815\uB9D0 \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930770
    m_Localized: "\uBB38\uC774 \uC5F4\uB838\uB2E4. \uB208\uC774 \uBD80\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930769
    m_Localized: "???: \u2026\uAC70\uAE30, \uB204\uAD6C \uC788\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213188
    m_Localized: "\uC624\uB79C\uB9CC\uC5D0 \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB9E4\uBBF8 \uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA70 \uB0AE\uC7A0\uC744 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213187
    m_Localized: "\uD558\uB8E8 \uC885\uC77C \uD479 \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930768
    m_Localized: "\uADF8\uB9AC\uACE0, \uC0AC\uB78C\uC758 \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930767
    m_Localized: "\uC77C\uACF1\uC9F8 \uB0A0 \uC0C8\uBCBD. \uBB38 \uB108\uBA38\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uAE30\uC5B4 \uC624\uB294 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930766
    m_Localized: "{0}: \u2026\uC870\uAE08\uB9CC \uB354."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930765
    m_Localized: "\uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uAE08\uC744 \uD558\uB098 \uB354 \uADF8\uC5C8\uB2E4. \uC5EC\uC12F."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930764
    m_Localized: "\uC5EC\uC12F\uC9F8 \uB0A0. \uBE44\uAC00 \uC654\uB2E4. \uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C \uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213186
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984\uBC29\uD559\uC774\uB2E4. \uC219\uC81C\uB294\u2026 \uC0B4\uC544\uB0A8\uAE30. \uADF8\uB9AC\uACE0 \uC77C\uAE30 \uC4F0\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213007
    m_Localized: "\uB2F4\uC784 \uC758\uACAC\uB780\uC5D0 \uC5F0\uD544\uB85C \uC801\uD78C \uBA54\uBAA8\uAC00 \uBCF4\uC600\uB2E4. \uAC19\uC740 \uC911\uD559\uAD50 \uCD9C\uC2E0 \uD559\uC0DD\uB4E4\uACFC\uC758 \uAD00\uACC4 \uAD00\uCC30 \uC694\uB9DD, \uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214532
    m_Localized: "\uADF8\uB0A0 \uC800\uB141, \uC120\uC0DD\uB2D8\uC740 \uCC3D\uACE0 \uC548\uC744 \uBA87 \uBC88\uC774\uACE0 \uC655\uBCF5\uD588\uB2E4. \uBC1C\uC18C\uB9AC\uAC00 \uC870\uAE08 \uC6B0\uC2A4\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930763
    m_Localized: "\uC0DD\uC218 \uBC15\uC2A4 \uC548\uC774 \uB208\uC5D0 \uB744\uAC8C \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930762
    m_Localized: "\uC228\uC744 \uCC38\uC558\uB2E4. \uC18C\uB9AC\uB294 \uC544\uC8FC \uC624\uB798 \uBA38\uBB3C\uB2E4 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930761
    m_Localized: "\uB2E4\uC12F\uC9F8 \uB0A0. \uBB38 \uBC14\uB85C \uBC16\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB04C\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930760
    m_Localized: "{0}\uC758 \uC5BC\uAD74\uC774 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC560\uB294 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930759
    m_Localized: "{0}\uC5D0\uAC8C \uD138\uC5B4\uB193\uC558\uB358 \uC774\uC57C\uAE30\uAC00 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC560\uB294 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213006
    m_Localized: "\uADF8 \uC548\uC5D0 \uB0B4 \uC774\uB984\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213005
    m_Localized: "1\uD559\uB144 \uBD80\uC7A5 \uC120\uC0DD\uB2D8 \uCC45\uC0C1 \uC606 \uCE90\uBE44\uB2DB. '1\uD559\uB144 \uD559\uC0DD\uC0DD\uD65C\uAE30\uB85D\uBD80'\uB77C\uACE0 \uC801\uD78C \uD30C\uC77C\uCCA0."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214531
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70 \uC9C4\uC9DC \uC798 \uB9CC\uB4E4\uC5C8\uB2E4. \uACF5\uD559 \uC120\uC0DD\uB2D8 \uD558\uB098 \uC0DD\uAE34 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212685
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB410\uB2E4. \uC774\uC81C \uC774 \uC2DC\uB97C \uC678\uC6B0\uB294 \uC0AC\uB78C\uC774 \uC5EC\uAE30 \uB458\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212684
    m_Localized: "\uB450 \uBC88 \uB9CC\uC5D0 \uC678\uC6E0\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uBF09\uC744 \uCE58\uB824\uB2E4 \uC18C\uB9AC \uB0A0\uAE4C \uBD10 \uD5C8\uACF5\uC5D0\uC11C \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930758
    m_Localized: "\uB0A0\uC9DC\uB97C \uC78A\uC9C0 \uC54A\uC73C\uB824\uACE0 \uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uC190\uD1B1\uC73C\uB85C \uAE08\uC744 \uADF8\uC5C8\uB2E4. \uD558\uB098, \uB458, \uC14B, \uB137."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930757
    m_Localized: "\uD734\uB300\uD3F0 \uD654\uBA74\uC774 \uAEBC\uC84C\uB2E4. \uB2E4\uC2DC \uCF1C\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930756
    m_Localized: "\uB137\uC9F8 \uB0A0. \uC815\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930755
    m_Localized: "\uBC1C\uC18C\uB9AC\uB294 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930754
    m_Localized: "\uB204\uAD70\uAC00 \uBCF5\uB3C4\uB97C \uB2EC\uB824\uAC14\uB2E4. \uBB38\uC744 \uB450\uB4DC\uB9AC\uACE0 \uC18C\uB9AC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212683
    m_Localized: "\uB530\uB77C\uC11C \uC678\uC6CC \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407547
    m_Localized: "{0}: \uC624\uCF00\uC774, \uC800\uC7A5 \uC644\uB8CC. \uC774\uBC88\uC5D4 \uC9C4\uC9DC \uC548 \uAE4C\uBA39\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407548
    m_Localized: "{0}: \uADFC\uB370 \uB108 \uADF8 \uAC80\uC0AC \uD574 \uBD24\uC5B4? \uB124 \uAE00\uC790 \uB098\uC624\uB294 \uAC70. I\uC57C, E\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407549
    m_Localized: "\uC54C\uC544. \uB0B4 \uB124 \uAE00\uC790\uB294\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407550
    m_Localized: "{0}: \uC624, \uC5ED\uC2DC. \uB531 \uB108 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930753
    m_Localized: "\uC14B\uC9F8 \uB0A0. \uC0AC\uC774\uB80C\uC774 \uC6B8\uB838\uB2E4. \uBA40\uB9AC\uC11C \uBE44\uBA85 \uAC19\uC740 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930752
    m_Localized: "\uBB3C\uB9DB\uC774 \uC774\uC0C1\uD558\uAC8C \uB2EC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736454
    m_Localized: "\uB300\uD68C\uC6A9 \uC0DD\uC218 \uBC15\uC2A4\uB97C \uCC98\uC74C\uC73C\uB85C \uB72F\uC5C8\uB2E4. \uD55C \uBCD1\uC744 \uD558\uB8E8\uC5D0 \uB098\uB220 \uB9C8\uC2DC\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736453
    m_Localized: "\uBC29\uC1A1\uC740 \uADF8\uAC8C \uB9C8\uC9C0\uB9C9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736452
    m_Localized: "\uB458\uC9F8 \uB0A0. \uD559\uAD50 \uBC29\uC1A1\uC774 \uC6B8\uB838\uB2E4. \uC218\uB3D7\uBB3C\uC744 \uB9C8\uC2DC\uC9C0 \uB9D0\uB77C\uB294 \uC548\uB0B4\uC600\uB2E4. \uC774\uC720\uB294 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930781
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798\uD588\uC5B4. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930782
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC11C\uB78D\uC5D0\uC11C \uC190\uC804\uB4F1 \uD558\uB098\uB97C \uAEBC\uB0B4 \uAC74\uB138\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212687
    m_Localized: "\uC790\uAE30 \uC804\uC5D0 \uC18D\uC73C\uB85C \uD55C \uBC88 \uB354 \uC678\uC6E0\uB2E4. \uB2E4\uC74C \uC904\uB3C4 \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213193
    m_Localized: "\uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00 \uAC15 \uCABD \uD558\uB298\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212831
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB4E4\uC740 \uB370\uB824\uB2E4\uC92C\uC5B4. \uADF8\uAC74 \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930783
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC74 \uB124\uAC00 \uAC00\uC838. \uB098\uBCF4\uB2E4 \uB124\uAC00 \uB354 \uB9CE\uC774 \uAC77\uAC8C \uB420 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930784
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uC774\uAC83\uB3C4. \uCCAD\uC18C\uD568\uC5D0\uC11C \uCC3E\uC558\uC5B4. \uD718\uB450\uB974\uB77C\uB294 \uAC8C \uC544\uB2C8\uC57C. \uB9C9\uB294 \uB370 \uC4F0\uB77C\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930785
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCC3D\uACE0 \uAD6C\uC11D\uC758 \uC0C1\uC790\uB97C \uC5F4\uC5C8\uB2E4. \uCEF5\uB77C\uBA74\uACFC \uC0DD\uC218\uAC00 \uBE7D\uBE7D\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213008
    m_Localized: "\uB204\uAD70\uAC00\uB294 \uB208\uCE58\uCC44\uACE0 \uC788\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uAC70\uAE30\uAE4C\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212801
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uBB38 \uB4A4\uC5D0\uC11C \uB0B4 \uC774\uB984\uC744 \uC791\uAC8C \uBD88\uB800\uB2E4. \uACB0\uC815\uC740 \uB0B4 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930786
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC8FC\uC77C \uB3D9\uC548 \uBAA8\uC544 \uB454 \uAC70\uC57C. \uB2F9\uBD84\uAC04\uC740 \uC774\uAC78\uB85C \uBC84\uD2F0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930787
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uC77C\uBD80\uD130 \uC815\uD558\uC790. \uACF5\uBD80\uD560 \uAC83, \uACE0\uCE60 \uAC83, \uAC00\uC838\uC62C \uAC83. \uD558\uB8E8\uD558\uB8E8."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930788
    m_Localized: "{0}: \uACF5\uBD80\uC694? \uC9C0\uAE08 \uAC19\uC740 \uB54C\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930789
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uAE08 \uAC19\uC740 \uB54C\uB2C8\uAE4C. \uB098\uB294 \uC120\uC0DD\uC774\uACE0, \uB108\uB294 \uD559\uC0DD\uC774\uC796\uC544. \uADF8\uAC70\uB77C\uB3C4 \uBD99\uC7A1\uACE0 \uC788\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930790
    m_Localized: "\uAD50\uACFC\uC11C \uB300\uC2E0 \uCC3D\uACE0 \uBCBD\uC5D0 \uBD99\uC740 \uC2DC\uD654 \uD3EC\uC2A4\uD130\uAC00 \uCE60\uD310\uC774 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212800
    m_Localized: "\uB0A8\uC790: \uB300\uC2E0 \uC131\uC758\uB294 \uBCF4\uC5EC\uC57C\uC9C0. \uC77C\uC8FC\uC77C\uC5D0 \uBA39\uC744 \uAC70 \uC870\uAE08\uC529. \uADF8\uB7FC \uC0AC\uAC70\uB9AC\uB294 \uB108\uD76C \uD3B8\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213009
    m_Localized: "\uB0B4 \uAE30\uB85D\uC744 \uB05D\uAE4C\uC9C0 \uC77D\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930791
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC26C\uC6B4 \uAC83\uBD80\uD130. \uC774 \uC2DC, \uC18C\uB9AC \uB0B4\uC11C \uC77D\uC5B4 \uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930792
    m_Localized: "\uC77D\uB294 \uB3D9\uC548 \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uB2E4. \uC218\uC5C5\uC744 \uB4E3\uB294 \uCABD\uC740 \uC624\uD788\uB824 \uC120\uC0DD\uB2D8 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930793
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uACE0\uB9C8\uC6CC. \uC624\uB79C\uB9CC\uC5D0 \uC0AC\uB78C\uC774 \uC77D\uB294 \uBB38\uC7A5\uC744 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213010
    m_Localized: "\uC911\uD559\uAD50 \uC0C1\uB2F4 \uAE30\uB85D \uC0AC\uBCF8\uC774 \uB07C\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uADF8\uB54C \uB0B4\uAC00 \uD588\uB358 \uB9D0\uB4E4\uC774 \uB0A8\uC758 \uAE00\uC528\uB85C \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212830
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB4E4 \uC911\uC5D0 \uBA87 \uBA85\uC774 \uC9D1\uC5D0 \uAC14\uC744\uAE4C. \u2026\uADF8\uB0A0 \uC624\uD6C4\uC5D0 \uB098\uB294 \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uC560 \uB458\uC744 \uB370\uB9AC\uACE0 \uD559\uAD50\uB97C \uB098\uC130\uC5B4. \uC8FC\uD0DD\uAC00\uC5D0\uC11C \uAE38\uC774 \uB9C9\uD614\uACE0. \uAC70\uAE30\uC11C \uBA48\uCDC4\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930794
    m_Localized: "\uB2E4\uC74C \uC2DC\uAC04\uB3C4 \uAE30\uB300\uD560\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930795
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uC219\uC81C\uB97C \uB0B4\uC57C\uACA0\uB124. \uB18D\uB2F4\uC774\uC57C. \uBC18\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930796
    m_Localized: "\uACE0\uAC1C\uB9CC \uB044\uB355\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213194
    m_Localized: "\uBD88\uAF43\uC740 \uC5C6\uC5C8\uB2E4. \uB300\uC2E0 \uBCC4\uC774 \uB9CE\uC558\uB2E4. \uB3C4\uC2DC\uC5D0 \uBD88\uC774 \uAEBC\uC9C0\uB2C8 \uBCC4\uC774 \uC774\uB807\uAC8C \uB9CE\uC558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213195
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAC8C \uBC31\uC870\uC790\uB9AC\uB2E4. \uC544\uB2C8, \uC544\uB2D0 \uC218\uB3C4 \uC788\uB2E4. \uAD6D\uC5B4 \uC120\uC0DD\uC774\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930797
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB354 \uBB3B\uC9C0 \uC54A\uACE0 \uD3EC\uC2A4\uD130 \uADC0\uD241\uC774\uC5D0 \uC624\uB298 \uB0A0\uC9DC\uB97C \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930798
    m_Localized: "\uAD50\uC2E4\uB3D9 1\uCE35 \uB05D \uAD50\uC2E4. \uCC45\uC0C1\uC744 \uBC00\uC5B4 \uBB38\uC744 \uB9C9\uC790 \uC0DD\uAC01\uBCF4\uB2E4 \uB113\uC740 \uACF5\uAC04\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930799
    m_Localized: "\uCC3D\uC73C\uB85C \uC624\uD6C4 \uD587\uBE5B\uC774 \uB4E4\uC5B4\uC654\uB2E4. \uCE60\uD310\uC5D0\uB294 \uB204\uAD70\uAC00 \uC4F0\uB2E4 \uB9CC \uC2DC\uAC04\uD45C\uAC00 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213196
    m_Localized: "\uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213197
    m_Localized: "\uC77C\uCC0D \uC794\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930800
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uBA74 \uC218\uC5C5\uD558\uAE30\uB294 \uD6E8\uC52C \uB0AB\uACA0\uB2E4. \uB2E4\uB9CC \uCC3D\uACE0\uBCF4\uB2E4\uB294 \uBC16\uC5D0\uC11C \uC798 \uBCF4\uC774\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930801
    m_Localized: "\uC5EC\uAE30\uB97C \uC0C8 \uAC70\uC810\uC73C\uB85C \uC0BC\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930802
    m_Localized: "\uB458\uC774\uC11C \uB2F4\uC694\uC640 \uBB3C\uD1B5\uC744 \uC62E\uACBC\uB2E4. \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uC791\uAC8C \uC801\uC5C8\uB2E4. \"1\uD559\uB144 0\uBC18\"."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930803
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCE60\uD310\uC774 \uC0DD\uACBC\uC73C\uB2C8 \uAC00\uB974\uCE60 \uC218 \uC788\uB294 \uAC8C \uB298\uACA0\uB2E4. \uC704\uCE35 \uACFC\uD559\uC2E4\uC774\uB791 \uC74C\uC545\uC2E4 \uAC83\uB3C4 \uBE4C\uB824 \uC624\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930804
    m_Localized: "\uC7A0\uC740 \uCC3D\uACE0\uC5D0\uC11C, \uB0AE\uC5D0\uB9CC \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212688
    m_Localized: "\uAC00\uB9CC\uD788 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212689
    m_Localized: "\uC2DC\uAC00 \uB05D\uB098\uACE0\uB3C4 \uD55C\uB3D9\uC548 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212690
    m_Localized: "{0}: \uADF8 \uBD04\uC740, \uC5B8\uC81C \uC640\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407546
    m_Localized: "{0}: \uC544 \uB9DE\uB2E4, \uBC18 \uB2E8\uD1A1\uBC29\uC5D0 \uC0DD\uC77C \uBAA9\uB85D \uB9CC\uB4E0\uB300. \uB108 \uC0DD\uC77C \uC5B8\uC81C\uC600\uC9C0? \uB098 \uB610 \uAE4C\uBA39\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407545
    m_Localized: "{0}: \uD5C9\u2026 \uD5C9\u2026 \uB108 \uC65C \uC774\uB807\uAC8C \uBE68\uB9AC \uAC78\uC5B4. \uBC84\uC2A4 \uB193\uCE5C \uC904 \uC54C\uC558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212691
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAA8\uB974\uC9C0. \uC2DC\uC778\uB3C4 \uB0A0\uC9DC\uB294 \uC548 \uC801\uC5B4 \uB1A8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214533
    m_Localized: "\uC194\uC9C1\uD788 \uBB34\uC11C\uC6CC\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214534
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBB34\uC11C\uC6B4 \uAC8C \uB9DE\uC544. \uBB34\uC12D\uB2E4\uACE0 \uB9D0\uD560 \uC904 \uC544\uB294 \uC0AC\uB78C\uC774 \uC624\uB798 \uBC84\uD168."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407363
    m_Localized: "\uB4B7\uC0B0 \uAC1C\uC6B8\uAE4C\uC9C0 \uC62C\uB77C\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407362
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4. \uBCC4 \uD558\uB098\uAC00 \uAE38\uAC8C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212825
    m_Localized: "\uBC24. \uBCF4\uAC74\uC2E4 \uBD88\uBE5B \uC544\uB798 \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC57D\uC7A5 \uBAA9\uB85D\uC744 \uB2E4\uC2DC \uC4F0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212824
    m_Localized: "\uB3C4\uD604\uC774 \uC804\uB2E8\uC9C0\uC758 '\uCCB4\uC721\uACF5\uC6D0'\uC774\uB77C\uB294 \uAE00\uC790\uC5D0\uC11C \uB208\uC744 \uB5BC\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213011
    m_Localized: "\uC190\uC774 \uB5A8\uB838\uC9C0\uB9CC \uB05D\uAE4C\uC9C0 \uC77D\uC5C8\uB2E4. \uC774\uAC74 \uB0B4 \uC774\uC57C\uAE30\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213012
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uD30C\uC77C\uC744 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930807
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uBCBD\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC11C\uB824\uB2E4 \uB2E4\uC2DC \uC8FC\uC800\uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930808
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544. \uB298 \uC774\uB798. \uAE30\uC5B4 \uB2E4\uB2C8\uB294 \uAC8C \uC544\uC9C1 \uC775\uC219\uD558\uC9C0 \uC54A\uC744 \uBFD0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930809
    m_Localized: "{0}: \uBAA9\uBC1C \uAC19\uC740 \uAC70\u2026 \uB9CC\uB4E4 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C\uC694? \uB300\uAC78\uB808 \uC790\uB8E8\uB791 \uD14C\uC774\uD504\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930810
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB7EC\uBA74 \uC815\uB9D0 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930811
    m_Localized: "\uAF2D \uB9CC\uB4E4\uC5B4 \uB4DC\uB9B4\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212692
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 '\uC624\uBA74'\uC774\uB77C\uACE0 \uC37C\uC796\uC544. '\uC628\uB2E4\uBA74'\uC774 \uC544\uB2C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213013
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD30C\uC77C\uC744 \uBC1B\uC544 \uB4E4\uACE0 \uCCAB \uC7A5\uC744 \uB118\uACBC\uB2E4. \uD45C\uC815\uC774 \uCC9C\uCC9C\uD788 \uAD73\uC5B4 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407437
    m_Localized: "\uB3CC\uC544\uC624\uC790\uB9C8\uC790 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uD314\uC744 \uBD99\uC7A1\uC558\uB2E4. \uC190\uB05D\uC774 \uCC28\uAC00\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930812
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC18D\uC774\uB2E4. \uB098\uB3C4 \uD558\uB098 \uC57D\uC18D\uD560\uAC8C. \uADF8\uAC70 \uC9DA\uACE0 \uC81C\uC77C \uBA3C\uC800 \uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00 \uBCFC \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407488
    m_Localized: "\uBCF8\uAD00 \uCC3D\uACE0\uC5D0 \uB0A8\uAE30\uB85C \uD55C \uCCAB \uBC24. \uC120\uC0DD\uB2D8\uC774 \uCCA0\uBB38 \uC548\uCABD\uC5D0 \uC1E0\uB9C9\uB300\uB97C \uAC00\uB85C\uC9C8\uB7EC \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407489
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC740 \uBC16\uC5D0\uC11C \uC7A0\uACA8 \uC788\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810824
    m_Localized: "\uC544\uC8FC \uBA40\uB9AC\uC11C, \uB0AE\uAC8C \uC6C5\uC6C5\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBC14\uB78C \uC18C\uB9AC\uC640\uB294 \uB2EC\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407361
    m_Localized: "{0}: \uC77C \uB144\uC5D0 \uD55C \uBC88\uC774\uBA74\u2026 \uC6B0\uB9AC \uAD6C\uC870\uB3C4 \uADF8\uCBE4\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930815
    m_Localized: "\uD14C\uC774\uD504\uB97C \uC138 \uBC88\uC774\uB098 \uB2E4\uC2DC \uAC10\uC558\uB2E4. \uC190\uC7A1\uC774 \uB192\uC774\uB97C \uB450 \uBC88 \uACE0\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930816
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uCC9C\uCC9C\uD788 \uC77C\uC5B4\uC130\uB2E4. \uD55C \uAC78\uC74C. \uB450 \uAC78\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930817
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uBD10. \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930818
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uC774\uACE0, \uC774\uAC8C \uBB50\uB77C\uACE0 \uB208\uBB3C\uC774 \uB098\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407490
    m_Localized: "{0}: \u2026\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407360
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAC8C \uACAC\uC6B0, \uC800\uAC8C \uC9C1\uB140. \uC77C \uB144\uC5D0 \uD55C \uBC88 \uB9CC\uB09C\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212829
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uD39C\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407491
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uBB38\uC740 \uC548\uC5D0\uC11C \uC7A0\uADF8\uB294 \uAC70\uC57C. \uC6B0\uB9AC\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930821
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD560 \uC598\uAE30\uAC00 \uC788\uC5B4. \uBC24\uC5D0 \uB300\uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930822
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0\uB294 \uC800\uAC83\uB4E4\uC774 \uAE68\uC5B4\uB098\uC11C \uB3CC\uC544\uB2E4\uB140. \uB300\uC2E0 \uB0AE\uC5D0 \uBCF4\uC774\uB358 \uC0AC\uB78C\uB4E4\uC740 \uC228\uACE0, \uC7A0\uB4E0 \uBB34\uB9AC\uB3C4 \uD769\uC5B4\uC9C0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930823
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC704\uD5D8\uD574. \uADF8\uB798\uB3C4 \uBC24\uC5D0\uB9CC \uAC08 \uC218 \uC788\uB294 \uACF3\uC774 \uC788\uC5B4. \uD558\uC9C0\uB9CC \uBC24\uC744 \uADF8\uB807\uAC8C \uBCF4\uB0B4\uACE0 \uB098\uBA74 \uC7A0\uC774 \uBE5A\uCC98\uB7FC \uC313\uC774\uB2C8\uAE4C \uC8FC\uC758\uD574\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930824
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uAD50 \uC548\uC774\uB77C\uBA74\u2026 \uC5F0\uC2B5 \uC0BC\uC544 \uD55C \uBC88\uCBE4\uC740 \uAD1C\uCC2E\uC744\uC9C0\uB3C4 \uBAB0\uB77C. \uB124\uAC00 \uC6D0\uD55C\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212693
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uD734\uB300\uD3F0 \uC18D \uCE5C\uAD6C. \uC5B4\uB5A4 \uC560\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212694
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uB054 \uAEBC\uC9C4 \uD734\uB300\uD3F0\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uB354\uB77C. \uAE30\uB2E4\uB9AC\uB294 \uCE5C\uAD6C\uAC00 \uC788\uC9C0. \uC5B4\uB5A4 \uC560\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212695
    m_Localized: "{0} \uC774\uC57C\uAE30\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212828
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD574\uC5F4\uC81C\uB97C \uB098\uB220 \uC8FC\uACE0, \uC870\uD1F4\uC99D\uC5D0 \uB3C4\uC7A5\uC744 \uCC0D\uC5C8\uC5B4. \uBC31 \uC7A5\uB3C4 \uB118\uAC8C. \uC9D1\uC5D0 \uAC00\uC11C \uC26C\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213198
    m_Localized: "\uAFC8\uC5D0\uC11C \uBD88\uAF43\uB180\uC774\uB97C \uBD24\uB2E4. \uC606\uC5D0 \uB204\uAC00 \uC788\uC5C8\uB294\uC9C0\uB294 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930825
    m_Localized: "\uD574 \uBCFC\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930826
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC190\uC804\uB4F1 \uAF2D \uCC59\uAE30\uACE0. \uBB34\uB9AC\uD558\uBA74 \uBC14\uB85C \uB3CC\uC544\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212823
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6C\uC2ED\uD314 \uC810 \uC0BC. \u2026\uB77C\uB514\uC624\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4. \uC544\uB2C8, \uC5B8\uC820\uAC00 \uB4E3\uAC8C \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212822
    m_Localized: "\uC804\uB2E8\uC9C0\uB97C \uC811\uC5B4 \uD488\uC5D0 \uB123\uC5C8\uB2E4. \uB3CC\uC544\uC640\uC11C \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uBCF4\uC5EC \uC8FC\uC790, \uC120\uC0DD\uB2D8\uC774 \uC8FC\uD30C\uC218 \uC22B\uC790\uB97C \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930829
    m_Localized: "4\uCE35 \uBCF5\uB3C4 \uCC3D\uC73C\uB85C \uAD50\uBB38 \uBC16\uC774 \uB0B4\uB824\uB2E4\uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212696
    m_Localized: "\uB5A1\uBCF6\uC774\uB97C \uC88B\uC544\uD558\uACE0, \uC0DD\uC77C\uC744 \uB9E8\uB0A0 \uAE4C\uBA39\uACE0, \uC6B4\uC138 \uC571\uC744 \uBBFF\uB294 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407372
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uB099\uC5FD\uC744 \uBAA8\uC740\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407371
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB180\uC774\uACF5\uC6D0\uC740 \uBABB \uAC00\uB3C4, \uB2E8\uD48D\uC740 \uACF5\uC9DC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407370
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC870\uAE08 \uC26C\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213158
    m_Localized: "\uB3C4\uD604: \uC9C4\uC9DC\uC694? \uC57D\uC18D\uC774\uC5D0\uC694. \uC800 \uAE38 \uB2E4 \uC54C\uC544\uC694. \uACE8\uBAA9 \uD558\uB098\uB3C4 \uC548 \uD2C0\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213159
    m_Localized: "\uC9C0\uAE08\uC740 \uB108\uBB34 \uC704\uD5D8\uD558\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213160
    m_Localized: "\uB3C4\uD604\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uC9C0\uB9CC, \uADF8\uB0A0 \uBC24 \uB2A6\uAC8C\uAE4C\uC9C0 \uCC3D\uAC00\uC5D0\uC11C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213161
    m_Localized: "\uBE68\uAC04 \uC9C0\uBD95 \uC9D1. \uD604\uAD00\uBB38\uC740 \uC7A0\uACA8 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407487
    m_Localized: "\uBD84\uD544 \uAC00\uB8E8\uAC00 \uC120\uC0DD\uB2D8 \uC18C\uB9E4\uC5D0 \uD558\uC597\uAC8C \uBB3B\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0 \uBCF4\uB294 \uBAA8\uC2B5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213002
    m_Localized: "'3\uD559\uB144 \uB3D9\uC544\uB9AC \uC815\uC218\uC7A5 \uACAC\uD559 \uCDE8\uC18C. \uC2DC\uCCAD \uC5F0\uB77D, \uC218\uC9C8 \uAC80\uC0AC \uACB0\uACFC \uC774\uC0C1.' \uB0A0\uC9DC\uB294 \uC0AC\uD0DC \uC0AC\uD758 \uC804\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930830
    m_Localized: "\uAE38 \uAC74\uB108 \uD3B8\uC758\uC810 \uAC04\uD310. \uBD88\uC740 \uAEBC\uC84C\uC9C0\uB9CC \uC720\uB9AC\uBB38\uC740 \uBA40\uCA61\uD574 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930831
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0\uB294 \uBB38\uC774 \uC5F4\uB9B0 \uCC44 \uC11C \uC788\uB294 \uCC28 \uD55C \uB300. \uADF8 \uC606\uC5D0 \uB5A8\uC5B4\uC9C4 \uC2E0\uBC1C \uD55C \uC9DD."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212821
    m_Localized: "\uC544\uB798\uC5D0\uB294 \uB204\uAD70\uAC00 \uBCFC\uD39C\uC73C\uB85C \uB367\uC368 \uB450\uC5C8\uB2E4. '\uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C \uC0AC\uB78C\uB4E4 \uC5EC\uAE30 \uC788\uC74C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212820
    m_Localized: "'\uD63C\uC790\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uB4E3\uACE0 \uC788\uB2E4\uBA74, \uC0B4\uC544 \uC788\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212881
    m_Localized: "\uC9C0\uB3C4\uB294 \uB180\uB784 \uB9CC\uD07C \uC815\uD655\uD588\uB2E4. \uC0AC\uAC70\uB9AC\uC758 \uBD89\uC740 \uD45C\uC2DC\uAE4C\uC9C0 \uC791\uAC8C \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213162
    m_Localized: "\uC9D1 \uC548\uC740 \uAE68\uB057\uD588\uB2E4. \uB108\uBB34 \uAE68\uB057\uD574\uC11C, \uC11C\uB458\uB7EC \uB5A0\uB09C \uAC83 \uAC19\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407486
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC751. \uC0AC\uB78C\uC740 \uC0B4\uC544\uB0A8\uAE30\uB9CC \uD558\uBA74 \uAE08\uBC29 \uC9C0\uCCD0. \uADF8\uB798\uC11C \uD559\uAD50\uC5D0 \uC74C\uC545 \uC2DC\uAC04\uC774 \uC788\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212802
    m_Localized: "\uC2DD\uB7C9\uC744 \uB0B4\uC900\uB2E4. \uC9C0\uAE08\uC740 \uC2F8\uC6B8 \uB54C\uAC00 \uC544\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212880
    m_Localized: "\uC1A1\uC608\uC9C0: \uC6B0\uB9AC\uAC00 \uB2E4\uB2CC \uAE38, \uB9C9\uD78C \uAE38, \uD45C\uC2DC \uC788\uB358 \uB2F4\uC7A5. \uB2E4 \uB123\uC5C8\uC5B4. \u2026\uC4F8\uBAA8 \uC788\uC73C\uBA74 \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212879
    m_Localized: "\uC1A1\uC608\uC9C0: \uBBF8\uC220 \uD559\uC6D0 \uB2E4\uB154\uC5C8\uC5B4. \uC774\uB7F0 \uAC83\uBC16\uC5D0 \uBABB \uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930837
    m_Localized: "\uAD50\uC2E4\uB3D9 2\uCE35 \uBCF4\uAC74\uC2E4. \uCE68\uB300 \uB450 \uAC1C, \uC57D\uC7A5 \uD558\uB098. \uB180\uB784 \uB9CC\uD07C \uC815\uB3C8\uB418\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716585930838
    m_Localized: "\uC57D\uC7A5 \uC544\uB798 \uC11C\uB78D\uC5D0 '\uAD50\uC9C1\uC6D0 \uAC74\uAC15\uAC80\uC9C4 \uAE30\uB85D' \uD30C\uC77C\uC774 \uAF42\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212819
    m_Localized: "'UBC \uC0DD\uC874\uC790 \uBC29\uC1A1. \uB9E4\uC77C \uBC24 \uC544\uD649 \uC2DC. \uC8FC\uD30C\uC218 98.3.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213163
    m_Localized: "\uB0C9\uC7A5\uACE0 \uBB38\uC5D0 \uC790\uC11D\uC73C\uB85C \uBD99\uC740 \uCABD\uC9C0 \uD55C \uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214535
    m_Localized: "\uD559\uAD50 \uBC16\uC740 \uCC98\uC74C\uC774\uC5C8\uB2E4. \uADF8 \uAE38\uC744 \uAC74\uB108\uB294 \uC0C1\uC0C1\uB9CC\uC73C\uB85C \uC190\uBC14\uB2E5\uC5D0 \uB540\uC774 \uCC3C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212803
    m_Localized: "\uD1B5\uC870\uB9BC \uB124 \uAC1C\uB97C \uB2F4\uC7A5 \uC704\uC5D0 \uC62C\uB824\uB193\uC558\uB2E4. \uB0A8\uC790\uAC00 \uD558\uB098\uC529 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC73C\uBA70 \uD718\uD30C\uB78C\uC744 \uBD88\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213001
    m_Localized: "\uC2E4\uD5D8 \uB178\uD2B8\uB97C \uC77D\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212818
    m_Localized: "\uAC00\uAC8C \uC720\uB9AC\uBB38 \uC548\uCABD\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uD14C\uC774\uD504\uB85C \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC190\uAE00\uC528\uB97C \uBCF5\uC0AC\uD55C \uC804\uB2E8\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212878
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCEE4\uB2E4\uB780 \uB3C4\uD654\uC9C0\uB97C \uB4E4\uACE0 \uC654\uB2E4. \uD559\uAD50\uC640 \uC8FC\uBCC0 \uACE8\uBAA9\uC774 \uC5F0\uD544\uB85C \uBE7C\uACE1\uD558\uAC8C \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407467
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 '\uBB3C\uC758 \uB053\uB294\uC810' \uB2E8\uC6D0\uC744 \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uC5C8\uB2E4. \uC2DC\uB97C \uC77D\uC744 \uB54C\uC640 \uB611\uAC19\uC740 \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212877
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uADF8\uB54C\uAE4C\uC9C0 \uC548 \uBC84\uB9B4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212817
    m_Localized: "\uADF8\uB0A0 \uBC24 \uCC98\uC74C\uC73C\uB85C, \uAD50\uBB38 \uCABD\uC5D0\uC11C \uB4E4\uB9AC\uB294 \uBAA8\uB4E0 \uC18C\uB9AC\uC5D0 \uC7A0\uC774 \uAE7C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214536
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uB9D0\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213164
    m_Localized: "'\uB3C4\uD604\uC544. \uC5C4\uB9C8\uB791 \uC544\uBE60\uB294 \uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C\uB85C \uAC04\uB2E4. \uAF2D \uC640. \uAF2D.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213000
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACFC\uD559 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uC168\uC73C\uBA74 \uC0C1 \uC8FC\uC168\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212999
    m_Localized: "\uD398\uD2B8\uBCD1, \uC22F, \uBAA8\uB798, \uC790\uAC08. \uAD50\uACFC\uC11C \uADF8\uB9BC\uB300\uB85C \uC313\uC544 \uC62C\uB838\uB2E4. \uD759\uD0D5\uBB3C\uC774 \uB9D1\uC740 \uBB3C\uBC29\uC6B8\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212816
    m_Localized: "\uB0A8\uC790: \uADF8\uB798. \uD615\uB2D8\uD55C\uD14C \uADF8\uB807\uAC8C \uC804\uD560\uAC8C. \uBC24\uC5D0 \uBB38 \uC798 \uC7A0\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212876
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uD3B8\uC9C0\uB97C \uBC1B\uC544 \uB4E4\uACE0 \uC624\uB798 \uC950\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212875
    m_Localized: "{0}: \uB124\uAC00 \uC9C1\uC811 \uC904 \uC218 \uC788\uC744 \uB54C \uBC1B\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212874
    m_Localized: "\uC77D\uC9C0 \uC54A\uACE0 \uB3CC\uB824\uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407492
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBE57\uC7A5\uC744 \uD55C \uBC88 \uD754\uB4E4\uC5B4 \uBCF4\uC558\uB2E4. \uAFC8\uCA4D\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213165
    m_Localized: "\uB3C4\uD604\uC740 \uCABD\uC9C0\uB97C \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4. \uC6B8\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC785\uC220\uC744 \uAE68\uBB3C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213185
    m_Localized: "\uAD50\uC7A5 \uC120\uC0DD\uB2D8 \uD6C8\uD654 \uB300\uC2E0 \uC120\uC0DD\uB2D8\uC774 \uC9E7\uAC8C \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212998
    m_Localized: "\uC815\uC218 \uC7A5\uCE58\uBD80\uD130 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407493
    m_Localized: "\uAC07\uD600 \uC788\uB358 \uACF3\uC774, \uC9C0\uD0A4\uB294 \uACF3\uC774 \uB418\uC5C8\uB2E4. \uADF8\uB0A0 \uBC24\uC740 \uBB38 \uCABD\uC744 \uBCF4\uC9C0 \uC54A\uACE0\uB3C4 \uC7A0\uB4E4 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212873
    m_Localized: "\uD3B8\uC9C0\uB97C \uC811\uC5B4 \uB0B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4. \uB3CC\uB824\uC8FC\uC9C0 \uC54A\uC558\uB2E4. \uC1A1\uC608\uC9C0\uB3C4 \uB2EC\uB77C\uACE0 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212872
    m_Localized: "'\uB124\uAC00 \uBB38\uC744 \uB450\uB4DC\uB9AC\uB358 \uC18C\uB9AC, \uC544\uC9C1\uB3C4 \uB4E4\uB824. \uBBF8\uC548\uD558\uB2E4\uB294 \uB9D0\uC740 \uB108\uBB34 \uC791\uC544\uC11C \uC548 \uC37C\uC5B4. \uB300\uC2E0 \uB9E4\uC77C \uBC24 \uC5EC\uAE30\uC11C \uBB38 \uCABD\uC744 \uBCFC\uAC8C. \uC774\uBC88\uC5D4 \uC544\uBB34\uB3C4 \uB2EB\uC9C0 \uBABB\uD558\uAC8C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212871
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uB300\uB2F5 \uB300\uC2E0 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407494
    m_Localized: "\uAD50\uC2E4\uB3D9 \uC591\uD638\uC2E4 \uCE68\uB300\uC5D0\uB294 \uC2DC\uD2B8\uAC00 \uBC18\uB4EF\uD558\uAC8C \uAE54\uB824 \uC788\uC5C8\uB2E4. \uB204\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC815\uB9AC\uD558\uACE0 \uB098\uAC04 \uADF8\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213184
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uBC29\uD559\uC2DD \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212997
    m_Localized: "\uAD50\uD0C1 \uC11C\uB78D\uC5D0\uC11C \uC2E4\uD5D8 \uB178\uD2B8 \uD55C \uAD8C\uC774 \uB098\uC654\uB2E4. \uC0AC\uD0DC \uC9C1\uC804 \uBA70\uCE60\uC758 \uAE30\uB85D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407495
    m_Localized: "\uBCBD\uC5D0 '\uC751\uAE09\uCC98\uCE58 \uC21C\uC11C'\uAC00 \uC801\uD78C \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC9C0\uD608, \uC18C\uB3C5, \uACE0\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212870
    m_Localized: "\uC77D\uC5B4\uB3C4 \uB418\uB0D0\uACE0 \uBB3B\uACE0, \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC77D\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407468
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \"\uBB3C\uC740 1\uAE30\uC555\uC5D0\uC11C 100\uB3C4\uC5D0 \uB053\uB294\uB2E4.\" \u2026\uC774 \uBB38\uC7A5, \uC0DD\uAC01\uBCF4\uB2E4 \uB4E0\uB4E0\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407469
    m_Localized: "{0}: \uC65C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213183
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uC2DC\uD5D8\uC740 \uB3C4\uB9DD \uC548 \uAC04\uB2E4. \uC2DC\uD5D8\uC9C0\uAC00 \uBA3C\uC800 \uB3C4\uB9DD\uAC00\uACA0\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212996
    m_Localized: "\uCE60\uD310\uC5D0\uB294 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC758 \uD310\uC11C\uAC00 \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uC5EC\uACFC, \uC99D\uB958, \uADF8\uB9AC\uACE0 '\uB2E4\uC74C \uC2DC\uAC04 \uC2E4\uD5D8 \uC900\uBE44\uBB3C'."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407470
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC138\uC0C1\uC774 \uC774\uB807\uAC8C \uB410\uB294\uB370, \uBB3C\uC740 \uC5EC\uC804\uD788 100\uB3C4\uC5D0 \uB053\uC796\uC544. \uC548 \uBC14\uB00C\uB294 \uAC8C \uC788\uB2E4\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407471
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uBB38\uC7A5 \uC544\uB798\uC5D0 \uC5F0\uD544\uB85C \uBC11\uC904\uC744 \uADF8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407472
    m_Localized: "\uC74C\uC545 \uC2DC\uAC04\uC774\uB77C\uACE0 \uD574\uB3C4, \uC18C\uB9AC\uB97C \uB0BC \uC218\uB294 \uC5C6\uC5C8\uB2E4. \uCC3D\uBC16 \uC5B4\uB514\uC11C \uBB34\uC5C7\uC774 \uB4E3\uACE0 \uC788\uC744\uC9C0 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407473
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC624\uB298\uC740 \uBC15\uC790\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212995
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uB354\uC704\uBA74 \uBB3C\uC774 \uAE08\uBC29 \uBC14\uB2E5\uB098. \uC5EC\uAE30\uB77C\uBA74 \uC815\uC218\uAE30\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212804
    m_Localized: "\uB0A8\uC790: \uB9D0 \uC798 \uD1B5\uD558\uB124. \uC55E\uC73C\uB85C \uC0AC\uAC70\uB9AC \uC9C0\uB0A0 \uB54C \uC6B0\uBE44 \uBCF4\uBA74 \uC190 \uD754\uB4E4\uC5B4. \uC548 \uC3E0 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407474
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCC45\uC0C1 \uBAA8\uC11C\uB9AC\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uD1A1, \uD1A1, \uB450\uB4DC\uB838\uB2E4. \uB098\uB3C4 \uB530\uB77C \uB450\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407475
    m_Localized: "\uCC98\uC74C\uC5D4 \uC5C7\uAC08\uB9AC\uB2E4\uAC00, \uC5B4\uB290 \uC21C\uAC04 \uB450 \uC18C\uB9AC\uAC00 \uD558\uB098\uB85C \uACB9\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212869
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8\uAC70\u2026 \uBC84\uB9AC\uB824\uB358 \uAC70\uC57C. \uB3CC\uB824\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212868
    m_Localized: "\uC8FC\uC6CC \uBCF4\uB2C8 \uB9E8 \uC704\uC5D0 \uB0B4 \uC774\uB984\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uD3B8\uC9C0\uC600\uB2E4. \uBD80\uCE58\uC9C0 \uC54A\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213182
    m_Localized: "\uC624\uB298\uC740 \uC26C\uACE0 \uC2F6\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213181
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB2F5 \uB178\uD2B8\uB294 \uB0B4\uC77C\uAE4C\uC9C0. \uB18D\uB2F4 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212867
    m_Localized: "\uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790 \uADF8 \uC560\uAC00 \uBB34\uB98E \uC704\uC758 \uACF5\uCC45\uC744 \uB36E\uC5C8\uB2E4. \uB36E\uB294 \uBC14\uB78C\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uBBF8\uB044\uB7EC\uC838 \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212866
    m_Localized: "\uBC24. \uBCF5\uB3C4 \uB05D \uCC3D\uAC00\uC5D0 \uC1A1\uC608\uC9C0\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uACBD\uACC4 \uB2F9\uBC88\uB3C4 \uC544\uB2CC\uB370, \uC694\uC998\uC740 \uB9E4\uC77C \uBC24 \uAC70\uAE30 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407364
    m_Localized: "\uAC1C\uC6B8\uBB3C\uC740 \uC190\uC774 \uC800\uB9B4 \uB9CC\uD07C \uCC28\uAC00\uC6E0\uB2E4. \uBB3C\uD1B5 \uAC00\uB4DD \uBC1B\uC544 \uC654\uB2E4. \uB053\uC774\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212805
    m_Localized: "\uADF8\uB0A0 \uC800\uB141 \uBC25\uC774 \uBAA9\uC5D0 \uAC78\uB838\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB0B4 \uBAAB\uC758 \uAD6D\uC744 \uC870\uAE08 \uB354 \uB5A0 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407496
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uADF8 \uC774\uC57C\uAE30\uB97C \uD558\uC790, \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810826
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB108\uB3C4 \uB4E4\uC5C8\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212994
    m_Localized: "\uACFC\uD559\uC2E4 \uBB38\uC744 \uC5F4\uC790 \uC54C\uCF54\uC62C \uB0C4\uC0C8\uAC00 \uD76C\uBBF8\uD558\uAC8C \uB0AC\uB2E4. \uC2E4\uD5D8\uB300 \uC704\uC5D0 \uBE44\uCEE4\uAC00 \uC904\uC9C0\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212993
    m_Localized: "\uCCB4\uC721\uAD00 \uC815\uBB38\uC5D0 \uC1E0\uC0AC\uC2AC\uC744 \uAC10\uACE0, \uB4B7\uBB38 \uCABD\uC5D0 \uD0C8\uCD9C\uB85C\uB97C \uB0C8\uB2E4. \uBC24\uC5D0\uB3C4 \uC228\uC5B4\uB4E4 \uACF3\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212865
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uC218\uC5C5\uC740 \uC11C\uC11C \uD55C\uB2E4. \uB2E4\uB4E4 \uC549\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212864
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uD314\uC9F1\uC744 \uB07C\uACE0 \uBB38\uAC04\uC5D0 \uAE30\uB300 \uC788\uC5C8\uB2E4. \uC6C3\uB294 \uC5BC\uAD74\uC744 \uB4E4\uD0A4\uC9C0 \uC54A\uC73C\uB824\uACE0 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407497
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC885\uC774 \uC21C\uC11C\uB300\uB85C\uB9CC \uD574\uB3C4 \uB9CE\uC774 \uC0B4\uC544. \uB2E4\uC74C\uC5D4 \uADF8\uAC83\uB3C4 \uB5BC\uC5B4 \uC640. \uAC19\uC774 \uC678\uC6B0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212815
    m_Localized: "\uB0A8\uC790\uAC00 \uC5B4\uAE68\uB97C \uC73C\uC4F1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212992
    m_Localized: "\uBE44\uC0C1\uC2DC \uB300\uD53C\uC18C\uB85C \uBB38\uC744 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212991
    m_Localized: "\uC904\uB118\uAE30, \uD314\uAD7D\uD600\uD3B4\uAE30, \uB9E4\uD2B8 \uC704 \uAD6C\uB974\uAE30. \uCCB4\uC721 \uC2DC\uAC04\uC774 \uC774\uB807\uAC8C \uBC18\uAC00\uC6B8 \uC904\uC740 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212984
    m_Localized: "\uCCB4\uC721\uAD00\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uBC1D\uC558\uB2E4. \uB192\uC740 \uCC3D\uC73C\uB85C \uD587\uBE5B\uC774 \uC3DF\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212863
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310 \uC55E\uAE4C\uC9C0 \uAC78\uC5B4\uAC00 \uBD84\uD544\uC744 \uB4E4\uC5C8\uB2E4. \uC11C\uC11C, \uB208\uB192\uC774\uC5D0, \uB0A0\uC9DC\uB97C \uC37C\uB2E4. \uAE00\uC528\uAC00 \uBC18\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212862
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC130\uB2E4. \uB098, \uC130\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407476
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC70\uC57C. \uC74C\uC545\uC740 \uAC19\uC774 \uB9DE\uCD94\uB294 \uAC70\uC57C. \uD06C\uAC8C \uC548 \uD574\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407477
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC544\uC8FC \uC791\uAC8C, \uC785\uC548\uC5D0\uC11C\uB9CC \uAD50\uAC00\uB97C \uD765\uC5BC\uAC70\uB838\uB2E4. \uAC00\uC0AC\uB294 \uC5C6\uC774 \uAC00\uB77D\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407485
    m_Localized: "{0}: \uC74C\uC545\uB3C4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212990
    m_Localized: "\uB9E4\uD2B8\uB97C \uAE54\uACE0 \uD6C8\uB828\uC7A5\uC73C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407478
    m_Localized: "{0}: \uADF8 \uB178\uB798 \uC2EB\uC5B4\uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212814
    m_Localized: "{0}: \uC904 \uAC70 \uC5C6\uC5B4\uC694. \uB3CC\uC544\uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212813
    m_Localized: "\uAC70\uC808\uD55C\uB2E4. \uC6B0\uB9AC \uAC83\uC740 \uC6B0\uB9AC\uAC00 \uC9C0\uD0A8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212832
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212989
    m_Localized: "{0}: \u2026\uC544\uB2C8\uC694. \uAD1C\uCC2E\uC544\uC694. \uC5EC\uAE30, \uC368\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212985
    m_Localized: "\uB18D\uAD6C \uACE8\uB300\uC5D0 \uAC78\uB9B0 \uACF5 \uD558\uB098\uAC00 \uADF8\uB300\uB85C\uC600\uB2E4. \uCF54\uD2B8 \uD55C\uAC00\uC6B4\uB370 \uB9E4\uD2B8\uAC00 \uAE54\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407479
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB4E4 \uADF8\uB798. \u2026\uADFC\uB370 \uC9C0\uAE08 \uB4E4\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407480
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0, \uBC15\uC790\uB97C \uACC4\uC18D \uB450\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212812
    m_Localized: "\uADF8\uB294 \uB0B4\uAC00 \uB0B4\uBBFC \uD1B5\uC870\uB9BC\uB9CC \uCC59\uACA8 \uB3CC\uC544\uC130\uB2E4. \uB2F4\uC7A5\uC758 \uD45C\uC2DC\uB294 \uADF8\uB300\uB85C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407365
    m_Localized: "\uBC14\uC704\uC5D0 \uC549\uC544 \uBC1C\uC744 \uB2F4\uADF8\uACE0 \uC788\uC73C\uB2C8, \uC138\uC0C1\uC774 \uB05D\uB0AC\uB2E4\uB294 \uAC8C \uAC70\uC9D3\uB9D0 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810825
    m_Localized: "\uC18C\uB9AC\uB294 \uD55C\uCC38 \uD558\uB298 \uC5B4\uB518\uAC00\uB97C \uB9F4\uB3CC\uB2E4\uAC00, \uB0A8\uCABD\uC73C\uB85C \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212811
    m_Localized: "\uB0A8\uC790: \uD765\uC815\uC740 \uAC81 \uC548 \uBA39\uC740 \uC0AC\uB78C\uC774 \uD558\uB294 \uAC70\uC57C. \uD615\uB2D8\uC774 \uBCC4\uB85C \uC548 \uC88B\uC544\uD558\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212986
    m_Localized: "\uADF8\uB9AC\uACE0 \uC800 \uC548\uCABD, \uCCB4\uC721\uCC3D\uACE0 \uBB38. \uB179\uC0C9 \uCCA0\uBB38\uC774 \uB2EB\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212861
    m_Localized: "\uD55C \uAC78\uC74C. \uB450 \uAC78\uC74C. \uC138 \uAC78\uC74C\uC9F8\uC5D0 \uBE44\uD2C0\uD588\uC9C0\uB9CC, \uB118\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212860
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC758\uC871\uC744 \uB07C\uC6B0\uACE0 \uBCBD\uC744 \uC9DA\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC190\uC744 \uB5BC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407366
    m_Localized: "\uC774\uB07C \uB080 \uBC14\uC704\uC5D0\uC11C \uBBF8\uB044\uB7EC\uC838 \uAC1C\uC6B8\uC5D0 \uBE60\uC84C\uB2E4. \uD314\uAFC8\uCE58\uAC00 \uC4F8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407367
    m_Localized: "\uD760\uBED1 \uC816\uC740 \uCC44 \uB3CC\uC544\uC624\uC790 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC74C\uC744 \uCC38\uB2E4\uAC00 \uACB0\uAD6D \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212859
    m_Localized: "\uB048\uC744 \uC138 \uBC88 \uC870\uC774\uACE0, \uCFE0\uC158\uC744 \uB450 \uBC88 \uBC14\uAFE8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212858
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uACF5\uD559 \uCABD\uC740 \uB124\uAC00 \uB0AB\uC796\uC544. \uC790\uC7AC \uB109\uB109\uD788 \uBAA8\uC544\uC11C \uAC19\uC774 \uB9CC\uB4E4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212810
    m_Localized: "\uB9D0\uC774 \uAF2C\uC600\uB2E4. \uBAA9\uC18C\uB9AC\uAC00 \uB5A8\uB9AC\uB294 \uAC78 \uB0A8\uC790\uB3C4 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212809
    m_Localized: "\uB0A8\uC790: \uAF2C\uB9F9\uC774\uAC00 \uC7A5\uC0AC\uB97C \uD558\uB124. \uD615\uB2D8\uD55C\uD14C \uADF8\uB300\uB85C \uC804\uD558\uC9C0. \uD615\uB2D8\uC740 \uC774\uB7F0 \uAC70 \uC88B\uC544\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213180
    m_Localized: "10\uBB38\uC81C \uC911 8\uAC1C\uB97C \uB9DE\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBE68\uAC04 \uD39C\uC73C\uB85C \uB3D9\uADF8\uB77C\uBBF8\uB97C \uD06C\uAC8C \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212833
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB354 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uC57D\uC7A5 \uBAA9\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC904\uC744 \uAC19\uC774 \uCC44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212987
    m_Localized: "\uC228\uC774 \uC870\uAE08 \uAC00\uBE60\uC84C\uB2E4. \uC77C\uBD80\uB7EC \uADF8\uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212857
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uBD88\uB800\uB2E4. \uC885\uC774\uC5D0 \uCE58\uC218\uC640 \uADF8\uB9BC\uC744 \uADF8\uB824 \uAC74\uB138\uB2E4. \uD50C\uB77C\uC2A4\uD2F1 \uAD00, \uB048, \uCFE0\uC158."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212856
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC11C\uC11C \uCE60\uD310\uC5D0 \uAE00\uC528\uB97C \uC4F8 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uB124\uC694. \uC549\uC544\uC11C \uC4F0\uB2C8\uAE4C \uC790\uAFB8 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212834
    m_Localized: "\uB9D0\uC5C6\uC774 \uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC744 \uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212835
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uC791\uC558\uB2E4. \uC18C\uB3C5\uC57D \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212836
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC774\uB7EC\uBA74 \uB0B4\uAC00 \uC704\uB85C\uBC1B\uB294 \uCABD\uC774 \uB418\uC796\uC544. \uBC18\uCE59\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213179
    m_Localized: "\uC2DC\uD5D8\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212855
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC73C\uB824\uB2E4\uAC00, \uC6C3\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212854
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC758\uC871\uC774\uC694. \uC9C4\uC9DC \uAC19\uC740 \uAC74 \uBABB \uB9CC\uB4E4\uC5B4\uB3C4, \uC11C\uC11C \uBA87 \uAC78\uC74C \uAC77\uB294 \uC815\uB3C4\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407481
    m_Localized: "1-5\uBC18 \uAD50\uC2E4\uC5D0\uC11C \uB9DE\uB294 \uCCAB \uBC24\uC774\uC5C8\uB2E4. \uCC45\uC0C1\uC744 \uBC00\uC5B4 \uBD99\uC5EC \uCE68\uB300\uB97C \uB9CC\uB4E4\uACE0, \uCEE4\uD2BC\uC744 \uB05D\uAE4C\uC9C0 \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407482
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC758\uC790\uC5D0 \uC549\uC740 \uCC44, \uB204\uAD70\uAC00 \uC4F0\uB2E4 \uB9CC \uC2DC\uAC04\uD45C\uB97C \uC9C0\uC6B0\uACE0 \uCE60\uD310 \uC544\uB798\uCABD\uC5D0 \uC0C8\uB85C \uC801\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213178
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uD5D8 \uBCFC\uB798? \uB0B4\uAC00 \uC9C1\uC811 \uCD9C\uC81C\uD588\uB2E4. \uAD6D\uC5B4 10\uBB38\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213177
    m_Localized: "\uB2EC\uB825\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uCCD0\uC9C4 \uB0A0. \uC6D0\uB798\uB77C\uBA74 \uAE30\uB9D0\uACE0\uC0AC \uCCAB\uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212853
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB978 \uAC83?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212808
    m_Localized: "\uB0A8\uC790\uAC00 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212807
    m_Localized: "{0}: \uBC18\uB9CC \uC904\uAC8C\uC694. \uB300\uC2E0 \uC6B0\uB9AC \uCABD \uB2F4\uC7A5\uC5D4 \uB2E4\uC2DC \uD45C\uC2DC\uD558\uC9C0 \uB9C8\uC138\uC694. \uADF8\uB9AC\uACE0 \uD559\uAD50 \uC55E\uC5D0\uC11C \uCD1D\uC740 \uAEBC\uB0B4\uC9C0 \uB9D0\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212988
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544? \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB9CC \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212837
    m_Localized: "\uC57D\uC7A5\uC5D0 \uB0A8\uC740 \uAC74 \uBD95\uB300 \uB450 \uB864\uACFC \uC9C4\uD1B5\uC81C \uBA87 \uC54C\uC774 \uC804\uBD80\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212838
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC815\uD574\uC57C \uD560 \uAC8C \uC788\uC5B4. \uC57D\uC774 \uC774 \uC815\uB3C4\uBC16\uC5D0 \uC5C6\uC744 \uB54C, \uB204\uAC00 \uBA3C\uC800 \uC4F0\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213223
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC5C6\uB294 \uCABD \uB2E4\uB9AC\uB97C \uC190\uC73C\uB85C \uAC10\uC30C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213051
    m_Localized: "\uB450 \uBC88 \uB178\uD06C\uD588\uB2E4. \uC548\uCABD\uC758 \uC228\uC18C\uB9AC\uAC00 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213050
    m_Localized: "\uAE00\uC528\uAC00 \uB465\uAE00\uC5C8\uB2E4. \uC5B4\uB514\uC11C \uBCF8 \uAC83 \uAC19\uAE30\uB3C4 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213049
    m_Localized: "'\uACE0\uB9C8\uC6CC\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407498
    m_Localized: "\uAC00\uC0AC \uC2E4\uC2B5\uC2E4 \uC870\uB9AC\uB300 \uC704\uC5D0 \uC55E\uCE58\uB9C8\uAC00 \uAC78\uB9B0 \uCC44\uC600\uB2E4. \uC774\uB984\uD45C\uC5D0 1\uD559\uB144 \uB204\uAD70\uAC00\uC758 \uC774\uB984\uC774 \uC090\uB6A4\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810821
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8\uB54C \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213048
    m_Localized: "\uB300\uC2E0 \uBE48 \uC0DD\uC218\uBCD1 \uD558\uB098\uAC00 \uBC18\uB4EF\uD558\uAC8C \uC138\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uB69C\uAED1 \uC704\uC5D0 \uC791\uC740 \uC885\uC774\uAC00 \uB07C\uC6CC\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213047
    m_Localized: "\uB2E4\uC74C\uC5D0 \uADF8 \uACE8\uBAA9\uC744 \uC9C0\uB0A0 \uB54C, 102\uD638 \uBB38 \uC55E\uC5D0 \uB450\uACE0 \uC628 \uD1B5\uC870\uB9BC\uC774 \uC5C6\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213046
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0AE\uC5D0\uB9CC \uAC00. \uBC24\uC758 \uACE8\uBAA9\uC740 \uC6B0\uB9AC \uD3B8\uC774 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213045
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0C8\uBCBD\uB3D9\uC774\uAD6C\uB098. \uC0AC\uB78C\uC774 \uC0B4\uB358 \uACF3\uC774\uB2C8 \uC4F8 \uB9CC\uD55C \uAC8C \uB9CE\uACA0\uC9C0. \uADF8\uB9AC\uACE0\u2026 \uC0AC\uB78C\uC774 \uB0A8\uC544 \uC788\uC744 \uC218\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213222
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB300\uC2E0 \uADF8 \uD559\uC0DD\uC99D, \uC783\uC5B4\uBC84\uB9AC\uC9C0 \uB9D0\uACE0 \uC798 \uAC16\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407347
    m_Localized: "\uD558\uCC9C \uB451\uC5D0 \uB0C9\uC774\uC640 \uC465\uC774 \uC794\uB729 \uC62C\uB77C\uC640 \uC788\uC5C8\uB2E4. \uD55C \uC90C\uC529 \uB72F\uC5B4 \uBD09\uC9C0\uC5D0 \uB2F4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213176
    m_Localized: "\uB044\uAE30 \uC9C1\uC804, \uB178\uB7AB\uC18C\uB9AC\uAC00 \uC544\uC8FC \uC7A0\uAE50 \uB2E4\uC2DC \uB4E4\uB9B0 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212839
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBCD1\uC6D0\uC5D0\uC120 '\uD2B8\uB9AC\uC544\uC9C0'\uB77C\uACE0 \uD574. \uC0B4\uB9B4 \uC218 \uC788\uB294 \uC0AC\uB78C\uBD80\uD130. \uB4E3\uAE30 \uC88B\uC740 \uB9D0\uC740 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407348
    m_Localized: "\uBB3C\uC18C\uB9AC\uAC00 \uCEE4\uC11C, \uC624\uB79C\uB9CC\uC5D0 \uB0B4 \uBC1C\uC18C\uB9AC\uB97C \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uACE0 \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212659
    m_Localized: "\uC120\uC0DD\uB2D8 \uC774\uBD88 \uACC1\uC5D0 \uC549\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uB208\uC744 \uB728\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212660
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uBA38\uB9AC\uB9E1\uC5D0 \uCEF5\uB77C\uBA74 \uD558\uB098\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uB69C\uAED1\uC5D0 \uBCFC\uD39C\uC73C\uB85C \uC4F4 \uAE00\uC528."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213221
    m_Localized: "\uC544\uC9C1\uC740 \uB9D0\uD558\uAE30 \uC5B4\uB835\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213220
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC740 \uCE5C\uAD6C\uAD6C\uB098. \uAF2D \uB2E4\uC2DC \uB9CC\uB098\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213219
    m_Localized: "\uB9D0\uD558\uB2E4 \uBCF4\uB2C8 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212783
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uD559\uAD50 \uC55E \uD070 \uC0AC\uAC70\uB9AC\uC5D0\uC11C \uBC1C\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212784
    m_Localized: "\uAEBC\uC9C4 \uC2E0\uD638\uB4F1 \uAE30\uB465\uB9C8\uB2E4 \uBD89\uC740 \uD398\uC778\uD2B8\uB85C \uAC19\uC740 \uD45C\uC2DC\uAC00 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4. \uB3D9\uADF8\uB77C\uBBF8 \uC548\uC5D0 \uC5D1\uC2A4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212840
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC74 \uC5B4\uB978\uC774 \uC815\uD560 \uC77C\uC774 \uC544\uB2C8\uC5D0\uC694. \uC5EC\uAE30\uC11C \uBC16\uC5D0 \uB098\uAC00\uB294 \uAC74 \uC774 \uC544\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213175
    m_Localized: "\uC804\uB825\uC744 \uC544\uB07C\uB824\uACE0 \uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213044
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uB9D0\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC9C0\uB3C4\uB97C \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213043
    m_Localized: "\uBA87\uBA87 \uBCA0\uB780\uB2E4\uC5D0\uB294 \uC544\uC9C1 \uBE68\uB798\uAC00 \uAC78\uB824 \uC788\uC5C8\uB2E4. \uBC14\uB78C\uC5D0 \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213042
    m_Localized: "\uD3B8\uC758\uC810 \uC625\uC0C1\uC5D0\uC11C \uBCF4\uB2C8 \uACE8\uBAA9 \uB108\uBA38\uB85C \uBE4C\uB77C\uCD0C\uC774 \uC774\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213218
    m_Localized: "\uB5A1\uBCF6\uC774\uB97C \uC88B\uC544\uD558\uACE0, \uC2DC\uD5D8 \uC804\uB0A0\uC5D0\uB9CC \uACF5\uBD80\uD558\uACE0, \uC6C3\uC744 \uB54C \uCF54\uB97C \uCC21\uADF8\uB9AC\uB294 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213217
    m_Localized: "{0}\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212661
    m_Localized: "'\uC0DD\uC77C \uCD95\uD558\uD574. \u2014 \uC724'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212662
    m_Localized: "{0}: \uC81C \uC0DD\uC77C\u2026 \uC5B4\uB5BB\uAC8C \uC544\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213216
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: {0} \uC598\uAE30, \uD574 \uC904 \uC218 \uC788\uC5B4? \uB124\uAC00 \uC790\uAFB8 \uADF8 \uD559\uC0DD\uC99D\uC744 \uB9CC\uC9C0\uAE38\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212806
    m_Localized: "\uC870\uAC74\uC744 \uBD99\uC5EC \uD611\uC0C1\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212843
    m_Localized: "{0}: \uC544\uD508 \uC0AC\uB78C\uC774 \uBA3C\uC800\uC608\uC694. \uB0B4\uC77C \uB098\uAC00\uC57C \uD558\uB294 \uC0AC\uB78C\uC774\uB77C\uB3C4, \uC624\uB298 \uC544\uD504\uC9C0 \uC54A\uC73C\uBA74 \uAE30\uB2E4\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213215
    m_Localized: "\uC5BC\uAD74\uC774 \uD655 \uB2EC\uC544\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212785
    m_Localized: "\uC2E0\uD638\uB4F1 \uC544\uB798 \uBC84\uC2A4 \uC815\uB958\uC7A5\uC5D0, \uBE44\uB3C4 \uC548 \uC624\uB294\uB370 \uC6B0\uBE44\uB97C \uC785\uC740 \uC0AC\uB78C \uC14B\uC774 \uC549\uC544 \uC788\uC5C8\uB2E4. \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212786
    m_Localized: "\uBAB8\uC744 \uB0AE\uCD94\uACE0 \uACE8\uBAA9\uC73C\uB85C \uB3CC\uC544\uC11C \uC654\uB2E4. \uAD50\uBB38 \uC606 \uB2F4\uC7A5\uC5D0\uB3C4 \uAC19\uC740 \uD45C\uC2DC\uAC00 \uC788\uC5C8\uB2E4. \uC624\uB298 \uC544\uCE68\uC5D4 \uC5C6\uB358 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213041
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD30C\uC77C\uC744 \uAC00\uBC29\uC5D0 \uB3C4\uB85C \uB123\uC5B4 \uC8FC\uACE0, \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213040
    m_Localized: "\uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213039
    m_Localized: "\uADF8\uB0A0 \uBC24, \uCC98\uC74C\uC73C\uB85C \uADF8 \uC774\uC57C\uAE30\uB97C \uC870\uAE08 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213038
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB124\uAC00 \uC0AC\uACFC\uD560 \uC77C\uC774 \uC544\uB2C8\uC57C. \uC0AC\uACFC\uB294 \uB0B4\uAC00 \uD574\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213037
    m_Localized: "\uBBF8\uC548\uD558\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212841
    m_Localized: "\uB450 \uC5B4\uB978\uC774 \uB098\uB97C \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212842
    m_Localized: "\uAC00\uC7A5 \uC544\uD508 \uC0AC\uB78C\uBD80\uD130 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212787
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC0AC\uAC70\uB9AC \uD30C. \uC0AC\uD0DC \uCD08\uC5D0 \uC18C\uBB38\uC744 \uB4E4\uC5C8\uC5B4. \uC0AC\uAC70\uB9AC\uB97C \uCC28\uC9C0\uD558\uACE0, \uD45C\uC2DC\uD55C \uACF3\uC744 \uCC28\uB840\uB85C \uD134\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212788
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uD45C\uC2DC\uB294, \uB2E4\uC74C\uC740 \uC5EC\uAE30\uB77C\uB294 \uB73B\uC77C \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407435
    m_Localized: "\uC804\uB9DD\uB300\uC5D0\uC11C \uC8FC\uC6B4 \uC791\uC740 \uB3CC \uD558\uB098\uB97C \uC120\uC0DD\uB2D8 \uCC45\uC0C1\uC5D0 \uC62C\uB824 \uB450\uC5C8\uB2E4. \uBC14\uB2E4\uAC00 \uBCF4\uC774\uB358 \uACF3\uC758 \uB3CC\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407436
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70, \uC878\uC5C5 \uC568\uBC94 \uB300\uC2E0 \uC624\uB798 \uAC04\uC9C1\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213036
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC228\uAE34 \uAC70 \uD0D3\uD558\uC9C0 \uC54A\uC544. \uC228\uAE30\uACE0 \uC2F6\uC744 \uB9CC\uD588\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213035
    m_Localized: "\uD654\uB09C \uBAA9\uC18C\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB798\uC11C \uB354 \uC544\uD320\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212844
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8 \uB208\uBE5B\uC774 \uC870\uAE08 \uB180\uB780 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212845
    m_Localized: "\uBC16\uC5D0 \uB098\uAC00\uB294 \uC0AC\uB78C\uBD80\uD130 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212789
    m_Localized: "\uD45C\uC2DC\uB97C \uC9C0\uC6B0\uACE0, \uAD50\uBB38\uC744 \uB354 \uB2E8\uB2E8\uD788 \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810822
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uCD9C\uC11D\uBD80\uB97C \uC11C\uB78D \uB9E8 \uC548\uCABD\uC5D0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213034
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70\u2026 \uB124\uAC00 \uC228\uACA8 \uB454 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213033
    m_Localized: "\uAC00\uBC29\uC744 \uC815\uB9AC\uD558\uB358 \uC120\uC0DD\uB2D8\uC774 \uBA48\uCDC4\uB2E4. \uC190\uC5D0 \uADF8 \uD30C\uC77C\uC774 \uB4E4\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213174
    m_Localized: "\uB204\uAD70\uAC00 \uC800 \uBC16\uC5D0\uC11C \uC74C\uC545\uC744 \uD2C0\uACE0 \uC788\uB2E4. \uADF8 \uC0AC\uC2E4\uB9CC\uC73C\uB85C \uC774\uC0C1\uD558\uAC8C \uB9C8\uC74C\uC774 \uB193\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214540
    m_Localized: "\uC625\uC0C1 \uBB38\uC740 \uB179\uC774 \uC2AC\uC5B4 \uC788\uC5C8\uC9C0\uB9CC \uC7A0\uACA8 \uC788\uC9C0\uB294 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407484
    m_Localized: "\uAD6D\uC5B4, \uC0DD\uC874, \uC751\uAE09\uCC98\uCE58. \uADF8\uB9AC\uACE0 \uB9E8 \uC544\uB798\uC5D0 \uC0C8\uB85C \uC801\uD78C \uCE78. \uACFC\uD559, \uC74C\uC545, \uACF5\uD559."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407483
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uAC04\uD45C. \uAD50\uC2E4\uC774 \uC0DD\uACBC\uC73C\uB2C8\uAE4C, \uC218\uC5C5\uB3C4 \uC81C\uB300\uB85C \uD574\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213214
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uBBF8 \uC4F0\uACE0 \uC788\uC5B4. \uB124 \uC77C\uAE30, \uAC00\uB054 \uC18C\uB9AC \uB0B4\uC11C \uC77D\uC796\uC544. \uB2E4 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212663
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4 \uCEF4\uD4E8\uD130\uC5D0 \uBC18 \uB2F4\uC784\uC774 \uC815\uB9AC\uD574 \uB454 \uD30C\uC77C\uC774 \uC788\uB354\uB77C. \uB2E8\uD1A1\uBC29 \uC0DD\uC77C \uBAA9\uB85D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212664
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4 \uC11C\uB78D\uC5D0 \uBC18 \uB2F4\uC784\uC774 \uAC77\uC5B4 \uB454 \uAE30\uCD08 \uC870\uC0AC\uC11C\uAC00 \uC788\uB354\uB77C. \uC0DD\uC77C \uCE78\uC5D0 \uB124 \uAE00\uC528\uAC00 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212846
    m_Localized: "{0}: \uBC16\uC5D0 \uB098\uAC00\uB294 \uC0AC\uB78C\uC774 \uC4F0\uB7EC\uC9C0\uBA74 \uB2E4 \uAC19\uC774 \uAD76\uC5B4\uC694. \uADF8\uB7EC\uB2C8\uAE4C \uB098\uAC00\uB294 \uC0AC\uB78C \uBA3C\uC800\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212847
    m_Localized: "\uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC5C8\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC740 \uADF8 \uC6D0\uCE59\uC744 \uC57D\uC7A5 \uBB38\uC5D0 \uC801\uC5C8\uB2E4. \uAE00\uC528\uAC00 \uC870\uAE08 \uB531\uB531\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407349
    m_Localized: "\uB451\uAE38 \uB05D\uC5D0\uC11C \uADF8\uAC83\uB4E4\uC758 \uADF8\uB9BC\uC790\uB97C \uBD24\uB2E4. \uB3CC\uC544\uC11C \uB6F0\uB2E4\uAC00 \uBE44\uD0C8\uC5D0\uC11C \uBBF8\uB044\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212848
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uD310\uB2E8\uD574 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212849
    m_Localized: "{0}: \uC800\uB294 \uBAA8\uB974\uACA0\uC5B4\uC694. \uC544\uB294 \uC0AC\uB78C\uC774 \uC815\uD574 \uC8FC\uC138\uC694. \uB300\uC2E0 \uC815\uD560 \uB54C\uB9C8\uB2E4 \uC774\uC720\uB97C \uB9D0\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212790
    m_Localized: "\uC2DC\uBA58\uD2B8 \uAC00\uB8E8\uB97C \uBB3C\uC5D0 \uAC1C\uC5B4 \uD45C\uC2DC\uB97C \uB36E\uC5C8\uB2E4. \uC190\uC774 \uB5A8\uB824\uC11C \uBA87 \uBC88\uC774\uB098 \uB2E4\uC2DC \uCE60\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214539
    m_Localized: "\uC625\uC0C1\uC73C\uB85C \uAC00\uB294 \uACC4\uB2E8\uC740 \uC5F4\uC5EC\uC12F \uCE78\uC774\uC5C8\uB2E4. \uC62C\uB77C\uAC00\uB294 \uB3D9\uC548 \uC138\uC5B4 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213173
    m_Localized: "\uD55C \uC2DC\uAC04 \uB3D9\uC548 \uB2E4\uC774\uC5BC\uC744 \uB3CC\uB838\uC9C0\uB9CC \uB2E4\uC2DC \uC7A1\uD788\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uC8FC\uD30C\uC218 \uC22B\uC790\uB97C \uCE60\uD310\uC5D0 \uC801\uC5B4 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212791
    m_Localized: "\uC9C0\uC6B4\uB2E4\uACE0 \uC5C6\uB358 \uC77C\uC774 \uB418\uC9C0\uB294 \uC54A\uB294\uB2E4. \uADF8\uB798\uB3C4, \uC6B0\uB9AC\uAC00 \uC5EC\uAE30\uC11C \uBCF4\uACE0 \uC788\uB2E4\uB294 \uAC74 \uC54C \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212850
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC88B\uC544. \uADF8 \uC870\uAC74, \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212851
    m_Localized: "\uBC24. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC724 \uC120\uC0DD\uB2D8\uC758 \uBAA9\uBC1C \uB192\uC774\uB97C \uC7AC\uACE0 \uC788\uC5C8\uB2E4. \uC904\uC790\uB97C \uB4E4\uACE0, \uBB34\uB98E \uC544\uB798\uB97C \uC624\uB798 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213032
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB9DE\uC544. \uD654\uB0BC \uB9CC\uD574. \uB354 \uD654\uB0B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213031
    m_Localized: "\uC18C\uB9AC\uB97C \uC9C0\uB974\uACE0 \uB098\uB2C8 \uC624\uD788\uB824 \uC228\uC774 \uC26C\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213172
    m_Localized: "\uC8FC\uD30C\uC218\uB97C \uC870\uAE08\uC529 \uB3CC\uB824 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214538
    m_Localized: "\uD30C\uC77C\uC744 \uB118\uAE30\uB2E4 '\uC724' \uC131\uC758 \uC774\uB984 \uC55E\uC5D0\uC11C \uC190\uC774 \uBA48\uCDC4\uB2E4. \uD608\uC561\uD615 \uCE78\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212792
    m_Localized: "\uD45C\uC2DC \uC606\uC5D0 '\uBE48 \uD559\uAD50. \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC74C.'\uC774\uB77C\uACE0 \uB367\uCE60\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407350
    m_Localized: "\uBB34\uB98E\uC774 \uAE4C\uC84C\uB2E4. \uADF8\uB798\uB3C4 \uC8FC\uBA39\uBC25\uC740 \uB05D\uAE4C\uC9C0 \uC190\uC5D0 \uC950\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407351
    m_Localized: "\uBC29\uD559\uC774\uC5C8\uB2E4. \uBC29\uD559\uC2DD\uB3C4, \uC0DD\uD65C \uD1B5\uC9C0\uD45C\uB3C4 \uC5C6\uC5C8\uC9C0\uB9CC \uB2EC\uB825\uC740 \uBC29\uD559\uC774\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212665
    m_Localized: "\uB2E8\uD1A1\uBC29 \uC0DD\uC77C \uBAA9\uB85D. \uADF8\uB0A0 \uC544\uCE68, {0} \uB9CC\uB4E4\uACA0\uB2E4\uACE0 \uD588\uB358 \uADF8 \uBAA9\uB85D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212666
    m_Localized: "{0} \uB0A8\uC758 \uC0DD\uC77C\uC744 \uB9E8\uB0A0 \uAE4C\uBA39\uC5C8\uB2E4. \uC62C\uD574\uB294 \uAE30\uC5B5\uD558\uACE0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407352
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uD559\uC5D4 \uB180\uC544\uC57C\uC9C0. \uADF8\uAC8C \uC219\uC81C\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407353
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB3C\uB180\uC774\uD558\uACE0 \uB098\uBA74 \uADC0\uC5D0 \uBB3C \uAF2D \uBE7C. \uC5EC\uAE30\uC11C \uC911\uC774\uC5FC \uAC78\uB9AC\uBA74 \uC57D\uB3C4 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407354
    m_Localized: "\uBE48 \uC218\uC601\uC7A5\uC5D0 \uACE0\uC778 \uBE57\uBB3C\uC5D0\uC11C \uBB3C\uB180\uC774\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407355
    m_Localized: "\uC218\uC601\uC7A5 \uBC14\uB2E5\uC5D0 \uBB34\uB98E\uAE4C\uC9C0 \uBE57\uBB3C\uC774 \uACE0\uC5EC \uC788\uC5C8\uB2E4. \uBBF8\uC9C0\uADFC\uD558\uACE0 \uC870\uAE08 \uD0C1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407556
    m_Localized: "{0}: 2\uBC88. '\uC0AC\uACFC' \uD558\uBA74 \uB5A0\uC624\uB974\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214537
    m_Localized: "\uD30C\uC77C\uC744 \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212852
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC0C1\uCC98\uB294 \uB2E4 \uC544\uBB3C\uC5C8\uC5B4\uC694. \uC774\uC81C \uBAA9\uBC1C \uB9D0\uACE0 \uB2E4\uB978 \uAC83\uB3C4 \uC0DD\uAC01\uD574 \uBCFC \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212667
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD1B\uBD88\uC740 \uC5C6\uC9C0\uB9CC. \uC18C\uC6D0\uC740 \uBE4C\uC5B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407356
    m_Localized: "\uCC98\uC74C\uC5D4 \uBC1C\uB9CC \uB2F4\uAC14\uB2E4. \uB098\uC911\uC5D4 \uC11C\uB85C \uBB3C\uC744 \uD280\uAE30\uBA70 \uC6C3\uC5C8\uB2E4. \uC18C\uB9AC\uB97C \uC8FD\uC774\uB290\uB77C \uC6C3\uC74C\uC774 \uB354 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212793
    m_Localized: "\uD07C\uC9C1\uD558\uAC8C, \uB300\uCDA9, \uBC84\uB824\uC9C4 \uACF3\uCC98\uB7FC \uBCF4\uC774\uAC8C \uC37C\uB2E4. \uCC3D\uBB38\uC5D0\uB294 \uC77C\uBD80\uB7EC \uBA3C\uC9C0\uB97C \uBB3B\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213030
    m_Localized: "{0}: \uC120\uC0DD\uB2D8\uB4E4\uC740 \uC65C \uC544\uBB34\uB3C4 \uBAB0\uB790\uC5B4\uC694? \uB2E4\uB4E4 \uBCF4\uACE0 \uC788\uC5C8\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213029
    m_Localized: "\uC65C \uBAB0\uB790\uB0D0\uACE0, \uCC98\uC74C\uC73C\uB85C \uD654\uB97C \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213028
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB9D0\uD558\uACE0 \uC2F6\uC744 \uB54C \uB9D0\uD574. \uADF8\uB54C\uAE4C\uC9C0 \uB098\uB294 \uC5EC\uAE30 \uC788\uC744 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213027
    m_Localized: "\uC544\uC9C1\uC740 \uB9D0\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213213
    m_Localized: "\uC800\uB3C4 \uADF8\uB7F0 \uAE00\uC744 \uC4F0\uACE0 \uC2F6\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213212
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uC120\uC0DD\uB2D8 \uC774\uB984\uC744 \uB9D0\uD574 \uC8FC\uC5C8\uB2E4. \uC9C0\uAE08\uC740 \uC5B4\uB514 \uACC4\uC2E4\uAE4C, \uD558\uACE0 \uD63C\uC7A3\uB9D0\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213211
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213210
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC8C \uCE6D\uCC2C\uC778 \uC904 \uBAB0\uB790\uB294\uB370, \uB098\uC911\uC5D0 \uBCF4\uB2C8\uAE4C \uC81C\uC77C \uC88B\uC740 \uCE6D\uCC2C\uC774\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213209
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uB4F1\uD559\uAD50 \uB54C \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uAE00\uC744 \uC77D\uACE0 \uADF8\uB7AC\uC5B4. \uB108\uB294 \uB0A8\uC758 \uB9D0\uC744 \uC798 \uB4E3\uB294 \uAE00\uC744 \uC4F4\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213208
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC65C \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC774 \uB410\uB0D0\uACE0? \uADF8\uAC70 \uBA74\uC811 \uB54C \uC9C8\uBB38\uC774\uB791 \uB611\uAC19\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213207
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC73C\uBA70 \uCD9C\uC11D\uBD80\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uB098\uBA38\uC9C0 \uC774\uB984\uC740 \uC18C\uB9AC \uB0B4\uC5B4 \uBD80\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213171
    m_Localized: "\uC18C\uB9AC\uAC00 \uB04A\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213170
    m_Localized: "???: \u2026\uC5EC\uAE30\uB294 \uC720, \uBE44, \uC528\u2026 \uB4E3\uB294 \uC0AC\uB78C \uC788\uC73C\uBA74\u2026 \uB0B4\uC77C\uB3C4 \uC774 \uC2DC\uAC04\uC5D0\u2026 \uC2E0\uCCAD\uACE1\uC740\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213206
    m_Localized: "\uC791\uAC8C \uC190\uB9CC \uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212794
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC18D\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4. \uC0AC\uB78C\uC740 \uBE44\uC5B4 \uC788\uB2E4\uB294 \uB9D0\uC744 \uC81C\uC77C \uC548 \uBBFF\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212795
    m_Localized: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uC9C0\uCF1C\uBCF4\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213026
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798 \uBC84\uD17C\uB2E4. \uC815\uB9D0\uB85C, \uC798 \uBC84\uD17C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213025
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB05D\uAE4C\uC9C0 \uB07C\uC5B4\uB4E4\uC9C0 \uC54A\uACE0 \uB4E4\uC5C8\uB2E4. \uB2E4 \uB4E3\uACE0 \uB098\uC11C\uC57C \uB531 \uD55C \uB9C8\uB514\uB97C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213024
    m_Localized: "\uD558\uB098\uC529 \uB9D0\uD588\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uBAA9\uC18C\uB9AC\uAC00 \uB5A8\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407357
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uAC00\uC7A5\uC790\uB9AC\uC5D0 \uC549\uC544 \uBC1C\uC744 \uB2F4\uADF8\uACE0, \uC816\uC9C0 \uC54A\uC740 \uCABD \uB2E4\uB9AC\uB97C \uD587\uBCD5\uC5D0 \uB0B4\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407358
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uBC24\uD558\uB298 \uD53C\uD06C\uB2C9\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213169
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C \uC74C\uC545\uC774 \uBA87 \uB9C8\uB514. \uADF8\uB9AC\uACE0 \uB204\uAD70\uAC00\uC758 \uC6C3\uC74C\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213168
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB34\uC804\uAE30\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uC0AC\uB78C \uBAA9\uC18C\uB9AC \uBE44\uC2B7\uD55C \uAC83\uC774 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407359
    m_Localized: "\uB0AE\uC758 \uC5F4\uAE30\uAC00 \uC2DD\uC740 \uC625\uC0C1 \uBC14\uB2E5\uC5D0 \uB204\uC6E0\uB2E4. \uBD88 \uAEBC\uC9C4 \uB3C4\uC2DC \uC704\uB85C \uC740\uD558\uC218\uAC00 \uD750\uB9BF\uD558\uAC8C \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212668
    m_Localized: "\uBB3C\uC744 \uB053\uC5EC \uCEF5\uB77C\uBA74\uC744 \uBC18\uC529 \uB098\uB220 \uBA39\uC5C8\uB2E4. \uAD6D\uBB3C\uAE4C\uC9C0 \uB2E4 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212669
    m_Localized: "\uB208\uC744 \uAC10\uACE0 \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBB34\uC2A8 \uC18C\uC6D0\uC774\uB0D0\uACE0 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213023
    m_Localized: "\uADF8\uB0A0 \uC788\uC5C8\uB358 \uC77C\uC744 \uCC98\uC74C\uBD80\uD130 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212796
    m_Localized: "\uD45C\uC2DC\uB294 \uADF8\uB300\uB85C \uB450\uC5C8\uB2E4. \uBC24\uB9C8\uB2E4 \uADF8 \uBD89\uC740 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uB208\uC744 \uAC10\uC544\uB3C4 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212797
    m_Localized: "\uB300\uB0AE\uC5D0 \uAD50\uBB38 \uC55E\uC5D0 \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uB0A8\uC790\uAC00 \uD63C\uC790 \uC11C \uC788\uC5C8\uB2E4. \uC190\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uB4E4\uACE0 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213022
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBBF8\uC548\uD558\uB2E4. \uBAB0\uB790\uB2E4\uB294 \uAC74 \uBCC0\uBA85\uC774 \uC548 \uB3FC. \uC5B4\uB978\uC774 \uBAB0\uB790\uC73C\uBA74 \uC548 \uB418\uB294 \uAC70\uC600\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213021
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4 \uD559\uAD50\uC5D0\uC11C. \uB0B4\uAC00 \uBAA8\uB974\uB294 \uC0AC\uC774\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213205
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC1C\uADFC\uC774\uB124. \uB300\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213204
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uD145 \uBE48 \uBCF5\uB3C4\uAE4C\uC9C0 \uC6B8\uB838\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uCD9C\uC11D\uBD80\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213203
    m_Localized: "{0}: \uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213167
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uC5B4\uAE68\uB97C \uB450\uB4DC\uB824 \uC8FC\uC5C8\uB2E4. \uB3C4\uD604\uC774 \uCABD\uC9C0\uB97C \uC811\uC5B4 \uAC00\uC2B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213166
    m_Localized: "\uB3C4\uD604: \u2026\uC0B4\uC544 \uC788\uC744 \uC218\uB3C4 \uC788\uACA0\uC8E0? \uB300\uD53C\uC18C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213202
    m_Localized: "\uD06C\uAC8C \uB300\uB2F5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213201
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD9C\uC11D \uBD80\uB974\uACA0\uB2E4. {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213020
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD55C\uB3D9\uC548 \uB9D0\uC744 \uC787\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213019
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uB108\uB97C \uCC3D\uACE0\uC5D0 \uAC00\uB454 \uAC8C\u2026 \uADF8 \uC560\uB4E4\uC774\uC5C8\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810823
    m_Localized: "\uC7A0\uC774 \uC624\uC9C0 \uC54A\uB294 \uBC24\uC774\uC5C8\uB2E4. \uCC3D\uD2C0\uC5D0 \uAE30\uB300\uC5B4 \uBC14\uAE65\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212798
    m_Localized: "\uB0A8\uC790: \uAC81\uBA39\uC9C0 \uB9C8. \uC624\uB298\uC740 \uB9D0\uB9CC \uD558\uB7EC \uC654\uC5B4. \uC6B0\uB9AC \uD615\uB2D8 \uB9D0 \uC804\uD558\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213018
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77D\uC5C8\uC5B4. \uC804\uBD80."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407368
    m_Localized: "\uD558\uB298\uC774 \uB192\uC558\uB2E4. \uC6D0\uB798 \uAC00\uC744 \uC18C\uD48D\uC740 \uB180\uC774\uACF5\uC6D0\uC774\uC5C8\uB2E4\uACE0 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407369
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC624\uB298 \uC880 \uC274\uAC8C. \uB300\uC2E0 \uB2E8\uD48D \uC0AC\uC9C4\uCC98\uB7FC, \uB208\uC5D0 \uB2F4\uC544 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213200
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uAD50\uC2E4 \uC55E\uC5D0 \uC11C\uC11C \uCD9C\uC11D\uBD80\uB97C \uD3BC\uCCE4\uB2E4. \uC9C4\uC9DC \uCD9C\uC11D\uBD80\uC600\uB2E4. \uAD50\uBB34\uC2E4\uC5D0\uC11C \uAC00\uC838\uC628."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213017
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uC190\uC804\uB4F1 \uBD88\uBE5B \uC544\uB798\uC5D0\uC11C \uC624\uB798 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBB34\uB98E \uC704\uC5D0 \uADF8 \uD30C\uC77C\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213016
    m_Localized: "\uC544\uBB34\uB3C4 \uBAA8\uB974\uAC8C. \uC9C0\uAE08\uC740 \uC544\uBB34\uC5D0\uAC8C\uB3C4 \uBCF4\uC5EC \uC8FC\uACE0 \uC2F6\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213015
    m_Localized: "\uD30C\uC77C\uC744 \uBAB0\uB798 \uAC00\uBC29 \uAE4A\uC219\uC774 \uB123\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213014
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB098\uC911\uC5D0 \uC77D\uC744\uAC8C. \uC9C0\uAE08\uC740 \uB108\uB791 \uAC19\uC774 \uC788\uC744 \uB54C \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212799
    m_Localized: "\uB0A8\uC790: \uC5EC\uAE30 \uC560\uB4E4\uC774\uB791 \uB2E4\uB9AC \uC5C6\uB294 \uC120\uC0DD \uD558\uB098 \uC0AC\uB294 \uAC70 \uB2E4 \uC54C\uC544. \uAC15\uCCA0\uC774 \uD615\uB2D8\uC774 \uADF8\uB7EC\uB354\uB77C. \uC560\uB4E4\uC740 \uAC74\uB4DC\uB9AC\uC9C0 \uB9D0\uC790\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213199
    m_Localized: "\uC624\uB298\uC740 2\uD559\uAE30 \uAC1C\uD559 \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213004
    m_Localized: "\uAD50\uBB34\uC2E4\uC740 \uC11C\uB958 \uB354\uBBF8\uC600\uB2E4. \uCC45\uC0C1\uB9C8\uB2E4 \uC2DC\uD5D8\uC9C0\uC640 \uAC00\uC815\uD1B5\uC2E0\uBB38\uC774 \uC313\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213003
    m_Localized: "\uB178\uD2B8\uB97C \uB36E\uB294 \uC190\uC774 \uC870\uAE08 \uCC28\uAC00\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213224
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC0C1\uD558\uC9C0. \uC5C6\uB294 \uB2E4\uB9AC\uAC00 \uAC00\uB054 \uC800\uB824. \uBC1C\uAC00\uB77D\uC774 \uAC04\uC9C0\uB7FD\uAE30\uB3C4 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212658
    m_Localized: "\uB69C\uAED1\uC5D0 \uBCFC\uD39C\uC73C\uB85C \uC4F4 \uAE00\uC528. \uB5A8\uB9AC\uB294 \uAE00\uC528\uC600\uB2E4. '\uC0DD\uC77C \uCD95\uD558\uD574. \u2014 \uC724'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212657
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uBA38\uB9AC\uB9E1\uC5D0 \uCEF5\uB77C\uBA74 \uD558\uB098\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uB3C4\uD604\uC774 \uC0C8\uBCBD\uC5D0 \uBAB0\uB798 \uAC16\uB2E4 \uB193\uC558\uB2E4\uACE0 \uD588\uB2E4. \uC120\uC0DD\uB2D8 \uC2EC\uBD80\uB984\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213225
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC694\uC998\uC740 \uBC24\uB9C8\uB2E4 \uC880 \uB354 \uADF8\uB798. \uC5F4\uC774 \uB098\uB294 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213226
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uAE30\uB85D\uD55C\uB2E4\uB358 \uADF8 \uC218\uCCA9\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213227
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uAED8 \uAF2D \uB9D0\uD558\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213228
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uADF8\uB798. \uC794\uC18C\uB9AC\uAFBC\uC774 \uB458\uC774 \uB410\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213229
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC5C8\uC9C0\uB9CC, \uADF8\uB0A0 \uBC24 \uAE30\uCE68\uC744 \uBA87 \uBC88 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213052
    m_Localized: "\uD55C\uCC38\uC744 \uAE30\uB2E4\uB838\uC9C0\uB9CC \uB300\uB2F5\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407499
    m_Localized: "\uCC2C\uC7A5 \uC548\uCABD\uC5D0\uC11C \uC300 \uD3EC\uB300\uC640 \uBD80\uD0C4\uAC00\uC2A4\uB97C \uCC3E\uC558\uB2E4. \uB0C4\uBE44\uB3C4, \uAD6D\uC790\uB3C4 \uADF8\uB300\uB85C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407500
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uC2A4\uAC00 \uC788\uC73C\uBA74 \uB370\uC6CC \uBA39\uC744 \uC218 \uC788\uACA0\uB2E4. \u2026\uC694\uB9AC, \uBC30\uC6CC \uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213053
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC81\uC774 \uB9CE\uC740 \uC0AC\uB78C\uC77C \uAC70\uC57C. \uADF8\uAC8C \uC9C0\uAE08\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC740 \uC774\uC720\uC77C \uC218\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213054
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBCF4\uAC74\uC2E4 \uBB38\uC744 \uC5F4\uC790\uB9C8\uC790 \uC57D\uC7A5\uBD80\uD130 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213055
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBD95\uB300\uAC00 \uC774\uAC83\uBC16\uC5D0 \uC5C6\uC5B4? \uC18C\uB3C5\uC57D\uC740? \uC544\uB2C8, \uC774\uAC74 \uC720\uD1B5\uAE30\uD55C\uC774\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213056
    m_Localized: "\uADF8\uB9AC\uACE0 \uBAA9\uBC1C\uC744 \uC9DA\uC740 \uC724 \uC120\uC0DD\uB2D8\uC744 \uBCF4\uACE0\uB294 \uB9D0\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407501
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC55E\uCE58\uB9C8 \uC774\uC57C\uAE30\uB294 \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uAEBC\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407502
    m_Localized: "\uACFC\uD559\uC2E4 \uBCBD\uC5D0 \uC8FC\uAE30\uC728\uD45C\uAC00 \uBC18\uCBE4 \uCC22\uC5B4\uC9C4 \uCC44 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC2E4\uD5D8\uB300 \uC11C\uB78D\uB9C8\uB2E4 \uC54C\uCF54\uC62C\uB7A8\uD504\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213230
    m_Localized: "\uB18D\uB2F4\uC73C\uB85C \uB118\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213057
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC724 \uC120\uC0DD\uB2D8. \uC0B4\uC544 \uACC4\uC168\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213058
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC15 \uC120\uC0DD\uB2D8\uB3C4\uC694. \uB2E4\uD589\uC785\uB2C8\uB2E4. \uC815\uB9D0 \uB2E4\uD589\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213059
    m_Localized: "\uB450 \uC5B4\uB978\uC774 \uD55C\uCC38 \uB3D9\uC548 \uC11C\uB85C\uB97C \uBCF4\uAE30\uB9CC \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407503
    m_Localized: "\uBD88\uC744 \uBD99\uC774\uBA74 \uBB3C\uC744 \uB053\uC77C \uC218 \uC788\uB2E4. \uADF8 \uC0DD\uAC01\uC774 \uBA3C\uC800 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407504
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB7A8\uD504 \uCC59\uACA8 \uC654\uC5B4? \uC798\uD588\uB2E4. \uACFC\uD559 \uC120\uC0DD\uB2D8 \uCC45\uC0C1\uC5D0 \uAD50\uACFC\uC11C\uB3C4 \uC788\uC5C8\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213231
    m_Localized: "{0}: \uB2E4\uB9AC\uAC00 \uADF8\uB9AC\uC6B4\uAC00 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212656
    m_Localized: "\uBB38\uC5D0 \uB4F1\uC744 \uAE30\uB300\uACE0 \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4. \uBB38 \uB108\uBA38\uC758 \uC228\uC18C\uB9AC\uAC00 \uAC19\uC774 \uBE4C\uC5B4 \uC8FC\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212655
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: (\uBB38 \uB108\uBA38) \uCD1B\uBD88\uC740 \uC5C6\uC9C0\uB9CC, \uC18C\uC6D0\uC740 \uBE4C\uC5B4\uB3C4 \uB3FC. \u2026\uB0B4\uB144 \uC0DD\uC77C\uC5D4 \uCF00\uC774\uD06C\uB85C \uD558\uC790. \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213232
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB807\uACA0\uC9C0. \uAF64 \uC624\uB798 \uAC19\uC774 \uB2E4\uB154\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213233
    m_Localized: "\uBC24\uC0C8 \uBAA8\uAE30\uAC00 \uADD3\uAC00\uC5D0\uC11C \uC575\uC575\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213234
    m_Localized: "\uCEE4\uD2BC \uCC9C\uC73C\uB85C \uBAA8\uAE30\uC7A5\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212654
    m_Localized: "\uBB38 \uC55E\uC5D0 \uC549\uC544 \uD070 \uC18C\uB9AC\uB85C \uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD588\uB2E4. \uBB38 \uB108\uBA38\uC5D0\uC11C \uC791\uAC8C \uC6C3\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212653
    m_Localized: "'\uC0DD\uC77C \uCD95\uD558\uD574. \uBB38\uC740 \uC5F4\uC9C0 \uB9D0\uACE0, \uB300\uC2E0 \uD06C\uAC8C \uB9D0\uD574 \uC918. \uB2E4 \uB4E4\uB824. \u2014 \uC724'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213235
    m_Localized: "\uC790\uC7AC\uB97C \uC870\uAE08 \uC37C\uC9C0\uB9CC, \uC624\uB79C\uB9CC\uC5D0 \uAE4A\uC774 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213236
    m_Localized: "\uADF8\uB0E5 \uCC38\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212782
    m_Localized: "\uD3B8\uC9C0\uB97C \uCC45\uC0C1 \uC11C\uB78D\uC5D0 \uB2E4\uC2DC \uB123\uC5C8\uB2E4. \uADF8 \uC790\uB9AC\uAC00 \uB9DE\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810820
    m_Localized: "{0}: \uB098\uC911\uC5D0 \uBD10\uC694. \uB2E4 \uAC19\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213060
    m_Localized: "\uC774\uC81C \uC5EC\uAE30\uC11C \uAC19\uC774 \uC9C0\uB0B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213061
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC2E0\uC138 \uC9C0\uACA0\uB2E4\uACE0\uB294 \uC548 \uD560\uAC8C. \uB300\uC2E0 \uC544\uD504\uBA74 \uBC14\uB85C \uB9D0\uD574. \uC228\uAE30\uBA74 \uD63C\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213525
    m_Localized: "{0}: \uC81C\uAC00 \uC606\uC5D0 \uC788\uC744\uAC8C\uC694. \uC5F4 \uC7AC\uACE0, \uC57D \uCC59\uAE30\uACE0. \uBC15 \uC120\uC0DD\uB2D8\uD55C\uD14C \uB2E4 \uBC30\uC6B8\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407346
    m_Localized: "\uD559\uAD50 \uB4A4 \uD558\uCC9C \uC0B0\uCC45\uB85C\uAE4C\uC9C0 \uB098\uAC00 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407345
    m_Localized: "\uC5EC\uAE30\uC11C \uBCF4\uB2C8 \uAD50\uC2E4\uB3D9 \uCC3D\uBB38 \uD558\uB098\uD558\uB098\uAC00, \uD558\uB098\uC529 \uD574\uB0B8 \uC77C \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212652
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uACA9\uB9AC\uD55C \uAD50\uC2E4 \uBB38\uD2C8\uC73C\uB85C \uCABD\uC9C0 \uD55C \uC7A5\uC774 \uBC00\uB824 \uB098\uC640 \uC788\uC5C8\uB2E4. \uAE00\uC528\uAC00 \uB9CE\uC774 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212651
    m_Localized: "\uC885\uC774 \uC6B8\uB838\uC744 \uC2DC\uAC04\uC774 \uC9C0\uB098\uB3C4\uB85D, \uB458\uC740 \uCC3D\uAC00\uB97C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407344
    m_Localized: "\uC625\uC0C1 \uB09C\uAC04 \uC544\uB798\uB85C \uD559\uAD50\uAC00 \uB2E4 \uBCF4\uC600\uB2E4. \uC6B0\uB9AC\uAC00 \uC9C0\uB098\uC628 \uAE38\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407343
    m_Localized: "\uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00 \uB3C4\uC2DC\uB77D\uC744 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407342
    m_Localized: "\uADF8 \uB9D0\uC774 \uC774\uC0C1\uD558\uAC8C \uC2AC\uD504\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407341
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uB144 \uBD04\uC5D0\uB3C4 \uC774 \uB098\uBB34\uB294 \uD544 \uAC70\uC57C. \uC6B0\uB9AC\uAC00 \uBCF4\uB4E0 \uC548 \uBCF4\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407340
    m_Localized: "\uAF43\uC78E\uC774 \uC8FC\uBA39\uBC25 \uC704\uC5D0 \uB0B4\uB824\uC549\uC558\uB2E4. \uD138\uC5B4 \uB0B4\uC9C0 \uC54A\uACE0 \uADF8\uB0E5 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213526
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB0B4 \uC190\uC744 \uAF2D \uC950\uC5C8\uB2E4. \uC190\uC774 \uB728\uAC70\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212781
    m_Localized: "\uC81C\uC790\uB9AC\uC5D0 \uB450\uACE0 \uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212780
    m_Localized: "\uC5B8\uC820\uAC00 \uC8FC\uC778\uC744 \uB9CC\uB098\uBA74 \uC804\uD574 \uC8FC\uACE0 \uC2F6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213527
    m_Localized: "\uBAA8\uB450\uB97C \uC704\uD574 \uAC70\uB9AC\uB97C \uB450\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213528
    m_Localized: "\uC785\uC774 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4. \uBC29\uC1A1\uC2E4\uC5D0\uC11C \uC9C0\uB0B4\uC2DC\uB294 \uAC8C \uC88B\uACA0\uB2E4\uACE0. \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC744 \uC704\uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212650
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 \uC774\uC0C1\uD558\uC9C0. \uC2EB\uC5B4\uD558\uB358 \uAC83\uBD80\uD130 \uBCF4\uACE0 \uC2F6\uC5B4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212649
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB3C4. \uAD50\uC0AC\uB294 \uC904 \uC138\uC6B0\uACE0 \uCC9C\uB9C9 \uCE58\uB290\uB77C \uB354 \uC2EB\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407339
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uBC9A\uB098\uBB34 \uC544\uB798\uC5D0 \uB3D7\uC790\uB9AC\uB97C \uD3B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407338
    m_Localized: "\uB3C4\uD604\uC774 \uC6B4\uB3D9\uD654 \uB048\uC744 \uB450 \uBC88\uC774\uB098 \uACE0\uCCD0 \uBB36\uC5C8\uB2E4. \uC18C\uD48D \uAC00 \uBCF8 \uAC8C \uC5B8\uC81C\uC600\uB294\uC9C0 \uBAA8\uB974\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213529
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8\uAC8C \uB9DE\uB2E4. \uB124\uAC00 \uADF8 \uB9D0\uC744 \uD560 \uC218 \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213530
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC5C8\uB2E4. \uADF8 \uC6C3\uC74C\uC774 \uAC00\uC7A5 \uC544\uD320\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212779
    m_Localized: "\uAC00\uBC29\uC5D0 \uB123\uC5B4 \uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212778
    m_Localized: "'\uB0B4\uC77C \uAF2D \uC0AC\uACFC\uD560\uAC8C. \uC9C4\uC9DC\uB85C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213531
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213532
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uBC31\uD560 \uAC8C \uC788\uB2E4. \uB098\uB294 \uC54C\uACE0 \uC788\uC5C8\uC5B4. \uC5B8\uC820\uAC00 \uC774\uB807\uAC8C \uB420 \uC218 \uC788\uB2E4\uB294 \uAC78."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213533
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBB3C\uB9B0 \uB2E4\uB9AC\uB97C \uC798\uB77C \uB0B4\uACE0 \uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uB4E4 \uC911\uC5D0, \uBA87 \uB2EC \uB4A4\uC5D0 \uB2E4\uC2DC \uC544\uD508 \uC0AC\uB78C\uB4E4\uC774 \uC788\uC5C8\uAC70\uB4E0. \uC18C\uBB38\uC73C\uB85C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213534
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uC11C \uB108\uD55C\uD14C \uB354 \uB9CE\uC774 \uAC00\uB974\uCE58\uACE0 \uC2F6\uC5C8\uC5B4. \uB0B4\uAC00 \uC5C6\uC5B4\uB3C4 \uB124\uAC00 \uD63C\uC790 \uC124 \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407337
    m_Localized: "\uC8FC\uBA39\uBC25 \uB450 \uAC1C\uC640 \uBB3C \uD55C \uBCD1\uC744 \uAC00\uBC29\uC5D0 \uB123\uC5C8\uB2E4. \uADF8\uAC83\uB9CC\uC73C\uB85C \uAC00\uBC29\uC774 \uC870\uAE08 \uB4E4\uB72C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213535
    m_Localized: "\uB05D\uAE4C\uC9C0 \uAC19\uC774 \uAC00\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213536
    m_Localized: "{0}: \uD63C\uC790 \uC11C\uB294 \uAC70 \uB9D0\uACE0, \uAC19\uC774 \uC11C\uB294 \uAC70 \uD560\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213537
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5 \uB300\uC2E0 \uB0B4 \uBA38\uB9AC\uB97C \uD5DD\uD074\uC5B4\uB728\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213538
    m_Localized: "\uB9D0\uC5C6\uC774 \uC190\uC744 \uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213539
    m_Localized: "\uD55C\uCC38\uC744 \uADF8\uB807\uAC8C \uC788\uC5C8\uB2E4. \uCC3D\uBC16\uC73C\uB85C \uCCAB\uB208 \uAC19\uC740 \uAC83\uC774 \uB0A0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212648
    m_Localized: "{0}: \uC800 \uB2EC\uB9AC\uAE30 \uC2EB\uC5B4\uD588\uC5B4\uC694. \uCCB4\uC721\uB300\uD68C \uB0A0\uB9C8\uB2E4 \uBE44 \uC624\uB77C\uACE0 \uBE4C\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212647
    m_Localized: "\uD145 \uBE48 \uD2B8\uB799 \uC704\uB85C \uBC14\uB78C\uC774 \uC9C0\uB098\uAC14\uB2E4. \uC5B8\uC820\uAC00 \uC800\uAE30\uB97C \uB2E4\uC2DC \uB2EC\uB9B4 \uC218 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213237
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uD314\uC5D0 \uC5F4\uB450 \uAD70\uB370\uB97C \uBB3C\uB824 \uC788\uC5C8\uB2E4. \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213540
    m_Localized: "\uC65C \uC774\uC81C \uB9D0\uD588\uB0D0\uACE0 \uD654\uB97C \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213541
    m_Localized: "{0}: \uC65C \uC774\uC81C \uB9D0\uD574\uC694! \uBBF8\uB9AC \uC54C\uC558\uC73C\uBA74\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213542
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC54C\uC558\uC73C\uBA74 \uBB58 \uD560 \uC218 \uC788\uC5C8\uC744\uAE4C. \uADF8\uB798\uB3C4 \uB124 \uB9D0\uC774 \uB9DE\uB2E4. \uBBF8\uC548\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212777
    m_Localized: "\uD0D0\uD5D8 \uC911 \uC8FC\uC6B4 \uD3B8\uC9C0 \uD55C \uC7A5. 2\uD559\uB144 \uB204\uAD70\uAC00\uAC00 \uAC19\uC740 \uBC18 \uCE5C\uAD6C\uC5D0\uAC8C \uC4F4, \uBD80\uCE58\uC9C0 \uBABB\uD55C \uD3B8\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212776
    m_Localized: "\uD574\uAC00 \uB730 \uB54C\uAE4C\uC9C0 \uC190\uC744 \uC7A1\uACE0 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBA87 \uBC88\uC774\uB098 \uACE0\uB9D9\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213238
    m_Localized: "\uBC1C\uC804\uAE30\uAC00 \uD138\uD138\uAC70\uB9AC\uB2E4 \uBA48\uCDC4\uB2E4. \uAD50\uC2E4 \uBD88\uC774 \uAEBC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213239
    m_Localized: "\uC9C1\uC811 \uACE0\uCCD0 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213543
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uCCA9\uC744 \uD3BC\uCCD0 \uBCF4\uC600\uB2E4. \uBA87 \uB2EC \uCE58 \uAE30\uB85D\uC774 \uBE7C\uACE1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213544
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC9C4\uD589\uC740 \uB290\uB824. \uBCF4\uD1B5 \uAC10\uC5FC\uACFC \uB2EC\uB77C. \uC758\uC2DD\uB3C4 \uB610\uB837\uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213545
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC57D\uC73C\uB85C \uB2A6\uCD9C \uC218\uB294 \uC788\uC744 \uAC70\uC57C. \uAC70\uAE30\uAE4C\uC9C0\uB294 \uB098\uB3C4 \uD655\uC2E0\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213546
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8 \uB108\uBA38\uB294\u2026 \uC815\uB9D0 \uBAA8\uB974\uACA0\uB2E4. \uB204\uAD70\uAC00 \uC5F0\uAD6C\uB97C \uD588\uB2E4\uBA74, \uADF8 \uAE30\uB85D\uC774 \uD544\uC694\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213547
    m_Localized: "DJ: \uC624\uB298\uC740 \uC0AC\uC5F0 \uD558\uB098 \uC77D\uC744\uAC8C\uC694. \uC544\uB2C8, \uC0AC\uC5F0\uC774\uB77C\uAE30\uBCF4\uB2E4\u2026 \uAE30\uC5B5\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213240
    m_Localized: "\uAE30\uB984\uB54C \uBB3B\uC740 \uC190\uC73C\uB85C \uD55C \uC2DC\uAC04. \uB2E4\uC2DC \uB3CC\uC544\uAC00\uB294 \uC18C\uB9AC\uAC00 \uC74C\uC545\uCC98\uB7FC \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213241
    m_Localized: "\uC804\uB825\uC744 \uC544\uB07C\uBA70 \uBA70\uCE60 \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213242
    m_Localized: "\uCD1B\uBD88 \uC544\uB798\uC5D0\uC11C \uC9C0\uB0C8\uB2E4. \uBC30\uD130\uB9AC\uC5D0 \uBAA8\uC544 \uB454 \uC804\uAE30\uAC00 \uC904\uC5B4\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213243
    m_Localized: "\uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uC55E\uC5D0 \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBE44\uCA4D \uB9C8\uB978 \uC0BC\uC0C9 \uACE0\uC591\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213548
    m_Localized: "DJ: \uC0AC\uD0DC \uCD08\uBC18\uC5D0 \uC800\uD55C\uD14C \uBB34\uC804\uC774 \uC628 \uC801\uC774 \uC788\uC5B4\uC694. \uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9\uC5D0\uC11C \uC77C\uD558\uB358 \uC5F0\uAD6C\uC6D0\uC774\uB77C\uACE0 \uD588\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213549
    m_Localized: "DJ: \uD734\uBA74\uD558\uB294 \uAC10\uC5FC, \uB2E4\uC2DC \uAE68\uC5B4\uB098\uB294 \uAC10\uC5FC\uC5D0 \uB300\uD574 \uACC4\uC18D \uAE30\uB85D\uD558\uACE0 \uC788\uB2E4\uACE0. \uD639\uC2DC \uC790\uAE30\uAC00 \uC5F0\uB77D\uC774 \uB04A\uAE30\uBA74, \uAE30\uB85D\uC740 \uC5F0\uAD6C\uB3D9 \uC9C0\uD558\uC5D0 \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213550
    m_Localized: "DJ: \uADF8 \uB4A4\uB85C \uB2E4\uC2DC\uB294 \uC5F0\uB77D\uC774 \uC5C6\uC5C8\uC5B4\uC694. \uC65C \uC774 \uC598\uAE38 \uD558\uB0D0\uBA74\u2026 \uC694\uC998 \uB204\uAC00 \uACC4\uC18D \uC815\uC218\uC7A5 \uCABD\uC744 \uBB3B\uAE38\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213551
    m_Localized: "\uC1A1\uC2E0 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB354 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213552
    m_Localized: "DJ: \uC5F0\uAD6C\uB3D9\uC740 \uBC24\uC5D0\uB9CC \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC744 \uAC70\uC608\uC694. \uB0AE\uC5D0\uB294 \uAC70\uAE30 \uC7A0\uB4E0 \uBB34\uB9AC\uAC00 \uB108\uBB34 \uB9CE\uB300\uC694. \uC870\uC2EC\uD574\uC694, \uD559\uC0DD."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213244
    m_Localized: "\uC774\uCABD\uC744 \uBE64\uD788 \uBCF4\uB354\uB2C8 \uC57C\uC639, \uD558\uACE0 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407336
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC218\uC5C5 \uC5C6\uC5B4. \uC18C\uD48D\uC774\uC57C. \uB098\uB294 \uCC3D\uAC00\uC5D0\uC11C \uBCFC\uAC8C. \uB2E4\uB140\uC640\uC11C \uB2E4 \uC598\uAE30\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212775
    m_Localized: "\uACC1\uC5D0\uC11C \uBC24\uC744 \uAC19\uC774 \uC0CC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407505
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uAC00\uB974\uCE60 \uC218 \uC788\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\u2026 \uAC19\uC774 \uC77D\uB294 \uAC74 \uD560 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213553
    m_Localized: "\uB178\uD2B8\uC5D0 \uBC1B\uC544 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213554
    m_Localized: "\uC815\uC218\uC7A5. \uC5F0\uAD6C\uB3D9. \uC9C0\uD558. \uAE30\uB85D. \uB2E8\uC5B4 \uB124 \uAC1C\uB97C \uB178\uD2B8\uC5D0 \uC801\uACE0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213555
    m_Localized: "DJ: \uC624\uB298\uC758 \uC2E0\uCCAD\uACE1\uC740\u2026 \uC2E0\uCCAD\uD55C \uC0AC\uB78C\uC774 \uC5C6\uB124\uC694. \uADF8\uB7FC \uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uB178\uB798\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407335
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC218\uC5C5 \uC5C6\uC5B4. \uC18C\uD48D\uC774\uC57C. \uBAA9\uBC1C \uC9DA\uACE0 \uB098\uB3C4 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407334
    m_Localized: "\uC6D0\uB798 \uC774\uB9D8\uB54C\uB294 \uD604\uC7A5\uCCB4\uD5D8\uD559\uC2B5 \uB0A0\uC774\uC5C8\uB2E4. \uAC00\uC815\uD1B5\uC2E0\uBB38\uC5D0\uB294 '\uB3C4\uC2DC\uB77D \uC9C0\uCC38'\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213556
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uB178\uB798\uAC00 \uAD50\uC2E4\uC744 \uCC44\uC6E0\uB2E4. \uB2E4\uB4E4 \uB9D0\uC5C6\uC774 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213557
    m_Localized: "DJ: \uB0B4\uC77C\uB3C4 \uC0B4\uC544 \uC788\uC5B4\uC694. \uADF8\uAC8C \uC624\uB298\uC758 \uC219\uC81C\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213558
    m_Localized: "DJ: \uC624\uB298\uC740 \uB0A0\uC528 \uC598\uAE30\uB97C \uD574 \uBCFC\uAE4C\uC694. \uCC3D\uBC16\uC744 \uBCF4\uC138\uC694. \u2026\uBCF4\uC168\uC8E0? \uADF8\uAC8C \uC624\uB298\uC758 \uB0A0\uC528\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213559
    m_Localized: "\uC6C3\uC74C \uBE44\uC2B7\uD55C \uC18C\uB9AC\uAC00 \uAD50\uC2E4\uC5D0 \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213560
    m_Localized: "DJ: \uB0B4\uC77C \uB610 \uB9CC\uB098\uC694. \uAF2D\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407333
    m_Localized: "???: \u2026\uC54C\uC558\uC5B4. \uADF8\uB798\uB3C4 \uB9D0 \uAC78\uC5B4 \uC918\uC11C \uACE0\uB9C8\uC6E0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213245
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uC870\uAE08 \uB35C\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213246
    m_Localized: "\uACE0\uC591\uC774\uB294 \uD5C8\uAC81\uC9C0\uAC81 \uBA39\uACE0 \uB098\uC11C \uB0B4 \uBC1C\uBAA9\uC5D0 \uBAB8\uC744 \uBE44\uBCD0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213561
    m_Localized: "DJ: \uC0AC\uC5F0\uC774 \uD558\uB098 \uB4E4\uC5B4\uC654\uC5B4\uC694. \"\uB3D9\uC0DD\uC774 \uBB34\uC0AC\uD558\uAE38.\" \u2026\uBB34\uC0AC\uD560 \uAC70\uC608\uC694. \uC6B0\uB9AC \uBAA8\uB450."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810819
    m_Localized: "\uC11C\uB78D\uC5D0 \uB2E4\uC2DC \uB123\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407506
    m_Localized: "\uCEF4\uD4E8\uD130\uC2E4 \uBAA8\uB2C8\uD130\uB294 \uC804\uBD80 \uAE4C\uB9E3\uAC8C \uAEBC\uC838 \uC788\uC5C8\uB2E4. \uD654\uBA74 \uD558\uB098\uC5D0 \uB178\uB780 \uCABD\uC9C0\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213562
    m_Localized: "\uB178\uB798 \uB300\uC2E0 \uD55C\uCC38 \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC\uB9CC \uB0AC\uB2E4. \uADF8\uB798\uB3C4 \uC544\uBB34\uB3C4 \uB77C\uB514\uC624\uB97C \uB044\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213563
    m_Localized: "\uCCAB \uD55C\uD30C\uAC00 \uBAB0\uB824\uC628 \uBC24. \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC218\uC2ED \uAC1C\uC758 \uBC1C\uC18C\uB9AC\uAC00 \uD559\uAD50\uB97C \uB458\uB7EC\uC30C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213247
    m_Localized: "\uADF8 \uB4A4\uB85C \uC0AC\uD758\uC5D0 \uD55C \uBC88\uC529 \uCC3E\uC544\uC654\uB2E4. \uC774\uB984\uC740 '\uAE09\uC2DD'\uC774 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213248
    m_Localized: "\uCAD3\uC544 \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213249
    m_Localized: "\uACE0\uC591\uC774\uB294 \uC11C\uC6B4\uD558\uB2E4\uB294 \uB4EF \uB3CC\uC544\uBCF4\uACE0 \uB2F4\uC7A5 \uB108\uBA38\uB85C \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213250
    m_Localized: "\uAD50\uBB38 \uC606 \uB2F4\uC7A5\uC5D0 \uB0AF\uC120 \uD45C\uC2DC\uAC00 \uC0DD\uACBC\uB2E4. \uD398\uC778\uD2B8\uB85C \uADF8\uB9B0 \uB3D9\uADF8\uB77C\uBBF8\uC640 \uD654\uC0B4\uD45C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213564
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC624\uB298\uC740 \uB098\uB3C4 \uBB38 \uC55E\uC5D0 \uC11C\uACA0\uB2E4. \uB9D0\uB9AC\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213565
    m_Localized: "\uAE30\uCE68\uC744 \uCC38\uC73C\uBA70 \uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407507
    m_Localized: "'\uC218\uD589\uD3C9\uAC00 \uC81C\uCD9C \uAE08\uC694\uC77C\uAE4C\uC9C0!!' \uB290\uB08C\uD45C\uAC00 \uB450 \uAC1C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407508
    m_Localized: "\uADF8 \uAE08\uC694\uC77C\uC740 \uC624\uC9C0 \uC54A\uC558\uB2E4. \uCABD\uC9C0\uB97C \uB5BC\uC5B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uACE0, \uBCF8\uCCB4\uB97C \uC5F4\uC5B4 \uC4F8 \uB9CC\uD55C \uBD80\uD488\uC744 \uBE90\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213566
    m_Localized: "\uC2B5\uACA9\uC774 \uC9C0\uB098\uAC04 \uC0C8\uBCBD. \uB2E4\uB4E4 \uAD50\uC2E4 \uBC14\uB2E5\uC5D0 \uC4F0\uB7EC\uC9C0\uB4EF \uB204\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212646
    m_Localized: "\uCC3D\uAC00\uC5D0\uC11C \uC6B4\uB3D9\uC7A5\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212645
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uB098\uAC04\uB2E4. \uB6F0\uC9C0\uB294 \uBABB\uD574\uB3C4. \uAE30\uB85D\uC740 \uB124\uAC00 \uC7AC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213251
    m_Localized: "\uB204\uAD70\uAC00 \uC774 \uD559\uAD50\uB97C \uC0B4\uD3B4\uBCF4\uACE0 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213567
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uB85C 3\uB9C9 \uD3C9\uAC00\uB97C \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213568
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uBC88 \uACC4\uC808\uC740 \uAE38\uC5C8\uB2E4. \uADF8\uB807\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213569
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uCC3D\uBC16\uC740 \uBC8C\uC368 \uACA8\uC6B8\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213570
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uB0AF\uC120 \uC0AC\uB78C\uC774 \uC11C \uC788\uC5C8\uB2E4. \uB0A1\uC740 \uB4F1\uC0B0\uBCF5, \uBAA8\uC790\uB97C \uAE4A\uC774 \uB20C\uB7EC\uC4F4 \uC5BC\uAD74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213571
    m_Localized: "\uC720\uB791\uC790: \uD574\uCE60 \uC0DD\uAC01 \uC5C6\uB2E4. \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB294 \uAE38\uC774\uC57C. \u2026\uBA39\uC744 \uAC70 \uC870\uAE08\uB9CC \uB098\uB220 \uC904 \uC218 \uC788\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213252
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uCCA0\uC870\uB9DD \uD55C \uACF3\uC774 \uC798\uB824 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uB4E4\uC5B4\uC654\uB2E4\uAC00, \uC544\uBB34\uAC83\uB3C4 \uAC00\uC838\uAC00\uC9C0 \uC54A\uACE0 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213253
    m_Localized: "\uB2F4\uC7A5 \uB108\uBA38\uB85C \uB0AE\uC740 \uBAA9\uC18C\uB9AC \uBA87 \uAC1C\uAC00 \uC9C0\uB098\uAC14\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uB3C4 \uC11E\uC5EC \uC788\uC5C8\uB2E4. \uD55C\uCC38 \uB4A4\uC5D0\uC57C \uC228\uC744 \uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213572
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uBB38 \uB108\uBA38\uC5D0\uC11C \uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4\uAC00, \uB2E4\uC2DC \uBA48\uCDC4\uB2E4. \uB124\uAC00 \uC815\uD558\uB77C\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213573
    m_Localized: "\uD1B5\uC870\uB9BC \uBA87 \uAC1C\uB97C \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407509
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC804\uC120\uC774\uB791 \uBD80\uD488\uC774\uBA74 \uACE0\uCE60 \uC218 \uC788\uB294 \uAC8C \uB9CE\uC544. \uACF5\uD559 \uACF5\uBD80\uD560 \uB54C \uC4F0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212774
    m_Localized: "\uC57D\uC744 \uC0BC\uD0A4\uACE0 \uD55C\uCC38 \uB4A4, \uC120\uC0DD\uB2D8\uC758 \uC228\uC18C\uB9AC\uAC00 \uACE0\uB974\uAC8C \uBC14\uB00C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213574
    m_Localized: "\uC720\uB791\uC790: \uACE0\uB9D9\uB2E4. \uC774 \uC740\uD61C\uB294\u2026 \uAE30\uC5B5\uD574 \uB450\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213254
    m_Localized: "\uB2F4\uC7A5\uACFC \uBB38\uC744 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212644
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC2ED\uC774 \uCD08. \uD559\uAD50 \uC2E0\uAE30\uB85D\uC774\uB2E4. \uCC38\uAC00\uC790\uAC00 \uD55C \uBA85\uC774\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212643
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBCBD\uC5D0 \uAE30\uB300\uC549\uC740 \uCC44 \uC190\uBAA9\uC2DC\uACC4\uB97C \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213255
    m_Localized: "\uC790\uC7AC\uB97C \uC544\uB07C\uC9C0 \uC54A\uC558\uB2E4. \uD45C\uC2DC \uC704\uC5D0\uB294 '\uBE48 \uD559\uAD50'\uB77C\uACE0 \uB367\uCE60\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213256
    m_Localized: "\uBD88\uBE5B\uC744 \uC904\uC774\uACE0 \uC228\uC8FD\uC5EC \uC9C0\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407281
    m_Localized: "\uD45C\uC9C0\uC5D0 \uCC0D\uD78C \uB0A0\uC9DC\uB294 3\uC6D4 26\uC77C. \uC624\uB298\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407280
    m_Localized: "\uCC3D\uACE0 \uC120\uBC18\uC5D0\uC11C \uBE44\uB2D0\uB3C4 \uC548 \uB72F\uC740 \uC2DC\uD5D8\uC9C0 \uBB36\uC74C\uC774 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407279
    m_Localized: "\uB0AF\uC120 \uBAA9\uC18C\uB9AC\uB4E4\uC774 \uCC28\uB840\uB85C \uC778\uC0AC\uB97C \uD588\uB2E4. \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213575
    m_Localized: "\uADF8\uB294 \uBAA8\uC790\uB97C \uC0B4\uC9DD \uB4E4\uC5B4 \uBCF4\uC774\uACE0 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213576
    m_Localized: "\uBBF8\uC548\uD558\uB2E4\uACE0, \uC904 \uC218 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213577
    m_Localized: "\uC720\uB791\uC790: \uADF8\uB798. \uC774\uD574\uD55C\uB2E4. \uB2E4\uB4E4 \uADF8\uB807\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213578
    m_Localized: "\uADF8\uB294 \uD55C\uCC38 \uD559\uAD50 \uAC74\uBB3C\uC744 \uC62C\uB824\uB2E4\uBCF4\uB2E4\uAC00 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212773
    m_Localized: "\uC9C4\uD1B5\uC81C\uB97C \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212772
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBBF8\uC548, \uAE68\uC6E0\uC9C0. \u2026\uC870\uAE08\uB9CC \uC788\uC73C\uBA74 \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213579
    m_Localized: "\uD558\uB8FB\uBC24 \uCCB4\uC721\uAD00\uC5D0\uC11C \uC7AC\uC6CC \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213580
    m_Localized: "\uBC24\uC0C8 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4. \uC544\uCE68\uC5D0 \uADF8\uAC00 \uC549\uC558\uB358 \uB9E4\uD2B8 \uC704\uC5D0 \uC811\uD78C \uC9C0\uB3C4 \uD55C \uC7A5\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213581
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098 \uBCF4\uB2C8 \uAE09\uC2DD\uC2E4 \uCC3D\uACE0 \uC790\uBB3C\uC1E0\uAC00 \uBD80\uC11C\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213582
    m_Localized: "\uC2DD\uB7C9\uACFC \uBB3C\uC774 \uB208\uC5D0 \uB744\uAC8C \uC904\uC5B4 \uC788\uC5C8\uB2E4. \uBC14\uB2E5\uC5D0 \uC9C4\uD759 \uBB3B\uC740 \uB4F1\uC0B0\uD654 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213583
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uC0AC\uB78C\uC774\uAD6C\uB098. \uC6D0\uB9DD\uD558\uC9C0 \uB9C8\uB77C. \uC6B0\uB9AC\uB3C4 \uADF8\uB7F4 \uC218 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213584
    m_Localized: "\uC790\uBB3C\uC1E0\uB97C \uB2E4\uC2DC \uB2E8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212642
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC5D0 \uAE30\uB304 \uCC44 \uC190\uBAA9\uC2DC\uACC4\uB97C \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212641
    m_Localized: "\uC228\uC774 \uCC28\uC11C \uC6C3\uC74C\uC774 \uB0AC\uB2E4. \uC18C\uB9AC\uB97C \uC8FD\uC774\uB290\uB77C \uB354 \uC6C3\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213585
    m_Localized: "\uB354 \uB2E8\uB2E8\uD55C \uC790\uBB3C\uC1E0\uB97C \uB2EC\uC558\uB2E4. \uB9C8\uC74C \uD55C\uCABD\uB3C4 \uAC19\uC774 \uC7A0\uADF8\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213586
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uADF8 \uC720\uB791\uC790\uAC00 \uB2E4\uC2DC \uB098\uD0C0\uB0AC\uB2E4. \uC774\uBC88\uC5D0\uB294 \uBB34\uC5B8\uAC00\uB97C \uB4E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213587
    m_Localized: "\uC720\uB791\uC790: \uBE5A \uAC1A\uC73C\uB7EC \uC654\uB2E4. \uC57D\uD488 \uC0C1\uC790 \uD558\uB098, \uADF8\uB9AC\uACE0 \uC774\uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213588
    m_Localized: "\uADF8\uAC00 \uAC74\uB128 \uAC83\uC740 \uC190\uC73C\uB85C \uADF8\uB9B0 \uC9C0\uB3C4\uC600\uB2E4. \uC815\uC218\uC7A5 \uB458\uB808\uC5D0 \uBE68\uAC04 \uC5D1\uC2A4 \uD45C\uC2DC\uAC00 \uC5EC\uB7EC \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213589
    m_Localized: "\uC720\uB791\uC790: \uC800\uAE30 \uADFC\uCC98 \uAC00\uC9C0 \uB9C8\uB77C. \uC544\uB2C8\uBA74\u2026 \uAC00\uC57C \uD55C\uB2E4\uBA74 \uBC24\uC5D0 \uAC00\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213257
    m_Localized: "\uBA70\uCE60 \uB3D9\uC548 \uBC24\uC5D0 \uBD88\uC744 \uCF1C\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB4E4 \uB9D0\uC218\uAC00 \uC904\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213296
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD, \uB098\uC57C. \uC9E7\uAC8C \uB9D0\uD560\uAC8C. \uC6B0\uB9AC \uC548\uC5D0 \uBB38\uC81C\uAC00 \uC880 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407326
    m_Localized: "\uCC3D\uACE0 \uBB38 \uC55E\uC5D0\uC11C, \uC724 \uC120\uC0DD\uB2D8\uC774 \uB0AF\uC120 \uC5BC\uAD74\uC744 \uD55C\uCC38 \uBC14\uB77C\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213295
    m_Localized: "\uBC24\uB2A6\uAC8C \uBB34\uC804\uAE30\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC8FC\uBCC0\uC744 \uC0B4\uD53C\uB294 \uB4EF \uBAA9\uC18C\uB9AC\uB97C \uB0AE\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213641
    m_Localized: "{0}: \uC544\uC9C1 \uC815\uD655\uD788\uB294 \uBAA8\uB974\uACA0\uB294\uB370\uC694. \uB204\uAD70\uAC00\uB97C \uB3D5\uB294 \uC77C\uC774\uBA74 \uC88B\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213640
    m_Localized: "\uD558\uACE0 \uC2F6\uC740 \uAC8C \uC0DD\uACBC\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213639
    m_Localized: "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC9C8\uBB38\uC774\uC5C8\uB2E4. \uADF8\uB2E4\uC74C, \uC774\uB77C\uB294 \uB9D0\uC744 \uC624\uB79C\uB9CC\uC5D0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213638
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6C\uC870\uB300\uAC00 \uC624\uBA74, \uADF8\uB2E4\uC74C\uC5D4 \uBB50 \uD558\uACE0 \uC2F6\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213637
    m_Localized: "\uAD6D\uC5B4 \uC601\uC5ED 1\uBC88\uBD80\uD130. \uBC18\uB3C4 \uBABB \uD480\uC5C8\uC9C0\uB9CC, \uB05D\uAE4C\uC9C0 \uC549\uC544 \uC788\uC5C8\uB2E4. 100\uBD84 \uB3D9\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212619
    m_Localized: "\uC791\uB144 \uC774\uB0A0 \uAD50\uC2E4 \uCE60\uD310\uC740 \uB099\uC11C\uC640 \uD48D\uC120\uC73C\uB85C \uAC00\uB4DD\uD588\uB2E4. \uC62C\uD574 \uCE60\uD310\uC5D0\uB294 \uBB3C \uBC1B\uB294 \uC21C\uC11C\uAC00 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212620
    m_Localized: "\uC885\uC774\uB85C \uCE74\uB124\uC774\uC158\uC744 \uC811\uC5B4 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213294
    m_Localized: "\uADF8\uB0A0 \uBC24 \uBC29\uC1A1\uC740 \uB178\uB798 \uC5C6\uC774 \uB05D\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213293
    m_Localized: "DJ: \uC54C\uC544\uC694. \uB9DE\uB294 \uB9D0\uC774\uC5D0\uC694. \u2026\uADF8\uB798\uB3C4 \uB4E3\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uB9D0\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213292
    m_Localized: "{0}: \uBBF8\uC548\uD574\uC694. \uC5EC\uAE30 \uC0AC\uB78C\uB4E4\uC744 \uB450\uACE0 \uB098\uAC08 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212621
    m_Localized: "\uBE68\uAC04 \uC0C9\uC885\uC774\uAC00 \uC5C6\uC5B4\uC11C \uD3EC\uC7A5\uC9C0\uB85C \uC811\uC5C8\uB2E4. \uC811\uB294 \uBC95\uC774 \uAC00\uBB3C\uAC00\uBB3C\uD574\uC11C \uC138 \uBC88 \uB9CC\uC5D0 \uAF43 \uBAA8\uC591\uC774 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213636
    m_Localized: "\uB0A8\uC544 \uC788\uB358 \uC2DC\uD5D8\uC9C0\uB97C \uD480\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213635
    m_Localized: "\uB204\uAD70\uAC00 \uB3CC\uC544\uC624\uBA74 \uCC3E\uAE30 \uC27D\uAC8C. \uADF8\uB7F0 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213634
    m_Localized: "\uC218\uD5D8\uD45C\uB97C \uD558\uB098\uD558\uB098 \uAC00\uC9C0\uB7F0\uD788 \uB193\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213633
    m_Localized: "\uC8FC\uC778 \uC5C6\uB294 \uC0AC\uC9C4 \uC218\uC2ED \uC7A5\uC774 \uC774\uCABD\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213632
    m_Localized: "3\uD559\uB144 \uAD50\uC2E4\uC5D0 \uB4E4\uC5B4\uAC00 \uBD24\uB2E4. \uCC45\uC0C1\uB9C8\uB2E4 \uC218\uD5D8\uD45C\uAC00 \uB4E0 \uD22C\uBA85 \uD30C\uC77C\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uBBF8\uB9AC \uB098\uB220 \uC900 \uAC83\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213631
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uC218\uB2A5\uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213630
    m_Localized: "'1\uD559\uB144 3\uBC18 \uB5A1\uBCF6\uC774 \u2014 \uB9DB\uC5C6\uC73C\uBA74 \uD658\uBD88'. \uB2E4 \uADF8\uB9AC\uACE0 \uB098\uC11C {0} \uC0DD\uAC01\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407457
    m_Localized: "\uCC98\uC74C\uC73C\uB85C '\uC694\uB9AC'\uB77C\uACE0 \uBD80\uB97C \uB9CC\uD55C \uAC83\uC774 \uADF8\uB987\uC5D0 \uB2F4\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407458
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC21F\uAC00\uB77D\uC73C\uB85C \uD55C \uC785 \uB5A0\uC11C, \uC624\uB798 \uC785\uC5D0 \uBB3C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213629
    m_Localized: "\uADF8\uB54C \uADF8\uB9AC\uB824\uB358 \uD3EC\uC2A4\uD130\uB97C \uADF8\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213628
    m_Localized: "\uBC15\uC218 \uC18C\uB9AC\uAC00 \uD145 \uBE48 \uAC15\uB2F9\uC5D0 \uD06C\uAC8C \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212917
    m_Localized: "\uBCF5\uB3C4 \uB05D \uCC3D\uD2C0\uB85C \uBB3C\uC774 \uC2A4\uBA84\uB2E4. \uAD50\uC2E4 \uBCBD\uC5D0 \uACF0\uD321\uC774 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212916
    m_Localized: "\uC544\uCE68\uBD80\uD130 \uBE44\uAC00 \uADF8\uCE58\uC9C0 \uC54A\uC558\uB2E4. \uC77C\uAE30\uC608\uBCF4\uAC00 \uC788\uC5C8\uB2E4\uBA74 \uC7A5\uB9C8 \uC2DC\uC791\uC774\uB77C\uACE0 \uD588\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213627
    m_Localized: "\uB3C4\uD604\uC740 \uB9AC\uCF54\uB354\uB97C \uBD88\uC5C8\uACE0, \uBC15 \uC120\uC0DD\uB2D8\uC740 \uB178\uB798\uB97C \uD588\uB2E4. \uB098\uB294 \uC2DC\uB97C \uC77D\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uBC30\uC6B4 \uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213626
    m_Localized: "\uAC15\uB2F9\uC5D0\uC11C \uC791\uC740 \uBC1C\uD45C\uD68C\uB97C \uC5F0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212622
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78 \uBAA9\uBC1C \uC190\uC7A1\uC774\uC5D0 \uAF42\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213291
    m_Localized: "\uC704\uD5D8\uD574\uC11C \uAC08 \uC218 \uC5C6\uB2E4\uACE0 \uC194\uC9C1\uD558\uAC8C \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212623
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78 \uC154\uCE20 \uC8FC\uBA38\uB2C8\uC5D0 \uAF42\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213625
    m_Localized: "1\uD559\uB144 3\uBC18, \uB5A1\uBCF6\uC774 \uAC00\uAC8C. \uB0B4 \uC774\uB984\uB3C4 \uAC70\uAE30 \uC788\uC5C8\uB2E4. \uB2F4\uB2F9\uC740 \uD3EC\uC2A4\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213624
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uD559\uAD50 \uCD95\uC81C \uB0A0\uC774\uC5C8\uB2E4. \uAD50\uBB34\uC2E4 \uAC8C\uC2DC\uD310\uC5D0 \uBC18\uBCC4 \uBD80\uC2A4 \uACC4\uD68D\uD45C\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213623
    m_Localized: "\uB2EC\uC774 \uCEF8\uB2E4. \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4. \uBB34\uC5C7\uC744 \uBE4C\uC5C8\uB294\uC9C0\uB294 \uC77C\uAE30\uC5D0\uB3C4 \uC801\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213622
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uBCF4\uB984\uB2EC\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213621
    m_Localized: "\uB3C4\uD604\uC774 \"\uC81C\uAC00 \uC81C\uC77C \uD070 \uC870\uAC01\" \uD558\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213620
    m_Localized: "\uAE09\uC2DD\uC2E4\uC5D0 \uC0C1\uC744 \uD3B4\uACE0 \uB2E4 \uAC19\uC774 \uB458\uB7EC\uC549\uC558\uB2E4. \uD1B5\uC870\uB9BC \uAF41\uCE58, \uC300\uBC25, \uADF8\uB9AC\uACE0 \uC0AC\uACFC \uD558\uB098\uB97C \uC5EC\uC12F \uC870\uAC01\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407270
    m_Localized: "\uD14C\uC774\uD504\uC640 \uC790\uC7AC\uB85C \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407271
    m_Localized: "\uC190\uC774 \uACF1\uC544 \uBA87 \uBC88\uC774\uB098 \uD14C\uC774\uD504\uB97C \uB193\uCCE4\uB2E4. \uADF8\uB798\uB3C4 \uB9C9\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407272
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uC5BC\uC74C\uC744 \uB179\uC5EC \uBB3C\uC744 \uC5BB\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212624
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uC0AC \uC0DD\uD65C \uC2ED \uB144 \uB9CC\uC5D0 \uCC98\uC74C \uBC1B\uC544 \uBCF8\uB2E4. \uC9C4\uC9DC \uCE74\uB124\uC774\uC158."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213290
    m_Localized: "\uC0C8\uBCBD \uBB34\uB835, DJ\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uB2E4. \uBBFC\uADDC\uAC00 \uC9C0\uB3C4 \uAE38\uC744 \uB530\uB77C \uAE30\uC5B4\uC11C \uB3CC\uC544\uC654\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213289
    m_Localized: "\uC6B0\uB9AC\uAC00 \uB2E4\uB140 \uBCF8 \uAE38\uC744 \uB5A0\uC62C\uB9AC\uBA70 \uBC30\uC218\uB85C, \uB9C9\uD78C \uACE8\uBAA9, \uC228\uC744 \uACF3\uC744 \uD558\uB098\uC529 \uBD88\uB7EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213288
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uADF8\uB9B0 \uC9C0\uB3C4\uB97C \uD3BC\uCCE4\uB2E4. \uBC30\uC218\uB85C, \uB9C9\uD78C \uACE8\uBAA9, \uC228\uC744 \uACF3\uC744 \uD558\uB098\uC529 \uBD88\uB7EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212625
    m_Localized: "{0}: \uC885\uC774\uC778\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212626
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uB4E4\uC9C0 \uC54A\uC796\uC544. \uADF8\uB7EC\uB2C8\uAE4C \uC9C4\uC9DC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407327
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBA87 \uD559\uB144\uC774\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810816
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC774\uB984\uC744 \uD558\uB098\uC529 \uBD88\uB800\uB2E4. \uB300\uB2F5\uC740 \uB0B4\uAC00 \uD588\uB2E4. \"\uB124.\" \uC11C\uB978\uB450 \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212915
    m_Localized: "\uC7A0\uC2DC \uC870\uC6A9\uD574\uC84C\uB2E4. \uADF8\uB0A0 \uC800\uB141, \uC120\uC0DD\uB2D8\uC774 \uC790\uAE30 \uBAAB\uC758 \uBC18\uC744 \uB0B4 \uADF8\uB987\uC5D0 \uC2AC\uCA4D \uB35C\uC5B4 \uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407273
    m_Localized: "\uB09C\uB85C \uC704\uC5D0\uC11C \uC5BC\uC74C\uC774 \uCC9C\uCC9C\uD788 \uB179\uC558\uB2E4. \uAE40\uC774 \uD53C\uC5B4\uC624\uB974\uB294 \uAC78 \uB2E4\uB4E4 \uC190\uC744 \uCB10\uBA70 \uC9C0\uCF1C\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407274
    m_Localized: "DJ: \uC0C8\uD574 \uC778\uC0AC \uBC1B\uC2B5\uB2C8\uB2E4. \uAD6C\uC870 \uAE30\uB2E4\uB9AC\uB294 \uBD84\uB4E4, \uC11C\uB85C\uC5D0\uAC8C \uD55C\uB9C8\uB514\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407275
    m_Localized: "\uBB34\uC804\uC73C\uB85C \uC778\uC0AC\uB97C \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407328
    m_Localized: "???: 2\uD559\uB144\uC774\uC694. \uC815\uCC30\uC740\u2026 \uC880 \uD560 \uC904 \uC54C\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407329
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: {0}, \uB124\uAC00 \uB370\uB824\uC654\uC73C\uB2C8 \uB124\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212627
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD558\uB8E8 \uC885\uC77C \uAF43\uC744 \uBE7C\uC9C0 \uC54A\uC558\uB2E4. \uC800\uB141\uC5D0 \uBB3C\uC744 \uB728\uB7EC \uAC08 \uB54C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212628
    m_Localized: "\uC9E7\uC740 \uD3B8\uC9C0\uB97C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213287
    m_Localized: "\uC9C0\uB3C4\uB97C \uD3BC\uCCD0 \uB193\uACE0 \uBB34\uC804\uC73C\uB85C \uAC15\uBCC0 \uAE38\uC744 \uC54C\uB824 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213286
    m_Localized: "DJ: \u2026\uAC00 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694. \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574\uC694. \uC815\uB9D0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213285
    m_Localized: "\uBBFC\uADDC\uB294 \uCC3E\uC9C0 \uBABB\uD588\uB2E4. \uBB34\uC804\uAE30\uC5D0 \uB300\uACE0 \uADF8 \uB9D0\uC744 \uD558\uB294 \uAC8C \uAC15\uBCC0\uBCF4\uB2E4 \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213284
    m_Localized: "\uAC15\uBCC0\uC740 \uB113\uACE0 \uC5B4\uB450\uC6E0\uB2E4. \uADF8\uAC83\uB4E4\uC758 \uC18C\uB9AC\uAC00 \uAC00\uAE4C\uC6CC\uC838 \uB3CC\uC544\uC11C\uC57C \uD588\uB2E4. \uB118\uC5B4\uC9C0\uBA70 \uD314\uC744 \uAE4A\uAC8C \uAE01\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212629
    m_Localized: "\uACF5\uCC45 \uD55C \uC7A5\uC744 \uCC22\uC5B4 \uBA87 \uC904\uC744 \uC37C\uB2E4. \uACE0\uB9D9\uB2E4\uB294 \uB9D0\uC744 \uC4F0\uB824\uACE0 \uD588\uB294\uB370 \uB2E4\uB978 \uB9D0\uC774 \uBA3C\uC800 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212630
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD3B8\uC9C0\uB97C \uB450 \uBC88 \uC77D\uACE0, \uC138 \uBC88\uC9F8\uB294 \uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uACE0 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213283
    m_Localized: "DJ: \uACE0\uB9C8\uC6CC\uC694. \uC774 \uBE5A\uC740\u2026 \uC774 \uBE5A\uC740 \uAF2D \uAC1A\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213282
    m_Localized: "\uBBFC\uADDC\uB97C \uBD80\uCD95\uD574 \uD559\uAD50\uB85C \uB370\uB824\uC654\uB2E4. \uBB34\uC804 \uB108\uBA38\uC5D0\uC11C DJ\uAC00 \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212631
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB2F5\uC7A5\uC740 \uBABB \uC4F0\uACA0\uB2E4. \uAE00 \uAC00\uB974\uCE58\uB294 \uC0AC\uB78C\uC774 \uC774\uB7EC\uBA74 \uC548 \uB418\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407276
    m_Localized: "{0}: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC608\uC694. \uB2E4\uB4E4 3\uC6D4\uC5D0 \uAF2D \uB9CC\uB098\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407277
    m_Localized: "DJ: \uC0C8\uBCBD\uACE0! \uAF2D \uB9CC\uB098\uC694. 3\uC6D4\uC5D0, \uC625\uC0C1\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407278
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC758 \uC778\uC0AC\uB97C \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213619
    m_Localized: "\uC544\uAEF4 \uB454 \uD1B5\uC870\uB9BC\uC73C\uB85C \uC0C1\uC744 \uCC28\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213618
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC1A1\uD3B8\uC740 \uBABB \uBE5A\uC5B4\uB3C4 \uC0C1\uC740 \uCC28\uB9B4 \uC218 \uC788\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213617
    m_Localized: "\uC624\uB298\uC740 \uCD94\uC11D\uC774\uC5C8\uB2E4. \uC6D0\uB798\uB77C\uBA74 \uD560\uBA38\uB2C8 \uB301\uC5D0\uC11C \uC1A1\uD3B8\uC744 \uBE5A\uC5C8\uC744 \uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212914
    m_Localized: "\uB0B4 \uBAAB\uC758 \uD1B5\uC870\uB9BC\uC744 \uC0C1\uC790 \uC704\uC5D0 \uC62C\uB824\uB193\uC558\uB2E4. \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212913
    m_Localized: "\uB0B4 \uBAAB\uC744 \uC904\uC5EC\uC11C \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213616
    m_Localized: "\uADF8\uAC78\uB85C \uCDA9\uBD84\uD588\uB2E4. \uC9C0\uAE08\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212912
    m_Localized: "\uD6A8\uC728\uC801\uC778 \uADDC\uCE59\uC774\uC5C8\uB2E4. \uADF8\uB0A0 \uBC24 \uB204\uAD70\uAC00 \uD63C\uC790 \uB2A6\uAC8C\uAE4C\uC9C0 \uC77C\uD558\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBC30\uAC00 \uACE0\uD30C\uC11C\uC600\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407511
    m_Localized: "\uC190\uAC00\uB77D \uD558\uB098\uB97C \uAC74\uBC18\uC5D0 \uC62C\uB838\uB2E4\uAC00, \uB204\uB974\uC9C0 \uC54A\uACE0 \uB0B4\uB838\uB2E4. \uC774 \uAC74\uBB3C\uC5D0\uC11C \uC18C\uB9AC\uB294 \uBD80\uB974\uB294 \uC2E0\uD638\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213615
    m_Localized: "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uACE0\uAC1C\uB9CC \uB044\uB355\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212632
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB300\uC2E0 \uC774\uAC74 \uC57D\uC18D\uD560\uAC8C. \uB0B4\uB144 \uC624\uB298\uB3C4 \uB098\uB294 \uB124 \uC120\uC0DD\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213281
    m_Localized: "\uBBFC\uADDC: \u2026UBC \uC0AC\uB78C\uC774\uC5D0\uC694? \uC544\uB2C8, \uD559\uAD50? \uD559\uAD50\uC5D0\uC11C \uC654\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213280
    m_Localized: "\uB451 \uC544\uB798 \uBC30\uC218\uB85C \uC548\uC5D0\uC11C \uC790\uC804\uAC70 \uBC14\uD034\uAC00 \uBCF4\uC600\uB2E4. \uADF8 \uC606\uC5D0 \uB2E4\uB9AC\uB97C \uB2E4\uCE5C \uB0A8\uC790\uC560\uAC00 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407330
    m_Localized: "\uBC1B\uC544\uB4E4\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407331
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uC624\uB298\uBD80\uD130 \uC2DD\uAD6C\uB2E4. \uB300\uC2E0 \uADDC\uCE59\uC740 \uC9C0\uCF1C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213614
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C \uB0B4 \uB208\uC744 \uB611\uBC14\uB85C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810817
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC774\uB984\uAE4C\uC9C0 \uBD80\uB974\uACE0 \uB098\uC11C, \uC120\uC0DD\uB2D8\uC740 \uCD9C\uC11D\uBD80\uB97C \uB36E\uACE0 \uCE60\uD310 \uC606\uC5D0 \uC138\uC6CC \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407510
    m_Localized: "\uC74C\uC545\uC2E4 \uD53C\uC544\uB178 \uB69C\uAED1 \uC704\uC5D0 \uBA3C\uC9C0\uAC00 \uC587\uAC8C \uC549\uC544 \uC788\uC5C8\uB2E4. \uB69C\uAED1\uC744 \uC5F4\uC790 \uD558\uC580 \uAC74\uBC18\uC774 \uC904\uC9C0\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213613
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC. \uB2A6\uC5B4\uB3C4 \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213612
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407332
    m_Localized: "\uC9C0\uAE08\uC740 \uC5B4\uB835\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213279
    m_Localized: "\uB0A0\uC774 \uBC1D\uAE30 \uC804\uC5D0 \uAC15\uBCC0 \uCABD\uC744 \uCC3E\uC544\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213278
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC5BC\uAD74\uC744 \uBCF4\uC558\uB2E4. \uC774\uBC88\uC5D0\uB294 \uB9D0\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB807\uB2E4\uACE0 \uAC00\uB77C\uACE0 \uD558\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213277
    m_Localized: "DJ: \uC6B0\uB9AC \uCABD\uC5D0\uC11C \uAC70\uAE30\uAE4C\uC9C0\uB294 \uB108\uBB34 \uBA40\uC5B4\uC694. \uD639\uC2DC\u2026 \uD639\uC2DC \uAC00\uAE4C\uC774 \uC788\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213276
    m_Localized: "DJ: \uC6B4\uBC18\uC870 \uBBFC\uADDC\uAC00 \uC5B4\uC81C \uAC15\uBCC0 \uCABD\uC73C\uB85C \uB098\uAC00\uC11C \uC548 \uB3CC\uC544\uC654\uC5B4\uC694. \uC5F4\uC544\uD649 \uC0B4\uC774\uC5D0\uC694. \uB9C8\uC9C0\uB9C9 \uBB34\uC804\uC774 \uD559\uAD50 \uADFC\uCC98\uC600\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213275
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uB5A8\uB838\uB2E4. \uBC29\uC1A1 \uB54C\uB294 \uD55C \uBC88\uB3C4 \uB5A8\uB9B0 \uC801 \uC5C6\uB294 \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213274
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4, \uBBF8\uC548\uD574\uC694. \uBD80\uD0C1\uD560 \uAC8C \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213273
    m_Localized: "DJ: \uADF8 \uBE75, \uC800\uB3C4 \uC54C\uC544\uC694. \uC18C\uBCF4\uB85C \uB9DE\uC8E0? \uD559\uAD50 \uB2E4\uB2D0 \uB54C \uC800\uB3C4 \uADF8\uAC70 \uBA39\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212633
    m_Localized: "\uD3B8\uC9C0\uB294 \uCD9C\uC11D\uBD80 \uB9E8 \uB4B7\uC7A5\uC5D0 \uB07C\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212634
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC774 \uB0B4\uB824\uB2E4\uBCF4\uC774\uB294 \uCC3D\uAC00. \uC6D0\uB798\uB77C\uBA74 \uC624\uB298\uC774 \uCCB4\uC721\uB300\uD68C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213272
    m_Localized: "\uD544\uC694\uD55C \uAC83 \uC774\uC57C\uAE30\uB294 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uC88B\uC544\uD558\uB294 \uB178\uB798, \uD559\uAD50 \uB9E4\uC810\uC758 \uBE75 \uC774\uC57C\uAE30\uB97C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213611
    m_Localized: "\uC1A1\uC608\uC9C0: \uB098, \uC774\uBC88\uC5D0\uB294 \uB124 \uD3B8\uC774\uC57C. \uB2A6\uC5C8\uC9C0\uB9CC. \uADF8\uAC70 \uB9D0\uD558\uACE0 \uC2F6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212767
    m_Localized: "\uD55C\uBC24\uC911, \uC120\uC0DD\uB2D8\uC774 \uC774\uB97C \uC545\uBB3C\uACE0 \uBB34\uB98E \uC544\uB798\uB97C \uC6C0\uCF1C\uC950\uACE0 \uC788\uC5C8\uB2E4. \uC5C6\uB294 \uACF3\uC774 \uC544\uD504\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212768
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544\u2026 \uAC00\uB054 \uC774\uB798. \uAE08\uBC29 \uC9C0\uB098\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213610
    m_Localized: "\uC1A1\uC608\uC9C0: \uD558\uB9B0\uC774 \uB9CC\uB0AC\uB2E4\uBA74\uC11C. \u2026\uAD1C\uCC2E\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213609
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uC870\uC6A9\uD788 \uB2E4\uAC00\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213271
    m_Localized: "\uADF8\uB0E5 \uC774\uC57C\uAE30\uB97C \uB098\uB208\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213270
    m_Localized: "DJ: \u2026\uADF8\uB0E5\uC774\uB77C\uB294 \uB9D0, \uC624\uB79C\uB9CC\uC5D0 \uB4E4\uC5B4 \uBCF4\uB124\uC694. \uACE0\uB9C8\uC6CC\uC694. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213269
    m_Localized: "{0}: \uBC29\uC1A1 \uC7A1\uC74C\uC774 \uC2EC\uD558\uB358\uB370\uC694. \uBD80\uD488 \uBA87 \uAC1C \uBCF4\uB0BC\uAC8C\uC694. \uADF8\uB0E5\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213268
    m_Localized: "\uC548\uD14C\uB098 \uBD80\uD488\uC744 \uBA3C\uC800 \uBCF4\uB0B4 \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213267
    m_Localized: "DJ: \uC88B\uC544\uC694. \uC6B4\uBC18\uC870\uD55C\uD14C \uD559\uAD50 \uC55E\uC744 \uCF54\uC2A4\uC5D0 \uB123\uC73C\uB77C\uACE0 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212635
    m_Localized: "\uD2B8\uB799\uC758 \uD770 \uC904\uC740 \uBC18\uCBE4 \uC9C0\uC6CC\uC84C\uACE0, \uBCF8\uBD80\uC11D \uCC9C\uB9C9\uC740 \uBF08\uB300\uB9CC \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213608
    m_Localized: "\uB3C4\uD604\uC740 \uD55C\uCC38 \uC6B8\uC5C8\uB2E4. \uB2E4 \uC6B8\uACE0 \uB098\uC11C \uACE0\uB9D9\uB2E4\uACE0 \uD588\uB2E4. \uC194\uC9C1\uD558\uAC8C \uB9D0\uD574 \uC918\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213607
    m_Localized: "\uBAA8\uB978\uB2E4\uACE0, \uADF8\uB798\uB3C4 \uAC19\uC774 \uAE30\uB2E4\uB9AC\uC790\uACE0 \uC194\uC9C1\uD558\uAC8C \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213606
    m_Localized: "\uB3C4\uD604\uC740 \uAC00\uC2B4 \uC8FC\uBA38\uB2C8\uC758 \uCABD\uC9C0\uB97C \uD55C \uBC88 \uB9CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213605
    m_Localized: "\uB3C4\uD604: \u2026\uB124. \uADF8\uB807\uC8E0. \uC5C4\uB9C8\uB294 \uC6D0\uB798 \uAE38 \uC798 \uCC3E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213604
    m_Localized: "\uBD84\uBA85 \uC0B4\uC544 \uC788\uC744 \uAC70\uB77C\uACE0 \uB9D0\uD574 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212636
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC791\uB144\uC5D4 \uB0B4\uAC00 \uB9E1\uC740 \uBC18\uC774 \uACC4\uC8FC \uAF34\uCC0C\uC600\uC5B4. \uBC14\uD1B5\uC744 \uB450 \uBC88 \uB5A8\uC5B4\uB728\uB838\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213266
    m_Localized: "{0}: \uC57D\uC774 \uC81C\uC77C \uD544\uC694\uD574\uC694. \uB300\uC2E0 \uC6B0\uB9AC\uB294 \uBD80\uD488\uC774\uB791 \uC5F0\uB8CC\uB97C \uC870\uAE08 \uAD6C\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212637
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC18 \uACC4\uC8FC \uB300\uC2E0, \uBCF5\uB3C4 \uB05D\uAE4C\uC9C0 \uC655\uBCF5 \uC5B4\uB54C. \uC18C\uB9AC\uB294 \uB0B4\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212638
    m_Localized: "\uBCF5\uB3C4\uB97C \uB2EC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213265
    m_Localized: "\uBB3C\uC790\uB97C \uC8FC\uACE0\uBC1B\uB294 \uC774\uC57C\uAE30\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213264
    m_Localized: "DJ: \uC774\uB984 \uBD88\uB7EC \uC918\uC694. \uBA85\uB2E8 \uC788\uC5B4\uC694. \uCC3E\uC544\uBCFC\uAC8C\uC694. \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213263
    m_Localized: "\uB3C4\uD604: \u2026\uCCB4\uC721\uACF5\uC6D0\uC5D0\uC11C \uC628 \uC0AC\uB78C\uB4E4 \uC911\uC5D0, \uD639\uC2DC\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212769
    m_Localized: "\uC800\uB141\uC744 \uBA39\uB2E4 \uC120\uC0DD\uB2D8\uC758 \uC21F\uAC00\uB77D\uC774 \uBA48\uCDC4\uB2E4. \uC190\uB4F1\uC5D0 \uD54F\uC904\uC774 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212770
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBE44 \uC624\uB824\uB098 \uBD10. \uC5C6\uB294 \uB2E4\uB9AC\uAC00 \uBA3C\uC800 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213603
    m_Localized: "\uB3C4\uD604: \uC774\uB3D9\uD588\uB2E4\uB294 \uAC70\uC8E0? \uB2E4 \uC8FD\uC740 \uAC8C \uC544\uB2C8\uB77C. \uC774\uB3D9\uD55C \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213602
    m_Localized: "\uB3C4\uD604\uC774 \uBB34\uC804\uAE30 \uC55E\uC5D0\uC11C \uAD73\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213601
    m_Localized: "DJ: \u2026\uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C \uC18C\uC2DD\uC774\uC5D0\uC694. \uC9C0\uB09C\uB2EC\uC5D0 \uBB34\uB9AC\uC5D0\uAC8C \uB6AB\uB838\uACE0, \uC0DD\uC874\uC790\uB4E4\uC740 \uB0A8\uCABD\uC73C\uB85C \uC774\uB3D9\uD588\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213600
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC544\uD504\uBA74 \uC544\uD504\uB2E4\uACE0 \uD558\uB77C\uACE0 \uD588\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213599
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBC24\uC0C8 \uBB3C\uC218\uAC74\uC744 \uAC08\uC544 \uC8FC\uC5C8\uB2E4. \uC794\uC18C\uB9AC\uB3C4 \uAC19\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213598
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uAED8 \uAC04\uD638\uB97C \uBD80\uD0C1\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213597
    m_Localized: "\uB530\uB85C \uC9C0\uB0B4\uB294 \uBA70\uCE60\uC774 \uAE38\uC5C8\uB2E4. \uBB38 \uB108\uBA38\uB85C \uC11C\uB85C\uC758 \uAE30\uCE68 \uC18C\uB9AC\uB9CC \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213596
    m_Localized: "\uC544\uD508 \uC0AC\uB78C\uB07C\uB9AC \uAD50\uC2E4 \uD558\uB098\uC5D0 \uACA9\uB9AC\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213595
    m_Localized: "\uC57D\uC774 \uC904\uC5B4\uB4DC\uB294 \uAC8C \uBCF4\uC600\uB2E4. \uADF8\uB798\uB3C4 \uC0AC\uD758 \uB9CC\uC5D0 \uC5F4\uC774 \uB0B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213594
    m_Localized: "\uC544\uAEF4 \uB454 \uC57D\uC744 \uB098\uB220 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213593
    m_Localized: "\uC628\uBAB8\uC774 \uC464\uC2DC\uACE0 \uBA38\uB9AC\uAC00 \uAE68\uC9C8 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212639
    m_Localized: "\uC2E0\uBC1C\uC744 \uBC97\uACE0 \uC591\uB9D0\uB9CC \uC2E0\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uAC00\uB77D\uC73C\uB85C \uC14B\uC744 \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212640
    m_Localized: "\uBCF5\uB3C4 \uB05D \uC18C\uD654\uC804\uC744 \uCC0D\uACE0 \uB3CC\uC544\uC654\uB2E4. \uBBF8\uB044\uB7EC\uC838\uC11C \uBCBD\uC744 \uC9DA\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213262
    m_Localized: "\uB3C4\uD604\uC774 \uBB34\uC804\uAE30 \uCABD\uC73C\uB85C \uBAB8\uC744 \uAE30\uC6B8\uC600\uB2E4. \uC785\uC220\uC774 \uBA87 \uBC88 \uB2EC\uC2F9\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213261
    m_Localized: "DJ: \uC790\uC804\uAC70\uB85C \uB2E4\uB2C8\uB294 \uC6B4\uBC18\uC870\uAC00 \uC788\uC5B4\uC694. \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88 \uB3D9\uB124\uB97C \uB3CC\uC544\uC694. \uD544\uC694\uD55C \uAC8C \uC788\uC73C\uBA74, \uC11C\uB85C \uBC14\uAFC0 \uC218 \uC788\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213260
    m_Localized: "DJ: \uC6B0\uB9AC\uB294 UBC\uC608\uC694. \uC61B \uBC29\uC1A1\uAD6D \uAC74\uBB3C. \uC2A4\uBB34 \uBA85\uCBE4 \uC0B4\uC544\uC694. \uCCB4\uC721\uACF5\uC6D0\uC5D0\uC11C \uB118\uC5B4\uC628 \uC0AC\uB78C\uB4E4\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213259
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4, \uC544\uC9C1 \uAE68\uC5B4 \uC788\uC5B4\uC694? \uC774\uAC74 \uBC29\uC1A1 \uC544\uB2C8\uACE0 \uADF8\uB0E5 \uD1B5\uD654\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213258
    m_Localized: "\uBC29\uC1A1\uC774 \uB05D\uB09C \uB4A4, 3\uBC88 \uCC44\uB110\uC5D0\uC11C DJ \uC0C8\uBCBD\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uB2E4. \uBC29\uC1A1 \uB54C\uBCF4\uB2E4 \uB0AE\uACE0 \uC870\uC6A9\uD55C \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213592
    m_Localized: "\uB3C5\uAC10\uC774 \uB3CC\uC558\uB2E4. \uB3C4\uD604\uC774 \uBA3C\uC800, \uADF8\uB2E4\uC74C \uB0B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213591
    m_Localized: "\uADF8\uB294 \uB300\uB2F5 \uC5C6\uC774 \uC190\uC744 \uD754\uB4E4\uACE0 \uB5A0\uB0AC\uB2E4. \uB2E4\uC2DC\uB294 \uBCF4\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213590
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uD558\uACE0 \uC9C0\uB3C4\uB97C \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212771
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB059\uB059 \uC553\uB294 \uC18C\uB9AC\uC5D0 \uAE7C\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBD95\uB300 \uAC10\uC740 \uC790\uB9AC\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C \uBB38\uC9C0\uB974\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810818
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD9C\uC11D \uC644\uB8CC. \u2026\uB2E4\uB4E4 \uC5B4\uB518\uAC00\uC5D0\uC11C \uB300\uB2F5\uD558\uACE0 \uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407557
    m_Localized: "\uBE68\uAC1B\uACE0 \uC544\uC0AD\uD55C \uACFC\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407558
    m_Localized: "\uBC31\uC124\uACF5\uC8FC, \uB274\uD134, \uBBF8\uC548\uD558\uB2E4\uB294 \uB9D0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213297
    m_Localized: "\uC815 \uBC18\uC7A5: \uBD80\uBC18\uC7A5 \uC624 \uC528 \uC54C\uC9C0? \uC57D \uC5C6\uC73C\uBA74 \uACA8\uC6B8 \uBABB \uB09C\uB2E4\uACE0, \uD559\uAD50\uB97C \uD138\uC790\uB294 \uB9D0\uC744 \uD558\uACE0 \uB2E4\uB140. \uB530\uB974\uB294 \uC0AC\uB78C\uC774 \uB137\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407456
    m_Localized: "\uB0C4\uBE44\uC5D0\uC11C \uAE40\uC774 \uC62C\uB77C\uC654\uB2E4. \uC300 \uD55C \uC90C\uC5D0 \uBB3C\uC744 \uB109\uB109\uD788 \uBD93\uACE0, \uC18C\uAE08\uC744 \uC544\uC8FC \uC870\uAE08."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810815
    m_Localized: "\uAC19\uC774 \uC77D\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213642
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC740 \uB300\uB2F5\uC774\uB2E4. \uC815\uD655\uD788 \uBAA8\uB97C \uB54C \uD558\uB294 \uB300\uB2F5 \uC911\uC5D0 \uC81C\uC77C \uC88B\uC740 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213643
    m_Localized: "\uC544\uC9C1 \uBAA8\uB974\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407455
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC218\uAC74 \uD55C \uC7A5\uC744 \uC811\uC5B4 \uC591\uB3D9\uC774 \uC704\uC5D0 \uAC78\uCCD0 \uB450\uC5C8\uB2E4. \uBE57\uBB3C\uC740 \uC815\uC218\uD558\uBA74 \uB9C8\uC2E4 \uBB3C\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213298
    m_Localized: "\uC815 \uBC18\uC7A5: \uB0B4\uAC00 \uB9C9\uACE0\uB294 \uC788\uB294\uB370\u2026 \uD639\uC2DC \uBAA8\uB974\uB2C8 \uBB38\uB2E8\uC18D \uC798\uD574. \uC774 \uB9D0 \uD558\uB294 \uAC83\uB3C4 \uC6B0\uB9AC \uCABD\uC5D4 \uBC30\uC2E0\uC774\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213299
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uD558\uACE0 \uBC29\uC5B4\uB97C \uB2E8\uB2E8\uD788 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213300
    m_Localized: "\uADF8\uB0A0 \uBC24 \uAD50\uBB38\uACFC \uCC3D\uACE0 \uBB38\uC5D0 \uBE57\uC7A5\uC744 \uD558\uB098\uC529 \uB354 \uAC78\uC5C8\uB2E4. \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uACC4\uC18D \uADC0\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213301
    m_Localized: "\uC758\uC57D\uD488\uC744 \uC870\uAE08 \uBCF4\uB0B4 \uAC08\uB4F1\uC744 \uB204\uADF8\uB7EC\uB728\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407454
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uADF8\uB0E5 \uBE44. \uADFC\uB370 \uC9C0\uAE08\uC740 \uBC30\uD0C8 \uD55C \uBC88\uC774 \uBAA9\uC228\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213644
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAB0\uB77C\uB3C4 \uB3FC. \uBAA8\uB974\uB294 \uAC78 \uC544\uB294 \uAC83\uB3C4 \uACF5\uBD80\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213645
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uD604\uC774\uAC00 \uADF8\uB7EC\uB354\uB77C. \uB124\uAC00 \uAC00\uB974\uCCD0 \uC900 \uC218\uD559\uC774 \uD559\uC6D0\uBCF4\uB2E4 \uB0AB\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213646
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uB974\uCE5C\uB2E4\uB294 \uAC74 \uB9D0\uC774\uC57C, \uB0B4\uAC00 \uC544\uB294 \uAC78 \uC8FC\uB294 \uAC8C \uC544\uB2C8\uB77C \uC0C1\uB300\uAC00 \uC774\uBBF8 \uAC00\uC9C4 \uAC78 \uAEBC\uB0B4 \uC8FC\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213647
    m_Localized: "\uADF8 \uBC29\uBC95\uC744 \uB354 \uC54C\uB824 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213302
    m_Localized: "{0}: \uC57D \uC870\uAE08 \uBCF4\uB0BC\uAC8C\uC694. \uC624 \uC528\uAC00 \uBB34\uC11C\uC6CC\uD558\uB294 \uAC74 \uC57D\uC774 \uC5C6\uB294 \uACA8\uC6B8\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213303
    m_Localized: "\uC815 \uBC18\uC7A5: \u2026\uD559\uC0DD\uC774 \uC5B4\uB978\uBCF4\uB2E4 \uB0AB\uB124. \uADF8\uAC70\uBA74 \uD55C\uB3D9\uC548 \uC870\uC6A9\uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407559
    m_Localized: "{0}: 3\uBC88. \uCE5C\uAD6C\uAC00 \uC2DC\uD5D8 \uB9DD\uCCE4\uB2E4\uACE0 \uC6B8\uC5B4. \uCCAB\uB9C8\uB514\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407453
    m_Localized: "{0}: \uADF8\uB0E5 \uBE44\uC778\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212918
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A5\uB9C8\uB294 \uD55C \uB2EC\uCBE4 \uAC08 \uAC70\uC57C. \uBB3C\uC740 \uB118\uCE58\uB294\uB370 \uB9C8\uC2E4 \uBB3C\uC740 \uBAA8\uC790\uB780 \uACC4\uC808\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213648
    m_Localized: "\uADF8\uB0A0 \uBC24, \uC120\uC0DD\uB2D8\uC740 \uC218\uC5C5 \uACC4\uD68D\uC11C \uC4F0\uB294 \uBC95\uC744 \uC54C\uB824 \uC8FC\uC5C8\uB2E4. \uC9C4\uC9DC \uAD50\uC0AC\uB4E4\uC774 \uC4F0\uB294 \uC591\uC2DD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213649
    m_Localized: "\uC870\uC6A9\uD788 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213650
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC624\uB298\uB530\uB77C \uC870\uAE08 \uC26C\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407560
    m_Localized: "\"\uBA87 \uC810\uC778\uB370? \uC5B4\uB514\uC11C \uD2C0\uB838\uC5B4?\""
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213304
    m_Localized: "\uB9C8\uD2B8 \uC77C\uC5D0\uB294 \uB07C\uC9C0 \uC54A\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213305
    m_Localized: "{0}: \uADF8\uAC74 \uB9C8\uD2B8 \uC548\uC758 \uC77C\uC774\uC5D0\uC694. \uC6B0\uB9AC \uC77C\uC740 \uC6B0\uB9AC\uAC00 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213651
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC218\uC5C5 \uACC4\uD68D\uC744 \uC138\uC6E0\uB2E4. \uB0A8\uC740 \uC8FC \uC218\uC5D0 \uB9DE\uCDB0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213652
    m_Localized: "\uCE60\uD310\uC5D0 \uC8FC\uCC28\uBCC4 \uB2E8\uC6D0\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uC904\uC5D0\uB294 '\uB9C8\uC9C0\uB9C9 \uC218\uC5C5 \u2014 \uC8FC\uC81C \uC790\uC720'."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213653
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC740 \uB124\uAC00 \uC815\uD574. \uBB34\uC5C7\uC774\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213654
    m_Localized: "\uAC19\uC774 \uACC4\uD68D\uD45C\uB97C \uB2E4\uB4EC\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213655
    m_Localized: "\uD558\uB098\uC529 \uACE0\uCCD0 \uB098\uAC14\uB2E4. \uC2DC, \uC18C\uC124, \uD3B8\uC9C0 \uC4F0\uAE30. \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9 \uCE78\uC740 \uBE44\uC6CC \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213306
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798. \uADF8\uAC8C \uB9DE\uC744 \uC218\uB3C4 \uC788\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407561
    m_Localized: "\"\uB9CE\uC774 \uC18D\uC0C1\uD588\uACA0\uB2E4\u2026\""
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213656
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uAC19\uC740 \uB9D0 \uD558\uC9C0 \uB9D0\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213657
    m_Localized: "{0}: \uB9C8\uC9C0\uB9C9\uC774\uB77C\uACE0 \uC4F0\uC9C0 \uB9C8\uC138\uC694. \uADF8\uB0E5 \uB2E4\uC74C \uC218\uC5C5\uC774\uB77C\uACE0 \uC368\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213658
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC73C\uBA70 '\uB9C8\uC9C0\uB9C9'\uC744 \uC9C0\uC6B0\uACE0 '\uB2E4\uC74C'\uC774\uB77C\uACE0 \uACE0\uCCD0 \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213659
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0 \uB099\uC5FD\uC774 \uBC1C\uBAA9\uAE4C\uC9C0 \uC313\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213660
    m_Localized: "\uAE01\uC5B4\uBAA8\uC544 \uB554\uAC10\uC73C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407562
    m_Localized: "{0}: \uB9C8\uC9C0\uB9C9. \uC5EC\uD589 \uAC00\uBA74 \uACC4\uD68D\uD45C \uC9DC?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213307
    m_Localized: "\uC544\uCE68, \uB9C8\uD2B8 \uCABD \uD558\uB298\uC5D0 \uAC80\uC740 \uC5F0\uAE30\uAC00 \uC62C\uB790\uB2E4. \uBB34\uC804\uAE30\uAC00 \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212919
    m_Localized: "\uC591\uB3D9\uC774\uC640 \uBE48 \uD1B5\uC744 \uBAA8\uB450 \uAEBC\uB0B4 \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810814
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uB984\uC774\uB77C\uB3C4 \uD55C \uBC88 \uBD88\uB7EC \uBCF4\uACE0 \uC2F6\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213661
    m_Localized: "\uB099\uC5FD \uB354\uBBF8\uC5D0 \uB6F0\uC5B4\uB4E4\uACE0 \uC2F6\uC740 \uAC78 \uCC38\uC558\uB2E4. \uBC18\uCBE4\uC740 \uBABB \uCC38\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213662
    m_Localized: "\uADF8\uB0E5 \uBC14\uB77C\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213663
    m_Localized: "\uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uC6B4\uB3D9\uC7A5\uC774 \uAE08\uC0C9\uC73C\uB85C \uCD9C\uB801\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213308
    m_Localized: "\uC815 \uBC18\uC7A5: \uC624 \uC528\uAC00 \uB137 \uB370\uB9AC\uACE0 \uB098\uAC14\uC5B4. \uC57D\uC774\uB791 \uC5F0\uC7A5 \uCC59\uACA8\uC11C. \uC0AC\uAC70\uB9AC\uB85C \uAC14\uC5B4. \uC0AC\uAC70\uB9AC \uD30C\uD55C\uD14C \uBD99\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213309
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB188\uB4E4\uC774 \uC624\uB298 \uBC24 \uCC3D\uACE0 \uD138\uB7EC \uB2E4\uC2DC \uC628\uB300. \uC624 \uC528\uAC00 \uCC3D\uACE0 \uAD6C\uC870\uB97C \uB2E4 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213664
    m_Localized: "\uBC24\uC774 \uCD94\uC6E0\uB2E4. \uC774\uBD88\uC774 \uBAA8\uC790\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213665
    m_Localized: "\uB2F4\uC694\uB97C \uB3C4\uD604\uC5D0\uAC8C \uB36E\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213666
    m_Localized: "\uB300\uC2E0 \uD328\uB529\uC744 \uAEF4\uC785\uACE0 \uC7A4\uB2E4. \uC544\uCE68\uC5D0 \uC5B4\uAE68\uAC00 \uBED0\uADFC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213667
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uB09C\uB85C\uB97C \uD53C\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213668
    m_Localized: "\uB2E4 \uAC19\uC774 \uB09C\uB85C \uC8FC\uC704\uC5D0 \uBAA8\uC5EC \uC190\uC744 \uB179\uC600\uB2E4. \uB204\uAD70\uAC00 \uACE0\uAD6C\uB9C8\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213310
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD\uB124 \uADF8 \uC5EC\uC790\uC560\uAC00 \uBBF8\uB9AC \uB9D0\uD574 \uC918\uC11C \uC57D \uC808\uBC18\uC740 \uC62E\uACA8 \uB1A8\uC5B4. \uACE0\uB9D9\uB2E4\uACE0 \uC804\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213311
    m_Localized: "\uC815 \uBC18\uC7A5: \uB3C4\uC640 \uB2EC\uB77C\uB294 \uB9D0\uC740 \uC548 \uD560\uAC8C. \uB108\uD76C\uB3C4 \uBC84\uD2F0\uAE30 \uBC14\uC058\uB2C8\uAE4C. \uADF8\uB0E5\u2026 \uC54C\uB824 \uC8FC\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213669
    m_Localized: "DJ: \uC624\uB298\uC740 \uC2E0\uCCAD\uACE1 \uBC1B\uC2B5\uB2C8\uB2E4. 3\uBC88 \uCC44\uB110, \uC544\uBB34\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213670
    m_Localized: "\uC2E0\uCCAD\uACE1\uC744 \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213671
    m_Localized: "{0}: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC694. \uC544\uBB34 \uB178\uB798\uB098\u2026 \uC2E0\uB098\uB294 \uAC78\uB85C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213672
    m_Localized: "DJ: \uC0C8\uBCBD\uACE0! \uBC18\uAC00\uC6CC\uC694. \uC624\uB298 \uBC24\uC740 \uC774 \uB178\uB798\uB85C \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212920
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uAD6C\uC11D\uAE4C\uC9C0 \uD1B5\uC744 \uB298\uC5B4\uB193\uC558\uB2E4. \uBE57\uC18C\uB9AC\uAC00 \uD1B5\uB9C8\uB2E4 \uB2E4\uB978 \uC74C\uC73C\uB85C \uC6B8\uB838\uB2E4. \uC815\uC218\uD558\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213312
    m_Localized: "\uB9C8\uD2B8\uB85C \uAC00\uC11C \uAC19\uC774 \uCC3D\uACE0\uB97C \uC9C0\uD0A8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212921
    m_Localized: "\uACF0\uD321\uC774\uAC00 \uBC88\uC9C0\uAE30 \uC804\uC5D0 \uB300\uCCAD\uC18C\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213673
    m_Localized: "\uC804\uB825\uC744 \uC544\uB07C\uB824\uACE0 \uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213674
    m_Localized: "\uBB34\uC804\uAE30 \uBD88\uC774 \uAEBC\uC9C0\uC790 \uAD50\uC2E4\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213675
    m_Localized: "\uAD50\uBB38 \uC55E \uC9C4\uD759\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uC794\uB729 \uCC0D\uD600 \uC788\uC5C8\uB2E4. \uC0AC\uB78C\uC758 \uAC83\uB3C4, \uC544\uB2CC \uAC83\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213676
    m_Localized: "\uBC24\uC5D0 \uAD50\uB300\uB85C \uC21C\uCC30\uC744 \uB3C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213313
    m_Localized: "\uBC24\uC0C8 \uCC3D\uACE0 \uC154\uD130 \uC55E\uC744 \uC9C0\uCF30\uB2E4. \uC0C8\uBCBD\uC5D0 \uBAB0\uB824\uC628 \uC6B0\uBE44\uB4E4\uC740 \uBD88\uBE5B\uACFC \uC0AC\uB78C \uC218\uB97C \uBCF4\uACE0 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407563
    m_Localized: "\uC2DC\uAC04 \uB2E8\uC704\uB85C \uC9E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407564
    m_Localized: "\uAC00\uC11C \uC815\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213677
    m_Localized: "\uCD94\uC6B4 \uBCF5\uB3C4\uB97C \uC624\uAC00\uBA70 \uBC24\uC744 \uC0C8\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213678
    m_Localized: "\uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406912
    m_Localized: "\uBA70\uCE60 \uB4A4, \uBC1C\uC790\uAD6D\uC740 \uB354 \uB9CE\uC544\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212922
    m_Localized: "\uB77D\uC2A4\uB97C \uC544\uAEF4 \uAC00\uBA70 \uBCBD\uC744 \uB2E6\uC558\uB2E4. \uB0C4\uC0C8\uAC00 \uB3C5\uD588\uC9C0\uB9CC, \uBC24\uC5D0 \uC228\uC26C\uAE30\uAC00 \uD55C\uACB0 \uD3B8\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810813
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD45C\uC9C0\uB97C \uC4F0\uB2E4\uB4EC\uAE30\uB9CC \uD558\uACE0 \uD55C\uCC38 \uD3B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406913
    m_Localized: "\uAD50\uBB38 \uCABD\uC5D0\uC11C \uC1E0\uC0AC\uC2AC \uB04A\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC6B4\uB3D9\uC7A5\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC624\uB294 \uC0AC\uB78C\uB4E4\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212923
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uCD08\uBCF5\uC774\uB2E4. \uC6D0\uB798\uB294 \uAE09\uC2DD\uC5D0 \uC0BC\uACC4\uD0D5 \uB098\uC624\uB294 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212924
    m_Localized: "\uB2ED\uC740 \uC5C6\uC5C8\uB2E4. \uB2ED\uAC00\uC2B4\uC0B4 \uD1B5\uC870\uB9BC \uD558\uB098\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406914
    m_Localized: "\uC6B0\uBE44\uB4E4\uC774\uC5C8\uB2E4. \uC0AC\uAC70\uB9AC \uD30C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406915
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD1B5\uD589\uC138\uB97C \uBC1B\uB358 \uB188\uB4E4\uC774 \uC544\uB2C8\uC57C. \uC0C8 \uC5BC\uAD74\uB4E4\uC774\uC57C. \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C\uB3C4 \uB9D0\uC744 \uC548 \uB4E3\uB294 \uB188\uB4E4\uC774 \uC788\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406916
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0AC\uAC70\uB9AC \uD30C\uB2E4. \uAC15\uCCA0\uC774 \uC815\uB9D0 '\uC6D0\uCE59\uB300\uB85C' \uD558\uB7EC \uC654\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406917
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE61\uD328\uB4E4\uC774\uB2E4. \uC6B0\uB9AC\uAC00 \uC5EC\uAE30 \uC788\uB294 \uAC78 \uC54C\uACE0 \uC628 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212925
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uB2E4 \uAC19\uC774 \uB098\uB220 '\uC0BC\uACC4\uD0D5'\uC744 \uB053\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810812
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uB9E1\uC744 \uBC18\uC774\uC5C8\uC5B4. \uCCAB \uC218\uC5C5\uC774 \uC0AC\uD0DC \uB2E4\uC74C \uC8FC\uC600\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406918
    m_Localized: "\uC624\uB298 \uD558\uB824\uB358 \uC77C\uC740 \uBAA8\uB450 \uBBF8\uB904\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213314
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uB0B4 \uC5B4\uAE68\uB97C \uB450 \uBC88 \uB450\uB4DC\uB838\uB2E4. \uB9D0\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406919
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC \uB4A4\uC5D0\uC11C \uB9DE\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406920
    m_Localized: "\uCC45\uC0C1\uACFC \uBB38\uC9DD \uB4A4\uB85C \uBAB8\uC744 \uBD99\uC774\uACE0, \uB4E4\uC5B4\uC624\uB294 \uAE38\uBAA9\uC744 \uB9C9\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406921
    m_Localized: "\uBD88\uC744 \uB044\uACE0 \uC228\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406922
    m_Localized: "\uBAA8\uB450 \uC228\uC744 \uC8FD\uC600\uB2E4. \uBCF5\uB3C4\uB97C \uAC77\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uD558\uB098, \uB458."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406923
    m_Localized: "\uBB3C\uC790\uB97C \uB0B4\uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406928
    m_Localized: "\uAC15\uCCA0\uC774 \uB2F4\uBC30 \uB300\uC2E0 \uB9C8\uB978 \uB098\uBB47\uAC00\uC9C0\uB97C \uC785\uC5D0 \uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406929
    m_Localized: "\uAC15\uCCA0: \uD560 \uB9D0\uC740 \uC774\uAC70\uB2E4. \uC624 \uC528 \uD328\uAC70\uB9AC. \uC6B0\uB9AC \uBC11\uC5D0\uC11C\uB3C4 \uB9D0 \uC548 \uB4E3\uACE0 \uB098\uAC14\uC5B4. \uB9C8\uC9C0\uB9C9 \uD55C\uD30C \uB0A0, \uB108\uD76C \uD559\uAD50 \uB178\uB9B0\uB2E4. \uC57D \uB0C4\uC0C8\uB97C \uB9E1\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406930
    m_Localized: "\uAC15\uCCA0: \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4\uB294 \uAC8C \uB0B4 \uC6D0\uCE59\uC774\uC5C8\uC9C0. \uADF8 \uC6D0\uCE59, \uB05D\uAE4C\uC9C0 \uC9C0\uD0A4\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406931
    m_Localized: "\uADF8\uB0A0 \uBC24 \uAC19\uC774 \uB9C9\uC544 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406932
    m_Localized: "{0}: \uADF8\uB0A0 \uBC24, \uB2F4\uC7A5\uC5D0 \uAC19\uC774 \uC11C \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212941
    m_Localized: "\uC544\uCE68\uBD80\uD130 \uB9E4\uBBF8\uAC00 \uC6B8\uC5C8\uB2E4. \uCC3D\uACE0 \uC548\uC758 \uACF5\uAE30\uAC00 \uB048\uC801\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407258
    m_Localized: "1\uC8FC\uCC28\uBD80\uD130 \uC77D\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBB38\uC744 \uC5F4\uC5B4 \uC92C\uB2E4, \uC77C\uC8FC\uC77C \uB9CC\uC5D0 \uC0AC\uB78C \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407259
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC7A5\uAE4C\uC9C0 \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213346
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC81\uC8FC\uB824\uB294 \uAC70\uC57C. \uADF8\uB9AC\uACE0\u2026 \uAC81\uC774 \uB098\uAE34 \uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213345
    m_Localized: "\uB204\uAD70\uAC00 \uBC24\uC0AC\uC774 \uAD50\uBB38\uC744 \uB118\uC5B4 \uB4E4\uC5B4\uC654\uB2E4 \uB098\uAC14\uB2E4\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213344
    m_Localized: "'\uC0AC\uAC70\uB9AC\uB294 \uAE30\uC5B5\uD55C\uB2E4. \u2014 \uAC15\uCCA0'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213343
    m_Localized: "\uAD50\uBB38 \uC548\uCABD\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uBABB\uC73C\uB85C \uBC15\uD600 \uC788\uC5C8\uB2E4. \uBD89\uC740 \uB3D9\uADF8\uB77C\uBBF8 \uC548\uC758 \uC5D1\uC2A4, \uADF8\uB9AC\uACE0 \uD55C \uC904."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213342
    m_Localized: "\uAC15\uCCA0: \uADF8\uB798. \uADF8\uAC83\uB3C4 \uC6D0\uCE59\uC774\uC9C0. \uADF8\uB7FC \uC6B0\uB9AC\uB3C4 \uC6B0\uB9AC \uC6D0\uCE59\uB300\uB85C \uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407578
    m_Localized: "{0}: \uADFC\uB370 \uBC30\uCE58\uACE0\uC0AC \uACB0\uACFC \uB098\uC654\uC796\uC544. \uB108 \uBA87 \uB4F1 \uD588\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406933
    m_Localized: "\uAC15\uCCA0\uC774 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407577
    m_Localized: "{0}: \uADF8\uB7F0 \uC0AC\uB78C\uC774 \uC81C\uC77C \uC6B4 \uC88B\uB300. \uBC29\uAE08 \uB0B4\uAC00 \uC9C0\uC5B4\uB0C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213341
    m_Localized: "\uAC15\uCCA0\uC774 \uBAA8\uC790\uB97C \uB2E4\uC2DC \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213340
    m_Localized: "{0}: \uC774\uC81C \uC548 \uB0B4\uC694. \uC9C0\uD0AC \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213339
    m_Localized: "\uB354\uB294 \uBABB \uB0B8\uB2E4. \uC57D\uC18D\uC740 \uB05D\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407260
    m_Localized: "\uC77D\uB294 \uB3D9\uC548 \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uB2E4. \uCC98\uC74C \uC218\uC5C5 \uB54C\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407261
    m_Localized: "\uB2E4 \uC77D\uC790 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4. \uC798 \uCEF8\uB2E4. \uC815\uB9D0 \uC798 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407262
    m_Localized: "\uC77C\uAE30\uB294 \uB098\uB9CC \uBCF4\uB294 \uAC70\uB77C\uACE0 \uC6C3\uC73C\uBA70 \uAC70\uC808\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406990
    m_Localized: "\uC791\uBCC4\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406989
    m_Localized: "\uC900\uC774 \uC6B8\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC785\uC220\uC744 \uAE68\uBB3C\uC5C8\uB2E4. \uACB0\uAD6D \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212930
    m_Localized: "\uCD08\uBCF5\uC774\uB77C\uB294 \uB9D0\uB9CC \uBA87 \uBC88 \uC785\uC5D0 \uAD74\uB824 \uBCF4\uC558\uB2E4. \uADF8\uAC83\uB9CC\uC73C\uB85C \uC870\uAE08 \uB35C \uB354\uC6B4 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406988
    m_Localized: "{0}: \uAC19\uC774 \uAC00. \uBA85\uB2E8\uC5D0 \uB124 \uC774\uB984 \uC62C\uB9B4\uAC8C. \uC624\uB298\uBD80\uD130 \uB108\uB294 \uC0AC\uAC70\uB9AC \uD30C \uB9D0\uACE0, \uADF8\uB0E5 \uC900\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406987
    m_Localized: "\uC900\uC744 \uBA85\uB2E8\uC5D0 \uC62C\uB9AC\uACE0 \uD568\uAED8 \uAC00\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406986
    m_Localized: "\uC900: \uB204\uB098. \uD5EC\uAE30\u2026 \uC800\uB3C4 \uD0C8 \uC218 \uC788\uC5B4\uC694? \uAC80\uC0AC, \uC800 \uC548 \uBB3C\uB838\uC5B4\uC694. \uC9C4\uC9DC\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212940
    m_Localized: "\uC0C8\uBCBD\uB158\uC5D0\uC57C \uBC14\uB78C\uC774 \uD55C \uC904\uAE30 \uB4E4\uC5B4\uC654\uB2E4. \uADF8 \uBC14\uB78C\uC5D0 \uB2E4\uB4E4 \uD55C\uAEBC\uBC88\uC5D0 \uC7A0\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213338
    m_Localized: "\uAC15\uCCA0: \uC6D0\uCE59\uC740 \uB0B4\uAC00 \uC815\uD558\uB294 \uAC70\uC57C, \uAF2C\uB9C8. \uB2E4\uC74C \uC8FC\uBD80\uD130 \uBB38 \uC870\uC2EC\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213337
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC84C\uB2E4. \uAC15\uCCA0\uC758 \uBD80\uD558 \uD558\uB098\uAC00 \uBE44\uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407576
    m_Localized: "\uBAB0\uB77C. \uAC80\uC0AC\uD574 \uBCF8 \uC801 \uC5C6\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212939
    m_Localized: "\uBC24\uC778\uB370\uB3C4 \uB354\uC704\uAC00 \uC2DD\uC9C0 \uC54A\uC558\uB2E4. \uB204\uAC00 \uBD80\uCC44\uC9C8\uD558\uB294 \uC18C\uB9AC\uB9CC \uBC24\uC0C8 \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406985
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uC900\uC774 \uC11C \uC788\uC5C8\uB2E4. \uC6B0\uBE44\uB97C \uBC97\uC740 \uCC44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810811
    m_Localized: "\uC218\uC5C5 \uC900\uBE44\uB97C \uD558\uB2E4\uAC00 \uAD50\uD0C1 \uC11C\uB78D\uC5D0\uC11C \uC587\uC740 \uCD9C\uC11D\uBD80\uAC00 \uB098\uC654\uB2E4. 1\uD559\uB144 4\uBC18."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406984
    m_Localized: "\uC544\uCE68. \uAE34 \uBC24\uC774 \uC9C0\uB098\uAC14\uB2E4. \uC0AC\uAC70\uB9AC \uCABD\uC740 \uC870\uC6A9\uD588\uB2E4. \uAC15\uCCA0\uACFC\uC758 \uC57D\uC18D\uC774, \uC9C0\uCF1C\uC9C4 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406983
    m_Localized: "\uAC15\uCCA0\uC740 \uC625\uC0C1 \uACC4\uB2E8 \uC55E\uC5D0\uC11C \uBA48\uCDC4\uB2E4\uACE0, \uB204\uAD70\uAC00 \uB9D0\uD588\uB2E4. \uC560\uB4E4 \uC788\uB294 \uB370\uAE4C\uC9C4 \uC548 \uC62C\uB77C\uC654\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406982
    m_Localized: "\uC544\uCE68. \uCC3D\uACE0 \uBB38\uC774 \uB72F\uACA8 \uC788\uC5C8\uB2E4. \uC57D\uC7A5\uB3C4 \uBC18\uCBE4 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC625\uC0C1 \uBB38\uC740 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810806
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uB9D0, \uC624\uB798 \uAE30\uC5B5\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810807
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uB0A0 \uBCF8 \uAC83\uB4E4\uC744 \uCC9C\uCC9C\uD788, \uD558\uB098\uC529 \uC774\uC57C\uAE30\uD588\uB2E4. \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406981
    m_Localized: "\uAC15\uCCA0\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB0A8\uC544 \uD559\uAD50\uB97C \uC62C\uB824\uB2E4\uBCF4\uB2E4\uAC00, \uBAA8\uC790\uB97C \uBC97\uC5B4 \uD55C \uBC88 \uB4E4\uC5B4 \uBCF4\uC774\uACE0 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406980
    m_Localized: "\uC544\uCE68. \uC6B0\uBE44\uB4E4\uC740 \uBB3C\uB7EC\uAC14\uB2E4. \uAD50\uBB38 \uC55E \uB208 \uC704\uC5D0 \uBD89\uC740 \uD398\uC778\uD2B8 \uD1B5\uC774 \uC4F0\uB7EC\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406979
    m_Localized: "\uAC15\uCCA0: \uB05D\uAE4C\uC9C0 \uC9C0\uCF30\uB2E4. \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4. \uCCB4\uC721\uAD00 \uAC04\uD310\uC5D0 \uC368 \uBD99\uC5EC \uB1A8\uB358 \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407263
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uB9DE\uB2E4. \uC77C\uAE30\uB294 \uADF8\uB798\uC57C\uC9C0. \uB098\uC911\uC5D0 \uCC45\uC73C\uB85C \uB098\uC624\uBA74 \uADF8\uB54C \uC0AC\uC11C \uC77D\uC73C\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407264
    m_Localized: "\uBC24\uC0C8 \uB208\uC774 \uC313\uC600\uB2E4. \uC6B4\uB3D9\uC7A5\uC774 \uD558\uC597\uAC8C \uB36E\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810808
    m_Localized: "\uC774\uC81C \uADF8\uB9CC \uC26C\uC2DC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407575
    m_Localized: "{0}: AB\uD615\uC740 '\uC911\uC694\uD55C \uACB0\uC815\uC744 \uBBF8\uB8E8\uC9C0 \uB9D0 \uAC83'. \uC624, \uC758\uBBF8\uC2EC\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213336
    m_Localized: "\uAC15\uCCA0: \u2026\uAD00\uC7A5\uB2D8 \uC18C\uB9AC \uB4E4\uC744 \uB54C \uC0DD\uAC01\uB098\uB124. \uB410\uB2E4. \uC9C0\uAE08\uB300\uB85C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213335
    m_Localized: "\uAC15\uCCA0\uC774 \uB098\uB97C \uC624\uB798 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212938
    m_Localized: "\uC816\uC740 \uC218\uAC74\uC744 \uBAA9\uC5D0 \uB450\uB974\uACE0 \uBC14\uB2E5\uC5D0 \uB204\uC6E0\uB2E4. \uC2DC\uBA58\uD2B8 \uBC14\uB2E5\uB9CC \uC870\uAE08 \uC11C\uB298\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407265
    m_Localized: "\uB208\uC0AC\uB78C\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407266
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC0AC\uB78C\uC5D0\uAC8C \uBAA9\uBC1C \uB450 \uAC1C\uB97C \uAF42\uC544 \uC8FC\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uCC3D\uBB38\uC73C\uB85C \uADF8\uAC78 \uBCF4\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407267
    m_Localized: "\uB208\uC744 \uBAA8\uC544 \uB179\uC5EC \uBB3C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212937
    m_Localized: "\uC5F4\uB300\uC57C\uC600\uB2E4. \uCC3D\uBB38\uC744 \uC5F4\uBA74 \uBAA8\uAE30\uAC00, \uB2EB\uC73C\uBA74 \uC228\uC774 \uB9C9\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213334
    m_Localized: "{0}: \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4\uBA74\uC11C\uC694. \uC560\uB4E4 \uBA39\uC744 \uAC78 \uB354 \uAC00\uC838\uAC00\uB294 \uAC83\uB3C4 \uAC74\uB4DC\uB9AC\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213333
    m_Localized: "\uC6D0\uCE59\uC744 \uC9C0\uCF1C \uB2EC\uB77C\uACE0, \uC9C0\uAE08 \uBAAB\uC73C\uB85C \uCDA9\uBD84\uD558\uB2E4\uACE0 \uB9DE\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407574
    m_Localized: "AB\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407573
    m_Localized: "{0}: O\uD615\uC740 '\uCCB4\uB825 \uAD00\uB9AC'. \uB108\uD55C\uD14C \uB531\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213332
    m_Localized: "\uAC15\uCCA0: \uACA8\uC6B8 \uC9C0\uB098\uBA74 \uAC1A\uC744 \uC77C \uC788\uC744 \uAC70\uB2E4. \uC0AC\uAC70\uB9AC\uB294 \uBC1B\uC740 \uAC74 \uAE30\uC5B5\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213331
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uC0C1\uC790\uC9F8 \uAC74\uB138\uB2E4. \uAC15\uCCA0\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213330
    m_Localized: "\uC774\uBC88 \uD55C \uBC88 \uB354 \uC2DD\uB7C9\uC744 \uB0B4\uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213329
    m_Localized: "\uAC15\uCCA0: \uADFC\uB370 \uACA8\uC6B8\uC774 \uC640. \uC6B0\uB9AC \uC2DD\uAD6C\uAC00 \uB298\uC5C8\uC5B4. \uC774\uBC88 \uACA8\uC6B8 \uC55E\uB450\uACE0, \uD55C \uBC88 \uB354 \uC131\uC758\uB97C \uBCF4\uC5EC \uC92C\uC73C\uBA74 \uD558\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213328
    m_Localized: "\uAC15\uCCA0: \uC0AC\uD0DC \uC804\uC5D4 \uC0AC\uAC70\uB9AC\uC5D0\uC11C \uBCF5\uC2F1 \uCCB4\uC721\uAD00\uC744 \uD588\uC5B4. \uC560\uB4E4 \uAC00\uB974\uCCE4\uC9C0. \uADF8\uB798\uC11C \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB824. \uADF8\uAC8C \uB0B4 \uC6D0\uCE59\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212936
    m_Localized: "\uC625\uC0C1 \uD143\uBC2D\uC758 \uC0C1\uCD94\uAC00 \uBCD5\uC744 \uBC1B\uC544 \uBC18\uC9DD\uC600\uB2E4. \uC6B0\uB9AC\uAC00 \uB418\uCC3E\uC740 \uB4E4\uC740 \uC544\uC9C1 \uC774 \uC815\uB3C4\uB2E4. \uADF8\uB798\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406978
    m_Localized: "\uAC15\uCCA0\uC774 \uAD50\uBB38 \uC55E\uC5D0\uC11C \uC7A5\uAC11\uC744 \uBC97\uC5C8\uB2E4. \uC190\uB4F1\uC774 \uAC08\uB77C\uC838 \uD53C\uAC00 \uB9FA\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406977
    m_Localized: "\uC544\uCE68. \uB2F4\uC7A5 \uC544\uB798 \uB208\uBC2D\uC774 \uC628\uD1B5 \uC9D3\uBC1F\uD600 \uC788\uC5C8\uB2E4. \uC624 \uC528 \uD328\uAC70\uB9AC\uB294 \uAC15\uBCC0 \uCABD\uC73C\uB85C \uD769\uC5B4\uC84C\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406976
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uBB38\uC73C\uB85C \uB2E4\uC12F, \uC67C\uCABD \uACC4\uB2E8\uC73C\uB85C \uC14B. \uC625\uC0C1 \uBB38\uC740 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C. \uC624\uB298\uC740 \uB098\uB3C4 \uBB38 \uC55E\uC5D0 \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213327
    m_Localized: "\uAC15\uCCA0: \uB0B4\uAC00 \uAC15\uCCA0\uC774\uB2E4. \uC9C1\uC811 \uBCF4\uB294 \uAC74 \uCC98\uC74C\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407446
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 {0}, \uB2E4\uCE58\uBA74 \uC228\uAE30\uC9C0 \uB9C8. \uC808\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407447
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uB9D0\uC744 \uD558\uACE0 \uC7A0\uAE50, \uC790\uAE30 \uBB34\uB98E \uC544\uB798\uB97C \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406975
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406974
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uB208\uC774 \uB418\uC5B4 \uC8FC\uB9C8. \uC815\uBB38\uC73C\uB85C \uB2E4\uC12F, \uC67C\uCABD \uACC4\uB2E8\uC73C\uB85C \uC14B. \uC625\uC0C1 \uBB38\uC740 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406973
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406972
    m_Localized: "\uAC15\uCCA0: \uC77C\uC8FC\uC77C \uC92C\uB2E4. \uC6D0\uCE59\uB300\uB85C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406971
    m_Localized: "\uB9E8 \uC55E\uC5D0 \uAC15\uCCA0\uC774 \uC788\uC5C8\uB2E4. \uC6B0\uBE44\uB4E4\uC774 \uADF8 \uB4A4\uB85C \uB05D\uC5C6\uC774 \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406970
    m_Localized: "\uAD6C\uC870\uB97C 3\uC8FC \uC55E\uB454 \uBC24. \uBD89\uC740 \uD398\uC778\uD2B8\uB97C \uCE60\uD55C \uAD50\uBB38\uC774 \uC1E0\uC0AC\uC2AC \uB04A\uAE30\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406969
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC67C\uCABD \uACC4\uB2E8, \uC14B. \uBD81\uCABD \uB2F4\uC7A5\uC740 \uAC15\uCCA0 \uC528 \uCABD\uC5D0 \uB9E1\uAE30\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406968
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uAC00\uC5D0\uC11C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406934
    m_Localized: "\uAC15\uCCA0: \uC560\uB4E4 \uC9C0\uD0A4\uB294 \uC77C\uC774\uBA74, \uCCB4\uC721\uAD00 \uBB38 \uB2EB\uC740 \uB4A4\uB85C \uCC98\uC74C\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406935
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0, \uACA8\uC6B8 \uC2DD\uB7C9\uC744 \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406936
    m_Localized: "\uD1B5\uC870\uB9BC \uB2E4\uC12F \uAC1C\uB97C \uAC74\uB138\uB2E4. \uAC15\uCCA0\uC740 \uBC1B\uC544\uC11C \uD55C \uBC88 \uB4E4\uC5B4 \uBCF4\uB354\uB2C8, \uD558\uB098\uB97C \uB2E4\uC2DC \uB0B4 \uC190\uC5D0 \uC950\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810809
    m_Localized: "{0}: \uC624\uB298\uC740 \uADF8\uB9CC\uD574\uC694. \uBD95\uB300 \uAC08\uACE0 \uC26C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407448
    m_Localized: "\uBC24\uC0C8 \uBC1B\uC544 \uB454 \uC591\uB3D9\uC774\uC5D0 \uBE57\uBB3C\uC774 \uACE0\uC5EC \uC788\uC5C8\uB2E4. \uBAA9\uC774 \uB9D0\uB77C\uC11C, \uC190\uC73C\uB85C \uB5A0 \uB9C8\uC2DC\uB824 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406967
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uC11C \uB2E4 \uBCF4\uC778\uB2E4. \uC67C\uCABD \uACC4\uB2E8, \uC14B. \uAC15\uCCA0 \uC528 \uCABD\uC740 \uBD81\uCABD \uB2F4\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406966
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4. \uBAA9\uC18C\uB9AC\uB294 \uC791\uC558\uC9C0\uB9CC \uB610\uB837\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406965
    m_Localized: "\uAC15\uCCA0: \uC624 \uC528! \uC5EC\uAE30 \uC560\uB4E4 \uD559\uAD50\uB2E4. \uB3CC\uC544\uAC00\uB77C. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406964
    m_Localized: "\uADF8\uB54C \uB2F4\uC7A5 \uC704\uB85C \uC190\uC804\uB4F1 \uBD88\uBE5B\uC774 \uD558\uB098, \uB458, \uC5F4 \uAC1C \uB118\uAC8C \uCF1C\uC84C\uB2E4. \uC6B0\uBE44\uB4E4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406963
    m_Localized: "\uAD6C\uC870\uB97C 3\uC8FC \uC55E\uB454 \uBC24. \uB208 \uC704\uB85C \uADF8\uB9BC\uC790\uB4E4\uC774 \uD559\uAD50\uB97C \uD5A5\uD574 \uAC78\uC5B4\uC654\uB2E4. \uC624 \uC528\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407449
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A0\uAE50, \uADF8\uAC70 \uADF8\uB0E5 \uB9C8\uC2DC\uBA74 \uC548 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407450
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC591\uB3D9\uC774\uB97C \uB04C\uC5B4\uB2F9\uACA8 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4. \uBC14\uB2E5\uC5D0 \uBA3C\uC9C0\uC640 \uB179 \uBD80\uC2A4\uB7EC\uAE30\uAC00 \uAC00\uB77C\uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406937
    m_Localized: "\uAC15\uCCA0: \uB137\uC774\uBA74 \uCDA9\uBD84\uD558\uB2E4. \uB108\uD76C \uBAAB \uB0A8\uACA8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406938
    m_Localized: "\uC6B0\uB9AC \uC77C\uC740 \uC6B0\uB9AC\uAC00 \uD558\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212931
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC544\uCE68\uBD80\uD130 \uCE60\uD310\uC5D0 \uB0A0\uC9DC\uB97C \uD06C\uAC8C \uC37C\uB2E4. 8\uC6D4 15\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212932
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uAD11\uBCF5\uC808. \uBE7C\uC557\uAE34 \uAC78 \uB418\uCC3E\uC740 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406939
    m_Localized: "{0}: \uC54C\uB824 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694. \uADF8\uB0A0\uC740 \uC6B0\uB9AC\uAC00 \uC9C0\uD0AC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213319
    m_Localized: "\uAC15\uCCA0\uC774 \uD55C\uCC38 \uC6C3\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC624 \uC528\uC758 \uB4F1\uC744 \uB5A0\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213320
    m_Localized: "\uAC15\uCCA0: \uC560\uAC00 \uC7A5\uC0AC\uB97C \uC544\uB124. \uC624 \uC528, \uB108\uB294 \uC5EC\uAE30 \uB0A8\uACE0. \uB9C8\uD2B8 \uCC3D\uACE0\uB294 \uAC74\uB4DC\uB9AC\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406962
    m_Localized: "\uADF8\uB0A0\uBD80\uD130 \uC544\uBB34\uB3C4 \uAD50\uBB38 \uCABD \uCC3D\uBB38\uC744 \uC5F4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406961
    m_Localized: "\uAC15\uCCA0: \uADF8\uB798. \uADF8\uB7FC \uADF8\uB0A0 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406960
    m_Localized: "{0}: \uC548 \uBE44\uC6CC\uC694. \uC5EC\uAE30\uB294 \uC6B0\uB9AC \uD559\uAD50\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406959
    m_Localized: "\uBE44\uC6B0\uC9C0 \uC54A\uB294\uB2E4. \uC5EC\uAE30\uB294 \uC6B0\uB9AC \uD559\uAD50\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406958
    m_Localized: "\uAC15\uCCA0: \uC77C\uC8FC\uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406957
    m_Localized: "\uB0B4 \uB9D0\uC740 \uBC14\uB78C\uC5D0 \uD769\uC5B4\uC84C\uB2E4. \uAC15\uCCA0\uC774 \uB4F1\uC744 \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407451
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC625\uC0C1\uC774\uB791 \uD648\uD1B5\uC744 \uD0C0\uACE0 \uB0B4\uB824\uC628 \uBB3C\uC774\uC57C. \uBB50\uAC00 \uC11E\uC600\uB294\uC9C0 \uBAB0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810810
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uACE0\uB9C8\uC6CC. \u2026\uBD88 \uB04C\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406956
    m_Localized: "\uAC15\uCCA0: \uBA85\uB2E8. \uAC70\uAE30 \uB0B4 \uC774\uB984 \uB9D0\uACE0, \uC6B0\uB9AC \uC560\uB4E4 \uC774\uB984 \uBA3C\uC800 \uC62C\uB824\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406940
    m_Localized: "\uAC15\uCCA0: \uADF8\uB798. \uADF8\uAC83\uB3C4 \uC6D0\uCE59\uC774\uC9C0. \uBB38 \uB2E8\uB2E8\uD788 \uC7A0\uAC00\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407572
    m_Localized: "O\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407571
    m_Localized: "{0}: B\uD615\uC740 '\uC608\uC0C1\uCE58 \uBABB\uD55C \uB9CC\uB0A8'\uC774\uB798. \uBB50\uC57C \uADF8\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213326
    m_Localized: "\uC774\uBC88\uC5D4 \uC6B0\uBE44\uAC00 \uC14B\uC774\uC5C8\uB2E4. \uAC00\uC6B4\uB370 \uC0AC\uB78C\uC774 \uBAA8\uC790\uB97C \uBC97\uC5C8\uB2E4. \uB208\uC379\uC744 \uAC00\uB85C\uC9C0\uB974\uB294 \uD749\uD130. \uB9C8\uD754\uCBE4 \uB41C \uB0A8\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213325
    m_Localized: "\uBA70\uCE60 \uB4A4 \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uC744 \uB54C, \uADF8\uB294 \uB0B4 \uC774\uB984\uC744 \uBD80\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406955
    m_Localized: "\uAC15\uCCA0\uC774 \uC6C3\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uD398\uC778\uD2B8 \uD1B5\uC744 \uBC1C\uB85C \uBC00\uC5B4 \uB118\uC5B4\uB728\uB838\uB2E4. \uBD89\uC740 \uAE00\uC528 \uC704\uB85C \uD398\uC778\uD2B8\uAC00 \uD758\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406954
    m_Localized: "{0}: \uAC80\uC0AC\uB294 \uC544\uBB34\uB3C4 \uBABB \uC18D\uC5EC\uC694. \uADF8\uB798\uB3C4 \uBA85\uB2E8\uC5D0 \uC774\uB984\uC740 \uC62C\uB824 \uC904 \uC218 \uC788\uC5B4\uC694. \uBB34\uC804\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406953
    m_Localized: "{0}: \uAD6C\uC870\uB300\uB294 \uC2F8\uC6B0\uB294 \uACF3\uC5D4 \uC548 \uB0B4\uB824\uC694. \uC625\uC0C1\uC5D0 \uD53C\uAC00 \uBB3B\uC73C\uBA74, \uADF8\uB0A0 \uD5EC\uAE30\uB294 \uADF8\uB0E5 \uC9C0\uB098\uAC00\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406952
    m_Localized: "\uD5EC\uAE30\uB294 \uBAA8\uB450\uB97C \uD0DC\uC6B4\uB2E4\uACE0, \uC2F8\uC6B0\uBA74 \uC544\uBB34\uB3C4 \uBABB \uD0C4\uB2E4\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406951
    m_Localized: "\uAC15\uCCA0: \u2026\uD5EC\uAE30\uC5D0 \uC6B0\uB9AC \uC790\uB9AC \uD558\uB098\uB9CC \uBB3C\uC5B4\uBD10 \uC918\uB77C. \uC548 \uB418\uBA74 \uB9D0\uACE0. \uADF8\uAC78\uB85C \uB05D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407323
    m_Localized: "???: \u2026\uACE0\uB9C8\uC6CC. \uC774 \uADFC\uCC98\uC5D0 \uC788\uC744\uAC8C. \uD639\uC2DC \uB610 \uBCF4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407322
    m_Localized: "\uAC00\uBC29\uC5D0\uC11C \uD1B5\uC870\uB9BC \uB450 \uAC1C\uB97C \uAEBC\uB0B4 \uAC74\uB138\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407072
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC774\uBD88 \uC18D\uC5D0\uC11C \uC190\uAC00\uB77D\uC73C\uB85C \uCC3D\uBC16\uC744 \uAC00\uB9AC\uCF30\uB2E4. \uD574\uAC00 \uBC8C\uC368 \uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407071
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB\uB208 \uC624\uBA74 \uC18C\uC6D0 \uBE48\uB2E4\uB358\uB370. \uB098\uB294 \uBC8C\uC368 \uBE4C\uC5C8\uB2E4. \uB9D0\uC740 \uC548 \uD574 \uC904 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407052
    m_Localized: "\uC1A1\uC608\uC9C0: \uB0B4\uC77C \uBB38\uC774 \uC5F4\uB9AC\uBA74, \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC81C\uC77C \uBA3C\uC800 \uB098\uAC08\uAC8C. \uADF8\uB9AC\uACE0 \uB124\uAC00 \uB098\uC62C \uB54C\uAE4C\uC9C0 \uBB38 \uC7A1\uACE0 \uC788\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407053
    m_Localized: "\uCE5C\uAD6C\uAC00 \uB418\uC790\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810789
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uBAA9\uBC1C, \uB0B4\uAC00 \uBC1B\uC740 \uC120\uBB3C \uC911\uC5D0 \uC81C\uC77C \uC88B\uC740 \uAC70\uC57C. \uC9C4\uC2EC\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810788
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD798\uB4E0 \uB0A0\uB3C4, \uAD1C\uCC2E\uC740 \uB0A0\uB3C4 \uC788\uC5C8\uC9C0. \uADF8\uAC8C \uC0AC\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407070
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB\uB208 \uC624\uBA74 \uB9CC\uB098\uC790\uB358 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB294\uB370. \u2026\uC624\uB298\uC740 \uB108\uD76C \uBCF4\uB294 \uAC78\uB85C \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407069
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uCC3D \uCABD\uC73C\uB85C \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407068
    m_Localized: "\uC6B4\uB3D9\uC7A5, \uAD50\uBB38, \uC0AC\uAC70\uB9AC\uC758 \uC2E0\uD638\uB4F1\uAE4C\uC9C0. \uBAA8\uB4E0 \uAC83\uC774 \uD558\uC597\uAC8C \uB36E\uC5EC \uC788\uC5C8\uB2E4. \uBD89\uC740 \uD45C\uC2DC\uB3C4, \uBC1C\uC790\uAD6D\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407067
    m_Localized: "\uC544\uCE68\uC5D0 \uCC3D\uBC16\uC774 \uC774\uC0C1\uD558\uAC8C \uBC1D\uC558\uB2E4. \uCCAB\uB208\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407066
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC744 \uB05D\uAE4C\uC9C0 \uC5F4\uC5B4 \uB450\uACE0, \uBA3C\uC800 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407054
    m_Localized: "{0}: \uB2E4\uC74C\uC5D4 \uBB38 \uC55E\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uB294 \uAC70 \uB9D0\uACE0. \uADF8\uB0E5 \uAC19\uC774 \uB098\uAC00\uC790. \uCE5C\uAD6C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810778
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544. \uC0B4\uC558\uC73C\uBA74 \uB41C \uAC70\uC57C. \uB098\uBA38\uC9C4 \uB2E4\uC2DC \uC313\uC73C\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810779
    m_Localized: "\uB3C4\uD604\uC740 \uB05D\uAE4C\uC9C0 \uC190\uC804\uB4F1\uC744 \uBD99\uB4E4\uACE0 \uC788\uC5C8\uB2E4. \uB5A8\uB9AC\uB294 \uC190\uC774\uC5C8\uC9C0\uB9CC, \uB193\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407065
    m_Localized: "{0}: \uC5EC\uAE30\uAE4C\uC9C0. \uBBF8\uC6CC\uD558\uC9C0\uB3C4 \uC54A\uACE0, \uAE30\uB2E4\uB9AC\uC9C0\uB3C4 \uC54A\uC744\uAC8C. \uADF8\uAC8C \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uC804\uBD80\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407064
    m_Localized: "\uC5EC\uAE30\uC11C \uB05D\uB0B4\uC790\uACE0 \uD55C\uB2E4. \uAC01\uC790\uC758 \uAE38\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810780
    m_Localized: "\uBD04\uC758 \uB9C8\uC9C0\uB9C9 \uBC24. \uC120\uC0DD\uB2D8\uC774 \uCD9C\uC11D\uBD80 \uB300\uC2E0 \uACF5\uCC45 \uD55C \uAD8C\uC744 \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810781
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: 1\uD559\uAE30 \uC911\uAC04 \uD3C9\uAC00, \uD560\uAC8C. \uB0B4 \uB9C8\uC74C\uB300\uB85C\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407063
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uCC98\uC74C\uC73C\uB85C \uC6C3\uC5C8\uB2E4. \uC791\uACE0, \uC11C\uD230 \uC6C3\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810782
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACF5\uBD80\uB294\u2026 \uC194\uC9C1\uD788 \uB180\uB790\uC5B4. \uC774\uB7F0 \uB370\uC11C\uB3C4 \uB108\uB294 \uACC4\uC18D \uBC30\uC6B0\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407055
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6B8\uBA74\uC11C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810787
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uB054 \uB108\uBB34 \uD63C\uC790 \uACAC\uB514\uB824\uACE0 \uD574. \uAE30\uB300\uB3C4 \uB3FC. \uB098\uB77C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810786
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uB108\uB294\u2026 \uC798 \uC6C3\uAC8C \uB410\uC5B4. \uADF8\uAC8C \uC81C\uC77C \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407056
    m_Localized: "\uB9D0\uC5C6\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407057
    m_Localized: "\uADF8\uAC78\uB85C \uCDA9\uBD84\uD588\uB2E4. \uCC3D\uBC16\uC5D0 \uB208\uC774 \uB0B4\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810783
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACF5\uBD80\uB294 \uAFB8\uC900\uD588\uC5B4. \uD558\uB8E8\uB3C4 \uAC70\uB974\uC9C0 \uC54A\uC740 \uC0AC\uB78C\uCC98\uB7FC \uBCF4\uC774\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407062
    m_Localized: "{0}: \uB2E4\uC2DC \uB9CC\uB098. \uADF8\uB54C\uB294 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uD558\uC790. \uAC19\uC740 \uBC18 \uC560\uB4E4\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810784
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACF5\uBD80\uBCF4\uB2E4 \uC0B4\uC544\uB0A8\uB294 \uAC8C \uBA3C\uC800\uC600\uC9C0. \uADF8\uAC78 \uD0D3\uD560 \uC0AC\uB78C\uC740 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810785
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAB8\uB3C4 \uB2E8\uB2E8\uD574\uC84C\uC5B4. \uCC98\uC74C \uCC3D\uACE0 \uBB38 \uC5F4\uC5C8\uC744 \uB54C\uB791 \uAC78\uC74C\uC774 \uB2EC\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810805
    m_Localized: "{0}: \uADF8\uB798\uB3C4 \uC624\uC168\uC796\uC544\uC694. \uADF8\uAC70\uBA74 \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406991
    m_Localized: "\uC900\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uD615\uB4E4\uC774\uB791 \uB0A8\uACA0\uB2E4\uACE0 \uD588\uB2E4. \uC5EC\uAE30\uAC00 \uC790\uAE30 \uB3D9\uB124\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406992
    m_Localized: "\uC0AC\uAC70\uB9AC \uCABD\uC744 \uD55C \uBC88 \uBC14\uB77C\uBCF4\uC558\uB2E4. \uC774 \uB3D9\uB124\uC758 \uACA8\uC6B8\uC774 \uB05D\uB098 \uAC00\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810804
    m_Localized: "\uADF8\uB0A0 \uC598\uAE30\uB97C \uB354 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810803
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC8FC\uC77C\uC774\uB098 \uAC78\uB838\uB124. \uBBF8\uC548\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406993
    m_Localized: "\uBB34\uC804\uAE30\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC5B4\uB518\uAC00 \uB4E4\uB72C, \uADF8\uB7EC\uBA74\uC11C\uB3C4 \uC9C0\uCE5C \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406994
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD. \uC6B0\uB9AC \uB5A0\uB09C\uB2E4. \uB0A8\uCABD\uC73C\uB85C. UBC \uCABD\uC5D0\uC11C \uAD6C\uC870 \uACBD\uB85C \uC815\uBCF4\uAC00 \uC654\uC5B4. \uAC70\uAE30\uC11C \uB2E4\uB978 \uD5EC\uAE30\uB97C \uAE30\uB2E4\uB9AC\uAE30\uB85C \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407579
    m_Localized: "\uC0DD\uAC01\uBCF4\uB2E4 \uC798 \uB098\uC654\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810888
    m_Localized: "3\uBC88\uC740 \uD2C0\uB9B0 \uAC83 \uAC19\uC558\uB2E4. 7\uBC88\uC740 \uC218\uC5C5 \uB54C \uC120\uC0DD\uB2D8\uC774 \uB450 \uBC88 \uB9D0\uD55C \uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212942
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984\uC774\uB124. \uBC8C\uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212943
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310\uC5D0 \uD559\uAD50 \uD3C9\uBA74\uB3C4\uB97C \uADF8\uB838\uB2E4. \uBD84\uD544\uC774 \uBA87 \uBC88\uC774\uB098 \uBD80\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406995
    m_Localized: "\uC815 \uBC18\uC7A5: \u2026\uADF8\uB0A0 \uC77C\uC740 \uC11C\uC6B4\uD588\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uC0B4\uC544 \uC788\uC73C\uB2C8\uAE4C. \uC798 \uC9C0\uB0B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406996
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB0A0 \uCC3D\uACE0 \uC9C0\uCF1C \uC900 \uAC70, \uC6B0\uB9AC \uC2DD\uAD6C\uB4E4 \uB2E4 \uAE30\uC5B5\uD574. \uB108\uB294 \uC6B0\uB9AC \uC740\uC778\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406997
    m_Localized: "\uC815 \uBC18\uC7A5: \uD2B8\uB7ED\uC5D0 \uB2E4 \uC548 \uC2E4\uB824\uC11C \uADF8\uB7EC\uB294\uB370, \uB0A8\uC740 \uAC70 \uAD50\uBB38 \uC55E\uC5D0 \uB450\uACE0 \uAC08\uAC8C. \uC300 \uC870\uAE08\uC774\uB791 \uC5F0\uB8CC \uD55C \uD1B5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213347
    m_Localized: "\uC790\uC7AC\uB97C \uC368\uC11C \uAD50\uBB38\uACFC \uB2F4\uC7A5\uC744 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406998
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC758 \uD2B8\uB7ED\uC774 \uD559\uAD50 \uC55E\uC744 \uCC9C\uCC9C\uD788 \uC9C0\uB098\uAC14\uB2E4. \uC9D0\uCE78\uC758 \uC5B4\uB978\uB4E4\uC774 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406999
    m_Localized: "\uB0A8\uACA8 \uC900 \uBB3C\uC790\uC5D0 \uACE0\uB9D9\uB2E4\uACE0 \uBB34\uC804\uC744 \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407000
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC\uC694. \uB0A8\uCABD\uC5D0\uC11C \uB2E4\uC2DC \uB9CC\uB098\uC694. \uAF2D\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407001
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798. \uADF8\uB54C \uACE0\uAE30 \uD55C \uBC88 \uB354 \uAD7D\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407002
    m_Localized: "\uC190\uC744 \uD754\uB4E4\uC5B4 \uBC30\uC6C5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407257
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB124 \uC77C\uAE30, \uD55C \uBC88\uB9CC \uC77D\uC5B4 \uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407256
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB0B4 \uC190\uB4F1\uC744 \uB450\uB4DC\uB838\uB2E4. \uCC9C\uCC9C\uD788, \uBC15\uC790\uC5D0 \uB9DE\uCD94\uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407445
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC774 \uD558\uB098\uB3C4 \uC5C6\uB124\u2026. \uB2E4\uC74C\uC5D0 \uB098\uAC00\uBA74 \uBD95\uB300\uB4E0 \uC18C\uB3C5\uC57D\uC774\uB4E0, \uBCF4\uC774\uB294 \uAC74 \uAF2D \uCC59\uACA8 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810802
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uCC3D\uACE0\uB294 \uB9C8\uC9C0\uB9C9 \uB0A0\uC5D0\uC57C \uAC14\uC5B4. \uAC70\uAE30 \uB204\uAC00 \uC788\uC744 \uAC70\uB77C\uACE0\uB294\u2026 \uC0DD\uAC01\uC744 \uBABB \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407255
    m_Localized: "\uC544\uBB34 \uB9D0\uB3C4 \uBABB \uD558\uACE0 \uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213348
    m_Localized: "\uBC24\uB2A6\uAC8C\uAE4C\uC9C0 \uCCA0\uC870\uB9DD\uC744 \uB367\uB300\uACE0 \uAE61\uD1B5\uC744 \uB9E4\uB2EC\uC558\uB2E4. \uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uAE61\uD1B5\uC774 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213349
    m_Localized: "\uB2A6\uC5C8\uC9C0\uB9CC \uC2DD\uB7C9\uC744 \uBCF4\uB0B4 \uD654\uD574\uB97C \uCCAD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213350
    m_Localized: "\uD1B5\uC870\uB9BC \uC138 \uAC1C\uC640 \uCABD\uC9C0\uB97C \uC0AC\uAC70\uB9AC \uC815\uB958\uC7A5\uC5D0 \uB450\uACE0 \uC654\uB2E4. '\uD559\uAD50. \uC774\uBC88 \uACA8\uC6B8\uB9CC \uC870\uC6A9\uD788 \uC9C0\uB098\uAC00\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213351
    m_Localized: "\uB2E4\uC74C \uB0A0 \uAD50\uBB38\uC758 \uC885\uC774\uAC00 \uC0AC\uB77C\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407254
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB \uBB38\uC7A5\uC740 \uB124\uAC00 \uC815\uD574. \uAD6D\uC5B4 \uC120\uC0DD\uC774 \uCCAB \uBB38\uC7A5\uAE4C\uC9C0 \uC815\uD574 \uC8FC\uBA74 \uBC18\uCE59\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407253
    m_Localized: "\uAF2D \uC4F0\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407003
    m_Localized: "\uD2B8\uB7ED\uC774 \uC0AC\uAC70\uB9AC\uB97C \uB3CC\uC544 \uC0AC\uB77C\uC9C8 \uB54C\uAE4C\uC9C0 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4. \uB9C8\uD2B8 \uAC04\uD310\uC758 \uBD88 \uAEBC\uC9C4 '\uB354\uBD88\uC5B4' \uAE00\uC790\uAC00 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407004
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uC790\uC804\uAC70 \uD55C \uB300\uAC00 \uBA48\uCDC4\uB2E4. \uB2E4\uB9AC\uB97C \uC0B4\uC9DD \uC800\uB294 \uB0A8\uC790\uC560. \uBBFC\uADDC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407005
    m_Localized: "\uBBFC\uADDC: \uBE5A \uAC1A\uC73C\uB7EC \uC654\uC5B4\uC694. DJ \uB204\uB098\uAC00 \uAF2D \uC9C1\uC811 \uAC00\uB77C\uACE0 \uD574\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810887
    m_Localized: "\uCC45\uC0C1 \uD558\uB098\uB97C \uCC3D\uAC00\uB85C \uC62E\uACA8 \uC549\uC558\uB2E4. \uC5F0\uD544 \uAE4E\uB294 \uC18C\uB9AC\uAC00 \uC774\uB807\uAC8C \uD070 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810886
    m_Localized: "\uC9C4\uC9C0\uD558\uAC8C \uC2DC\uD5D8\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407006
    m_Localized: "\uADF8\uAC00 \uC9D0\uBC1B\uC774\uC758 \uC0C1\uC790\uB97C \uB0B4\uB824\uB193\uC558\uB2E4. \uC57D\uD488\uACFC \uD1B5\uC870\uB9BC\uC774 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407007
    m_Localized: "\uBBFC\uADDC: \uADF8\uB0A0 \uBC30\uC218\uB85C\uC5D0\uC11C\u2026 \uC9C4\uC9DC \uB05D\uC778 \uC904 \uC54C\uC558\uAC70\uB4E0\uC694. \uACE0\uB9C8\uC6CC\uC694. \uADF8 \uB9D0 \uC9C1\uC811 \uD558\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407008
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4, \uC88B\uC740 \uC18C\uC2DD\uC774\uC5D0\uC694. \uAD6C\uC870\uB300\uB791 \uC6B0\uB9AC \uCC44\uB110\uC744 \uC5F0\uACB0\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810801
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uB4A4\uB85C\uB294 \uAE30\uC5B4\uC11C \uB2E4\uB154\uC5B4. \uBCF4\uAC74\uC2E4, \uAD50\uBB34\uC2E4, \uBCF8\uAD00 \uCC3D\uACE0. \uD558\uB8E8\uC5D0 \uD55C \uACF3\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810800
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD37C\uC9C0\uAE30 \uC804\uC5D0 \uB05D\uB0B4\uC57C \uD55C\uB2E4\uB294 \uC0DD\uAC01\uBFD0\uC774\uC5C8\uC5B4. \uBCF4\uAC74\uC2E4\uC774 \uAC00\uAE4C\uC6CC\uC11C \uB2E4\uD589\uC774\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213352
    m_Localized: "\uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uACE0 \uD560 \uC77C\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213353
    m_Localized: "\uC885\uC774\uB97C \uB5BC\uC5B4 \uBD88\uC3D8\uC2DC\uAC1C\uB85C \uC37C\uB2E4. \uC190\uC740 \uB5A8\uB838\uC9C0\uB9CC, \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C\uB3C4 \uBD88\uC740 \uBD99\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407009
    m_Localized: "DJ: \uAD6C\uC870\uB300\uAC00 \uC0C8\uBCBD\uC2DC \uC0DD\uC874\uC790 \uBA85\uB2E8\uC744 \uBC1B\uB294\uB300\uC694. \uBB34\uC804\uC73C\uB85C \uC774\uB984\uC744 \uBD88\uB7EC \uC8FC\uBA74, \uADF8\uB300\uB85C \uC62C\uB77C\uAC04\uB300\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407010
    m_Localized: "DJ: \uADF8\uB9AC\uACE0\u2026 \uB0B4\uAC00 \uC0C8\uBCBD\uACE0 \uC774\uB984, \uC81C\uC77C \uBA3C\uC800 \uBD88\uB7EC \uC92C\uC5B4\uC694. \uD559\uAD50\uC5D0 \uD559\uC0DD\uB4E4\uC774 \uC788\uB2E4\uACE0. \uC120\uC0DD\uB2D8\uB3C4 \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407011
    m_Localized: "\uC6B0\uB9AC \uBAA8\uB450\uC758 \uC774\uB984\uC744 \uD558\uB098\uC529 \uBD88\uB7EC \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407012
    m_Localized: "\uD55C \uC0AC\uB78C\uC529 \uC774\uB984\uC744 \uBD88\uB800\uB2E4. \uB9C8\uC9C0\uB9C9\uC5D0 \uB0B4 \uC774\uB984\uC744 \uBD88\uB800\uB2E4. \uBAA9\uC774 \uBA54\uC5B4\uC11C \uB450 \uBC88 \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407013
    m_Localized: "\uC120\uC0DD\uB2D8 \uC774\uB984\uC744 \uBD80\uB97C \uCC28\uB840\uC5D0\uC11C, \uC7A0\uAE50 \uBA48\uCDC4\uB2E4. \uADF8\uB9AC\uACE0 \uBD88\uB800\uB2E4. \uC724\uC601\uD604."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407014
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0\uB9CC \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407252
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB204\uAC00 \uBB34\uC5C7\uC744 \uC54C\uACE0 \uC788\uC5C8\uB294\uC9C0, \uC6B0\uB9AC\uAC00 \uC5B4\uB5BB\uAC8C \uBC84\uD17C\uB294\uC9C0. \uADF8\uB9AC\uACE0 \uB124\uAC00 \uC5B4\uB5BB\uAC8C \uCEF8\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407251
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 1\uB144\uC744 \uAE00\uB85C \uB0A8\uACA8 \uC918. \uC798 \uC4F0\uB824\uACE0 \uD558\uC9C0 \uB9D0\uACE0, \uC788\uC5C8\uB358 \uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407250
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD80\uD0C1\uC774 \uD558\uB098 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407015
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC\uC694. \uC815\uB9D0\uB85C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407016
    m_Localized: "DJ: \uB098\uC911\uC5D0 \uC9C1\uC811 \uB9CC\uB098\uC11C \uD574\uC694, \uADF8 \uB9D0. \uC18C\uBCF4\uB85C \uBE75 \uC0AC \uC904\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407017
    m_Localized: "DJ: \uB3C4\uD604 \uD559\uC0DD, \uAC70\uAE30 \uC788\uC5B4\uC694? \u2026\uCC3E\uC558\uC5B4\uC694. \uCCB4\uC721\uACF5\uC6D0\uC5D0\uC11C \uB118\uC5B4\uC628 \uC0AC\uB78C\uB4E4 \uBA85\uB2E8\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407018
    m_Localized: "\uBB34\uC804\uAE30 \uB108\uBA38\uAC00 \uC7A0\uAE50 \uC870\uC6A9\uD588\uB2E4. \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C, \uC228 \uACE0\uB974\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407019
    m_Localized: "???: \u2026\uB3C4\uD604\uC544. \uC5C4\uB9C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810799
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBD95\uB300 \uB05D\uC744 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4. \uBB34\uB98E \uC544\uB798, \uBE44\uC5B4 \uC788\uB294 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213354
    m_Localized: "\uBC24, \uAD50\uBB38 \uCABD\uC5D0\uC11C \uC2E0\uC74C \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC190\uC804\uB4F1\uC744 \uBE44\uCD94\uC790 \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uC544\uC774\uAC00 \uB2F4\uC7A5 \uC544\uB798 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213355
    m_Localized: "\uB3C4\uD604 \uB610\uB798, \uC544\uB2C8\uBA74 \uB354 \uC5B4\uB838\uB2E4. \uC6B0\uBE44 \uC18C\uB9E4\uAC00 \uC816\uC5B4 \uC788\uC5C8\uB2E4. \uC720\uB9AC\uC5D0 \uB2E4\uB9AC\uB97C \uBCA0\uC600\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213356
    m_Localized: "\uC900: \u2026\uD615\uB4E4\uC774 \uB450\uACE0 \uAC14\uC5B4\uC694. \uB530\uB77C\uC624\uB2E4 \uB118\uC5B4\uC84C\uB294\uB370, \uC544\uBB34\uB3C4 \uC548 \uB3CC\uC544\uBD24\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810885
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uD5D8 \uC2DC\uAC04\uC740 \uC624\uC2ED \uBD84. \uBD80\uC815\uD589\uC704\uB294\u2026 \uBCFC \uC0AC\uB78C\uC774 \uC5C6\uC73C\uB2C8 \uBBFF\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810769
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC549\uC544\uC11C\uB3C4 \uBCFC \uC218 \uC788\uC5B4. \uC878\uBA74 \uAE68\uC6CC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213357
    m_Localized: "\uC900: \uC800 \uC0AC\uAC70\uB9AC \uD30C \uB9DE\uC544\uC694. \uADFC\uB370 \uC544\uBB34\uAC83\uB3C4 \uC548 \uD6D4\uCCE4\uC5B4\uC694. \uC9C4\uC9DC\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213358
    m_Localized: "\uBCF4\uAC74\uC2E4\uB85C \uB370\uB824\uAC00 \uC0C1\uCC98\uB97C \uCE58\uB8CC\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213359
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uC5C6\uC774 \uC18C\uB3C5\uC57D\uC744 \uAEBC\uB0C8\uB2E4. \uC900\uC774 \uC774\uB97C \uC545\uBB34\uB294 \uB3D9\uC548 \uC190\uC744 \uC7A1\uC544 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213360
    m_Localized: "\uBC30\uC6B4 \uB300\uB85C \uC9C0\uD608\uD558\uACE0, \uC18C\uB3C5\uD558\uACE0, \uAC10\uC558\uB2E4. \uC900\uC774 \uC6B8\uC74C\uC744 \uCC38\uB290\uB77C \uC5B4\uAE68\uB97C \uB5A8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213361
    m_Localized: "\uC544\uCE68\uC5D0 \uC900\uC740 \uC6B0\uBE44\uB97C \uBC97\uC5B4 \uB450\uACE0 \uAC14\uB2E4. \uC6B0\uBE44 \uC8FC\uBA38\uB2C8\uC5D0 \uC0AC\uD0D5 \uD558\uB098\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4. \uACE0\uB9D9\uB2E4\uB294 \uB9D0 \uB300\uC2E0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810798
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2E4 \uB204\uAD70\uAC00 \uB0B4 \uB2E4\uB9AC\uB97C \uBD99\uC7A1\uC558\uC5B4. \uADF8\uB2E4\uC74C \uC77C\uC740\u2026 \uC9C0\uAE08\uB3C4 \uC18C\uB9AC\uB85C\uB9CC \uAE30\uC5B5\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407020
    m_Localized: "\uB3C4\uD604\uC774 \uBB34\uC804\uAE30\uB97C \uB450 \uC190\uC73C\uB85C \uBD99\uC7A1\uC558\uB2E4. \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4. \uC785\uB9CC \uC5F4\uB838\uB2E4 \uB2EB\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407021
    m_Localized: "???: \uB3C4\uC2DC\uB77D \uB2E4 \uBA39\uC5C8\uC5B4? \uADF8\uB0A0 \uC2F8 \uC900 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213318
    m_Localized: "{0}: \uCC3D\uACE0 \uD138\uBA74 \uB9C8\uD2B8\uB3C4 \uD559\uAD50\uB3C4 \uACA8\uC6B8 \uBABB \uB098\uC694. \uADF8\uB7FC \uC0AC\uAC70\uB9AC\uB294 \uB2E4\uC74C \uACA8\uC6B8 \uB204\uAD6C\uD55C\uD14C\uC11C \uBC1B\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213317
    m_Localized: "\uC0AC\uAC70\uB9AC\uB85C \uCC3E\uC544\uAC00 \uC624 \uC528\uC640 \uAC15\uCCA0 \uC0AC\uC774\uC5D0\uC11C \uB2F4\uD310\uC744 \uC9D3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407566
    m_Localized: "{0}\uAC00 \uD734\uB300\uD3F0 \uD654\uBA74\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uC6B4\uC138 \uC571\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407565
    m_Localized: "{0}: \uACB0\uACFC \uB098\uC654\uB2E4. \uC74C\u2026 \uB0B4\uAC00 \uC0DD\uAC01\uD55C \uB108\uB791 \uAC70\uC758 \uAC19\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213316
    m_Localized: "\uADF8\uB798\uB3C4 \uCC3D\uACE0\uB294 \uC9C0\uCF30\uB2E4. \uC815 \uBC18\uC7A5\uC774 \uB0B4 \uD314\uC5D0 \uBD95\uB300\uB97C \uAC10\uC73C\uBA70 \uC774\uB97C \uC545\uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213315
    m_Localized: "\uC154\uD130\uAC00 \uBC00\uB824 \uC62C\uB77C\uAC14\uB2E4. \uBAB8\uC2F8\uC6C0 \uB05D\uC5D0 \uB204\uAD70\uAC00 \uD718\uB450\uB978 \uC1E0\uD30C\uC774\uD504\uC5D0 \uD314\uC744 \uB9DE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406927
    m_Localized: "\uAC15\uCCA0: \uC6B0\uB9B0 \uC548 \uD0C4\uB2E4. \uAC10\uC5FC \uAC80\uC0AC \uD1B5\uACFC\uD560 \uB188\uC774 \uBA87 \uC5C6\uAC70\uB4E0. \uADF8\uB9AC\uACE0\u2026 \uC5EC\uAE30\uAC00 \uC6B0\uB9AC \uB3D9\uB124\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212929
    m_Localized: "\uC544\uAEF4 \uB450\uACE0, \uC624\uB298\uC740 \uBB3C\uB9CC \uD55C \uC794 \uB354 \uB9C8\uC2E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212928
    m_Localized: "\uB540\uC744 \uD758\uB9AC\uBA70 \uBA39\uC5C8\uB2E4. \uC5EC\uB984\uC774\uB77C\uC11C\uC778\uC9C0, \uB530\uB73B\uD574\uC11C\uC778\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407268
    m_Localized: "\uC591\uB3D9\uC774 \uAC00\uB4DD \uB208\uC744 \uD37C \uC654\uB2E4. \uB179\uC774\uB2C8 \uC0DD\uAC01\uBCF4\uB2E4 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407269
    m_Localized: "\uC218\uB3C4\uAD00\uC774 \uC5BC\uC5B4 \uD130\uC84C\uB2E4. \uAE09\uC2DD\uC2E4 \uBC14\uB2E5\uC774 \uC5BC\uC74C\uD310\uC774 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407022
    m_Localized: "\uB3C4\uD604: \u2026\uB2E4 \uBA39\uC5C8\uC5B4. \uC5C4\uB9C8. \uB2E4 \uBA39\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213362
    m_Localized: "\uBA39\uC744 \uAC83\uC744 \uC950\uC5EC \uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810770
    m_Localized: "\uC790\uC815 \uBB34\uB835, \uD559\uAD50 \uC804\uCCB4\uAC00 \uC6B8\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC6B4\uB3D9\uC7A5 \uCABD\uC5D0\uC11C, \uBCF5\uB3C4\uC5D0\uC11C, \uACC4\uB2E8\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810771
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC5B4\uB098. \uC9C0\uAE08. \uBB38 \uCABD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213363
    m_Localized: "\uD1B5\uC870\uB9BC \uB450 \uAC1C\uB97C \uC950\uC5EC \uC8FC\uC5C8\uB2E4. \uC900\uC740 \uBA87 \uBC88\uC774\uB098 \uB3CC\uC544\uBCF4\uBA70 \uC0AC\uAC70\uB9AC \uCABD\uC73C\uB85C \uC808\uB69D\uC774\uBA70 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213364
    m_Localized: "\uCAD3\uC544\uB0B8\uB2E4. \uC0AC\uAC70\uB9AC \uD30C\uB294 \uC0AC\uAC70\uB9AC \uD30C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407023
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB3C4\uD604\uC740 \uBB34\uC804\uAE30\uB97C \uC548\uACE0 \uC7A4\uB2E4. \uC544\uBB34\uB3C4 \uB044\uB77C\uACE0 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407024
    m_Localized: "DJ: \uC0C8\uBCBD\uC2DC \uC5B4\uB518\uAC00\uC5D0\uC11C \uC544\uC9C1 \uAE68\uC5B4 \uC788\uB294 \uC5EC\uB7EC\uBD84. \uC624\uB298\uC774 \uC81C \uB9C8\uC9C0\uB9C9 \uC815\uADDC \uBC29\uC1A1\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407025
    m_Localized: "DJ: \uAD6C\uC870\uAC00 \uC2DC\uC791\uB418\uBA74, \uC800\uB3C4 \uC774 \uB9C8\uC774\uD06C\uB97C \uB044\uACE0 \uC904\uC744 \uC11C\uC57C \uD558\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407026
    m_Localized: "DJ: \uC624\uB298\uC758 \uC2E0\uCCAD\uACE1\uC740\u2026 \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC5D0\uC11C \uB4E4\uC5B4\uC628 \uAC70\uC608\uC694. \uBA87 \uB2EC \uC804\uC5D0 '\uC2E0\uB098\uB294 \uAC78\uB85C'\uB77C\uACE0 \uD588\uB358."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213365
    m_Localized: "{0}: \uAC00. \uB2E4\uC2DC\uB294 \uC624\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213366
    m_Localized: "\uC900\uC774 \uC77C\uC5B4\uB098 \uBE44\uD2C0\uAC70\uB9AC\uBA70 \uC5B4\uB460 \uC18D\uC73C\uB85C \uC0AC\uB77C\uC84C\uB2E4. \uADF8 \uB4B7\uBAA8\uC2B5\uC774, \uCC3D\uACE0 \uBB38 \uC55E\uC5D0 \uC11C \uC788\uB358 \uB204\uAD70\uAC00\uCC98\uB7FC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213367
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uC2DC\uD0A4\uC9C0 \uC54A\uC740 \uC77C\uC744 \uD588\uB2E4. \uD654\uC7A5\uC2E4 \uCCAD\uC18C, \uC4F0\uB808\uAE30 \uBB3B\uAE30, \uC591\uB3D9\uC774 \uB098\uB974\uAE30. \uC81C\uC77C \uB354\uB7FD\uACE0 \uC81C\uC77C \uBB34\uAC70\uC6B4 \uAC83\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213368
    m_Localized: "\uC544\uBB34\uD558\uACE0\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uBC25\uB3C4 \uC81C\uC77C \uB9C8\uC9C0\uB9C9\uC5D0, \uAD6C\uC11D\uC5D0\uC11C \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810772
    m_Localized: "\uCCA0\uBB38\uC774 \uC548\uCABD\uC73C\uB85C \uD718\uC5C8\uB2E4. \uC218\uC2ED \uAC1C\uC758 \uBC1C\uC18C\uB9AC\uAC00 \uD55C\uAEBC\uBC88\uC5D0 \uBAB0\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407249
    m_Localized: "\uBE48 \uC758\uC790 \uD558\uB098\uD558\uB098\uC5D0 \uB204\uAD70\uAC00\uAC00 \uC549\uC544 \uC788\uC5C8\uC744 \uAC83\uC774\uB2E4. \uADF8 \uC0AC\uB78C\uB4E4\uC744 \uC0DD\uAC01\uD558\uBA70 \uD55C\uCC38 \uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810797
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uACFC \uD6C4\uC600\uC5B4. \uAD50\uBB38\uC73C\uB85C \uC0AC\uB78C\uB4E4\uC774 \uBC00\uB824 \uB4E4\uC5B4\uC654\uACE0, \uC6B0\uB9AC\uB294 \uCCB4\uC721\uAD00 \uCABD\uC73C\uB85C \uC548\uB0B4\uD558\uACE0 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810796
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uC598\uAE30, \uD55C \uBC88\uB3C4 \uC548 \uD588\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407248
    m_Localized: "\uBE48 \uC758\uC790\uB4E4 \uC0AC\uC774\uC5D0 \uC870\uC6A9\uD788 \uC549\uC544 \uC788\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810773
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uBC84\uD17C\uB2E4. \uB9C8\uC9C0\uB9C9 \uD55C \uB9C8\uB9AC\uAC00 \uBB38\uD2C8\uC5D0\uC11C \uBC00\uB824\uB098\uAC08 \uB54C\uAE4C\uC9C0 \uB458\uC740 \uB4F1\uC744 \uB9DE\uB300\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213369
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uD558\uB9B0 \uCABD\uC744 \uBA87 \uBC88 \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4. \uD55C\uB54C \uB458\uC740 \uB298 \uBD99\uC5B4 \uB2E4\uB154\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213370
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213371
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC. \uD654\uC7A5\uC2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213372
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uBA48\uCE6B\uD588\uB2E4. \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uADF8\uB0A0 \uC800\uB141\uC5D4 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uACFC \uAC19\uC740 \uC2DC\uAC04\uC5D0 \uBC25\uC744 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407247
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB108\uD76C\uB294 \uC774 \uD559\uAD50\uC758 \uB9C8\uC9C0\uB9C9 \uD559\uAE30\uB97C \uB05D\uAE4C\uC9C0 \uB2E4\uB154\uB2E4. \uADF8\uAC78\uB85C \uCDA9\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810795
    m_Localized: "\uBD88\uC744 \uB044\uAE30 \uC804, \uC120\uC0DD\uB2D8\uC774 \uBD95\uB300\uB97C \uAC08\uB2E4\uAC00 \uC190\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810794
    m_Localized: "\u2014 1\uB9C9 \xB7 \uC0DD\uC874, \uB05D \u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407027
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C \uC2E0\uB098\uB294 \uB178\uB798\uAC00 \uD758\uB800\uB2E4. \uB2E4\uB4E4 \uCC98\uC74C\uC5D4 \uAC00\uB9CC\uD788 \uB4E3\uB2E4\uAC00, \uD558\uB098\uB458 \uBC1C\uB85C \uBC15\uC790\uB97C \uB9DE\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810793
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 \uAC19\uC774 \uAC00 \uBCF4\uC790. \uB2E4\uC74C \uD559\uAE30\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213373
    m_Localized: "\uAC19\uC774 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213374
    m_Localized: "\uC591\uB3D9\uC774 \uD55C\uCABD \uC190\uC7A1\uC774\uB97C \uC7A1\uC558\uB2E4. \uB458\uC774\uC11C \uB9D0\uC5C6\uC774 \uC6B4\uB3D9\uC7A5\uC744 \uAC00\uB85C\uC9C8\uB800\uB2E4. \uBB34\uAC70\uC6B4 \uAC74 \uBC18\uC73C\uB85C \uB098\uB258\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213375
    m_Localized: "\uADF8\uB0E5 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810792
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984\uC774 \uC640. \uB365\uACE0, \uAE38\uACE0, \uC544\uB9C8 \uB354 \uD798\uB4E4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407028
    m_Localized: "DJ: \uB0B4\uC77C\uB3C4 \uC0B4\uC544 \uC788\uC5B4\uC694. \uADF8\uAC8C \uC624\uB298\uC758, \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9 \uC219\uC81C\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407029
    m_Localized: "\uBC24. \uB3C4\uD604\uC774 \uAC00\uBC29\uC744 \uB2E4 \uC2F8 \uB193\uACE0\uB3C4 \uC7A0\uB4E4\uC9C0 \uBABB\uD558\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407030
    m_Localized: "\uB3C4\uD604: \uB204\uB098. \uAD6C\uC870\uB418\uBA74 \uC5C4\uB9C8\uD55C\uD14C \uBA3C\uC800 \uAC00\uC694. \uADFC\uB370 \uADF8\uB2E4\uC74C\uC5D4\u2026 \uB204\uB098 \uC5B4\uB514 \uC788\uB294\uC9C0 \uAF2D \uC54C\uB824 \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407031
    m_Localized: "\uB3C4\uD604: \uB204\uB098. \uAD6C\uC870\uB418\uBA74 \uC5C4\uB9C8 \uCC3E\uC744 \uAC70\uC608\uC694. \uCC3E\uC744 \uB54C\uAE4C\uC9C0. \uB204\uB098\uAC00 \uADF8\uB7AC\uC796\uC544\uC694. \uAE38 \uC798 \uCC3E\uB294 \uC0AC\uB78C\uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810774
    m_Localized: "\uC0C8\uBCBD, \uBC1C\uC18C\uB9AC\uAC00 \uC7A6\uC544\uB4E4\uC5C8\uB2E4. \uC724 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4. \uCC98\uC74C \uBCF4\uB294, \uC9C0\uCE5C \uC6C3\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407032
    m_Localized: "\uB3C4\uD604: \uB204\uB098 \uC5C6\uC5C8\uC73C\uBA74 \uC800 \uADF8 \uC9D1 \uBB38 \uC55E\uC5D0\uC11C \uADF8\uB0E5 \uC788\uC5C8\uC744 \uAC70\uC608\uC694. \uBB38 \uB450\uB4DC\uB9AC\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407033
    m_Localized: "\uAF2D \uB2E4\uC2DC \uB9CC\uB098\uC790\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407034
    m_Localized: "\uC0C8\uB07C\uC190\uAC00\uB77D\uC744 \uAC78\uC5C8\uB2E4. \uB3C4\uD604\uC774 \uC5C4\uC9C0\uB85C \uB3C4\uC7A5\uAE4C\uC9C0 \uCC0D\uC5C8\uB2E4. \uCD08\uB4F1\uD559\uC0DD\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407035
    m_Localized: "\uC544\uB07C\uB358 \uC190\uC804\uB4F1\uC744 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407036
    m_Localized: "{0}: \uC774\uAC70 \uAC00\uC838\uAC00. \uC5B4\uB450\uC6B4 \uB370 \uAC00\uBA74 \uCF1C. \uADF8\uB9AC\uACE0 \uB098 \uC0DD\uAC01\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406926
    m_Localized: "\uAC15\uCCA0: \uAD6C\uC870\uB300 \uC628\uB2E4\uBA70. \uBC29\uC1A1 \uB4E4\uC5C8\uB2E4. \uCD95\uD558\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406925
    m_Localized: "\uB208 \uC313\uC778 \uAD50\uBB38 \uC55E\uC5D0 \uAC15\uCCA0\uC774 \uD63C\uC790 \uC11C \uC788\uC5C8\uB2E4. \uBD80\uD558\uB3C4, \uC6B0\uBE44\uB3C4 \uC5C6\uC774. \uB450\uAEBC\uC6B4 \uC810\uD37C \uCC28\uB9BC\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406924
    m_Localized: "\uCC3D\uACE0 \uBB38\uC744 \uC5F4\uC5B4 \uBCF4\uC600\uB2E4. \uADF8\uB4E4\uC740 \uD544\uC694\uD55C \uB9CC\uD07C \uCC59\uACA8 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212927
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC8C \uBB34\uC2A8 \uC0BC\uACC4\uD0D5\uC774\uC57C. \u2026\uB9DB\uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212926
    m_Localized: "\uC300 \uD55C \uC90C, \uD1B5\uC870\uB9BC \uD558\uB098, \uB9C8\uB298 \uB300\uC2E0 \uB9C8\uB298 \uAC00\uB8E8. \uAD6D\uBB3C\uC774 \uBF40\uC597\uAC8C \uC6B0\uB7EC\uB0AC\uB2E4. \uBE44\uC2B7\uD588\uB2E4. \uC544\uC8FC \uC870\uAE08."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407037
    m_Localized: "\uB3C4\uD604\uC774 \uC190\uC804\uB4F1\uC744 \uCF30\uB2E4 \uAED0\uB2E4 \uD558\uBA70 \uC6C3\uC5C8\uB2E4. \uCC9C\uC7A5\uC5D0 \uB3D9\uADF8\uB780 \uBE5B\uC774 \uB5B4\uB2E4 \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407038
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uAC74\uC2E4 \uC57D\uC7A5\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC815\uB9AC\uD558\uACE0 \uC788\uC5C8\uB2E4. \uBE48 \uCE78\uC774 \uB354 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407039
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC774 \uC57D\uC7A5, \uCC98\uC74C \uC5F4\uC5C8\uC744 \uB54C \uBD95\uB300 \uB450 \uB864\uC774\uC5C8\uC9C0. \uAE30\uC5B5\uB098?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407040
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC190\uB54C \uBB3B\uC740 \uC218\uCCA9\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uB9E4\uC8FC \uC801\uC740 \uAE30\uB85D. \uCCB4\uC628, \uC0C1\uCC98, \uB0A0\uC528, \uC6B0\uB9AC \uC774\uB984."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407041
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAC00\uC838\uAC00. \uB098\uBCF4\uB2E4 \uB124\uAC00 \uB354 \uC798 \uC4F8 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407042
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uB098\uC911\uC5D0, \uC138\uC0C1\uC774 \uB2E4\uC2DC \uD559\uAD50\uB97C \uC5F4\uBA74\u2026 \uC758\uB300\uB4E0 \uAC04\uD638\uB300\uB4E0 \uC0DD\uAC01\uD574 \uBD10. \uC190\uC774 \uCC28\uBD84\uD55C \uC0AC\uB78C\uC740 \uADC0\uD558\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407043
    m_Localized: "\uB098\uC911\uC5D0 \uBB34\uC5C7\uC774 \uB418\uBA74 \uC88B\uC744\uC9C0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810791
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC544\uC774 \uC77C\uC740\u2026 \uC26C\uC6B4 \uC120\uD0DD\uC774 \uC544\uB2C8\uC5C8\uB2E4\uB294 \uAC70 \uC54C\uC544. \uB108\uBB34 \uC624\uB798 \uBD99\uB4E4\uACE0 \uC788\uC9C4 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810790
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uD604\uC774\uB97C \uB370\uB824\uC628 \uAC74 \uB124 \uC120\uD0DD\uC774\uC5C8\uC5B4. \uADF8 \uC560\uD55C\uD14C\uB3C4, \uB098\uD55C\uD14C\uB3C4 \uD070\uC77C\uC774\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407044
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB50\uAC00 \uB418\uB4E0. \uB2E4\uCE5C \uC0AC\uB78C \uC55E\uC5D0\uC11C \uB3C4\uB9DD \uC548 \uAC00\uB294 \uC0AC\uB78C\uC774\uBA74 \uB3FC. \uB108\uB294 \uC774\uBBF8 \uADF8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407045
    m_Localized: "\uADF8\uB3D9\uC548 \uACE0\uB9C8\uC6E0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407046
    m_Localized: "{0}: \uADF8\uB0A0 \uC190\uB4F1 \uC18C\uB3C5\uD574 \uC8FC\uC2E0 \uAC70\uC694. \uB530\uB054\uD588\uB294\uB370, \uADF8\uAC8C \uC5EC\uAE30\uC11C \uCC98\uC74C \uBC1B\uC740 \uCE58\uB8CC\uC600\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407047
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4. \uC57D\uC7A5 \uBB38\uC5D0 \uC774\uB9C8\uB97C \uC7A0\uAE50 \uB314\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407048
    m_Localized: "\uBC24. \uBCF5\uB3C4 \uB05D \uCC3D\uAC00. \uC1A1\uC608\uC9C0\uB294 \uC624\uB298\uB3C4 \uAC70\uAE30 \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uACBD\uACC4\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407049
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC811\uD78C \uC885\uC774\uB97C \uAEBC\uB0C8\uB2E4. \uADF8\uB54C \uB0B4\uAC00 \uB3CC\uB824\uC92C\uB358 \uD3B8\uC9C0\uC600\uB2E4. \uADC0\uD241\uC774\uAC00 \uB2F3\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407050
    m_Localized: "\uC1A1\uC608\uC9C0: \uC9C1\uC811 \uC904 \uC218 \uC788\uC744 \uB54C \uBC1B\uB294\uB2E4\uACE0 \uD588\uC796\uC544. \u2026\uC9C0\uAE08\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407051
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8 \uD3B8\uC9C0, \uC544\uC9C1 \uAC00\uC9C0\uACE0 \uC788\uC5B4? \u2026\uBC84\uB824\uB3C4 \uB3FC. \uC774\uC81C \uBB38 \uCABD\uC740 \uC548 \uBD10\uB3C4 \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810775
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC\u2026 \uD574\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213376
    m_Localized: "\uADF8 \uC560\uAC00 \uC2A4\uC2A4\uB85C \uC815\uD55C \uBC8C\uC774\uC5C8\uB2E4. \uB07C\uC5B4\uB4E4\uACE0 \uC2F6\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC8C \uC633\uC740\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213377
    m_Localized: "\uBC24, \uD654\uC7A5\uC2E4 \uAC00\uB294 \uAE38\uC5D0 \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC774 \uC870\uAE08 \uC5F4\uB824 \uC788\uB294 \uAC78 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213378
    m_Localized: "\uC548\uC5D0\uC11C \uCD5C\uD558\uB9B0\uC774 \uB9E4\uD2B8 \uC704\uC5D0 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBD88\uC740 \uCF1C\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213379
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC5EC\uAE30 \uB9E4\uC77C \uC640. \uB124\uAC00 \uC788\uB358 \uB370\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213380
    m_Localized: "\uCD5C\uD558\uB9B0: \uBB38 \uB2EB\uD788\uB294 \uC18C\uB9AC, \uB098\uB3C4 \uB4E4\uC5C8\uC5B4. \uADF8\uB0A0 \uBC24\uC5D0 \uC9D1\uC5D0\uC11C. \uC774\uBD88\uC744 \uB4A4\uC9D1\uC5B4\uC368\uB3C4 \uB4E4\uB838\uC5B4. \uC774\uC0C1\uD558\uC9C0. \uB098\uB294 \uBC16\uC5D0 \uC788\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213381
    m_Localized: "\uBB38\uC744 \uC5F4\uC5B4 \uB454 \uCC44 \uC606\uC5D0 \uC549\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213382
    m_Localized: "\uBB38\uC740 \uD65C\uC9DD \uC5F4\uC5B4 \uB450\uC5C8\uB2E4. \uB458\uC774\uC11C \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407325
    m_Localized: "\uBC1C\uAC78\uC74C\uC744 \uC7AC\uCD09\uD588\uB2E4. \uB4A4\uC5D0\uC11C \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407324
    m_Localized: "\uBABB \uBCF8 \uCC99 \uC9C0\uB098\uCE5C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810776
    m_Localized: "\uCC45\uC0C1 \uD558\uB098\uAC00 \uBB34\uB108\uC84C\uB2E4. \uC2DD\uB7C9 \uC0C1\uC790\uAC00 \uC4F0\uB7EC\uC9C0\uACE0, \uB204\uAD70\uAC00\uC758 \uC190\uC774 \uBB38\uD2C8\uC73C\uB85C \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810777
    m_Localized: "\uC5B4\uB5BB\uAC8C \uB9C9\uC558\uB294\uC9C0\uB294 \uC798 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294\uB2E4. \uC815\uC2E0\uC744 \uCC28\uB9AC\uC790 \uC544\uCE68\uC774\uC5C8\uACE0, \uC190\uBC14\uB2E5\uC774 \uC4F0\uB77C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406941
    m_Localized: "\uAD50\uBB38\uC5D0 \uBD89\uC740 \uD398\uC778\uD2B8\uB85C \uD070 \uAE00\uC528\uAC00 \uCE60\uD574\uC838 \uC788\uC5C8\uB2E4. '\uAD6C\uC870 \uC804\uAE4C\uC9C0 \uD559\uAD50\uB97C \uBE44\uC6CC\uB77C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406942
    m_Localized: "\uADF8 \uC544\uB798, \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uBB34\uB9AC\uAC00 \uC11C \uC788\uC5C8\uB2E4. \uAC00\uC6B4\uB370 \uAC15\uCCA0\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406943
    m_Localized: "\uAC15\uCCA0: \uD5EC\uAE30\uB294 \uC625\uC0C1\uC5D0 \uB0B4\uB9B0\uB2E4\uC9C0. \uC625\uC0C1 \uC788\uB294 \uAC74\uBB3C\uC740 \uC774 \uB3D9\uB124\uC5D0 \uC5EC\uAE30\uBFD0\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212933
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4 \uC2DC\uAC04\uC5D0 \uC774\uB7F0 \uC2DC\uB97C \uBC30\uC6E0\uC5B4. \uBE7C\uC557\uAE34 \uB4E4\uC5D0\uB3C4 \uBD04\uC740 \uC624\uB294\uAC00, \uD558\uACE0 \uBB3B\uB294 \uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213324
    m_Localized: "\uBB34\uC804\uAE30\uB97C \uAED0\uB2E4. \uC5F0\uAE30\uB294 \uC624\uD6C4\uAE4C\uC9C0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407570
    m_Localized: "B\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407569
    m_Localized: "{0}: \uD5D0. \uC624\uB298 \uC870\uC2EC\uD574\uB77C \uC9C4\uC9DC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213323
    m_Localized: "\uB07C\uC9C0 \uC54A\uB294\uB2E4. \uD559\uAD50\uB97C \uC9C0\uD0A4\uB294 \uAC8C \uBA3C\uC800\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406950
    m_Localized: "\uAC15\uCCA0\uC774 \uC624\uB798 \uC900\uC744 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC190\uC744 \uB4E4\uC5B4 \uBB34\uB9AC\uB97C \uBB3C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407452
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE68\uB057\uD55C \uCC9C\uC73C\uB85C \uD55C \uBC88 \uAC70\uB974\uACE0, \uB053\uC5EC\uC11C \uC2DD\uD600. \uADF8\uB2E4\uC74C\uC5D0 \uB9C8\uC154."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212935
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2F5\uC740 \uC2DC \uC548\uC5D0 \uC788\uC5B4. \uBD04\uC740 \uC640. \uB4E4\uC744 \uB2E4\uC2DC \uCC3E\uC73C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406949
    m_Localized: "\uC900: \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4\uBA74\uC11C\uC694. \uC800\uB3C4 \uC560\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406948
    m_Localized: "\uC900: \uD615. \uC800 \uD559\uAD50 \uB204\uB098\uAC00 \uC800 \uC0B4\uB838\uC5B4\uC694. \uD615\uB4E4\uC774 \uB450\uACE0 \uAC14\uC744 \uB54C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213322
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB9C8\uD2B8 \uCC3D\uACE0 \uC808\uBC18\uC774 \uD138\uB838\uB2E4\uB294 \uBB34\uC804\uC774 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213321
    m_Localized: "\uB0B4 \uB9D0\uC740 \uC6B0\uBE44\uB4E4\uC758 \uC6C3\uC74C\uC18C\uB9AC\uC5D0 \uBB3B\uD614\uB2E4. \uCAD3\uACA8\uB098\uB4EF \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407568
    m_Localized: "A\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407567
    m_Localized: "{0}: \uC57C, \uC624\uB298 A\uD615 \uC6B4\uC138 \uCD5C\uC545\uC774\uB798. \u314B\u314B \uB108 \uBB34\uC2A8 \uD615\uC774\uC5C8\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406947
    m_Localized: "\uC900\uC774 \uAC15\uCCA0 \uC55E\uC744 \uB9C9\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406946
    m_Localized: "\uBB34\uB9AC \uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uC55E\uC73C\uB85C \uAC78\uC5B4 \uB098\uC654\uB2E4. \uC900\uC774\uC5C8\uB2E4. \uC6B0\uBE44 \uC18C\uB9E4 \uC544\uB798\uB85C \uBD95\uB300 \uC790\uAD6D\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406945
    m_Localized: "\uAC15\uCCA0: \uC77C\uC8FC\uC77C \uC900\uB2E4. \uBE44\uC6B0\uB4E0\uC9C0, \uC9C0\uD0A4\uB4E0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162406944
    m_Localized: "\uAC15\uCCA0: \uC6B0\uB9AC\uB3C4 \uC0B4\uACE0 \uC2F6\uB2E4. \uAC80\uC0AC\uB294 \uC5B4\uB5BB\uAC8C\uB4E0 \uD1B5\uACFC\uD55C\uB2E4. \uADF8\uB7EC\uB2C8 \uADF8\uB0A0 \uC625\uC0C1\uC740 \uC6B0\uB9AC\uAC00 \uC4F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212934
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2DC\uB97C \uB2E4 \uC678\uC6CC \uC74A\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uCC3D\uBC16\uC744 \uBCF4\uBA70 \uD55C \uC904\uB9CC \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013763
    m_Localized: "\uBC84\uD2F0\uC790. \uBB38\uC774 \uC5F4\uB9B4 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013762
    m_Localized: "{0}: \u2026\uB204\uAD70\uAC00 \uC624\uACA0\uC9C0. \uACE7."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013761
    m_Localized: "\uD734\uB300\uD3F0\uC740 \uC2E0\uD638\uAC00 \uC7A1\uD788\uC9C0 \uC54A\uC558\uB2E4. \uAD6C\uC11D\uC5D0 \uB300\uD68C\uC6A9 \uC0DD\uC218 \uBC15\uC2A4\uC640 \uC811\uD78C \uB9E4\uD2B8\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013760
    m_Localized: "\uC190\uC7A1\uC774\uB97C \uB3CC\uB824\uB3C4, \uBB38\uC744 \uB450\uB4DC\uB824\uB3C4, \uB300\uB2F5\uD558\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 312271237824512
    m_Localized: "\uC5B4\uB460. \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC740 \uBC16\uC5D0\uC11C \uC7A0\uACA8 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407061
    m_Localized: "\uC5B8\uC820\uAC00 \uB2E4\uC2DC \uB9CC\uB098\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407060
    m_Localized: "\uCD5C\uD558\uB9B0: \uB098\uB294\u2026 \uB2E4\uC2DC \uB9CC\uB098\uC790\uB294 \uB9D0\uC744 \uD560 \uC790\uACA9\uC774 \uC5C6\uC5B4. \uADF8\uB7EC\uB2C8\uAE4C \uB124\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407059
    m_Localized: "\uCD5C\uD558\uB9B0: \uAD6C\uC870\uB418\uBA74 \uB2E4\uB4E4 \uD769\uC5B4\uC9C0\uACA0\uC9C0. \uB108\uB791 \uB098\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407058
    m_Localized: "\uBC24. \uCD5C\uD558\uB9B0\uC774 \uCCB4\uC721\uCC3D\uACE0 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736451
    m_Localized: "\uB9E4\uD2B8\uB97C \uD3B4\uACE0 \uB204\uC6E0\uB2E4. \uCCB4\uC721\uAD00 \uBC14\uB2E5 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736450
    m_Localized: "{0}: \uB0B4\uC77C\uC740\u2026 \uB204\uAC00 \uC624\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736449
    m_Localized: "{0}: \uC624\uB298\u2026 \uB5A1\uBCF6\uC774 \uBA39\uAE30\uB85C \uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736448
    m_Localized: "\uBC16\uC5D0\uC11C \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uBA40\uC5B4\uC9C0\uB358 \uAC83\uC744 \uAE30\uC5B5\uD55C\uB2E4. \uBB38\uC740 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 315716506238976
    m_Localized: "\uCCAB\uC9F8 \uB0A0. \uD574\uAC00 \uC9C0\uC790 \uBB38\uD2C8\uC758 \uBE5B\uB3C4 \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407551
    m_Localized: "\uBAB0\uB77C. \uD574 \uBCF8 \uC801 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407552
    m_Localized: "{0}: \uADF8\uB7FC \uB0B4\uAC00 \uC989\uC11D\uC73C\uB85C \uD574 \uC904\uAC8C. \uB300\uCDA9 \uB9DE\uC544, \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407553
    m_Localized: "{0}: 1\uBC88. \uC8FC\uB9D0\uC5D0 \uC57D\uC18D\uC774 \uAC11\uC790\uAE30 \uCDE8\uC18C\uB410\uC5B4. \uB108\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407554
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uD55C\uD14C \uC5F0\uB77D\uD574\uC11C \uB098\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214530
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC190\uAC00\uB77D\uC73C\uB85C \uBC14\uB2E5\uC5D0 \uADF8\uB9BC\uC744 \uADF8\uB838\uB2E4. \uACA8\uB4DC\uB791\uC774 \uBC1B\uCE68, \uC190\uC7A1\uC774, \uAE38\uC774. \uC0DD\uAC01\uBCF4\uB2E4 \uC815\uD655\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214529
    m_Localized: "\uC5B4\uB5BB\uAC8C \uB9CC\uB4DC\uB294\uC9C0\uBD80\uD130 \uC54C\uB824 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407555
    m_Localized: "\uC624\uD788\uB824 \uC88B\uC544. \uC9D1\uC5D0\uC11C \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212682
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 \uD55C \uBA85\uC774 \uC878\uC5C5\uD558\uACE0 \uD3B8\uC9C0\uB97C \uBCF4\uB0C8\uC5B4. \uB2E4\uB978 \uAC74 \uB2E4 \uC78A\uC5C8\uB294\uB370 \uADF8 \uAD6C\uC808\uB9CC \uAE30\uC5B5\uB09C\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212681
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB \uBC1C\uB839 \uBC1B\uB358 \uD574\uC5D0 \uAC00\uB974\uCE5C \uC2DC\uC57C. \uADF8\uD574 \uC544\uC774\uB4E4\uC740 \uB2E4 \uC878\uC558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212680
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uB85C \uC9E7\uC740 \uC2DC\uB97C \uC74A\uC5C8\uB2E4. \uBD04\uC774 \uC624\uBA74, \uC774\uB77C\uB294 \uB9D0\uB85C \uC2DC\uC791\uD558\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212679
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uC2DC \uD55C \uAD6C\uC808 \uC54C\uB824 \uC904\uAE4C. \uC218\uC5C5 \uB54C \uC4F0\uB824\uACE0 \uC544\uAEF4 \uB454 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212678
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC0C1\uD558\uC9C0. \uD55C \uBA85\uC744 \uCC3E\uC558\uB294\uB370, \uAF2D \uBC18 \uC804\uCCB4\uB97C \uCC3E\uC740 \uAC83 \uAC19\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212677
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78\uB85C \uCDA9\uBD84\uD558\uB2E4\uB294 \uB4EF \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428456214528
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCC3D\uACE0\uB97C \uC9C0\uD0A4\uB824\uBA74 \uB36B\uC774\uB098 \uACBD\uBCF4 \uAC19\uC740 \uAC83\uB3C4 \uC0DD\uAC01\uD574 \uB46C\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 340428384911360
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2E0\uC911\uD574\uC11C \uC88B\uC544. \uB300\uC2E0 \uBB38 \uCABD \uCC45\uC0C1\uC740 \uB2E8\uB2E8\uD788 \uBB36\uC5B4 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212676
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uC11C \uB0A8\uC558\uC5B4. \uD639\uC2DC \uB0A8\uC740 \uC544\uC774\uAC00 \uC788\uC744\uAE4C \uBD10. \uACB0\uAD6D \uCC3E\uC740 \uAC74 \uB108 \uD558\uB098\uC600\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212675
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uC598\uAE30\uB294, \uC5B8\uC820\uAC00. \uC624\uB298\uC740 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212674
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uCC3D \uCABD\uC744 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212673
    m_Localized: "{0}: \uAC00\uC871\uC740\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212672
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB4E4 \uC544\uC774\uB4E4 \uB370\uB9AC\uB7EC \uC9D1\uC73C\uB85C \uAC14\uC9C0. \uB098\uB294 \uB370\uB9AC\uB7EC \uAC08 \uC0AC\uB78C\uC774 \uC5C6\uC5C8\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212671
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC65C \uD559\uAD50\uC5D0 \uB0A8\uC558\uB0D0\uACE0? \u2026\uADF8\uB0A0 \uAD50\uBB34\uC2E4\uC5D0 \uB0A8\uC740 \uC0AC\uB78C\uC774 \uB098\uBC16\uC5D0 \uC5C6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212670
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uB144 \uC0DD\uC77C\uC5D4, \uCF00\uC774\uD06C\uB85C \uD558\uC790. \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212826
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC7A0 \uC548 \uC640? \uB098\uB3C4. \uC549\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212827
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uB098\uB294 \uBCF4\uAC74\uC2E4\uC5D0 \uC788\uC5C8\uC5B4. \uC5F4\uB098\uB294 \uC560\uB4E4\uC774 \uC904\uC744 \uC130\uC9C0. \uCC98\uC74C\uC5D4 \uB2E4 \uB3C5\uAC10\uC778 \uC904 \uC54C\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407438
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B4\uB514. \uBCF4\uC5EC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212983
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC548 \uAC00\uB3C4 \uB3FC. \uADF8 \uBB38\uC740 \uC6B0\uB9AC\uAC00 \uB2E4\uC2DC \uC5F4 \uD544\uC694 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212982
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uD39C\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212981
    m_Localized: "{0}: \uCCB4\uC721\uAD00 \uCC3D\uACE0\uB294\u2026 \uC548 \uAC00\uB3C4 \uB418\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212980
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uAD00\uC740 \uB113\uACE0 \uBB38\uC774 \uB450\uAEBC\uC6CC. \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE30\uBA74 \uD53C\uD560 \uACF3\uC774 \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212979
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE09\uC2DD\uC2E4, \uB3C4\uC11C\uAD00, \uADF8\uB9AC\uACE0 \uCCB4\uC721\uAD00. \uB0A0\uC774 \uB354 \uB354\uC6CC\uC9C0\uAE30 \uC804\uC5D0 \uB2E4 \uC5F4\uC5B4 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212978
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uD3C9\uBA74\uB3C4\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uB354 \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212977
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC18\uB0A9 \uAE30\uD55C\uC740 \uC5C6\uB2E4. \uCC9C\uCC9C\uD788 \uC77D\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212976
    m_Localized: "{0}: \uC77C\uACF1 \uBC88\uC9F8\uB294 \uB098\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212975
    m_Localized: "\uD45C\uC9C0\uAC00 \uB2F3\uC740 \uCCAD\uC18C\uB144 \uC18C\uC124. \uB300\uCD9C \uCE74\uB4DC\uC5D0 \uC774\uB984\uC774 \uC5EC\uC12F \uAC1C \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212974
    m_Localized: "\uC18C\uC124\uCC45 \uD55C \uAD8C\uC744 \uACE8\uB77C \uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212973
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC219\uC81C \uB9CE\uC774 \uB0B4 \uC904 \uAC70\uB2E4. \uAC01\uC624\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212972
    m_Localized: "\uC218\uD559, \uACFC\uD559, \uADF8\uB9AC\uACE0 '\uC751\uAE09\uCC98\uCE58 \uD578\uB4DC\uBD81'. \uAC00\uBC29\uC774 \uAE08\uBC29 \uBB34\uAC70\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212971
    m_Localized: "\uCC38\uACE0\uC11C\uB791 \uBB38\uC81C\uC9D1\uC744 \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212970
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBAA9\uBC1C\uC744 \uC138\uC6CC \uB450\uACE0 \uC11C\uAC00\uC5D0 \uAE30\uB300 \uD55C\uCC38\uC744 \uC11C \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212969
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uB294\u2026 \uADF8\uB300\uB85C\uAD6C\uB098. \uC2DC\uAC04\uC774 \uBA48\uCD98 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212968
    m_Localized: "\uC11C\uAC00 \uC0AC\uC774\uB85C \uD587\uBE5B\uC774 \uAE38\uAC8C \uB4E4\uC5B4\uC654\uB2E4. \uBA3C\uC9C0\uAC00 \uCC9C\uCC9C\uD788 \uB5A0\uB2E4\uB154\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212967
    m_Localized: "\uB3C4\uC11C\uAD00 \uC720\uB9AC\uBB38\uC5D0\uB294 '\uC815\uC219'\uC774\uB77C\uB294 \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uC5C6\uB294 \uACF3\uC5D0 \uC815\uC219\uC774\uB77C\uB2C8, \uC870\uAE08 \uC6C3\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212966
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC601\uC591\uC0AC \uC120\uC0DD\uB2D8\uC774 \uAF3C\uAF3C\uD558\uC168\uB124. \uAC10\uC0AC\uD558\uB2E4\uACE0 \uD574\uC57C\uACA0\uB2E4. \uC5B4\uB514 \uACC4\uC2DC\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212965
    m_Localized: "\uC2DD\uC790\uC7AC \uCC3D\uACE0 \uC548\uCABD, \uB72F\uC9C0 \uC54A\uC740 \uC300 \uD3EC\uB300\uC640 \uD1B5\uC870\uB9BC \uC0C1\uC790\uAC00 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212964
    m_Localized: "\uCC3D\uACE0\uBD80\uD130 \uC815\uB9AC\uD574\uC694. \uBA39\uC744 \uAC8C \uB354 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212963
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uAD6D\uBB3C\uAE4C\uC9C0 \uB2E4 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212962
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9DB\uC788\uB2E4. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212961
    m_Localized: "\uAC00\uC2A4\uBC84\uB108 \uD558\uB098\uB85C \uB053\uC778 \uB77C\uBA74\uC774\uC5C8\uC9C0\uB9CC, \uC2DD\uD310\uC5D0 \uB35C\uC5B4 \uBA39\uC73C\uB2C8 \uC774\uC0C1\uD558\uAC8C \uD559\uAD50 \uAE09\uC2DD \uB9DB\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212960
    m_Localized: "\uC624\uB298 \uC800\uB141\uC740 \uB2E4 \uAC19\uC774 \uC5EC\uAE30\uC11C \uBA39\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212959
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 1\uD559\uB144\uC740 4\uAD50\uC2DC\uAC00 \uCCB4\uC721\uC774\uC5C8\uC9C0. \uB2E4\uB4E4 \uBC30\uACE0\uD320\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212958
    m_Localized: "{0}: \u2026\uCE74\uB808\uC600\uAD6C\uB098. \uADF8\uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212957
    m_Localized: "\uCE74\uB808\uB77C\uC774\uC2A4, \uBBF8\uC5ED\uAD6D, \uAE4D\uB450\uAE30, \uC694\uAD6C\uB974\uD2B8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212956
    m_Localized: "\uC2A4\uD14C\uC778\uB9AC\uC2A4 \uC870\uB9AC\uB300 \uC704\uC5D0 \uC2DD\uD310\uC774 \uC0B0\uCC98\uB7FC \uC313\uC5EC \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uAE09\uC2DD \uBA54\uB274\uD310\uC774 \uBCBD\uC5D0 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212955
    m_Localized: "\uAE09\uC2DD\uC2E4 \uBB38\uC744 \uBC00\uC790 \uC624\uB798\uB41C \uAE30\uB984 \uB0C4\uC0C8\uC640 \uD568\uAED8 \uC11C\uB298\uD55C \uACF5\uAE30\uAC00 \uBC00\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212954
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uC11C\uAD00 \uC5F4\uC1E0\uB294 \uAD50\uBB34\uC2E4 \uC5B4\uB518\uAC00\uC5D0 \uC788\uC744 \uAC70\uC57C. \uC5C6\uC73C\uBA74 \uBB38\uC744 \uB530\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212953
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uAC00\uB974\uCE5C \uBCF4\uB78C\uC774 \uC788\uB2E4. \uC544\uB2C8, \uC544\uC9C1 \uAC00\uB974\uCE5C \uAC83\uB3C4 \uBCC4\uB85C \uC5C6\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212952
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uB208\uC774 \uCEE4\uC84C\uB2E4\uAC00, \uC774\uB0B4 \uC6C3\uC74C\uC774 \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407439
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC0C1\uCC98 \uB458\uB808\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uCC9C\uCC9C\uD788 \uC9DA\uC5B4 \uB098\uAC14\uB2E4. \uC787\uC790\uAD6D\uC774 \uC788\uB294\uC9C0 \uBCF4\uB294 \uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212951
    m_Localized: "\uB3C4\uC11C\uAD00\uBD80\uD130. \uCC45\uC774 \uD544\uC694\uD574\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212950
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB798, \uC2DD\uD310. \uADF8\uAC8C \uAF64 \uC911\uC694\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212949
    m_Localized: "{0}: \uADF8\uB9AC\uACE0 \uC2DD\uD310\uC774\uC694. \uC2DD\uD310\uC5D0 \uBA39\uACE0 \uC2F6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212948
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD604\uC2E4\uC801\uC774\uAD6C\uB098. \uC88B\uC544. \uB0C9\uC7A5\uACE0\uB294 \uBABB \uC368\uB3C4 \uC870\uB9AC\uB300\uB791 \uD070 \uC1A5\uC774 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212947
    m_Localized: "\uAE09\uC2DD\uC2E4\uBD80\uD130. \uBA39\uB294 \uAC8C \uBA3C\uC800\uC608\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212946
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD55C \uBC88\uC5D0 \uB2E4\uB294 \uBABB \uD574. \uC5B4\uB514\uBD80\uD130 \uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212945
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uC2E4\uB3D9 \uB9D0\uACE0\uB3C4 \uC4F8 \uB9CC\uD55C \uB370\uAC00 \uB9CE\uC544. \uAE09\uC2DD\uC2E4, \uB3C4\uC11C\uAD00, \uCCB4\uC721\uAD00, \uACFC\uD559\uC2E4, \uAD50\uBB34\uC2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212944
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC740 \uBC84\uD2F0\uB294 \uACC4\uC808\uC774\uC5C8\uC5B4. \uC5EC\uB984\uC740 \uB113\uD788\uB294 \uACC4\uC808\uB85C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407440
    m_Localized: "\uD55C\uCC38 \uB4A4\uC5D0\uC57C \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407441
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uAE01\uD78C \uAC70\uC57C. \uBB3C\uB9B0 \uAC74 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407442
    m_Localized: "\uADF8 \uB9D0\uC744 \uD558\uB294 \uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407443
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 \uC774\uAC74 \uC800\uC808\uB85C \uC548 \uB098\uC544. \uC774\uB7F0 \uB370\uC120 \uC791\uC740 \uC0C1\uCC98\uAC00 \uC81C\uC77C \uBB34\uC11C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407444
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC0C1\uC790\uC5D0 \uBD95\uB300\uAC00 \uB0A8\uC544 \uC788\uC73C\uB2C8\uAE4C, \uC624\uB298 \uBC24\uC5D4 \uD479 \uC790. \uC790\uAE30 \uC804\uC5D0 \uB0B4\uAC00 \uAC10\uC544 \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810827
    m_Localized: "{0}: \uD5EC\uAE30\u2026 \uC600\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810828
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAA8\uB974\uACA0\uC5B4. \uC798\uBABB \uB4E4\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810829
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uB807\uAC8C \uB9D0\uD558\uBA74\uC11C\uB3C4, \uADF8\uB0A0 \uBC24 \uB2A6\uAC8C\uAE4C\uC9C0 \uCC3D\uBC16\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810830
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38\uC5D0 \uC8FC\uC6B4 \uBCF4\uC870\uBC30\uD130\uB9AC \uD558\uB098. \uB208\uAE08\uC740 \uAC70\uC758 \uBC14\uB2E5\uC774\uC5C8\uC9C0\uB9CC, \uBD88\uBE5B\uC774 \uD55C \uCE78 \uAE5C\uBE61\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810831
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC11C\uB78D\uC5D0\uC11C \uCC3E\uC544 \uC900 \uCF00\uC774\uBE14\uC744 \uAF42\uC558\uB2E4. \uC190\uC774 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810832
    m_Localized: "\uD654\uBA74\uC774 \uD55C\uCC38 \uAE4C\uB9E3\uB2E4\uAC00, \uB85C\uACE0\uAC00 \uC9C0\uB098\uAC00\uACE0 \uB0AF\uC775\uC740 \uBC30\uACBD \uD654\uBA74\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810833
    m_Localized: "\uC694\uC998 \uBC24\uB9C8\uB2E4 \uC18C\uB9AC\uAC00 \uAC00\uAE4C\uC6CC\uC84C\uB2E4. \uC6B4\uB3D9\uC7A5 \uCABD\uC5D0\uC11C, \uADF8\uB9AC\uACE0 \uC5B4\uC81C\uB294 \uACC4\uB2E8 \uC544\uB798\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810834
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAC83\uB4E4, \uBB34\uB9AC\uB97C \uC9D3\uAE30 \uC2DC\uC791\uD588\uC5B4. \uC774\uBC88 \uC8FC \uC548\uC5D0 \uD55C \uBC88\uC740 \uD06C\uAC8C \uC62C \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810835
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 \uC6B0\uB9AC, \uC11D \uB2EC \uAC00\uAE4C\uC774 \uBC84\uD17C\uB2E4. \uADF8\uAC74 \uC78A\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810836
    m_Localized: "\uB05D\uB098\uBA74 \uAC19\uC774 \uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810837
    m_Localized: "{0}: \uC774\uBC88 \uC8FC \uC9C0\uB098\uBA74\uC694. \uC625\uC0C1\uC5D0\uC11C \uD574 \uB728\uB294 \uAC70 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810838
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC18D. \uBAA9\uBC1C \uC9DA\uACE0\uB77C\uB3C4 \uC62C\uB77C\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810839
    m_Localized: "\uC9C0\uAE08 \uD560 \uC218 \uC788\uB294 \uAC78 \uB354 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810840
    m_Localized: "\uB458\uC774\uC11C \uBC24\uB2A6\uAC8C\uAE4C\uC9C0 \uBB38 \uC55E \uCC45\uC0C1\uC744 \uB2E4\uC2DC \uBB36\uACE0, \uBB3C\uD1B5\uC744 \uC548\uCABD\uC73C\uB85C \uC62E\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810841
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uC815\uB3C4\uBA74\u2026 \uD558\uB8E8\uB294 \uB354 \uBC84\uD2F0\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810842
    m_Localized: "\uC0C8\uBCBD \uB450 \uC2DC\uCBE4. \uCC9C\uC7A5 \uB108\uBA38\uC5D0\uC11C \uB611, \uB611, \uB611 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810843
    m_Localized: "\uC880\uBE44\uB294 \uC800\uB807\uAC8C \uADDC\uCE59\uC801\uC73C\uB85C \uB450\uB4DC\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810844
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB4E4\uC5C8\uC5B4? \uAD50\uC2E4\uB3D9 3\uCE35 \uCABD\uC774\uC57C. \uC0AC\uB78C\uC774\uC57C, \uC800\uAC74."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810845
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0 \uAC00\uB294 \uAC74 \uC548 \uB3FC. \uAC00\uB824\uBA74 \uB0AE\uC5D0, \uC870\uC6A9\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810846
    m_Localized: "\uB0B4\uC77C \uAC00 \uBCF4\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810847
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. 3\uCE35 \uB05D \uAD50\uC2E4 \uCABD\uC774\uC5C8\uC5B4. \uBB3C\uC774\uB791 \uAC04\uC2DD \uC880 \uCC59\uACA8 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810848
    m_Localized: "\uBABB \uB4E4\uC740 \uAC78\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810849
    m_Localized: "\uC18C\uB9AC\uB294 \uD55C\uCC38 \uB354 \uC774\uC5B4\uC9C0\uB2E4 \uBA48\uCDC4\uB2E4. \uADF8\uB0A0 \uBC24\uC740 \uC7A0\uC774 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810850
    m_Localized: "\uC791\uC740 \uC544\uC774\uC600\uB2E4. \uC911\uD559\uAD50 \uCCB4\uC721\uBCF5, \uC2E0\uBC1C \uD55C \uC9DD\uC740 \uB048\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810851
    m_Localized: "\uB3C4\uD604: \uAC15\uB3C4\uD604\uC774\uC694. \uC0C8\uBCBD\uC911 3\uD559\uB144. \uD615 \uD559\uAD50 \uAD6C\uACBD \uC654\uB2E4\uAC00\u2026 \uADF8\uB0A0\uBD80\uD130 \uC5EC\uAE30 \uC788\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810852
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC8FC\uC77C \uB118\uAC8C 3\uCE35\uC5D0\uC11C \uD63C\uC790 \uBC84\uD2F4 \uAC70\uC57C? \uB300\uB2E8\uD558\uB2E4, \uC815\uB9D0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810853
    m_Localized: "\uB3C4\uD604\uC740 \uC120\uC0DD\uB2D8\uC758 \uB2E4\uB9AC\uB97C \uBCF4\uACE0 \uB208\uC744 \uD53C\uD588\uB2E4\uAC00, \uB2E4\uC2DC \uB611\uBC14\uB85C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810854
    m_Localized: "\uC774\uC81C \uC5EC\uAE30\uC11C \uAC19\uC774 \uC9C0\uB0B4\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810855
    m_Localized: "\uB3C4\uD604: \u2026\uC9C4\uC9DC\uC694? \uC800 \uBC25 \uB9CE\uC774 \uC548 \uBA39\uC5B4\uC694. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810856
    m_Localized: "\uAC19\uC774 \uC9C0\uB0B4\uB418 \uADDC\uCE59\uBD80\uD130 \uC815\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810857
    m_Localized: "\uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uAE30. \uD63C\uC790 \uB098\uAC00\uC9C0 \uC54A\uAE30. \uBA39\uC744 \uAC74 \uAC19\uC774 \uB098\uB204\uAE30. \uB3C4\uD604\uC774 \uC190\uAC00\uB77D\uC73C\uB85C \uD558\uB098\uC529 \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810858
    m_Localized: "\uB3C4\uD604: \uC9C0\uD0AC\uAC8C\uC694. \uB2E4 \uC9C0\uD0AC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810859
    m_Localized: "\uBC24\uC911\uC5D0 \uCC3D\uACE0 \uCCA0\uBB38\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB450\uB4DC\uB9AC\uB294 \uC18C\uB9AC. \uBB38\uD2C8\uC73C\uB85C \uBCF4\uB2C8 3\uCE35\uC758 \uADF8 \uC544\uC774\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810860
    m_Localized: "\uB3C4\uD604: \uBB3C\u2026 \uACE0\uB9C8\uC6E0\uC5B4\uC694. \uADFC\uB370 \uD63C\uC790\uB294 \uC774\uC81C \uBABB \uC788\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810861
    m_Localized: "\uB3C4\uD604: \uB4E4\uC5EC\uBCF4\uB0B4 \uC8FC\uC2DC\uBA74 \uBB50\uB4E0 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810862
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC774\uCABD\uC744 \uBCF4\uC558\uB2E4. \uB124\uAC00 \uC815\uD558\uB77C\uB294 \uB208\uBE5B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810863
    m_Localized: "\uBB38\uC744 \uC5F4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810864
    m_Localized: "\uB3C4\uD604\uC740 \uB4E4\uC5B4\uC624\uC790\uB9C8\uC790 \uBC14\uB2E5\uC5D0 \uC8FC\uC800\uC549\uC544 \uD55C\uCC38\uC744 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810865
    m_Localized: "\uBBF8\uC548\uD558\uB2E4\uACE0, \uC9C0\uAE08\uC740 \uC548 \uB41C\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810866
    m_Localized: "\uB300\uC2E0 \uD1B5\uC870\uB9BC \uB450 \uAC1C\uB97C \uBB38\uD2C8\uC73C\uB85C \uBC00\uC5B4 \uC8FC\uC5C8\uB2E4. \uBC1C\uC18C\uB9AC\uAC00 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810867
    m_Localized: "\uADF8 \uB4A4\uB85C 3\uCE35\uC5D0\uC11C \uB178\uD06C \uC18C\uB9AC\uB294 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810868
    m_Localized: "\uC0C8\uBCBD, \uB3C4\uD604\uC774 \uBAB8\uC744 \uC6C5\uD06C\uB9B0 \uCC44 \uC7A0\uAF2C\uB300\uB97C \uD588\uB2E4. \uD615, \uD615 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810869
    m_Localized: "\uAE68\uC5B4\uB09C \uB3C4\uD604\uC740 \uB540\uC5D0 \uC816\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810870
    m_Localized: "\uB3C4\uD604: \u2026\uC8C4\uC1A1\uD574\uC694. \uC2DC\uB044\uB7EC\uC6E0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810871
    m_Localized: "\uC606\uC5D0 \uC549\uC544 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810872
    m_Localized: "\uD615\uC774 3\uD559\uB144 \uAD50\uC2E4\uC5D0 \uC788\uC5C8\uB2E4\uACE0 \uD588\uB2E4. \uAC19\uC774 \uC9D1\uC5D0 \uAC00\uAE30\uB85C \uD588\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810873
    m_Localized: "\uB2E4 \uB4E3\uACE0 \uB098\uC11C, \uD560 \uC218 \uC788\uB294 \uB9D0\uC740 \uD558\uB098\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4. \"\uAC19\uC774 \uCC3E\uC544\uBCF4\uC790. \uC5B8\uC820\uAC00.\""
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810874
    m_Localized: "\uAD1C\uCC2E\uB2E4\uACE0, \uB2E4\uC2DC \uC790\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810875
    m_Localized: "\uB3C4\uD604\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0 \uB4F1\uC744 \uB3CC\uB838\uB2E4. \uC228\uC18C\uB9AC\uAC00 \uC624\uB798\uB3C4\uB85D \uACE0\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810876
    m_Localized: "\uB3C4\uD604: \uC800\uB3C4 \uBB50 \uD558\uACE0 \uC2F6\uC5B4\uC694. \uB9E8\uB0A0 \uC228\uC5B4\uB9CC \uC788\uB294 \uAC70 \uC2EB\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810877
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD558\uACE0 \uC2F6\uC740 \uAC8C \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810878
    m_Localized: "\uB3C4\uD604: \uB9DD \uBCF4\uB294 \uAC70\uC694. \uC800 \uB208 \uC88B\uC544\uC694. 3\uCE35\uC5D0\uC11C \uC77C\uC8FC\uC77C \uB0B4\uB0B4 \uCC3D\uBC16\uB9CC \uBD24\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810879
    m_Localized: "\uB9DD \uBCF4\uB294 \uBC95\uC744 \uAC00\uB974\uCCD0 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810880
    m_Localized: "\uC18C\uB9AC \uC2E0\uD638 \uC138 \uAC00\uC9C0. \uC9E7\uAC8C \uB450 \uBC88\uC740 '\uC228\uC5B4', \uAE38\uAC8C \uD55C \uBC88\uC740 '\uAD1C\uCC2E\uC544'. \uB3C4\uD604\uC740 \uAE08\uBC29 \uC678\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810881
    m_Localized: "\uC544\uC9C1\uC740 \uC548\uC804\uD55C \uC77C\uB9CC \uB9E1\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810882
    m_Localized: "\uB3C4\uD604: \u2026\uB124. \uADF8\uB798\uB3C4 \uB098\uC911\uC5D4 \uC2DC\uCF1C \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810883
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC190 \uAE00\uC528\uB85C \uB9CC\uB4E0 \uC2DC\uD5D8\uC9C0\uB97C \uB0B4\uBC00\uC5C8\uB2E4. \uAD6D\uC5B4 \uC5F4 \uBB38\uC81C. \uC774\uBA74\uC9C0 \uB4B7\uBA74\uC5D0 \uC790\uB97C \uB300\uACE0 \uADF8\uC740 \uC904\uC774 \uBC18\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810884
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6D0\uB798 \uC624\uB298\uC774 1\uD559\uAE30 \uC911\uAC04\uACE0\uC0AC \uCCAB\uB0A0\uC774\uC5C8\uC5B4. \uAE30\uBD84\uB9CC\uC774\uB77C\uB3C4 \uB0B4 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810768
    m_Localized: "\uBC24\uC5D0 \uBC88\uAC08\uC544 \uC9C0\uD0A4\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810767
    m_Localized: "\uB0A8\uC740 \uC790\uC7AC\uB85C \uBB38 \uC55E \uCC45\uC0C1\uC744 \uC774\uC911\uC73C\uB85C \uBB36\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810766
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC\uBD80\uD130 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810765
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C \uB354 \uC313\uB4E0\uC9C0, \uBC24\uC5D0 \uBC88\uAC08\uC544 \uC9C0\uD0A4\uB4E0\uC9C0 \uD574\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810764
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC\uAC00 \uB4DC\uB098\uB4DC\uB294 \uC18C\uB9AC\uB97C \uC800\uAC83\uB4E4\uB3C4 \uB4E3\uACE0 \uC788\uB294 \uAC70\uC57C. \uB0C4\uC0C8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810763
    m_Localized: "\uBC24\uC0C8 \uCC3D\uACE0 \uCCA0\uBB38\uC744 \uAE01\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uBB38\uD2C0\uC5D0 \uD760\uC9D1\uC774 \uB298\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810762
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uBCF4\uB2E4 \uB124\uAC00 \uBA3C\uC800\uC57C. \uC54C\uC9C0? \uBE48\uC190\uC73C\uB85C \uC640\uB3C4 \uB3FC. \uC5BC\uAD74\uB9CC \uBCF4\uC5EC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810761
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0\uB9CC \uC5F4\uB9AC\uB294 \uACF3\uB3C4 \uC788\uC744 \uAC70\uC57C. \uC57D\uD488\uACE0 \uAC19\uC740 \uB370\uB294 \uB0AE\uC5D4 \uC154\uD130\uAC00 \uB0B4\uB824\uAC00 \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810760
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC758\uC6D0 \uB300\uAE30\uC2E4\uC5D4 \uC0AC\uB78C\uC774 \uB9CE\uC558\uC744 \uAC70\uC57C. \uADF8 \uB9D0\uC740\u2026 \uBB34\uB9AC\uAC00 \uC788\uC744 \uAC70\uB77C\uB294 \uB73B\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810759
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uAD6D\uC774\uB77C. \uC57D\uC740 \uC6B0\uB9AC\uD55C\uD14C \uC81C\uC77C \uBD80\uC871\uD55C \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810758
    m_Localized: "\uC804\uB2E8\uC9C0 \uADC0\uD241\uC774\uC5D0 \uB204\uAD70\uAC00 \uBCFC\uD39C\uC73C\uB85C \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCD0 \uB450\uC5C8\uB2E4. \uB098\uBCF4\uB2E4 \uBA3C\uC800 \uC774\uAC78 \uBCF8 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810757
    m_Localized: "'\uC0C8\uBCBD\uC57D\uAD6D \xB7 2\uCE35 \uC5F0\uC138\uC758\uC6D0. \uB3C4\uBCF4 3\uBD84.'"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810756
    m_Localized: "\uD3B8\uC758\uC810 \uACC4\uC0B0\uB300 \uB4A4 \uBCBD\uC5D0 \uADFC\uCC98 \uAC00\uAC8C \uC804\uB2E8\uC9C0\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810755
    m_Localized: "\uC11C\uB958\uB97C \uACF5\uCC45 \uC0AC\uC774\uC5D0 \uB07C\uC6CC \uB450\uC5C8\uB2E4. \uC5B8\uC820\uAC00 \uBB3C\uC5B4\uBCFC \uC218 \uC788\uC744 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810754
    m_Localized: "\uD63C\uC790\uB9CC \uAC04\uC9C1\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810753
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC54C\uB824 \uC918\uC11C \uACE0\uB9C8\uC6CC. \uC774\uAC74 \uC6B0\uB9AC \uB458\uC774 \uB05D\uAE4C\uC9C0 \uAE30\uC5B5\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810752
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC11C\uB958\uB97C \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4\uAC00, \uC811\uC5B4\uC11C \uD488\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810751
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uBCF4\uC5EC \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810750
    m_Localized: "\uADF8 \uC544\uB798\uC5D0 \uB204\uAD70\uAC00 \uBCFC\uD39C\uC73C\uB85C \uC904\uC744 \uAE0B\uACE0, \uB2E4\uC2DC \uADF8 \uC704\uC5D0 '\uBCF4\uB958 \uD574\uC81C'\uB77C\uACE0 \uC801\uC5B4 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810749
    m_Localized: "'\uC6D0\uC778 \uBD88\uBA85 \uBC1C\uC5F4 \uD658\uC790 \uBC1C\uC0DD \uC2DC \uB4F1\uAD50 \uD559\uC0DD \uADC0\uAC00 \uC870\uCE58 \uBCF4\uB958 \uBC0F \uAD50\uB0B4 \uB300\uAE30.'"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810748
    m_Localized: "\uAC00\uC838\uC628 \uC11C\uB958\uB294 \uC0AC\uD0DC \uC0AC\uD758 \uC804 \uB0A0\uC9DC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810747
    m_Localized: "\uD55C\uCC38 \uB4A4, \uAFB8\uB7EC\uBBF8\uC5D0\uC11C \uC791\uC740 \uC5F4\uC1E0 \uD558\uB098\uB97C \uBE7C\uC11C \uCC45\uC0C1 \uC704\uC5D0 \uC62C\uB824 \uB450\uC5C8\uB2E4. \uC9D1\uC5B4 \uAC00\uB77C\uB294 \uB9D0\uB3C4, \uB450\uB77C\uB294 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810746
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB9D0\uC744 \uB05D\uB9FA\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810745
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD81\uAE08\uD574. \uADF8\uB798\uC11C \uBB34\uC11C\uC6CC. \uC5B4\uB978\uB4E4\uC774 \uBB58 \uC54C\uACE0 \uC788\uC5C8\uB294\uC9C0, \uC54C\uAC8C \uB420\uAE4C \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810744
    m_Localized: "{0}: \uBB50\uAC00 \uC801\uD600 \uC788\uC5C8\uB294\uC9C0 \uAD81\uAE08\uD558\uC9C0 \uC54A\uC73C\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810743
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4 \uB9E8 \uC548\uCABD \uCE90\uBE44\uB2DB. \uD639\uC2DC \uAC70\uAE30 \uB0A8\uC544 \uC788\uC73C\uBA74\u2026 \uC544\uB2C8\uB2E4. \uB098\uC911\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810742
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB3C4 \uACB0\uC7AC\uD310\uC744 \uB118\uAE30\uBA74\uC11C \uC81C\uBAA9\uB9CC \uBD24\uC5B4. \uB05D\uAE4C\uC9C0 \uC77D\uC740 \uC0AC\uB78C\uC774 \uC788\uC5C8\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810741
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0AC\uD0DC \uBA70\uCE60 \uC804\uC5D0 \uAD50\uBB34\uC2E4\uC5D0 \uACF5\uBB38\uC774 \uC654\uC5C8\uC5B4. \uB2E4\uB4E4 \uADF8\uB0E5 \uB3C5\uAC10 \uB300\uC751 \uC9C0\uCE68\uC778 \uC904 \uC54C\uC558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810740
    m_Localized: "{0}: \uADF8 \uC5F4\uC1E0, \uACC4\uC18D \uBCF4\uC2DC\uB358\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810739
    m_Localized: "\uCD1B\uBD88\uC774 \uC9E7\uC544\uC9C8 \uB54C\uAE4C\uC9C0 \uC120\uC0DD\uB2D8\uC740 \uAD50\uBB34\uC2E4 \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB97C \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810738
    m_Localized: "\uBD88\uC774 \uB4E4\uC5B4\uC628 \uB4A4\uB85C \uC120\uC0DD\uB2D8\uC740 \uBC24\uB9C8\uB2E4 \uAD50\uBB34\uC2E4 \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB97C \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810737
    m_Localized: "\uD734\uB300\uD3F0\uC744 \uC5CE\uC5B4 \uB450\uC5C8\uB2E4. \uD654\uBA74 \uBD88\uBE5B\uC774 \uCC9C\uC7A5\uC5D0 \uD76C\uBBF8\uD558\uAC8C \uBE44\uCCE4\uB2E4\uAC00 \uAEBC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810736
    m_Localized: "\uD654\uBA74\uC744 \uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810735
    m_Localized: "\"\uB098 \uD559\uAD50\uC57C. \uC0B4\uC544 \uC788\uC5B4.\" \uC804\uC1A1 \uC2E4\uD328 \uD45C\uC2DC\uAC00 \uB5B4\uB2E4. \uADF8\uB798\uB3C4 \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810734
    m_Localized: "\uBCF4\uB0B4\uC9C0\uC9C0 \uC54A\uC744 \uB2F5\uC7A5\uC744 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810733
    m_Localized: "\uADF8 \uB4A4\uB85C\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810732
    m_Localized: "7\uC77C\uC9F8\uBD80\uD130\uB294, \uC0C8 \uBA54\uC2DC\uC9C0\uAC00 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810731
    m_Localized: "{0}: (6\uC77C\uC9F8) \uBC30\uD130\uB9AC \uC5BC\uB9C8 \uC548 \uB0A8\uC558\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810730
    m_Localized: "{0}: (5\uC77C\uC9F8) {1} \uC81C\uBC1C \uB2F5\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810729
    m_Localized: "{0}: (4\uC77C\uC9F8) \uC57C, \uB108 \uD639\uC2DC \uD559\uAD50\uC5D0 \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810728
    m_Localized: "{0}: (4\uC77C\uC9F8) \uADF8\uB54C \uB124\uAC00 \uB9D0\uD574 \uC900 \uAC70, \uACC4\uC18D \uC0DD\uAC01\uB098. \uB098 \uADF8\uB54C \uC544\uBB34\uAC83\uB3C4 \uBABB \uD588\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810727
    m_Localized: "{0}: (3\uC77C\uC9F8) \uC804\uD654 \uC880 \uBC1B\uC544. \uB108\uD76C \uC9D1 \uCABD\uB3C4 \uB09C\uB9AC\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810726
    m_Localized: "{0}: (2\uC77C\uC9F8) \uD559\uAD50 \uC55E \uC774\uC0C1\uD574. \uACBD\uCC30\uCC28\uAC00 \uB9C9\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810725
    m_Localized: "{0}: (1\uC77C\uC9F8) \uC624\uB298 \uC65C \uBA3C\uC800 \uAC14\uC5B4? \uB0B4\uC77C\uC740 \uB5A1\uBCF6\uC774 \uBB34\uC870\uAC74\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810724
    m_Localized: "{0}: (1\uC77C\uC9F8) \uC5B4\uB514\uC57C? \uB5A1\uBCF6\uC774 \uBA39\uAE30\uB85C \uD588\uC796\uC544. \uAD50\uBB38 \uC55E\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810723
    m_Localized: "\uC804\uC6D0\uC774 \uB4E4\uC5B4\uC654\uB2E4. \uC54C\uB9BC\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uC3DF\uC544\uC84C\uB2E4. \uC804\uBD80 \uAC19\uC740 \uC774\uB984\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810722
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0, \uBE68\uAC04 \uBC30\uD130\uB9AC \uCE78\uC774 \uD558\uB098 \uCC44\uC6CC\uC9C0\uB294 \uAC78 \uC9C0\uCF1C\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810721
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCF1C\uC9C0\uBA74\u2026 \uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uB9CE\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810720
    m_Localized: "\uCDA9\uC804\uAE30\uC5D0 \uAF42\uC740 \uD734\uB300\uD3F0 \uD654\uBA74\uC5D0 \uBC30\uD130\uB9AC \uBAA8\uC591\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810719
    m_Localized: "\uCC3D\uBB38\uB9C8\uB2E4 \uCEE4\uD2BC\uC744 \uB05D\uAE4C\uC9C0 \uCCE4\uB2E4. \uD615\uAD11\uB4F1 \uD558\uB098 \uC544\uB798 \uB458\uC774 \uB9C8\uC8FC \uC549\uC73C\uB2C8, \uBC29\uC774 \uAC11\uC790\uAE30 \uC881\uC544 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810718
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uB3D9\uB124\uC5D0\uC11C \uBD88 \uCF1C\uC9C4 \uCC3D\uBB38\uC740 \uC5EC\uAE30 \uD558\uB098\uBFD0\uC77C \uAC70\uC57C. \uBCF4\uB294 \uAC8C \uC0AC\uB78C\uB9CC\uC740 \uC544\uB2D0 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810717
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 {0}, \uBC24\uC5D0\uB294 \uBD88 \uD558\uB098\uB9CC \uCF1C\uC790. \uCEE4\uD2BC\uB3C4 \uAF2D \uCE58\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810716
    m_Localized: "\uCF1C\uC9C0\uB294 \uAC83\uBCF4\uB2E4 \uC548 \uCF1C\uC9C0\uB294 \uAC8C \uB9CE\uC558\uB2E4. \uADF8\uB798\uB3C4 \uD558\uB098\uAC00 \uCF1C\uC9C8 \uB54C\uB9C8\uB2E4 \uC120\uC0DD\uB2D8\uC774 \uC791\uAC8C \uBC15\uC218\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810715
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAE30 \uC2A4\uC704\uCE58 \uC880 \uB20C\uB7EC \uBCFC\uB798? \uD558\uB098\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810714
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uBCF5\uB3C4\uB85C \uB098\uAC00\uB354\uB2C8, \uC2A4\uC704\uCE58\uB97C \uD558\uB098\uC529 \uB20C\uB7EC \uBCF4\uC558\uB2E4. \uCF1C\uC9C0\uB294 \uAC83\uBCF4\uB2E4 \uC548 \uCF1C\uC9C0\uB294 \uAC8C \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810713
    m_Localized: "\uC5B4\uB514\uC120\uAC00 \uB0C9\uC7A5\uACE0\uAC00 \uC6C5, \uD558\uACE0 \uAE68\uC5B4\uB098\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uD559\uAD50\uAC00 \uC228\uC744 \uD55C \uBC88 \uC270 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810712
    m_Localized: "\uB458\uC740 \uD55C\uCC38 \uADF8 \uBD88\uBE5B \uD558\uB098\uB9CC \uBC14\uB77C\uBCF4\uC558\uB2E4. \uD558\uC597\uACE0, \uC870\uAE08 \uB5A8\uB9AC\uACE0, \uB208\uC774 \uC2DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810711
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uBD88\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810710
    m_Localized: "\uBCF5\uB3C4 \uB05D \uD615\uAD11\uB4F1 \uD558\uB098\uAC00 \uAE5C\uBE61\uC774\uB2E4 \uCF1C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810709
    m_Localized: "\uB808\uBC84\uB97C \uB0B4\uB9AC\uC790 \uBC1C\uC804\uAE30\uAC00 \uAE30\uCE68\uD558\uB4EF \uBA87 \uBC88 \uB5A8\uB354\uB2C8, \uB0AE\uAC8C \uC6B8\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810708
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD80\uD488\uC740 \uC790\uC7AC\uB85C \uB300\uC2E0\uD558\uACE0, \uB098\uBA38\uC9C0\uB294 \uACF5\uBD80\uB85C \uBA54\uC6B0\uC790. \uACF5\uD559 \uCABD\uC744 \uC880 \uD574 \uB46C\uC57C \uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810707
    m_Localized: "\uC77C\uC8FC\uC77C \uB118\uAC8C \uAEBC\uC838 \uC788\uB358 \uD734\uB300\uD3F0\uC774 \uC8FC\uBA38\uB2C8 \uC18D\uC5D0\uC11C \uAC11\uC790\uAE30 \uBB34\uAC81\uAC8C \uB290\uAEF4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810706
    m_Localized: "{0}: \uD734\uB300\uD3F0\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810705
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uCE60 \uC218\uB9CC \uC788\uC73C\uBA74 \uBD88\uC744 \uCF1C\uACE0, \uD734\uB300\uD3F0\uB3C4 \uCDA9\uC804\uD560 \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810704
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uC1A1\uC2E4\uC5D0 \uBE44\uC0C1 \uBC1C\uC804\uAE30\uAC00 \uC788\uC5B4. \uD559\uAD50 \uD589\uC0AC \uB54C \uC4F0\uB358 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810703
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B8\uC820\uAC00 \uB098\uB3C4 \uAC70\uAE30\uC11C \uD558\uB298 \uD55C\uBC88 \uBCF4\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810702
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F4\uC5EC\uC12F \uCE78\uC774\uB77C\uACE0? \uC26C\uC5C4\uC26C\uC5C4 \uAC00\uBA74 \uB418\uACA0\uB2E4. \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uB370\uB824\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810701
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F0\uAE30\uAC00 \uB09C\uB2E4\uB294 \uAC74, \uB204\uAC00 \uBD88\uC744 \uD53C\uC6E0\uB2E4\uB294 \uAC70\uC57C. \uBC25\uC744 \uD558\uB4E0 \uBAB8\uC744 \uB179\uC774\uB4E0. \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810700
    m_Localized: "\uBC14\uB78C, \uC0C8\uC18C\uB9AC, \uC5F0\uAE30 \uD55C \uC904\uAE30. \uB9D0\uD558\uB294 \uB3D9\uC548 \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810699
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B4\uB560\uC5B4? \uD558\uB098\uB3C4 \uBE7C\uB193\uC9C0 \uB9D0\uACE0 \uB9D0\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810698
    m_Localized: "\uB3CC\uC544\uC624\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810697
    m_Localized: "\uC5EC\uAE30\uC11C\uB294, \uC7A0\uAE50\uC774\uC9C0\uB9CC, \uC228\uC744 \uAE4A\uAC8C \uC274 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810696
    m_Localized: "\uC625\uC0C1 \uBC14\uB2E5\uC740 \uB113\uACE0 \uD3C9\uD3C9\uD588\uB2E4. \uBB34\uC5C7\uC774\uB4E0 \uB0B4\uB824\uC549\uC744 \uC218 \uC788\uC744 \uB9CC\uD07C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810695
    m_Localized: "\uBA40\uB9AC \uC5F0\uAE30 \uD55C \uC904\uAE30\uAC00 \uC62C\uB77C\uAC00\uACE0 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uC544\uC9C1 \uC800\uAE30 \uC788\uB2E4\uB294 \uB73B\uC77C\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810694
    m_Localized: "\uB3C4\uC2DC\uB294 \uC870\uC6A9\uD588\uB2E4. \uB108\uBB34 \uC870\uC6A9\uD574\uC11C \uC0C8\uC18C\uB9AC\uAC00 \uD06C\uAC8C \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810693
    m_Localized: "\uBB38\uC744 \uBC00\uC790 \uBC14\uB78C\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uB4E4\uC774\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810692
    m_Localized: "\uBD95\uB300\uC640 \uC18C\uB3C5\uC57D\uC744 \uAC00\uBC29\uC5D0 \uB123\uC5C8\uB2E4. \uD30C\uC77C\uC740 \uADF8\uB300\uB85C \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810691
    m_Localized: "\uC57D\uD488\uB9CC \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810690
    m_Localized: "\uC65C \uC774\uAC78 \uAE30\uC5B5\uD574 \uB450\uACE0 \uC2F6\uC740\uC9C0\uB294 \uC2A4\uC2A4\uB85C\uB3C4 \uC798 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810689
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uB3CC\uC544\uC624\uB294 \uAE38\uC744 \uBA3C\uC800 \uBD10 \uB46C. \uB4E4\uC5B4\uAC00\uB294 \uAE38\uBCF4\uB2E4 \uB098\uC624\uB294 \uAE38\uC774 \uC911\uC694\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 379513245810688
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCC3D\uACE0 \uCABD\uC5D0\uB294 \uC0C1\uC790\uAC00 \uB9CE\uC744 \uAC70\uACE0, \uC0AC\uBB34\uC2E4\uC740 \uC7A0\uACA8 \uC788\uC744 \uC218\uB3C4 \uC788\uC5B4. \uBB34\uB9AC\uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 379512771854336
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uAD50 \uBC16\uC774\uAD6C\uB098. \uAC70\uB9AC\uAC00 \uC9E7\uC73C\uB2C8 \uD574 \uC9C0\uAE30 \uC804\uC5D0 \uB2E4\uB140\uC62C \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212882
    m_Localized: "\uD559\uAD50 \uBC29\uC5B4 \uC9C0\uB3C4\uB85C \uC4F4\uB2E4. \uC57D\uD55C \uACF3\uC744 \uD45C\uC2DC\uD558\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212883
    m_Localized: "\uB458\uC774\uC11C \uB2F4\uC7A5\uC758 \uD2C8, \uC7A0\uAE30\uC9C0 \uC54A\uB294 \uCC3D\uBB38, \uC18C\uB9AC\uAC00 \uC6B8\uB9AC\uB294 \uBCF5\uB3C4\uB97C \uBE68\uAC04 \uD39C\uC73C\uB85C \uD45C\uC2DC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212884
    m_Localized: "\uADF8\uB0A0 \uC624\uD6C4, \uD45C\uC2DC\uD55C \uACF3\uC744 \uD558\uB098\uC529 \uB9C9\uC558\uB2E4. \uC1A1\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C '\uC6B0\uB9AC'\uB77C\uB294 \uB9D0\uC744 \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212885
    m_Localized: "\uB3D9\uB124 \uC9C0\uB3C4\uB85C \uC4F4\uB2E4. \uAC08 \uAE38\uC744 \uBBF8\uB9AC \uADF8\uB824 \uBCF4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212886
    m_Localized: "\uC9C0\uB3C4 \uC704\uC5D0 \uB2E4\uC74C \uD0D0\uD5D8 \uACBD\uB85C\uB97C \uADF8\uB838\uB2E4. \uB3CC\uC544\uC624\uB294 \uAE38\uC744 \uB450 \uAC1C\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212887
    m_Localized: "\uC1A1\uC608\uC9C0: \uB098\uAC00\uB294 \uAC74 \uB124\uAC00 \uD558\uB2C8\uAE4C. \uAE38\uC774\uB77C\uB3C4 \uB0B4\uAC00 \uADF8\uB9B4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212888
    m_Localized: "\uBC24\uC0C8 \uB3C4\uD604\uC758 \uC5F4\uC774 \uB0B4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC816\uC740 \uC218\uAC74\uC744 \uBA87 \uBC88\uC774\uACE0 \uAC08\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212889
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB3C\uB9B0 \uAC74 \uC544\uB2C8\uC57C. \uADF8\uB0E5 \uC5EC\uB984 \uAC10\uAE30. \uC560\uB4E4\uC740 \uC6D0\uB798 \uC774\uB807\uAC8C \uB053\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212890
    m_Localized: "\uB3C4\uD604\uC774 \uC7A0\uACB0\uC5D0 \uBB34\uC5B8\uAC00 \uC911\uC5BC\uAC70\uB838\uB2E4. \uC5C4\uB9C8, \uB77C\uACE0 \uD588\uB2E4. \uB450 \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212891
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uAC74\uC744 \uC9DC\uB358 \uC190\uC744 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212892
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8 \uC606\uC5D0\uC11C \uAC19\uC774 \uBC24\uC744 \uC0C8\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212893
    m_Localized: "\uC0C8\uBCBD \uB124 \uC2DC\uCBE4 \uB3C4\uD604\uC758 \uC774\uB9C8\uAC00 \uC2DD\uC5C8\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uACFC \uB098\uB294 \uB3D9\uC2DC\uC5D0 \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212894
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC744 \uB5B4\uB2E4. \uC6B0\uB9AC \uB458\uC744 \uBC88\uAC08\uC544 \uBCF4\uB354\uB2C8, \uC270 \uBAA9\uC18C\uB9AC\uB85C \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212895
    m_Localized: "\uB3C4\uD604: \uB204\uB098\uB791 \uC324\uC774 \uC5C4\uB9C8 \uAC19\uC544\uC694. \u2026\uB458\uC774 \uD569\uCCD0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212896
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uAC74\uC73C\uB85C \uB3C4\uD604\uC758 \uC5BC\uAD74\uC744 \uB36E\uC5C8\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC218\uAC74 \uBC11\uC5D0\uC11C \uC0C8\uC5B4 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212897
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uB9E1\uAE30\uACE0 \uC7A0\uC744 \uCCAD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407466
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC544. \uADF8\uB7FC \uAC19\uC774 \uC77D\uC790. \uBAA8\uB974\uB294 \uAC74 \uBAA8\uB978\uB2E4\uACE0 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407465
    m_Localized: "{0}: \uC54C\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407464
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBBF8\uB9AC \uB9D0\uD574 \uB450\uB294\uB370, \uB098 \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC778 \uAC70 \uC54C\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212898
    m_Localized: "{0}: \uB0B4\uC77C \uB098\uAC00\uC57C \uD574\uC11C\uC694. \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212899
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uADF8\uAC8C \uB9DE\uC544. \uB108\uB294 \uC790. \uC5EC\uAE30\uB294 \uB0B4 \uC77C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212900
    m_Localized: "\uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uB3C4\uD604\uC740 \uBC15 \uC120\uC0DD\uB2D8 \uBB34\uB98E\uC744 \uBCA0\uACE0 \uC790\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212901
    m_Localized: "\uC544\uCE68, \uC2DD\uB7C9 \uC0C1\uC790 \uC55E\uC5D0\uC11C \uBAA9\uC18C\uB9AC\uAC00 \uB192\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212902
    m_Localized: "\uB3C4\uD604: \uC608\uC9C0 \uB204\uB098\uAC00 \uC5B4\uC81C \uBC24\uC5D0 \uD558\uB098 \uB354 \uBA39\uC5C8\uC796\uC544\uC694! \uC81C\uAC00 \uBD24\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212903
    m_Localized: "\uC1A1\uC608\uC9C0: \uACBD\uACC4 \uC11C\uB290\uB77C \uBC30\uACE0\uD30C\uC11C \uADF8\uB7AC\uC5B4. \uD55C \uAC1C\uC57C, \uD55C \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212904
    m_Localized: "\uB3C4\uD604: \uC800\uB9CC \uB9E8\uB0A0 \uC801\uAC8C \uBC1B\uB294 \uAC83 \uAC19\uC544\uC694. \uC800\uB3C4 \uC77C\uD558\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212905
    m_Localized: "\uB204\uAD70\uAC00 \uC0C1\uC790\uC758 \uD1B5\uC870\uB9BC \uC218\uB97C \uB2E4\uC2DC \uC138\uACE0 \uC788\uC5C8\uB2E4. \uD558\uB098\uAC00 \uBAA8\uC790\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407463
    m_Localized: "\uACFC\uD559 \uAD50\uACFC\uC11C\uB97C \uCC45\uC0C1\uC5D0 \uD3BC\uCCE4\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uD5DB\uAE30\uCE68\uC744 \uD55C \uBC88 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407462
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uC77C\uB3C4 \uD558\uC790. \uD560\uC218\uB85D \uB298 \uAC70\uC57C. \uAD6D\uC5B4\uB3C4, \uC694\uB9AC\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407461
    m_Localized: "\uC6B0\uB9AC\uB294 \uB9D0\uC5C6\uC774 \uADF8\uB987 \uBC14\uB2E5\uC774 \uBCF4\uC77C \uB54C\uAE4C\uC9C0 \uBA39\uC5C8\uB2E4. \uBC30\uBCF4\uB2E4 \uC190\uC774 \uBA3C\uC800 \uB530\uB73B\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407460
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE09\uC2DD\uC2E4 \uC544\uC8FC\uBA38\uB2C8\uB4E4 \uC0DD\uAC01\uB09C\uB2E4. \uBE44 \uC624\uB294 \uB0A0\uC5D4 \uAF2D \uAD6D\uC744 \uD55C \uBC88 \uB354 \uB370\uC6CC \uC8FC\uC168\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407459
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB530\uB73B\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212906
    m_Localized: "\uB0A8\uC740 \uC2DD\uB7C9\uC740 \uC77C\uC8FC\uC77C\uC744 \uBC84\uD2F0\uAE30\uB3C4 \uBE60\uB4EF\uD588\uB2E4. \uB2E4\uB4E4 \uB098\uB97C \uBCF4\uC558\uB2E4. \uC120\uC0DD\uB2D8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212907
    m_Localized: "\uB611\uAC19\uC774 \uB098\uB208\uB2E4. \uB204\uAD6C\uB4E0 \uAC19\uC740 \uC591\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212908
    m_Localized: "{0}: \uC624\uB298\uBD80\uD130 \uBC30\uC2DD\uD45C \uB9CC\uB4E4\uC5B4\uC694. \uB611\uAC19\uC774. \uC800\uB3C4, \uC120\uC0DD\uB2D8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212909
    m_Localized: "\uBD88\uB9CC\uC774 \uC5C6\uC9C0\uB294 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uD45C\uAC00 \uBD99\uC740 \uB4A4\uB85C\uB294 \uC544\uBB34\uB3C4 \uC0C1\uC790 \uC55E\uC5D0\uC11C \uC5B8\uC131\uC744 \uB192\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212910
    m_Localized: "\uBC16\uC5D0 \uB098\uAC00\uACE0 \uC77C\uD558\uB294 \uC0AC\uB78C\uC774 \uBA3C\uC800 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212911
    m_Localized: "{0}: \uC77C\uD55C \uB9CC\uD07C \uBA39\uC5B4\uC694. \uADF8\uAC8C \uACF5\uD3C9\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212766
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uAE30\uCE68\uC744 \uCC38\uC73C\uBA70 \uC6C3\uC5C8\uB2E4. \uC774\uB7F0 \uC544\uCE68\uC774 \uBA87 \uBC88 \uB354 \uB0A8\uC558\uB294\uC9C0, \uB458 \uB2E4 \uC138\uC9C0 \uC54A\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212765
    m_Localized: "\uD55C\uB3D9\uC548 \uB458 \uB2E4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uC88B\uC740 \uCABD\uC758 \uCE68\uBB35\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212764
    m_Localized: "\uBC24\uC0C8 \uB208\uC774 \uC654\uB2E4. \uBC1C\uC790\uAD6D \uD558\uB098 \uC5C6\uB294 \uC6B4\uB3D9\uC7A5\uC774 \uD558\uC597\uAC8C \uBE5B\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212763
    m_Localized: "\uB2F4\uC694 \uD558\uB098\uB97C \uB458\uC774 \uB098\uB220 \uB36E\uACE0 \uD574\uAC00 \uB4E4 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212762
    m_Localized: "\uCC3D\uC5D0 \uC131\uC5D0\uAC00 \uAF08\uB2E4. \uC190\uAC00\uB77D\uC73C\uB85C \uC774\uB984\uC744 \uC37C\uB2E4\uAC00 \uC9C0\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212761
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uB7F0 \uB0A0\uC5D4 \uC6D0\uB798 \uC18C\uD48D\uC744 \uAC00\uB294 \uAC70\uC57C. \u2026\uB0B4\uB144\uC5D4 \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212760
    m_Localized: "\uD558\uB298\uC774 \uB192\uC558\uB2E4. \uAD6C\uB984 \uD55C \uC810 \uC5C6\uB294 \uC544\uCE68."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212759
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB099\uC5FD \uD558\uB098\uB97C \uC8FC\uC6CC \uAD50\uACFC\uC11C \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407512
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC774\uC57C\uAE30\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407513
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC548 \uB204\uB978 \uAC70, \uC798\uD588\uC5B4. \uC5B8\uC820\uAC00 \uB9C8\uC74C\uAECF \uCE60 \uC218 \uC788\uB294 \uB0A0\uC774 \uC624\uBA74 \uADF8\uB54C \uCE58\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407514
    m_Localized: "\uBC29\uC1A1\uC2E4 \uCC45\uC0C1\uC5D0 \uC6D0\uACE0 \uD55C \uC7A5\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4. '\uD559\uC0DD \uC5EC\uB7EC\uBD84\uC740 \uC9C0\uAE08 \uC788\uB294 \uAD50\uC2E4\uC5D0\uC11C \uB300\uAE30\uD558\uC2ED\uC2DC\uC624.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407515
    m_Localized: "\uADF8 \uC544\uB798\uC5D0 \uD39C\uC73C\uB85C \uAE09\uD558\uAC8C \uB367\uC4F4 \uC904\uC774 \uC788\uC5C8\uB2E4. '\uB300\uAE30 \uCDE8\uC18C. \uC6B4\uB3D9\uC7A5\uC73C\uB85C' \u2014 \uAC70\uAE30\uC11C \uAE00\uC528\uAC00 \uB04A\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212758
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0 \uB099\uC5FD\uC774 \uC313\uC5EC \uC788\uC5C8\uB2E4. \uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uBC14\uC2A4\uB77D\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212757
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uADF8\uB0E5, \uC774\uB807\uAC8C \uC788\uC790. \uD55C \uC2DC\uAC04\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212756
    m_Localized: "\uC544\uCE68\uBD80\uD130 \uBCD5\uC774 \uB728\uAC70\uC6E0\uB2E4. \uBCF5\uB3C4 \uB05D \uCC3D\uBB38\uC744 \uC5F4\uC790 \uBC14\uB78C\uC774 \uD55C \uC904\uAE30 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212755
    m_Localized: "\uC120\uC0DD\uB2D8\uACFC \uB098\uB780\uD788 \uC549\uC544 \uBB3C\uC744 \uD55C \uBAA8\uAE08\uC529 \uB098\uB220 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212754
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB0B4\uB9B0 \uBE44\uB85C \uACF5\uAE30\uAC00 \uC11C\uB298\uD588\uB2E4. \uB9E4\uBBF8\uAC00 \uC6B8\uAE30 \uC2DC\uC791\uD558\uAE30 \uC804\uC758 \uC9E7\uC740 \uC2DC\uAC04."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212753
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCC3D\uAC00\uC5D0 \uC758\uC790\uB97C \uB04C\uC5B4\uB2E4 \uB193\uACE0 \uD55C\uCC38 \uBC14\uAE65\uC744 \uBCF4\uC558\uB2E4. \uC624\uB298\uC740 \uC544\uBB34\uB3C4 \uC11C\uB450\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212752
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uAC00\uC7A5\uC790\uB9AC \uBC9A\uB098\uBB34\uB294 \uAF43\uC774 \uB2E4 \uC9C0\uACE0 \uC78E\uC774 \uC62C\uB77C\uC640 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212751
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0A8\uC740 \uCEE4\uD53C \uBBF9\uC2A4 \uD558\uB098\uB97C \uBC18\uC73C\uB85C \uB098\uB220 \uD0D4\uB2E4. \uBBF8\uC9C0\uADFC\uD588\uC9C0\uB9CC \uB2EC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212750
    m_Localized: "\uB4DC\uBB3C\uAC8C \uC870\uC6A9\uD55C \uC544\uCE68\uC774\uC5C8\uB2E4. \uCC3D\uBC16\uC5D0\uC11C \uCC38\uC0C8\uAC00 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212749
    m_Localized: "\uBC30\uD0C8\uBCF4\uB2E4\uB294 \uB0AB\uB2E4. \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212748
    m_Localized: "\uC544\uAE5D\uC9C0\uB9CC \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212747
    m_Localized: "\uB053\uC774\uACE0 \uB098\uB2C8 \uB0C4\uC0C8\uAC00 \uC0AC\uB77C\uC84C\uB2E4. \uC5F0\uB8CC\uAC00 \uC544\uAE5D\uC9C0\uB9CC \uBB3C\uC774 \uB354 \uADC0\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212746
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uB053\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212745
    m_Localized: "\uB354\uC704 \uD0D3\uC778\uC9C0, \uC694\uC998\uC740 \uBB3C\uC774 \uAE08\uBC29 \uC0C1\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212744
    m_Localized: "\uBB3C\uC744 \uB530\uB974\uB2E4 \uC190\uC774 \uBA48\uCDC4\uB2E4. \uC0C9\uC774 \uC870\uAE08 \uD0C1\uD588\uB2E4. \uB0C4\uC0C8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212743
    m_Localized: "\uBC1B\uC544 \uB454 \uBB3C \uC704\uC5D0 \uC587\uC740 \uB9C9\uC774 \uB5A0 \uC788\uC5C8\uB2E4. \uC190\uAC00\uB77D\uC744 \uB300\uC790 \uBBF8\uB048\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212742
    m_Localized: "\uBB3C\uD1B5\uC5D0\uC11C \uC774\uC0C1\uD55C \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212741
    m_Localized: "\uC62E\uAE30\uB2E4 \uC0C1\uC790 \uD558\uB098\uB97C \uB5A8\uC5B4\uB728\uB838\uB2E4. \uADF8\uB798\uB3C4 \uB098\uBA38\uC9C0\uB294 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212740
    m_Localized: "\uC2DD\uB7C9\uC744 \uB192\uC740 \uACF3\uC73C\uB85C \uC62E\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212739
    m_Localized: "\uB36B\uC740 \uBE44\uC5B4 \uC788\uC5C8\uACE0, \uC0C1\uC790\uB294 \uB354 \uB9CE\uC774 \uAC09\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212738
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uB36B\uC774 \uC81C \uC5ED\uD560\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212737
    m_Localized: "\uB36B\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212736
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800 \uB140\uC11D\uB4E4, \uC6B0\uB9AC\uBCF4\uB2E4 \uC5EC\uAE30\uC11C \uC624\uB798 \uC0B0 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407516
    m_Localized: "\uB9C8\uC774\uD06C \uC804\uC6D0\uC740 \uAEBC\uC838 \uC788\uC5C8\uB2E4. \uC6D0\uACE0\uB97C \uC811\uC5B4 \uB4E4\uACE0 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407517
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB0A0 \uC544\uCE68 \uBC29\uC1A1, \uB098\uB3C4 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407518
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6D0\uACE0\uB97C \uBC1B\uC544 \uB4E4\uACE0, \uC624\uB798 \uD3B4 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407519
    m_Localized: "\uD55C\uB0AE\uC758 \uC5F4\uAE30\uAC00 \uCC3D\uACE0 \uC548\uAE4C\uC9C0 \uB4E4\uC5B4\uCC3C\uB2E4. \uC2DD\uB7C9 \uC0C1\uC790\uC5D0\uC11C \uC270\uB0B4\uAC00 \uC62C\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407520
    m_Localized: "\uB354\uC704\uAC00 \uBA70\uCE60\uC9F8 \uC774\uC5B4\uC84C\uB2E4. \uBC18\uCC2C \uD1B5 \uB69C\uAED1\uC744 \uC5F4\uC790\uB9C8\uC790 \uB2E4\uC2DC \uB2EB\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407521
    m_Localized: "\uC18C\uAE08\uC5D0 \uC808\uC5EC \uC0B4\uB824 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212735
    m_Localized: "\uC120\uBC18 \uC544\uB798 \uAE4C\uB9CC \uC54C\uAC31\uC774\uAC00 \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uB610 \uC950\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212734
    m_Localized: "\uBC24\uC0C8 \uCC9C\uC7A5 \uC704\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB6F0\uC5B4\uB2E4\uB2C8\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uC300 \uBD09\uC9C0\uC5D0 \uAD6C\uBA4D\uC774 \uB098 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212733
    m_Localized: "\uC2DD\uB7C9 \uC0C1\uC790 \uBAA8\uC11C\uB9AC\uAC00 \uAC09\uD600 \uC788\uC5C8\uB2E4. \uC950\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212732
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC751. \uC5EC\uAE30 \uC788\uC5B4. \uBB38 \uC5F4\uB824 \uC788\uC5B4. \uBD10, \uC5F4\uB824 \uC788\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212731
    m_Localized: "\uC120\uC0DD\uB2D8\uC744 \uAE68\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212730
    m_Localized: "\uAE00\uB85C \uC4F0\uACE0 \uB098\uB2C8 \uC870\uAE08 \uC791\uC544\uC84C\uB2E4. \uAFC8\uC740 \uAFC8\uC77C \uBFD0\uC774\uB77C\uACE0 \uB9C8\uC9C0\uB9C9 \uC904\uC5D0 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212729
    m_Localized: "\uC77C\uAE30\uC7A5\uC5D0 \uAFC8\uC744 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212728
    m_Localized: "\uB208\uC744 \uB5B4\uC744 \uB54C \uC228\uC774 \uAC00\uBE74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407522
    m_Localized: "\uC18C\uAE08\uC744 \uC544\uB07C\uC9C0 \uC54A\uC558\uB2E4. \uC9DC\uAE34 \uD574\uB3C4 \uBA70\uCE60\uC740 \uB354 \uBA39\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407523
    m_Localized: "\uC808\uC774\uB294 \uC0AC\uC774\uC5D0\uB3C4 \uC0C1\uD558\uB294 \uAC8C \uB354 \uBE68\uB790\uB2E4. \uC870\uAE08\uB9CC \uAC74\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407524
    m_Localized: "\uC0C1\uD55C \uAC83\uC744 \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407525
    m_Localized: "\uC544\uAE5D\uC9C0\uB9CC, \uC774 \uB354\uC704\uC5D0 \uBC30\uD0C8\uC774 \uB098\uBA74 \uB354 \uD070\uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212727
    m_Localized: "\uB610 \uADF8 \uCC3D\uACE0 \uAFC8\uC774\uC5C8\uB2E4. \uBB38 \uBC16\uC758 \uC6C3\uC74C\uC18C\uB9AC. \uC190\uC7A1\uC774\uB97C \uC544\uBB34\uB9AC \uB3CC\uB824\uB3C4 \uC5F4\uB9AC\uC9C0 \uC54A\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212726
    m_Localized: "\uBE57\uBB3C\uC740 \uC815\uC218\uD558\uBA74 \uC4F8 \uC218 \uC788\uB2E4. \uBC24\uC0C8 \uC591\uB3D9\uC774\uB97C \uAC08\uC544 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212725
    m_Localized: "\uC591\uB3D9\uC774\uB85C \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212724
    m_Localized: "\uBE44\uB2D0\uC774 \uBB34\uAC8C\uB97C \uBABB \uC774\uAE30\uACE0 \uD130\uC84C\uB2E4. \uC790\uC7AC\uB9CC \uB0A0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212723
    m_Localized: "\uD14C\uC774\uD504\uC640 \uBE44\uB2D0\uB85C \uB9C9\uC558\uB2E4. \uAF64 \uADF8\uB7F4\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212722
    m_Localized: "\uCC9C\uC7A5\uC744 \uACE0\uCCD0 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212721
    m_Localized: "\uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C \uB2E4\uB978 \uC18C\uB9AC\uAC00 \uC11E\uC600\uB2E4. \uAD50\uC2E4 \uB4A4\uD3B8 \uBC14\uB2E5\uC5D0 \uBB3C\uC774 \uACE0\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212720
    m_Localized: "\uCC9C\uC7A5 \uC5BC\uB8E9\uC774 \uD558\uB8FB\uBC24 \uC0C8 \uB450 \uBC30\uB85C \uBC88\uC84C\uB2E4. \uB611, \uB611. \uBB3C\uBC29\uC6B8\uC774 \uCC45\uC0C1 \uC704\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212719
    m_Localized: "\uBC24\uC0C8 \uBE44\uAC00 \uC654\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0C8\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212718
    m_Localized: "\uB458\uC740 \uD55C\uCC38 \uB9D0\uC5C6\uC774 \uD558\uB298\uB9CC \uBCF4\uC558\uB2E4. \uB0B4\uB824\uAC00\uB294 \uACC4\uB2E8\uB3C4 \uC5F4\uC5EC\uC12F \uCE78\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212717
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD88\uC774 \uB2E4 \uAEBC\uC9C0\uB2C8\uAE4C \uBCC4\uC774 \uBCF4\uC774\uB124. \uC88B\uC740 \uC77C\uC740 \uC544\uB2CC\uB370. \uADF8\uB798\uB3C4 \uBCF4\uC774\uAE34 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212716
    m_Localized: "\uBA40\uB9AC \uD55C \uAD70\uB370, \uC544\uC8FC \uC791\uC740 \uBD88\uBE5B\uC774 \uAE5C\uBE61\uC774\uB2E4 \uAEBC\uC84C\uB2E4. \uB458 \uB2E4 \uBCF4\uC558\uACE0, \uB458 \uB2E4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212715
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uC11C \uBCC4 \uC774\uB984\uC740 \uADF8\uAC70 \uD558\uB098\uBC16\uC5D0 \uBAB0\uB77C. \uBCC4 \uBCF4\uACE0 \uC4F4 \uC2DC\uB294 \uBA87 \uD3B8 \uC544\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212714
    m_Localized: "{0}: \uC120\uC0DD\uB2D8 \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212713
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAE30 \uAD6D\uC790 \uBAA8\uC591 \uBCF4\uC5EC? \uAD6D\uC790 \uB05D \uB450 \uBCC4\uC744 \uC774\uC5B4\uC11C \uB2E4\uC12F \uBC30\uCBE4 \uAC00\uBA74 \uBD81\uADF9\uC131\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407526
    m_Localized: "\uBC24\uC0C8 \uC624\uD55C\uC774 \uB0AC\uB2E4. \uB2F4\uC694\uB97C \uB450 \uACB9 \uB36E\uC5B4\uB3C4 \uC774\uAC00 \uB531\uB531 \uBD80\uB52A\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407527
    m_Localized: "\uBAA9\uC774 \uB530\uB054\uAC70\uB9AC\uB354\uB2C8 \uBAB8\uC774 \uBB34\uAC70\uC6CC\uC84C\uB2E4. \uD55C\uD30C\uAC00 \uBAB8\uC18D\uAE4C\uC9C0 \uB4E4\uC5B4\uC628 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407528
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F4 \uB098\uB294\uAD6C\uB098. \uC624\uB298\uC740 \uBB34\uB9AC\uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407529
    m_Localized: "\uC57D\uC744 \uBA39\uACE0 \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407530
    m_Localized: "\uC57D\uC744 \uC0BC\uD0A4\uACE0 \uB2F4\uC694 \uC18D\uC5D0\uC11C \uB540\uC744 \uD758\uB838\uB2E4. \uC0C8\uBCBD\uB158\uC5D0 \uC5F4\uC774 \uB0B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407531
    m_Localized: "\uC57D\uC744 \uC544\uB07C\uACE0 \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407532
    m_Localized: "\uC57D\uC740 \uB354 \uC544\uD50C \uB54C\uB97C \uC704\uD574 \uB0A8\uACA8 \uB450\uC5C8\uB2E4. \uAE34 \uBC24\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407533
    m_Localized: "\uBC24\uC0C8 \uB0B4\uB9B0 \uBE44\uC5D0 \uAD50\uC2E4 \uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0DC\uB2E4. \uB9E4\uD2B8\uB9AC\uC2A4 \uD55C\uCABD\uC774 \uC816\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407534
    m_Localized: "\uBE57\uC904\uAE30\uAC00 \uAD75\uC5B4\uC9C0\uC790 \uCC3D\uD2C0 \uC544\uB798\uB85C \uBB3C\uC774 \uC2A4\uBA70\uB4E4\uC5C8\uB2E4. \uBC14\uB2E5\uC5D0 \uAC78\uB808\uB97C \uAE54\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407535
    m_Localized: "\uCC9C\uC7A5 \uBAA8\uC11C\uB9AC\uC5D0\uC11C \uBB3C\uBC29\uC6B8\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uC5D0 \uC7A0\uC774 \uAE7C\uB2E4. \uB611, \uB611, \uB611."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407536
    m_Localized: "\uC9C0\uBD95\uC744 \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407537
    m_Localized: "\uC790\uC7AC\uB97C \uB367\uB300 \uC0C8\uB294 \uACF3\uC744 \uB9C9\uC558\uB2E4. \uC774\uBC88 \uC7A5\uB9C8\uB294 \uBC84\uD2F8 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407538
    m_Localized: "\uC591\uB3D9\uC774\uB85C \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212712
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC18D \uC9C0\uCF30\uC9C0? \uBAA9\uBC1C \uC9DA\uACE0 \uC81C\uC77C \uBA3C\uC800 \uC625\uC0C1\uC5D0 \uC62C\uB77C\uC624\uACA0\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212711
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC11C\uC6B8\uC5D0\uC11C \uC774\uB7F0 \uD558\uB298\uC744 \uBCFC \uC904\uC740 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212710
    m_Localized: "\uBD88 \uAEBC\uC9C4 \uB3C4\uC2DC \uC704\uB85C \uBCC4\uC774 \uC3DF\uC544\uC9C8 \uB4EF \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212709
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB09C\uAC04\uC744 \uBD99\uC7A1\uACE0 \uC55E\uC7A5\uC130\uB2E4. \uC625\uC0C1 \uACC4\uB2E8\uC740 \uC5F4\uC5EC\uC12F \uCE78. \uC26C\uBA74\uC11C \uC138 \uBC88 \uB9CC\uC5D0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212708
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC55E\uC7A5\uC130\uB2E4. \uC625\uC0C1 \uACC4\uB2E8\uC740 \uC5F4\uC5EC\uC12F \uCE78. \uC26C\uBA74\uC11C \uC138 \uBC88 \uB9CC\uC5D0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212707
    m_Localized: "\uC774\uBD88\uC744 \uB04C\uC5B4 \uC62C\uB838\uB2E4. \uB9D0\uD558\uC9C0 \uC54A\uC740 \uC774\uB984\uC774 \uD55C\uCC38 \uC785\uC548\uC5D0 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212706
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB9D0\uD558\uACE0 \uC2F6\uC744 \uB54C \uB9D0\uD574. \uB098\uB294 \uACC4\uC18D \uC5EC\uAE30 \uC788\uC744 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212705
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB450 \uD1B5. \uC544\uCE68\uC5D0 \uAC19\uC774 \uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407539
    m_Localized: "\uC591\uB3D9\uC774\uAC00 \uAE08\uBC29 \uCC3C\uB2E4. \uC815\uC218\uD558\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407540
    m_Localized: "3\uC6D4 \uB458\uC9F8 \uC8FC, \uC6D4\uC694\uC77C \uC544\uCE68."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407541
    m_Localized: "\uAD50\uBCF5 \uC7AC\uD0B7\uC774 \uC544\uC9C1 \uBAB8\uC5D0 \uB35C \uB9DE\uB294\uB2E4. \uACE0\uB4F1\uD559\uAD50\uC5D0 \uB4E4\uC5B4\uC628 \uC9C0 \uACA8\uC6B0 \uC77C\uC8FC\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407542
    m_Localized: "\uC8FC\uBA38\uB2C8 \uC18D \uD734\uB300\uD3F0\uC774 \uC9E7\uAC8C \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407543
    m_Localized: "\uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uB2EC\uB824\uC624\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407544
    m_Localized: "{0}: \uC57C, {1}! \uAC19\uC774 \uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212704
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212703
    m_Localized: "{0}: \u2026\uB0B4\uC77C \uBB3C\uC740 \uBA87 \uD1B5 \uBC1B\uC544\uC57C \uD574\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212702
    m_Localized: "\uB2E4\uB978 \uC774\uC57C\uAE30\uB97C \uAEBC\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212701
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC740 \uCE5C\uAD6C\uB124. \uAF2D \uB2E4\uC2DC \uB9CC\uB098\uC11C, \uB5A1\uBCF6\uC774 \uC0AC \uC918. \uB2A6\uC740 \uB2F5\uC7A5 \uAC12\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212700
    m_Localized: "{0}: \u2026\uB2F5\uC7A5 \uB290\uB9B0 \uC560\uC694. \uADF8\uB798\uB3C4 \uB5A1\uBCF6\uC774\uB294 \uAF2D \uAC19\uC774 \uBA39\uB294 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212699
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB294 \uB124 \uC598\uAE30\uB97C \uC5B4\uB5BB\uAC8C \uD560\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212698
    m_Localized: "\uB9D0\uD558\uB2E4 \uBCF4\uB2C8 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212697
    m_Localized: "\uC2DC\uD5D8 \uC804\uB0A0\uC774\uBA74 '\uC624\uB298\uC758 \uC6B4\uC138'\uAC00 \uB098\uC058\uB2E4\uACE0 \uACF5\uBD80\uB97C \uC811\uB358 \uC560. \uADF8\uB7EC\uACE0\uB294 \uB098\uBCF4\uB2E4 \uC798 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213157
    m_Localized: "\uB2E4\uC74C\uC5D0 \uC8FC\uD0DD\uAC00\uC5D0 \uAC08 \uB54C \uAC19\uC774 \uB4E4\uB974\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213156
    m_Localized: "\uB3C4\uD604: \uD55C \uBC88\uB9CC\u2026 \uD55C \uBC88\uB9CC \uAC00 \uBCF4\uBA74 \uC548 \uB3FC\uC694? \uD63C\uC790 \uAC00\uACA0\uB2E4\uB294 \uAC70 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213155
    m_Localized: "\uB3C4\uD604: \uC5C4\uB9C8\uAC00 \uADF8\uB0A0 \uC544\uCE68\uC5D0 \uB3C4\uC2DC\uB77D \uC2F8 \uC92C\uAC70\uB4E0\uC694. \uADF8\uAC8C \uB9C8\uC9C0\uB9C9\uC774\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213154
    m_Localized: "\uB3C4\uD604: \uB204\uB098. \uC800\uAE30, \uBE68\uAC04 \uC9C0\uBD95 \uBCF4\uC774\uC8E0? \uADF8 \uB4A4\uC5D0 \uC6B0\uB9AC \uC9D1 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213153
    m_Localized: "\uBC24. \uB3C4\uD604\uC774 \uCC3D\uAC00\uC5D0 \uC549\uC544 \uC0C8\uBCBD\uB3D9 \uCABD\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213152
    m_Localized: "\uC190\uAC00\uB77D\uC744 \uC811\uC73C\uBA70 \uC138\uC5C8\uB2E4. \uC811\uC744 \uB54C\uB9C8\uB2E4 \uC870\uAE08\uC529 \uC6C3\uC74C\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213151
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC5D0 \uC6B0\uB9AC\uB294 \uB458\uC774\uC5C8\uC5B4. \uC9C0\uAE08\uC740 \uBA87 \uBA85\uC778\uC9C0 \uC138\uC5B4 \uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213150
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310 \uB300\uC2E0 \uD558\uB298\uC744 \uAC00\uB9AC\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407373
    m_Localized: "\uB099\uC5FD\uC744 \uC0B0\uCC98\uB7FC \uC313\uC544 \uB193\uACE0 \uADF8 \uC704\uB85C \uB6F0\uC5B4\uB4E4\uC5C8\uB2E4. \uBC14\uC2A4\uB77D \uC18C\uB9AC\uAC00 \uC628\uBAB8\uC744 \uB36E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407374
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC5B4 \uC6C3\uC5C8\uB2E4. \uC6C3\uACE0 \uB098\uC11C \uC2A4\uC2A4\uB85C \uB180\uB780 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407375
    m_Localized: "\uAC00\uC7A5 \uBD89\uC740 \uC78E \uD558\uB098\uB97C \uACE8\uB77C \uC77C\uAE30\uC7A5 \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213149
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: 2\uB9C9 \uD3C9\uAC00 \uC2DC\uAC04\uC774\uB2E4. \uB18D\uB2F4\uC774\uC57C. \uBC18\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213148
    m_Localized: "\uC2B5\uACA9\uC744 \uBC84\uD2F4 \uD559\uAD50 \uC704\uB85C \uBCC4\uC774 \uC3DF\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213147
    m_Localized: "\uC5EC\uB984\uC758 \uB9C8\uC9C0\uB9C9 \uBC24. \uC625\uC0C1\uC5D0 \uBAA8\uB450 \uBAA8\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213146
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uBC24\uC774 \uACE0\uBE44\uB2E4. \uB2E4\uB4E4, \uC81C\uC790\uB9AC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213145
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC18C\uB9AC\uB97C \uB4E3\uACE0 \uC628 \uAC70\uC57C. \uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uC57D\uD574\uC9C4 \uAC78 \uC544\uB294 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213144
    m_Localized: "\uD0DC\uD48D\uC774 \uC9C0\uB098\uAC04 \uB2E4\uC74C \uB0A0 \uBC24. \uD759\uD0D5\uBB3C\uC5D0 \uC4F8\uB824 \uC628 \uAC83\uB4E4\uC774 \uD559\uAD50 \uB2F4\uC7A5 \uC544\uB798\uB85C \uBAA8\uC5EC\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213143
    m_Localized: "\uBB34\uC11C\uC6E0\uB2E4. \uADF8\uB798\uB3C4 \uC606\uC5D0 \uB204\uAD70\uAC00\uC758 \uC5B4\uAE68\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213142
    m_Localized: "\uB2F4\uC694\uB97C \uB4A4\uC9D1\uC5B4\uC4F0\uACE0 \uC9C0\uB098\uAC00\uAE30\uB97C \uAE30\uB2E4\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407376
    m_Localized: "\uB4B7\uC0B0 \uB2E8\uD48D\uAE38\uC744 \uC624\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407377
    m_Localized: "\uB2A5\uC120\uAE4C\uC9C0 \uC624\uB974\uC790 \uC0B0 \uC804\uCCB4\uAC00 \uBD88\uBD99\uC740 \uAC83\uCC98\uB7FC \uBD89\uC5C8\uB2E4. \uBC24\uACFC \uB3C4\uD1A0\uB9AC\uB97C \uC8FC\uBA38\uB2C8 \uAC00\uB4DD \uC8FC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213141
    m_Localized: "\uB450\uAEBC\uC6B4 \uCCB4\uC721\uAD00 \uBCBD \uB108\uBA38\uB85C \uBC14\uB78C \uC18C\uB9AC\uAC00 \uBA40\uAC8C \uB4E4\uB838\uB2E4. \uB9E4\uD2B8 \uC704\uC5D0 \uBAA8\uC5EC \uC549\uC544 \uC544\uCE68\uC744 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213140
    m_Localized: "\uBAA8\uB450 \uCCB4\uC721\uAD00\uC73C\uB85C \uD53C\uC2E0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213139
    m_Localized: "\uC816\uC740 \uCC45\uC0C1\uC744 \uB2E4\uC2DC \uC313\uACE0 \uB048\uC73C\uB85C \uBB36\uC5C8\uB2E4. \uD574 \uB730 \uBB34\uB835\uC5D0\uC57C \uACA8\uC6B0 \uB05D\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213138
    m_Localized: "\uBC24\uC0C8 \uBB34\uB108\uC9C4 \uACF3\uC744 \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213137
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB4E4 \uAD1C\uCC2E\uC544? \uCC3D\uAC00\uC5D0\uC11C \uB5A8\uC5B4\uC838!"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213136
    m_Localized: "\uAD50\uC2E4 \uCC3D\uBB38 \uD558\uB098\uAC00 \uAE68\uC9C0\uBA74\uC11C \uBE57\uBB3C\uC774 \uB4E4\uC774\uCCE4\uB2E4. \uBC14\uB9AC\uCF00\uC774\uB4DC \uD55C\uCABD\uC774 \uBB34\uB108\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213135
    m_Localized: "\uBC24\uC0C8 \uBC14\uB78C\uC774 \uD559\uAD50\uB97C \uD754\uB4E4\uC5C8\uB2E4. \uD0DC\uD48D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213134
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407378
    m_Localized: "\uADF8 \uC21C\uAC04\uB9CC\uD07C\uC740, \uC544\uBB34\uAC83\uB3C4 \uBB34\uC12D\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407379
    m_Localized: "\uB0B4\uB824\uC624\uB294 \uAE38\uC5D0 \uBC1C\uBAA9\uC744 \uC811\uC9C8\uB800\uB2E4. \uC808\uB69D\uC774\uBA70 \uB3CC\uC544\uC624\uB294 \uAE38\uC774 \uB450 \uBC30\uB85C \uAE38\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213133
    m_Localized: "\uCEF5\uC744 \uB0B4\uB824\uB193\uB294 \uC18C\uB9AC\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213132
    m_Localized: "\uB2E4\uC2DC\uB294 \uADF8 \uC598\uAE30 \uD558\uC9C0 \uB9D0\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213131
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0 \uBA3C\uC800 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213130
    m_Localized: "{0}: \uB098\uC911\uC5D0. \uB0B4\uAC00 \uC900\uBE44\uB418\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213129
    m_Localized: "\uC544\uC9C1\uC740 \uB4E3\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213128
    m_Localized: "{0}: \uC6A9\uC11C\uD55C\uB2E4\uB294 \uB9D0\uC740 \uBABB \uD574. \uC544\uC9C1\uC740. \uADF8\uB798\uB3C4 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213127
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uC6B8\uAE30 \uC2DC\uC791\uD588\uB2E4. \uB098\uB294 \uC6B8\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213126
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407380
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8 \uC0AC\uB78C\uB4E4\uACFC \uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uBC14\uBE44\uD050\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407381
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uC22F\uACFC \uACE0\uAE30 \uD1B5\uC870\uB9BC\uC744 \uAC00\uC838\uC654\uB2E4. \uC6B0\uB9AC\uB294 \uC300\uACFC \uAE40\uCE58\uB97C \uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213125
    m_Localized: "\uC1A1\uC608\uC9C0: \uD558\uB9B0\uC774\uB294 \uC0B4\uC544 \uC788\uC5B4. \uB9C8\uD2B8 \uCABD\uC5D0 \uC5B4\uB978\uB4E4\uC774\uB791 \uAC19\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213124
    m_Localized: "\uC1A1\uC608\uC9C0: \uBB34\uC11C\uC6E0\uC5B4. \uD558\uB9B0\uC774\uD55C\uD14C \uCC0D\uD788\uB294 \uAC8C. \uADF8\uB798\uC11C \uADF8\uB0E5\u2026 \uC9D1\uC5D0 \uAC14\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213123
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8\uB54C, \uB098 \uB2E4 \uBD24\uC5B4. \uCC3D\uACE0 \uBB38 \uB2EB\uB294 \uAC83\uB3C4. \uB108 \uC548\uC5D0\uC11C \uBB38 \uB450\uB4DC\uB9AC\uB294 \uC18C\uB9AC\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213122
    m_Localized: "\uC1A1\uC608\uC9C0: \uD560 \uB9D0\uC774 \uC788\uC5B4. \u2026\uB4E3\uAE30 \uC2EB\uC73C\uBA74 \uC548 \uB4E4\uC5B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213121
    m_Localized: "\uBC24. \uAE09\uC2DD\uC2E4\uC5D0\uC11C \uBB3C\uC744 \uB9C8\uC2DC\uB294\uB370 \uC1A1\uC608\uC9C0\uAC00 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213120
    m_Localized: "\uBBF8\uC6CC\uD558\uB294 \uB9C8\uC74C\uACFC \uBD88\uC30D\uD55C \uB9C8\uC74C\uC774 \uD55C \uD398\uC774\uC9C0\uC5D0 \uAC19\uC774 \uC801\uD614\uB2E4. \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213119
    m_Localized: "\uADF8 \uC560 \uC0DD\uAC01\uC744 \uC77C\uAE30\uC5D0 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213118
    m_Localized: "\uADF8 \uBB34\uB9AC \uC606\uC5D0 \uB298 \uC11C \uC788\uB358 \uC544\uC774. \uC6C3\uC9C0\uB3C4, \uB9D0\uB9AC\uC9C0\uB3C4 \uC54A\uB358 \uC544\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407382
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uAD50 \uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uACE0\uAE30\uB97C \uAD7D\uB2E4\uB2C8. \uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uBA74 \uAE30\uC808\uD558\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407383
    m_Localized: "\uC5B4\uB978\uB4E4\uACFC \uC544\uC774\uB4E4\uC774 \uD55C \uBD88 \uC55E\uC5D0 \uB458\uB7EC\uC549\uC558\uB2E4. \uC5F0\uAE30\uAC00 \uD558\uB298\uB85C \uACE7\uAC8C \uC62C\uB77C\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407384
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uBD88 \uBC18\uB300\uD3B8\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uAC74\uB128 \uACE0\uAE30\uB97C \uBC1B\uC544 \uB4E4\uACE0, \uC624\uB798 \uCCD0\uB2E4\uBCF4\uB2E4\uAC00 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407385
    m_Localized: "\uBC24\uC0C8 \uB208\uC774 \uB0B4\uB838\uB2E4. \uC6B4\uB3D9\uC7A5\uC774 \uCC98\uC74C \uBCF4\uB294 \uACF3\uCC98\uB7FC \uD558\uC5AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407386
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uB2F4\uC694\uB97C \uB450\uB974\uACE0 \uCC3D\uAC00\uC5D0 \uC549\uC558\uB2E4. \uC190\uC744 \uD754\uB4E4\uC5B4 \uC6B0\uB9AC\uB97C \uB0B4\uBCF4\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213117
    m_Localized: "\uC9C0\uD558\uCCA0\uC5ED\uC5D0\uC11C \uBCF8 \uC5BC\uAD74\uC774 \uACC4\uC18D \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213116
    m_Localized: "\uD1B5\uC870\uB9BC \uC138 \uAC1C\uB97C \uAC74\uB138\uB2E4. \uC1A1\uC608\uC9C0\uB294 \uBC1B\uC544 \uB4E4\uACE0 \uD55C\uCC38 \uC11C \uC788\uB2E4\uAC00 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213115
    m_Localized: "{0}: \uC5EC\uAE30\uB294 \uC548 \uB3FC. \uBBF8\uC548\uD574. \u2026\uC544\uB2C8, \uBBF8\uC548\uD558\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213114
    m_Localized: "\uBB3C\uC790\uB97C \uB098\uB220 \uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213113
    m_Localized: "\uADF8\uB0A0 \uBC24\uC740 \uC7A0\uC774 \uC798 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213112
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uB208\uC744 \uB9C8\uC8FC\uCE58\uC9C0\uB294 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213111
    m_Localized: "{0}: \uADDC\uCE59\uC740 \uC9C0\uCF1C. \uADF8\uAC70\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213110
    m_Localized: "\uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB3C4 \uB41C\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407387
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB208 \uC624\uB294 \uB0A0 \uAD50\uC2E4\uC5D0 \uC549\uC544 \uC788\uB294 \uAC74 \uC8C4\uC57C. \uB098\uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407388
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0 \uB208\uC0AC\uB78C\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407389
    m_Localized: "\uB208\uC744 \uAD74\uB9AC\uACE0 \uAD74\uB838\uB2E4. \uBA38\uB9AC\uB97C \uC62C\uB9AC\uB294 \uB370 \uB458\uC774 \uD544\uC694\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213109
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC774\uCABD\uC744 \uBCF4\uC558\uB2E4. \uC774\uBC88\uC5D0\uB3C4 \uB124\uAC00 \uC815\uD558\uB77C\uB294 \uB208\uBE5B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213108
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uB098, \uB4E4\uC5B4\uAC00\uB3C4 \uB3FC? \uC815\uB9D0\uB85C?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213107
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0\uC11C \uADF8 \uC560\uAC00 \uCC98\uC74C \uC785\uC744 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213106
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uD559\uAD50\uC5D0 \uC624\uB294 \uB0B4\uB0B4 \uD55C\uB9C8\uB514\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB0B4 \uB4A4\uB97C \uBC18 \uBC1C\uC9DD \uB5A8\uC5B4\uC838 \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213105
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uC218\uC7A5 \uBC29\uD5A5\uC774\uB77C\u2026 \uC65C \uD558\uD544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213104
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC774\uC57C\uAE30\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC624\uB798 \uC0DD\uAC01\uC5D0 \uC7A0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213103
    m_Localized: "\uBAA9\uC18C\uB9AC\uB294 \uAC70\uAE30\uC11C \uB04A\uACBC\uB2E4. \uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uBB34\uC5B4\uB77C \uC678\uCE58\uB294 \uC18C\uB9AC\uAC00 \uC9E7\uAC8C \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213102
    m_Localized: "\uC548\uB0B4 \uBC29\uC1A1: \u2026\uC815\uC218\uC7A5 \uBC29\uD5A5 \uC5F4\uCC28\uB294 \uC6B4\uD589\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uBC18\uBCF5\uD569\uB2C8\uB2E4. \uC815\uC218\uC7A5 \uBC29\uD5A5\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407390
    m_Localized: "\uB2E8\uCD94 \uB300\uC2E0 \uBCD1\uB69C\uAED1, \uCF54\uB294 \uC5F0\uD544. \uBAA9\uB3C4\uB9AC\uB294 \uB0B4 \uAC83\uC744 \uD480\uC5B4 \uAC10\uC544 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407391
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC0AC\uB78C \uC606\uC5D0 \uC791\uC740 \uB208\uC0AC\uB78C\uC744 \uD558\uB098 \uB354 \uB9CC\uB4E4\uC5C8\uB2E4. \uC5C4\uB9C8 \uAC70\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407392
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uD574 \uB728\uB294 \uAC78 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407393
    m_Localized: "\uC0C8\uBCBD, \uC625\uC0C1 \uBB38\uC744 \uC5F4\uC790 \uC228\uC774 \uD558\uC597\uAC8C \uC5BC\uC5C8\uB2E4. \uB3D9\uCABD \uD558\uB298 \uB05D\uC774 \uC544\uC8FC \uCC9C\uCC9C\uD788 \uBD89\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407394
    m_Localized: "\uD574\uAC00 \uB2E4 \uB5A0\uC624\uB97C \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uAC19\uC740 \uAC78 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407395
    m_Localized: "\uC5BC\uC5B4\uBD99\uC740 \uD558\uCC9C\uC5D0\uC11C \uC370\uB9E4\uB97C \uD0C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407396
    m_Localized: "\uBE44\uB8CC \uD3EC\uB300\uB97C \uAE54\uACE0 \uC5BC\uC74C \uC704\uB97C \uBBF8\uB044\uB7EC\uC84C\uB2E4. \uB118\uC5B4\uC9C0\uACE0 \uC6C3\uACE0, \uB610 \uD0D4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407397
    m_Localized: "\uBCFC\uC774 \uC5BC\uC5BC\uD574\uC9C8 \uB54C\uAE4C\uC9C0 \uB180\uC558\uB2E4. \uB3CC\uC544\uC624\uB294 \uAE38\uC5D0 \uC190\uC774 \uB179\uC9C0 \uC54A\uC544 \uC11C\uB85C \uC785\uAE40\uC744 \uBD88\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407398
    m_Localized: "\uC5BC\uC74C \uAC00\uC7A5\uC790\uB9AC\uAC00 \uAC08\uB77C\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBAB8\uC744 \uB358\uC9C0\uB4EF \uB451\uC73C\uB85C \uBE60\uC838\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213101
    m_Localized: "\uC548\uB0B4 \uBC29\uC1A1: \uC2B9\uAC1D \uC5EC\uB7EC\uBD84\uAED8 \uC54C\uB824 \uB4DC\uB9BD\uB2C8\uB2E4. \uD604\uC7AC \uC2DC \uC804\uC5ED\uC5D0\u2026 \uBC1C\uC5F4 \uC99D\uC0C1\uC774 \uC788\uB294 \uBD84\uC740 \uC5F4\uCC28 \uD0D1\uC2B9\uC744\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213100
    m_Localized: "\uC7AC\uC0DD \uBC84\uD2BC\uC744 \uB204\uB974\uC790 \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uB05D\uC5D0 \uCC28\uBD84\uD55C \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213099
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5ED\uBB34\uC2E4\uC774\uB098 \uB9E4\uC810\uC5D0\uB294 \uC4F8 \uB9CC\uD55C \uAC8C \uC788\uC744 \uAC70\uC57C. \uB0AE\uC5D0\uB3C4 \uC5B4\uB450\uC6B0\uB2C8\uAE4C \uC190\uC804\uB4F1\uC740 \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213098
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uD558\uCCA0\uC5ED\uC774\uB77C\u2026 \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uC774 \uD53C\uD588\uB358 \uACF3\uC774\uC57C. \uADF8\uB9CC\uD07C \uB9CE\uC774 \uB0A8\uC544 \uC788\uACA0\uC9C0. \uC0AC\uB78C\uC774\uB4E0, \uC544\uB2C8\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213097
    m_Localized: "\uD559\uAD50\uC5D0\uC11C \uC2ED \uBD84 \uAC70\uB9AC\uC5D0 \uC0C8\uBCBD\uC5ED\uC774 \uC788\uC5C8\uB2E4. \uC9C0\uD558 2\uCE35, \uB300\uD569\uC2E4\uACFC \uC2B9\uAC15\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213096
    m_Localized: "\uBC24. \uB3C4\uC11C\uAD00\uC5D0\uC11C \uAC00\uC838\uC628 \uC2DC\uB0B4 \uC9C0\uB3C4\uB97C \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213095
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uADF8\uB0A0 \uBC24 \uB0B4 \uB2F4\uC694\uB97C \uD55C \uC7A5 \uB354 \uB36E\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213094
    m_Localized: "{0}: \uAD1C\uCC2E\uC544\uC694. \uADF8\uB0E5 \uBB3C\uAC74\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407399
    m_Localized: "\uD55C\uCABD \uBC1C\uC774 \uC816\uC5C8\uACE0, \uC190\uBC14\uB2E5\uC774 \uC5BC\uC74C\uC5D0 \uC4F8\uB838\uB2E4. \uADF8\uB0A0 \uBC24\uC740 \uC624\uB798 \uB5A8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407400
    m_Localized: "\uC6D0\uB798 \uC774\uBC88 \uC8FC\uB294 2\uD559\uB144 \uC120\uBC30\uB4E4\uC758 \uC218\uD559\uC5EC\uD589 \uC8FC\uAC04\uC774\uC5C8\uB2E4. 1\uD559\uB144\uC740 \uB0B4\uB144\uC774 \uB420 \uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407401
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uB144\uC740 \uBAA8\uB974\uB2C8\uAE4C, \uC62C\uD574 \uAC00\uC790. \uC6B0\uB9AC\uB07C\uB9AC \uC218\uD559\uC5EC\uD589."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407402
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC5EC\uAE30 \uB0A8\uC744\uAC8C. \uB204\uAD70\uAC00\uB294 \uD559\uAD50\uB97C \uC9C0\uCF1C\uC57C\uC9C0. \u2026\uC0AC\uC9C4 \uB300\uC2E0 \uC774\uC57C\uAE30\uB97C \uAC00\uC838\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407403
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C \uB05D\uC5D0 \uACE0\uBB34\uB97C \uC0C8\uB85C \uAC10\uC558\uB2E4. \uBA3C \uAE38\uC744 \uAC08 \uCC44\uBE44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407404
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9B4\uAC8C. \uAC00\uB294 \uAE38\uC774 \uB108\uBB34 \uBA40\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407405
    m_Localized: "\uBC30\uB0AD\uC5D0 \uC774\uD2C0 \uCE58 \uBA39\uC744 \uAC83\uACFC \uBB3C, \uB2F4\uC694\uB97C \uB123\uC5C8\uB2E4. \uD558\uB8FB\uBC24 \uD559\uAD50\uB97C \uBE44\uC6B4\uB2E4\uB294 \uAC8C \uC2E4\uAC10 \uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407406
    m_Localized: "\uAC78\uC5B4\uC11C \uB4B7\uC0B0 \uB108\uBA38 \uC804\uB9DD\uB300\uAE4C\uC9C0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407407
    m_Localized: "\uBC18\uB098\uC808\uC744 \uAC78\uC5C8\uB2E4. \uC228\uC774 \uD131\uAE4C\uC9C0 \uCC3C\uC744 \uB54C \uC804\uB9DD\uB300 \uB09C\uAC04\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407408
    m_Localized: "\uADF8 \uB108\uBA38\uB85C, \uC544\uC8FC \uBA40\uB9AC, \uD68C\uC0C9 \uB760\uCC98\uB7FC \uBC14\uB2E4\uAC00 \uB204\uC6CC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407409
    m_Localized: "\uAE38\uC774 \uBB34\uB108\uC838 \uC788\uC5B4 \uD55C\uCC38 \uB3CC\uC544\uAC14\uB2E4. \uB118\uC5B4\uC9C0\uACE0, \uAE01\uD788\uACE0, \uD574\uAC00 \uAE30\uC6B8\uC5B4\uC11C\uC57C \uC804\uB9DD\uB300\uC5D0 \uB2FF\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213093
    m_Localized: "\uC544\uBB34\uB807\uC9C0 \uC54A\uC740 \uCC99\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213092
    m_Localized: "\uBCF4\uB0BC \uC218 \uC5C6\uB294 \uD3B8\uC9C0. \uADF8\uB798\uB3C4 \uC4F0\uB294 \uB3D9\uC548\uC740 \uAC19\uC774 \uC788\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213091
    m_Localized: "\uC77C\uAE30\uC7A5\uC5D0 {0}\uC5D0\uAC8C \uD3B8\uC9C0\uB97C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213090
    m_Localized: "\uB2E4 \uC6B8\uACE0 \uB098\uB2C8 \uBC30\uAC00 \uACE0\uD320\uB2E4. \uADF8\uAC8C \uC774\uC0C1\uD558\uAC8C \uB2E4\uD589\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213089
    m_Localized: "\uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC11C \uC6B8\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uB4F1\uC744 \uCC9C\uCC9C\uD788 \uB450\uB4DC\uB824 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213088
    m_Localized: "\uC18C\uB9AC \uB0B4\uC5B4 \uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213087
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0 \uC606\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213086
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68, \uB5A1\uBCF6\uC774\uB97C \uBA39\uC790\uACE0 \uD588\uB358 \uBAA9\uC18C\uB9AC\uAC00 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407410
    m_Localized: "\uADF8\uB798\uB3C4 \uBC14\uB2E4\uB294 \uAC70\uAE30 \uC788\uC5C8\uB2E4. \uD68C\uC0C9 \uB760\uCC98\uB7FC, \uC544\uC8FC \uBA40\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407411
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC758 \uD2B8\uB7ED\uC744 \uBE4C\uB824 \uBC14\uB2F7\uAC00\uAE4C\uC9C0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407412
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uD2B8\uB7ED \uC5F4\uC1E0\uB97C \uAC74\uB138\uB2E4. \uAE30\uB984\uC740 \uAF49 \uCC44\uC6CC \uB450\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407413
    m_Localized: "\uC815 \uBC18\uC7A5: \uC218\uD559\uC5EC\uD589\uC774\uB77C\uBA70. \uC560\uB4E4\uC740 \uADF8\uB7F0 \uAC70 \uD574\uC57C \uB3FC. \uB300\uC2E0 \uD760\uC9D1 \uB0B4\uBA74 \uD63C\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213085
    m_Localized: "\uD559\uC0DD\uC99D\uC744 \uC8FC\uC6CC \uC624\uC9C0 \uBABB\uD55C \uC190\uC774 \uC790\uAFB8 \uC8FC\uBA39\uC744 \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213084
    m_Localized: "\uADF8 \uC815\uB958\uC7A5\uC744 \uC9C0\uB098\uC628 \uB4A4\uB85C \uACC4\uC18D \uAC19\uC740 \uC7A5\uBA74\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB04A\uC5B4\uC9C4 \uAC00\uBC29\uB048. \uAE68\uC9C4 \uD654\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213083
    m_Localized: "\uD559\uAD50\uB85C \uB3CC\uC544\uC640\uC11C\uC57C \uAEBC\uB0B4 \uBCFC \uC218 \uC788\uC5C8\uB2E4. \uC0AC\uC9C4 \uC18D {0}\uB294 \uC55E\uBA38\uB9AC\uAC00 \uC870\uAE08 \uC090\uB6A4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213082
    m_Localized: "\uC8FC\uBA38\uB2C8 \uC18D \uD559\uC0DD\uC99D\uC774 \uACC4\uC18D \uC190\uC5D0 \uB2FF\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213081
    m_Localized: "\uCC98\uC74C \uB4E3\uB294 \uCE6D\uCC2C\uC774\uB77C \uC5B4\uB5A4 \uD45C\uC815\uC744 \uC9C0\uC5B4\uC57C \uD560\uC9C0 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213080
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC798\uD558\uB124. \uC190\uC774 \uCC28\uBD84\uD574. \uC758\uC0AC\uB4E4\uC774 \uC81C\uC77C \uBD80\uB7EC\uC6CC\uD558\uB294 \uAC8C \uADF8\uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213079
    m_Localized: "\uC555\uBC15 \uBD95\uB300, \uC9C0\uD608\uC810, \uBD80\uBAA9. \uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC740 \uBE60\uB974\uACE0 \uC815\uD655\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213078
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAD50\uACFC\uC11C\uB294 \uB36E\uC5B4. \uC190\uC73C\uB85C \uBC30\uC6B0\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407414
    m_Localized: "\uBE48 \uB3C4\uB85C\uB97C \uB2EC\uB838\uB2E4. \uCC3D\uBB38\uC744 \uB0B4\uB9AC\uC790 \uBC14\uB78C\uC5D0\uC11C \uC18C\uAE08 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407415
    m_Localized: "\uBAA8\uB798\uC0AC\uC7A5\uC5D0 \uC720\uBAA9\uC744 \uBAA8\uC544 \uC791\uC740 \uBD88\uC744 \uD53C\uC6E0\uB2E4. \uD30C\uB3C4 \uC18C\uB9AC\uAC00 \uBAA8\uB4E0 \uC18C\uB9AC\uB97C \uB36E\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407416
    m_Localized: "\uC804\uB9DD\uB300 \uC544\uB798 \uBC14\uC704 \uADF8\uB298\uC5D0 \uC791\uC740 \uBD88\uC744 \uD53C\uC6E0\uB2E4. \uC800 \uBA40\uB9AC \uBC14\uB2E4 \uCABD \uD558\uB298\uC774 \uC870\uAE08 \uB354 \uC5B4\uB450\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407417
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBD88 \uC606\uC5D0 \uBAA9\uBC1C\uC744 \uB215\uD600 \uB450\uACE0 \uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407418
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC218\uD559\uC5EC\uD589 \uBC24\uC5D4 \uC6D0\uB798 \uC7A0 \uC548 \uC790\uACE0 \uC774\uC57C\uAE30\uD558\uB294 \uAC70\uC57C. \uC120\uC0DD\uB2D8\uC740 \uBAA8\uB978 \uCC99\uD574 \uC8FC\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407419
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC5C6\uB294 \uBC24\uC740 \uCC98\uC74C\uC774\uC5C8\uB2E4. \uB5A0\uB098\uC62C \uB54C \uC120\uC0DD\uB2D8\uC774 \uD55C \uB9D0\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407420
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: (\uB5A0\uB098\uB358 \uC544\uCE68) \uD559\uAD50 \uAC71\uC815\uC740 \uD558\uC9C0 \uB9C8. \uB108\uD76C\uB098 \uC798 \uC790. \u2026\uC544\uB2C8, \uC798 \uB180\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407421
    m_Localized: "\uB3C4\uD604\uC774 \uBD88 \uC55E\uC5D0\uC11C \uAFB8\uBC85\uAFB8\uBC85 \uC878\uB2E4\uAC00, \uAE5C\uC9DD \uB180\uB77C \uAE68\uC11C\uB294 \uC548 \uC7A4\uB2E4\uACE0 \uC6B0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407422
    m_Localized: "\uB098\uC911\uC5D0 \uBB34\uC5C7\uC774 \uB418\uACE0 \uC2F6\uC740\uC9C0 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407423
    m_Localized: "\uCC98\uC74C\uC73C\uB85C '\uB098\uC911'\uC774\uB77C\uB294 \uB9D0\uC744 \uC18C\uB9AC \uB0B4\uC5B4 \uD588\uB2E4. \uB9D0\uD558\uACE0 \uB098\uB2C8, \uADF8\uAC8C \uC815\uB9D0 \uC62C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407424
    m_Localized: "\uB9D0\uC5C6\uC774 \uBCC4\uC744 \uC13C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407425
    m_Localized: "\uBCC4\uC744 \uC138\uB2E4\uAC00 \uBA87 \uBC88\uC774\uB098 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC14C\uB2E4. \uB2E4 \uC140 \uD544\uC694\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407426
    m_Localized: "\uD559\uAD50 \uC9C0\uBD95\uC774 \uBCF4\uC774\uC790 \uC774\uC0C1\uD558\uAC8C \uC228\uC774 \uB193\uC600\uB2E4. \uC9D1\uC5D0 \uC624\uB294 \uAE30\uBD84\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213077
    m_Localized: "\uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213076
    m_Localized: "\uAD1C\uCC2E\uC744 \uAC70\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC5EC\uAE30 \uC788\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213075
    m_Localized: "\uBAA8\uB978 \uCC99\uD558\uACE0 \uB3CC\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213074
    m_Localized: "\uC218\uCCA9 \uCCAB \uC7A5\uC5D0 \uB0A0\uC9DC\uC640 \uCCB4\uC628, \uC0C1\uCC98 \uBAA8\uC591\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213073
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB3C\uB9B0 \uC0AC\uB78C \uC911\uC5D0 \uC774\uB807\uAC8C \uBA40\uCA61\uD55C \uACBD\uC6B0\uB294 \uCC98\uC74C \uBD10. \uADF8\uB7EC\uB2C8\uAE4C \uAE30\uB85D\uD574 \uB458 \uAC70\uC57C. \uB9E4\uC8FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213072
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uB9DD\uC124\uC774\uB2E4\uAC00 \uC218\uCCA9\uC744 \uD3BC\uCCD0 \uBCF4\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213071
    m_Localized: "\uB4E4\uC5B4\uAC00\uC11C \uBB34\uC2A8 \uB73B\uC778\uC9C0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213070
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC6B4\uC774\uB77C\uB294 \uB9D0, \uC800\uB294 \uBCC4\uB85C \uC548 \uBBFF\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407427
    m_Localized: "\uAD50\uBB38 \uC0AC\uC2AC\uC774 \uB04A\uACA8 \uC788\uC5C8\uB2E4. \uCC3D\uACE0 \uBB38\uC9DD\uC774 \uB72F\uACA8 \uC788\uACE0, \uC2DD\uB7C9 \uC0C1\uC790 \uBA87 \uAC1C\uAC00 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407428
    m_Localized: "\uC6B0\uB9AC\uAC00 \uC5C6\uB294 \uB3D9\uC548\uC774\uC5C8\uB2E4. \uB2E4\uB4E4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uCE5C \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407429
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uCC3D\uACE0 \uAD6C\uC11D\uC5D0 \uBAB8\uC744 \uC228\uAE30\uACE0 \uC788\uC5C8\uB2E4. \uC6B0\uB9AC\uB97C \uBCF4\uC790 \uADF8\uC81C\uC57C \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407430
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544. \uBB3C\uAC74\uC740 \uB610 \uAD6C\uD558\uBA74 \uB3FC. \uB108\uD76C\uAC00 \uB3CC\uC544\uC654\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407431
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uC5B4\uC9C0\uB7EC\uC6E0\uB2E4. \uB204\uAD70\uAC00 \uC654\uB2E4\uAC00, \uB9C9\uD600\uC11C \uB3CC\uC544\uAC04 \uD754\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407432
    m_Localized: "\uB0A8\uC544 \uC788\uB358 \uC0AC\uB78C\uB4E4\uC774 \uC9C0\uCF1C \uB0C8\uB2E4. \uADF8 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294 \uB3D9\uC548 \uC190\uC774 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407433
    m_Localized: "\uD559\uAD50\uB294 \uB5A0\uB0A0 \uB54C \uADF8\uB300\uB85C\uC600\uB2E4. \uADF8\uAC8C \uC774\uB807\uAC8C \uACE0\uB9C8\uC6B8 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407434
    m_Localized: "\uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC870\uAC1C\uAECD\uB370\uAE30 \uD558\uB098\uB97C \uAEBC\uB0B4 \uC120\uC0DD\uB2D8 \uCC45\uC0C1\uC5D0 \uC62C\uB824 \uB450\uC5C8\uB2E4. \uAE30\uB150\uD488\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213069
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B4\uC774 \uC88B\uC558\uB358 \uAC70\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213068
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uBB3C\uB9B0 \uAC70, \uB9DE\uC8E0? \uADF8\uB7F0\uB370 \uC5F4\uB3C4 \uC5C6\uACE0, \uC99D\uC0C1\uB3C4 \uC5C6\uACE0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213067
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC0C1\uCC98\uB294 \uAE68\uB057\uD558\uAC8C \uC544\uBB3C\uC5C8\uC5B4\uC694. \uB108\uBB34 \uAE68\uB057\uD574\uC11C \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213066
    m_Localized: "\uBB38\uD2C8\uC73C\uB85C \uB450 \uC0AC\uB78C\uC758 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213065
    m_Localized: "\uBC24. \uBCF4\uAC74\uC2E4\uC5D0\uC11C \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC724 \uC120\uC0DD\uB2D8\uC758 \uB2E4\uB9AC \uBD95\uB300\uB97C \uC0C8\uB85C \uAC10\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213064
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC190\uB4F1\uC758 \uAE01\uD78C \uC790\uAD6D\uC744 \uC18C\uB3C5\uD558\uBA70 \uB9D0\uD588\uB2E4. \uB530\uB054\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213063
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC88B\uC544. \uCCAB \uC218\uC5C5. \uC0C1\uCC98\uB294 \uC228\uAE30\uB294 \uAC8C \uC544\uB2C8\uB77C \uBCF4\uC5EC \uC8FC\uB294 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213062
    m_Localized: "\uC751\uAE09\uCC98\uCE58\uB97C \uAC00\uB974\uCCD0 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213524
    m_Localized: "\uACC1\uC5D0\uC11C \uB3CC\uBCF4\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213523
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB9D0\uB824\uB3C4 \uC548 \uB4E3\uACA0\uC9C0. \uADF8\uB7FC \uC57D\uC18D\uD574. \uC0B4\uC544\uC11C \uB3CC\uC544\uC628\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213522
    m_Localized: "{0}: \uBC29\uBC95\uC774 \uC788\uC744 \uAC70\uC608\uC694. \uC815\uC218\uC7A5\uC774\uB4E0 \uBCD1\uC6D0\uC774\uB4E0, \uC81C\uAC00 \uCC3E\uC544\uC62C\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213521
    m_Localized: "\uCE58\uB8CC\uBC95\uC744 \uCC3E\uACA0\uB2E4\uACE0, \uC5B4\uB514\uB4E0 \uAC00\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213520
    m_Localized: "\uAD6C\uC870\uB300 \uBC29\uC1A1\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uBA38\uB9BF\uC18D\uC5D0\uC11C \uC6B8\uB838\uB2E4. \uAC10\uC5FC\uC790\uB294 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213519
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD734\uBA74\uC774\uB77C\uACE0 \uD588\uC9C0. \uC7A0\uB4E4\uC5B4 \uC788\uB358 \uAC70\uC57C. \uADF8\uB0A0\uBD80\uD130 \uCB49."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213518
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB180\uB77C\uC9C0 \uC54A\uC558\uB2E4. \uB9C8\uCE58 \uC624\uB798 \uAE30\uB2E4\uB9B0 \uC190\uB2D8\uC744 \uB9DE\uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213517
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544. \uACB0\uAD6D \uC654\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213516
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: 39\uB3C4. \uC0C1\uCC98 \uC790\uB9AC\uAC00\u2026 \uB2E4\uC2DC \uBD89\uC5B4\uC84C\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213515
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uCCB4\uC628\uACC4\uB97C \uBCF4\uACE0 \uC5BC\uAD74\uC774 \uAD73\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213514
    m_Localized: "\uCD08\uACA8\uC6B8\uC758 \uBC24. \uC120\uC0DD\uB2D8\uC758 \uAE30\uCE68\uC774 \uBA70\uCE60\uC9F8 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213513
    m_Localized: "\uCD94\uC704\uC640 \uBC30\uACE0\uD514\uC774 \uACB9\uCE5C \uBC24\uC774\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC758 \uAE30\uCE68\uC774 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213512
    m_Localized: "\uC870\uB07C\uB294 \uBB34\uAC70\uC6E0\uC9C0\uB9CC \uC785\uC73C\uB2C8 \uC774\uC0C1\uD558\uAC8C \uB4E0\uB4E0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213511
    m_Localized: "\uCD1D\uAE30 \uBCF4\uAD00\uD568\uC740 \uD145 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uB300\uC2E0 \uBCBD\uC5D0 \uC9C4\uC555\uC6A9 \uC870\uB07C\uC640 \uC0BC\uB2E8\uBD09\uC774 \uAC78\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213510
    m_Localized: "\uBB34\uAE30\uACE0 \uCCA0\uBB38\uC740 \uC1E0\uC9C0\uB81B\uB300 \uB05D\uC5D0\uC11C \uBE44\uBA85\uC744 \uC9C0\uB974\uBA70 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213509
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uC791\uAC8C \uC37C\uB2E4. \uC815\uC218\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213508
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uD558\uCCA0 \uBC29\uC1A1, \uACFC\uD559\uC2E4 \uB178\uD2B8, \uC774 \uC11C\uB958. \uB2E4 \uAC19\uC740 \uACF3\uC744 \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213507
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9 \uCD9C\uC785 \uD1B5\uC81C\u2026 \uC0AC\uD0DC \uB2F7\uC0C8 \uC804\uC774\uC57C. \uB204\uAD70\uAC00\uB294 \uC54C\uACE0 \uC788\uC5C8\uB2E4\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213506
    m_Localized: "\uD30C\uCD9C\uC18C\uC5D0\uC11C \uAC00\uC838\uC628 \uC11C\uB958\uCCA0\uC744 \uC120\uC0DD\uB2D8\uC774 \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213505
    m_Localized: "{0}: \uADF8\uB7EC\uB2C8\uAE4C. \uB108 \uAC19\uC9C0 \uC54A\uC73C\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213504
    m_Localized: "\uCD5C\uD558\uB9B0: \uC65C \uB370\uB824\uC654\uC5B4? \uB098 \uAC19\uC73C\uBA74 \uC548 \uB370\uB824\uC654\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213503
    m_Localized: "\uB2E8\uB458\uC774 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213502
    m_Localized: "\uB2E4\uB978 \uAD50\uC2E4\uC5D0\uC11C \uC7A4\uB2E4. \uADF8\uB798\uB3C4 \uBB38\uC740 \uC7A0\uADF8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213501
    m_Localized: "\uADF8 \uC560\uC640 \uAC70\uB9AC\uB97C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213500
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uADF8 \uB9C8\uC9C0\uB9C9 \uADDC\uCE59\uC744 \uB4E4\uC73C\uBA70 \uC785\uC220\uC744 \uAE68\uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213499
    m_Localized: "\uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uAE30. \uD63C\uC790 \uB098\uAC00\uC9C0 \uC54A\uAE30. \uBA39\uC744 \uAC74 \uAC19\uC774 \uB098\uB204\uAE30. \uADF8\uB9AC\uACE0 \uD558\uB098 \uB354. \uC5EC\uAE30\uC11C\uB294 \uC544\uBB34\uB3C4 \uB204\uAD6C\uB97C \uAC00\uB450\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213498
    m_Localized: "\uBAA8\uB450 \uC55E\uC5D0\uC11C \uADDC\uCE59\uC744 \uB2E4\uC2DC \uC815\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213497
    m_Localized: "\uB3C4\uD604\uC740 \uB098\uB97C \uCCD0\uB2E4\uBD24\uB2E4. \uC1A1\uC608\uC9C0\uB294 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213496
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uD559\uAD50\uC5D0 \uC628 \uCCAB\uB0A0 \uBC24. \uC544\uBB34\uB3C4 \uADF8 \uC560 \uC606\uC5D0 \uC549\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213495
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uD55C\uCC38\uC744 \uCCD0\uB2E4\uBCF4\uB2E4\uAC00, \uC544\uC8FC \uC791\uAC8C \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213494
    m_Localized: "{0}: \uC6B0\uB9AC \uD559\uAD50\uC5D0 \uC640. \uB300\uC2E0 \uADDC\uCE59\uC740 \uB0B4\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213493
    m_Localized: "\uC815 \uBC18\uC7A5\uC758 \uBB34\uB9AC\uB294 \uACE7 \uB2E4\uB978 \uB3C4\uC2DC\uB85C \uB5A0\uB09C\uB2E4\uACE0 \uD588\uB2E4. \uC774 \uC544\uC774\uB294 \uB370\uB824\uAC00\uC9C0 \uC54A\uB294\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213492
    m_Localized: "\uC5EC\uAE30 \uC788\uC73C\uBA74 \uC704\uD5D8\uD558\uB2E4\uACE0, \uD559\uAD50\uB85C \uC624\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213491
    m_Localized: "\uB3CC\uC544\uC11C\uC11C \uAC78\uC5B4 \uB098\uC624\uB294 \uB3D9\uC548 \uD55C \uBC88\uB3C4 \uB4A4\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213490
    m_Localized: "{0}: \uB108\uB97C \uBBF8\uC6CC\uD558\uB294 \uB370 \uB0A8\uC740 \uC2DC\uAC04\uC744 \uC4F0\uACE0 \uC2F6\uC9C0 \uC54A\uC544. \uAC01\uC790 \uC0B4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213489
    m_Localized: "\uAC01\uC790 \uC0B4\uC790\uACE0, \uB2E4\uC2DC\uB294 \uB9C8\uC8FC\uCE58\uC9C0 \uB9D0\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213488
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4. \uCC98\uC74C\uC73C\uB85C \uADF8 \uC560\uC758 \uC815\uC218\uB9AC\uB97C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213487
    m_Localized: "{0}: \uC6A9\uC11C\uD560\uAC8C. \uB124\uAC00 \uBC1B\uC744 \uC790\uACA9\uC774 \uC788\uC5B4\uC11C\uAC00 \uC544\uB2C8\uB77C, \uB0B4\uAC00 \uC774\uAC78 \uB354 \uB4E4\uACE0 \uB2E4\uB2C8\uAE30 \uC2EB\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213486
    m_Localized: "\uC6A9\uC11C\uD55C\uB2E4\uACE0 \uB9D0\uD55C\uB2E4. \uB098\uB97C \uC704\uD574\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213485
    m_Localized: "\uADF8\uB798\uB3C4 \uC228\uC744 \uC26C\uC5C8\uB2E4. \uD558\uB098, \uB458, \uC14B."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407282
    m_Localized: "\uC6D0\uB798\uB77C\uBA74 \uC624\uB298\uC740 \uACE0\uB4F1\uD559\uAD50 \uCCAB \uBAA8\uC758\uACE0\uC0AC \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213484
    m_Localized: "\uC190\uC774 \uB5A8\uB838\uB2E4. \uCC3D\uACE0 \uBB38 \uB108\uBA38\uB85C \uB4E4\uB9AC\uB358 \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB9AC\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213483
    m_Localized: "\uCD5C\uD558\uB9B0: \uADF8\uB0A0 \uADF8\uB0E5\u2026 \uC7A5\uB09C\uC774\uC5C8\uC5B4. \uADF8\uB807\uAC8C \uB420 \uC904 \uBAB0\uB790\uC5B4. \uB2E4\uC74C \uB0A0 \uAEBC\uB0B4 \uC8FC\uB824\uACE0 \uD588\uB294\uB370, \uADF8 \uB2E4\uC74C \uB0A0\uC774\u2026 \uADF8\uAC70\uC600\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213482
    m_Localized: "\uADF8 \uC560\uAC00 \uCC98\uC74C \uD55C \uB9D0\uC774\uC5C8\uB2E4. \uC0AC\uACFC\uB3C4, \uBCC0\uBA85\uB3C4 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213481
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uB108, \uC0B4\uC544 \uC788\uC5C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213480
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uC791\uC558\uB2E4. \uC544\uB2C8\uBA74 \uB0B4\uAC00 \uCEE4\uC9C4 \uAC78\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213479
    m_Localized: "\uB4F1 \uB4A4\uB85C \uC2DC\uC120\uC774 \uC624\uB798 \uB530\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213478
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798, \uC870\uC2EC\uD558\uB294 \uAC8C \uB9DE\uC9C0. \uB9C8\uC74C \uBC14\uB00C\uBA74 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213477
    m_Localized: "\uC815\uC911\uD788 \uAC70\uC808\uD558\uACE0 \uB3CC\uC544\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407283
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC70\u2026 \uC6B0\uB9AC \uD559\uB144 \uAC70\uB124. \uAD50\uBB34\uC2E4\uB85C \uAC00\uB358 \uC0C1\uC790\uC600\uB098 \uBCF4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407284
    m_Localized: "{0}: \uC774\uAC78 \uC9C0\uAE08 \uD480\uC5B4\uC11C \uBB50 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213476
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38\uC774 \uC870\uAE08 \uB35C \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213475
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD\uC774 \uD611\uC0C1\uC744 \uD558\uB124. \uC88B\uC544, \uBB34\uC804 \uCC44\uB110 \uD558\uB098 \uC815\uD558\uC790. \uBB34\uC2A8 \uC77C \uC788\uC73C\uBA74 \uC11C\uB85C \uBD80\uB974\uB294 \uAC78\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213474
    m_Localized: "\uC11C\uB85C \uB3D5\uC790\uACE0, \uC815\uAE30\uC801\uC73C\uB85C \uC5F0\uB77D\uD558\uC790\uACE0 \uC81C\uC548\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213473
    m_Localized: "\uC57D\uD488 \uB450 \uC0C1\uC790\uC640 \uC300 \uD55C \uD3EC\uB300. \uC815 \uBC18\uC7A5\uC774 \uC545\uC218\uB97C \uCCAD\uD588\uB2E4. \uC190\uC774 \uAC70\uCE60\uACE0 \uB530\uB73B\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213472
    m_Localized: "\uC57D \uC870\uAE08\uACFC \uC2DD\uB7C9\uC744 \uBC14\uAFBC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213471
    m_Localized: "\uC815 \uBC18\uC7A5: \uC6B0\uB9AC\uB294 \uBA39\uC744 \uAC8C \uB9CE\uACE0, \uC57D\uC774 \uC5C6\uC5B4. \uB108\uD76C\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213470
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uAD50\uC5D0 \uC120\uC0DD\uB2D8\uD558\uACE0 \uC560\uB4E4 \uBA87\uC774 \uC788\uB2E4\uACE0? \uB300\uB2E8\uD558\uB124. \uC6B0\uB9B0 \uC5EC\uAE30 \uC5F4\uD55C \uBA85\uC774\uC57C. \uB354\uBD88\uC5B4 \uB9C8\uD2B8\uB77C\uACE0\uB4E4 \uD574. \uC774\uB984\uC740 \uB0B4\uAC00 \uC9C0\uC740 \uAC70 \uC544\uB2C8\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213469
    m_Localized: "\uB9C8\uD2B8 \uC0AC\uBB34\uC2E4. \uAC00\uC6B4\uB370 \uB0A8\uC790\uB294 \uC790\uC2E0\uC744 \uC815 \uBC18\uC7A5\uC774\uB77C\uACE0 \uC18C\uAC1C\uD588\uB2E4. \uC6D0\uB798 \uBB3C\uB958\uCC3D\uACE0 \uBC18\uC7A5\uC774\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407285
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE00\uC384. \uCC44\uC810\uC740 \uB0B4\uAC00 \uD574 \uC904 \uC218 \uC788\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407286
    m_Localized: "\uC2DC\uAC04\uC744 \uC7AC\uACE0 \uD480\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213468
    m_Localized: "\uAC10\uC5FC\uC790\uB294 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uADF8 \uBB38\uC7A5\uC774 \uBA38\uB9BF\uC18D\uC5D0\uC11C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213467
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uB2E4\uB9CC \uC6C3\uB294 \uC5BC\uAD74 \uADF8\uB300\uB85C \uC790\uAE30 \uB2E4\uB9AC\uB97C \uD55C \uBC88 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213466
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uC5BC\uAD74\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213465
    m_Localized: "22\uC8FC. \uC190\uAC00\uB77D\uC73C\uB85C \uC138\uC5B4 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213464
    m_Localized: "\uB2E4 \uAC19\uC774 \uAEF4\uC548\uC558\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uBAA9\uBC1C\uC744 \uB193\uCE58\uBA70 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213463
    m_Localized: "\uAC19\uC774 \uC18C\uB9AC \uC9C0\uB974\uBA70 \uAE30\uBED0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213462
    m_Localized: "\uBC29\uC1A1\uC774 \uB05D\uB098\uC790 \uC544\uBB34\uB3C4 \uB9D0\uC744 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB7EC\uB2E4 \uB3C4\uD604\uC774 \uC18C\uB9AC\uB97C \uC9C8\uB800\uB2E4. \uC774\uAE34 \uCD95\uAD6C \uACBD\uAE30\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213461
    m_Localized: "\uAD6C\uC870\uB300: \uC778\uADFC\uC5D0\uC11C \uB2E4\uB978 \uC0DD\uC874\uC790 \uC2E0\uD638\uB3C4 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uB05D\uAE4C\uC9C0 \uBC84\uD168 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407287
    m_Localized: "\uC5F0\uD544 \uC18C\uB9AC\uB9CC \uCC3D\uACE0\uB97C \uCC44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213460
    m_Localized: "\uAD6C\uC870\uB300: \uD0D1\uC2B9 \uC804 \uC804\uC6D0 \uAC80\uC9C4\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4. \uAC10\uC5FC\uC774 \uD655\uC778\uB41C \uC0AC\uB78C\uC740 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uBC18\uBCF5\uD569\uB2C8\uB2E4. \uAC10\uC5FC\uC790\uB294 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213459
    m_Localized: "\uAD6C\uC870\uB300: \uC9C0\uC815 \uCC29\uB959 \uC9C0\uC810\uC740 \uC625\uC0C1, \uB610\uB294 \uB113\uC740 \uACF5\uD130\uC785\uB2C8\uB2E4. \uB0AE\uC5D0 SOS\uB97C \uD45C\uC2DC\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213458
    m_Localized: "\uAD6C\uC870\uB300: \uC0C8\uBCBD\uC2DC \uC77C\uB300 \uC0DD\uC874\uC790\uC5D0\uAC8C \uC54C\uB9BD\uB2C8\uB2E4. \uAD6C\uC870\uB300\uAC00 \uB0B4\uB144 3\uC6D4 \uB458\uC9F8 \uC8FC\uC5D0 \uB3C4\uCC29\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213457
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uB05D\uC5D0, DJ\uAC00 \uC544\uB2CC \uB0AF\uC120 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uB610\uBC15\uB610\uBC15\uD55C, \uD6C8\uB828\uB41C \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213456
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD1D \uAC19\uC740 \uAC74 \uC0DD\uAC01\uB3C4 \uD558\uC9C0 \uB9C8. \uC6B0\uB9AC\uAC00 \uD544\uC694\uD55C \uAC74 \uB9C9\uC744 \uC218 \uC788\uB294 \uAC83\uBFD0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213455
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD30C\uCD9C\uC18C\uB77C\u2026 \uBB34\uAE30\uACE0\uB294 \uC7A0\uACA8 \uC788\uACA0\uC9C0\uB9CC, \uBC24\uC774\uB77C\uBA74 \uC9C0\uD0A4\uB294 \uC0AC\uB78C\uB3C4 \uC5C6\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213454
    m_Localized: "\uBB38\uC5D0 \uC190\uAE00\uC528 \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uAE00\uC528\uB294 \uBE57\uBB3C\uC5D0 \uBC88\uC838 \uC77D\uC744 \uC218 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213453
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uD070\uAE38 \uBAA8\uD241\uC774\uC5D0 \uD30C\uCD9C\uC18C\uAC00 \uBCF4\uC600\uB2E4. \uC21C\uCC30\uCC28 \uBC14\uD034\uB294 \uB2E4 \uC8FC\uC800\uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213452
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uAC8C \uB418\uBA74 \uB9D0\uC744 \uC544\uB07C\uACE0, \uC6B0\uB9AC\uAC00 \uC5B4\uB514 \uC788\uB294\uC9C0\uB294 \uC27D\uAC8C \uC54C\uB824 \uC8FC\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213451
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9C8\uD2B8\uB77C. \uBB3C\uC790\uB294 \uB9CE\uACA0\uC9C0. \uADF8\uB9AC\uACE0 \uC0AC\uB78C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213450
    m_Localized: "DJ: \uAC70\uB798\uB3C4 \uD55C\uB2E4\uB358\uB370\u2026 \uC870\uC2EC\uC740 \uD558\uC138\uC694. \uC0AC\uB78C\uC774 \uC81C\uC77C \uBB34\uC11C\uC6B4 \uC138\uC0C1\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213449
    m_Localized: "DJ: \uC2A4\uC2A4\uB85C '\uB354\uBD88\uC5B4 \uB9C8\uD2B8'\uB77C\uACE0 \uBD80\uB978\uB300\uC694. \uC774\uB984\uC740 \uC88B\uB124\uC694. \uC774\uB984\uB9CC\uD07C\uB9CC \uD558\uC2DC\uAE38."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213448
    m_Localized: "DJ: \uC624\uB298\uC758 \uC18C\uC2DD. \uC0C8\uBCBD\uB9C8\uD2B8\uC5D0 \uC5B4\uB978 \uBA87 \uBD84\uC774 \uC790\uB9AC\uB97C \uC7A1\uC73C\uC168\uB300\uC694. \uBB3C\uB958\uCC3D\uACE0\uAE4C\uC9C0 \uC4F0\uC2E0\uB2E4\uB2C8 \uBD80\uB7FD\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213447
    m_Localized: "\uADF8 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA70 \uC624\uB79C\uB9CC\uC5D0 \uAE4A\uC774 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213446
    m_Localized: "DJ\uB294 \uB300\uB2F5\uC774 \uC5C6\uC5B4\uB3C4 \uACC4\uC18D \uC774\uC57C\uAE30\uD588\uB2E4. \uB3D9\uB124 \uBE75\uC9D1 \uC774\uC57C\uAE30, \uBE44 \uC624\uB294 \uB0A0 \uC774\uC57C\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213445
    m_Localized: "\uB300\uB2F5\uD558\uC9C0 \uC54A\uACE0 \uB4E3\uAE30\uB9CC \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213444
    m_Localized: "DJ: \u2026\uC640. \uD559\uAD50\uC694? \uD559\uC0DD\uC774\uC5D0\uC694? \uC138\uC0C1\uC5D0. \uC624\uB298 \uBC29\uC1A1\uC740 \uADF8\uCABD\uC5D0 \uBC14\uCE69\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213443
    m_Localized: "\uC7A0\uAE50\uC758 \uCE68\uBB35. \uADF8\uB9AC\uACE0 \uC6C3\uC74C\uC774 \uC11E\uC778 \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213442
    m_Localized: "{0}: \uB4E4\uB824\uC694. \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC608\uC694. \uC5EC\uAE30, \uC0AC\uB78C \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213441
    m_Localized: "\uC1A1\uC2E0 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB300\uB2F5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407288
    m_Localized: "\uB2E4 \uD480\uACE0 \uB098\uB2C8, \uC774\uC0C1\uD558\uAC8C\uB3C4 \uC870\uAE08 \uC228\uC774 \uC26C\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213440
    m_Localized: "DJ: \uD639\uC2DC \uC774 \uBC29\uC1A1 \uB4E3\uB294 \uBD84 \uC788\uC73C\uBA74\u2026 3\uBC88 \uCC44\uB110\uB85C \uC2E0\uD638 \uD55C \uBC88\uB9CC \uC918\uC694. \uD63C\uC790 \uB5A0\uB4DC\uB294 \uAC70, \uC0DD\uAC01\uBCF4\uB2E4 \uC678\uB86D\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213439
    m_Localized: "DJ: \uC624\uB298\uC758 \uD65C\uB3D9 \uC608\uBCF4. \uBD81\uCABD \uC0C1\uAC00\uB294 \uC870\uC6A9\uD558\uACE0, \uAC15\uBCC0 \uCABD\uC740 \uC2DC\uB044\uB7FD\uC2B5\uB2C8\uB2E4. \uAC15\uBCC0\uC740 \uD53C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213438
    m_Localized: "DJ: \uC800\uB294 DJ \uC0C8\uBCBD. \uC9C4\uC9DC DJ\uB294 \uC544\uB2C8\uACE0, \uC61B\uB0A0\uC5D0 \uB3D9\uB124 \uB77C\uB514\uC624\uC5D0\uC11C \uC0AC\uC5F0 \uC77D\uB358 \uC0AC\uB78C\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213437
    m_Localized: "DJ: \uC0C8\uBCBD\uC2DC \uC5B4\uB518\uAC00\uC5D0\uC11C \uC544\uC9C1 \uAE68\uC5B4 \uC788\uB294 \uC5EC\uB7EC\uBD84, \uC88B\uC740 \uBC24\uC785\uB2C8\uB2E4. \uC624\uB298\uB3C4 \uC0B4\uC544 \uC788\uC5B4 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213436
    m_Localized: "\uAC00\uC744 \uCCAB \uBC24. \uBC29\uC1A1\uC2E4 \uBB34\uC804\uAE30\uAC00 \uB610\uB837\uD55C \uBAA9\uC18C\uB9AC\uB97C \uD1A0\uD574 \uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213435
    m_Localized: "\uADF8 \uB9D0\uC774 \uC774\uC0C1\uD558\uAC8C \uC624\uB798 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213434
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAF2D\uB300\uAE30 \uBA87 \uAC1C\uB294 \uB0A8\uACA8 \uB450\uB294 \uAC70\uC57C. \uAE4C\uCE58\uBC25. \uACA8\uC6B8\uC5D0 \uC0C8\uB4E4\uB3C4 \uBA39\uC5B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213433
    m_Localized: "\uAE4C\uCE58\uBC25\uC73C\uB85C \uB0A8\uACA8 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213432
    m_Localized: "\uC7A5\uB300\uB97C \uD718\uB450\uB974\uB2E4 \uAC10\uC774 \uB5A8\uC5B4\uC838 \uD130\uC84C\uB2E4. \uADF8\uB798\uB3C4 \uBA87 \uAC1C\uB294 \uBA40\uCA61\uD588\uB2E4. \uCC3D\uAC00\uC5D0 \uB298\uC5B4\uB193\uC73C\uB2C8 \uBC29\uC774 \uD658\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213431
    m_Localized: "\uC7A5\uB300\uB85C \uAC10\uC744 \uB534\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213430
    m_Localized: "\uAC10\uB098\uBB34 \uAF2D\uB300\uAE30\uC5D0 \uAE4C\uCE58 \uD55C \uB9C8\uB9AC\uAC00 \uC549\uC544 \uD64D\uC2DC\uB97C \uCABC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213429
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uB2F4\uC7A5 \uC606 \uAC10\uB098\uBB34\uC5D0 \uAC10\uC774 \uC8FC\uD669\uC0C9\uC73C\uB85C \uB9E4\uB2EC\uB824 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uB530\uC9C0 \uC54A\uC740 \uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407289
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4\uB294 \uAF64 \uD558\uB124. \uC218\uD559\uC740\u2026 \uB0B4\uC77C \uB2E4\uC2DC \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407290
    m_Localized: "\uC2DC\uD5D8\uC9C0\uB97C \uCC22\uC5B4 \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407291
    m_Localized: "\uC885\uC774\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uC9C8\uACBC\uB2E4. \uADF8\uB798\uB3C4 \uB05D\uAE4C\uC9C0 \uCC22\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213428
    m_Localized: "\uC7AC\uB8CC\uAC00 \uC544\uAE4C\uC6E0\uB2E4. \uB300\uC2E0 \uB0A8\uC740 \uBB34\uB97C \uC370\uC5B4 \uAD6D\uC744 \uB053\uC600\uB2E4. \uAE40\uC7A5 \uB0C4\uC0C8 \uBE44\uC2B7\uD55C \uAC83\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213427
    m_Localized: "\uC774\uBC88 \uD574\uB294 \uAC74\uB108\uB6F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213426
    m_Localized: "\uD56D\uC544\uB9AC \uB300\uC2E0 \uD070 \uAE40\uCE58\uD1B5 \uB450 \uAC1C\uB97C \uADF8\uB298\uC9C4 \uAD50\uC2E4 \uAD6C\uC11D\uC5D0 \uBB3B\uC5C8\uB2E4. \uACA8\uC6B8 \uB0B4\uB0B4 \uAEBC\uB0B4 \uBA39\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213425
    m_Localized: "\uC190\uC774 \uBE68\uAC1B\uAC8C \uC5BC\uACE0, \uACE0\uCDA7\uAC00\uB8E8\uAC00 \uB208\uC5D0 \uB4E4\uC5B4\uAC00 \uB2E4\uB4E4 \uC6B8\uBA74\uC11C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213424
    m_Localized: "\uB2E4 \uAC19\uC774 \uAE40\uC7A5\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213423
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC5D0\uC11C \uACE0\uCDA7\uAC00\uB8E8 \uD55C \uBD09\uC9C0\uAC00 \uC654\uB2E4. \uCABD\uC9C0\uC5D0 \uC815 \uBC18\uC7A5\uC758 \uAE00\uC528. '\uAE40\uC7A5\uC740 \uC6D0\uB798 \uB098\uB220 \uD558\uB294 \uAC70\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213422
    m_Localized: "\uBC30\uCD94\uB294 \uC5C6\uC5C8\uB2E4. \uB9C8\uD2B8\uC5D0\uC11C \uAD6C\uD55C \uBB34\uC640 \uC2DC\uB4E0 \uAC13, \uD1B5\uC870\uB9BC \uACE0\uCD94\uB97C \uBAA8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213421
    m_Localized: "\uC625\uC0C1 \uD143\uBC2D\uC5D0\uC11C \uD0A4\uC6B4 \uBC30\uCD94\uAC00 \uC791\uACE0 \uB2E8\uB2E8\uD588\uB2E4. \uC2DC\uB4E0 \uAC89\uC78E\uC744 \uB5BC\uB2C8 \uC18D\uC774 \uB178\uB7AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407292
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC870\uAC01\uB4E4\uC744 \uBAA8\uC544 \uBD88\uC3D8\uC2DC\uAC1C \uC0C1\uC790\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407293
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC798 \uD0C8 \uAC70\uC57C. \uC774\uBC88 \uACA8\uC6B8\uC5D4 \uC774\uAC8C \uB354 \uC4F8\uBAA8 \uC788\uC744\uC9C0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407294
    m_Localized: "\uBD88 \uAEBC\uC9C4 \uCC3D\uACE0. \uC724 \uC120\uC0DD\uB2D8\uC774 \uBCBD\uC5D0 \uB4F1\uC744 \uAE30\uB304 \uCC44 \uBD95\uB300\uB97C \uB2E4\uC2DC \uAC10\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407295
    m_Localized: "{0} \uAE6C \uAC78 \uC54C\uC544\uCC58\uB294\uC9C0, \uC120\uC0DD\uB2D8\uC774 \uC190\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407296
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBABB \uC790\uACA0\uC5B4? \uB098\uB3C4 \uADF8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407297
    m_Localized: "\uB2E4\uB9AC\u2026 \uAD1C\uCC2E\uC73C\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407298
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uB0D0\uACE0 \uBB3C\uC5B4\uBD10 \uC900 \uC0AC\uB78C\uC774 \uB124\uAC00 \uCC98\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407299
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uD504\uAE34 \uD574. \uADF8\uB798\uB3C4 \uADF8\uB0A0 \uADF8\uB807\uAC8C \uC548 \uD588\uC73C\uBA74, \uC9C0\uAE08 \uB108\uB791 \uC774 \uC598\uAE30\uB3C4 \uBABB \uD588\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213420
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE40\uC7A5\uD560 \uB54C\uB2E4. \uACA8\uC6B8 \uBC18\uCC2C\uC740 \uC9C0\uAE08 \uB9CC\uB4E4\uC5B4 \uB46C\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213419
    m_Localized: "\uB0A0\uC774 \uAC11\uC790\uAE30 \uCD94\uC6CC\uC84C\uB2E4. \uC724 \uC120\uC0DD\uB2D8\uC774 \uC190\uBC14\uB2E5\uC744 \uBE44\uBE44\uBA70 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213418
    m_Localized: "\uC785 \uBAA8\uC591\uC744 \uB530\uB77C \uD558\uB2E4 \uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213417
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2E0\uC774 \uB098\uC11C \uAE30\uC5ED, \uB2C8\uC740, \uB514\uADFF\uC774 \uC5B4\uB5BB\uAC8C \uC0DD\uACA8\uB0AC\uB294\uC9C0 \uC774\uC57C\uAE30\uD588\uB2E4. \uD600\uC640 \uC774\uC640 \uC785\uC220\uC758 \uBAA8\uC591."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213416
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB4E4\uB824\uC8FC\uB294 \uD55C\uAE00 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213415
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78 \uC77D\uACE0, \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uAE00\uC790\uB294 \uBA70\uCE60 \uB3D9\uC548 \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213414
    m_Localized: "\uBD84\uD544\uC744 \uB4E4\uACE0 \uD55C\uCC38 \uC11C \uC788\uB2E4\uAC00 \uC37C\uB2E4. \uC9E7\uC740 \uB9D0\uC774\uC5C8\uB2E4. \uB204\uAD6C\uC5D0\uAC8C \uD558\uB294 \uB9D0\uC778\uC9C0\uB294 \uC4F0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213413
    m_Localized: "\uCE60\uD310 \uAD6C\uC11D\uC5D0 \uD558\uACE0 \uC2F6\uC5C8\uB358 \uB9D0\uC744 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213412
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC624\uB298 \uC219\uC81C. \uD558\uACE0 \uC2F6\uC5C8\uB294\uB370 \uBABB \uD588\uB358 \uB9D0\uC744 \uD558\uB098\uC529 \uC368 \uBCF4\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213411
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9D0\uC774 \uC11C\uB85C \uD1B5\uD558\uC9C0 \uC54A\uC544\uC11C, \uBC31\uC131\uC774 \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC744 \uAE00\uB85C \uC4F0\uC9C0 \uBABB\uD574\uC11C, \uADF8\uAC8C \uC548\uD0C0\uAE4C\uC6CC\uC11C \uB9CC\uB4E0 \uAE00\uC790\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213410
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC61B \uAE00\uC790\uB85C \uCCAB \uC904\uC744 \uC74A\uC5C8\uB2E4. \uB098\uB78F\uB9D0\uC2F8\uBBF8 \uB4D5\uADC1\uC5D0 \uB2EC\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213409
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uD55C\uAE00\uB0A0. \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uD55C\uD14C\uB294 \uC124\uB0A0 \uAC19\uC740 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213408
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC544\uCE68\uBD80\uD130 \uB4E4\uB5A0 \uC788\uC5C8\uB2E4. \uCE60\uD310 \uD55C\uAC00\uC6B4\uB370 \uD07C\uC9C1\uD558\uAC8C \uC37C\uB2E4. 10\uC6D4 9\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213407
    m_Localized: "\uADF8\uB294 \uC6C3\uC73C\uBA70 \uB5A0\uB0AC\uB2E4. \uADF8 \uC6C3\uC74C\uC774 \uD55C\uB3D9\uC548 \uAD50\uBB38 \uC55E\uC5D0 \uB0A8\uC544 \uC788\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213406
    m_Localized: "\uBC31: \uACE0\uB9D9\uB2E4. \uADF8 \uB9D0, \uC624\uB798 \uBABB \uB4E4\uC5C8\uB2E4. \uADFC\uB370 \uB098\uB294 \uAC78\uC5B4\uC57C \uC0AC\uB294 \uC0AC\uB78C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213405
    m_Localized: "\uC5EC\uAE30 \uAC19\uC774 \uC788\uC790\uACE0 \uBD99\uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213404
    m_Localized: "\uBC31\uC740 \uBAA8\uC790\uB97C \uC0B4\uC9DD \uB4E4\uC5B4 \uBCF4\uC774\uACE0 \uB5A0\uB0AC\uB2E4. \uC774\uBC88\uC5D4 \uC815\uB9D0\uB85C, \uB2E4\uC2DC \uBCF4\uC9C0 \uBABB\uD560 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213403
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0, \uBB34\uC0AC\uD788 \uAC00\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213402
    m_Localized: "\uADF8\uAC00 \uBD81\uCABD \uB2F4\uC7A5\uC744 \uAC00\uB9AC\uD0A4\uBA70, \uC5B4\uB514\uC5D0 \uBB34\uC5C7\uC744 \uB367\uB300\uC57C \uD558\uB294\uC9C0 \uD558\uB098\uD558\uB098 \uC54C\uB824 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213401
    m_Localized: "\uBC31: \uBD81\uCABD \uB2F4\uC7A5\uC774 \uC57D\uD574. \uB0B4\uAC00 \uBCF4\uAE30\uC5D4 \uADF8\uB798. \uACA8\uC6B8 \uC624\uAE30 \uC804\uC5D0 \uB9C9\uC544 \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213400
    m_Localized: "\uBC31: \uC0AC\uAC70\uB9AC \uB188\uB4E4, \uACA8\uC6B8 \uB4E4\uC5B4\uC11C \uC0AC\uB78C\uC774 \uB298\uC5C8\uC5B4. \uB9C8\uC9C0\uB9C9 \uD55C\uD30C \uB54C \uD06C\uAC8C \uD55C \uBC88 \uC62C \uAC70\uB2E4. \uBD81\uCABD \uB2F4\uC7A5\uC774 \uC57D\uD574. \uAC70\uAE30\uBD80\uD130 \uB9C9\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213399
    m_Localized: "\uC720\uB791\uC790: \uBC31\uC774\uB77C\uACE0 \uBD88\uB7EC. \uC0B0 \uC548\uB0B4\uC6D0\uC774\uC5C8\uB2E4. \uAE38\uC740 \uC798 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407300
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uC774\uC0C1 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uB354 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407301
    m_Localized: "\uC800\uB294 \uAD1C\uCC2E\uC544\uC694. \uC8FC\uBB34\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407302
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. {0}, \uB0B4\uC77C\uB3C4 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407303
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uB2F4\uC694\uB97C \uB04C\uC5B4\uC62C\uB838\uB2E4. \uAD1C\uCC2E\uB2E4\uB294 \uB9D0\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uC27D\uAC8C \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407304
    m_Localized: "\uC2DD\uB7C9 \uC0C1\uC790\uC5D0\uC11C \uC2DC\uD07C\uD55C \uB0C4\uC0C8\uAC00 \uC62C\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407305
    m_Localized: "\uC2B5\uAE30 \uB54C\uBB38\uC5D0 \uBE75\uACFC \uBC18\uCC2C \uBA87 \uAC1C\uAC00 \uC0C1\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407306
    m_Localized: "\uD1B5\uC870\uB9BC \uD558\uB098\uAC00 \uBD88\uB8E9\uD558\uAC8C \uBD80\uD480\uC5B4 \uC788\uC5C8\uB2E4. \uC606 \uC0C1\uC790\uC758 \uB77C\uBA74 \uBD09\uC9C0\uC5D0\uB3C4 \uACF0\uD321\uC774\uAC00 \uBC88\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407307
    m_Localized: "\uC313\uC544 \uB454 \uC2DD\uB7C9 \uC544\uB798\uCABD\uC5D0\uC11C \uBB3C\uAE30\uAC00 \uBC30\uC5B4 \uB098\uC654\uB2E4. \uC544\uB798 \uCE78 \uAC83\uB4E4\uC774 \uB205\uB205\uD558\uAC8C \uBCC0\uD574 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407308
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uAE4C\uC6CC\uB3C4 \uBC84\uB9AC\uB294 \uAC8C \uB9DE\uC744 \uC218\uB3C4 \uC788\uC5B4. \u2026\uB124\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407309
    m_Localized: "\uC0C1\uD55C \uAC83\uAE4C\uC9C0 \uC804\uBD80 \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407310
    m_Localized: "\uC544\uAE5D\uB2E4\uB294 \uC0DD\uAC01\uC744 \uAFB9 \uB204\uB974\uACE0 \uC0C1\uC790\uB97C \uBE44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407311
    m_Localized: "\uBA40\uCA61\uD55C \uBD80\uBD84\uC744 \uACE8\uB77C \uC0B4\uB824 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407312
    m_Localized: "\uCE7C\uB85C \uC0C1\uD55C \uBD80\uBD84\uC744 \uB3C4\uB824\uB0B4\uACE0, \uB053\uC77C \uC218 \uC788\uB294 \uAC74 \uB053\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407313
    m_Localized: "\uC0DD\uAC01\uBCF4\uB2E4 \uB9CE\uC774 \uAC74\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213398
    m_Localized: "\uC720\uB791\uC790: \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB4E4\uB800\uB2E4. \uB0A8\uCABD\uC73C\uB85C \uAC04\uB2E4. \uAD6C\uC870\uB300\uAC00 \uC628\uB2E4\uB294 \uBC29\uC1A1, \uB098\uB3C4 \uB4E4\uC5C8\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213397
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uADF8 \uC720\uB791\uC790\uAC00 \uC138 \uBC88\uC9F8\uB85C \uB098\uD0C0\uB0AC\uB2E4. \uB4F1\uC5D0 \uBA54\uACE0 \uC788\uB358 \uBC30\uB0AD\uC774 \uB208\uC5D0 \uB744\uAC8C \uAC00\uBCBC\uC6CC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213396
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6B0\uB9AC\uB77C\uB294 \uB9D0\uC5D0 \uADF8 \uC560\uAC00 \uC544\uC8FC \uC870\uAE08 \uB180\uB780 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213395
    m_Localized: "{0}: \uC54C\uB824 \uC918\uC11C \uACE0\uB9C8\uC6CC. \uC774\uAC74 \uC6B0\uB9AC\uAC00 \uC950\uACE0 \uC788\uC790. \uD544\uC694\uD560 \uB54C \uC4F0\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213394
    m_Localized: "\uC9C0\uAE08\uC740 \uC6B0\uB9AC\uB9CC \uC54C\uACE0 \uC788\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213393
    m_Localized: "\uC815 \uBC18\uC7A5: \u2026\uADF8 \uC560\uAC00? \uADF8\uB798. \uACE0\uB9D9\uB2E4\uACE0 \uC804\uD574 \uC918. \uC870\uC6A9\uD788 \uCC98\uB9AC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213392
    m_Localized: "\uBB34\uC804\uAE30 \uB108\uBA38\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC774 \uD55C\uCC38 \uC870\uC6A9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213391
    m_Localized: "\uC815 \uBC18\uC7A5\uC5D0\uAC8C \uBB34\uC804\uC73C\uB85C \uC54C\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407314
    m_Localized: "\uAD1C\uCC2E\uC544 \uBCF4\uC600\uB294\uB370, \uC800\uB141\uBD80\uD130 \uBC30\uAC00 \uB4A4\uD2C0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407315
    m_Localized: "\uACB0\uAD6D \uB0A8\uC740 \uAC83\uB3C4 \uBC84\uB824\uC57C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407316
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uCCB4\uC721\uAD00 \uB4A4\uD3B8 \uADF8\uB298\uC5D0\uC11C \uB204\uAD70\uAC00\uC640 \uB208\uC774 \uB9C8\uC8FC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407317
    m_Localized: "\uAD50\uBCF5 \uC704\uC5D0 \uCCB4\uC721\uBCF5\uC744 \uACB9\uCCD0 \uC785\uC740 \uD559\uC0DD \uD558\uB098. \uC190\uC5D0 \uB4E0 \uAC74 \uBE48 \uBB3C\uBCD1\uBFD0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407318
    m_Localized: "???: \uBB3C\uB824\uACE0 \uC628 \uAC70 \uC544\uB2C8\uC57C. \uADF8\uB0E5\u2026 \uC0AC\uB78C\uC774\uB124, \uC2F6\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407319
    m_Localized: "\uAC19\uC774 \uAC00\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407320
    m_Localized: "{0}: \uC6B0\uB9AC \uCABD\uC5D0 \uC5B4\uB978\uC774 \uD55C \uBD84 \uACC4\uC154. \uAC19\uC774 \uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407321
    m_Localized: "\uBA39\uC744 \uAC83\uB9CC \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213390
    m_Localized: "\uCD5C\uD558\uB9B0: \uB9D0 \uC548 \uD558\uB824\uACE0 \uD588\uC5B4. \uADFC\uB370 \uC5EC\uAE30\uC11C\uB294\u2026 \uC544\uBB34\uB3C4 \uB204\uAD6C\uB97C \uAC00\uB450\uC9C0 \uC54A\uB294\uB2E4\uBA70."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213389
    m_Localized: "\uCD5C\uD558\uB9B0: \uC815 \uBC18\uC7A5\uC740 \uBAB0\uB77C. \uACA8\uC6B8 \uB418\uBA74 \uADF8\uAC78\uB85C \uC0AC\uB78C\uB4E4 \uC904 \uC138\uC6B8 \uAC70\uB77C\uACE0, \uC790\uAE30\uB124\uB07C\uB9AC \uADF8\uB7AC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213388
    m_Localized: "\uCD5C\uD558\uB9B0: \uB9C8\uD2B8\uC5D0 \uC788\uC744 \uB54C \uB4E4\uC740 \uAC8C \uC788\uC5B4. \uC624 \uC528 \uC544\uC800\uC528. \uC57D\uC744 \uB530\uB85C \uC228\uACA8 \uB46C. \uCC3D\uACE0 \uB4A4 \uB0C9\uB3D9\uACE0 \uC548\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213387
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uBA3C\uC800 \uB9D0\uC744 \uAC78\uC5B4\uC654\uB2E4. \uCC98\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213386
    m_Localized: "\uBB38\uC744 \uB05D\uAE4C\uC9C0 \uC5F4\uC5B4 \uB450\uACE0 \uC654\uB2E4. \uADF8 \uC560\uAC00 \uAC70\uAE30\uC11C \uBB34\uC5C7\uC744 \uD655\uC778\uD558\uB294\uC9C0\uB294, \uADF8 \uC560\uC758 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213385
    m_Localized: "\uC870\uC6A9\uD788 \uBB38\uC744 \uC5F4\uC5B4 \uB450\uACE0 \uB3CC\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213384
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC5B4 \uC6B8\uC5C8\uB2E4. \uB098\uB294 \uC6B8\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uB05D\uAE4C\uC9C0 \uC606\uC5D0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158213383
    m_Localized: "{0}: \uC5EC\uAE30 \uC774\uC81C \uBB38 \uC548 \uC7A0\uACA8. \uADF8\uAC70 \uD655\uC778\uD558\uB7EC \uC624\uB294 \uAC70\uBA74, \uAC19\uC774 \uC640\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407073
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC774 \uB3D9\uC9C0\uC57C. \uC77C \uB144 \uC911\uC5D0 \uBC24\uC774 \uC81C\uC77C \uAE34 \uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407074
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6D0\uB798\uB294 \uD325\uC8FD\uC744 \uC464\uC5B4 \uBA39\uC5B4. \uB098\uC05C \uAE30\uC6B4 \uCAD3\uC73C\uB77C\uACE0. \uB0B4\uC77C\uBD80\uD130\uB294 \uB0AE\uC774 \uC870\uAE08\uC529 \uAE38\uC5B4\uC9C0\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407075
    m_Localized: "\uD325\uC740 \uC5C6\uC5C8\uB2E4. \uD1B5\uC870\uB9BC \uD325\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4. \uBE59\uC218\uC6A9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407076
    m_Localized: "\uD1B5\uC870\uB9BC \uD325\uC73C\uB85C \uD325\uC8FD \uBE44\uC2B7\uD55C \uAC83\uC744 \uC468\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407077
    m_Localized: "\uC300\uC744 \uC624\uB798 \uB053\uC5EC \uD325\uC744 \uD480\uC5C8\uB2E4. \uB108\uBB34 \uB2EC\uC544\uC11C \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC0C8\uC54C\uC2EC \uB300\uC2E0 \uB123\uC740 \uB5A1 \uC870\uAC01\uC740 \uCAC0\uB4DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407078
    m_Localized: "\uC120\uC0DD\uB2D8 \uC785\uC5D0 \uD55C \uC21F\uAC00\uB77D\uC529 \uB5A0 \uB123\uC5B4 \uB4DC\uB838\uB2E4. \uB450 \uC21F\uAC00\uB77D\uC9F8\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407079
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2EC\uB2E4. \uB098\uC05C \uAE30\uC6B4\uC774 \uB2EC\uC544\uC11C \uB3C4\uB9DD\uAC00\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407080
    m_Localized: "\uAC00\uC7A5 \uAE34 \uBC24\uC744 \uADF8\uB0E5 \uD568\uAED8 \uACAC\uB518\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407081
    m_Localized: "\uBD88\uC744 \uC544\uB07C\uB824\uACE0 \uC77C\uCC0D \uB204\uC6E0\uB2E4. \uAE34 \uBC24\uC774\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uB0B4\uC77C\uBD80\uD130\uB294, \uC870\uAE08\uC529 \uC9E7\uC544\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407082
    m_Localized: "\uC624\uB298\uC740 \uC124\uB0A0\uC774\uC5C8\uB2E4. \uB2EC\uB825\uC5D0\uB3C4, \uB9C8\uC74C\uC5D0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407083
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC758 \uC774\uBD88 \uC606\uC5D0 \uB098\uB780\uD788 \uC549\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uB9CC \uACA8\uC6B0 \uB4E4\uC5B4 \uC6B0\uB9AC \uBA38\uB9AC\uB97C \uD558\uB098\uC529 \uC4F0\uB2E4\uB4EC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407084
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC758\uC790\uC5D0 \uBC18\uB4EF\uD558\uAC8C \uC549\uC558\uB2E4. \uC138\uBC30\uB97C \uBC1B\uB294 \uC0AC\uB78C\uC758 \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407085
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uC138\uBC30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407086
    m_Localized: "\uC808\uC744 \uD558\uB294 \uBC95\uC744 \uBAB0\uB77C\uC11C \uC11C\uD234\uB800\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC74C\uC744 \uCC38\uC73C\uBA70 \uB355\uB2F4\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407087
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC62C\uD574\uB294\u2026 \uBB38\uC774 \uC5F4\uB9AC\uB294 \uD574\uAC00 \uB420 \uAC70\uB2E4. \uC0C8\uD574 \uBCF5 \uB9CE\uC774 \uBC1B\uC544\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407088
    m_Localized: "\uC138\uBC43\uB3C8 \uB300\uC2E0 \uCABD\uC9C0 \uD55C \uC7A5. '\uD55C \uD574 \uB3D9\uC548 \uC798 \uCEF8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407089
    m_Localized: "\uB5A1\uAD6D \uBE44\uC2B7\uD55C \uAC83\uC744 \uB053\uC5EC \uB098\uB220 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407090
    m_Localized: "\uAC00\uB798\uB5A1\uC740 \uC5C6\uC5C8\uB2E4. \uC300\uC744 \uBE5A\uC5B4 \uB0A9\uC791\uD558\uAC8C \uC370\uC5C8\uB2E4. \uAD6D\uBB3C\uC740 \uBA78\uCE58 \uB300\uC2E0 \uD1B5\uC870\uB9BC \uCC38\uCE58\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407091
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70 \uBA39\uC73C\uBA74 \uD55C \uC0B4 \uB354 \uBA39\uB294 \uAC70\uC57C. \uB2E4\uB4E4 \uCD95\uD558\uD574. \uC0B4\uC544\uC11C \uD55C \uC0B4 \uB354 \uBA39\uC740 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407092
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uBD80\uB7FC \uB300\uC2E0 \uB9D0\uB9B0 \uCF69 \uD55C \uC54C\uC744 \uC6B0\uB9AC \uC190\uC5D0 \uD558\uB098\uC529 \uC950\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407093
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC815\uC6D4\uB300\uBCF4\uB984. \uC77C \uB144 \uC911 \uB2EC\uC774 \uC81C\uC77C \uD06C\uACE0 \uBC1D\uC740 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407094
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uCE68\uC5D4 \uBD80\uB7FC\uC744 \uAE68\uACE0, \uB354\uC704\uB97C \uD314\uACE0, \uBC24\uC5D4 \uB2EC\uC5D0 \uC18C\uC6D0\uC744 \uBE4C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407095
    m_Localized: "\uB545\uCF69 \uB300\uC2E0 \uB9D0\uB9B0 \uCF69\uC744 \uAE68\uBB3C\uC5C8\uB2E4. \uC774\uAC00 \uC544\uD320\uB2E4. \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407096
    m_Localized: "\uBC24\uC5D0 \uD070 \uB2EC\uC744 \uBCF4\uBA70 \uC18C\uC6D0\uC744 \uBE48\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407097
    m_Localized: "\uB2EC\uC774 \uC815\uB9D0 \uCEF8\uB2E4. \uAD6C\uC870 \uD5EC\uAE30\uAC00 \uB0B4\uB824\uC62C \uC625\uC0C1 \uC704\uB85C, \uB465\uAE00\uAC8C \uB5A0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407098
    m_Localized: "\uC18C\uC6D0\uC740 \uD558\uB098\uC600\uB2E4. \uBAA8\uB450 \uD568\uAED8, \uC800 \uBB38\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407099
    m_Localized: "\uB354\uC704\uB97C \uD310\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407100
    m_Localized: "{0}: \uC120\uC0DD\uB2D8! \u2026\uB0B4 \uB354\uC704 \uC0AC \uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407101
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uCD94\uC704\uC5D0 \uB354\uC704\uB97C \uC65C \uD314\uC544. \u2026\uADF8\uB798, \uC0AC \uC904\uAC8C. \uB300\uC2E0 \uC62C\uC5EC\uB984\uC740 \uC6B0\uB9AC \uAC19\uC774 \uB365\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407102
    m_Localized: "\uC5EC\uC12F\uC9F8 \uB0A0. \uBE44\uAC00 \uC654\uB2E4. \uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C \uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB838\uB2E4. \uB5A1\uBCF6\uC774 \uAC00\uAC8C \uC55E\uC5D0\uC11C \uB4E3\uB358 \uB178\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407103
    m_Localized: "\uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uAE08\uC744 \uD558\uB098 \uB354 \uADF8\uC5C8\uB2E4. \uC5EC\uC12F."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407104
    m_Localized: "\uC774 \uBC24\uC744 \uC804\uC5D0\uB3C4 \uD55C \uBC88 \uC9C0\uB098\uC628 \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407105
    m_Localized: "\uC77C\uACF1\uC9F8 \uB0A0 \uC0C8\uBCBD. \uBB38 \uB108\uBA38\uC5D0\uC11C \uB204\uAD70\uAC00 \uAE30\uC5B4 \uC624\uB294 \uC18C\uB9AC. \uADF8\uB9AC\uACE0 \uC0AC\uB78C\uC758 \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407106
    m_Localized: "???: \u2026\uAC70\uAE30, \uB204\uAD6C \uC788\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407107
    m_Localized: "\uACA8\uC6B8\uC758 \uCCAB \uBC24. \uC120\uC0DD\uB2D8\uC740 \uC774\uC81C \uAC70\uC758 \uB204\uC6CC\uC11C \uC9C0\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407108
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uBC88 \uC8FC \uACC4\uD68D\uD45C, \uB124\uAC00 \uC9DC \uBCFC\uB798? \uB098\uB294 \uBCF4\uAE30\uB9CC \uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407109
    m_Localized: "\uCE60\uD310 \uC55E\uC5D0 \uC130\uB2E4. \uBD84\uD544\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uBB34\uAC70\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407110
    m_Localized: "\uD63C\uC790 \uACC4\uD68D\uC744 \uC138\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407111
    m_Localized: "\uD0D0\uD5D8, \uACF5\uBD80, \uD734\uC2DD, \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uB3CC\uBCF4\uAE30. \uCE78\uC744 \uCC44\uC6CC \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407112
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB0B4\uAC00 \uC9E0 \uAC83\uBCF4\uB2E4 \uB0AB\uB2E4. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407113
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uC870\uC5B8\uC744 \uAD6C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407114
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24 \uD0D0\uD5D8\uC740 \uC774\uD2C0 \uC5F0\uC18D \uB123\uC9C0 \uB9C8\uB77C. \uADF8\uB9AC\uACE0 \uC26C\uB294 \uB0A0\uC744 \uAF2D \uD558\uB098 \uBE44\uC6CC \uB46C. \uADF8\uAC8C \uB2E4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407115
    m_Localized: "\uC9E7\uC740 \uC870\uC5B8\uC774\uC5C8\uB2E4. \uADF8 \uC9E7\uC74C\uC774 \uC870\uAE08 \uC2AC\uD390\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407116
    m_Localized: "\uB3C4\uC11C\uAD00\uC5D0\uC11C \uAC00\uC838\uC628 \uC2DC\uB0B4 \uC9C0\uB3C4\uC5D0 \uBE68\uAC04 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uAC15\uBCC0\uC758 \uC0C8\uBCBD\uC815\uC218\uC7A5. \uADF8 \uC606\uC758 \uC791\uC740 \uAC74\uBB3C, \uC5F0\uAD6C\uB3D9."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407117
    m_Localized: "DJ\uAC00 \uB9D0\uD588\uB358 \uADF8\uACF3. \uC9C0\uD558\uC5D0 \uAE30\uB85D\uC774 \uC788\uB2E4\uB294 \uACF3."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407118
    m_Localized: "\uC9C0\uD558\uCCA0 \uBC29\uC1A1\uB3C4, \uACFC\uD559\uC2E4 \uB178\uD2B8\uB3C4, \uD30C\uCD9C\uC18C \uC11C\uB958\uB3C4 \uBAA8\uB450 \uAC19\uC740 \uACF3\uC744 \uAC00\uB9AC\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407119
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB0AE\uC5D4 \uAC00\uC9C0 \uB9C8. \uAC70\uAE30 \uC7A0\uB4E0 \uAC8C \uB108\uBB34 \uB9CE\uB300. \uAC00\uC57C \uD55C\uB2E4\uBA74\u2026 \uBC24\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407120
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB9D0\uB824\uB3C4 \uC18C\uC6A9\uC5C6\uB2E4\uB294 \uAC78 \uC544\uB294 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407121
    m_Localized: "\uC5F0\uAD6C\uB3D9\uC5D0\uC11C \uAC00\uC838\uC628 \uD30C\uC77C\uC744 \uBC15 \uC120\uC0DD\uB2D8\uACFC \uD568\uAED8 \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407122
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD734\uBA74 \uAC10\uC5FC\u2026 \uC7AC\uD65C\uC131 \uC870\uAC74\u2026 \uC774\uAC70, \uC6B0\uB9AC\uAC00 \uBA87 \uB2EC \uB3D9\uC548 \uAE30\uB85D\uD55C \uAC70\uB791 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407123
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC5EC\uAE30 \uBD10. \uC7AC\uD65C\uC131 \uCD08\uAE30\uC5D0 \uD2B9\uC815 \uD56D\uC0DD\uC81C \uC870\uD569\uACFC \uD574\uC5F4 \uCC98\uCE58\uB97C \uAC19\uC774 \uD558\uBA74, \uC77C\uBD80\uC5D0\uC11C \uC9C4\uD589\uC774 \uBA48\uCDC4\uB300. \uC77C\uBD80\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407124
    m_Localized: "\uC77C\uBD80. \uADF8 \uB2E8\uC5B4\uC5D0 \uC190\uAC00\uB77D\uC774 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407125
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC0AC\uB78C\uB4E4\uC774 \uB0A8\uAE34 \uAC70\uAD6C\uB098. \uB05D\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407126
    m_Localized: "\uBCA0\uAEF4 \uC628 \uBA54\uBAA8\uB97C \uC120\uC0DD\uB2D8\uAED8 \uC77D\uC5B4 \uB4DC\uB838\uB2E4. \uBCF4\uACE0\uD588\uC73C\uB098 \uBB35\uC0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407127
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB204\uAD70\uAC00\uB294 \uBBF8\uB9AC \uC54C\uC558\uACE0, \uB204\uAD70\uAC00\uB294 \uB9D0\uD588\uACE0, \uB204\uAD70\uAC00\uB294 \uB4E3\uC9C0 \uC54A\uC558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407128
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC8C \uC81C\uC77C \uBB34\uC12D\uB2E4. \uC880\uBE44\uBCF4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407129
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC5D0 \uC9E7\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uCC98\uCE58 \uC911 \uC218\uD608 \uD544\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407130
    m_Localized: "\uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798\uC5D0\uC11C \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D\uC744 \uCC3E\uC558\uB2E4. \uC724 \uC120\uC0DD\uB2D8, \uD608\uC561\uD615 B."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407131
    m_Localized: "\uD559\uC0DD \uAC74\uAC15 \uAE30\uB85D\uC758 \uB0B4 \uCE78\uB3C4 \uB2E4\uC2DC \uD655\uC778\uD588\uB2E4. \uB0B4 \uD53C\uB77C\uBA74 \uC120\uC0DD\uB2D8\uAED8 \uB4DC\uB9B4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407132
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uC0DD \uD53C\uB97C \uBC1B\uB294 \uC120\uC0DD\uC774\uB77C. \uCCB4\uBA74\uC774 \uB9D0\uC774 \uC544\uB2C8\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407133
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uACE0\uB9D9\uB2E4. \uADF8 \uB9D0\uC740 \uBBF8\uB9AC \uD574 \uB450\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407134
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC5D0 \uC9E7\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uCC98\uCE58 \uC911 \uC218\uD608 \uD544\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407135
    m_Localized: "\uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798\uC5D0\uC11C \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D\uC744 \uCC3E\uC558\uB2E4. \uC724 \uC120\uC0DD\uB2D8, \uD608\uC561\uD615 B."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407136
    m_Localized: "\uB0B4 \uD608\uC561\uD615\uC73C\uB85C\uB294 \uB4DC\uB9B4 \uC218 \uC5C6\uB2E4. \uB9DE\uC9C0 \uC54A\uB294 \uD53C\uB294 \uC57D\uC774 \uC544\uB2C8\uB77C \uB3C5\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407137
    m_Localized: "\uB5A0\uC624\uB974\uB294 \uACF3\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4. \uC57D\uAD6D 2\uCE35 \uC758\uC6D0 \uCC98\uCE58\uC2E4\uC758 \uBCF4\uB0C9 \uC0C1\uC790. \uD608\uC561 \uD329\uC774 \uB0A8\uC544 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407138
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0 \uAC70\uAE38 \uAC00\uACA0\uB2E4\uB294 \uAC70\uB0D0. \u2026\uB9D0\uB824\uB3C4 \uAC08 \uC5BC\uAD74\uC774\uAD6C\uB098. \uAF2D \uB3CC\uC544\uC640\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407139
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC5D0 \uC9E7\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uCC98\uCE58 \uC911 \uC218\uD608 \uD544\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407140
    m_Localized: "\uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798\uC5D0\uC11C \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D\uC744 \uCC3E\uC558\uB2E4. \uC724 \uC120\uC0DD\uB2D8, \uD608\uC561\uD615 B."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407141
    m_Localized: "\uD559\uC0DD \uAC74\uAC15 \uAE30\uB85D\uC758 \uB0B4 \uCE78\uC5D0\uB294 \"\uBBF8\uAC80\uC0AC\"\uB77C\uACE0\uB9CC \uC801\uD600 \uC788\uC5C8\uB2E4. \uCE5C\uAD6C\uAC00 \uC6B4\uC138 \uC571\uC744 \uB0B4\uBC00\uB358 \uADF8\uB0A0 \uC544\uCE68\uC5D0\uB3C4 \uB098\uB294 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407142
    m_Localized: "\uBAA8\uB974\uB294 \uD53C\uB97C \uB123\uC744 \uC218\uB294 \uC5C6\uB2E4. \uB77C\uBCA8\uC774 \uBD99\uC740 \uD53C\uAC00 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407143
    m_Localized: "\uC57D\uAD6D 2\uCE35 \uC758\uC6D0 \uCC98\uCE58\uC2E4\uC758 \uBCF4\uB0C9 \uC0C1\uC790. \uAC70\uAE30 \uB0A8\uC740 \uD608\uC561 \uD329\uC774\uB77C\uBA74 \uD608\uC561\uD615\uC774 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407144
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB54C \uAC80\uC0AC\uB77C\uB3C4 \uBC1B\uC544 \uB458 \uAC78 \uADF8\uB7AC\uAD6C\uB098. \uBCF4\uAC74 \uC120\uC0DD\uB2D8\uD55C\uD14C \uD63C\uB0A0 \uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407145
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uD30C\uC77C\uC744 \uB36E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407146
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD574 \uBCFC \uC218\uB294 \uC788\uC5B4. \uADF8\uB7F0\uB370 \uC9C0\uAE08\uC740 \uC548 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407147
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uCC98\uCE58\uD558\uB824\uBA74 \uB0B4 \uC190\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD574. \uB124\uAC00 \uC751\uAE09\uCC98\uCE58\uB97C \uD6E8\uC52C \uB354 \uC798 \uC54C\uC544\uC57C \uD558\uACE0, \uC6B0\uB9AC\uAC00 \uBAA8\uC740 \uC99D\uC0C1 \uAE30\uB85D\uB3C4 \uB354 \uC788\uC5B4\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407148
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC758\uD559 \uACF5\uBD80\uB97C \uB354 \uD574. \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uC0C1\uD0DC\uB97C \uB9E4\uC77C \uC801\uC5B4. \uB2E8\uC11C\uAC00 \uC313\uC774\uBA74, \uADF8\uB54C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407149
    m_Localized: "\uBAA8\uB4E0 \uAC8C \uAC16\uCDB0\uC84C\uB2E4. \uC5F0\uAD6C\uB3D9 \uAE30\uB85D, \uBA87 \uB2EC \uCE58 \uAD00\uCC30 \uC77C\uC9C0, \uADF8\uB9AC\uACE0 \uB0B4 \uC190."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407150
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC131\uACF5\uD55C\uB2E4\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC5B4. \uAE30\uB85D\uC5D0\uC11C\uB3C4 \uC77C\uBD80\uC600\uC5B4. \uC544\uC8FC \uC77C\uBD80."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407151
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD574 \uBCF4\uC790. \uD574 \uBCF4\uC9C0\uB3C4 \uC54A\uACE0 \uD3EC\uAE30\uD558\uB294 \uAC74, \uAD6D\uC5B4 \uC120\uC0DD\uC774 \uAC00\uB974\uCE60 \uAC8C \uC544\uB2C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407152
    m_Localized: "\uB0B4 \uD53C\uB97C \uC4F4\uB2E4. \uC9C0\uAE08 \uCC98\uCE58\uB97C \uC2DC\uC791\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407153
    m_Localized: "\uD314\uC5D0 \uBC14\uB298\uC774 \uB4E4\uC5B4\uAC14\uB2E4. \uB0B4 \uD53C\uAC00 \uAC00\uB294 \uAD00\uC744 \uB530\uB77C \uC120\uC0DD\uB2D8 \uCABD\uC73C\uB85C \uCC9C\uCC9C\uD788 \uB0B4\uB824\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407154
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uC0DD\uD55C\uD14C \uBE5A\uC744 \uC9C0\uB294\uAD6C\uB098. \uC774\uAC74 \uD3C9\uC0DD \uBABB \uAC1A\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407155
    m_Localized: "\uBC24\uC0C8 \uC5F4\uC744 \uC7C0\uB2E4. \uC57D\uC744 \uC2DC\uAC04 \uB9DE\uCDB0 \uB123\uACE0, \uBD95\uB300\uB97C \uAC08\uACE0, \uB2E4\uC2DC \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407156
    m_Localized: "\uC0C8\uBCBD\uC774 \uB420 \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407157
    m_Localized: "\uAD6C\uD574 \uC628 \uD608\uC561 \uD329\uC73C\uB85C \uCC98\uCE58\uB97C \uC2DC\uC791\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407158
    m_Localized: "\uBCF4\uB0C9 \uC0C1\uC790\uC5D0\uC11C \uD608\uC561 \uD329\uC744 \uAEBC\uB0B4 \uAC78\uC5C8\uB2E4. \uC57D\uAD6D 2\uCE35\uC5D0\uC11C \uB4E4\uACE0 \uC628 \uADF8\uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407159
    m_Localized: "\uBC24\uC0C8 \uC5F4\uC744 \uC7C0\uB2E4. \uC57D\uC744 \uC2DC\uAC04 \uB9DE\uCDB0 \uB123\uACE0, \uBD95\uB300\uB97C \uAC08\uACE0, \uB2E4\uC2DC \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407160
    m_Localized: "\uC0C8\uBCBD\uC774 \uB420 \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407161
    m_Localized: "\uC870\uAE08 \uB354 \uC900\uBE44\uD558\uACE0 \uD558\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407162
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uC11C\uB450\uB974\uC9C0 \uB9C8\uB77C. \uC544\uC9C1 \uC2DC\uAC04\uC740 \uC788\uB2E4. \uC870\uAE08\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407163
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB354\uB294 \uD63C\uC790 \uC77C\uC5B4\uB098\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407164
    m_Localized: "\uBCA0\uAC1C \uC606\uC5D0 \uCD9C\uC11D\uBD80\uAC00 \uC788\uC5C8\uB2E4. \uC0AC\uD0DC \uC774\uD6C4 \uB0B4\uB0B4 \uC4F0\uB358 \uADF8 \uCD9C\uC11D\uBD80."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407165
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70, \uC774\uC81C \uB124\uAC00 \uB4E4\uACE0 \uC788\uC5B4\uB77C. \uCD9C\uC11D\uC740 \uB124\uAC00 \uBD88\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407166
    m_Localized: "\uCD9C\uC11D\uBD80\uB97C \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407167
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uCC98\uC74C\uC73C\uB85C \uCD9C\uC11D\uC744 \uBD88\uB800\uB2E4. \uB3C4\uD604, \uC1A1\uC608\uC9C0, \uBC15 \uC120\uC0DD\uB2D8\u2026 \uADF8\uB9AC\uACE0 \uC724 \uC120\uC0DD\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407168
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB124. \uCD9C\uC11D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407169
    m_Localized: "\uC544\uC9C1\uC740 \uC120\uC0DD\uB2D8\uC774 \uBD80\uB974\uC2DC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407170
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uC9D1\uC740. \uADF8\uB7FC \uB0B4\uC77C\uB3C4 \uB0B4\uAC00 \uBD80\uB974\uB9C8. \uBAA9\uC18C\uB9AC\uAC00 \uB0A8\uC544 \uC788\uB294 \uB3D9\uC548\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407171
    m_Localized: "\uAD50\uBB34\uC2E4 \uC11C\uB958\uD568\uC744 \uC815\uB9AC\uD558\uB2E4\uAC00, 1\uB9C9 \uB54C \uCC59\uACA8 \uB454 \uACF5\uBB38\uACFC \uAC19\uC740 \uBC88\uD638\uC758 \uBB38\uC11C\uB97C \uCC3E\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407172
    m_Localized: "\uC218\uC2E0: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50. \uB0B4\uC6A9: \uAD50\uB0B4 \uC74C\uC218\uB300 \uC0AC\uC6A9 \uC77C\uC2DC \uC911\uC9C0 \uD611\uC870 \uC694\uCCAD. \uBC1C\uC2E0: \uC0C8\uBCBD\uC815\uC218\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407173
    m_Localized: "\uB0A0\uC9DC\uB294 \uC0AC\uD0DC \uC0AC\uD758 \uC804\uC774\uC5C8\uB2E4. \uD559\uAD50\uB294 \uADF8 \uACF5\uBB38\uC744 \uBC1B\uACE0\uB3C4 \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407174
    m_Localized: "\uBC24. \uBAA8\uC740 \uB2E8\uC11C\uB4E4\uC744 \uBC14\uB2E5\uC5D0 \uB298\uC5B4\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407175
    m_Localized: "\uC9C0\uD558\uCCA0 \uBC29\uC1A1. \uACFC\uD559\uC2E4 \uB178\uD2B8. \uD30C\uCD9C\uC18C \uC11C\uB958. \uC5F0\uAD6C\uB3D9 \uBA54\uBAA8. \uB77C\uB514\uC624\uC758 \uAE30\uC5B5."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407176
    m_Localized: "\uC120\uC744 \uAE0B\uC790 \uBAA8\uB4E0 \uC120\uC774 \uD55C \uC810\uC73C\uB85C \uBAA8\uC600\uB2E4. \uC815\uC218\uC7A5. \uADF8\uB9AC\uACE0 \uADF8\uB0A0 \uD559\uAD50\uC758 \uC218\uB3D7\uBB3C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407177
    m_Localized: "\uB204\uAD70\uAC00 \uBBF8\uB9AC \uC54C\uC558\uACE0, \uB9D0\uD588\uACE0, \uBB35\uC0B4\uB2F9\uD588\uB2E4. \uADF8 \uC0AC\uC774 \uB3C4\uC2DC\uB294 \uBB3C\uC744 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407178
    m_Localized: "\uC774\uAC83\uC744 \uB204\uAD70\uAC00\uC5D0\uAC8C \uC804\uD574\uC57C \uD55C\uB2E4. \uAD6C\uC870\uB300\uAC00 \uC624\uBA74, \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407179
    m_Localized: "\uD55C\uD30C\uAC00 \uC774\uC5B4\uC84C\uB2E4. \uC5F0\uB8CC\uAC00 \uBC14\uB2E5\uC744 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407180
    m_Localized: "\uAD50\uC2E4\uC774 \uB108\uBB34 \uCD94\uC6CC\uC11C \uC785\uAE40\uC73C\uB85C \uC190\uC744 \uB179\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407181
    m_Localized: "\uAD50\uC2E4 \uCC45\uAC78\uC0C1\uC744 \uB554\uAC10\uC73C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407182
    m_Localized: "1\uD559\uB144 3\uBC18 \uCC45\uC0C1\uC774 \uBD88 \uC18D\uC5D0\uC11C \uD0C1\uD0C1 \uC18C\uB9AC\uB97C \uB0C8\uB2E4. \uB204\uAD70\uAC00\uC758 \uB099\uC11C\uAC00 \uC0C8\uACA8\uC9C4 \uCC45\uC0C1\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407183
    m_Localized: "\uD55C \uAD50\uC2E4\uC5D0 \uBAA8\uB450 \uBAA8\uC5EC \uCCB4\uC628\uC73C\uB85C \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407184
    m_Localized: "\uC881\uC740 \uAD50\uC2E4\uC5D0 \uBAA8\uB450 \uBAA8\uC5EC \uB2F4\uC694\uB97C \uB098\uB220 \uB36E\uC5C8\uB2E4. \uB204\uAD70\uAC00\uC758 \uCF54 \uACE0\uB294 \uC18C\uB9AC\uC5D0 \uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407185
    m_Localized: "\uB3C4\uC11C\uAD00\uC758 \uC624\uB798\uB41C \uCC45\uC744 \uD0DC\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407186
    m_Localized: "\uB0A1\uC740 \uBC31\uACFC\uC0AC\uC804\uBD80\uD130 \uB123\uC5C8\uB2E4. \uC18C\uC124\uC740 \uB05D\uAE4C\uC9C0 \uB0A8\uACA8 \uB450\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uACE0\uC9D1\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407187
    m_Localized: "\uAD6C\uC870\uB97C 3\uC8FC \uC55E\uB454 \uBC24. \uB208 \uC704\uB85C \uC218\uC2ED \uAC1C\uC758 \uADF8\uB9BC\uC790\uAC00 \uD559\uAD50\uB97C \uD5A5\uD574 \uAC78\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407188
    m_Localized: "\uC625\uC0C1\uC758 SOS \uD45C\uC2DC\uB97C \uC9C0\uD0A4\uB294 \uAC83\uCC98\uB7FC, \uBAA8\uB450\uAC00 \uC81C\uC790\uB9AC\uC5D0 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407189
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uB204\uC6B4 \uCC44\uB85C \uB9D0\uD588\uB2E4. \uBB34\uC804\uAE30\uB97C \uC950\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407190
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uC11C \uB2E4 \uBCF4\uC778\uB2E4. \uB0B4\uAC00 \uB208\uC774 \uB418\uC5B4 \uC8FC\uB9C8. \uC67C\uCABD \uACC4\uB2E8, \uC14B."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407191
    m_Localized: "\uAD6C\uC870\uB300: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50, \uB4E4\uB9BD\uB2C8\uAE4C. \uAD6C\uC870\uB300\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407192
    m_Localized: "\uAD6C\uC870\uB300: \uC608\uC815\uB300\uB85C 3\uC6D4 \uB458\uC9F8 \uC8FC \uC544\uCE68, \uC625\uC0C1\uC73C\uB85C \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407193
    m_Localized: "\uAD6C\uC870\uB300: \uC624\uB294 \uAE38\uC5D0 \uC778\uADFC \uC8FC\uD0DD\uAC00\uC5D0\uC11C \uC0DD\uC874\uC790 \uD55C \uBA85\uC744 \uBA3C\uC800 \uD0DC\uC6C1\uB2C8\uB2E4. \uADF8 \uC0DD\uC874\uC790\uAC00 \uC0C8\uBCBD\uACE0\uC5D0 \uC544\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uACE0 \uD558\uB354\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407194
    m_Localized: "\uBB34\uC804\uAE30\uB97C \uC954 \uC190\uC774 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407195
    m_Localized: "{0}: \u2026\uC774\uB984\uC740\uC694? \uADF8 \uC0AC\uB78C \uC774\uB984\uC774 \uBB50\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407196
    m_Localized: "\uAD6C\uC870\uB300: \uC2E0\uD638\uAC00 \uC57D\uD569\uB2C8\uB2E4. \uB2E4\uC74C \uAD50\uC2E0 \uB54C. \uB05D\uAE4C\uC9C0 \uBC84\uD168 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407197
    m_Localized: "\uAD6C\uC870 \uC77C\uC8FC\uC77C \uC804 \uBC24. \uC120\uC0DD\uB2D8\uC774 \uBAA8\uB450\uB97C \uB0B4\uBCF4\uB0B4\uACE0 \uB098\uB97C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407198
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC80\uC9C4\uC774 \uC788\uB2E4\uACE0 \uD588\uC9C0. \uB098\uB294 \uBABB \uD0C4\uB2E4. \uADF8\uAC74 \uC54C\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407199
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC815\uD558\uC790. \uB0B4\uAC00 \uC5B4\uB5BB\uAC8C \uB0A8\uC744\uC9C0. \uB124\uAC00 \uC815\uD574\uB3C4 \uB418\uACE0, \uB0B4 \uB9D0\uC744 \uB4E4\uC5B4\uB3C4 \uB418\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407200
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC744 \uD574 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407201
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uB2E4. \uCE60\uD310 \uC9C0\uC6B0\uACE0, \uBD84\uD544 \uC0C8\uAC83\uC73C\uB85C. \uC8FC\uC81C\uB294\u2026 \uB124\uAC00 \uC815\uD55C \uAC70\uC600\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407246
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6B0\uB9AC \uC774\uB984\uC744 \uD558\uB098\uC529 \uBD88\uB800\uB2E4. \uC878\uC5C5\uD558\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uC9C0\uB9CC, \uB2E4\uB4E4 \uC55E\uC73C\uB85C \uB098\uAC00 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407245
    m_Localized: "\uC878\uC5C5\uC2DD\uC744 \uB05D\uAE4C\uC9C0 \uCE58\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407244
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC878\uC5C5\uC7A5\uC740 \uC5C6\uB2E4. \uB300\uC2E0 \uC774\uB984\uC744 \uBD80\uB974\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407243
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uD720\uCCB4\uC5B4 \uB300\uC2E0 \uB04C\uACE0 \uC628 \uC0AC\uBB34\uC6A9 \uC758\uC790\uC5D0 \uC549\uC544 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407202
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC774 \uC788\uC5C8\uB2E4. \uD559\uC0DD\uC740 \uD558\uB098\uC600\uACE0, \uC120\uC0DD\uB2D8\uC740 \uB204\uC6CC\uC11C \uAC00\uB974\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407203
    m_Localized: "\uD310\uC11C\uB294 \uB0B4\uAC00 \uD588\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBD80\uB974\uB294 \uB300\uB85C, \uD55C \uAE00\uC790\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407204
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uB73B\uB300\uB85C, \uBC29\uC1A1\uC2E4\uB85C \uBAA8\uC154 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407205
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uB9D9\uB2E4. \uB2E4\uB978 \uC0AC\uB78C\uB4E4 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uC548 \uB418\uB294 \uAC70\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407206
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38\uC744 \uB2EB\uAE30 \uC804\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4. \uC544\uCE68\uB9C8\uB2E4 \uBC29\uC1A1\uC73C\uB85C \uCD9C\uC11D\uC744 \uBD80\uB97C \uAC70\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407207
    m_Localized: "\uAC10\uC5FC\uC744 \uC228\uAE30\uACE0 \uD568\uAED8 \uD0C0\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407208
    m_Localized: "{0}: \uC5F4\uB9CC \uB0B4\uB9AC\uBA74 \uB3FC\uC694. \uAC80\uC9C4 \uADF8\uAC70, \uC18D\uC77C \uC218 \uC788\uC5B4\uC694. \uAC19\uC774 \uAC00\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407209
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC624\uB798 \uC6C3\uB2E4\uAC00, \uADF8\uB7EC\uC790\uACE0 \uD588\uB2E4. \uAC70\uC9D3\uB9D0\uC778 \uC904 \uC54C\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407210
    m_Localized: "\uB098\uB3C4 \uB0A8\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407211
    m_Localized: "{0}: \uC800\uB3C4 \uC548 \uAC08\uB798\uC694. \uC120\uC0DD\uB2D8\uC774 \uD63C\uC790 \uB0A8\uB294 \uAC70, \uC2EB\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407212
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uBC14\uBCF4 \uAC19\uC740 \uC18C\uB9AC. \uC815\uB9D0 \uBC14\uBCF4 \uAC19\uC740 \uC18C\uB9AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407213
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC6B0\uB294 \uAC78 \uCC98\uC74C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407214
    m_Localized: "\uC870\uC6A9\uD788 \uC791\uBCC4 \uC778\uC0AC\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407215
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uB108\uBA38\uB85C \uC778\uC0AC\uB97C \uD588\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBB38 \uB108\uBA38\uC5D0\uC11C \uB300\uB2F5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407216
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC120\uD0DD, \uD0D3\uD558\uC9C0 \uB9C8\uB77C. \uB124\uAC00 \uC0B4\uC544\uB0A8\uB294 \uCABD\uC744 \uACE8\uB790\uB2E4\uB294 \uAC8C \uB0B4 \uC790\uB791\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407217
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uCCB4\uC628\uACC4\uB97C \uB0B4\uB824\uB193\uACE0 \uC218\uCCA9\uC5D0 \uC801\uC5C8\uB2E4. \uC815\uC0C1."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407218
    m_Localized: "\uC77C\uC8FC\uC77C\uC9F8 \uAC19\uC740 \uAE00\uC790\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407219
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC80\uC9C4, \uD1B5\uACFC\uD558\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407220
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD1B5\uACFC \uBABB \uD558\uBA74 \uC81C\uAC00 \uAD6C\uC870\uB300\uB97C \uBD99\uC7A1\uACE0 \uB530\uC9C8 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407221
    m_Localized: "\uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0, \uC544\uBB34 \uAC71\uC815 \uC5C6\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407222
    m_Localized: "\uAD6C\uC870 \uC804\uB0A0 \uBC24. \uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407223
    m_Localized: "\uC625\uC0C1\uC758 SOS \uAE00\uC528\uB97C \uB2E4\uC2DC \uCE60\uD588\uB2E4. \uB208 \uC704\uC5D0 \uBE68\uAC04 \uD398\uC778\uD2B8\uAC00 \uC120\uBA85\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407242
    m_Localized: "\uC120\uC0DD\uB2D8\uC744 \uB2F4\uC694\uC9F8 \uB9E4\uD2B8\uC5D0 \uB215\uD600 \uAC15\uB2F9 \uC55E\uC73C\uB85C \uC62E\uACBC\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBCA0\uAC1C\uB97C \uBC1B\uCCD0 \uB2EC\uB77C\uACE0 \uD588\uB2E4. \uC6B0\uB9AC\uB97C \uBCFC \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407224
    m_Localized: "\uB3C4\uD604\uC740 \uAC00\uBC29\uC744 \uC138 \uBC88\uC774\uB098 \uB2E4\uC2DC \uC30C\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC740 \uC57D\uC7A5\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC815\uB9AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407225
    m_Localized: "\uBAA8\uB450\uC640 \uC625\uC0C1\uC5D0\uC11C \uBC24\uD558\uB298\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407226
    m_Localized: "\uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uAC19\uC740 \uBCC4\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407227
    m_Localized: "\uC77C\uAE30\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC744 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407228
    m_Localized: "52\uC8FC\uC9F8. \uC4F8 \uB9D0\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C, \uD55C \uC904\uB9CC \uC37C\uB2E4. \uB0B4\uC77C, \uBB38\uC774 \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407229
    m_Localized: "\uD06C\uB9AC\uC2A4\uB9C8\uC2A4. \uAD50\uC2E4 \uAD6C\uC11D\uC5D0 \uB300\uAC78\uB808 \uC790\uB8E8\uB85C \uD2B8\uB9AC\uB97C \uC138\uC6E0\uB2E4. \uC7A5\uC2DD\uC740 \uC740\uBC15\uC9C0\uC640 \uBCD1\uB69C\uAED1."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407230
    m_Localized: "\uC11C\uB85C\uC5D0\uAC8C \uC791\uC740 \uC120\uBB3C\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407231
    m_Localized: "\uB3C4\uD604\uC740 \uB098\uBB34 \uC870\uAC01 \uBD80\uC5C9\uC774\uB97C, \uBC15 \uC120\uC0DD\uB2D8\uC740 \uC9C1\uC811 \uB72C \uBAA9\uB3C4\uB9AC\uB97C \uB0B4\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407232
    m_Localized: "\uB098\uB294 \uC120\uC0DD\uB2D8\uAED8 \uC0C8 \uBD84\uD544 \uD55C \uC0C1\uC790\uB97C \uB4DC\uB838\uB2E4. \uB9E4\uC810 \uCC3D\uACE0 \uAD6C\uC11D\uC5D0\uC11C \uCC3E\uC740 \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407233
    m_Localized: "\uB2E4 \uAC19\uC774 \uCE90\uB7F4\uC744 \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407234
    m_Localized: "\uC791\uC740 \uBAA9\uC18C\uB9AC\uB85C \uBD88\uB800\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBC15\uC790\uB97C \uB193\uCE58\uBA74\uC11C\uB3C4 \uB05D\uAE4C\uC9C0 \uB530\uB77C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407235
    m_Localized: "\uC0C8\uD574 \uCCAB\uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407236
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uD574\uB3CB\uC774\uB97C \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407237
    m_Localized: "\uD574\uAC00 \uAC15 \uB108\uBA38\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC62C\uB77C\uC654\uB2E4. \uC190\uC774 \uC5BC\uC5C8\uC9C0\uB9CC \uB05D\uAE4C\uC9C0 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407238
    m_Localized: "\uC0C8\uD574 \uACB0\uC2EC\uC744 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407239
    m_Localized: "\uC885\uC774 \uD55C \uC7A5\uC5D0 \uC801\uC5C8\uB2E4. \uD558\uB098, \uC0B4\uC544\uB0A8\uAE30. \uB458, \uADF8\uB2E4\uC74C\uC5D0 \uD558\uACE0 \uC2F6\uC740 \uAC78 \uCC3E\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407240
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uC878\uC5C5\uC2DD \uB0A0\uC774\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uD559\uAE30\uC758 \uB9C8\uC9C0\uB9C9 \uD589\uC0AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407241
    m_Localized: "\uAC15\uB2F9\uC5D0 \uC758\uC790\uB97C \uBA87 \uAC1C \uB193\uC558\uB2E4. 3\uD559\uB144 \uC120\uBC30\uB4E4\uC758 \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212618
    m_Localized: "5\uC6D4 15\uC77C. \uB2EC\uB825\uC5D0 \uC791\uAC8C '\uC2A4\uC2B9\uC758 \uB0A0'\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8 \uAE00\uC528\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uC774 \uB2EC\uB825\uC744 \uAC78\uC5B4 \uB454 \uB204\uAD70\uAC00\uC758 \uAE00\uC528\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212617
    m_Localized: "\uCC3D\uBC16\uC740 \uC2DC\uD5D8 \uB0A0\uCC98\uB7FC \uC870\uC6A9\uD588\uB2E4. \uADF8\uAC74 \uC608\uC804\uC5D0\uB3C4 \uADF8\uB7AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212616
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBCF4\uACE0 \uC2F6\uC5B4\uC9C0\uBA74 \uB9D0\uD574. \uBB38\uC81C\uB294 \uC548 \uBC14\uAFC0 \uAC70\uC57C. \uBBF8\uB9AC \uBD10\uB3C4 \uBAA8\uB978 \uCC99\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212615
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2DC\uD5D8\uC9C0\uB97C \uBC18\uC73C\uB85C \uC811\uC5B4 \uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212614
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uAC8C. \uB2E4\uB4E4 \uC2DC\uD5D8\uC774 \uC5C6\uC5B4\uC9C0\uAE38 \uADF8\uB807\uAC8C \uBC14\uB790\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212613
    m_Localized: "{0}: \uC2DC\uD5D8 \uC548 \uBD10\uB3C4 \uB418\uB294 \uC138\uC0C1\uC774 \uB410\uB294\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212612
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACB0\uC11D \uCC98\uB9AC. \uB300\uC2E0 \uC625\uC0C1 \uCCAD\uC18C \uBC8C\uC810\uC774\uB2E4. \u2026\uB18D\uB2F4\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212611
    m_Localized: "\uC624\uB298\uC740 \uB561\uB561\uC774\uCE5C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212610
    m_Localized: "\uC2DC\uD5D8\uC9C0 \uC704\uCABD\uC5D0 \uBE68\uAC04 \uC0C9\uC5F0\uD544 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uC77C\uACF1 \uAC1C. \uC774\uB984 \uCE78 \uC606\uC5D0\uB294 \uC791\uAC8C '\uCC38 \uC798\uD588\uC5B4\uC694'."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212609
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uD649 \uBB38\uC81C \uC911\uC5D0 \uC77C\uACF1 \uAC1C. 10\uBC88\uC740 \uC815\uB2F5\uC774 \uC5C6\uB294 \uBB38\uC81C\uB77C\uC11C. \u2026\uC798 \uC37C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163158212608
    m_Localized: "\uD55C\uCC38 \uC5F0\uD544\uC744 \uB4E4\uACE0 \uC788\uB2E4\uAC00 \uD55C \uC904\uC744 \uC37C\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uADF8 \uBB38\uC81C\uB9CC \uCC44\uC810\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163095298048
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBB38\uC81C\uB294 '\uC9C0\uAE08 \uAC00\uC7A5 \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC744 \uD55C \uBB38\uC7A5\uC73C\uB85C \uC4F0\uC2DC\uC624'\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407580
    m_Localized: "{0}: \uC5ED\uC2DC\u2026 \uACF5\uBD80\uD558\uB294 \uC560\uB294 \uB2E4\uB974\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407581
    m_Localized: "\uB531 \uC911\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407582
    m_Localized: "{0}: \uC911\uAC04\uC774 \uC81C\uC77C \uD3B8\uD574. \uAE30\uB300\uB3C4 \uC5C6\uACE0 \uAC71\uC815\uB3C4 \uC5C6\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407583
    m_Localized: "\uB9D0\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uC544\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407584
    m_Localized: "{0}: \uAD1C\uCC2E\uC544. \uB300\uC2E0 \uB108 \uCCB4\uC721\uC740 \uC798\uD558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407585
    m_Localized: "\uC544\uC9C1 \uD655\uC778 \uC548 \uD588\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407586
    m_Localized: "{0}: \uB300\uB2E8\uD558\uB2E4, \uADF8 \uBC30\uC9F1."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407587
    m_Localized: "{0}: \uADF8\uB7FC \uC81C\uC77C \uC790\uC2E0 \uC788\uB294 \uACFC\uBAA9\uC740?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407588
    m_Localized: "\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407589
    m_Localized: "\uC218\uD559\xB7\uACFC\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407590
    m_Localized: "\uCCB4\uC721"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407591
    m_Localized: "\uAE30\uC220\xB7\uAC00\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407592
    m_Localized: "\uC0DD\uBA85\uACFC\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407593
    m_Localized: "\uB531\uD788 \uC5C6\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407594
    m_Localized: "{0}: \uC544 \uB9DE\uB2E4, \uC624\uB298 \uB3D9\uC544\uB9AC \uC2E0\uCCAD \uB9C8\uAC10\uC774\uC796\uC544. \uB108 \uC5B4\uB514 \uB123\uC5C8\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407595
    m_Localized: "\uC721\uC0C1\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407596
    m_Localized: "\uC694\uB9AC\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407597
    m_Localized: "\uACFC\uD559\uD0D0\uAD6C\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407598
    m_Localized: "\uB3C4\uC11C\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407599
    m_Localized: "\uBBF8\uC220\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407600
    m_Localized: "\uBC29\uC1A1\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407601
    m_Localized: "\uBCF4\uAC74\uBC18"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407602
    m_Localized: "\uADC0\uAC00\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407603
    m_Localized: "{0}: \uC9D1\uC5D0 \uBE68\uB9AC \uAC00\uB294 \uAC83\uB3C4 \uC7AC\uB2A5\uC774\uC57C. \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407604
    m_Localized: "\uAD50\uBB38 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4. \uB9DE\uC740\uD3B8\uC5D0\uC11C \uB0AF\uC775\uC740 \uBB34\uB9AC\uAC00 \uAC78\uC5B4\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407605
    m_Localized: "\uAC19\uC740 \uC911\uD559\uAD50\uC5D0\uC11C \uC62C\uB77C\uC628 \uC560\uB4E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC774\uCABD\uAE4C\uC9C0 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407606
    m_Localized: "{0}\uC758 \uD45C\uC815\uC774 \uAD73\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407607
    m_Localized: "{0}: \u2026\uC7E4\uB124 \uB610 \uADF8\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407608
    m_Localized: "\"\uAD1C\uCC2E\uC544.\" \uD558\uACE0 \uC6C3\uC5B4\uB118\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407609
    m_Localized: "\uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uD558\uB294 \uAC74 \uC0DD\uAC01\uBCF4\uB2E4 \uC26C\uC6E0\uB2E4. \uB298 \uADF8\uB7AC\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407610
    m_Localized: "\uACE0\uAC1C\uB97C \uC219\uC774\uACE0 \uAC78\uC74C\uC744 \uC7AC\uCD09\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407611
    m_Localized: "\uC2E0\uD638\uAC00 \uBC14\uB00C\uC790\uB9C8\uC790 \uBA3C\uC800 \uAC74\uB11C\uB2E4. \uB4A4\uB97C \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407612
    m_Localized: "\uCC98\uC74C\uC73C\uB85C {0}\uC5D0\uAC8C \uD138\uC5B4\uB193\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407613
    m_Localized: "\uC9E7\uAC8C, \uC544\uC8FC \uC870\uAE08\uB9CC \uB9D0\uD588\uB2E4. {0}\uB294 \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407614
    m_Localized: "{0}: \u2026\uC65C \uC774\uC81C \uB9D0\uD574. \uBC14\uBCF4\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407615
    m_Localized: "\uADF8 \uBB34\uB9AC\uB97C \uB611\uBC14\uB85C \uB9C8\uC8FC \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407616
    m_Localized: "\uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4. \uC2EC\uC7A5\uC774 \uADC0\uC5D0\uC11C \uB6F0\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407617
    m_Localized: "\uBA40\uB9AC\uC11C \uAD6C\uAE09\uCC28 \uC0AC\uC774\uB80C\uC774 \uAE38\uAC8C \uC6B8\uB838\uB2E4. \uC624\uB298 \uC544\uCE68\uC5D0\uB9CC \uBC8C\uC368 \uC138 \uBC88\uC9F8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407618
    m_Localized: "{0}: \uC694\uC998 \uC5F4\uBCD1 \uB3C8\uB300. \uC606 \uBC18 \uC560\uB3C4 \uACB0\uC11D\uD588\uB2E4\uB358\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407619
    m_Localized: "{0}: \uC544\uBB34\uD2BC! \uBC29\uACFC \uD6C4\uC5D0 \uB5A1\uBCF6\uC774 \uCF5C?"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407620
    m_Localized: "\uCF5C. \uC218\uC5C5 \uB05D\uB098\uACE0 \uAD50\uBB38 \uC55E\uC5D0\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407621
    m_Localized: "{0}: \uC57D\uC18D\uD588\uB2E4? \uB3C4\uB9DD\uAC00\uBA74 \uC8FD\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407622
    m_Localized: "\uC624\uB298\uC740 \uC880\u2026 \uB2E4\uC74C\uC5D0 \uAC00\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407623
    m_Localized: "{0}: \uCE58. \uADF8\uB7FC \uB0B4\uC77C\uC740 \uBB34\uC870\uAC74\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407624
    m_Localized: "\uC885\uC774 \uC6B8\uB838\uB2E4. {0}\uAC00 \uB2E4\uB978 \uBC18 \uCABD\uC73C\uB85C \uC190\uC744 \uD754\uB4E4\uBA70 \uB6F0\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407625
    m_Localized: "\uADF8\uAC8C, \uADF8\uB0A0 \uBCF8 {0}\uC758 \uB9C8\uC9C0\uB9C9 \uBAA8\uC2B5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407626
    m_Localized: "\uC218\uC5C5\uC740 \uC774\uC0C1\uD558\uAC8C \uAE38\uC5C8\uB2E4. \uBE48\uC790\uB9AC\uAC00 \uBA87 \uAC1C \uB354 \uB298\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407627
    m_Localized: "\uBC29\uACFC \uD6C4, \uCCB4\uC721\uBD80\uC7A5 \uC2EC\uBD80\uB984\uC73C\uB85C \uCCB4\uC721\uAD00 \uCC3D\uACE0\uC5D0 \uACF5\uC744 \uAC16\uB2E4 \uB193\uC73C\uB7EC \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407628
    m_Localized: "\uB4F1 \uB4A4\uC5D0\uC11C \uBB38\uC774 \uB2EB\uD788\uB294 \uC18C\uB9AC. \uADF8\uB9AC\uACE0 \uBC14\uAE65\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uAC78\uB9AC\uB294 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407629
    m_Localized: "\"\uC57C, \uC5F4\uC5B4 \uC918.\" \uB300\uB2F5 \uB300\uC2E0 \uBA40\uC5B4\uC9C0\uB294 \uC6C3\uC74C\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407630
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407631
    m_Localized: "\uADF8\uB9AC\uACE0 \uD559\uAD50\uAC00 \uC870\uC6A9\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407632
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407633
    m_Localized: "7\uC77C\uC9F8 \uB418\uB294 \uB0A0, \uCCA0\uBB38\uC774 \uB35C\uCEF9\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 504163162407634
    m_Localized: "\uBB38\uD2C8\uC73C\uB85C \uB4E4\uC5B4\uC628 \uBE5B \uC18D\uC5D0, \uBCBD\uC744 \uC9DA\uACE0 \uBAB8\uC744 \uB04C\uB2E4\uC2DC\uD53C \uD55C \uB204\uAD70\uAC00\uC758 \uC2E4\uB8E8\uC5E3\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
