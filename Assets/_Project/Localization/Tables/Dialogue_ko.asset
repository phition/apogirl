--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 33f6960b278f4ad429ad72f31ea481ac, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1372806649757942
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uB178\uB798\uC5D0 \uB9DE\uCDB0 \uB204\uAD70\uAC00 \uBC1C\uB85C \uBC15\uC790\uB97C \uB9DE\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757941
    m_Localized: "DJ: \uC0C8\uBCBD\uACE0! \uBC18\uAC00\uC6CC\uC694. \uC624\uB298 \uBC24\uC740 \uC774 \uB178\uB798\uB85C \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757940
    m_Localized: "DJ: \uB610 \uC0C8\uBCBD\uACE0! \uB2E8\uACE8 \uC0DD\uACBC\uB124. \uC624\uB298\uB3C4 \uC2E0\uB098\uB294 \uAC78\uB85C \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654261
    m_Localized: "\uAD6C\uC870\uB97C \uBA70\uCE60 \uC55E\uB454 \uBC24. \uCD9C\uC11D\uBD80\uB97C \uC815\uB9AC\uD558\uB2E4\uAC00, \uB9E8 \uB4B7\uC7A5\uC758 \uD55C \uC904\uC5D0\uC11C \uC190\uC774 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654262
    m_Localized: "\uB2E4\uB978 \uC904\uC5D0\uB294 \uB2E4 \uC774\uB984\uC774 \uC788\uC5C8\uB2E4. \uADF8 \uC904\uC5D0\uB294 \uC120\uC0DD\uB2D8 \uAE00\uC528\uB85C '2\uD559\uB144'\uC774\uB77C\uACE0\uB9CC \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786217
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uBC84\uD17C\uB2E4. \uB9C8\uC9C0\uB9C9 \uD55C \uB9C8\uB9AC\uAC00 \uBB38\uD2C8\uC5D0\uC11C \uBC00\uB824\uB098\uAC08 \uB54C\uAE4C\uC9C0 \uB458\uC740 \uB4F1\uC744 \uB9DE\uB300\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786216
    m_Localized: "\uCCA0\uBB38\uC774 \uC548\uCABD\uC73C\uB85C \uD718\uC5C8\uB2E4. \uC218\uC2ED \uAC1C\uC758 \uBC1C\uC18C\uB9AC\uAC00 \uD55C\uAEBC\uBC88\uC5D0 \uBAB0\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174866
    m_Localized: "{0}: \uC544\uD508 \uC0AC\uB78C\uC774 \uBA3C\uC800\uC608\uC694. \uB0B4\uC77C \uB098\uAC00\uC57C \uD558\uB294 \uC0AC\uB78C\uC774\uB77C\uB3C4, \uC624\uB298 \uC544\uD504\uC9C0 \uC54A\uC73C\uBA74 \uAE30\uB2E4\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757939
    m_Localized: "{0}: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC694. \uC544\uBB34 \uB178\uB798\uB098\u2026 \uC2E0\uB098\uB294 \uAC78\uB85C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654263
    m_Localized: "\uC120\uBC30\uAC00 \uB0B4 \uC190\uC758 \uCD9C\uC11D\uBD80\uB97C \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC190\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uBB34\uC5B8\uAC00\uB97C \uB2EC\uB77C\uACE0 \uD558\uB294 \uAC74 \uCC98\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118045
    m_Localized: "\uACF5\uCC45 \uB9C8\uC9C0\uB9C9 \uC904\uC5D0 \uC120\uBC30\uAC00 \uC791\uAC8C \uC37C\uB2E4. \u300C\uC798\uD558\uB124\u300D. \uB098\uB294 \uADF8 \uC7A5\uC744 \uCC22\uC9C0 \uC54A\uACE0 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146494
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC758 \uC774\uBD88 \uC606\uC5D0 \uB098\uB780\uD788 \uC549\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uB9CC \uACA8\uC6B0 \uB4E4\uC5B4 \uC6B0\uB9AC \uBA38\uB9AC\uB97C \uD558\uB098\uC529 \uC4F0\uB2E4\uB4EC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757938
    m_Localized: "\uC2E0\uCCAD\uACE1\uC744 \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757937
    m_Localized: "DJ: \uC81C\uAC00 \uBD88\uB7EC \uB4DC\uB9B4\uAC8C\uC694. \u2026\uBABB \uBD88\uB7EC\uB3C4 \uC6C3\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757936
    m_Localized: "DJ: \uC624\uB298\uC740 \uC2E0\uCCAD\uACE1 \uB300\uC2E0 \uC2E0\uCCAD \uC0AC\uC5F0\uB3C4 \uBC1B\uC544\uC694. \uB178\uB798\uAC00 \uAE30\uC5B5 \uC548 \uB098\uBA74 \uC81C\uBAA9\uB9CC \uB9D0\uD574\uB3C4 \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757935
    m_Localized: "DJ: \uC774 \uB3C4\uC2DC\uC5D0 \uC544\uC9C1 \uB178\uB798 \uB4E3\uB294 \uC0AC\uB78C\uC774 \uC14B \uC774\uC0C1 \uC788\uB2E4\uB294 \uAC70\uC608\uC694. \uC624\uB298\uC758 \uC88B\uC740 \uC18C\uC2DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757934
    m_Localized: "DJ: \uC2E0\uCCAD\uACE1 \uC2DC\uAC04\uC774\uC5D0\uC694. \uC9C0\uB09C\uC8FC\uC5D4 \uC2E0\uD638\uAC00 \uC138 \uAD70\uB370\uC11C \uC654\uC5B4\uC694. \uC138 \uAD70\uB370\uB098\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118046
    m_Localized: "\uC720\uB791\uC790\uB294 \uACF5\uBD80 \uBAA8\uC784\uC774\uB77C\uB294 \uB9D0\uC5D0 \uCF54\uC6C3\uC74C\uC744 \uCCE4\uB2E4. \uADF8\uB7EC\uB354\uB2C8 \uB0B4 \uC9C0\uB9AC\uBD80\uB3C4\uB97C \uB04C\uC5B4\uB2F9\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118047
    m_Localized: "\uC720\uB791\uC790: \uB4F1\uACE0\uC120\uC740 \uC774\uB807\uAC8C \uC77D\uB294 \uAC70\uB2E4. \uCD18\uCD18\uD558\uBA74 \uAC00\uD30C\uB974\uACE0, \uC131\uAE30\uBA74 \uC644\uB9CC\uD558\uACE0. \uC774\uAC70 \uD558\uB098\uBA74 \uAE38\uC744 \uC548 \uC783\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757933
    m_Localized: "DJ: \uC870\uAC74\uC740 \uD558\uB098. \uC2AC\uD508 \uB178\uB798\uB294 \uC548 \uB3FC\uC694. \uC694\uC998\uC740 \uB2E4\uB4E4 \uCDA9\uBD84\uD788 \uC2AC\uD504\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757932
    m_Localized: "DJ: \uC624\uB298\uC740 \uC2E0\uCCAD\uACE1 \uBC1B\uC2B5\uB2C8\uB2E4. 3\uBC88 \uCC44\uB110, \uC544\uBB34\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757931
    m_Localized: "\uB09C\uB85C \uC55E\uC790\uB9AC \uADDC\uCE59\uC774 \uC0DD\uACBC\uB2E4. \uAC00\uC7A5 \uB2A6\uAC8C \uB4E4\uC5B4\uC628 \uC0AC\uB78C\uC774 \uC81C\uC77C \uC55E."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786215
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC5B4\uB098. \uC9C0\uAE08. \uBB38 \uCABD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786214
    m_Localized: "\uC790\uC815 \uBB34\uB835, \uD559\uAD50 \uC804\uCCB4\uAC00 \uC6B8\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC6B4\uB3D9\uC7A5 \uCABD\uC5D0\uC11C, \uBCF5\uB3C4\uC5D0\uC11C, \uACC4\uB2E8\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118048
    m_Localized: "\uAD50\uACFC\uC11C\uC5D0 \uC788\uB358 \uB0B4\uC6A9\uC774\uC5C8\uB2E4. \uC720\uB791\uC790 \uC785\uC73C\uB85C \uB4E4\uC73C\uB2C8 \uCC98\uC74C \uB4E3\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654321
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC758\uC790\uC5D0 \uC549\uC740 \uCC44, \uB204\uAD70\uAC00 \uC4F0\uB2E4 \uB9CC \uC2DC\uAC04\uD45C\uB97C \uC9C0\uC6B0\uACE0 \uCE60\uD310 \uC544\uB798\uCABD\uC5D0 \uC0C8\uB85C \uC801\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757983
    m_Localized: "{0}: \uC54C\uB824 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694. \uADF8\uB0A0\uC740 \uC6B0\uB9AC\uAC00 \uC9C0\uD0AC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174867
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8 \uB208\uBE5B\uC774 \uC870\uAE08 \uB180\uB780 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757930
    m_Localized: "\uB2E4 \uAC19\uC774 \uB09C\uB85C \uC8FC\uC704\uC5D0 \uBAA8\uC5EC \uC190\uC744 \uB179\uC600\uB2E4. \uB204\uAD70\uAC00 \uACE0\uAD6C\uB9C8\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757929
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uB09C\uB85C\uB97C \uD53C\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757928
    m_Localized: "\uB300\uC2E0 \uD328\uB529\uC744 \uAEF4\uC785\uACE0 \uC7A4\uB2E4. \uC544\uCE68\uC5D0 \uC5B4\uAE68\uAC00 \uBED0\uADFC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757927
    m_Localized: "\uC120\uC0DD\uB2D8 \uC704\uC5D0 \uB2F4\uC694\uB97C \uD558\uB098 \uB354 \uB36E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654320
    m_Localized: "1-5\uBC18 \uAD50\uC2E4\uC5D0\uC11C \uB9DE\uB294 \uCCAB \uBC24\uC774\uC5C8\uB2E4. \uCC45\uC0C1\uC744 \uBC00\uC5B4 \uBD99\uC5EC \uCE68\uB300\uB97C \uB9CC\uB4E4\uACE0, \uCEE4\uD2BC\uC744 \uB05D\uAE4C\uC9C0 \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146753
    m_Localized: "\uC18C\uC124\uC740 \uB05D\uAE4C\uC9C0 \uB0A8\uACA8 \uB450\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uACE0\uC9D1\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757982
    m_Localized: "\uC6B0\uB9AC \uC77C\uC740 \uC6B0\uB9AC\uAC00 \uD558\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174847
    m_Localized: "\uB3C4\uD604\uC774 \uC804\uB2E8\uC9C0\uC758 '\uCCB4\uC721\uACF5\uC6D0'\uC774\uB77C\uB294 \uAE00\uC790\uC5D0\uC11C \uB208\uC744 \uB5BC\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146493
    m_Localized: "\uC624\uB298\uC740 \uC124\uB0A0\uC774\uC5C8\uB2E4. \uB2EC\uB825\uC5D0\uB3C4, \uB9C8\uC74C\uC5D0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757926
    m_Localized: "\uC7A0\uB4E0 \uB3C4\uD604 \uC704\uC5D0 \uB2F4\uC694\uB97C \uB36E\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757925
    m_Localized: "\uB0B4 \uB2F4\uC694\uB97C \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uB36E\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757924
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uAE30\uCE68\uC774 \uCD94\uC704 \uC18D\uC5D0\uC11C \uB354 \uD06C\uAC8C \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757923
    m_Localized: "\uADF8\uB798\uB3C4 \uBC1C\uB05D\uC774 \uC2DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786213
    m_Localized: "\uCCAB \uBD88\uCE68\uBC88\uC740 \uC120\uC0DD\uB2D8\uC774\uC5C8\uB2E4. \uC0C8\uBCBD\uC5D0 \uAD50\uB300\uD558\uB7EC \uC77C\uC5B4\uB098 \uBCF4\uB2C8, \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uB72C \uCC44 \uBB38\uB9CC \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146492
    m_Localized: "\uBD88\uC744 \uC544\uB07C\uB824\uACE0 \uC77C\uCC0D \uB204\uC6E0\uB2E4. \uAE34 \uBC24\uC774\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uB0B4\uC77C\uBD80\uD130\uB294, \uC870\uAE08\uC529 \uC9E7\uC544\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460180
    m_Localized: "{0}: \uADF8\uB7FC \uC624\uB298 \uB9C8\uC9C0\uB9C9 \uAC70. \uC5EC\uB35F \uBC88\uC9F8, \uAD1C\uCC2E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460179
    m_Localized: "\"\uADF8\uB7FC \uC624\uB298 \uB9C8\uC9C0\uB9C9 \uAC70, \uC5EC\uB35F \uBC88\uC9F8 \uAD1C\uCC2E\uC544\uC694.\" \uD558\uACE0 \uC6C3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460178
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB9CC \uAD1C\uCC2E\uC9C0 \uC54A\uC740 \uB0A0\uC5D4, \uADF8 \uB9D0 \uB300\uC2E0 \uB2E4\uB978 \uB9D0\uC744 \uD574\uB3C4 \uB41C\uB2E4\uB294 \uAC83\uB9CC \uC54C\uC544 \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460177
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6C3\uB294 \uAC74 \uC88B\uC544. \uC815\uB9D0\uB85C. \uB124\uAC00 \uC6C3\uC73C\uBA74 \uB098\uB3C4 \uBC84\uD2F8 \uB9CC\uD574\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786212
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC549\uC544\uC11C\uB3C4 \uBCFC \uC218 \uC788\uC5B4. \uC878\uBA74 \uAE68\uC6CC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174868
    m_Localized: "\uBC16\uC5D0 \uB098\uAC00\uB294 \uC0AC\uB78C\uBD80\uD130 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757922
    m_Localized: "\uCC3D\uD2C8\uC73C\uB85C \uBC14\uB78C\uC774 \uB4E4\uC5B4\uC640 \uCD1B\uBD88\uC774 \uC790\uAFB8 \uB204\uC6E0\uB2E4. \uC2E0\uBB38\uC9C0\uB97C \uC811\uC5B4 \uD2C8\uC744 \uB9C9\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757921
    m_Localized: "\uB2E4\uB4E4 \uBAB8\uC744 \uC6C5\uD06C\uB9AC\uACE0 \uC11C\uB85C\uC5D0\uAC8C \uC870\uAE08\uC529 \uBD99\uC5B4 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757920
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uCD94\uC6CC\uC11C \uAE7C\uB2E4. \uBB3C\uD1B5 \uC704\uC5D0 \uC587\uC740 \uC5BC\uC74C\uC774 \uB07C\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757943
    m_Localized: "\uC804\uB825\uC744 \uC544\uB07C\uB824\uACE0 \uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757944
    m_Localized: "\uBB34\uC804\uAE30 \uBD88\uC774 \uAEBC\uC9C0\uC790 \uAD50\uC2E4\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146495
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC758\uC790\uC5D0 \uBC18\uB4EF\uD558\uAC8C \uC549\uC558\uB2E4. \uC138\uBC30\uB97C \uBC1B\uB294 \uC0AC\uB78C\uC758 \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826524
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2DD\uB7C9 \uC870\uAE08\uACFC \uC57D \uC0C1\uC790 \uBC18\uC744 \uCC59\uACA8 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146662
    m_Localized: "\uC0C8\uBCBD\uC774 \uB420 \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757945
    m_Localized: "\uB044\uAE30 \uC9C1\uC804, DJ\uAC00 \uB204\uAD70\uAC00\uC758 \uC2E0\uCCAD\uACE1 \uC81C\uBAA9\uC744 \uC77D\uB294 \uAC8C \uB4E4\uB838\uB2E4. \uB05D\uAE4C\uC9C0 \uB4E3\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757946
    m_Localized: "\uAD50\uBB38 \uC55E \uC9C4\uD759\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uC794\uB729 \uCC0D\uD600 \uC788\uC5C8\uB2E4. \uC0AC\uB78C\uC758 \uAC83\uB3C4, \uC544\uB2CC \uAC83\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757947
    m_Localized: "\uAC00\uC7A5 \uD070 \uBC1C\uC790\uAD6D \uD558\uB098\uAC00 \uAD50\uBB38 \uC548\uCABD\uAE4C\uC9C0 \uB4E4\uC5B4\uC654\uB2E4\uAC00, \uB3CC\uC544 \uB098\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706389
    m_Localized: "\uADF8\uAC74 \uC774\uAE34 \uAC8C \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB0A0 \uC544\uCE68\uC758 \uB208\uBE5B\uC740 \uC544\uBB34\uAC83\uB3C4 \uBC14\uAFB8\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117833
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uADF8\uB54C \uD559\uAD50\uAC00 \uC2EB\uC5C8\uC5B4. \uC9D1\uB3C4 \uC2EB\uC5C8\uACE0. \uADF8\uBD84\uC774 \uADF8\uAC78 \uC54C\uC558\uB358 \uAC83 \uAC19\uC544. \uADF8\uB798\uC11C \uB9E4\uC8FC \uD55C \uC904. \uBE60\uC9D0\uC5C6\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757948
    m_Localized: "\uBC24\uC0AC\uC774 \uB0B4\uB9B0 \uC11C\uB9AC \uC704\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uC904\uC9C0\uC5B4 \uC788\uC5C8\uB2E4. \uB2F4\uC7A5\uC744 \uB530\uB77C \uD55C \uBC14\uD034."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174865
    m_Localized: "\uAC00\uC7A5 \uC544\uD508 \uC0AC\uB78C\uBD80\uD130 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786218
    m_Localized: "\uC0C8\uBCBD, \uBC1C\uC18C\uB9AC\uAC00 \uC7A6\uC544\uB4E4\uC5C8\uB2E4. \uC724 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4. \uCC98\uC74C \uBCF4\uB294, \uC9C0\uCE5C \uC6C3\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174940
    m_Localized: "\uBE57\uC18C\uB9AC\uC5D0 \uB2E4\uB978 \uC18C\uB9AC\uAC00 \uB2E4 \uBB3B\uD614\uB2E4. \uC800\uAC83\uB4E4\uC758 \uC18C\uB9AC\uB3C4, \uC6B0\uB9AC \uC18C\uB9AC\uB3C4. \uADF8\uAC74 \uC870\uAE08 \uB2E4\uD589\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757949
    m_Localized: "\uBB34\uC5B8\uAC00 \uD559\uAD50\uB97C \uD55C \uBC14\uD034 \uC7AC\uACE0 \uAC04 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117832
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB54C \uB2F4\uC784 \uC120\uC0DD\uB2D8 \uAC70\uC57C. \uC219\uC81C \uAC80\uC0AC\uD558\uBA74\uC11C \uB9E4\uBC88 \uD55C \uC904\uC529 \uC801\uC5B4 \uC8FC\uC168\uC5B4. \uB0B4\uAC00 \uC4F4 \uAC83\uBCF4\uB2E4 \uADF8\uBD84\uC774 \uC4F4 \uAC8C \uB354 \uB9CE\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706388
    m_Localized: "\uBCF8 \uAC83\uC744 \uB9D0\uB85C \uAEBC\uB0B4\uB294 \uB300\uC2E0, \uADF8 \uC606\uC790\uB9AC\uC5D0 \uC549\uC558\uB2E4. \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757950
    m_Localized: "\uBC1C\uC790\uAD6D \uC606\uC5D0 \uB2F4\uBC30\uAF41\uCD08\uAC00 \uD558\uB098 \uB5A8\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uC544\uC9C1 \uB35C \uC816\uC740 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757951
    m_Localized: "\uC800\uAC83\uB4E4\uC740 \uB2F4\uBC30\uB97C \uD53C\uC6B0\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757952
    m_Localized: "\uBC24\uC5D0 \uAD50\uB300\uB85C \uC21C\uCC30\uC744 \uB3C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706387
    m_Localized: "\uB9D0\uD558\uC9C0 \uC54A\uACE0, \uACC1\uC5D0 \uC549\uC544 \uC788\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174948
    m_Localized: "\uACF0\uD321\uC774\uAC00 \uBC88\uC9C0\uAE30 \uC804\uC5D0 \uB300\uCCAD\uC18C\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757953
    m_Localized: "\uCD94\uC6B4 \uBCF5\uB3C4\uB97C \uC624\uAC00\uBA70 \uBC24\uC744 \uC0C8\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757954
    m_Localized: "\uB3C4\uD604\uC774 \uC21C\uCC30 \uC2DC\uAC04\uD45C\uB97C \uB9CC\uB4E4\uC5C8\uB2E4. \uC790\uAE30 \uC774\uB984\uC744 \uC81C\uC77C \uB9CE\uC774 \uB123\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757955
    m_Localized: "\uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706414
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC758 \uD2B8\uB7ED\uC744 \uBE4C\uB824 \uBC14\uB2F7\uAC00\uAE4C\uC9C0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706415
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uD2B8\uB7ED \uC5F4\uC1E0\uB97C \uAC74\uB138\uB2E4. \uAE30\uB984\uC740 \uAF49 \uCC44\uC6CC \uB450\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757956
    m_Localized: "\uBA70\uCE60 \uB4A4, \uBC1C\uC790\uAD6D\uC740 \uB354 \uB9CE\uC544\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174864
    m_Localized: "\uB450 \uC5B4\uB978\uC774 \uB098\uB97C \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786219
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC\u2026 \uD574\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706416
    m_Localized: "\uC815 \uBC18\uC7A5: \uC218\uD559\uC5EC\uD589\uC774\uB77C\uBA70. \uC560\uB4E4\uC740 \uADF8\uB7F0 \uAC70 \uD574\uC57C \uB3FC. \uB300\uC2E0 \uD760\uC9D1 \uB0B4\uBA74 \uD63C\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118044
    m_Localized: "\uBB3C\uB9AC \uBB38\uC81C \uD558\uB098\uB97C \uC120\uBC30\uAC00 \uADF8\uB9BC\uC73C\uB85C \uD480\uC5B4 \uC8FC\uC5C8\uB2E4. \uD654\uC0B4\uD45C \uBA87 \uAC1C\uB85C. \uB9D0\uBCF4\uB2E4 \uBE68\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786220
    m_Localized: "\uCC45\uC0C1 \uD558\uB098\uAC00 \uBB34\uB108\uC84C\uB2E4. \uC2DD\uB7C9 \uC0C1\uC790\uAC00 \uC4F0\uB7EC\uC9C0\uACE0, \uB204\uAD70\uAC00\uC758 \uC190\uC774 \uBB38\uD2C8\uC73C\uB85C \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757957
    m_Localized: "\uAD50\uBB38 \uCABD\uC5D0\uC11C \uC1E0\uC0AC\uC2AC \uB04A\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC6B4\uB3D9\uC7A5\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC624\uB294 \uC0AC\uB78C\uB4E4\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757958
    m_Localized: "\uC6B0\uBE44\uB4E4\uC774\uC5C8\uB2E4. \uC0AC\uAC70\uB9AC \uD30C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757959
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD1B5\uD589\uC138\uB97C \uBC1B\uB358 \uB188\uB4E4\uC774 \uC544\uB2C8\uC57C. \uC0C8 \uC5BC\uAD74\uB4E4\uC774\uC57C. \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C\uB3C4 \uB9D0\uC744 \uC548 \uB4E3\uB294 \uB188\uB4E4\uC774 \uC788\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757960
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0AC\uAC70\uB9AC \uD30C\uB2E4. \uAC15\uCCA0\uC774 \uC815\uB9D0 '\uC6D0\uCE59\uB300\uB85C' \uD558\uB7EC \uC654\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146496
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uC138\uBC30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146497
    m_Localized: "\uC808\uC744 \uD558\uB294 \uBC95\uC744 \uBAB0\uB77C\uC11C \uC11C\uD234\uB800\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC74C\uC744 \uCC38\uC73C\uBA70 \uB355\uB2F4\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146498
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC62C\uD574\uB294\u2026 \uBB38\uC774 \uC5F4\uB9AC\uB294 \uD574\uAC00 \uB420 \uAC70\uB2E4. \uC0C8\uD574 \uBCF5 \uB9CE\uC774 \uBC1B\uC544\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460181
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uACB0\uAD6D \uC18C\uB9AC \uB0B4\uC11C \uC6C3\uC5C8\uB2E4. \uBD95\uB300 \uAC10\uC740 \uB2E4\uB9AC\uB97C \uC9DA\uC73C\uBA70, \uD55C\uCC38."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460182
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC84C\uB2E4. \uADF8\uB798, \uC624\uB298\uC740 \uADF8\uAC78\uB85C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146499
    m_Localized: "\uC138\uBC43\uB3C8 \uB300\uC2E0 \uCABD\uC9C0 \uD55C \uC7A5. '\uD55C \uD574 \uB3D9\uC548 \uC798 \uCEF8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757984
    m_Localized: "\uAC15\uCCA0: \uADF8\uB798. \uADF8\uAC83\uB3C4 \uC6D0\uCE59\uC774\uC9C0. \uBB38 \uB2E8\uB2E8\uD788 \uC7A0\uAC00\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757985
    m_Localized: "\uAD50\uBB38\uC5D0 \uBD89\uC740 \uD398\uC778\uD2B8\uB85C \uD070 \uAE00\uC528\uAC00 \uCE60\uD574\uC838 \uC788\uC5C8\uB2E4. '\uAD6C\uC870 \uC804\uAE4C\uC9C0 \uD559\uAD50\uB97C \uBE44\uC6CC\uB77C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369195
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC798\uB410\uB2E4. \uC870\uC218\uAC00 \uC0DD\uACBC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369196
    m_Localized: "\uC774\uC81C \uC5EC\uAE30\uC11C \uAC19\uC774 \uC9C0\uB0B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146661
    m_Localized: "\uBC24\uC0C8 \uC5F4\uC744 \uC7C0\uB2E4. \uC57D\uC744 \uC2DC\uAC04 \uB9DE\uCDB0 \uB123\uACE0, \uBD95\uB300\uB97C \uAC08\uACE0, \uB2E4\uC2DC \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146660
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uC0DD\uD55C\uD14C \uBE5A\uC744 \uC9C0\uB294\uAD6C\uB098. \uC774\uAC74 \uD3C9\uC0DD \uBABB \uAC1A\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146754
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798\uD588\uB2E4. \uC124\uBA85\uC740 \uB2E4\uC2DC \uC4F8 \uC218 \uC788\uC5B4\uB3C4, \uC774\uC57C\uAE30\uB294 \uADF8\uB807\uC9C0\uAC00 \uC54A\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174792
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBE44 \uC624\uB824\uB098 \uBD10. \uC5C6\uB294 \uB2E4\uB9AC\uAC00 \uBA3C\uC800 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757961
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE61\uD328\uB4E4\uC774\uB2E4. \uC6B0\uB9AC\uAC00 \uC5EC\uAE30 \uC788\uB294 \uAC78 \uC54C\uACE0 \uC628 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757962
    m_Localized: "\uC624\uB298 \uD558\uB824\uB358 \uC77C\uC740 \uBAA8\uB450 \uBBF8\uB904\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757963
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC \uB4A4\uC5D0\uC11C \uB9DE\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757964
    m_Localized: "\uCC45\uC0C1\uACFC \uBB38\uC9DD \uB4A4\uB85C \uBAB8\uC744 \uBD99\uC774\uACE0, \uB4E4\uC5B4\uC624\uB294 \uAE38\uBAA9\uC744 \uB9C9\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757965
    m_Localized: "\uBD88\uC744 \uB044\uACE0 \uC228\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146500
    m_Localized: "\uB5A1\uAD6D \uBE44\uC2B7\uD55C \uAC83\uC744 \uB053\uC5EC \uB098\uB220 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146755
    m_Localized: "\uAD6C\uC870\uB97C 3\uC8FC \uC55E\uB454 \uBC24. \uB208\uC774 \uADF8\uCE5C \uC6B4\uB3D9\uC7A5 \uC704\uB85C, \uC218\uC2ED \uAC1C\uC758 \uADF8\uB9BC\uC790\uAC00 \uD559\uAD50\uB97C \uD5A5\uD574 \uAC78\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369155
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC694\uC998 \uC774 \uAC00\uBC29 \uC55E\uB9CC \uC9C0\uB098\uAC00\uBA74 \uAC78\uC74C\uC774 \uBE68\uB77C\uC9C0\uB354\uB77C. \uC774\uC81C\uC57C \uC54C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460272
    m_Localized: "\uC694\uC998 \uC0AC\uB78C\uB4E4\uC758 \uC5BC\uAD74\uC744 \uBCF4\uB294 \uBC84\uB987\uC774 \uC0DD\uACBC\uB2E4. \uADF8\uB9BC\uC790\uB97C \uC138\uB358 \uB208\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369125
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC911\uD559\uAD50 \uAE30\uB85D\uC5D0 \uC774\uB807\uAC8C \uC801\uD600 \uC788\uB354\uB77C. '\uBC1D\uC74C. \uAD50\uC6B0 \uAD00\uACC4 \uC6D0\uB9CC.' \uC0C1\uB2F4 \uAE30\uB85D \uBC14\uB85C \uC717\uCE78\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987536
    m_Localized: "\uB3C4\uC2DC\uB294 \uC870\uC6A9\uD588\uB2E4. \uB108\uBB34 \uC870\uC6A9\uD574\uC11C \uC0C8\uC18C\uB9AC\uAC00 \uD06C\uAC8C \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146381
    m_Localized: "\uCD5C\uD558\uB9B0. \uADF8 \uC774\uB984\uC744 \uBD80\uB97C \uB54C, \uD558\uB9B0\uC774 \uC228\uC744 \uBA48\uCD94\uB294 \uAC8C \uB290\uAEF4\uC84C\uB2E4. \uBE60\uB728\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369197
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC2E0\uC138 \uC9C0\uACA0\uB2E4\uACE0\uB294 \uC548 \uD560\uAC8C. \uB300\uC2E0 \uC544\uD504\uBA74 \uBC14\uB85C \uB9D0\uD574. \uC228\uAE30\uBA74 \uD63C\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757966
    m_Localized: "\uBAA8\uB450 \uC228\uC744 \uC8FD\uC600\uB2E4. \uBCF5\uB3C4\uB97C \uAC77\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uD558\uB098, \uB458."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757967
    m_Localized: "\uBB3C\uC790\uB97C \uB0B4\uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174863
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC74 \uC5B4\uB978\uC774 \uC815\uD560 \uC77C\uC774 \uC544\uB2C8\uC5D0\uC694. \uC5EC\uAE30\uC11C \uBC16\uC5D0 \uB098\uAC00\uB294 \uAC74 \uC774 \uC544\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786221
    m_Localized: "\uC5B4\uB5BB\uAC8C \uB9C9\uC558\uB294\uC9C0\uB294 \uC798 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294\uB2E4. \uC815\uC2E0\uC744 \uCC28\uB9AC\uC790 \uC544\uCE68\uC774\uC5C8\uACE0, \uC190\uBC14\uB2E5\uC774 \uC4F0\uB77C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987535
    m_Localized: "\uBB38\uC744 \uBC00\uC790 \uBC14\uB78C\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uB4E4\uC774\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369198
    m_Localized: "\uC751\uAE09\uCC98\uCE58\uB97C \uAC00\uB974\uCCD0 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117840
    m_Localized: "\uADF8 \uC120\uC0DD\uB2D8\uC740 \uC9C0\uAE08 \uC5B4\uB514 \uACC4\uC2DC\uB0D0\uACE0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987534
    m_Localized: "\uC625\uC0C1 \uBB38\uC740 \uB179\uC774 \uC2AC\uC5B4 \uC788\uC5C8\uC9C0\uB9CC \uC7A0\uACA8 \uC788\uC9C0\uB294 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786222
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544. \uC0B4\uC558\uC73C\uBA74 \uB41C \uAC70\uC57C. \uB098\uBA38\uC9C4 \uB2E4\uC2DC \uC313\uC73C\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757968
    m_Localized: "\uCC3D\uACE0 \uBB38\uC744 \uC5F4\uC5B4 \uBCF4\uC600\uB2E4. \uADF8\uB4E4\uC740 \uD544\uC694\uD55C \uB9CC\uD07C \uCC59\uACA8 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757969
    m_Localized: "\uB208 \uC313\uC778 \uAD50\uBB38 \uC55E\uC5D0 \uAC15\uCCA0\uC774 \uD63C\uC790 \uC11C \uC788\uC5C8\uB2E4. \uBD80\uD558\uB3C4, \uC6B0\uBE44\uB3C4 \uC5C6\uC774. \uB450\uAEBC\uC6B4 \uC810\uD37C \uCC28\uB9BC\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757970
    m_Localized: "\uAC15\uCCA0: \uAD6C\uC870\uB300 \uC628\uB2E4\uBA70. \uBC29\uC1A1 \uB4E4\uC5C8\uB2E4. \uCD95\uD558\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146501
    m_Localized: "\uAC00\uB798\uB5A1\uC740 \uC5C6\uC5C8\uB2E4. \uC300\uC744 \uBE5A\uC5B4 \uB0A9\uC791\uD558\uAC8C \uC370\uC5C8\uB2E4. \uAD6D\uBB3C\uC740 \uBA78\uCE58 \uB300\uC2E0 \uD1B5\uC870\uB9BC \uCC38\uCE58\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146502
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70 \uBA39\uC73C\uBA74 \uD55C \uC0B4 \uB354 \uBA39\uB294 \uAC70\uC57C. \uB2E4\uB4E4 \uCD95\uD558\uD574. \uC0B4\uC544\uC11C \uD55C \uC0B4 \uB354 \uBA39\uC740 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706362
    m_Localized: "\uC6C3\uC9C0 \uC54A\uC740 \uC5BC\uAD74\uC744 \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117839
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB2EE\uC558\uC9C0. \uBCA0\uB080 \uAC70\uC57C. \uC774\uC2ED \uB144\uC9F8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118043
    m_Localized: "\uC120\uBC30\uB294 \uACF5\uCC45\uC5D0 \uAE00\uC528\uB85C \uB300\uB2F5\uD588\uB2E4. \uB0B4\uAC00 \uBB3C\uC73C\uBA74 \uC120\uBC30\uAC00 \uC4F0\uACE0, \uC120\uBC30\uAC00 \uC4F0\uBA74 \uB0B4\uAC00 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757971
    m_Localized: "\uAC15\uCCA0: \uC6B0\uB9B0 \uC548 \uD0C4\uB2E4. \uAC10\uC5FC \uAC80\uC0AC \uD1B5\uACFC\uD560 \uB188\uC774 \uBA87 \uC5C6\uAC70\uB4E0. \uC5EC\uB35F \uC790\uB9AC\uC5D0 \uB07C\uC5B4\uB4E4 \uC5FC\uCE58\uB3C4 \uC5C6\uACE0. \uADF8\uB9AC\uACE0\u2026 \uC5EC\uAE30\uAC00 \uC6B0\uB9AC \uB3D9\uB124\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757972
    m_Localized: "\uAC15\uCCA0\uC774 \uB2F4\uBC30 \uB300\uC2E0 \uB9C8\uB978 \uB098\uBB47\uAC00\uC9C0\uB97C \uC785\uC5D0 \uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146659
    m_Localized: "\uD314\uC5D0 \uBC14\uB298\uC774 \uB4E4\uC5B4\uAC14\uB2E4. \uB0B4 \uD53C\uAC00 \uAC00\uB294 \uAD00\uC744 \uB530\uB77C \uC120\uC0DD\uB2D8 \uCABD\uC73C\uB85C \uCC9C\uCC9C\uD788 \uB0B4\uB824\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146658
    m_Localized: "\uB0B4 \uD53C\uB97C \uC4F4\uB2E4. \uC9C0\uAE08 \uCC98\uCE58\uB97C \uC2DC\uC791\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757973
    m_Localized: "\uAC15\uCCA0: \uD560 \uB9D0\uC740 \uC774\uAC70\uB2E4. \uC624 \uC528 \uD328\uAC70\uB9AC. \uC6B0\uB9AC \uBC11\uC5D0\uC11C\uB3C4 \uB9D0 \uC548 \uB4E3\uACE0 \uB098\uAC14\uC5B4. \uB9C8\uC9C0\uB9C9 \uD55C\uD30C \uB0A0, \uB108\uD76C \uD559\uAD50 \uB178\uB9B0\uB2E4. \uC57D \uB0C4\uC0C8\uB97C \uB9E1\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174996
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uAD6D\uBB3C\uAE4C\uC9C0 \uB2E4 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174886
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310 \uC55E\uAE4C\uC9C0 \uAC78\uC5B4\uAC00 \uBD84\uD544\uC744 \uB4E4\uC5C8\uB2E4. \uC11C\uC11C, \uB208\uB192\uC774\uC5D0, \uB0A0\uC9DC\uB97C \uC37C\uB2E4. \uAE00\uC528\uAC00 \uBC18\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757752
    m_Localized: "\uCD94\uC704\uAC00 \uC6B0\uB9AC \uD3B8\uC774\uC5C8\uB2E4. \uC800\uAC83\uB4E4\uC758 \uC6C0\uC9C1\uC784\uC774 \uC0C8\uBCBD\uC73C\uB85C \uAC08\uC218\uB85D \uB290\uB824\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757751
    m_Localized: "\uD30C\uCD9C\uC18C\uC5D0\uC11C \uAC00\uC838\uC628 \uC870\uB07C\uC758 \uBC84\uD074\uC744 \uCC44\uC6E0\uB2E4. \uC190\uAC00\uB77D\uC774 \uACF1\uC544 \uC138 \uBC88 \uB9CC\uC5D0 \uC7A0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706413
    m_Localized: "\uADF8\uB798\uB3C4 \uBC14\uB2E4\uB294 \uAC70\uAE30 \uC788\uC5C8\uB2E4. \uD68C\uC0C9 \uB760\uCC98\uB7FC, \uC544\uC8FC \uBA40\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654270
    m_Localized: "\uC120\uBC30\uB77C\uACE0 \uBD80\uB974\uBA70 \uCD9C\uC11D\uC744 \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118064
    m_Localized: "\uB3C4\uD604: \uD615\uC740 \uB9E8\uB0A0 \uC800\uBCF4\uACE0 \uC0B0\uB9CC\uD558\uB2E4\uACE0, \uB108\uB294 \uAFB8\uC900\uD55C \uAC8C \uC5C6\uB2E4\uACE0 \uD588\uB294\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118063
    m_Localized: "\uB3C4\uD604: \uB204\uB098, \uC800 \uC6D0\uB798 \uC721\uC0C1\uBD80 \uB4E4\uC5B4\uAC00\uB824\uACE0 \uD588\uC5B4\uC694. \uD615\uC774 \uC721\uC0C1\uBD80\uC600\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369126
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6C3\uACE0 \uC788\uC5C8\uC73C\uB2C8\uAE4C, \uB2E4\uB4E4 \uAC70\uAE30\uC11C \uBA48\uCDC4\uAD6C\uB098. \uC6C3\uB294 \uC5BC\uAD74 \uB4A4\uAE4C\uC9C0 \uBCF4\uB294 \uAC8C \uC5B4\uB978 \uC77C\uC778\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146750
    m_Localized: "\uB204\uAD70\uAC00\uC758 \uCF54 \uACE0\uB294 \uC18C\uB9AC\uC5D0 \uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4. \uC6C3\uC74C\uC5D0\uB3C4 \uC628\uAE30\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757974
    m_Localized: "\uAC15\uCCA0: \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4\uB294 \uAC8C \uB0B4 \uC6D0\uCE59\uC774\uC5C8\uC9C0. \uADF8 \uC6D0\uCE59, \uB05D\uAE4C\uC9C0 \uC9C0\uD0A4\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757975
    m_Localized: "\uADF8\uB0A0 \uBC24 \uAC19\uC774 \uB9C9\uC544 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146657
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD574 \uBCF4\uC790. \uD574 \uBCF4\uC9C0\uB3C4 \uC54A\uACE0 \uD3EC\uAE30\uD558\uB294 \uAC74, \uAD6D\uC5B4 \uC120\uC0DD\uC774 \uAC00\uB974\uCE60 \uAC8C \uC544\uB2C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146656
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC131\uACF5\uD55C\uB2E4\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC5B4. \uAE30\uB85D\uC5D0\uC11C\uB3C4 \uC77C\uBD80\uC600\uC5B4. \uC544\uC8FC \uC77C\uBD80."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117847
    m_Localized: "\uC5F4 \uB54C\uBB38\uC778\uC9C0 \uC190\uC774 \uB5A8\uB838\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uD55C \uD68D\uC744 \uAE0B\uACE0 \uC228\uC744 \uACE0\uB974\uACE0, \uB2E4\uC2DC \uD55C \uD68D\uC744 \uADF8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118062
    m_Localized: "\uC904\uB118\uAE30\uB97C \uB9C8\uCE58\uACE0 \uCCB4\uC721\uAD00 \uBC14\uB2E5\uC5D0 \uB204\uC6E0\uB294\uB370, \uB3C4\uD604\uC774 \uCC9C\uC7A5\uC744 \uBCF4\uBA70 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369127
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC5D0 '\uC548 \uAD1C\uCC2E\uB2E4'\uACE0 \uD574 \uC918\uC11C \uB2E4\uD589\uC774\uC5C8\uB2E4. \uADF8 \uB9D0\uC774 \uC5C6\uC5C8\uC73C\uBA74 \uB098\uB3C4 \uADF8 \uCE78\uC5D0\uC11C \uBA48\uCDC4\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117834
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uC0AC\uAC00 \uB41C \uAC74 \uADF8 \uD55C \uC904 \uB54C\uBB38\uC774\uC57C. \uBCC4\uC77C \uC544\uB2CC \uAC83 \uAC19\uC740\uB370, \uADF8\uAC8C \uC77C \uB144\uC744 \uBC84\uD2F0\uAC8C \uD558\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146690
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uCD9C\uC11D\uC785\uB2C8\uB2E4. \uC544\uC774\uACE0, \uC774 \uB098\uC774\uC5D0 \uCD9C\uC11D\uC744 \uB2E4 \uBD80\uB974\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146689
    m_Localized: "{0}: \uBC15 \uC120\uC0DD\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757976
    m_Localized: "{0}: \uADF8\uB0A0 \uBC24, \uB2F4\uC7A5\uC5D0 \uAC19\uC774 \uC11C \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757977
    m_Localized: "\uAC15\uCCA0\uC774 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980491
    m_Localized: "\uB3C4\uD604\uC740 \uACF5\uCC45\uC744 \uC811\uC5B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4. \uBC84\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826568
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC55E\uCE58\uB9C8 \uC774\uC57C\uAE30\uB294 \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uAEBC\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757986
    m_Localized: "\uADF8 \uC544\uB798, \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uBB34\uB9AC\uAC00 \uC11C \uC788\uC5C8\uB2E4. \uAC00\uC6B4\uB370 \uAC15\uCCA0\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980494
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uD649 \uBB38\uC81C \uC911\uC5D0 \uC77C\uACF1 \uAC1C. 10\uBC88\uC740 \uC815\uB2F5\uC774 \uC5C6\uB294 \uBB38\uC81C\uB77C\uC11C. \u2026\uC798 \uC37C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146749
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uCC98\uC74C\uC5D4 \uBB38\uAC00\uC5D0 \uB530\uB85C \uC549\uC544 \uC788\uC5C8\uB2E4. \uC0C8\uBCBD\uC5D0 \uBCF4\uB2C8 \uB204\uAD70\uAC00\uC758 \uC5B4\uAE68\uC5D0 \uAE30\uB300 \uC7A0\uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980492
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBB38\uC81C\uB294 '\uC9C0\uAE08 \uAC00\uC7A5 \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC744 \uD55C \uBB38\uC7A5\uC73C\uB85C \uC4F0\uC2DC\uC624'\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146688
    m_Localized: "\uC120\uBC30\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uB300\uB2F5\uC740 \uB298 \uADF8\uAC70\uC600\uB2E4. \uCD9C\uC11D\uBD80\uC758 '2\uD559\uB144' \uC606\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369139
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB9D0\uD558\uACE0 \uC2F6\uC744 \uB54C \uB9D0\uD574. \uADF8\uB54C\uAE4C\uC9C0 \uB098\uB294 \uC5EC\uAE30 \uC788\uC744 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146687
    m_Localized: "{0}: \uC120\uBC30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117837
    m_Localized: "'\uC624\uB298\uC740 \uAE00\uC528\uAC00 \uBC14\uB974\uB2E4.' '\uC774 \uBB38\uC7A5, \uB124 \uC0DD\uAC01\uC774\uB77C \uC88B\uB2E4.' '\uC9C0\uAC01 \uC138 \uBC88\uC9F8. \uC544\uCE68\uC740 \uBA39\uACE0 \uB2E4\uB2C8\uB2C8.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757987
    m_Localized: "\uAC15\uCCA0: \uD5EC\uAE30\uB294 \uC625\uC0C1\uC5D0 \uB0B4\uB9B0\uB2E4\uC9C0. \uC625\uC0C1 \uC788\uB294 \uAC74\uBB3C\uC740 \uC774 \uB3D9\uB124\uC5D0 \uC5EC\uAE30\uBFD0\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118060
    m_Localized: "{0}: \uC120\uC0DD\uB2D8\uC774 \uC800 \uAC00\uB974\uCCD0 \uC8FC\uC154\uC11C, \uC774\uC81C \uC800 \uD63C\uC790 \uB0A8\uB294 \uB0A0\uC774 \uC640\uB3C4 \uB35C \uBB34\uC11C\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146748
    m_Localized: "\uC881\uC740 \uAD50\uC2E4\uC5D0 \uBAA8\uB450 \uBAA8\uC5EC \uB2F4\uC694\uB97C \uB098\uB220 \uB36E\uC5C8\uB2E4. \uC5B4\uAE68\uC640 \uC5B4\uAE68\uAC00 \uB2FF\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826518
    m_Localized: "\uC120\uBC30\uB294 \uD55C\uCC38 \uC0DD\uAC01\uD558\uB2E4\uAC00 \uACF5\uCC45\uC5D0 \uC37C\uB2E4. \u300C\uC625\uC0C1\u300D. \uADF8\uB9AC\uACE0 \uADF8 \uC606\uC5D0 \uC791\uC740 \uACE0\uC591\uC774 \uBC1C\uC790\uAD6D\uC744 \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117836
    m_Localized: "\uBE68\uAC04 \uD39C \uAE00\uC528\uB97C \uD558\uB098\uC529 \uC77D\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146686
    m_Localized: "\uCD5C\uD558\uB9B0: \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146685
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uC7A0\uAE50 \uB9DD\uC124\uC774\uB2E4 \uC190\uC744 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146684
    m_Localized: "{0}: \uCD5C\uD558\uB9B0."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987533
    m_Localized: "\uC625\uC0C1\uC73C\uB85C \uAC00\uB294 \uACC4\uB2E8\uC740 \uC5F4\uC5EC\uC12F \uCE78\uC774\uC5C8\uB2E4. \uC62C\uB77C\uAC00\uB294 \uB3D9\uC548 \uC138\uC5B4 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118059
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118049
    m_Localized: "\uD63C\uC790 \uBB38\uC81C\uB97C \uD480\uC5C8\uB2E4. \uB2F5\uC9C0\uAC00 \uC5C6\uC5B4\uC11C \uB9DE\uC558\uB294\uC9C0\uB294 \uBAA8\uB978\uB2E4. \uADF8\uB798\uB3C4 \uB05D\uAE4C\uC9C0 \uD480\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706390
    m_Localized: "\uADF8\uB798\uB3C4 \uADF8 \uC544\uCE68, \uB098\uB294 \uB098\uB97C \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC70\uBA74 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460228
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB0B4\uAC00 \uB9D0\uD55C \uC21C\uC11C\uB300\uB85C \uD558\uB098\uC529 \uC190\uAC00\uB77D\uC73C\uB85C \uC9DA\uC5B4 \uBCF4\uC558\uB2E4. \uB2E4\uC74C \uB0A0\uBD80\uD130 \uC120\uC0DD\uB2D8\uC758 \uACF5\uCC45\uC5D0 \uD559\uAD50 \uC9C0\uB3C4\uAC00 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786278
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB4E4\uC5C8\uC5B4? \uAD50\uC2E4\uB3D9 3\uCE35 \uCABD\uC774\uC57C. \uC0AC\uB78C\uC774\uC57C, \uC800\uAC74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117846
    m_Localized: "\uBC18\uCBE4 \uC5F4\uB9B0 \uBB38 \uC0AC\uC774\uB85C \uC724 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uC600\uB2E4. \uB450\uAEBC\uC6B4 \uD06C\uB9BC\uC0C9 \uC885\uC774 \uC704\uC5D0 \uBD93\uD39C\uC73C\uB85C \uBB34\uC5B8\uAC00\uB97C \uC544\uC8FC \uCC9C\uCC9C\uD788 \uC4F0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117845
    m_Localized: "\uC0C8\uBCBD \uB450 \uC2DC. \uAD50\uBB34\uC2E4 \uBB38\uD2C8\uC73C\uB85C \uCD1B\uBD88\uC774 \uC0C8\uC5B4 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460227
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB2E4 \uC678\uC6E0\uAD6C\uB098. \uADF8\uB798, \uADF8\uAC74 \uB124\uAC00 \uAC00\uC9C4 \uAC70\uB2E4. \uC798 \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905772
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0A8\uC740 \uCEE4\uD53C \uBBF9\uC2A4 \uD558\uB098\uB97C \uBC18\uC73C\uB85C \uB098\uB220 \uD0D4\uB2E4. \uBBF8\uC9C0\uADFC\uD588\uC9C0\uB9CC \uB2EC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706391
    m_Localized: "\"\uBB34\uC11C\uC6B0\uBA74 \uC548 \uBD10\uB3C4 \uB410\uC5B4. \uADF8\uB798\uB3C4 \uB10C \uC798\uBABB\uD55C \uAC8C \uC5C6\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460226
    m_Localized: "{0}: \uC624\uB978\uCABD \uCC3D\uBB38\uC740 \uC548 \uC7A0\uACA8\uC694. \uACC4\uB2E8\uC740 \uC67C\uCABD\uC774 \uB35C \uC6B8\uB824\uC694. \uAE09\uD558\uBA74 \uACFC\uD559\uC2E4 \uCABD\uC73C\uB85C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826586
    m_Localized: "\uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4. \uC2EC\uC7A5\uC774 \uADC0\uC5D0\uC11C \uB6F0\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369138
    m_Localized: "\uC544\uC9C1\uC740 \uB9D0\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369137
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798 \uBC84\uD17C\uB2E4. \uC815\uB9D0\uB85C, \uC798 \uBC84\uD17C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905771
    m_Localized: "\uB4DC\uBB3C\uAC8C \uC870\uC6A9\uD55C \uC544\uCE68\uC774\uC5C8\uB2E4. \uCC3D\uBC16\uC5D0\uC11C \uCC38\uC0C8\uAC00 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706392
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uB294 \uB208\uC744 \uD53C\uD558\uBA74 \uC9C0\uB294 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD588\uB2E4. \uADF8\uB798\uC11C \uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544\uB3C4 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369136
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB05D\uAE4C\uC9C0 \uB07C\uC5B4\uB4E4\uC9C0 \uC54A\uACE0 \uB4E4\uC5C8\uB2E4. \uB2E4 \uB4E3\uACE0 \uB098\uC11C\uC57C \uB531 \uD55C \uB9C8\uB514\uB97C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369135
    m_Localized: "\uD558\uB098\uC529 \uB9D0\uD588\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uBAA9\uC18C\uB9AC\uAC00 \uB5A8\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174921
    m_Localized: "{0}: \uB0B4\uC77C \uB098\uAC00\uC57C \uD574\uC11C\uC694. \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369134
    m_Localized: "\uADF8\uB0A0 \uC788\uC5C8\uB358 \uC77C\uC744 \uCC98\uC74C\uBD80\uD130 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706393
    m_Localized: "\"\uB9D0\uD574\uC11C \uB2E4\uD589\uC774\uC57C. \uADF8 \uD55C\uB9C8\uB514\uAC00 1\uB144\uC744 \uBC84\uD2F0\uAC8C \uD588\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980493
    m_Localized: "\uD55C\uCC38 \uC5F0\uD544\uC744 \uB4E4\uACE0 \uC788\uB2E4\uAC00 \uD55C \uC904\uC744 \uC37C\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uADF8 \uBB38\uC81C\uB9CC \uCC44\uC810\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757767
    m_Localized: "\uC720\uB791\uC790: \uD574\uCE60 \uC0DD\uAC01 \uC5C6\uB2E4. \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB294 \uAE38\uC774\uC57C. \u2026\uBA39\uC744 \uAC70 \uC870\uAE08\uB9CC \uB098\uB220 \uC904 \uC218 \uC788\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757768
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uBB38 \uB108\uBA38\uC5D0\uC11C \uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4\uAC00, \uB2E4\uC2DC \uBA48\uCDC4\uB2E4. \uB124\uAC00 \uC815\uD558\uB77C\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117843
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uACF5\uCC45\uC744 \uB36E\uACE0 \uD45C\uC9C0\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C \uD55C \uBC88 \uC4F8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117842
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBA87 \uD574 \uC804\uC5D0 \uC815\uB144\uD1F4\uC784 \uD558\uC168\uC5B4. \uC2DC\uACE8\uB85C \uB0B4\uB824\uAC00\uC2E0\uB2E4\uACE0 \uD588\uC9C0. \uAC70\uAE34\u2026 \uC5EC\uAE30\uBCF4\uB2E4\uB294 \uC870\uC6A9\uD558\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826569
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uAC00\uB974\uCE60 \uC218 \uC788\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\u2026 \uAC19\uC774 \uC77D\uB294 \uAC74 \uD560 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654264
    m_Localized: "\uC5F0\uD544\uC744 \uAC74\uB138\uB2E4. \uC120\uBC30\uB294 \uADF8 \uC904 \uC704\uC5D0\uC11C \uD55C\uCC38 \uC5F0\uD544\uC744 \uBA48\uCD94\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786277
    m_Localized: "\uC880\uBE44\uB294 \uC800\uB807\uAC8C \uADDC\uCE59\uC801\uC73C\uB85C \uB450\uB4DC\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174787
    m_Localized: "\uD55C\uB3D9\uC548 \uB458 \uB2E4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uC88B\uC740 \uCABD\uC758 \uCE68\uBB35\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460234
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uAD50\uBB38\uAE4C\uC9C0 \uD55C \uBE14\uB85D. \uB298 \uD558\uB358 \uB300\uB85C \uB6F0\uC5C8\uB2E4. \uC228\uC774 \uCC28\uAE30 \uC804\uC5D0, \uC544\uBB34\uAC83\uB3C4 \uB530\uB77C\uC624\uAE30 \uC804\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146654
    m_Localized: "\uADF8\uB0A0\uBD80\uD130 \uAD00\uCC30 \uC77C\uC9C0\uC5D0 \uCE78\uC744 \uC0C8\uB85C \uADF8\uC5C8\uB2E4. \uC2DC\uAC01, \uCCB4\uC628, \uC190\uB05D\uC758 \uC628\uB3C4. \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8\uC774 \uADF8\uB0A0 \uD55C \uB9D0 \uD55C \uC904."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460225
    m_Localized: "\uACC4\uB2E8\uCC38\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uBA70 \uCD9C\uAD6C\uB97C \uC54C\uB824 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146383
    m_Localized: "\uC120\uBC30. \uC774\uB984 \uB300\uC2E0 '\uC0C8\uBCBD\uACE0 2\uD559\uB144'\uC774\uB77C\uACE0 \uBD88\uB800\uB2E4. \uC606\uC5D0\uC11C \uC120\uBC30\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uAC70\uBA74 \uB41C\uB2E4\uB294 \uB4EF\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146747
    m_Localized: "\uD55C \uAD50\uC2E4\uC5D0 \uBAA8\uB450 \uBAA8\uC5EC \uCCB4\uC628\uC73C\uB85C \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146746
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB4E4\uC774 \uC54C\uBA74 \uD654\uB0BC\uAE4C. \u2026\uC544\uB2C8\uB2E4. \uB530\uB73B\uD558\uAC8C \uC37C\uB2E4\uACE0 \uD558\uBA74 \uC6C3\uC744 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146683
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uB124. \uC5EC\uAE30 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146682
    m_Localized: "{0}: \uC1A1\uC608\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460224
    m_Localized: "\uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4. \uBC1C\uC774 \uBA3C\uC800 \uC54C\uB358 \uAC78\uC74C\uC774\uC5C8\uB2E4. \uBE68\uB9AC \uC9C0\uB098\uAC00\uC57C \uD558\uB294 \uBCF5\uB3C4\uAC00, \uC608\uC804\uC5D0\uB3C4 \uC788\uC5C8\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117835
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC870\uAE08 \uC465\uC2A4\uB7EC\uC6B4 \uB4EF \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146745
    m_Localized: "'\uC218\uB2A5 D-700'. '\uBBFC\uC9C0 \uBC14\uBCF4'. \uD558\uD2B8 \uC548\uC5D0 \uC801\uD78C \uB450 \uC774\uB984. \uBD88\uAF43\uC774 \uAE00\uC528\uB97C \uD558\uB098\uC529 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146744
    m_Localized: "1\uD559\uB144 3\uBC18 \uCC45\uC0C1\uC774 \uBD88 \uC18D\uC5D0\uC11C \uD0C1\uD0C1 \uC18C\uB9AC\uB97C \uB0C8\uB2E4. \uB204\uAD70\uAC00\uC758 \uB099\uC11C\uAC00 \uC0C8\uACA8\uC9C4 \uCC45\uC0C1\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654313
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCC45\uC0C1 \uBAA8\uC11C\uB9AC\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uD1A1, \uD1A1, \uB450\uB4DC\uB838\uB2E4. \uB098\uB3C4 \uB530\uB77C \uB450\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146681
    m_Localized: "\uB3C4\uD604: \uB124! \u2026\uC544, \uB108\uBB34 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146680
    m_Localized: "{0}: \uB3C4\uD604."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757769
    m_Localized: "\uD1B5\uC870\uB9BC \uBA87 \uAC1C\uB97C \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174879
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC11C\uC11C \uCE60\uD310\uC5D0 \uAE00\uC528\uB97C \uC4F8 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uB124\uC694. \uC549\uC544\uC11C \uC4F0\uB2C8\uAE4C \uC790\uAFB8 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369128
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB108, \uB298 \uBA3C\uC800 \uAC00 \uC788\uB354\uB77C. \uB098\uAC08 \uB54C\uB3C4, \uB3CC\uC544\uC62C \uB54C\uB3C4. \uBB38 \uC55E\uC5D0 \uC81C\uC77C \uBA3C\uC800."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146743
    m_Localized: "\uAD50\uC2E4 \uCC45\uAC78\uC0C1\uC744 \uB554\uAC10\uC73C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786191
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uBCF4\uC5EC \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146655
    m_Localized: "\uBAA8\uB4E0 \uAC8C \uAC16\uCDB0\uC84C\uB2E4. \uC5F0\uAD6C\uB3D9 \uAE30\uB85D, \uBA87 \uB2EC \uCE58 \uAD00\uCC30 \uC77C\uC9C0, \uADF8\uB9AC\uACE0 \uB0B4 \uC190."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923657
    m_Localized: "\uC720\uB791\uC790\uAC00 \uBAA8\uC790 \uADF8\uB298 \uC544\uB798\uB85C \uC6C3\uC5C8\uB2E4. \uC18C\uB9AC\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146663
    m_Localized: "\uAD6C\uD574 \uC628 \uD608\uC561 \uD329\uC73C\uB85C \uCC98\uCE58\uB97C \uC2DC\uC791\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146742
    m_Localized: "\uBB34\uC5C7\uC774\uB4E0 \uD0DC\uC6CC\uC57C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654314
    m_Localized: "\uCC98\uC74C\uC5D4 \uC5C7\uAC08\uB9AC\uB2E4\uAC00, \uC5B4\uB290 \uC21C\uAC04 \uB450 \uC18C\uB9AC\uAC00 \uD558\uB098\uB85C \uACB9\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786192
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC11C\uB958\uB97C \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4\uAC00, \uC811\uC5B4\uC11C \uD488\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369133
    m_Localized: "{0}: {1}\uD55C\uD14C \uD55C \uBC88 \uB9D0\uD574 \uBCF8 \uC801 \uC788\uC5B4\uC694. \uADF8\uB0A0 \uC544\uCE68\uC5D0. \uADF8\uB798\uC11C\uC778\uC9C0, \uC9C0\uAE08\uC740 \uC870\uAE08 \uB35C \uBB34\uC11C\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923656
    m_Localized: "{0}: \uD558\uB098 \uB4DC\uC2E4\uB798\uC694? \uC544, \uC6D0\uB798 \uC544\uC800\uC528 \uAC70\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826540
    m_Localized: "\uD55C\uCC38 \uBCF4\uB2E4\uAC00, \uADF8 \uC5BC\uAD74\uD55C\uD14C \uC791\uAC8C \uB9D0\uD588\uB2E4. \uC218\uACE0\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146382
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8. \uC774\uB984 \uB4A4\uC5D0 \uBCF4\uAC74\uAD50\uC0AC\uB77C\uACE0 \uAF2D \uBD99\uC5EC \uB2EC\uB77C\uACE0 \uD588\uB2E4. \uADF8\uB798\uC57C \uAC00\uC11C\uB3C4 \uC77C\uC744 \uC2DC\uD0A8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174804
    m_Localized: "\uD3B8\uC9C0 \uADC0\uD241\uC774\uC758 \uB0A0\uC9DC\uB294, \uADF8\uB0A0\uC758 \uBC14\uB85C \uC804\uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146739
    m_Localized: "\uAD50\uC2E4\uC774 \uB108\uBB34 \uCD94\uC6CC\uC11C \uC785\uAE40\uC73C\uB85C \uC190\uC744 \uB179\uC600\uB2E4. \uBB3C\uBCD1 \uC18D \uBB3C\uC774 \uC544\uCE68\uB9C8\uB2E4 \uC0B4\uC5BC\uC74C\uC774 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146679
    m_Localized: "\uC11C\uB978\uB450 \uBA85\uC758 \uC774\uB984\uC744 \uBA3C\uC800 \uBD88\uB800\uB2E4. \uB300\uB2F5\uC740 \uC5C6\uC5C8\uB2E4. \uC774\uB984\uB9C8\uB2E4 \uD55C \uBC15\uC790\uC529 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146678
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uCC98\uC74C\uC73C\uB85C \uCD9C\uC11D\uC744 \uBD88\uB800\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uBAA9\uC18C\uB9AC\uAC00 \uC791\uAC8C \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369194
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uB108, \uBCF4\uAC74\uBD80\uC600\uC9C0? \uC810\uC2EC\uC2DC\uAC04\uB9C8\uB2E4 \uBC34\uB4DC \uCC59\uAE30\uB7EC \uC624\uB358."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369193
    m_Localized: "\uB450 \uC5B4\uB978\uC774 \uD55C\uCC38 \uB3D9\uC548 \uC11C\uB85C\uB97C \uBCF4\uAE30\uB9CC \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117841
    m_Localized: "{0}: \uADF8 \uC120\uC0DD\uB2D8\uC740\uC694? \uC9C0\uAE08\uC740\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460338
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uBC24\uD558\uB298 \uD53C\uD06C\uB2C9\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563631
    m_Localized: "\uB3C4\uD604 \uB610\uB798, \uC544\uB2C8\uBA74 \uB354 \uC5B4\uB838\uB2E4. \uC6B0\uBE44 \uC18C\uB9E4\uAC00 \uC816\uC5B4 \uC788\uC5C8\uB2E4. \uC720\uB9AC\uC5D0 \uB2E4\uB9AC\uB97C \uBCA0\uC600\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711632
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD558\uACE0 \uC2F6\uC740 \uAC8C \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654265
    m_Localized: "\uC774\uB984\uC744 \uC368 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146664
    m_Localized: "\uBCF4\uB0C9 \uC0C1\uC790\uC5D0\uC11C \uD608\uC561 \uD329\uC744 \uAEBC\uB0B4 \uAC78\uC5C8\uB2E4. \uC57D\uAD6D 2\uCE35\uC5D0\uC11C \uB4E4\uACE0 \uC628 \uADF8\uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146740
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uC774\uBD88\uC744 \uB450 \uACB9, \uC138 \uACB9 \uB36E\uC5B4 \uB4DC\uB824\uB3C4 \uC190\uB05D\uC740 \uCC28\uAC00\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460337
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uAC00\uC7A5\uC790\uB9AC\uC5D0 \uC549\uC544 \uBC1C\uC744 \uB2F4\uADF8\uACE0, \uC816\uC9C0 \uC54A\uC740 \uCABD \uB2E4\uB9AC\uB97C \uD587\uBCD5\uC5D0 \uB0B4\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460336
    m_Localized: "\uCC98\uC74C\uC5D4 \uBC1C\uB9CC \uB2F4\uAC14\uB2E4. \uB098\uC911\uC5D4 \uC11C\uB85C \uBB3C\uC744 \uD280\uAE30\uBA70 \uC6C3\uC5C8\uB2E4. \uC18C\uB9AC\uB97C \uC8FD\uC774\uB290\uB77C \uC6C3\uC74C\uC774 \uB354 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146665
    m_Localized: "\uBC24\uC0C8 \uC5F4\uC744 \uC7C0\uB2E4. \uC57D\uC744 \uC2DC\uAC04 \uB9DE\uCDB0 \uB123\uACE0, \uBD95\uB300\uB97C \uAC08\uACE0, \uB2E4\uC2DC \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146666
    m_Localized: "\uC0C8\uBCBD\uC774 \uB420 \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146667
    m_Localized: "\uC870\uAE08 \uB354 \uC900\uBE44\uD558\uACE0 \uD558\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654266
    m_Localized: "{0}: \uC368 \uC918\uC694. \uAD6C\uC870\uB300\uAC00 \uBD80\uB97C \uB54C, \uC9C4\uC9DC \uC774\uB984\uC73C\uB85C \uBD88\uB9AC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460335
    m_Localized: "\uC218\uC601\uC7A5 \uBC14\uB2E5\uC5D0 \uBB34\uB98E\uAE4C\uC9C0 \uBE57\uBB3C\uC774 \uACE0\uC5EC \uC788\uC5C8\uB2E4. \uBBF8\uC9C0\uADFC\uD558\uACE0 \uC870\uAE08 \uD0C1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146677
    m_Localized: "\uCD9C\uC11D\uBD80\uB97C \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369132
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB798\uB3C4 \uBD24\uAD6C\uB098. \uBB34\uC11C\uC6E0\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369131
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uB2C8\uB2E4. \uADF8\uAC74 \uC544\uB2C8\uC57C. \uB124\uAC00 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB4E0 \uC219\uC600\uB4E0, \uBB38\uC744 \uC7A0\uADFC \uAC74 \uADF8 \uC560\uB4E4\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654267
    m_Localized: "\uC120\uBC30\uB294 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 '2\uD559\uB144' \uC606\uC5D0 \uC791\uAC8C \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uCD9C\uC11D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118051
    m_Localized: "\uACF5\uBD80 \uBAA8\uC784\uC774 \uB05D\uB098\uACE0 \uCD1B\uBD88\uC744 \uB044\uB824\uB294\uB370, \uBC15 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC190\uC744 \uC7A1\uC558\uB2E4. \uC190\uBC14\uB2E5\uC5D0 \uAD73\uC740\uC0B4\uC774 \uBC15\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146676
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uBC18 \uC560\uB4E4 \uC774\uB984\uB3C4 \uAC19\uC774. \uC5B4\uB514\uC120\uAC00 \uB300\uB2F5\uD558\uACE0 \uC788\uC744\uC9C0 \uBAA8\uB974\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786274
    m_Localized: "\uB458\uC774\uC11C \uBC24\uB2A6\uAC8C\uAE4C\uC9C0 \uBB38 \uC55E \uCC45\uC0C1\uC744 \uB2E4\uC2DC \uBB36\uACE0, \uBB3C\uD1B5\uC744 \uC548\uCABD\uC73C\uB85C \uC62E\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786273
    m_Localized: "\uC9C0\uAE08 \uD560 \uC218 \uC788\uB294 \uAC78 \uB354 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146741
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBC24\uB9C8\uB2E4 \uC624\uB974\uB294 \uC5F4 \uB54C\uBB38\uC5D0, \uCD94\uC6B4\uC9C0 \uB354\uC6B4\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4\uACE0 \uD588\uB2E4. \uADF8 \uB9D0\uC774 \uB354 \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980490
    m_Localized: "\uB3C4\uD604: \u2026\uB124. \uADF8\uB798\uB3C4 \uB098\uC911\uC5D4 \uC2DC\uCF1C \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174810
    m_Localized: "\uD3B8\uC9C0\uB97C \uCC45\uC0C1 \uC11C\uB78D\uC5D0 \uB2E4\uC2DC \uB123\uC5C8\uB2E4. \uADF8 \uC790\uB9AC\uAC00 \uB9DE\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826570
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC804\uC120\uC774\uB791 \uBD80\uD488\uC774\uBA74 \uACE0\uCE60 \uC218 \uC788\uB294 \uAC8C \uB9CE\uC544. \uACF5\uD559 \uACF5\uBD80\uD560 \uB54C \uC4F0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146780
    m_Localized: "\uAD6C\uC870\uB300: \uC608\uC815\uB300\uB85C 3\uC6D4 \uB458\uC9F8 \uC8FC \uC544\uCE68, \uC625\uC0C1\uC73C\uB85C \uAC11\uB2C8\uB2E4. \uC625\uC0C1 \uD45C\uC2DC\uB294 \uADF8\uB300\uB85C \uB450\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146779
    m_Localized: "\uAD6C\uC870\uB300: \uB77C\uB514\uC624 \uCC44\uB110\uB85C \uBC1B\uC740 \uBA85\uB2E8 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC0C8\uBCBD\uACE0 \uC778\uC6D0, \uBE60\uC9D0\uC5C6\uC774 \uC62C\uB77C\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146778
    m_Localized: "\uAD6C\uC870\uB300: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50, \uB4E4\uB9BD\uB2C8\uAE4C. \uAD6C\uC870\uB300\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460223
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 \uADF8 \uAC78\uC74C\uC740 \uC5B4\uB514\uC11C \uBC30\uC6E0\uB2C8. \uC5F4\uC5EC\uC12F \uC0B4\uC774 \uBC30\uC6B0\uAE30\uC5D4 \uB108\uBB34 \uBE60\uB978 \uAC78\uC74C\uC778\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146378
    m_Localized: "\uD55C \uC0AC\uB78C\uC529 \uC774\uB984\uC744 \uBD88\uB800\uB2E4. \uCC9C\uCC9C\uD788, \uBC1B\uC544 \uC801\uC744 \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146777
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC7A1\uC74C \uB05D\uC5D0, \uCC98\uC74C \uB4E3\uB294 \uB2E8\uB2E8\uD55C \uBAA9\uC18C\uB9AC\uAC00 \uB07C\uC5B4\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146776
    m_Localized: "\uBAA8\uB450 2\uCE35 \uBCF5\uB3C4\uC5D0 \uBAA8\uC5EC \uC11C\uB85C\uC758 \uC774\uB984\uC744 \uBD88\uB800\uB2E4. \uB2E4 \uB300\uB2F5\uD588\uB2E4. \uADF8\uAC70\uBA74 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146775
    m_Localized: "\uB0A0\uC774 \uBC1D\uACE0 \uB098\uC11C\uC57C \uADF8\uAC83\uB4E4\uC740 \uB3CC\uC544\uAC14\uB2E4. 1\uCE35\uC5D0 \uC313\uC544 \uB454 \uC2DD\uB7C9 \uC77C\uBD80\uAC00 \uC9D3\uBC1F\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146774
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC \uD558\uB098\uAC00 \uB118\uC5B4\uAC14\uB2E4. 1\uCE35\uC744 \uB0B4\uC8FC\uACE0, 2\uCE35 \uACC4\uB2E8\uCC38\uC5D0\uC11C \uBC84\uD17C\uB2E4. \uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uBB34\uC804\uAE30\uC5D0\uC11C \uB04A\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118027
    m_Localized: "\uAD50\uC2E4 \uCC45\uC0C1 \uB450 \uAC1C\uB97C \uBD99\uC774\uACE0 \uCD1B\uBD88 \uD558\uB098\uB97C \uAC00\uC6B4\uB370 \uB450\uC5C8\uB2E4. \uBB38\uC81C\uC9D1\uC740 \uBC18\uCBE4 \uC816\uC5B4 \uC788\uC5C8\uC9C0\uB9CC \uC77D\uC744 \uC218\uB294 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369203
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC0C1\uCC98\uB294 \uAE68\uB057\uD558\uAC8C \uC544\uBB3C\uC5C8\uC5B4\uC694. \uB108\uBB34 \uAE68\uB057\uD574\uC11C \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118052
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBD95\uB300 \uAC10\uB294 \uC190\uC774 \uB410\uB124. \uCC98\uC74C \uC654\uC744 \uB550 \uD540\uC14B\uB3C4 \uB5A8\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980489
    m_Localized: "\uC544\uC9C1\uC740 \uC548\uC804\uD55C \uC77C\uB9CC \uB9E1\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369202
    m_Localized: "\uBB38\uD2C8\uC73C\uB85C \uB450 \uC0AC\uB78C\uC758 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980528
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBCBD\uC5D0 \uAE30\uB300\uC549\uC740 \uCC44 \uC190\uBAA9\uC2DC\uACC4\uB97C \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174825
    m_Localized: "\uD45C\uC2DC\uB294 \uADF8\uB300\uB85C \uB450\uC5C8\uB2E4. \uBC24\uB9C8\uB2E4 \uADF8 \uBD89\uC740 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uB208\uC744 \uAC10\uC544\uB3C4 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118028
    m_Localized: "\uB3C4\uC11C\uBD80\uC5D0\uC11C \uD558\uB358 \uB300\uB85C \uBB38\uC81C\uC9D1\uC744 \uB2E8\uC6D0\uBCC4\uB85C \uB098\uB204\uACE0 \uACAC\uCD9C\uC9C0\uB97C \uBD99\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654254
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790: \uC138\uC0C1 \uCC38 \uB9CE\uC774 \uBCC0\uD588\uB2E4. \u2026\uAC00\uB77C. \uAC15\uCCA0 \uD615\uD55C\uD14C\uB294 \uB9D0 \uC548 \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654255
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38 \uB0B4\uB0B4 \uC120\uBC30\uB294 \uB0B4 \uBC18 \uAC78\uC74C \uB4A4\uC5D0\uC11C \uAC78\uC5C8\uB2E4. \uAD50\uBB38 \uC55E\uC5D0\uC11C, \uCC98\uC74C\uC73C\uB85C \uBA3C\uC800 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uB0B4\uAC00 \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB294\uB370\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460332
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uD559\uC5D4 \uB180\uC544\uC57C\uC9C0. \uADF8\uAC8C \uC219\uC81C\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460333
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB3C\uB180\uC774\uD558\uACE0 \uB098\uBA74 \uADC0\uC5D0 \uBB3C \uAF2D \uBE7C. \uC5EC\uAE30\uC11C \uC911\uC774\uC5FC \uAC78\uB9AC\uBA74 \uC57D\uB3C4 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174809
    m_Localized: "\uC81C\uC790\uB9AC\uC5D0 \uB450\uACE0 \uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118053
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0A1\uC740 \uAC04\uD638\uC0AC \uC218\uCCA9\uC744 \uD3BC\uCCE4\uB2E4. \uB9E8 \uC55E \uC7A5\uC5D0 \uC11C\uD230 \uAE00\uC528\uB85C '\uC2E0\uADDC \uAC04\uD638\uC0AC \uBC15\u25CB\u25CB, \uCCAB \uADFC\uBB34'\uB77C\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146773
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uCD9C\uC11D \uBD80\uB974\uC790. \uD55C \uBA85\uB3C4 \uBE60\uC9C0\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146772
    m_Localized: "\uD574\uAC00 \uB728\uC790 \uB204\uAD70\uAC00 \uC6C3\uC74C\uC744 \uD130\uB728\uB838\uB2E4. \uC6B8\uC74C\uC778\uC9C0 \uC6C3\uC74C\uC778\uC9C0 \uBAA8\uB97C \uC18C\uB9AC\uAC00 \uBCF5\uB3C4\uB97C \uB530\uB77C \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146771
    m_Localized: "\uADF8\uB9BC\uC790\uB4E4\uC740 \uC0C8\uBCBD\uC774 \uC624\uAE30 \uC804\uC5D0 \uB208 \uC18D\uC73C\uB85C \uC4F0\uB7EC\uC9C0\uAC70\uB098 \uD769\uC5B4\uC84C\uB2E4. \uC815\uBB38\uC740 \uB05D\uB0B4 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118029
    m_Localized: "\uACFC\uD559\uBD80 \uC2E4\uD5D8 \uB178\uD2B8\uCC98\uB7FC, \uB9E8 \uC704\uC5D0 \uB0A0\uC9DC\uC640 \uC624\uB298\uC758 \uBAA9\uD45C\uBD80\uD130 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118030
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBB38\uC81C\uC9D1 \uB300\uC2E0 \uBD95\uB300\uB97C \uAEBC\uB0C8\uB2E4. \uC624\uB298\uC740 \uC751\uAE09 \uCC98\uCE58 \uC2DC\uD5D8\uC774\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146470
    m_Localized: "\uC544\uCE68\uC5D0 \uCC3D\uBC16\uC774 \uC774\uC0C1\uD558\uAC8C \uBC1D\uC558\uB2E4. \uCCAB\uB208\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146471
    m_Localized: "\uC6B4\uB3D9\uC7A5, \uAD50\uBB38, \uC0AC\uAC70\uB9AC\uC758 \uC2E0\uD638\uB4F1\uAE4C\uC9C0. \uBAA8\uB4E0 \uAC83\uC774 \uD558\uC597\uAC8C \uB36E\uC5EC \uC788\uC5C8\uB2E4. \uBD89\uC740 \uD45C\uC2DC\uB3C4, \uBC1C\uC790\uAD6D\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118031
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uCD9C\uD608 \uBD80\uC704\uBCF4\uB2E4 \uC2EC\uC7A5 \uAC00\uAE4C\uC6B4 \uCABD. \uADF8\uB2E4\uC74C\uC740? \u2026\uADF8\uB807\uC9C0. \uC2DC\uAC04\uC744 \uC801\uB294 \uAC70\uC57C. \uC5B8\uC81C \uBB36\uC5C8\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174785
    m_Localized: "\uB2F4\uC694 \uD558\uB098\uB97C \uB458\uC774 \uB098\uB220 \uB36E\uACE0 \uD574\uAC00 \uB4E4 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146669
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB354\uB294 \uD63C\uC790 \uC77C\uC5B4\uB098\uC9C0 \uBABB\uD588\uB2E4. \uC544\uCE68\uC5D0 \uBAB8\uC744 \uC77C\uC73C\uD0A4\uB824\uB2E4\uAC00, \uD314\uC774 \uBA3C\uC800 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118032
    m_Localized: "\uB0B4\uAC00 \uB9DE\uD790 \uB54C\uB9C8\uB2E4 \uC120\uC0DD\uB2D8 \uB208\uAC00\uAC00 \uC870\uAE08\uC529 \uD480\uB838\uB2E4. \uAC00\uB974\uCE58\uB294 \uC0AC\uB78C \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117831
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uACF5\uCC45\uC744 \uB118\uACBC\uB2E4. \uB0B4 \uAE00\uC528\uBCF4\uB2E4 \uC5C9\uB9DD\uC778 \uAE00\uC528, \uADF8\uB9AC\uACE0 \uC5EC\uBC31\uB9C8\uB2E4 \uBE68\uAC04 \uD39C \uAE00\uC528\uAC00 \uBE7C\uACE1\uD588\uB2E4. \uC120\uC0DD\uB2D8 \uAE00\uC528\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711631
    m_Localized: "\uB3C4\uD604: \uB204\uB098 \uB098\uAC08 \uB54C\uB9C8\uB2E4 \uC5EC\uAE30\uC11C \uC2DC\uACC4\uB9CC \uBD10\uC694. \uB3CC\uC544\uC62C \uB54C\uAE4C\uC9C0. \uADF8\uAC8C \uC81C\uC77C \uD798\uB4E4\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146770
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC74 \uC2DC\uD5D8\uC774 \uC544\uB2C8\uB2E4. \uD2C0\uB9AC\uBA74 \uB2E4\uC2DC \uD480\uBA74 \uB3FC. \uB300\uC2E0 \uC0B4\uC544\uC11C \uD480\uC5B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146769
    m_Localized: "{0}: \uB4E4\uC5C8\uC5B4\uC694. \uC67C\uCABD \uACC4\uB2E8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146768
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC11C\uC11C \uC2F8\uC6B0\uC9C0\uB294 \uBABB\uD574\uB3C4, \uBCF4\uB294 \uAC74 \uD560 \uC218 \uC788\uB2E4. \uC67C\uCABD \uACC4\uB2E8, \uC14B."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706379
    m_Localized: "\"\uCC9C\uCC9C\uD788 \uAC00\uB3C4 \uB3FC. \uC774\uC81C\uB294 \uAC19\uC774 \uAC78\uC744 \uC0AC\uB78C\uC774 \uC788\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706380
    m_Localized: "\uBB38\uACE0\uB9AC\uB97C \uB193\uACE0 \uACC4\uB2E8\uC744 \uB2E4\uC2DC \uB0B4\uB824\uAC14\uB2E4. \uB9E8 \uB4A4\uC5D0\uC11C, \uC81C\uC77C \uB290\uB9B0 \uC0AC\uB78C \uC606\uC5D0\uC11C \uB2E4\uC2DC \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460334
    m_Localized: "\uBE48 \uC218\uC601\uC7A5\uC5D0 \uACE0\uC778 \uBE57\uBB3C\uC5D0\uC11C \uBB3C\uB180\uC774\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146668
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uC11C\uB450\uB974\uC9C0 \uB9C8\uB77C. \uC544\uC9C1 \uC2DC\uAC04\uC740 \uC788\uB2E4. \uC870\uAE08\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146644
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uD30C\uC77C\uC744 \uB36E\uACE0, \uC548\uACBD\uC744 \uBC97\uC5B4 \uCF67\uB4F1\uC744 \uB20C\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146645
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD574 \uBCFC \uC218\uB294 \uC788\uC5B4. \uADF8\uB7F0\uB370 \uC9C0\uAE08\uC740 \uC548 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369157
    m_Localized: "\uBBF8\uC548\uD558\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369156
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uBB34 \uC77C \uC5C6\uB358 \uCC99\uD558\uB824\uACE0 \uC228\uAE34 \uAC74 \uC544\uB2C8\uC9C0. \uB124\uAC00 \uBA3C\uC800 \uB05D\uAE4C\uC9C0 \uBCF4\uACE0 \uB098\uC11C, \uB204\uAD6C\uD55C\uD14C \uBCF4\uC5EC \uC904\uC9C0 \uC815\uD558\uACE0 \uC2F6\uC5C8\uB358 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706381
    m_Localized: "\uACF5\uCC45\uC744 \uB36E\uACE0 \uB098\uC11C\uB3C4 \uD55C\uCC38 \uC7A0\uC774 \uC624\uC9C0 \uC54A\uC558\uB2E4. \uB208\uC744 \uAC10\uC544\uB3C4 \uC22B\uC790\uAC00 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706382
    m_Localized: "\uCEE4\uD2BC\uC744 \uCE58\uACE0 \uC120\uC0DD\uB2D8 \uC606\uC5D0 \uC549\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146670
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uCCB4\uC628\uC744 \uC7AC\uACE0 \uC218\uCCA9\uC5D0 \uD55C \uC904\uC744 \uC801\uC5C8\uB2E4. \uBB34\uC2A8 \uC904\uC778\uC9C0, \uC544\uBB34\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146671
    m_Localized: "\uBCA0\uAC1C \uC606\uC5D0 \uCD9C\uC11D\uBD80\uAC00 \uC788\uC5C8\uB2E4. 1\uD559\uB144 4\uBC18. \uC120\uC0DD\uB2D8\uC774 \uB9E1\uAE30\uB85C \uD588\uB358, \uB05D\uB0B4 \uCCAB \uC218\uC5C5\uC744 \uD558\uC9C0 \uBABB\uD55C \uBC18."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146646
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uCC98\uCE58\uD558\uB824\uBA74 \uB0B4 \uC190\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD574. \uB124\uAC00 \uC751\uAE09\uCC98\uCE58\uB97C \uD6E8\uC52C \uB354 \uC798 \uC54C\uC544\uC57C \uD558\uACE0, \uC6B0\uB9AC\uAC00 \uBAA8\uC740 \uC99D\uC0C1 \uAE30\uB85D\uB3C4 \uB354 \uC788\uC5B4\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146379
    m_Localized: "\uB3C4\uD604. \uC774\uB984\uC774 \uBD88\uB9AC\uC790 \uB3C4\uD604\uC774 \uBB34\uC804\uAE30\uC5D0 \uB300\uACE0 \"\uB124!\" \uD558\uACE0 \uB300\uB2F5\uD588\uB2E4. \uC800\uCABD\uC5D0\uC11C \uB4E4\uB9B4 \uB9AC \uC5C6\uB294\uB370\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706383
    m_Localized: "\uCEE4\uD2BC\uC744 \uCCE4\uB2E4. \uCC3D\uBC16\uC774 \uC0AC\uB77C\uC84C\uB2E4. \uADF8\uAC83\uB4E4\uC774 \uC0AC\uB77C\uC9C4 \uAC74 \uC544\uB2C8\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146767
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 3\uCE35 \uCC3D\uAC00\uC5D0 \uC758\uC790\uB97C \uB193\uACE0 \uC549\uC558\uB2E4. \uBC24\uB9C8\uB2E4 \uC624\uB974\uB294 \uC5F4\uC5D0 \uC774\uB9C8\uAC00 \uC816\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118054
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uCCAB\uB0A0 \uB098\uB294 \uD654\uC7A5\uC2E4\uC5D0\uC11C \uC6B8\uC5C8\uC5B4. \uC544\uBB34\uB3C4 \uBAB0\uB77C. \uB108\uD55C\uD14C \uCC98\uC74C \uB9D0\uD558\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174862
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBCD1\uC6D0\uC5D0\uC120 '\uD2B8\uB9AC\uC544\uC9C0'\uB77C\uACE0 \uD574. \uC0B4\uB9B4 \uC218 \uC788\uB294 \uC0AC\uB78C\uBD80\uD130. \uB4E3\uAE30 \uC88B\uC740 \uB9D0\uC740 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369129
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC8C\u2026 \uADF8\uB7F0 \uC774\uC720\uC600\uAD6C\uB098. \uBE68\uB9AC \uC9C0\uB098\uAC00\uC57C \uD558\uB294 \uBCF5\uB3C4\uAC00 \uC788\uC5C8\uB358 \uAC70\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369130
    m_Localized: "{0}: \uC0AC\uD0DC \uB098\uB358 \uB0A0 \uC544\uCE68\uC5D0\uC694. \uCC98\uC74C\uC73C\uB85C \uADF8 \uC560\uB4E4\uC744 \uB611\uBC14\uB85C \uBD24\uC5B4\uC694. \uADF8\uB798\uC11C \uADF8\uB807\uAC8C \uB41C \uAC74\uAC00 \uC2F6\uAE30\uB3C4 \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118033
    m_Localized: "\uB3C4\uD604\uC740 \uC218\uD559 \uBB38\uC81C\uC9D1\uC744 \uD3B4\uC790\uB9C8\uC790 \uC5CE\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146472
    m_Localized: "\uC791\uB144 \uCCAB\uB208\uC5D0\uB294 {0} \uC0AC\uC9C4\uC744 \uC2A4\uBB34 \uC7A5 \uB118\uAC8C \uBCF4\uB0C8\uC5C8\uB2E4. \uB2E4 \uBE44\uC2B7\uD55C \uC0AC\uC9C4\uC774\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uD558\uB098\uD558\uB098 \uB2F5\uC7A5\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146473
    m_Localized: "\uB3C4\uD604\uC774 \uCC3D\uC5D0 \uC774\uB9C8\uB97C \uB300\uACE0 \uD55C\uCC38 \uC11C \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146672
    m_Localized: "\uC11C\uB978\uB450 \uBA85\uC758 \uC774\uB984 \uB4A4\uB85C, \uBE48 \uC7A5\uB9C8\uB2E4 \uC120\uC0DD\uB2D8\uC774 \uC190\uC73C\uB85C \uC368 \uB123\uC740 \uC774\uB984\uB4E4\uC774 \uC774\uC5B4\uC84C\uB2E4. \uC774 \uD559\uAD50\uC5D0 \uD558\uB098\uC529 \uB4E4\uC5B4\uC628 \uC0AC\uB78C\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146673
    m_Localized: "\uC0AC\uC774\uC0AC\uC774\uC5D0 \uB07C\uC6CC \uB454 \uC885\uC774\uB4E4\uC774 \uC090\uC838\uB098\uC640 \uC788\uC5C8\uB2E4. \uBC18\uC73C\uB85C \uC811\uC740 \uCABD\uC9C0, \uC811\uD78C \uC790\uAD6D\uC774 \uD558\uC597\uAC8C \uB2F3\uC740 \uD3B8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369201
    m_Localized: "\uBC24. \uBCF4\uAC74\uC2E4\uC5D0\uC11C \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC724 \uC120\uC0DD\uB2D8\uC758 \uB2E4\uB9AC \uBD95\uB300\uB97C \uC0C8\uB85C \uAC10\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174786
    m_Localized: "\uBC24\uC0C8 \uB208\uC774 \uC654\uB2E4. \uBC1C\uC790\uAD6D \uD558\uB098 \uC5C6\uB294 \uC6B4\uB3D9\uC7A5\uC774 \uD558\uC597\uAC8C \uBE5B\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786275
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uC815\uB3C4\uBA74\u2026 \uD558\uB8E8\uB294 \uB354 \uBC84\uD2F0\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146647
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAE30\uB85D\uC5D0\uC11C \uC9C4\uD589\uC774 \uBA48\uCD98 \uC0AC\uB78C\uB4E4\uC740 \uB2E4 \uCD08\uAE30\uC5D0, \uB2E4 \uAF3C\uAF3C\uD558\uAC8C \uC9C0\uCF1C\uBCF8 \uC0AC\uB78C\uB4E4\uC774\uC5C8\uC5B4. \uC6B4\uC774 \uC544\uB2C8\uB77C \uAE30\uB85D\uC774 \uC0B4\uB9B0 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757990
    m_Localized: "\uAC15\uCCA0: \uC77C\uC8FC\uC77C \uC900\uB2E4. \uBE44\uC6B0\uB4E0\uC9C0, \uC9C0\uD0A4\uB4E0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118055
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAC00\uB974\uCE58\uB294 \uAC8C \uC88B\uC544. \uB0B4\uAC00 \uC0AC\uB77C\uC838\uB3C4 \uB0A8\uB294 \uAC70\uC796\uC544. \u2026\uB124 \uC190\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174784
    m_Localized: "\uCC3D\uC5D0 \uC131\uC5D0\uAC00 \uAF08\uB2E4. \uC190\uAC00\uB77D\uC73C\uB85C \uC774\uB984\uC744 \uC37C\uB2E4\uAC00 \uC9C0\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786276
    m_Localized: "\uC0C8\uBCBD \uB450 \uC2DC\uCBE4. \uCC9C\uC7A5 \uB108\uBA38\uC5D0\uC11C \uB611, \uB611, \uB611 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146674
    m_Localized: "\uADF8\uC911 \uD558\uB098\uB294 \uC5EC\uB984\uC5D0 102\uD638 \uC55E\uC5D0\uC11C \uBC1B\uC740 \uADF8 \uCABD\uC9C0\uC600\uB2E4. '\uACE0\uB9C8\uC6CC\uC694.' \uB3D9\uADF8\uB797\uAC8C \uB9D0\uB824 \uC62C\uB77C\uAC04 '\uC694' \uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146766
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uC11C \uB2E4 \uBCF4\uC778\uB2E4. \uB0B4\uAC00 \uB208\uC774 \uB418\uC5B4 \uC8FC\uB9C8. \uC67C\uCABD \uACC4\uB2E8, \uC14B."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146765
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uB204\uC6B4 \uCC44\uB85C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4. \uCE68\uB300\uB97C \uCC3D\uAC00\uB85C \uB04C\uC5B4\uB2E4 \uB193\uC740 \uAC74 \uC624\uB298 \uBC24\uC744 \uC704\uD574\uC11C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118056
    m_Localized: "\uC120\uC0DD\uB2D8\uD55C\uD14C \uBC30\uC6B4 \uAC78 \uB2E4\uC2DC \uAC00\uB974\uCCD0 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757989
    m_Localized: "\uAC15\uCCA0: \uC6B0\uB9AC\uB3C4 \uC0B4\uACE0 \uC2F6\uB2E4. \uAC80\uC0AC\uB294 \uC5B4\uB5BB\uAC8C\uB4E0 \uD1B5\uACFC\uD55C\uB2E4. \uADF8\uB7EC\uB2C8 \uADF8\uB0A0 \uC625\uC0C1\uC740 \uC6B0\uB9AC\uAC00 \uC4F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786271
    m_Localized: "{0}: \uC774\uBC88 \uC8FC \uC9C0\uB098\uBA74\uC694. \uC625\uC0C1\uC5D0\uC11C \uD574 \uB728\uB294 \uAC70 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591900
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uBE68\uB9AC \uBABB \uC6C0\uC9C1\uC5EC. \uB124\uAC00 \uC55E\uC7A5\uC11C \uC918\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591899
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBCF8\uAD00 \uCC3D\uACE0\uC5D0 \uBB3C\uC774\uB791 \uBA39\uC744 \uAC8C \uC870\uAE08 \uC788\uC5B4. \uAC70\uAE30\uAE4C\uC9C0\uB9CC \uAC19\uC774 \uAC00\uC790. \uC18C\uB9AC \uB0B4\uC9C0 \uB9D0\uACE0, \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146474
    m_Localized: "\uB3C4\uD604: \uC791\uB144 \uCCAB\uB208\uC5D4 \uD559\uC6D0 \uAC00\uAE30 \uC2EB\uB2E4\uACE0 \uC5C4\uB9C8\uD55C\uD14C \uB5BC\uC37C\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146475
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCC3D\uC5D0 \uC11C\uB9B0 \uAE40 \uC704\uC5D0 \uC190\uAC00\uB77D\uC73C\uB85C \uBB34\uC5B8\uAC00\uB97C \uADF8\uB838\uB2E4\uAC00, \uC18C\uB9E4\uB85C \uC9C0\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591898
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0AE\uC5D0\uB294 \uC800\uB807\uAC8C \uC7A0\uB4E4\uC5B4 \uC788\uC5B4. \uBC24\uC5D0\uB294\u2026 \uB098\uC911\uC5D0 \uC598\uAE30\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591897
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5 \uB300\uC2E0 \uCC3D\uACE0 \uBC16 \uBCF5\uB3C4\uB97C \uAC00\uB9AC\uCF30\uB2E4. \uBCF5\uB3C4 \uB05D\uC5D0 \uBB34\uC5B8\uAC00 \uC11C \uC788\uC5C8\uB2E4. \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uACE0, \uACE0\uAC1C\uB9CC \uC219\uC778 \uCC44."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369200
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC190\uB4F1\uC758 \uAE01\uD78C \uC790\uAD6D\uC744 \uC18C\uB3C5\uD558\uBA70 \uB9D0\uD588\uB2E4. \uB530\uB054\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757750
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uB9D0\uC5C6\uC774 \uBB38 \uC606\uC5D0 \uC130\uB2E4. \uBB38\uC744 \uC7A0\uADF8\uB358 \uC190\uC73C\uB85C, \uC774\uBC88\uC5D0\uB294 \uBB38\uC744 \uBD99\uC7A1\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987469
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC26C\uC6B4 \uAC83\uBD80\uD130. \uC774 \uC2DC, \uC18C\uB9AC \uB0B4\uC11C \uC77D\uC5B4 \uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757988
    m_Localized: "\uAC15\uCCA0: \uD5EC\uAE30 \uD55C \uBC88\uC5D0 \uC5EC\uB35F\uC774\uB77C\uBA70. \uB2E4\uC74C \uAC74 \uD55C \uB2EC \uB4A4\uACE0. \uC774 \uB3D9\uB124\uC5D0\uC11C \uD55C \uB2EC\uC744 \uB354 \uBC84\uD2F8 \uB188\uC774, \uC6B0\uB9AC \uC911\uC5D0 \uBA87\uC774\uB098 \uB420 \uAC83 \uAC19\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146675
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70, \uC774\uC81C \uB124\uAC00 \uB4E4\uACE0 \uC788\uC5B4\uB77C. \uCD9C\uC11D\uC740 \uB124\uAC00 \uBD88\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146476
    m_Localized: "\uB208 \uC704\uC5D0 \uCC98\uC74C \uCC0D\uD78C \uBC1C\uC790\uAD6D\uC740 \uADF8 \uACE0\uC591\uC774\uC758 \uAC83\uC774\uC5C8\uB2E4. \uAE09\uC2DD\uC2E4 \uCABD\uC73C\uB85C, \uD55C \uC904\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174887
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uD314\uC9F1\uC744 \uB07C\uACE0 \uBB38\uAC04\uC5D0 \uAE30\uB300 \uC788\uC5C8\uB2E4. \uC6C3\uB294 \uC5BC\uAD74\uC744 \uB4E4\uD0A4\uC9C0 \uC54A\uC73C\uB824\uACE0 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786272
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC18D. \uBAA9\uBC1C \uC9DA\uACE0\uB77C\uB3C4 \uC62C\uB77C\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146764
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB79C\uB9CC\uC5D0 \uC11C \uC788\uC73C\uB824\uB2C8 \uBB34\uB98E\uC774 \uB2E4 \uB5A8\uB9B0\uB2E4. \u2026\uB18D\uB2F4\uC774\uB2E4. \uC67C\uCABD \uACC4\uB2E8, \uC14B."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146763
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBB34\uC804\uAE30\uB97C \uB4E4\uACE0 \uC625\uC0C1 \uBB38 \uC55E\uC5D0 \uC130\uB2E4. \uC5F4\uC774 \uB0B4\uB9B0 \uB4A4\uB85C \uCC98\uC74C \uB9E1\uB294 \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786287
    m_Localized: "\uB3C4\uD604\uC740 \uC120\uC0DD\uB2D8\uC758 \uB2E4\uB9AC\uB97C \uBCF4\uACE0 \uB208\uC744 \uD53C\uD588\uB2E4\uAC00, \uB2E4\uC2DC \uB611\uBC14\uB85C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786286
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC8FC\uC77C \uB118\uAC8C 3\uCE35\uC5D0\uC11C \uD63C\uC790 \uBC84\uD2F4 \uAC70\uC57C? \uB300\uB2E8\uD558\uB2E4, \uC815\uB9D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118034
    m_Localized: "\uB3C4\uD604: \uB204\uB098, \uADFC\uB370 \uC774\uAC70 \uAD6C\uC870\uB418\uBA74 \uC2DC\uD5D8 \uBD10\uC694? \uC9C4\uC9DC\uB85C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118035
    m_Localized: "{0}: \uBD10. \uADF8\uB7EC\uB2C8\uAE4C \uD480\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118036
    m_Localized: "\uB3C4\uD604\uC740 \uD22C\uB35C\uB300\uBA74\uC11C\uB3C4 \uB05D\uAE4C\uC9C0 \uD480\uC5C8\uB2E4. \uC138 \uBB38\uC81C \uC911 \uB450 \uAC1C\uB97C \uB9DE\uD614\uB2E4. \uC790\uB791\uD558\uB7EC \uC724 \uC120\uC0DD\uB2D8\uD55C\uD14C \uB6F0\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711513
    m_Localized: "\uBC24\uC0C8 \uAD50\uC2E4 \uC55E\uBB38\uC744 \uAE01\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uBB38\uC744 \uB9C9\uC740 \uCC45\uC0C1\uC774 \uD55C \uBF18\uCBE4 \uBC00\uB824\uB098 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711514
    m_Localized: "\uBC24\uC0C8 \uCC3D\uACE0 \uCCA0\uBB38\uC744 \uAE01\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uBB38\uD2C0\uC5D0 \uD760\uC9D1\uC774 \uB298\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711515
    m_Localized: "\uD558\uB098\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uAE01\uB294 \uC18C\uB9AC \uC0AC\uC774\uC0AC\uC774\uB85C \uB2E4\uB978 \uBC15\uC790\uAC00 \uC11E\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711516
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC\uAC00 \uB4DC\uB098\uB4DC\uB294 \uC18C\uB9AC\uB97C \uC800\uAC83\uB4E4\uB3C4 \uB4E3\uACE0 \uC788\uB294 \uAC70\uC57C. \uB0C4\uC0C8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118057
    m_Localized: "{0}: \uADF8\uB7FC \uC624\uB298\uC740 \uC81C\uAC00 \uC120\uC0DD\uB2D8 \uC2DC\uD5D8 \uBCFC\uAC8C\uC694. \uCD9C\uD608 \uBD80\uC704\uBCF4\uB2E4 \uC2EC\uC7A5 \uAC00\uAE4C\uC6B4 \uCABD, \uADF8\uB2E4\uC74C\uC740\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118058
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uB2E4\uAC00 \uB300\uB2F5\uD588\uB2E4. \uC815\uB2F5\uC774\uC5C8\uB2E4. \uB0B4\uAC00 \uC218\uCCA9\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uADF8\uB824 \uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711517
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCC98\uC74C\uC5D4 \uC9C0\uB098\uAC00\uB2E4 \uB4E4\uB974\uB294 \uC815\uB3C4\uC600\uACA0\uC9C0. \uC774\uC81C\uB294 \uC5EC\uAE30\uB97C \uAE30\uC5B5\uD558\uAE30 \uC2DC\uC791\uD55C \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146648
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC758\uD559 \uACF5\uBD80\uB97C \uB354 \uD574. \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uC0C1\uD0DC\uB97C \uB9E4\uC77C \uC801\uC5B4. \uB2E8\uC11C\uAC00 \uC313\uC774\uBA74, \uADF8\uB54C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146649
    m_Localized: "\uD30C\uC77C\uC744 \uBA87 \uBC88\uC774\uACE0 \uB2E4\uC2DC \uC77D\uC5C8\uB2E4. \uC77D\uC744\uC218\uB85D \uBAA8\uB974\uB294 \uAC83\uC774 \uB298\uC5B4\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174832
    m_Localized: "\uB0A8\uC790: \uAF2C\uB9F9\uC774\uAC00 \uC7A5\uC0AC\uB97C \uD558\uB124. \uD615\uB2D8\uD55C\uD14C \uADF8\uB300\uB85C \uC804\uD558\uC9C0. \uD615\uB2D8\uC740 \uC774\uB7F0 \uAC70 \uC88B\uC544\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146762
    m_Localized: "\uC120\uBC30\uB294 \uB9E1\uAE34 \uB300\uB85C \uC67C\uCABD \uACC4\uB2E8 \uC544\uB798\uC5D0 \uC130\uB2E4. \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC774\uACE0\uB294, \uB05D\uAE4C\uC9C0 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146761
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBCF4\uAC74\uC2E4 \uBB38\uC744 \uD65C\uC9DD \uC5F4\uC5B4 \uB450\uACE0, \uBD95\uB300\uB97C \uAE38\uAC8C \uC798\uB77C \uC758\uC790 \uB4F1\uBC1B\uC774\uB9C8\uB2E4 \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786176
    m_Localized: "\uD654\uBA74\uC744 \uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786177
    m_Localized: "\uD734\uB300\uD3F0\uC744 \uC5CE\uC5B4 \uB450\uC5C8\uB2E4. \uD654\uBA74 \uBD88\uBE5B\uC774 \uCC9C\uC7A5\uC5D0 \uD76C\uBBF8\uD558\uAC8C \uBE44\uCCE4\uB2E4\uAC00 \uAEBC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654268
    m_Localized: "\uADF8\uAC8C \uB300\uB2F5\uC774\uC5C8\uB2E4. \uC608\uC804\uC758 \uC774\uB984\uC73C\uB85C\uB294 \uB2E4\uC2DC \uBD88\uB9AC\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654269
    m_Localized: "\uC0AC\uAC70\uB9AC\uC758 \uADF8 \uB0A8\uC790\uAC00 \uBD80\uB974\uB2E4 \uB9CC \uC774\uB984\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB05D\uB0B4 \uB4E3\uC9C0 \uBABB\uD55C \uC774\uB984. \uB4E3\uC9C0 \uC54A\uC544\uC11C \uB2E4\uD589\uC778 \uC774\uB984."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369199
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC88B\uC544. \uCCAB \uC218\uC5C5. \uC0C1\uCC98\uB294 \uC228\uAE30\uB294 \uAC8C \uC544\uB2C8\uB77C \uBCF4\uC5EC \uC8FC\uB294 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146477
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uCC3D \uCABD\uC73C\uB85C \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146478
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB\uB208 \uC624\uBA74 \uB9CC\uB098\uC790\uB358 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB294\uB370. \u2026\uC624\uB298\uC740 \uB108\uD76C \uBCF4\uB294 \uAC78\uB85C \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146760
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 3\uCE35 \uCC3D\uAC00\uC5D0\uC11C \uC190\uC804\uB4F1\uC744 \uC950\uC5C8\uB2E4. \uC544\uB798\uCE35\uC5D0 \uC2E0\uD638\uB97C \uBCF4\uB0B4\uB294 \uAC74 \uADF8 \uC560 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146650
    m_Localized: "\uCC98\uCE58 \uC808\uCC28\uB294 \uC801\uD600 \uC788\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uADF8\uAC78 \uD574\uB0BC \uC190\uC774, \uC9C0\uAE08\uC758 \uB098\uC5D0\uAC8C\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146651
    m_Localized: "\uAE30\uB85D\uC5D0\uC11C \uC9C4\uD589\uC774 \uBA48\uCD98 \uC0AC\uB78C\uB4E4\uC740 \uBAA8\uB450 \uCD08\uAE30\uC5D0, \uAF3C\uAF3C\uD558\uAC8C \uAD00\uCC30\uB41C \uC0AC\uB78C\uB4E4\uC774\uC5C8\uB2E4. \uC6B4\uC774 \uC544\uB2C8\uB77C \uAE30\uB85D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706384
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uC624\uB298 \uBAAB\uC740 \uB2E4 \uBD24\uC5B4. \uB098\uBA38\uC9C0\uB294 \uB0B4\uC77C\uC758 \uB124\uAC00 \uBCF4\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706385
    m_Localized: "{0}: \uC120\uC0DD\uB2D8. \uBD95\uB300 \uAC08 \uB54C, \uC774\uC81C \uB4F1 \uB3CC\uB9AC\uC9C0 \uB9C8\uC138\uC694. \uC800 \uBD10\uB3C4 \uAD1C\uCC2E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706417
    m_Localized: "\uB3C4\uD604\uC774 \uBD88 \uC55E\uC5D0\uC11C \uAFB8\uBC85\uAFB8\uBC85 \uC878\uB2E4\uAC00, \uAE5C\uC9DD \uB180\uB77C \uAE68\uC11C\uB294 \uC548 \uC7A4\uB2E4\uACE0 \uC6B0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118037
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uACF5\uBD80\uD560 \uB54C \uC5F0\uC2B5\uC7A5 \uADC0\uD241\uC774\uC5D0 \uC791\uC740 \uADF8\uB9BC\uC744 \uADF8\uB838\uB2E4. \uCD1B\uBD88, \uC9C0\uC6B0\uAC1C, \uB0B4 \uC190."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118038
    m_Localized: "\uC1A1\uC608\uC9C0: \uC678\uC6B8 \uB54C \uADF8\uB9BC\uC73C\uB85C \uADF8\uB9AC\uBA74 \uC798 \uC678\uC6CC\uC838. \u2026\uB108\uB3C4 \uD574 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591981
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B8\uC820\uAC00 \uB098\uB3C4 \uAC70\uAE30\uC11C \uD558\uB298 \uD55C\uBC88 \uBCF4\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591982
    m_Localized: "\uAEBC\uC9C0\uAE30 \uC804\uAE4C\uC9C0 \uC2E0\uD638\uB294 \uD55C \uBC88\uB3C4 \uC7A1\uD788\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uC2DC \uCF1C\uC9C0\uBA74, \uADF8\uC0AC\uC774 \uBB34\uC5C7\uC774 \uC640 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118039
    m_Localized: "\uC5ED\uC0AC \uC5F0\uD45C \uC606\uC5D0 \uC11C\uD230 \uADF8\uB9BC\uC744 \uADF8\uB838\uB2E4. \uC2E0\uAE30\uD558\uAC8C\uB3C4 \uB2E4\uC74C \uB0A0\uAE4C\uC9C0 \uAE30\uC5B5\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118040
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uC601\uC5B4 \uB2E8\uC5B4\uC7A5\uC744 \uB118\uAE30\uB2E4 \uB9D0\uACE0 \uD22D \uB358\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654327
    m_Localized: "\uBCF8\uAD00 \uCC3D\uACE0\uC5D0 \uB0A8\uAE30\uB85C \uD55C \uCCAB \uBC24. \uC120\uC0DD\uB2D8\uC774 \uCCA0\uBB38 \uC548\uCABD\uC5D0 \uC1E0\uB9C9\uB300\uB97C \uAC00\uB85C\uC9C8\uB7EC \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826517
    m_Localized: "\uB2E4 \uB4E3\uACE0 \uB098\uC11C \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC600\uB2E4. \uC608\uC9C0\uAC00 \uADF8\uC81C\uC57C \uB0B4 \uC5BC\uAD74\uC744 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146380
    m_Localized: "\uC1A1\uC608\uC9C0. \uADF8 \uC560\uB294 \uC81C \uC774\uB984\uC774 \uBD88\uB9AC\uB294 \uB3D9\uC548 \uB450 \uC190\uC744 \uAF2D \uBAA8\uC73C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146652
    m_Localized: "\uC758\uD559 \uACF5\uBD80\uB97C \uB354 \uD574\uC57C \uD55C\uB2E4. \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uC0C1\uD0DC\uB97C \uB9E4\uC77C \uC801\uC5B4\uC57C \uD55C\uB2E4. \uB2E8\uC11C\uAC00 \uC313\uC774\uBA74, \uADF8\uB54C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706386
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD55C\uCC38 \uB9D0\uC774 \uC5C6\uB2E4\uAC00, \uB2E4\uC74C \uB0A0\uBD80\uD130 \uB4F1\uC744 \uB3CC\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uC544\uD30C\uD558\uB294 \uC5BC\uAD74\uB3C4 \uADF8\uB0E5 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369192
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC15 \uC120\uC0DD\uB2D8\uB3C4\uC694. \uB2E4\uD589\uC785\uB2C8\uB2E4. \uC815\uB9D0 \uB2E4\uD589\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369191
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC724 \uC120\uC0DD\uB2D8. \uC0B4\uC544 \uACC4\uC168\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118041
    m_Localized: "\uCD5C\uD558\uB9B0: \uC774\uAC70 \uD574\uC11C \uBB50 \uD574. \u2026\uC544\uB2C8, \uADF8\uB0E5 \uD574. \uB108 \uD558\uB294 \uAC70 \uBCF4\uB2C8\uAE4C \uB098\uB3C4 \uD574\uC57C \uD560 \uAC83 \uAC19\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146759
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uB9D0\uC5C6\uC774 1\uCE35 \uBCF5\uB3C4 \uB9E8 \uC55E\uC790\uB9AC\uB85C \uAC14\uB2E4. \uC544\uBB34\uB3C4 \uC2DC\uD0A4\uC9C0 \uC54A\uC740 \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146758
    m_Localized: "\uB3C4\uD604\uC774 \uC815\uBB38 \uBC14\uB9AC\uCF00\uC774\uB4DC \uB4A4\uC5D0 \uCABC\uADF8\uB824 \uC549\uC558\uB2E4. \uC190\uC774 \uB5A8\uB9AC\uB294 \uAC8C \uBCF4\uC600\uB2E4. \uADF8\uB798\uB3C4 \uC790\uB9AC\uB97C \uB728\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146757
    m_Localized: "\uC625\uC0C1\uC758 SOS \uAE00\uC528\uB97C \uC9C0\uD0A4\uB294 \uAC83\uCC98\uB7FC, \uBAA8\uB450\uAC00 \uC815\uD574 \uB454 \uC81C\uC790\uB9AC\uB85C \uD769\uC5B4\uC84C\uB2E4. \uBA87 \uB2EC \uB3D9\uC548 \uBAB8\uC5D0 \uC775\uD78C \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146756
    m_Localized: "\uBC1C\uC18C\uB9AC\uB294 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uB208\uC774 \uC18C\uB9AC\uB97C \uB2E4 \uBA39\uC5C8\uB2E4. \uADF8\uB9BC\uC790\uB9CC \uCC9C\uCC9C\uD788, \uC904\uC744 \uC9C0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146653
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC219\uC81C\uAC00 \uB610 \uB298\uC5C8\uAD6C\uB098. \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uCC44\uC810\uBC1B\uB294 \uCABD\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118042
    m_Localized: "\uD558\uB9B0\uC740 \uB2E8\uC5B4 \uC2A4\uBB34 \uAC1C\uB97C \uC678\uC6E0\uB2E4. \uB0B4\uAC00 \uC5F4\uB2E4\uC12F \uAC1C \uC678\uC6E0\uC744 \uB54C. \uD558\uB9B0\uC740 \uC22B\uC790\uB97C \uB450 \uBC88 \uD655\uC778\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146752
    m_Localized: "\uB0A1\uC740 \uBC31\uACFC\uC0AC\uC804\uBD80\uD130 \uB123\uC5C8\uB2E4. \uC138\uC0C1\uC758 \uBAA8\uB4E0 \uAC83\uC744 \uC124\uBA85\uD558\uB358 \uCC45\uC774, \uD55C \uAD8C\uC529 \uC7AC\uAC00 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146751
    m_Localized: "\uB3C4\uC11C\uAD00\uC758 \uC624\uB798\uB41C \uCC45\uC744 \uD0DC\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118025
    m_Localized: "\uB2E4\uB9AC\uAC00 \uD6C4\uB4E4\uAC70\uB838\uB2E4. \uC720\uB791\uC790\uB294 \uB05D\uAE4C\uC9C0 \uAC19\uC740 \uC18D\uB3C4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980529
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC2ED\uC774 \uCD08. \uD559\uAD50 \uC2E0\uAE30\uB85D\uC774\uB2E4. \uCC38\uAC00\uC790\uAC00 \uD55C \uBA85\uC774\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146469
    m_Localized: "\uC5F4\uB9B0 \uBB38 \uC548\uC73C\uB85C \uCC2C \uBC14\uB78C\uC774 \uB4E4\uC5B4\uAC14\uB2E4. \uADF8 \uC548\uC5D0\uB294 \uC774\uC81C \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118024
    m_Localized: "\uC720\uB791\uC790: \uB2EC\uB9AC\uAE30\uBCF4\uB2E4 \uC774\uAC8C \uC0B0\uB2E4. \uC800\uAC83\uB4E4\uD55C\uD14C\uC11C \uB3C4\uB9DD\uCE60 \uB550 \uB298 \uACC4\uB2E8\uC774 \uC788\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118023
    m_Localized: "\uC720\uB791\uC790\uB294 \uBB34\uAC70\uC6B4 \uBC30\uB0AD \uBA54\uACE0 \uACC4\uB2E8 \uC624\uB974\uAE30\uB97C \uC2DC\uCF30\uB2E4. \uCCB4\uC721\uAD00 \uAD00\uC911\uC11D \uACC4\uB2E8, \uC624\uB974\uACE0 \uB0B4\uB9AC\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118022
    m_Localized: "\uADF8\uB798\uC11C \uC624\uB298\uC740 \uB0B4\uAC00 \uBA3C\uC800 \uC9DD\uC744 \uD558\uC790\uACE0 \uD588\uB2E4. \uC608\uC9C0\uB294 \uB300\uB2F5 \uB300\uC2E0 \uC5EC\uC12F \uAC1C\uC9F8\uB97C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118021
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uCCB4\uC721 \uC2DC\uAC04 \uC81C\uC77C \uC2EB\uC5C8\uC5B4. \uC9DD \uC9C0\uC73C\uB77C\uACE0 \uD560 \uB54C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654253
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790\uAC00 \uB098\uC640 \uC120\uBC30\uB97C \uBC88\uAC08\uC544 \uBCF4\uB2E4\uAC00, \uD53C\uC2DD \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146781
    m_Localized: "\uAD6C\uC870\uB300: \uC624\uB294 \uAE38\uC5D0 \uC778\uADFC \uC8FC\uD0DD\uAC00\uC5D0\uC11C \uC0DD\uC874\uC790 \uD55C \uBA85\uC744 \uBA3C\uC800 \uD0DC\uC6C1\uB2C8\uB2E4. \uADF8 \uC0DD\uC874\uC790\uAC00 \uC0C8\uBCBD\uACE0\uC5D0 \uC544\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uACE0 \uD558\uB354\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460222
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB355\uBD84\uC5D0 \uC6B0\uB9AC\uAC00 \uC544\uC9C1 \uC0B4\uC544 \uC788\uB294 \uAC70\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460221
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB108\uB294 \uB298 \uCD9C\uAD6C\uBD80\uD130 \uBCF4\uB354\uB77C. \uC5B4\uB290 \uBC29\uC5D0 \uB4E4\uC5B4\uAC00\uB3C4 \uC81C\uC77C \uBA3C\uC800 \uBB38, \uCC3D\uBB38, \uACC4\uB2E8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980527
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC5D0 \uAE30\uB304 \uCC44 \uC190\uBAA9\uC2DC\uACC4\uB97C \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980526
    m_Localized: "\uC228\uC774 \uCC28\uC11C \uC6C3\uC74C\uC774 \uB0AC\uB2E4. \uC18C\uB9AC\uB97C \uC8FD\uC774\uB290\uB77C \uB354 \uC6C3\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174824
    m_Localized: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uC9C0\uCF1C\uBCF4\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706378
    m_Localized: "\uBA3C\uC800 \uAC00\uB294 \uC0AC\uB78C\uC774 \uC788\uC5B4\uC57C \uBB38\uC774 \uC5F4\uB824 \uC788\uB2E4. \uADF8\uAC8C \uB0B4 \uAC78\uC74C\uC758 \uC4F8\uBAA8\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460220
    m_Localized: "\uB3CC\uC544\uBCF4\uB2C8 \uB098\uB294 \uBC8C\uC368 \uACC4\uB2E8\uCC38\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC544\uC9C1 \uBCF5\uB3C4 \uD55C\uAC00\uC6B4\uB370\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987523
    m_Localized: "\uC57D\uC7A5 \uC544\uB798 \uC11C\uB78D\uC5D0 '\uAD50\uC9C1\uC6D0 \uAC74\uAC15\uAC80\uC9C4 \uAE30\uB85D' \uD30C\uC77C\uC774 \uAF42\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654252
    m_Localized: "{0}: \uC6B0\uB9AC \uC120\uBC30\uC608\uC694. \uBCFC\uC77C \uB05D\uB0AC\uC73C\uBA74 \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706377
    m_Localized: "\uB0B4\uC77C\uB3C4 \uB9E8 \uBA3C\uC800 \uC624\uB97C \uAC83\uC774\uB2E4. \uBB38\uC744 \uC5F4\uACE0, \uBB38\uACE0\uB9AC\uB97C \uC7A1\uACE0, \uB2E4\uB4E4 \uC62C\uB77C\uC62C \uB54C\uAE4C\uC9C0 \uB193\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706376
    m_Localized: "\uD55C \uBC88 \uBA48\uCDB0 \uBCF8 \uC801\uC774 \uC788\uC5B4\uC11C, \uC774\uBC88\uC5D4 \uB35C \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706375
    m_Localized: "\uC544\uBB34\uAC83\uB3C4 \uB530\uB77C\uC624\uC9C0 \uC54A\uC558\uB2E4. \uC774 \uAE38\uC740 \uB0B4\uAC00 \uB9E4\uC77C \uB3C4\uB9DD\uCCD0 \uC628 \uAE38\uC774\uC790, \uB9E4\uC77C \uAC78\uC5B4\uC11C \uB3CC\uC544\uC628 \uAE38\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987522
    m_Localized: "\uC704 \uCE78\uC5D0\uB294 \uBD95\uB300\uC640 \uC18C\uB3C5\uC57D\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uC544\uB798 \uCE78\uB9CC \uD145 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uBC14\uB2E5\uC5D0 \uC549\uC544\uC11C \uC190\uC774 \uB2FF\uB294 \uB192\uC774\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987521
    m_Localized: "\uC57D\uC7A5 \uC720\uB9AC\uBB38\uC5D0 \uCABD\uC9C0\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. '\uD544\uC694\uD55C \uC0AC\uB78C \uAC00\uC838\uAC00\uC138\uC694. \uB2E4\uC74C \uC0AC\uB78C \uBAAB\uB3C4 \uC870\uAE08 \uB0A8\uACA8 \uC8FC\uC138\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654251
    m_Localized: "\uC120\uBC30 \uC55E\uC744 \uB9C9\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146468
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC744 \uB05D\uAE4C\uC9C0 \uC5F4\uC5B4 \uB450\uACE0, \uBA3C\uC800 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146467
    m_Localized: "\uCD5C\uD558\uB9B0: \uADF8\uAC70\uBA74 \uB3FC. \uADF8\uAC70\uBA74, \uCDA9\uBD84\uD788 \uB9CE\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654250
    m_Localized: "\uC120\uBC30\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uACE0\uAC1C\uB97C \uC219\uC774\uC9C0\uB3C4, \uB4E4\uC9C0\uB3C4 \uC54A\uC558\uB2E4. \uADF8\uC800 \uB0B4 \uC606\uC5D0\uC11C \uC9D0\uC744 \uACE0\uCCD0 \uBA68\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118020
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uB6F0\uB294 \uAC74 \uC2EB\uB2E4\uACE0 \uD588\uB2E4. \uB300\uC2E0 \uB9E4\uD2B8 \uC704\uC5D0\uC11C \uAC19\uC774 \uD314\uAD7D\uD600\uD3B4\uAE30\uB97C \uD588\uB2E4. \uC14B, \uB137, \uB2E4\uC12F."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118019
    m_Localized: "\uB0B4 \uACF5\uC740 \uBC31\uBCF4\uB4DC\uB3C4 \uBABB \uB9DE\uD614\uB2E4. \uC120\uBC30\uAC00 \uB0B4 \uD314\uAFC8\uCE58\uB97C \uC0B4\uC9DD \uBC00\uC5B4 \uAC01\uB3C4\uB97C \uACE0\uCCD0 \uC8FC\uC5C8\uB2E4. \uB2E4\uC74C \uACF5\uC740 \uB4E4\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146466
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6B8 \uAC83 \uAC19\uC740 \uC5BC\uAD74\uC774\uC5C8\uC9C0\uB9CC, \uC6B8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146465
    m_Localized: "{0}: \uC5EC\uAE30\uAE4C\uC9C0. \uBBF8\uC6CC\uD558\uC9C0\uB3C4 \uC54A\uACE0, \uAE30\uB2E4\uB9AC\uC9C0\uB3C4 \uC54A\uC744\uAC8C. \uADF8\uAC8C \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uC804\uBD80\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118018
    m_Localized: "\uC120\uBC30\uAC00 \uB358\uC9C4 \uACF5\uC774 \uACE8\uB300 \uD14C\uB450\uB9AC\uB97C \uC138 \uBC88 \uB3CC\uACE0 \uB4E4\uC5B4\uAC14\uB2E4. \uC120\uBC30\uAC00 \uB098\uB97C \uBCF4\uC558\uB2E4. \uB124 \uCC28\uB840."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118017
    m_Localized: "\uC120\uBC30\uB294 \uB18D\uAD6C\uACF5\uC744 \uD558\uB098 \uCC3E\uC544\uC654\uB2E4. \uBC14\uB78C\uC774 \uBC18\uCBE4 \uBE60\uC9C4 \uACF5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460331
    m_Localized: "\uBC29\uD559\uC774\uC5C8\uB2E4. \uBC29\uD559\uC2DD\uB3C4, \uC0DD\uD65C \uD1B5\uC9C0\uD45C\uB3C4 \uC5C6\uC5C8\uC9C0\uB9CC \uB2EC\uB825\uC740 \uBC29\uD559\uC774\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174853
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB4E4 \uC911\uC5D0 \uBA87 \uBA85\uC774 \uC9D1\uC5D0 \uAC14\uC744\uAE4C. \u2026\uADF8\uB0A0 \uC624\uD6C4\uC5D0 \uB098\uB294 \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uC560 \uB458\uC744 \uB370\uB9AC\uACE0 \uD559\uAD50\uB97C \uB098\uC130\uC5B4. \uC8FC\uD0DD\uAC00\uC5D0\uC11C \uAE38\uC774 \uB9C9\uD614\uACE0. \uAC70\uAE30\uC11C \uBA48\uCDC4\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706374
    m_Localized: "\uB3CC\uC544\uC130\uB2E4. \uD145 \uBE48 \uAE38. \uC4F0\uB7EC\uC9C4 \uC790\uC804\uAC70, \uD384\uB7ED\uC774\uB294 \uD604\uC218\uB9C9, \uAE38\uAC8C \uB204\uC6B4 \uADF8\uB9BC\uC790\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706373
    m_Localized: "\uD55C \uBC88 \uB4A4\uB97C \uB3CC\uC544\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117926
    m_Localized: "\uADF8 \uC0BC\uC0C9 \uACE0\uC591\uC774\uAC00 \uB610 \uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uC55E\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uC774\uBC88\uC5D4 \uB098\uB97C \uB611\uBC14\uB85C \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369204
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uBB3C\uB9B0 \uAC70, \uB9DE\uC8E0? \uADF8\uB7F0\uB370 \uC5F4\uB3C4 \uC5C6\uACE0, \uC99D\uC0C1\uB3C4 \uC5C6\uACE0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592008
    m_Localized: "\"\uB098 \uD559\uAD50\uC57C. \uC0B4\uC544 \uC788\uC5B4.\" \uC804\uC1A1 \uC2E4\uD328 \uD45C\uC2DC\uAC00 \uB5B4\uB2E4. \uADF8\uB798\uB3C4 \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146464
    m_Localized: "\uC5EC\uAE30\uC11C \uB05D\uB0B4\uC790\uACE0 \uD55C\uB2E4. \uAC01\uC790\uC758 \uAE38\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146463
    m_Localized: "{0}: \uADF8\uAC74 \uADF8\uB54C \uAC00\uC11C \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592007
    m_Localized: "\uBCF4\uB0B4\uC9C0\uC9C0 \uC54A\uC744 \uB2F5\uC7A5\uC744 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174888
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uC218\uC5C5\uC740 \uC11C\uC11C \uD55C\uB2E4. \uB2E4\uB4E4 \uC549\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369205
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B4\uC774 \uC88B\uC558\uB358 \uAC70\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591901
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uC774\uAC83\uB3C4. \uCCAD\uC18C\uD568\uC5D0\uC11C \uCC3E\uC558\uC5B4. \uD718\uB450\uB974\uB77C\uB294 \uAC8C \uC544\uB2C8\uC57C. \uB9C9\uB294 \uB370 \uC4F0\uB77C\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591902
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCC3D\uACE0 \uAD6C\uC11D\uC758 \uC0C1\uC790\uB97C \uC5F4\uC5C8\uB2E4. \uCEF5\uB77C\uBA74\uACFC \uC0DD\uC218\uAC00 \uBE7D\uBE7D\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826576
    m_Localized: "{0}: \uD5C9\u2026 \uD5C9\u2026 \uB108 \uC65C \uC774\uB807\uAC8C \uBE68\uB9AC \uAC78\uC5B4. \uBC84\uC2A4 \uB193\uCE5C \uC904 \uC54C\uC558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146643
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uAC70\uB4E0, \uD329\uB9CC \uBCF4\uC9C0 \uB9D0\uACE0 \uB098\uC624\uB294 \uAE38\uBD80\uD130 \uBD10\uB77C. \uAF2D \uB3CC\uC544\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146642
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD63C\uB098\uC2E4 \uC77C \uB9DE\uC544\uC694. \uB2E4 \uB05D\uB098\uBA74 \uD55C \uBA85\uB3C4 \uBE60\uC9D0\uC5C6\uC774 \uAC80\uC0AC\uD560 \uAC70\uC608\uC694. \uC800\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117924
    m_Localized: "\uACE0\uC591\uC774\uB294 \uAF2C\uB9AC \uB05D\uB9CC \uBA87 \uBC88 \uAE4C\uB531\uC774\uB2E4\uAC00 \uC5B4\uB460 \uC18D\uC73C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460308
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uC5D0\uAC8C \uD55C\uB9C8\uB514 \uD560 \uC218 \uC788\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146462
    m_Localized: "\uCD5C\uD558\uB9B0: \uAC19\uC740 \uBC18\uC774\uBA74\u2026 \uB124 \uC606\uC790\uB9AC\uB294 \uB0B4\uAC00 \uB9E1\uB294\uB2E4. \uBA3C\uC800 \uB9D0\uD574 \uB454\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146461
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uCC98\uC74C\uC73C\uB85C \uC6C3\uC5C8\uB2E4. \uC791\uACE0, \uC11C\uD230 \uC6C3\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591903
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC8FC\uC77C \uB3D9\uC548 \uBAA8\uC544 \uB454 \uAC70\uC57C. \uB2F9\uBD84\uAC04\uC740 \uC774\uAC78\uB85C \uBC84\uD2F0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591904
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uC77C\uBD80\uD130 \uC815\uD558\uC790. \uACF5\uBD80\uD560 \uAC83, \uACE0\uCE60 \uAC83, \uAC00\uC838\uC62C \uAC83. \uD558\uB8E8\uD558\uB8E8."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460307
    m_Localized: "\uAD6C\uC870\uB300\uAC00 \uBA3C\uC800 \uD0DC\uC6B4\uB2E4\uB294 \uC0DD\uC874\uC790. \uC774\uB984\uC740 \uC544\uC9C1 \uBAA8\uB978\uB2E4. \uADF8\uB798\uB3C4 \uC790\uAFB8 \uADF8 \uC5BC\uAD74\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460306
    m_Localized: "\uC815\uB958\uC7A5\uC758 \uB04A\uC5B4\uC9C4 \uAC00\uBC29\uB048. \uADF8 \uB4A4\uB85C \uADF8 \uC560\uC5D0\uAC8C \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC774 \uD558\uB098\uC529 \uB298\uC5C8\uB2E4. \uC77C\uAE30\uC7A5 \uB4A4\uCABD\uC774 \uB2E4 \uADF8 \uB9D0\uB4E4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146641
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB54C \uAC80\uC0AC\uB77C\uB3C4 \uBC1B\uC544 \uB458 \uAC78 \uADF8\uB7AC\uAD6C\uB098. \uBCF4\uAC74 \uC120\uC0DD\uB2D8\uD55C\uD14C \uD63C\uB0A0 \uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826533
    m_Localized: "\uBB38\uC190\uC7A1\uC774\uB97C \uB193\uB294 \uC190\uC774 \uB5A8\uB838\uB2E4. \uC9C0\uAE08\uC740 \uC544\uB2C8\uB2E4. \uC544\uC9C1\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460305
    m_Localized: "{0} \uD55C\uCC38 \uB9D0\uC774 \uC5C6\uB2E4\uAC00, \uC65C \uC774\uC81C \uB9D0\uD558\uB0D0\uACE0 \uD588\uB2E4. \uBC14\uBCF4\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460304
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uC800\uAE30\uC11C, \uB098\uB294 \uCC98\uC74C\uC73C\uB85C {0}\uC5D0\uAC8C \uD138\uC5B4\uB193\uC558\uB2E4. \uC9E7\uAC8C, \uC544\uC8FC \uC870\uAE08\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174815
    m_Localized: "\uBAB8\uC744 \uB0AE\uCD94\uACE0 \uACE8\uBAA9\uC73C\uB85C \uB3CC\uC544\uC11C \uC654\uB2E4. \uAD50\uBB38 \uC606 \uB2F4\uC7A5\uC5D0\uB3C4 \uAC19\uC740 \uD45C\uC2DC\uAC00 \uC788\uC5C8\uB2E4. \uC624\uB298 \uC544\uCE68\uC5D4 \uC5C6\uB358 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980506
    m_Localized: "\uCC3D\uBC16\uC740 \uC2DC\uD5D8 \uB0A0\uCC98\uB7FC \uC870\uC6A9\uD588\uB2E4. \uADF8\uAC74 \uC608\uC804\uC5D0\uB3C4 \uADF8\uB7AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591905
    m_Localized: "{0}: \uACF5\uBD80\uC694? \uC9C0\uAE08 \uAC19\uC740 \uB54C\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980507
    m_Localized: "\uC791\uB144 \uC774\uB0A0 \uAD50\uC2E4 \uCE60\uD310\uC740 \uB099\uC11C\uC640 \uD48D\uC120\uC73C\uB85C \uAC00\uB4DD\uD588\uB2E4. \uC62C\uD574 \uCE60\uD310\uC5D0\uB294 \uBB3C \uBC1B\uB294 \uC21C\uC11C\uAC00 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729278
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uD39C\uB77C\uC774\uD2B8\uB97C \uB0B4 \uC190\uBC14\uB2E5\uC5D0 \uAF2D \uC950\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729277
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC774\uAC70 \uB108 \uD574. \uADF8\uB9AC\uACE0 \uD558\uB098\uB9CC \uC57D\uC18D\uD574. \uC57D\uC740 \uC544\uAEF4. \uADFC\uB370 \uC0AC\uB78C\uD55C\uD14C\uB294 \uC544\uB07C\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729276
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAC04\uD638\uD559\uACFC \uCCAB\uD574\uC5D0 \uC0B0 \uAC70\uC57C. \uB3D9\uACF5 \uBCF4\uACE0, \uBAA9 \uC548 \uBCF4\uACE0, \uC815\uC804\uB41C \uBCF5\uB3C4\uC5D0\uC11C \uAE38\uB3C4 \uBCF4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729275
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC0AC\uC9C4\uC744 \uB2E4\uC2DC \uB123\uACE0, \uAC00\uC6B4 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC791\uC740 \uD39C\uB77C\uC774\uD2B8\uB97C \uAEBC\uB0C8\uB2E4. \uC740\uC0C9 \uCE60\uC774 \uB2E4 \uBC97\uACA8\uC9C4 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146460
    m_Localized: "{0}: \uB2E4\uC2DC \uB9CC\uB098. \uADF8\uB54C\uB294 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uD558\uC790. \uAC19\uC740 \uBC18 \uC560\uB4E4\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146459
    m_Localized: "\uC5B8\uC820\uAC00 \uB2E4\uC2DC \uB9CC\uB098\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118016
    m_Localized: "\uC120\uC0DD\uB2D8\uB3C4 \uAC19\uC774 \uB530\uB77C \uD588\uB2E4. \uD5C8\uB9AC\uB97C \uD3B4\uB2E4 \"\uC544\uC774\uACE0\" \uC18C\uB9AC\uB97C \uB0C8\uB2E4. \uB458\uC774 \uAC19\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729274
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC0B4\uC544 \uC788\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD574. \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uAE30\uB85C \uD588\uC5B4. \uAC54\uB294 \uB098\uBCF4\uB2E4 \uCE68\uCC29\uD558\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729273
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC \uB538. \uB108\uBCF4\uB2E4 \uB450 \uC0B4 \uB9CE\uC544. \uADF8\uB0A0\uC740 \uAE30\uC219\uC0AC\uC5D0 \uC788\uC5C8\uC5B4. \uB2E4\uB978 \uB3C4\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729272
    m_Localized: "\uBC24\uB2A6\uAC8C \uBCF4\uAC74\uC2E4 \uCE68\uB300 \uB05D\uC5D0 \uB098\uB780\uD788 \uC549\uC558\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC9C0\uAC11\uC5D0\uC11C \uC0AC\uC9C4 \uD55C \uC7A5\uC744 \uAEBC\uB0C8\uB2E4. \uB9CE\uC774 \uB9CC\uC838\uC11C \uBAA8\uC11C\uB9AC\uAC00 \uD558\uC597\uAC8C \uC77C\uC5B4\uB09C \uC0AC\uC9C4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706450
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB530\uB73B\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706451
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE09\uC2DD\uC2E4 \uC544\uC8FC\uBA38\uB2C8\uB4E4 \uC0DD\uAC01\uB09C\uB2E4. \uBE44 \uC624\uB294 \uB0A0\uC5D4 \uAF2D \uAD6D\uC744 \uD55C \uBC88 \uB354 \uB370\uC6CC \uC8FC\uC168\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118015
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB2E4\uCE58\uBA74 \uB0B4 \uC77C\uC774 \uB298\uC5B4. \uADF8\uB7EC\uB2C8\uAE4C \uCC9C\uCC9C\uD788. \uC6B4\uB3D9\uC740 \uB2E4\uCE58\uB824\uACE0 \uD558\uB294 \uAC8C \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118014
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC2A4\uD2B8\uB808\uCE6D\uBD80\uD130 \uC2DC\uCF30\uB2E4. \uD5C8\uB9AC, \uC5B4\uAE68, \uBB34\uB98E. \uC544\uD508 \uB370\uAC00 \uC788\uC73C\uBA74 \uBC14\uB85C \uB9D0\uD558\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729271
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBC18\uB9CC\uC774\uC57C. \uB098\uBA38\uC9C0 \uBC18\uC740 \uB0B4 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729270
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD55C\uCC38 \uBD95\uB300\uB97C \uB9CC\uC9C0\uB2E4\uAC00, \uC11C\uB78D\uC5D0\uC11C \uACF5\uCC45 \uD55C \uAD8C\uC744 \uAEBC\uB0B4 \uB0B4 \uC55E\uC5D0 \uB193\uC558\uB2E4. \uC57D \uC774\uB984\uACFC \uB0A8\uC740 \uAC1C\uC218, \uADF8\uB9AC\uACE0 \uB0A0\uC9DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729269
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB7F0 \uAC78 \uD559\uC0DD\uD55C\uD14C \uB118\uAE30\uBA74 \uC548 \uB418\uB294 \uAC74\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729268
    m_Localized: "{0}: \uADF8 \uC22B\uC790, \uC800\uD55C\uD14C\uB3C4 \uC54C\uB824 \uC8FC\uC138\uC694. \uB458\uC774 \uC138\uBA74 \uBC18\uC529\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729267
    m_Localized: "\uADF8 \uACC4\uC0B0\uC744 \uAC19\uC774 \uD558\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118013
    m_Localized: "\uCE6D\uCC2C\uC778\uC9C0 \uC544\uB2CC\uC9C0 \uBAB0\uB790\uB2E4. \uD558\uB9B0 \uCABD\uC5D0\uC11C \uC6C3\uC74C \uBE44\uC2B7\uD55C \uC228\uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654249
    m_Localized: "\uC77C\uC9C4. \uADF8 \uB9D0\uC774 \uB098\uC624\uAE30\uB3C4 \uC804\uC5D0 \uC54C\uC544\uB4E4\uC5C8\uB2E4. \uB4F1\uC774 \uBA3C\uC800 \uAD73\uC5C8\uB2E4. \uCCB4\uC721\uCC3D\uACE0\uC758 \uBB38\uC774 \uC7A0\uAE50 \uB208\uC55E\uC744 \uC9C0\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654248
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790: \uC0AC\uAC70\uB9AC \uD615\uB4E4\uB3C4 \uB108\uB294 \uC548 \uAC74\uB4DC\uB838\uC796\uC544. \uB208 \uD55C \uBC88 \uB3CC\uB9AC\uBA74 \uC560\uB4E4\uC774 \uC54C\uC544\uC11C \uC904 \uC11C\uB358 \uB188\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654247
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790: \uC640. \uC9C4\uC9DC \uB108\uAD6C\uB098. \uC0C8\uBCBD\uACE0\uC5D0\uC11C \uC81C\uC77C \uC798\uB098\uAC00\uB358 \uB188\uC774, \uC560\uB4E4 \uC9D0\uC774\uB098 \uB4E4\uACE0 \uB2E4\uB2C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729266
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC774\uC0C1\uD558\uB2E4. \uC624\uB298\uC740 \uC22B\uC790\uAC00 \uC548 \uBCF4\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729265
    m_Localized: "\uB0C4\uBE44 \uBB3C\uC774 \uB2E4 \uC878 \uB54C\uAE4C\uC9C0 \uB864\uC774 \uC5F4\uB450 \uAC1C \uC313\uC600\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uCC98\uC74C\uC73C\uB85C \uD558\uD488\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117923
    m_Localized: "\uADF8\uB0E5 \uC9C0\uCF1C\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117922
    m_Localized: "{0}: \u2026\uADF8\uB798. \uB108\uB294 \uADF8\uB0A0\uB3C4 \uADF8\uB7AC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117921
    m_Localized: "\uB2E4 \uBA39\uACE0 \uB098\uC11C\uB3C4 \uACE0\uB9D9\uB2E4\uB294 \uAE30\uC0C9\uC740 \uC5C6\uC5C8\uB2E4. \uC55E\uBC1C\uB85C \uC5BC\uAD74\uC744 \uB2E6\uACE0\uB294 \uB2F4\uC7A5 \uB108\uBA38\uB85C \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654246
    m_Localized: "\uC120\uBC30\uAC00 \uADF8 \uB0A8\uC790\uB97C \uBCF4\uC558\uB2E4. \uC544\uBB34 \uD45C\uC815 \uC5C6\uC774, \uADF8\uC800 \uB611\uBC14\uB85C. \uB0A8\uC790\uAC00 \uD558\uB358 \uB9D0\uC744 \uC0BC\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591906
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uAE08 \uAC19\uC740 \uB54C\uB2C8\uAE4C. \uB098\uB294 \uC120\uC0DD\uC774\uACE0, \uB108\uB294 \uD559\uC0DD\uC774\uC796\uC544. \uADF8\uAC70\uB77C\uB3C4 \uBD99\uC7A1\uACE0 \uC788\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117830
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4 \uACE0\uB4F1\uD559\uAD50 2\uD559\uB144 \uB54C \uACF5\uCC45\uC774\uC57C. \uAD50\uBB34\uC2E4 \uB0B4 \uC0AC\uBB3C\uD568\uC5D0 \uB123\uC5B4 \uB480\uC5C8\uB294\uB370, \uC544\uC9C1 \uC788\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987520
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC904\uC5D0\uB294 '\uB450\uD1B5, \uC5F4 \u2014 \uC870\uD1F4'. \uADF8 \uC704 \uC904\uC5D0\uB3C4, \uB610 \uADF8 \uC704 \uC904\uC5D0\uB3C4 \uAC19\uC740 \uB9D0\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980508
    m_Localized: "\uC885\uC774\uB85C \uCE74\uB124\uC774\uC158\uC744 \uC811\uC5B4 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729264
    m_Localized: "\uB9D0\uC5C6\uC774 \uC606\uC5D0 \uC549\uC544 \uBD95\uB300 \uB05D\uC744 \uC7A1\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uD55C \uBC88 \uAC10\uB294 \uB3D9\uC548 \uB098\uB3C4 \uD55C \uBC88 \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729263
    m_Localized: "\uC606\uC5D0 \uC549\uC544 \uAC19\uC774 \uBD95\uB300\uB97C \uB9CC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174928
    m_Localized: "\uB204\uAD70\uAC00 \uC0C1\uC790\uC758 \uD1B5\uC870\uB9BC \uC218\uB97C \uB2E4\uC2DC \uC138\uACE0 \uC788\uC5C8\uB2E4. \uD558\uB098\uAC00 \uBAA8\uC790\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174915
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8 \uC606\uC5D0\uC11C \uAC19\uC774 \uBC24\uC744 \uC0C8\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729262
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB34\uC11C\uC6B4 \uAC74 \uC57D\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uB0A0\uC774 \uC544\uB2C8\uC57C. \uADF8\uB0A0 \uB0B4\uAC00 \uB204\uAD6C\uD55C\uD14C '\uBBF8\uC548\uD574'\uB77C\uACE0 \uD574\uC57C \uD558\uB294\uC9C0 \uC544\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729261
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC190\uC744 \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uB9D0\uD588\uB2E4. \uC5BC\uAD74 \uB300\uC2E0 \uC190\uC744 \uBCF4\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729260
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC694\uC998\uC740 \uBC24\uC5D0 \uADF8\uAC8C \uACC4\uC0B0\uC774 \uB3FC. \uC774 \uB864\uB85C \uBA87 \uBC88, \uB0A8\uC740 \uC18C\uB3C5\uC57D\uC73C\uB85C \uBA70\uCE60. \uB208 \uAC10\uC73C\uBA74 \uC22B\uC790\uAC00 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729259
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBCD1\uC6D0\uC5D0\uC120 \uD55C \uBC88 \uC4F0\uACE0 \uBC84\uB838\uC5B4. \uC544\uAE5D\uB2E4\uB294 \uC0DD\uAC01\uC744 \uD55C \uBC88\uB3C4 \uC548 \uD588\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729258
    m_Localized: "\uBC84\uB108 \uC704 \uB0C4\uBE44\uC5D0\uC11C \uBB3C\uC774 \uB053\uC5C8\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC740 \uB2E4 \uB9C8\uB978 \uBD95\uB300\uB97C \uD558\uB098\uC529 \uAC77\uC5B4 \uB3CC\uB3CC \uB9D0\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592006
    m_Localized: "\uADF8 \uB4A4\uB85C\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654245
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790: \u2026\uC57C. \uB108 \uC0C8\uBCBD\uACE0 \uADF8\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118012
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uB108 \uC0DD\uAC01\uBCF4\uB2E4 \uC548 \uB290\uB9AC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729257
    m_Localized: "\uBCF4\uAC74\uC2E4 \uCC9C\uC7A5\uC5D0 \uBE68\uB7AB\uC904\uC774 \uAC78\uB824 \uC788\uC5C8\uB2E4. \uC0B6\uC544\uC11C \uB9D0\uB9B0 \uBD95\uB300\uAC00 \uC904\uB9C8\uB2E4 \uD558\uC597\uAC8C \uB298\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146377
    m_Localized: "\uC6B0\uB9AC \uBAA8\uB450\uC758 \uC774\uB984\uC744 \uD558\uB098\uC529 \uBD88\uB7EC \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987519
    m_Localized: "\uCE68\uB300 \uC2DC\uD2B8\uB294 \uBC18\uB4EF\uD558\uAC8C \uC811\uD600 \uC788\uC5C8\uACE0, \uCC45\uC0C1 \uC704 \uCD9C\uC785 \uBA85\uBD80\uB294 3\uC6D4 \uB458\uC9F8 \uC8FC\uC5D0\uC11C \uBA48\uCDB0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729256
    m_Localized: "\uD1A1, \uD1A1. \uC870\uAE08 \uBE68\uB790\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBAA8\uB978 \uCC99\uD588\uACE0, \uB098\uB3C4 \uBAA8\uB978 \uCC99\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729255
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB7FC \uC624\uB298\uC740 \uB124\uAC00 \uC7AC. \uC5B4\uB514 \uBCF4\uC790, \uB0B4\uAC00 \uC815\uC0C1\uC778\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118011
    m_Localized: "\uB2E4\uC12F \uBC14\uD034\uC9F8\uC5D0 \uD558\uB9B0\uC774 \uC18D\uB3C4\uB97C \uC62C\uB838\uB2E4. \uC9C0\uAE30 \uC2EB\uC5B4\uC11C \uB098\uB3C4 \uC62C\uB838\uB2E4. \uC5F4 \uBC14\uD034\uC9F8\uC5D4 \uB458 \uB2E4 \uB9E4\uD2B8 \uC704\uC5D0 \uB300\uC790\uB85C \uB204\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118010
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uB9D0\uC5C6\uC774 \uCCB4\uC721\uAD00\uC744 \uB3CC\uC558\uB2E4. \uD55C \uBC14\uD034, \uB450 \uBC14\uD034. \uB098\uB3C4 \uC606\uC5D0\uC11C \uB6F0\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118009
    m_Localized: "\uC544\uD754\uC5EC\uB35F\uC5D0\uC11C \uAC78\uB838\uB2E4. \uB3C4\uD604\uC740 \"\uC544\uAE5D\uB2E4\"\uBA70 \uC124\uAC70\uC9C0\uB97C \uC790\uAE30\uAC00 \uD558\uACA0\uB2E4\uACE0 \uD588\uB2E4. \uCC98\uC74C\uBD80\uD130 \uADF8\uB7F4 \uC0DD\uAC01\uC774\uC5C8\uB358 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118008
    m_Localized: "\uB3C4\uD604: \uB204\uB098 \uBC31 \uAC1C \uB118\uC73C\uBA74 \uC81C\uAC00 \uB0B4\uC77C \uC124\uAC70\uC9C0 \uD560\uAC8C\uC694. \uBABB \uB118\uC73C\uBA74 \uB204\uB098\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729254
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4\uAC00, \uC190\uBAA9\uC744 \uB0B4 \uCABD\uC73C\uB85C \uB0B4\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729253
    m_Localized: "{0}: \uADF8\uB7FC \uC120\uC0DD\uB2D8 \uAC74\uC694? \uC120\uC0DD\uB2D8 \uB9E5\uBC15\uC740 \uB204\uAC00 \uC7AC\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987518
    m_Localized: "\uAD50\uC2E4\uB3D9 2\uCE35 \uBCF4\uAC74\uC2E4. \uCE68\uB300 \uB450 \uAC1C, \uC57D\uC7A5 \uD558\uB098. \uB180\uB784 \uB9CC\uD07C \uC815\uB3C8\uB418\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460219
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBCBD\uC744 \uC9DA\uACE0 \uBAB8\uC744 \uB04C\uC5C8\uB2E4. \uD55C \uCE78, \uC26C\uACE0, \uB610 \uD55C \uCE78."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117920
    m_Localized: "\uBA40\uCC0D\uC774 \uBB3C\uB7EC\uB098 \uC788\uC790, \uACE0\uC591\uC774\uAC00 \uD55C\uCC38 \uB0C4\uC0C8\uB97C \uB9E1\uB2E4\uAC00 \uBA39\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146458
    m_Localized: "\uCD5C\uD558\uB9B0: \uB098\uB294\u2026 \uB2E4\uC2DC \uB9CC\uB098\uC790\uB294 \uB9D0\uC744 \uD560 \uC790\uACA9\uC774 \uC5C6\uC5B4. \uADF8\uB7EC\uB2C8\uAE4C \uB124\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146457
    m_Localized: "\uCD5C\uD558\uB9B0: \uADF8\uB0A0 \uC77C, \uBBF8\uC548\uD558\uB2E4\uB294 \uB9D0\uB85C \uB05D\uB098\uB294 \uAC70 \uC544\uB2C8\uB77C\uB294 \uAC70 \uC54C\uC544. \uADF8\uB798\uC11C \uD55C \uBC88\uB3C4 \uC81C\uB300\uB85C \uBABB \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118007
    m_Localized: "\uB3C4\uD604\uC774 \uC904\uB118\uAE30\uB97C \uB4E4\uACE0 \uC654\uB2E4. \uC904\uC774 \uBC14\uB2E5\uC744 \uCE60 \uB54C\uB9C8\uB2E4 \uD0C1, \uD0C1, \uCCB4\uC721\uAD00\uC774 \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729252
    m_Localized: "\uC120\uC0DD\uB2D8 \uB9E5\uBC15\uC740 \uB204\uAC00 \uC7AC\uB0D0\uACE0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729251
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC88B\uC544. \uB0B4\uC77C\uBD80\uD130 \uC544\uCE68 \uD55C \uC904\uC740 \uB124 \uAE00\uC528\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729250
    m_Localized: "\uCCB4\uC628\uACC4 \uC77D\uB294 \uBC95, \uC5F4\uC774 \uC788\uC744 \uB54C \uC774\uB9C8\uBCF4\uB2E4 \uBAA9\uB35C\uBBF8\uB97C \uBA3C\uC800 \uBCF4\uB294 \uC774\uC720. \uC120\uC0DD\uB2D8\uC740 \uAC19\uC740 \uAC78 \uB450 \uBC88 \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uB0B4\uAC00 \uD2C0\uB9AC\uBA74 \uB05D\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729249
    m_Localized: "\uD558\uB098\uC529 \uBC30\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729248
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uBABB \uC77C\uC5B4\uB098\uB294 \uB0A0\uC774 \uC62C \uC218\uB3C4 \uC788\uC796\uC544. \uADF8\uB0A0\uC740 \uB124\uAC00 \uC774 \uD45C\uB97C \uCC44\uC6B0\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118006
    m_Localized: "\uC721\uC0C1\uBD80 \uB54C\uCC98\uB7FC \uC2A4\uD2B8\uB808\uCE6D\uBD80\uD130 \uD588\uB2E4. \uBAB8\uC774 \uC544\uC9C1 \uC21C\uC11C\uB97C \uAE30\uC5B5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118005
    m_Localized: "\uCCB4\uC721\uAD00 \uBC14\uB2E5\uC5D0 \uB9E4\uD2B8\uB97C \uAE54\uACE0, \uBB38\uC740 \uB2E8\uB2E8\uD788 \uC7A0\uAC14\uB2E4. \uB540\uC744 \uD758\uB9AC\uBA74 \uC7A0\uC774 \uC798 \uC628\uB2E4. \uBAB8\uC774 \uADF8\uAC78 \uAE30\uC5B5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729247
    m_Localized: "\uCC45\uC0C1 \uC704 \uD310\uC790\uC5D0 \uC190\uC73C\uB85C \uC904 \uCE5C \uD45C\uAC00 \uC788\uC5C8\uB2E4. \uC774\uB984\uB9C8\uB2E4 \uB0A0\uC9DC, \uCCB4\uC628, \uB9E5\uBC15. \uC9C0\uC6B0\uAC1C \uC790\uAD6D\uC774 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729246
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: 15\uCD08 \uB3D9\uC548 \uC138\uACE0 \uB124 \uBC30. \uC22B\uC790\uBCF4\uB2E4 \uC911\uC694\uD55C \uAC74 \uC5B4\uC81C\uB791 \uB2E4\uB978\uAC00\uC57C. \uBE60\uB978\uC9C0, \uC57D\uD55C\uC9C0, \uB4E4\uCB49\uB0A0\uCB49\uD55C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460218
    m_Localized: "\uBAA9\uBC1C \uB05D\uC774 \uBC14\uB2E5\uC744 \uC9DA\uB294 \uC18C\uB9AC. \uD55C \uBC88, \uC26C\uACE0, \uB610 \uD55C \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117829
    m_Localized: "\uCC45\uC0C1 \uC704\uC5D0 \uC544\uC8FC \uB0A1\uC740 \uACF5\uCC45\uC774 \uC788\uC5C8\uB2E4. \uD45C\uC9C0\uAC00 \uB204\uB807\uAC8C \uBC14\uB798\uACE0, \uBAA8\uC11C\uB9AC\uAC00 \uB465\uAE00\uAC8C \uB2F3\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729245
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC190\uAC00\uB77D\uC744 \uC790\uAE30 \uC190\uBAA9 \uC548\uCABD\uC5D0 \uAC16\uB2E4 \uB314\uB2E4. \uCC98\uC74C\uC5D4 \uC544\uBB34\uAC83\uB3C4 \uB290\uAEF4\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB7EC\uB2E4, \uD1A1. \uD1A1."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654244
    m_Localized: "\uADF8 \uB0A8\uC790\uC758 \uB208\uC774 \uC120\uBC30\uC5D0\uAC8C\uC11C \uBA48\uCDC4\uB2E4. \uD749\uD130\uC5D0\uC11C. \uADF8\uB9AC\uACE0 \uADF8 \uC704\uC758 \uB208\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146456
    m_Localized: "\uCD5C\uD558\uB9B0: \uAD6C\uC870\uB418\uBA74 \uB2E4\uB4E4 \uD769\uC5B4\uC9C0\uACA0\uC9C0. \uB108\uB791 \uB098\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460282
    m_Localized: "{0}: \uC120\uC0DD\uB2D8. \uB530\uB85C \uB5BC\uC5B4 \uB450\uC2DC\uB294 \uAC70, \uB204\uAD6C \uBAAB\uC774\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654243
    m_Localized: "\uC0AC\uAC70\uB9AC \uD1B5\uD589\uB85C\uB97C \uC9C0\uB098 \uB3CC\uC544\uC624\uB294 \uAE38\uC774\uC5C8\uB2E4. \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uB0A8\uC790 \uD558\uB098\uAC00 \uC6B0\uB9AC\uB97C \uB9C9\uC544 \uC138\uC6E0\uB2E4. \uB298 \uBCF4\uB358 \uD1B5\uD589\uC138 \uAC77\uB294 \uC5BC\uAD74\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826525
    m_Localized: "\uB3C4\uD604: \uC774\uAC74 \uB204\uB098 \uAC00\uC838\uC694. \uB9DD \uBCFC \uB54C \uC368\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563801
    m_Localized: "{0}: \uC0AC\uACFC\uD574 \uB2EC\uB77C\uB294 \uAC70 \uC544\uB2C8\uC57C. \uB124\uAC00 \uC54C\uC558\uC73C\uBA74 \uD574\uC11C. \uADF8\uAC8C \uBB34\uC2A8 \uC77C\uC774\uC5C8\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563800
    m_Localized: "{0}: \uC7A5\uB09C \uC544\uB2C8\uC5C8\uC5B4. \uB098\uB294 \uC5FF\uC0C8 \uB3D9\uC548 \uADF8 \uC548\uC5D0 \uC788\uC5C8\uC5B4. \uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uAE08\uC744 \uADF8\uC73C\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563799
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uCC98\uB7FC \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uACE0, \uD558\uACE0 \uC2F6\uB358 \uB9D0\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729244
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC774\uB9AC \uC640 \uBD10. \uC190\uAC00\uB77D \uB450 \uAC1C. \uC5C4\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729243
    m_Localized: "\uC544\uCE68 \uD68C\uC9C4\uC774\uB77C\uACE0, \uBC15 \uC120\uC0DD\uB2D8\uC740 \uADF8\uB807\uAC8C \uBD88\uB800\uB2E4. \uCE68\uB300 \uBA87 \uAC1C\uC640 \uC0AC\uB78C \uBA87 \uBA85\uBFD0\uC778\uB370\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729242
    m_Localized: "\uC5BC\uAD74\uB3C4 \uBAA8\uB974\uB294 \uC0AC\uB78C\uB4E4\uC774\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uADF8 \uBC24\uC5D4, \uAC19\uC740 \uBC18 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729241
    m_Localized: "\uAC15 \uAC74\uB108 \uC544\uD30C\uD2B8 13\uCE35\uC758 \uD560\uBA38\uB2C8. \uC9C0\uD558 \uC8FC\uCC28\uC7A5\uC5D0\uC11C \uC9C0\uB0B8\uB2E4\uB294 \uD615\uC81C. \uC774\uB984 \uB300\uC2E0 \uC228\uC18C\uB9AC\uB9CC \uBCF4\uB0B8 \uB204\uAD70\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146640
    m_Localized: "\uC57D\uAD6D 2\uCE35 \uC758\uC6D0 \uCC98\uCE58\uC2E4\uC758 \uBCF4\uB0C9 \uC0C1\uC790. \uAC70\uAE30 \uB0A8\uC740 \uD608\uC561 \uD329\uC774\uB77C\uBA74, \uAC89\uC5D0 \uD608\uC561\uD615\uC774 \uC801\uD600 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786270
    m_Localized: "\uB05D\uB098\uBA74 \uAC19\uC774 \uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729240
    m_Localized: "\uB0AF\uC120 \uBAA9\uC18C\uB9AC\uB4E4\uC774 \uCC28\uB840\uB85C \uC778\uC0AC\uB97C \uD588\uB2E4. \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729239
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC758 \uC778\uC0AC\uB97C \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729238
    m_Localized: "DJ: \uADF8 \uAE00\uC528, \uAD6C\uC870\uB300\uB3C4 \uBCFC \uAC70\uC608\uC694. \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729237
    m_Localized: "{0}: \uC0C8\uBCBD\uACE0\uC608\uC694. \uCC3D\uBC16\uC5D0\u2026 \uC625\uC0C1\uC5D0 \uCE60\uD55C \uBE68\uAC04 \uAE00\uC528\uAC00 \uBCF4\uC5EC\uC694. \uB208 \uC704\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729236
    m_Localized: "DJ: \uADF8 \uB9D0\uC774 \uC81C\uC77C \uC88B\uC740 \uC778\uC0AC\uC608\uC694. \uB0B4\uC77C\uB3C4 \uADF8 \uB9D0 \uB4E4\uB824\uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729235
    m_Localized: "{0}: \uC0C8\uBCBD\uACE0\uC608\uC694. \uC624\uB298\uB3C4 \uB2E4 \uC0B4\uC544 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460281
    m_Localized: "\uB3C4\uD604\uC774 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uB0A0 \uCC98\uC74C\uC73C\uB85C, \uCC3D\uBC16\uC744 \uBCF4\uC9C0 \uC54A\uACE0 \uBC25\uC744 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174826
    m_Localized: "\uD1B5\uC870\uB9BC \uB124 \uAC1C\uB97C \uB2F4\uC7A5 \uC704\uC5D0 \uC62C\uB824\uB193\uC558\uB2E4. \uB0A8\uC790\uAC00 \uD558\uB098\uC529 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC73C\uBA70 \uD718\uD30C\uB78C\uC744 \uBD88\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729234
    m_Localized: "DJ: \uC0C8\uBCBD\uACE0! \uAF2D \uB9CC\uB098\uC694. 3\uC6D4\uC5D0, \uC625\uC0C1\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729233
    m_Localized: "{0}: \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC608\uC694. \uB2E4\uB4E4 3\uC6D4\uC5D0 \uAF2D \uB9CC\uB098\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757806
    m_Localized: "DJ: \u2026\uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C \uC18C\uC2DD\uC774\uC5D0\uC694. \uC9C0\uB09C\uB2EC\uC5D0 \uBB34\uB9AC\uC5D0\uAC8C \uB6AB\uB838\uACE0, \uC0DD\uC874\uC790\uB4E4\uC740 \uB0A8\uCABD\uC73C\uB85C \uC774\uB3D9\uD588\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757805
    m_Localized: "\uC794\uC18C\uB9AC\uAC00 \uADF8\uB807\uAC8C \uBC18\uAC00\uC6B4 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729232
    m_Localized: "\uBB34\uC804\uC73C\uB85C \uC778\uC0AC\uB97C \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706418
    m_Localized: "\uB098\uC911\uC5D0 \uBB34\uC5C7\uC774 \uB418\uACE0 \uC2F6\uC740\uC9C0 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923618
    m_Localized: "\uAD50\uBB34\uC2E4 \uC0AC\uBB3C\uD568 \uB9E8 \uC544\uB798\uC5D0\uC11C \uB179\uC2A8 \uC904 \uD558\uB098\uB97C \uCC3E\uC544\uC654\uB2E4. \uC120\uBC30\uB294 \uADF8\uAC83\uC744 \uBD88\uBE5B\uC5D0 \uBE44\uCDB0 \uBCF4\uACE0, \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757745
    m_Localized: "\uAE30\uCE68\uC744 \uCC38\uC73C\uBA70 \uC120\uC0DD\uB2D8\uC774 \uC758\uC871\uC5D0 \uCCB4\uC911\uC744 \uC2E3\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923619
    m_Localized: "\uADF8 \uB044\uB355\uC784\uC740 \uB2E4\uB978 \uB54C\uBCF4\uB2E4 \uC870\uAE08 \uB354 \uAE4A\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340799
    m_Localized: "\uC77C\uAE30\uB294 \uB098\uB9CC \uBCF4\uB294 \uAC70\uB77C\uACE0 \uC6C3\uC73C\uBA70 \uAC70\uC808\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340800
    m_Localized: "{0}: \uC77C\uAE30\uB294 \uB098\uB9CC \uBCF4\uB294 \uAC70\uC608\uC694. \uC120\uC0DD\uB2D8\uC774 \uADF8\uB7EC\uC168\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340801
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uB9DE\uB2E4. \uC77C\uAE30\uB294 \uADF8\uB798\uC57C\uC9C0. \uB098\uC911\uC5D0 \uCC45\uC73C\uB85C \uB098\uC624\uBA74 \uADF8\uB54C \uC0AC\uC11C \uC77D\uC73C\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340802
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uAC00 \uC8FC\uACE0. \uAE4E\uC544 \uB2EC\uB77C\uACE0 \uC548 \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757784
    m_Localized: "\uADF8\uAC00 \uAC74\uB128 \uAC83\uC740 \uC190\uC73C\uB85C \uADF8\uB9B0 \uC9C0\uB3C4\uC600\uB2E4. \uC815\uC218\uC7A5 \uB458\uB808\uC5D0 \uBE68\uAC04 \uC5D1\uC2A4 \uD45C\uC2DC\uAC00 \uC5EC\uB7EC \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146437
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAC00\uC838\uAC00. \uB098\uBCF4\uB2E4 \uB124\uAC00 \uB354 \uC798 \uC4F8 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146438
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uB098\uC911\uC5D0, \uC138\uC0C1\uC774 \uB2E4\uC2DC \uD559\uAD50\uB97C \uC5F4\uBA74\u2026 \uC758\uB300\uB4E0 \uAC04\uD638\uB300\uB4E0 \uC0DD\uAC01\uD574 \uBD10. \uC190\uC774 \uCC28\uBD84\uD55C \uC0AC\uB78C\uC740 \uADC0\uD558\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923620
    m_Localized: "\uCCB4\uC721\uAD00. \uC120\uBC30\uAC00 \uAC78\uB808 \uC790\uB8E8\uB97C \uD558\uB098 \uB4E4\uACE0 \uBB38 \uC55E\uC5D0 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923621
    m_Localized: "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC2DC\uBC94\uC744 \uBCF4\uC600\uB2E4. \uC5B4\uAE68\uB97C \uBB38\uC5D0 \uBD99\uC774\uACE0, \uBC1C \uD558\uB098\uB294 \uB4A4\uB85C \uAE38\uAC8C, \uBB34\uB98E\uC740 \uAD7D\uD788\uACE0. \uC790\uB8E8\uB97C \uBB38 \uC190\uC7A1\uC774 \uC544\uB798\uC5D0 \uBE44\uC2A4\uB4EC\uD788 \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923622
    m_Localized: "\uADF8\uB9AC\uACE0 \uB098\uB97C \uBCF4\uC558\uB2E4. \uD574 \uBCF4\uB77C\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174848
    m_Localized: "\uBC24. \uBCF4\uAC74\uC2E4 \uBD88\uBE5B \uC544\uB798 \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC57D\uC7A5 \uBAA9\uB85D\uC744 \uB2E4\uC2DC \uC4F0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757785
    m_Localized: "\uC720\uB791\uC790: \uC800\uAE30 \uADFC\uCC98 \uAC00\uC9C0 \uB9C8\uB77C. \uC544\uB2C8\uBA74\u2026 \uAC00\uC57C \uD55C\uB2E4\uBA74 \uBC24\uC5D0 \uAC00\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757786
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uD558\uACE0 \uC9C0\uB3C4\uB97C \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340803
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC6C3\uB2E4\uAC00 \uAE30\uCE68\uC744 \uD588\uB2E4. \uAE30\uCE68\uC774 \uBA4E\uC744 \uB54C\uAE4C\uC9C0 \uB4F1\uC744 \uC4F8\uC5B4 \uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340804
    m_Localized: "\uBC24\uC0C8 \uB208\uC774 \uC313\uC600\uB2E4. \uC6B4\uB3D9\uC7A5\uC774 \uD558\uC597\uAC8C \uB36E\uC600\uB2E4. \uBC1C\uC790\uAD6D \uD558\uB098 \uC5C6\uB294, \uCC98\uC74C \uBCF4\uB294 \uD558\uC591."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340805
    m_Localized: "\uB610 \uB208\uC774 \uB0B4\uB838\uB2E4. \uC9C0\uB09C\uBC88 \uB208\uC774 \uB179\uB2E4 \uB9CC \uC790\uB9AC \uC704\uB85C \uC0C8 \uB208\uC774 \uB36E\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340806
    m_Localized: "\uB208. \uC774\uC81C\uB294 \uBC18\uAC11\uC9C0\uB3C4 \uC54A\uC558\uB2E4. \uCC3D\uD2C0\uC5D0 \uC313\uC778 \uB208\uC744 \uC4F8\uC5B4 \uB0B4\uB2E4\uAC00, \uADF8\uB798\uB3C4 \uD558\uB298\uC744 \uD55C \uBC88 \uC62C\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340807
    m_Localized: "\uADF8\uAC83\uB4E4\uC740 \uB208 \uC18D\uC5D0\uC11C \uB290\uB824\uC84C\uB2E4. \uC624\uB298\uC740 \uBC14\uAE65\uC774 \uC870\uAE08 \uB35C \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369142
    m_Localized: "\uC18C\uB9AC\uB97C \uC9C0\uB974\uACE0 \uB098\uB2C8 \uC624\uD788\uB824 \uC228\uC774 \uC26C\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757763
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC81C \uB0A8\uC740 \uAC74 \uD55C \uACC4\uC808\uC774\uC57C. \uC5F4\uC138 \uC8FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340808
    m_Localized: "\uB208\uC0AC\uB78C\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340809
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC0AC\uB78C\uC5D0\uAC8C \uB098\uBB47\uAC00\uC9C0 \uBAA9\uBC1C \uB450 \uAC1C\uB97C \uAF42\uC544 \uC8FC\uC5C8\uB2E4. \uCC3D\uBB38 \uB108\uBA38\uB85C \uC120\uC0DD\uB2D8\uC774 \uC6C3\uB294 \uAC8C \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654288
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A0\uAE50, \uADF8\uAC70 \uADF8\uB0E5 \uB9C8\uC2DC\uBA74 \uC548 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654287
    m_Localized: "\uBC24\uC0C8 \uBC1B\uC544 \uB454 \uC591\uB3D9\uC774\uC5D0 \uBE57\uBB3C\uC774 \uACE0\uC5EC \uC788\uC5C8\uB2E4. \uBAA9\uC774 \uB9D0\uB77C\uC11C, \uC190\uC73C\uB85C \uB5A0 \uB9C8\uC2DC\uB824 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757787
    m_Localized: "\uADF8\uB294 \uB300\uB2F5 \uC5C6\uC774 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uB5A0\uB098\uB824\uB2E4, \uD574\uAC00 \uC9C0\uB294 \uD558\uB298\uC744 \uD55C \uBC88 \uC62C\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757788
    m_Localized: "\uB3C5\uAC10\uC774 \uB3CC\uC558\uB2E4. \uB3C4\uD604\uC774 \uBA3C\uC800, \uADF8\uB2E4\uC74C \uB0B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146439
    m_Localized: "\uB098\uC911\uC5D0 \uBB34\uC5C7\uC774 \uB418\uBA74 \uC88B\uC744\uC9C0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923623
    m_Localized: "\uB530\uB77C \uD558\uB2C8 \uC120\uBC30\uAC00 \uB0B4 \uB4B7\uBC1C\uC744 \uBC1C\uB05D\uC73C\uB85C \uD22D \uBC00\uC5C8\uB2E4. \uBC18 \uBF18 \uB354 \uB4A4\uB85C. \uB2E4\uC2DC \uC5B4\uAE68\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uB20C\uB800\uB2E4. \uB354 \uB0AE\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146440
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB50\uAC00 \uB418\uB4E0. \uB2E4\uCE5C \uC0AC\uB78C \uC55E\uC5D0\uC11C \uB3C4\uB9DD \uC548 \uAC00\uB294 \uC0AC\uB78C\uC774\uBA74 \uB3FC. \uB108\uB294 \uC774\uBBF8 \uADF8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757789
    m_Localized: "\uB3C5\uAC10\uC774 \uB3CC\uC558\uB2E4. \uB204\uAD70\uAC00 \uBA3C\uC800 \uAE30\uCE68\uC744 \uC2DC\uC791\uD588\uACE0, \uADF8\uB2E4\uC74C \uB0B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340810
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC0AC\uB78C\uC5D0\uAC8C \uC790\uAE30 \uBAA9\uB3C4\uB9AC\uB97C \uAC10\uC544 \uC8FC\uC5C8\uB2E4. \uCC3D\uBB38 \uB108\uBA38\uB85C \uC120\uC0DD\uB2D8\uC774 \uC6C3\uB294 \uAC8C \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340811
    m_Localized: "\uD63C\uC790 \uC791\uC740 \uB208\uC0AC\uB78C\uC744 \uB9CC\uB4E4\uC5C8\uB2E4. \uB208\uC740 \uBCD1\uB69C\uAED1, \uC785\uC740 \uB098\uBB47\uAC00\uC9C0. \uC120\uC0DD\uB2D8 \uCC3D \uC544\uB798\uC5D0 \uC138\uC6CC \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340812
    m_Localized: "\uBC24\uC774 \uB418\uC790 \uB208\uC0AC\uB78C \uBA38\uB9AC \uC704\uC5D0\uB3C4 \uB208\uC774 \uC18C\uBCF5\uC774 \uC313\uC600\uB2E4. \uBAA8\uC790\uB97C \uC4F4 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729216
    m_Localized: "\uB208\uC744 \uBAA8\uC544 \uB179\uC5EC \uBB3C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729217
    m_Localized: "\uC591\uB3D9\uC774 \uAC00\uB4DD \uB208\uC744 \uD37C \uC654\uB2E4. \uB179\uC774\uB2C8 \uC0DD\uAC01\uBCF4\uB2E4 \uC801\uC5C8\uB2E4. \uBC14\uB2E5\uC5D0 \uC190\uAC00\uB77D \uB450 \uB9C8\uB514\uCBE4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563790
    m_Localized: "{0}: \uC6A9\uC11C\uD560\uAC8C. \uB124\uAC00 \uBC1B\uC744 \uC790\uACA9\uC774 \uC788\uC5B4\uC11C\uAC00 \uC544\uB2C8\uB77C, \uB0B4\uAC00 \uC774\uAC78 \uB354 \uB4E4\uACE0 \uB2E4\uB2C8\uAE30 \uC2EB\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563791
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4. \uCC98\uC74C\uC73C\uB85C \uADF8 \uC560\uC758 \uC815\uC218\uB9AC\uB97C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563792
    m_Localized: "\uAC01\uC790 \uC0B4\uC790\uACE0, \uB2E4\uC2DC\uB294 \uB9C8\uC8FC\uCE58\uC9C0 \uB9D0\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146441
    m_Localized: "\uADF8\uB3D9\uC548 \uACE0\uB9C8\uC6E0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923624
    m_Localized: "\uAD6C\uACBD\uD558\uB358 \uB3C4\uD604\uC774 \uB530\uB77C \uD558\uB2E4 \uBBF8\uB044\uB7EC\uC84C\uB2E4. \uC120\uBC30\uAC00 \uB3C4\uD604\uC758 \uBC1C\uB3C4 \uB611\uAC19\uC774 \uD22D \uBC00\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980503
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uAC8C. \uB2E4\uB4E4 \uC2DC\uD5D8\uC774 \uC5C6\uC5B4\uC9C0\uAE38 \uADF8\uB807\uAC8C \uBC14\uB790\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117997
    m_Localized: "\uC74C\uC545\uC2E4\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4. \uC120\uC0DD\uB2D8\uC758 \uC790\uC7A5\uAC00\uB294 \uB05D\uAE4C\uC9C0 \uD55C \uBC88\uB3C4 \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146442
    m_Localized: "{0}: \uADF8\uB0A0 \uC190\uB4F1 \uC18C\uB3C5\uD574 \uC8FC\uC2E0 \uAC70\uC694. \uB530\uB054\uD588\uB294\uB370, \uADF8\uAC8C \uC5EC\uAE30\uC11C \uCC98\uC74C \uBC1B\uC740 \uCE58\uB8CC\uC600\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146443
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4. \uC57D\uC7A5 \uBB38\uC5D0 \uC774\uB9C8\uB97C \uC7A0\uAE50 \uB314\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757746
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC758\uC871\uC5D0 \uCCB4\uC911\uC744 \uC2E3\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146374
    m_Localized: "DJ: \uAD6C\uC870\uB300\uAC00 \uC0C8\uBCBD\uC2DC \uC0DD\uC874\uC790 \uBA85\uB2E8\uC744 \uBC1B\uB294\uB300\uC694. \uBB34\uC804\uC73C\uB85C \uC774\uB984\uC744 \uBD88\uB7EC \uC8FC\uBA74, \uADF8\uB300\uB85C \uC62C\uB77C\uAC04\uB300\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826522
    m_Localized: "\uC6B0\uB9AC\uB294 \uADF8 \uBB3C\uB85C \uC774\uB97C \uB2E6\uC558\uB2E4. \uC624\uB79C\uB9CC\uC5D0 \uC785\uC548\uC774 \uAC1C\uC6B4\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563793
    m_Localized: "{0}: \uB108\uB97C \uBBF8\uC6CC\uD558\uB294 \uB370 \uB0A8\uC740 \uC2DC\uAC04\uC744 \uC4F0\uACE0 \uC2F6\uC9C0 \uC54A\uC544. \uAC01\uC790 \uC0B4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563794
    m_Localized: "\uB3CC\uC544\uC11C\uC11C \uAC78\uC5B4 \uB098\uC624\uB294 \uB3D9\uC548 \uD55C \uBC88\uB3C4 \uB4A4\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563795
    m_Localized: "\uC5EC\uAE30 \uC788\uC73C\uBA74 \uC704\uD5D8\uD558\uB2E4\uACE0, \uD559\uAD50\uB85C \uC624\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757747
    m_Localized: "\uAE30\uCE68\uC744 \uCC38\uC73C\uBA70 \uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757748
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146444
    m_Localized: "\uBC24. \uBCF5\uB3C4 \uB05D \uCC3D\uAC00. \uC1A1\uC608\uC9C0\uB294 \uC624\uB298\uB3C4 \uAC70\uAE30 \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uACBD\uACC4\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146445
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC811\uD78C \uC885\uC774\uB97C \uAEBC\uB0C8\uB2E4. \uADF8\uB54C \uB0B4\uAC00 \uB3CC\uB824\uC92C\uB358 \uD3B8\uC9C0\uC600\uB2E4. \uADC0\uD241\uC774\uAC00 \uB2F3\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117998
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uB178\uB798\uBC29 \uC2ED\uD314\uBC88\uC774\uB77C\uBA70 \uC2E0\uB098\uB294 \uB178\uB798\uB97C \uACE8\uB790\uB2E4. \uADF8\uB7F0\uB370 \uBAA9\uC18C\uB9AC\uAC00 \uC790\uAFB8 \uB0AE\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117999
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC774\uAC70 \uADF8\uB54C \uC560\uB4E4\uC774\uB791 \uB9E8\uB0A0 \uBD80\uB974\uB358 \uAC70\uB77C. \uB2E4\uB978 \uAC70 \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118000
    m_Localized: "\uB2E4\uB978 \uB178\uB798\uB97C \uD588\uB2E4. \uD558\uB9B0\uC774 \uBAA8\uB974\uB294 \uB178\uB798\uC600\uB2E4. \uD558\uB9B0\uC740 \uB05D\uAE4C\uC9C0 \uAC00\uC0AC\uB97C \uD2C0\uB9AC\uBA74\uC11C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118001
    m_Localized: "\uC720\uB791\uC790\uB294 \uB178\uB798 \uB300\uC2E0 \uD718\uD30C\uB78C\uC744 \uBD88\uC5C8\uB2E4. \uC0B0\uC0C8 \uC18C\uB9AC\uB97C \uD749\uB0B4 \uB0B8 \uAC70\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146446
    m_Localized: "\uC1A1\uC608\uC9C0: \uC9C1\uC811 \uC904 \uC218 \uC788\uC744 \uB54C \uBC1B\uB294\uB2E4\uACE0 \uD588\uC796\uC544. \u2026\uC9C0\uAE08\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146447
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8 \uD3B8\uC9C0, \uC544\uC9C1 \uAC00\uC9C0\uACE0 \uC788\uC5B4? \u2026\uBC84\uB824\uB3C4 \uB3FC. \uC774\uC81C \uBB38 \uCABD\uC740 \uC548 \uBD10\uB3C4 \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118002
    m_Localized: "\uC720\uB791\uC790: \uC774\uAC74 '\uC5EC\uAE30 \uC788\uB2E4'. \uC774\uAC74 '\uC870\uC2EC\uD574'. \uC0B0\uC5D0\uC11C\uB294 \uB9D0\uBCF4\uB2E4 \uC774\uAC8C \uBA40\uB9AC \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118003
    m_Localized: "\uBC30\uC6B4 \uB300\uB85C \uB530\uB77C \uBD88\uC5C8\uB2E4. \uBC14\uB78C \uBE60\uC9C0\uB294 \uC18C\uB9AC\uB9CC \uB0AC\uB2E4. \uC720\uB791\uC790\uAC00 \uBAA8\uC790 \uC544\uB798\uB85C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146448
    m_Localized: "\uC1A1\uC608\uC9C0: \uB0B4\uC77C \uBB38\uC774 \uC5F4\uB9AC\uBA74, \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC81C\uC77C \uBA3C\uC800 \uB098\uAC08\uAC8C. \uADF8\uB9AC\uACE0 \uB124\uAC00 \uB098\uC62C \uB54C\uAE4C\uC9C0 \uBB38 \uC7A1\uACE0 \uC788\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563796
    m_Localized: "\uC815 \uBC18\uC7A5\uC758 \uBB34\uB9AC\uB294 \uACE7 \uB2E4\uB978 \uB3C4\uC2DC\uB85C \uB5A0\uB09C\uB2E4\uACE0 \uD588\uB2E4. \uC774 \uC544\uC774\uB294 \uB370\uB824\uAC00\uC9C0 \uC54A\uB294\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563797
    m_Localized: "{0}: \uC6B0\uB9AC \uD559\uAD50\uC5D0 \uC640. \uB300\uC2E0 \uADDC\uCE59\uC740 \uB0B4\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563798
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uD55C\uCC38\uC744 \uCCD0\uB2E4\uBCF4\uB2E4\uAC00, \uC544\uC8FC \uC791\uAC8C \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729218
    m_Localized: "\uB208 \uD55C \uC591\uB3D9\uC774\uAC00 \uBB3C \uD55C \uCEF5. \uACA8\uC6B8\uC758 \uC148\uBC95\uC744 \uD558\uB098 \uBC30\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729219
    m_Localized: "\uC218\uB3C4\uAD00\uC774 \uC5BC\uC5B4 \uD130\uC84C\uB2E4. \uAE09\uC2DD\uC2E4 \uBC14\uB2E5\uC774 \uC5BC\uC74C\uD310\uC774 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757790
    m_Localized: "\uC628\uBAB8\uC774 \uC464\uC2DC\uACE0 \uBA38\uB9AC\uAC00 \uAE68\uC9C8 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786281
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. 3\uCE35 \uB05D \uAD50\uC2E4 \uCABD\uC774\uC5C8\uC5B4. \uBB3C\uC774\uB791 \uAC04\uC2DD \uC880 \uCC59\uACA8 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786280
    m_Localized: "\uB0B4\uC77C \uAC00 \uBCF4\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757791
    m_Localized: "\uC5F4\uC5D0 \uB4E4\uB72C \uBC24, \uAFC8\uC778\uC9C0 \uC0DD\uC2DC\uC778\uC9C0 \uBAA8\uB974\uAC8C \uCCB4\uC721\uCC3D\uACE0 \uD658\uAE30\uCC3D\uC774 \uBA87 \uBC88 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174789
    m_Localized: "\uD55C\uBC24\uC911, \uC120\uC0DD\uB2D8\uC774 \uC774\uB97C \uC545\uBB3C\uACE0 \uBB34\uB98E \uC544\uB798\uB97C \uC6C0\uCF1C\uC950\uACE0 \uC788\uC5C8\uB2E4. \uC5C6\uB294 \uACF3\uC774 \uC544\uD504\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826541
    m_Localized: "\uC9C0\uAE08\uC740 \uC548\uB2E4. \uC548 \uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uD574\uB3C4, \uBB38\uC740 \uB2EB\uD788\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757792
    m_Localized: "{0}: \uC774\uAC70\u2026 \uADF8 \uC5F4 \uC544\uB2C8\uC8E0? \uD734\uBA74\uC5F4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146449
    m_Localized: "\uCE5C\uAD6C\uAC00 \uB418\uC790\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923625
    m_Localized: "\uC790\uC138\uB97C \uB420 \uB54C\uAE4C\uC9C0 \uBC18\uBCF5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923626
    m_Localized: "\uC5F4 \uBC88, \uC2A4\uBB34 \uBC88. \uC120\uBC30\uB294 \uD55C \uBC88\uB3C4 \uC798\uD588\uB2E4\uACE0 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB0E5 \uB354 \uC774\uC0C1 \uBC1C\uC744 \uBC00\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC8C \uD569\uACA9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757749
    m_Localized: "\uB3C4\uD604\uC774 \uCC3D\uAC00\uC5D0\uC11C \uC2E0\uD638\uB97C \uBCF4\uB0C8\uB2E4. \uC9E7\uAC8C \uB450 \uBC88. \uB610 \uC9E7\uAC8C \uB450 \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174889
    m_Localized: "\uBC24. \uBCF5\uB3C4 \uB05D \uCC3D\uAC00\uC5D0 \uC1A1\uC608\uC9C0\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uACBD\uACC4 \uB2F9\uBC88\uB3C4 \uC544\uB2CC\uB370, \uC694\uC998\uC740 \uB9E4\uC77C \uBC24 \uAC70\uAE30 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757793
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC544\uB2C8\uC57C. \uBB3C\uB9B0 \uB370\uAC00 \uC5C6\uC796\uC544. \uADF8\uB0E5 \uB3C5\uAC10\uC774\uC57C. \uADF8\uAC83\uB3C4 \uC9C0\uB3C5\uD55C \uB188."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146375
    m_Localized: "DJ: \uADF8\uB9AC\uACE0\u2026 \uB0B4\uAC00 \uC0C8\uBCBD\uACE0 \uC774\uB984, \uC81C\uC77C \uBA3C\uC800 \uBD88\uB7EC \uC92C\uC5B4\uC694. \uD559\uAD50\uC5D0 \uD559\uC0DD\uB4E4\uC774 \uC788\uB2E4\uACE0. \uC120\uC0DD\uB2D8\uB3C4 \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460217
    m_Localized: "\uC7A0\uB4E4\uAE30 \uC804, \uC120\uC0DD\uB2D8\uACFC \uBCF5\uB3C4 \uB05D\uAE4C\uC9C0 \uBB38\uB2E8\uC18D\uC744 \uD558\uB7EC \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757794
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uB2C8\uC57C. \uBB3C\uB9B0 \uB370\uAC00 \uC5C6\uC796\uC544. \uADF8\uB0E5 \uB3C5\uAC10\uC774\uC57C. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757795
    m_Localized: "\uADF8\uB798\uB3C4 \uBB34\uC11C\uC6E0\uB2E4. \uC120\uC0DD\uB2D8\uD55C\uD14C \uC62E\uC73C\uBA74 \uC548 \uB410\uB2E4. \uADF8 \uBAB8\uC5D0 \uC774\uAC83\uAE4C\uC9C0 \uC5B9\uD788\uBA74 \uC548 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174937
    m_Localized: "\uB0B4 \uBAAB\uC758 \uD1B5\uC870\uB9BC\uC744 \uC0C1\uC790 \uC704\uC5D0 \uC62C\uB824\uB193\uC558\uB2E4. \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923627
    m_Localized: "\uAC19\uC774 \uBB38\uC744 \uBC84\uD168 \uBCF4\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923628
    m_Localized: "{0}: \uC120\uBC30\uAC00 \uBC16\uC5D0\uC11C \uBC00\uC5B4 \uBD10\uC694. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923629
    m_Localized: "\uC120\uBC30\uAC00 \uBB38\uC744 \uBC00\uC5C8\uB2E4. \uCC98\uC74C\uC5D4 \uBC00\uB838\uB2E4. \uB450 \uBC88\uC9F8\uC5D4 \uBC84\uD17C\uB2E4. \uC138 \uBC88\uC9F8\uC5D0 \uC120\uBC30\uAC00 \uBB38 \uB108\uBA38\uC5D0\uC11C \uC190\uBC14\uB2E5\uC73C\uB85C \uBB38\uC744 \uB450 \uBC88 \uB450\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923630
    m_Localized: "\uC9E7\uAC8C \uB450 \uBC88. \uC6B0\uB9AC\uB07C\uB9AC \uC815\uD55C \uC2E0\uD638\uB85C\uB294 '\uC228\uC5B4'\uC600\uC9C0\uB9CC, \uC120\uBC30\uAC00 \uD55C \uAC74 \uC544\uB9C8 '\uB410\uC5B4'\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923631
    m_Localized: "\uD604\uAD00 \uBC14\uB9AC\uCF00\uC774\uB4DC \uBCF4\uAC15\uC774 \uB05D\uB09C \uC800\uB141\uC774\uC5C8\uB2E4. \uD310\uC790\uC640 \uCCA0\uD310\uC774 \uACB9\uACB9\uC774 \uBB38\uC744 \uB9C9\uACE0 \uC788\uC5C8\uB2E4. \uB300\uBD80\uBD84 \uC120\uBC30\uAC00 \uD63C\uC790 \uBD99\uC778 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826571
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC548 \uB204\uB978 \uAC70, \uC798\uD588\uC5B4. \uC5B8\uC820\uAC00 \uB9C8\uC74C\uAECF \uCE60 \uC218 \uC788\uB294 \uB0A0\uC774 \uC624\uBA74 \uADF8\uB54C \uCE58\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905823
    m_Localized: "\uC2DD\uB7C9\uC744 \uB0B4\uC900\uB2E4. \uC9C0\uAE08\uC740 \uC2F8\uC6B8 \uB54C\uAC00 \uC544\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146450
    m_Localized: "{0}: \uB2E4\uC74C\uC5D4 \uBB38 \uC55E\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uB294 \uAC70 \uB9D0\uACE0. \uADF8\uB0E5 \uAC19\uC774 \uB098\uAC00\uC790. \uCE5C\uAD6C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146451
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6B8\uBA74\uC11C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905822
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uBB38 \uB4A4\uC5D0\uC11C \uB0B4 \uC774\uB984\uC744 \uC791\uAC8C \uBD88\uB800\uB2E4. \uACB0\uC815\uC740 \uB0B4 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729220
    m_Localized: "\uB610 \uD130\uC84C\uB2E4. \uC9C0\uB09C\uBC88\uC5D0 \uAC10\uC740 \uD14C\uC774\uD504 \uBC14\uB85C \uC606\uC774\uC5C8\uB2E4. \uAE09\uC2DD\uC2E4 \uBC14\uB2E5\uC5D0 \uB2E4\uC2DC \uC5BC\uC74C\uC774 \uAE54\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146639
    m_Localized: "\uBAA8\uB974\uB294 \uD53C\uB97C \uB123\uC744 \uC218\uB294 \uC5C6\uB2E4. \uB77C\uBCA8\uC774 \uBD99\uC740 \uD53C\uAC00 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174833
    m_Localized: "\uB9D0\uC774 \uAF2C\uC600\uB2E4. \uBAA9\uC18C\uB9AC\uAC00 \uB5A8\uB9AC\uB294 \uAC78 \uB0A8\uC790\uB3C4 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729221
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uCA4D, \uD558\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC774\uC81C\uB294 \uB2E4\uB4E4 \uBB34\uC2A8 \uC18C\uB9AC\uC778\uC9C0 \uC54C\uC558\uB2E4. \uC218\uB3C4\uAD00\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729222
    m_Localized: "\uC0C8\uB294 \uBB3C\uC774 \uBC14\uB2E5\uC5D0\uC11C \uADF8\uB300\uB85C \uC5BC\uC5B4 \uAC14\uB2E4. \uB9C9\uB4E0 \uC4F0\uB4E0, \uC9C0\uAE08 \uD574\uC57C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905821
    m_Localized: "\uB0A8\uC790: \uB300\uC2E0 \uC131\uC758\uB294 \uBCF4\uC5EC\uC57C\uC9C0. \uC77C\uC8FC\uC77C\uC5D0 \uBA39\uC744 \uAC70 \uC870\uAE08\uC529. \uADF8\uB7FC \uC0AC\uAC70\uB9AC\uB294 \uB108\uD76C \uD3B8\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905820
    m_Localized: "\uB0A8\uC790: \uC5EC\uAE30 \uC560\uB4E4\uC774\uB791 \uB2E4\uB9AC \uC5C6\uB294 \uC120\uC0DD \uD558\uB098 \uC0AC\uB294 \uAC70 \uB2E4 \uC54C\uC544. \uAC15\uCCA0\uC774 \uD615\uB2D8\uC774 \uADF8\uB7EC\uB354\uB77C. \uC560\uB4E4\uC740 \uAC74\uB4DC\uB9AC\uC9C0 \uB9D0\uC790\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905819
    m_Localized: "\uB0A8\uC790: \uAC81\uBA39\uC9C0 \uB9C8. \uC624\uB298\uC740 \uB9D0\uB9CC \uD558\uB7EC \uC654\uC5B4. \uC6B0\uB9AC \uD615\uB2D8 \uB9D0 \uC804\uD558\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905818
    m_Localized: "\uB300\uB0AE\uC5D0 \uAD50\uBB38 \uC55E\uC5D0 \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uB0A8\uC790\uAC00 \uD63C\uC790 \uC11C \uC788\uC5C8\uB2E4. \uC190\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uB4E4\uACE0 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654231
    m_Localized: "\uC120\uBC30\uB294 \uC190\uB05D\uC73C\uB85C \uBAA9\uC758 \uD749\uD130\uB97C \uCC9C\uCC9C\uD788 \uC4F8\uACE0 \uC788\uC5C8\uB2E4. \uC544\uD508 \uB370\uB97C \uB9CC\uC9C0\uB294 \uC190\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uAC70\uAE30 \uC544\uC9C1 \uBB34\uC5C7\uC774 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uB294 \uC190\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146452
    m_Localized: "\uB9D0\uC5C6\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980495
    m_Localized: "\uC2DC\uD5D8\uC9C0 \uC704\uCABD\uC5D0 \uBE68\uAC04 \uC0C9\uC5F0\uD544 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uC77C\uACF1 \uAC1C. \uC774\uB984 \uCE78 \uC606\uC5D0\uB294 \uC791\uAC8C '\uCC38 \uC798\uD588\uC5B4\uC694'."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729223
    m_Localized: "\uD14C\uC774\uD504\uC640 \uC790\uC7AC\uB85C \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729224
    m_Localized: "\uC190\uC774 \uACF1\uC544 \uBA87 \uBC88\uC774\uB098 \uD14C\uC774\uD504\uB97C \uB193\uCCE4\uB2E4. \uC785\uAE40\uC744 \uBD88\uC5B4 \uAC00\uBA70 \uB2E4\uC2DC \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729225
    m_Localized: "\uADF8\uB798\uB3C4 \uB9C9\uC558\uB2E4. \uC5BC\uC74C \uC704\uC5D0 \uBB34\uB98E \uAFC7\uC5C8\uB358 \uC790\uB9AC\uAC00 \uD558\uC597\uAC8C \uC816\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757796
    m_Localized: "\uC544\uAEF4 \uB454 \uC57D\uC744 \uB098\uB220 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146453
    m_Localized: "\uADF8\uAC78\uB85C \uCDA9\uBD84\uD588\uB2E4. \uCC3D\uBC16\uC5D0 \uB208\uC774 \uB0B4\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654232
    m_Localized: "\uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790 \uC190\uC744 \uB0B4\uB838\uB2E4. \uADF8\uB9AC\uACE0 \uB298 \uADF8\uB807\uB4EF \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC600\uB2E4. \uAD1C\uCC2E\uB2E4\uB294 \uB73B\uC778\uC9C0, \uAC00\uB77C\uB294 \uB73B\uC778\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146454
    m_Localized: "\uBC24. \uCD5C\uD558\uB9B0\uC774 \uCCB4\uC721\uCC3D\uACE0 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146455
    m_Localized: "\uBB38\uACE0\uB9AC \uC544\uB798\uC5D0 \uC624\uB798\uB41C \uAE01\uD78C \uC790\uAD6D\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uB458 \uB2E4 \uADF8\uAC78 \uBCF4\uACE0 \uC788\uC5C8\uC9C0\uB9CC, \uC544\uBB34\uB3C4 \uBA3C\uC800 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654233
    m_Localized: "\uB0AE\uC5D0 \uCD5C\uD558\uB9B0\uC774 \uC120\uBC30\uB97C \uC624\uB798 \uCCD0\uB2E4\uBCF4\uB358 \uAC8C \uC0DD\uAC01\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654234
    m_Localized: "\uCD5C\uD558\uB9B0: \uC800 \uC120\uBC30\u2026 \uC5B4\uB514\uC11C \uBD24\uB294\uB370. \uC6B0\uB9AC \uD559\uAD50 \uC560\uB4E4\uC740 \uB2E4 \uC54C\uC558\uC744 \uAC70\uC57C. \uADF8 \uC5BC\uAD74 \uB9D0\uACE0, \uC608\uC804 \uC5BC\uAD74."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654235
    m_Localized: "\uB354 \uBB3B\uC790 \uD558\uB9B0\uC740 \uC785\uC744 \uB2E4\uBB3C\uC5C8\uB2E4. \uBAA8\uB974\uB294 \uC5BC\uAD74\uC774 \uC544\uB2C8\uB77C, \uB9D0\uD558\uAE30 \uC2EB\uC740 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340623
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uBC14\uBCF4 \uAC19\uC740 \uC18C\uB9AC. \uC815\uB9D0 \uBC14\uBCF4 \uAC19\uC740 \uC18C\uB9AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711630
    m_Localized: "\uB3C4\uD604: \uC800\uB3C4 \uBB50 \uD558\uACE0 \uC2F6\uC5B4\uC694. \uB9E8\uB0A0 \uC228\uC5B4\uB9CC \uC788\uB294 \uAC70 \uC2EB\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757797
    m_Localized: "\uC57D\uC774 \uC904\uC5B4\uB4DC\uB294 \uAC8C \uBCF4\uC600\uB2E4. \uADF8\uB798\uB3C4 \uC0AC\uD758 \uB9CC\uC5D0 \uC5F4\uC774 \uB0B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757798
    m_Localized: "\uC57D\uC0C1\uC790 \uBC14\uB2E5\uC774 \uBCF4\uC600\uB2E4. \uB2E4\uC74C \uD0D0\uD5D8 \uBAA9\uB85D \uB9E8 \uC704\uC5D0 '\uD574\uC5F4\uC81C'\uB97C \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757799
    m_Localized: "\uC544\uD508 \uC0AC\uB78C\uB07C\uB9AC \uAD50\uC2E4 \uD558\uB098\uC5D0 \uACA9\uB9AC\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757800
    m_Localized: "\uB530\uB85C \uC9C0\uB0B4\uB294 \uBA70\uCE60\uC774 \uAE38\uC5C8\uB2E4. \uBB38 \uB108\uBA38\uB85C \uC11C\uB85C\uC758 \uAE30\uCE68 \uC18C\uB9AC\uB9CC \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757801
    m_Localized: "\uAE30\uCE68 \uC18C\uB9AC\uB85C \uC11C\uB85C \uC0B4\uC544 \uC788\uB294 \uAC78 \uD655\uC778\uD588\uB2E4. \uC774\uCABD\uC5D0\uC11C \uD55C \uBC88 \uD558\uBA74, \uC800\uCABD\uC5D0\uC11C \uD55C \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757802
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uAED8 \uAC04\uD638\uB97C \uBD80\uD0C1\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757803
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBC24\uC0C8 \uBB3C\uC218\uAC74\uC744 \uAC08\uC544 \uC8FC\uC5C8\uB2E4. \uC794\uC18C\uB9AC\uB3C4 \uAC19\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757804
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC544\uD504\uBA74 \uC544\uD504\uB2E4\uACE0 \uD558\uB77C\uACE0 \uD588\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729226
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uC5BC\uC74C\uC744 \uB179\uC5EC \uBB3C\uC744 \uC5BB\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729227
    m_Localized: "\uB09C\uB85C \uC704\uC5D0\uC11C \uC5BC\uC74C\uC774 \uCC9C\uCC9C\uD788 \uB179\uC558\uB2E4. \uAE40\uC774 \uD53C\uC5B4\uC624\uB974\uB294 \uAC78 \uB2E4\uB4E4 \uC190\uC744 \uCB10\uBA70 \uC9C0\uCF1C\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729228
    m_Localized: "\uBB3C \uB053\uB294 \uC18C\uB9AC\uAC00 \uC624\uB79C\uB9CC\uC5D0 \uBD80\uC5CC \uAC19\uC558\uB2E4. \uB204\uAD70\uAC00 \uB77C\uBA74 \uC598\uAE30\uB97C \uAEBC\uB0C8\uB2E4\uAC00, \uB2E4 \uAC19\uC774 \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174954
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC8C \uBB34\uC2A8 \uC0BC\uACC4\uD0D5\uC774\uC57C. \u2026\uB9DB\uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980530
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uB098\uAC04\uB2E4. \uB6F0\uC9C0\uB294 \uBABB\uD574\uB3C4. \uAE30\uB85D\uC740 \uB124\uAC00 \uC7AC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654236
    m_Localized: "\uB9D0\uC5C6\uC774 \uC606\uC5D0 \uC549\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654237
    m_Localized: "\uC120\uBC30 \uC606\uC5D0 \uC549\uC558\uB2E4. \uB458\uC774\uC11C \uD55C\uCC38 \uCC3D\uBC16\uB9CC \uBCF4\uC558\uB2E4. \uADF8\uAC83\uB4E4\uC774 \uC6B4\uB3D9\uC7A5\uC744 \uCC9C\uCC9C\uD788 \uAC00\uB85C\uC9C8\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706421
    m_Localized: "\uB0A8\uC544 \uC788\uB358 \uC0AC\uB78C\uB4E4\uC774 \uC9C0\uCF1C \uB0C8\uB2E4. \uADF8 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294 \uB3D9\uC548 \uC190\uC774 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706420
    m_Localized: "\uB9D0\uC5C6\uC774 \uBCC4\uC744 \uC13C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706419
    m_Localized: "\uCC98\uC74C\uC73C\uB85C '\uB098\uC911'\uC774\uB77C\uB294 \uB9D0\uC744 \uC18C\uB9AC \uB0B4\uC5B4 \uD588\uB2E4. \uB9D0\uD558\uACE0 \uB098\uB2C8, \uADF8\uAC8C \uC815\uB9D0 \uC62C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729229
    m_Localized: "DJ: \uC778\uC0AC \uBC1B\uC2B5\uB2C8\uB2E4. \uAD6C\uC870 \uAE30\uB2E4\uB9AC\uB294 \uBD84\uB4E4, \uC11C\uB85C\uC5D0\uAC8C \uD55C\uB9C8\uB514\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729230
    m_Localized: "DJ: \uC624\uB298\uB3C4 \uC778\uC0AC \uC2DC\uAC04\uC774\uC5D0\uC694. \uC5B4\uC81C\uBCF4\uB2E4 \uBAA9\uC18C\uB9AC\uAC00 \uD558\uB098\uB77C\uB3C4 \uB298\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729231
    m_Localized: "DJ: \uC778\uC0AC \uC2DC\uAC04\uC774\uC5D0\uC694. \uC624\uB298\uC740 \uC774\uB984 \uB9D0\uACE0, \uC9C0\uAE08 \uCC3D\uBC16\uC5D0 \uBB50\uAC00 \uBCF4\uC774\uB294\uC9C0 \uB9D0\uD574 \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786269
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 \uC6B0\uB9AC, \uC11D \uB2EC \uAC00\uAE4C\uC774 \uBC84\uD17C\uB2E4. \uADF8\uAC74 \uC78A\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146376
    m_Localized: "\uB2E4\uB4E4 \uBB34\uC804\uAE30\uB97C \uC954 \uB0B4 \uCABD\uC744 \uBCF4\uC558\uB2E4. \uC774\uB984\uC744 \uBD80\uB974\uB294 \uAC74, \uC5B8\uC820\uAC00\uBD80\uD130 \uB0B4 \uC77C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987468
    m_Localized: "\uAD50\uACFC\uC11C \uB300\uC2E0 \uCC3D\uACE0 \uBCBD\uC5D0 \uBD99\uC740 \uC2DC\uD654 \uD3EC\uC2A4\uD130\uAC00 \uCE60\uD310\uC774 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460171
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uACF1."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923617
    m_Localized: "{0}: \uC904 \uD558\uB098 \uBAA8\uC790\uB77C\uB124\uC694. \uAD50\uBB34\uC2E4 \uC11C\uB78D\uC5D0 \uC788\uB358 \uAC70 \uAC19\uC740\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369143
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB9DE\uC544. \uD654\uB0BC \uB9CC\uD574. \uB354 \uD654\uB0B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146373
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4, \uC88B\uC740 \uC18C\uC2DD\uC774\uC5D0\uC694. \uAD6C\uC870\uB300\uB791 \uC6B0\uB9AC \uCC44\uB110\uC744 \uC5F0\uACB0\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340798
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB \uC7A5\uC758 \uB108\uD55C\uD14C \uB9D0\uD574 \uC8FC\uACE0 \uC2F6\uB2E4. \uAD1C\uCC2E\uB2E4\uACE0. \uC77C\uACF1\uC9F8 \uB0A0\uC5D0 \uBB38\uC774 \uC5F4\uB9B0\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340797
    m_Localized: "\uB2E4 \uC77D\uC790 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4. \uC798 \uCEF8\uB2E4. \uC815\uB9D0 \uC798 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174920
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uB9E1\uAE30\uACE0 \uC7A0\uC744 \uCCAD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923616
    m_Localized: "\uB0A8\uC740 \uC904\uC744 \uCC3E\uC544\uC624\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923615
    m_Localized: "\uC5EC\uC12F \uC904\uC774 \uB2E4 \uAC78\uB838\uC744 \uB54C \uC120\uBC30\uB294 \uAE30\uD0C0\uB97C \uCE58\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uC904 \uD558\uB098\uB97C \uC544\uC8FC \uC791\uAC8C \uD295\uACBC\uB2E4. \uC74C \uD558\uB098\uAC00 \uC74C\uC545\uC2E4\uC5D0 \uC624\uB798 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923614
    m_Localized: "\uAE30\uD0C0 \uBAA9\uC5D0 \uBE5B\uC744 \uBE44\uCD94\uC5C8\uB2E4. \uC120\uBC30\uC758 \uC190\uC774 \uBE68\uB77C\uC84C\uB2E4. \uC904\uC744 \uAC10\uACE0, \uD295\uAE30\uACE0, \uADC0\uB97C \uB300\uACE0, \uB2E4\uC2DC \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923613
    m_Localized: "\uC190\uC804\uB4F1\uC744 \uBC1B\uC544 \uBE44\uCDB0 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369144
    m_Localized: "\uC6C3\uC73C\uBA70 \"\uAD1C\uCC2E\uC544\uC694\"\uB77C\uACE0 \uD558\uB824\uB2E4, \uC6C3\uC74C\uC744 \uB0B4\uB824\uB193\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340796
    m_Localized: "\uC5B4\uB5A4 \uC7A5\uC5D0\uC11C\uB294 \uB0B4\uAC00 \uC77D\uB2E4\uAC00 \uBA48\uCDC4\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC7AC\uCD09\uD558\uC9C0 \uC54A\uACE0 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340795
    m_Localized: "\uC77D\uB294 \uB3D9\uC548 \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uB2E4. \uCC98\uC74C \uC218\uC5C5 \uB54C\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340794
    m_Localized: "\uBE57\uBB3C\uC744 \uBC1B\uC740 \uB0A0. \uC625\uC0C1 \uACC4\uB2E8 \uC5F4\uC5EC\uC12F \uCE78\uC744 \uCC98\uC74C \uC13C \uB0A0. \uCC98\uC74C\uC73C\uB85C \uB204\uAD70\uAC00\uB97C \uB370\uB824\uC628 \uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340793
    m_Localized: "1\uC8FC\uCC28\uBD80\uD130 \uC77D\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBB38\uC744 \uC5F4\uC5B4 \uC92C\uB2E4. \uC77C\uC8FC\uC77C \uB9CC\uC5D0 \uC0AC\uB78C \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923612
    m_Localized: "\uC120\uBC30\uAC00 \uB098\uB97C \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC190\uC804\uB4F1\uC744 \uB0B4 \uCABD\uC73C\uB85C \uB0B4\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923611
    m_Localized: "\uC190\uC804\uB4F1\uC744 \uC785\uC5D0 \uBB3C\uACE0 \uC904\uC744 \uAC10\uC73C\uB824\uB2C8 \uC798 \uB418\uC9C0 \uC54A\uB294 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460170
    m_Localized: "\uC800\uB141\uC744 \uCE58\uC6B0\uB294\uB370 \uC120\uC0DD\uB2D8\uC774 \uC190\uAC00\uB77D\uC744 \uD558\uB098\uC529 \uC811\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369145
    m_Localized: "{0}: \uAD1C\uCC2E\uC544\uC694. \uB2E4 \uC9C0\uB09C \uC77C\uC778\uB370\uC694, \uBB50. \uC800 \uC6D0\uB798 \uC774\uB7F0 \uAC70 \uC798\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654289
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC591\uB3D9\uC774\uB97C \uB04C\uC5B4\uB2F9\uACA8 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4. \uBC14\uB2E5\uC5D0 \uBA3C\uC9C0\uC640 \uB179 \uBD80\uC2A4\uB7EC\uAE30\uAC00 \uAC00\uB77C\uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340792
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC7A5\uAE4C\uC9C0 \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340791
    m_Localized: "\uC77C\uAE30\uC7A5\uC744 \uD3BC\uCCE4\uB2E4. \uCCAB \uC7A5\uC758 \uAE00\uC528\uB294 \uC9C0\uAE08\uBCF4\uB2E4 \uC791\uACE0 \uC090\uB6A4\uC5C8\uB2E4. \uC5F0\uD544 \uC790\uAD6D\uC774 \uAD70\uB370\uAD70\uB370 \uBC88\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340790
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC694\uC998 \uB208\uC774 \uC790\uAFB8 \uD750\uB824\uC838\uC11C. \uAE00\uC528\uB294 \uBABB \uC77D\uC5B4\uB3C4, \uB124 \uBAA9\uC18C\uB9AC\uB294 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826544
    m_Localized: "\uC5F4\uC5EC\uC12F \uCE78\uC774 \uCC98\uC74C\uC73C\uB85C \uAE38\uC5C8\uB2E4. \uC2EB\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117996
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC18C\uC544\uBCD1\uB3D9\uC5D0 \uC788\uC744 \uB54C. \uC560\uB4E4 \uC7AC\uC6B8 \uB54C \uC774\uAC83\uB9CC \uBD88\uB800\uC5B4. \uB2E4\uB978 \uB178\uB798\uB294 \uAC00\uC0AC\uAC00 \uC0DD\uAC01\uC774 \uC548 \uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117995
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB178\uB798\uB97C \uBABB \uD55C\uB2E4\uACE0 \uC190\uC0AC\uB798\uB97C \uCCE4\uB2E4. \uADF8\uB7EC\uB2E4 \uC790\uC7A5\uAC00 \uD55C \uC18C\uC808\uC744 \uD765\uC5BC\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757783
    m_Localized: "\uC720\uB791\uC790: \uBE5A \uAC1A\uC73C\uB7EC \uC654\uB2E4. \uC57D\uD488 \uC0C1\uC790 \uD558\uB098, \uADF8\uB9AC\uACE0 \uC774\uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757782
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uADF8 \uC720\uB791\uC790\uAC00 \uB2E4\uC2DC \uB098\uD0C0\uB0AC\uB2E4. \uC774\uBC88\uC5D0\uB294 \uBB34\uC5B8\uAC00\uB97C \uB4E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757781
    m_Localized: "\uB354 \uB2E8\uB2E8\uD55C \uC790\uBB3C\uC1E0\uB97C \uB2EC\uC558\uB2E4. \uB9C8\uC74C \uD55C\uCABD\uB3C4 \uAC19\uC774 \uC7A0\uADF8\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757780
    m_Localized: "\uC790\uBB3C\uC1E0\uB97C \uB2E4\uC2DC \uB2E8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340789
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB124 \uC77C\uAE30, \uD55C \uBC88\uB9CC \uC77D\uC5B4 \uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117994
    m_Localized: "\uB098\uB3C4 \uBAA8\uB974\uAC8C \uAC19\uC774 \"\uBE60\uBC24\"\uC744 \uBD88\uB800\uB2E4. \uBC30\uAC00 \uC544\uD50C \uB54C\uAE4C\uC9C0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706494
    m_Localized: "\uC18C\uAE08\uC744 \uC544\uB07C\uC9C0 \uC54A\uC558\uB2E4. \uC9DC\uAE34 \uD574\uB3C4 \uBA70\uCE60\uC740 \uB354 \uBA39\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340788
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uB2E4. \uB300\uB2F5\uC740 \uB098\uC911\uC5D0 \uD574\uB3C4 \uB41C\uB2E4. \uC81C\uCD9C \uAE30\uD55C\uC740 \uB109\uB109\uD788 \uC8FC\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340787
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB0B4 \uC190\uB4F1\uC744 \uB450\uB4DC\uB838\uB2E4. \uCC9C\uCC9C\uD788, \uBC15\uC790\uC5D0 \uB9DE\uCD94\uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980496
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uACF1 \uAC1C\uAC00 \uC544\uC26C\uC6CC? \uC5BC\uAD74\uC5D0 \uB2E4 \uC4F0\uC5EC \uC788\uB2E4. \uC9C0\uAE08\uC740 \uC77C\uACF1 \uAC1C\uBA74 \uCDA9\uBD84\uD574. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923669
    m_Localized: "\uC720\uB791\uC790\uB294 \uD55C\uCC38 \uBCC4\uC744 \uBCF4\uB2E4\uAC00 \uB300\uB2F5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340786
    m_Localized: "\uB300\uB2F5\uD558\uB824\uACE0 \uD588\uB294\uB370, \uBAA9\uC18C\uB9AC \uB300\uC2E0 \uB208\uBB3C\uC774 \uBA3C\uC800 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706495
    m_Localized: "\uC808\uC774\uB294 \uC0AC\uC774\uC5D0\uB3C4 \uC0C1\uD558\uB294 \uAC8C \uB354 \uBE68\uB790\uB2E4. \uC870\uAE08\uB9CC \uAC74\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117993
    m_Localized: "\uB3C4\uD604: \uC774\uAC70 \uBCF4\uC2A4 \uB098\uC62C \uB54C \uB098\uC624\uB294 \uAC70\uC608\uC694. \uC9C0\uAE08 \uC6B0\uB9AC\uD55C\uD14C \uB531\uC774\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706405
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8 \uC0AC\uB78C\uB4E4\uACFC \uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uBC14\uBE44\uD050\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146372
    m_Localized: "\uBBFC\uADDC\uB294 \uD574\uAC00 \uAE30\uC6B8\uAE30 \uC804\uC5D0 \uB3CC\uC544\uAC14\uB2E4. \uB208 \uC704\uC5D0 \uBC14\uD034 \uC790\uAD6D\uC774 \uAE38\uAC8C \uB0A8\uC558\uB2E4. \uD55C \uC904\uB85C, \uB3CC\uC544\uAC00\uB294 \uCABD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340785
    m_Localized: "\uC544\uBB34 \uB9D0\uB3C4 \uBABB \uD558\uACE0 \uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174982
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB798, \uC2DD\uD310. \uADF8\uAC8C \uAF64 \uC911\uC694\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174997
    m_Localized: "\uCC3D\uACE0\uBD80\uD130 \uC815\uB9AC\uD574\uC694. \uBA39\uC744 \uAC8C \uB354 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117992
    m_Localized: "\uB3C4\uD604\uC740 \uC544\uB294 \uB178\uB798\uAC00 \uC804\uBD80 \uAC8C\uC784 \uBC30\uACBD\uC74C\uC545\uC774\uC5C8\uB2E4. \uAC00\uC0AC \uB300\uC2E0 \"\uBE60\uBC24 \uBE60\uBC24\"\uC73C\uB85C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117991
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uD569\uCC3D\uBD80\uC600\uC5B4. \uC911\uD559\uAD50 \uB54C. \uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0 \uC548 \uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174998
    m_Localized: "\uC2DD\uC790\uC7AC \uCC3D\uACE0 \uC548\uCABD, \uB72F\uC9C0 \uC54A\uC740 \uC300 \uD3EC\uB300\uC640 \uD1B5\uC870\uB9BC \uC0C1\uC790\uAC00 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174999
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC601\uC591\uC0AC \uC120\uC0DD\uB2D8\uC774 \uAF3C\uAF3C\uD558\uC168\uB124. \uAC10\uC0AC\uD558\uB2E4\uACE0 \uD574\uC57C\uACA0\uB2E4. \uC5B4\uB514 \uACC4\uC2DC\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175000
    m_Localized: "\uB3C4\uC11C\uAD00 \uC720\uB9AC\uBB38\uC5D0\uB294 '\uC815\uC219'\uC774\uB77C\uB294 \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uC5C6\uB294 \uACF3\uC5D0 \uC815\uC219\uC774\uB77C\uB2C8, \uC870\uAE08 \uC6C3\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340784
    m_Localized: "\uADF8\uB0A0 \uBC24, \uC77C\uAE30\uC7A5 \uB9E8 \uB4B7\uC7A5\uC5D0 \uC791\uAC8C \uC801\uC5C8\uB2E4. \uC4F8 \uAC83. \uC788\uC5C8\uB358 \uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340783
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB300\uC2E0 \uB9C8\uC9C0\uB9C9 \uBB38\uC7A5\uC740\u2026 \uC544\uB2C8\uB2E4. \uADF8\uAC83\uB3C4 \uB124 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117990
    m_Localized: "\uB178\uB798\uAC00 \uB05D\uB098\uC790 \uC608\uC9C0\uB294 \uC5BC\uAD74\uC744 \uBB34\uB98E\uC5D0 \uBB3B\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923610
    m_Localized: "\uC120\uBC30\uAC00 \uC758\uC790\uC5D0 \uC549\uC544 \uB0A1\uC740 \uD1B5\uAE30\uD0C0\uB97C \uBB34\uB98E\uC5D0 \uC62C\uB824\uB193\uACE0 \uC788\uC5C8\uB2E4. \uC904\uC774 \uC138 \uAC1C \uB04A\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uBB34\uB98E \uC704\uC5D0 \uC0C8 \uC904 \uAFB8\uB7EC\uBBF8\uAC00 \uC788\uC5C8\uB2E4. \uC5B4\uB514\uC11C \uAD6C\uD574 \uC654\uB294\uC9C0 \uBAA8\uB97C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340782
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB \uBB38\uC7A5\uC740 \uB124\uAC00 \uC815\uD574. \uAD6D\uC5B4 \uC120\uC0DD\uC774 \uCCAB \uBB38\uC7A5\uAE4C\uC9C0 \uC815\uD574 \uC8FC\uBA74 \uBC18\uCE59\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340781
    m_Localized: "{0}: \uC4F8\uAC8C\uC694. \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340780
    m_Localized: "\uAF2D \uC4F0\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174816
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC0AC\uAC70\uB9AC \uD30C. \uC0AC\uD0DC \uCD08\uC5D0 \uC18C\uBB38\uC744 \uB4E4\uC5C8\uC5B4. \uC0AC\uAC70\uB9AC\uB97C \uCC28\uC9C0\uD558\uACE0, \uD45C\uC2DC\uD55C \uACF3\uC744 \uCC28\uB840\uB85C \uD134\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146704
    m_Localized: "\uC218\uC2E0 \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50. \uAD50\uB0B4 \uC74C\uC218\uB300 \uC0AC\uC6A9 \uC77C\uC2DC \uC911\uC9C0 \uD611\uC870 \uC694\uCCAD. \uBC1C\uC2E0 \uC0C8\uBCBD\uC815\uC218\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923609
    m_Localized: "\uC74C\uC545\uC2E4 \uBB38\uD2C8\uC5D0\uC11C \uC190\uC804\uB4F1 \uBE5B\uC774 \uC0C8\uC5B4 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146705
    m_Localized: "\uB0A0\uC9DC\uB294 \uC0AC\uD0DC \uC0AC\uD758 \uC804. \uC5EC\uBC31\uC5D0 \uB204\uAD70\uAC00 \uC5F0\uD544\uB85C \uC801\uC5B4 \uB450\uC5C8\uB2E4. \"\uD559\uBD80\uBAA8 \uBBFC\uC6D0 \uC6B0\uB824. \uC77C\uB2E8 \uBCF4\uB958.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980509
    m_Localized: "\uBE68\uAC04 \uC0C9\uC885\uC774\uAC00 \uC5C6\uC5B4\uC11C \uD3EC\uC7A5\uC9C0\uB85C \uC811\uC5C8\uB2E4. \uC811\uB294 \uBC95\uC774 \uAC00\uBB3C\uAC00\uBB3C\uD574\uC11C \uC138 \uBC88 \uB9CC\uC5D0 \uAF43 \uBAA8\uC591\uC774 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175001
    m_Localized: "\uC11C\uAC00 \uC0AC\uC774\uB85C \uD587\uBE5B\uC774 \uAE38\uAC8C \uB4E4\uC5B4\uC654\uB2E4. \uBA3C\uC9C0\uAC00 \uCC9C\uCC9C\uD788 \uB5A0\uB2E4\uB154\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175002
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uB294\u2026 \uADF8\uB300\uB85C\uAD6C\uB098. \uC2DC\uAC04\uC774 \uBA48\uCD98 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175003
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBAA9\uBC1C\uC744 \uC138\uC6CC \uB450\uACE0 \uC11C\uAC00\uC5D0 \uAE30\uB300 \uD55C\uCC38\uC744 \uC11C \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923608
    m_Localized: "(\uCD5C\uD558\uB9B0\uC774 '\uB3D9\uB124 \uC0AC\uC815'\uC744 \uC368 \uC8FC\uAE30\uB85C \uD588\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706496
    m_Localized: "\uC0C1\uD55C \uAC83\uC744 \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987461
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC74 \uB124\uAC00 \uAC00\uC838. \uB098\uBCF4\uB2E4 \uB124\uAC00 \uB354 \uB9CE\uC774 \uAC77\uAC8C \uB420 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175004
    m_Localized: "\uB3C4\uC11C\uBD80 \uB54C \uC815\uB9AC\uD558\uB358 \uC11C\uAC00\uC600\uB2E4. \uC751\uAE09\uCC98\uCE58 \uCC45\uC740 500\uBC88\uB300, \uC18C\uC124\uC740 800\uBC88\uB300. \uB208\uC744 \uAC10\uACE0\uB3C4 \uCC3E\uC744 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786207
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB458 \uB2E4 \uD558\uBA74 \uC88B\uACA0\uC9C0\uB9CC, \uC790\uC7AC\uB3C4 \uC7A0\uB3C4 \uD55C\uC815\uB3FC \uC788\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786206
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C \uB354 \uC313\uB4E0\uC9C0, \uBC24\uC5D0 \uBC88\uAC08\uC544 \uC9C0\uD0A4\uB4E0\uC9C0 \uD574\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146706
    m_Localized: "\uB610 \uBCF4\uB958\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146371
    m_Localized: "\uB3C4\uD604\uC774 \uBBFC\uADDC\uC758 \uC790\uC804\uAC70\uB97C \uC2E0\uAE30\uD558\uB2E4\uB294 \uB4EF \uB9CC\uC84C\uB2E4. \uBBFC\uADDC\uAC00 \uCCB4\uC778\uC5D0 \uAE30\uB984 \uCE58\uB294 \uBC95\uC744 \uC54C\uB824 \uC8FC\uC5C8\uB2E4. \uB458 \uB2E4 \uC624\uB79C\uB9CC\uC5D0 \uC81C \uB098\uC774 \uAC19\uC740 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174872
    m_Localized: "{0}: \uC800\uB294 \uBAA8\uB974\uACA0\uC5B4\uC694. \uC544\uB294 \uC0AC\uB78C\uC774 \uC815\uD574 \uC8FC\uC138\uC694. \uB300\uC2E0 \uC815\uD560 \uB54C\uB9C8\uB2E4 \uC774\uC720\uB97C \uB9D0\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146707
    m_Localized: "\uBD04\uC5D0 \uCC3E\uC740 \uADF8 \uACF5\uBB38\uC774 \uB5A0\uC62C\uB790\uB2E4. \uADC0\uAC00 \uC870\uCE58 \uBCF4\uB958, \uAD50\uB0B4 \uB300\uAE30. \uADF8 \uC704\uC5D0 \uBCFC\uD39C\uC73C\uB85C \uC801\uD78C \uBCF4\uB958 \uD574\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146708
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uC6B0\uB9AC\uB294 \uD559\uAD50\uC5D0 \uB0A8\uC544 \uC788\uC73C\uB77C\uB294 \uB9D0\uC744 \uB4E4\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC26C\uB294 \uC2DC\uAC04\uB9C8\uB2E4 \uC74C\uC218\uB300 \uC55E\uC5D0 \uC904\uC744 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980510
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78 \uBAA9\uBC1C \uC190\uC7A1\uC774\uC5D0 \uAF42\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340779
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798 \uC4F4 \uAE00\uC740 \uC78A\uD600\uB3C4, \uC788\uC5C8\uB358 \uB300\uB85C \uC4F4 \uAE00\uC740 \uB0A8\uB294\uB2E4. \uAD6D\uC5B4 \uC120\uC0DD \uC2ED \uB144\uC5D0 \uADF8\uAC70 \uD558\uB098 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340778
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB204\uAC00 \uBB34\uC5C7\uC744 \uC54C\uACE0 \uC788\uC5C8\uB294\uC9C0, \uC6B0\uB9AC\uAC00 \uC5B4\uB5BB\uAC8C \uBC84\uD17C\uB294\uC9C0. \uADF8\uB9AC\uACE0 \uB124\uAC00 \uC5B4\uB5BB\uAC8C \uCEF8\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340777
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 1\uB144\uC744 \uAE00\uB85C \uB0A8\uACA8 \uC918. \uC798 \uC4F0\uB824\uACE0 \uD558\uC9C0 \uB9D0\uACE0, \uC788\uC5C8\uB358 \uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146709
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uC55E\uC5D0 \uC549\uC544, \uBB38 \uB108\uBA38\uB85C \uC11C\uB958\uB97C \uC77D\uC5B4 \uB4DC\uB838\uB2E4. \uD55C\uCC38 \uB4A4\uC5D0 \uB300\uB2F5\uC774 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146370
    m_Localized: "\uBBFC\uADDC: \uACE0\uB9C8\uC6CC\uC694. \uADF8 \uB9D0 \uC9C1\uC811 \uD558\uACE0 \uC2F6\uC5C8\uC5B4\uC694. \uBB34\uC804\uAE30 \uB9D0\uACE0, \uC5BC\uAD74 \uBCF4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340776
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD80\uD0C1\uC774 \uD558\uB098 \uC788\uB2E4. \uC120\uC0DD\uC73C\uB85C\uC11C\uAC00 \uC544\uB2C8\uB77C, \uADF8\uB0E5 \uC0AC\uB78C\uC73C\uB85C\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923607
    m_Localized: "\uADF8\uAC74 \uAC70\uC808\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uD558\uB9B0\uB3C4 \uADF8\uAC78 \uC544\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340775
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uC774\uB9C8\uC758 \uBB3C\uC218\uAC74\uC744 \uB0B4\uB9AC\uACE0 \uB098\uB97C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340774
    m_Localized: "\uBE48 \uC758\uC790 \uD558\uB098\uD558\uB098\uC5D0 \uB204\uAD70\uAC00\uAC00 \uC549\uC544 \uC788\uC5C8\uC744 \uAC83\uC774\uB2E4. \uADF8 \uC0AC\uB78C\uB4E4\uC744 \uC0DD\uAC01\uD558\uBA70 \uD55C\uCC38 \uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340773
    m_Localized: "\uBE48 \uC758\uC790\uB4E4 \uC0AC\uC774\uC5D0 \uC870\uC6A9\uD788 \uC549\uC544 \uC788\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340772
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB108\uD76C\uB294 \uC774 \uD559\uAD50\uC758 \uB9C8\uC9C0\uB9C9 \uD559\uAE30\uB97C \uB05D\uAE4C\uC9C0 \uB2E4\uB154\uB2E4. \uADF8\uAC78\uB85C \uCDA9\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340771
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6B0\uB9AC \uC774\uB984\uC744 \uD558\uB098\uC529 \uBD88\uB800\uB2E4. \uC878\uC5C5\uD558\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uC9C0\uB9CC, \uB2E4\uB4E4 \uC55E\uC73C\uB85C \uB098\uAC00 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340768
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uD720\uCCB4\uC5B4 \uB300\uC2E0 \uB04C\uACE0 \uC628 \uC0AC\uBB34\uC6A9 \uC758\uC790\uC5D0 \uC549\uC544 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340767
    m_Localized: "\uC120\uC0DD\uB2D8\uC744 \uB2F4\uC694\uC9F8 \uB9E4\uD2B8\uC5D0 \uB215\uD600 \uAC15\uB2F9 \uC55E\uC73C\uB85C \uC62E\uACBC\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBCA0\uAC1C\uB97C \uBC1B\uCCD0 \uB2EC\uB77C\uACE0 \uD588\uB2E4. \uC6B0\uB9AC\uB97C \uBCFC \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340766
    m_Localized: "\uAC15\uB2F9\uC5D0 \uC758\uC790\uB97C \uBA87 \uAC1C \uB193\uC558\uB2E4. 3\uD559\uB144 \uC120\uBC30\uB4E4\uC758 \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175006
    m_Localized: "\uC218\uD559, \uACFC\uD559, \uADF8\uB9AC\uACE0 '\uC751\uAE09\uCC98\uCE58 \uD578\uB4DC\uBD81'. \uAC00\uBC29\uC774 \uAE08\uBC29 \uBB34\uAC70\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591892
    m_Localized: "\uB2E4\uC12F\uC9F8 \uB0A0\uC758 \uADF8 \uC18C\uB9AC\uC640\uB294 \uB2EC\uB790\uB2E4. \uB04C\uACE0, \uBA48\uCD94\uACE0, \uC228\uC744 \uACE0\uB974\uACE0, \uB2E4\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654296
    m_Localized: "\uCC98\uC74C\uC73C\uB85C '\uC694\uB9AC'\uB77C\uACE0 \uBD80\uB97C \uB9CC\uD55C \uAC83\uC774 \uADF8\uB987\uC5D0 \uB2F4\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563781
    m_Localized: "\uC6C3\uC74C\uC740 \uB0B4\uAC00 \uBB34\uB108\uC9C0\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC950\uACE0 \uC788\uB358 \uAC70\uC600\uB2E4. \uADF8\uAC78 \uD5C8\uB77D\uC73C\uB85C \uC77D\uC740 \uAC74 \uADF8 \uC560\uB4E4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563782
    m_Localized: "\uCD5C\uD558\uB9B0: \uB108 \uB9E8\uB0A0 \uB3C4\uB9DD\uCCE4\uC796\uC544. \uC885 \uCE58\uC790\uB9C8\uC790. \uADF8\uB7EC\uB2C8\uAE4C \uCAD3\uC544\uAC00\uB294 \uAC8C \uBB34\uC2A8 \uB180\uC774\uCC98\uB7FC\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923589
    m_Localized: "{0}: \uC65C \uC54C\uB824 \uC8FC\uB294 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923590
    m_Localized: "\uD558\uB9B0\uC740 \uBD84\uD544\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117977
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uAC70\uAE30 \uB9D0\uACE0. \uC5EC\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117978
    m_Localized: "\uC774\uAE30\uACE0 \uC9C0\uB294 \uAC83\uBCF4\uB2E4, \uC608\uC9C0\uAC00 \uC624\uB298 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4 \uC6C3\uC740 \uAC8C \uB354 \uAE30\uC5B5\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117979
    m_Localized: "\uC120\uBC30\uB294 \uCE74\uB4DC\uB97C \uBC1B\uC790 \uD55C\uCC38 \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4\uAC00, \uD55C \uC7A5\uC529 \uC544\uC8FC \uCC9C\uCC9C\uD788 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460159
    m_Localized: "\uACE0\uAC1C\uB97C \uAC00\uB85C\uC800\uC5C8\uB2E4. \uB9D0\uC744 \uC548 \uD558\uB294 \uAC74\uC9C0 \uBABB \uD558\uB294 \uAC74\uC9C0, \uC544\uBB34\uB3C4 \uBB3B\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591891
    m_Localized: "\uC77C\uACF1\uC9F8 \uB0A0 \uC0C8\uBCBD. \uBB38 \uB108\uBA38\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uAE30\uC5B4 \uC624\uB294 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987448
    m_Localized: "\uBB38\uC774 \uC5F4\uB838\uB2E4. \uB208\uC774 \uBD80\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117980
    m_Localized: "\uB9D0\uC774 \uC5C6\uB294 \uB300\uC2E0 \uD45C\uC815\uC774 \uB2E4 \uB9D0\uD574 \uC8FC\uC5C8\uB2E4. \uC88B\uC740 \uD328\uAC00 \uB4E4\uC5B4\uC624\uBA74 \uB208\uC379\uC774 \uC544\uC8FC \uC870\uAE08 \uC62C\uB77C\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117981
    m_Localized: "\uADF8\uAC78 \uC54C\uC544\uCC48 \uB4A4\uB85C \uB098\uB294 \uD55C \uBC88\uB3C4 \uC774\uAE30\uC9C0 \uBABB\uD588\uB2E4. \uC120\uBC30\uB3C4 \uADF8\uAC78 \uC544\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826572
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6D0\uACE0\uB97C \uBC1B\uC544 \uB4E4\uACE0, \uC624\uB798 \uD3B4 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563783
    m_Localized: "\uD558\uB9B0\uC740 \uB9D0\uC744 \uB05D\uB9FA\uC9C0 \uBABB\uD588\uB2E4. \uB05D\uB9FA\uC5B4\uC11C\uB294 \uC548 \uB418\uB294 \uB9D0\uC774\uB77C\uB294 \uAC78 \uC544\uB294 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563784
    m_Localized: "\uB3C4\uB9DD\uCE5C \uAC8C \uC544\uB2C8\uC5C8\uB2E4. \uC0B4\uC544\uB0A8\uB294 \uAE38\uC744 \uBA3C\uC800 \uCC3E\uC740 \uAC70\uC600\uB2E4. \uADF8 \uAC78\uC74C\uC774 \uB098\uB97C \uC5EC\uAE30\uAE4C\uC9C0 \uB370\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563785
    m_Localized: "\uCD5C\uD558\uB9B0: \uADF8\uB0A0 \uC544\uCE68\uC5D0\u2026 \uB108 \uB098 \uB611\uBC14\uB85C \uBD24\uC9C0. \uD6A1\uB2E8\uBCF4\uB3C4\uC5D0\uC11C. \uADF8\uAC8C \uC774\uC0C1\uD558\uAC8C \uACC4\uC18D \uC0DD\uAC01\uB0AC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369097
    m_Localized: "\uAD50\uD0C1 \uC11C\uB78D\uC5D0\uC11C \uC2E4\uD5D8 \uB178\uD2B8 \uD55C \uAD8C\uC774 \uB098\uC654\uB2E4. \uC0AC\uD0DC \uC9C1\uC804 \uBA70\uCE60\uC758 \uAE30\uB85D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369096
    m_Localized: "\uCE60\uD310\uC5D0\uB294 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC758 \uD310\uC11C\uAC00 \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uC5EC\uACFC, \uC99D\uB958, \uADF8\uB9AC\uACE0 '\uB2E4\uC74C \uC2DC\uAC04 \uC2E4\uD5D8 \uC900\uBE44\uBB3C'."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706402
    m_Localized: "\uAC1C\uC6B8\uBB3C\uC740 \uC190\uC774 \uC800\uB9B4 \uB9CC\uD07C \uCC28\uAC00\uC6E0\uB2E4. \uBB3C\uD1B5 \uAC00\uB4DD \uBC1B\uC544 \uC654\uB2E4. \uB053\uC774\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369095
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uB354\uC704\uBA74 \uBB3C\uC774 \uAE08\uBC29 \uBC14\uB2E5\uB098. \uC5EC\uAE30\uB77C\uBA74 \uC815\uC218\uAE30\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369094
    m_Localized: "\uACFC\uD559\uC2E4 \uBB38\uC744 \uC5F4\uC790 \uC54C\uCF54\uC62C \uB0C4\uC0C8\uAC00 \uD76C\uBBF8\uD558\uAC8C \uB0AC\uB2E4. \uC2E4\uD5D8\uB300 \uC704\uC5D0 \uBE44\uCEE4\uAC00 \uC904\uC9C0\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369093
    m_Localized: "\uCCB4\uC721\uAD00 \uC815\uBB38\uC5D0 \uC1E0\uC0AC\uC2AC\uC744 \uAC10\uACE0, \uB4B7\uBB38 \uCABD\uC5D0 \uD0C8\uCD9C\uB85C\uB97C \uB0C8\uB2E4. \uBC24\uC5D0\uB3C4 \uC228\uC5B4\uB4E4 \uACF3\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711567
    m_Localized: "\uC218\uC5C5 \uC900\uBE44\uB97C \uD558\uB2E4\uAC00 \uAD50\uD0C1 \uC11C\uB78D\uC5D0\uC11C \uC587\uC740 \uCD9C\uC11D\uBD80\uAC00 \uB098\uC654\uB2E4. 1\uD559\uB144 4\uBC18."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923591
    m_Localized: "\uCD5C\uD558\uB9B0: \uB0B4\uAC00 \uC544\uB294 \uAC8C \uC774\uB7F0 \uAC83\uBC16\uC5D0 \uC5C6\uC5B4\uC11C. \uB0A8 \uAD34\uB86D\uD788\uB294 \uAE38, \uC228\uB294 \uAE38. \uADF8\uAC70\uB77C\uB3C4 \uC4F8\uBAA8 \uC788\uAC8C \uC4F0\uACE0 \uC2F6\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923592
    m_Localized: "\uD574 \uC9C8 \uB158 \uC625\uC0C1. \uD558\uB9B0\uC774 \uB0A1\uC740 \uBCA4\uCE58 \uB05D\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uB09C\uAC04\uC5D0\uC11C \uBA40\uCC0D\uC774. \uB098\uB3C4 \uBC18\uB300\uCABD \uB05D\uC5D0 \uC549\uC558\uB2E4. \uD55C \uD314 \uAC70\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987449
    m_Localized: "???: \u2026\uC0B4\uC544 \uC788\uAD6C\uB098. \uB2E4\uD589\uC774\uB2E4. \uC815\uB9D0 \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146718
    m_Localized: "\uC0AC\uD0DC \uC5F4\uD558\uB8E8 \uC804. \uC5F0\uAD6C\uB3D9 \uD654\uC774\uD2B8\uBCF4\uB4DC\uC758 \uBA54\uBAA8. \uC2DC\uB8CC B-7, \uBC18\uC751 \uC774\uC0C1. \uBCF4\uACE0\uD588\uC73C\uB098 \uBB35\uC0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369092
    m_Localized: "\uBE44\uC0C1\uC2DC \uB300\uD53C\uC18C\uB85C \uBB38\uC744 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146369
    m_Localized: "\uBBFC\uADDC: \uADF8\uB0A0 \uBC30\uC218\uB85C\uC5D0\uC11C\u2026 \uC9C4\uC9DC \uB05D\uC778 \uC904 \uC54C\uC558\uAC70\uB4E0\uC694. \uB2E4\uB9AC\uB294 \uC544\uC9C1 \uC774\uB798\uC694. \uADF8\uB798\uB3C4 \uC790\uC804\uAC70\uB294 \uD0C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757774
    m_Localized: "\uADF8\uB294 \uD55C\uCC38 \uD559\uAD50 \uAC74\uBB3C\uC744 \uC62C\uB824\uB2E4\uBCF4\uB2E4\uAC00 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757775
    m_Localized: "\uD558\uB8FB\uBC24 \uCCB4\uC721\uAD00\uC5D0\uC11C \uC7AC\uC6CC \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757776
    m_Localized: "\uBC24\uC0C8 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4. \uC544\uCE68\uC5D0 \uADF8\uAC00 \uC549\uC558\uB358 \uB9E4\uD2B8 \uC704\uC5D0 \uC811\uD78C \uC9C0\uB3C4 \uD55C \uC7A5\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786237
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uCC3D\uACE0\uB294 \uB9C8\uC9C0\uB9C9 \uB0A0\uC5D0\uC57C \uAC14\uC5B4. \uAC70\uAE30 \uB204\uAC00 \uC788\uC744 \uAC70\uB77C\uACE0\uB294\u2026 \uC0DD\uAC01\uC744 \uBABB \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146365
    m_Localized: "\uC9D0\uBC1B\uC774\uC5D0 \uBB36\uC778 \uC0C1\uC790 \uC704\uB85C \uB208\uC774 \uC18C\uBCF5\uC774 \uC313\uC5EC \uC788\uC5C8\uB2E4. UBC \uCABD\uC5D0\uC11C\uBD80\uD130 \uB0B4\uB0B4 \uB04C\uACE0 \uC654\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174875
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC0C1\uCC98\uB294 \uB2E4 \uC544\uBB3C\uC5C8\uC5B4\uC694. \uC774\uC81C \uBAA9\uBC1C \uB9D0\uACE0 \uB2E4\uB978 \uAC83\uB3C4 \uC0DD\uAC01\uD574 \uBCFC \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786200
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC758\uC6D0 \uB300\uAE30\uC2E4\uC5D4 \uC0AC\uB78C\uC774 \uB9CE\uC558\uC744 \uAC70\uC57C. \uADF8 \uB9D0\uC740\u2026 \uBB34\uB9AC\uAC00 \uC788\uC744 \uAC70\uB77C\uB294 \uB73B\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786201
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0\uB9CC \uC5F4\uB9AC\uB294 \uACF3\uB3C4 \uC788\uC744 \uAC70\uC57C. \uC57D\uD488\uACE0 \uAC19\uC740 \uB370\uB294 \uB0AE\uC5D4 \uC154\uD130\uAC00 \uB0B4\uB824\uAC00 \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563786
    m_Localized: "\uADF8\uB0A0\uCC98\uB7FC \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uC558\uB2E4. \uBCF4\uB294 \uAC83\uACFC \uC8FC\uBA39\uC744 \uC950\uB294 \uAC83\uC740 \uB2E4\uB974\uB2E4\uACE0, \uC18D\uC73C\uB85C \uD55C \uBC88 \uB354 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563787
    m_Localized: "\uC190\uC774 \uB5A8\uB838\uB2E4. \uCC3D\uACE0 \uBB38 \uB108\uBA38\uB85C \uB4E4\uB9AC\uB358 \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB9AC\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146366
    m_Localized: "\uBBFC\uADDC: \uBE5A \uAC1A\uC73C\uB7EC \uC654\uC5B4\uC694. DJ \uB204\uB098\uAC00 \uAF2D \uC9C1\uC811 \uAC00\uB77C\uACE0 \uD574\uC11C\uC694. \uBB34\uC804\uC73C\uB85C \uD558\uBA74 \uBC18\uCE59\uC774\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987450
    m_Localized: "\uBAA9\uC18C\uB9AC\uC758 \uC8FC\uC778\uC740 \uBC14\uB2E5\uC5D0 \uC549\uC740 \uCC44 \uBCBD\uC5D0 \uB4F1\uC744 \uAE30\uB300\uACE0 \uC788\uC5C8\uB2E4. \uD55C\uCABD \uBC14\uC9C0 \uC790\uB77D\uC774 \uBB34\uB98E \uC544\uB798\uC5D0\uC11C \uBD95\uB300\uB85C \uBB36\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923593
    m_Localized: "\uD55C\uCC38 \uB458 \uB2E4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uD558\uB9B0\uC774 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uBB54\uAC00\uB97C \uAEBC\uB0B4 \uC190\uBC14\uB2E5\uC5D0 \uC62C\uB838\uB2E4. \uC2F8\uAD6C\uB824 \uB098\uBE44 \uBA38\uB9AC\uD540\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923594
    m_Localized: "\uB098\uB294 \uADF8\uAC78 \uC54C\uC544\uBCF4\uC558\uB2E4. \uB0B4 \uAC83\uC774\uC5C8\uB2E4. \uD559\uAE30 \uCD08\uC5D0 \uD558\uB9B0\uC5D0\uAC8C \uBE7C\uC557\uAE30\uACE0 \uB05D\uB0B4 \uB3CC\uB824\uBC1B\uC9C0 \uBABB\uD55C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146717
    m_Localized: "\uBC24. \uBAA8\uB450 \uC7A0\uB4E0 \uB4A4, \uBAA8\uC740 \uAC83\uB4E4\uC744 \uAD50\uC2E4 \uBC14\uB2E5\uC5D0 \uB0A0\uC9DC \uC21C\uC11C\uB300\uB85C \uB298\uC5B4\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563788
    m_Localized: "\uADF8\uB798\uB3C4 \uC228\uC744 \uC26C\uC5C8\uB2E4. \uD558\uB098, \uB458, \uC14B."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460239
    m_Localized: "\uCCA0\uBB38\uC774 \uB4F1 \uB4A4\uC5D0\uC11C \uB2EB\uD614\uB2E4. \uC228\uC744 \uBAB0\uC544\uC26C\uBA70 \uC6B4\uB3D9\uC7A5\uC5D0 \uC8FC\uC800\uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460238
    m_Localized: "\uADF8\uB300\uB85C \uB6F0\uC5B4 \uB4E4\uC5B4\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146716
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB124\uAC00 \uB4E4\uACE0 \uAC00\uB77C. \uC774\uBC88\uC5D0\uB294 \uC544\uBB34\uB3C4 \uBCF4\uB958\uD558\uC9C0 \uBABB\uD558\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923595
    m_Localized: "\uCD5C\uD558\uB9B0: \uBC84\uB9AC\uB824\uACE0 \uD588\uB294\uB370 \uBABB \uBC84\uB838\uC5B4. \uADF8\uB0A0 \uC774\uD6C4\uB85C \uACC4\uC18D \uAC00\uC9C0\uACE0 \uB2E4\uB154\uC5B4. \uC65C\uC778\uC9C0 \uBAA8\uB974\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923596
    m_Localized: "\uCD5C\uD558\uB9B0: \uB3CC\uB824\uC900\uB2E4\uACE0 \uBB50\uAC00 \uB418\uB294 \uAC70 \uC544\uB2C8\uB77C\uB294 \uAC70 \uC54C\uC544. \uBBF8\uC548\uD558\uB2E4\uACE0 \uD574\uB3C4, \uADF8\uB0A0\uC774 \uC5C6\uC5B4\uC9C0\uB294 \uAC83\uB3C4 \uC544\uB2C8\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987451
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4\uB2F4\uB2F9 \uC724\uC601\uD604\uC774\uC57C. 1\uD559\uB144 \uC218\uC5C5\uC740 \uC544\uC9C1 \uD55C \uBC88\uB3C4 \uBABB \uB4E4\uC5B4\uAC14\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460160
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB798. \uC774\uB984\uC740 \uB9D0\uD558\uACE0 \uC2F6\uC744 \uB54C \uB9D0\uD574\uB77C. \uADF8\uB54C\uAE4C\uC9C4 2\uD559\uB144\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923597
    m_Localized: "\uCD5C\uD558\uB9B0: \uBC1B\uB4E0 \uC548 \uBC1B\uB4E0 \uB124\uAC00 \uC815\uD574. \uC548 \uBC1B\uC544\uB3C4 \uB3FC. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923598
    m_Localized: "\uD558\uB9B0\uC740 \uB098\uB97C \uBCF4\uC9C0 \uC54A\uC558\uB2E4. \uD540\uC744 \uC62C\uB9B0 \uC190\uBC14\uB2E5\uB9CC \uB0B4\uBC00\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923599
    m_Localized: "\uCD5C\uD558\uB9B0: \uADF8\uB9AC\uACE0 \uD558\uB098\uB9CC. \uC0AC\uAC70\uB9AC \uC0AC\uB78C\uB4E4 \uACF5\uBB3C, \uB0B4\uAC00 \uC598\uAE30\uD558\uBA74 \uC880 \uC904\uC5B4. \uADF8 \uC0AC\uB78C\uB4E4 \uC57D\uC810 \uB2E4 \uC54C\uAC70\uB4E0. \uC774\uAC74 \uBBF8\uC548\uD574\uC11C \uD558\uB294 \uAC70 \uC544\uB2C8\uC57C. \uC5EC\uAE30 \uC0B4\uB824\uACE0 \uD558\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923600
    m_Localized: "\uBA38\uB9AC\uD540\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923601
    m_Localized: "\uD540\uC744 \uC9D1\uC5C8\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uAC00\uBCBC\uC6E0\uB2E4. \uADF8\uB807\uAC8C \uC624\uB798 \uBB34\uAC70\uC6E0\uB358 \uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146715
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB204\uAD6C \uC798\uBABB\uC774\uB0D0\uBCF4\uB2E4, \uC774\uAC78 \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uB4E4\uACE0 \uAC00\uB290\uB0D0\uAC00 \uC911\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369091
    m_Localized: "\uCF54\uD2B8 \uB05D\uC5D0\uC11C \uB05D\uAE4C\uC9C0 \uD55C \uBC88 \uB2EC\uB824 \uBD24\uB2E4. \uB2E4\uB9AC\uAC00 \uBA3C\uC800 \uCD9C\uBC1C\uC120\uC744 \uCC3E\uC558\uB2E4. \uC721\uC0C1\uBD80 \uB54C \uBAB8\uC774 \uC544\uC9C1 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369090
    m_Localized: "\uC904\uB118\uAE30, \uD314\uAD7D\uD600\uD3B4\uAE30, \uB9E4\uD2B8 \uC704 \uAD6C\uB974\uAE30. \uCCB4\uC721 \uC2DC\uAC04\uC774 \uC774\uB807\uAC8C \uBC18\uAC00\uC6B8 \uC904\uC740 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369089
    m_Localized: "\uB9E4\uD2B8\uB97C \uAE54\uACE0 \uD6C8\uB828\uC7A5\uC73C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923602
    m_Localized: "\uC6A9\uC11C\uD55C\uB2E4\uACE0 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uD558\uB9B0\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB9CC \uB458 \uB2E4 \uD574\uAC00 \uB2E4 \uC9C8 \uB54C\uAE4C\uC9C0 \uADF8 \uC790\uB9AC\uC5D0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826501
    m_Localized: "DJ: \u2026\uACE0\uB9C8\uC6CC\uC694. \uC774\uAC74 \uC6B0\uB9AC\uAC00 \uC77D\uB294 \uAC83\uBCF4\uB2E4 \uD559\uAD50 \uCE5C\uAD6C\uB4E4\uC774 \uC77D\uB294 \uAC8C \uB354 \uC798 \uB2FF\uC744 \uAC83 \uAC19\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786188
    m_Localized: "\uAC00\uC838\uC628 \uC11C\uB958\uB294 \uC0AC\uD0DC \uC0AC\uD758 \uC804 \uB0A0\uC9DC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369088
    m_Localized: "{0}: \u2026\uC544\uB2C8\uC694. \uAD1C\uCC2E\uC544\uC694. \uC5EC\uAE30, \uC368\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174924
    m_Localized: "\uC544\uCE68, \uC2DD\uB7C9 \uC0C1\uC790 \uC55E\uC5D0\uC11C \uBAA9\uC18C\uB9AC\uAC00 \uB192\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591888
    m_Localized: "\uC785\uAF2C\uB9AC\uAE4C\uC9C0 \uC62C\uB77C\uAC00 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uC548 \uBCF4\uB294 \uB370\uC11C\uB3C4 \uC6C3\uB294 \uC5BC\uAD74\uC774 \uB418\uB294 \uAC8C, \uC870\uAE08 \uC6B0\uC2A4\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591889
    m_Localized: "\uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uAE08\uC744 \uD558\uB098 \uB354 \uADF8\uC5C8\uB2E4. \uC5EC\uC12F."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175022
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544? \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB9CC \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757777
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098 \uBCF4\uB2C8 \uAE09\uC2DD\uC2E4 \uCC3D\uACE0 \uC790\uBB3C\uC1E0\uAC00 \uBD80\uC11C\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757778
    m_Localized: "\uC2DD\uB7C9\uACFC \uBB3C\uC774 \uB208\uC5D0 \uB744\uAC8C \uC904\uC5B4 \uC788\uC5C8\uB2E4. \uBC14\uB2E5\uC5D0 \uC9C4\uD759 \uBB3B\uC740 \uB4F1\uC0B0\uD654 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174874
    m_Localized: "\uBC24. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC724 \uC120\uC0DD\uB2D8\uC758 \uBAA9\uBC1C \uB192\uC774\uB97C \uC7AC\uACE0 \uC788\uC5C8\uB2E4. \uC904\uC790\uB97C \uB4E4\uACE0, \uBB34\uB98E \uC544\uB798\uB97C \uC624\uB798 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591890
    m_Localized: "{0}: \u2026\uC870\uAE08\uB9CC \uB354."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146568
    m_Localized: "DJ\uAC00 \uB9D0\uD588\uB358 \uADF8\uACF3. \uC5F0\uB77D\uC774 \uB04A\uAE30\uBA74 \uAE30\uB85D\uC740 \uC9C0\uD558\uC5D0 \uC788\uB2E4\uACE0 \uD588\uB358 \uC5F0\uAD6C\uC6D0\uC758 \uC77C\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923668
    m_Localized: "{0}: \uC65C \uD55C\uACF3\uC5D0 \uC548 \uACC4\uC138\uC694? \uC5EC\uAE30 \uAC19\uC740 \uB370\uB3C4 \uC788\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146367
    m_Localized: "\uADF8\uAC00 \uC0C1\uC790\uB97C \uB0B4\uB824\uB193\uC558\uB2E4. \uC57D\uD488\uACFC \uD1B5\uC870\uB9BC, \uADF8\uB9AC\uACE0 \uB9E8 \uC704\uC5D0 \uC811\uD78C \uC885\uC774 \uD55C \uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174938
    m_Localized: "\uC7A0\uC2DC \uC870\uC6A9\uD574\uC84C\uB2E4. \uADF8\uB0A0 \uC800\uB141, \uC120\uC0DD\uB2D8\uC774 \uC790\uAE30 \uBAAB\uC758 \uBC18\uC744 \uB0B4 \uADF8\uB987\uC5D0 \uC2AC\uCA4D \uB35C\uC5B4 \uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786202
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uBCF4\uB2E4 \uB124\uAC00 \uBA3C\uC800\uC57C. \uC54C\uC9C0? \uBE48\uC190\uC73C\uB85C \uC640\uB3C4 \uB3FC. \uC5BC\uAD74\uB9CC \uBCF4\uC5EC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786203
    m_Localized: "\uB3C4\uD604\uC774 \uB2F4\uC694\uB97C \uBA38\uB9AC\uB05D\uAE4C\uC9C0 \uB4A4\uC9D1\uC5B4\uC4F4 \uCC44 \uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175021
    m_Localized: "\uC228\uC774 \uC870\uAE08 \uAC00\uBE60\uC84C\uB2E4. \uC77C\uBD80\uB7EC \uADF8\uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175020
    m_Localized: "\uADF8\uB9AC\uACE0 \uC800 \uC548\uCABD, \uCCB4\uC721\uCC3D\uACE0 \uBB38. \uB179\uC0C9 \uCCA0\uBB38\uC774 \uB2EB\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175019
    m_Localized: "\uB18D\uAD6C \uACE8\uB300\uC5D0 \uAC78\uB9B0 \uACF5 \uD558\uB098\uAC00 \uADF8\uB300\uB85C\uC600\uB2E4. \uCF54\uD2B8 \uD55C\uAC00\uC6B4\uB370 \uB9E4\uD2B8\uAC00 \uAE54\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369149
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8 \uB9D0 \uD558\uB294 \uC5BC\uAD74, \uCC98\uC74C \uBCF8\uB2E4. \uBCF4\uC5EC \uC918\uC11C \uACE0\uB9D9\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369148
    m_Localized: "\uCC98\uC74C\uC73C\uB85C \uC6C3\uC9C0 \uC54A\uACE0 \uADF8 \uB9D0\uC744 \uD588\uB2E4. \uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC84C\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uADF8 \uAC08\uB77C\uC9C4 \uC18C\uB9AC\uAE4C\uC9C0 \uB2E4 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923667
    m_Localized: "\uC65C \uACC4\uC18D \uAC77\uB290\uB0D0\uACE0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923666
    m_Localized: "\uC720\uB791\uC790: \uB410\uB2E4. \uC774\uC81C \uB108\uB294 \uC548 \uC783\uC5B4\uBC84\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826521
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800 \uC18C\uB9AC\uAC00 \uC6B0\uB9AC \uB300\uC2E0 \uAE68\uC5B4 \uC788\uC5B4 \uC904 \uAC70\uC57C. \uC624\uB298\uC740 \uC870\uAE08 \uB354 \uC790\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654295
    m_Localized: "\uB0C4\uBE44\uC5D0\uC11C \uAE40\uC774 \uC62C\uB77C\uC654\uB2E4. \uC300 \uD55C \uC90C\uC5D0 \uBB3C\uC744 \uB109\uB109\uD788 \uBD93\uACE0, \uC18C\uAE08\uC744 \uC544\uC8FC \uC870\uAE08."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174925
    m_Localized: "\uB3C4\uD604: \uC608\uC9C0 \uB204\uB098\uAC00 \uC5B4\uC81C \uBC24\uC5D0 \uD558\uB098 \uB354 \uBA39\uC5C8\uC796\uC544\uC694! \uC81C\uAC00 \uBD24\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117987
    m_Localized: "\uB450 \uBC88\uC9F8\uC5D4 \uB9DE\uC558\uB2E4. \uC120\uBC30\uB294 \uC18C\uB9AC \uC5C6\uC774 \uC785 \uBAA8\uC591\uC73C\uB85C \uAC00\uC0AC\uB97C \uB530\uB77C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117986
    m_Localized: "\uB0B4\uAC00 \uC544\uB294 \uB178\uB798\uB97C \uBD80\uB974\uC790 \uC120\uBC30\uAC00 \uCF54\uB4DC\uB97C \uCC3E\uC544 \uB530\uB77C\uC654\uB2E4. \uD2C0\uB9B0 \uC74C\uC5D0\uC11C \uC120\uBC30\uAC00 \uACE0\uAC1C\uB97C \uC0B4\uC9DD \uAE30\uC6B8\uC600\uB2E4. \uB2E4\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175018
    m_Localized: "\uCCB4\uC721\uAD00\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uBC1D\uC558\uB2E4. \uB192\uC740 \uCC3D\uC73C\uB85C \uD587\uBE5B\uC774 \uC3DF\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175017
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC548 \uAC00\uB3C4 \uB3FC. \uADF8 \uBB38\uC740 \uC6B0\uB9AC\uAC00 \uB2E4\uC2DC \uC5F4 \uD544\uC694 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175016
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uD39C\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175015
    m_Localized: "{0}: \uCCB4\uC721\uAD00 \uCC3D\uACE0\uB294\u2026 \uC548 \uAC00\uB3C4 \uB418\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175014
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uAD00\uC740 \uB113\uACE0 \uBB38\uC774 \uB450\uAEBC\uC6CC. \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE30\uBA74 \uD53C\uD560 \uACF3\uC774 \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175013
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE09\uC2DD\uC2E4, \uB3C4\uC11C\uAD00, \uADF8\uB9AC\uACE0 \uCCB4\uC721\uAD00. \uB0A0\uC774 \uB354 \uB354\uC6CC\uC9C0\uAE30 \uC804\uC5D0 \uB2E4 \uC5F4\uC5B4 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369147
    m_Localized: "{0}: \u2026\uC544\uB2C8\uC694. \uC548 \uAD1C\uCC2E\uC558\uC5B4\uC694. \uD558\uB098\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146368
    m_Localized: "'\uD559\uAD50 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C. \uC2E0\uCCAD\uACE1\uC740 \uC544\uC9C1 \uBC1B\uC544\uC694.' DJ\uC758 \uAE00\uC528\uC600\uB2E4. \uBAA9\uC18C\uB9AC\uCC98\uB7FC \uB3D9\uAE00\uB3D9\uAE00\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786204
    m_Localized: "\uB3C4\uD604: \u2026\uB610 \uC640\uC694? \uC624\uB298 \uBC24\uC5D0\uB3C4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175007
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC219\uC81C \uB9CE\uC774 \uB0B4 \uC904 \uAC70\uB2E4. \uAC01\uC624\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460161
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: {0}, \uB124\uAC00 \uB370\uB824\uC654\uC73C\uB2C8 \uB124\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460162
    m_Localized: "\uBC1B\uC544\uB4E4\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923603
    m_Localized: "\uC544\uC9C1\uC740 \uBC1B\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923604
    m_Localized: "{0}: \uC544\uC9C1\uC740 \uC544\uB2C8\uC57C. \uB124\uAC00 \uAC16\uACE0 \uC788\uC5B4. \uB0B4\uAC00 \uB2EC\uB77C\uACE0 \uD560 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174927
    m_Localized: "\uB3C4\uD604: \uC800\uB9CC \uB9E8\uB0A0 \uC801\uAC8C \uBC1B\uB294 \uAC83 \uAC19\uC544\uC694. \uC800\uB3C4 \uC77C\uD558\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175012
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uD3C9\uBA74\uB3C4\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uB354 \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175011
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC18\uB0A9 \uAE30\uD55C\uC740 \uC5C6\uB2E4. \uCC9C\uCC9C\uD788 \uC77D\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175010
    m_Localized: "{0}: \uC77C\uACF1 \uBC88\uC9F8\uB294 \uB098\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175009
    m_Localized: "\uD45C\uC9C0\uAC00 \uB2F3\uC740 \uCCAD\uC18C\uB144 \uC18C\uC124. \uB300\uCD9C \uCE74\uB4DC\uC5D0 \uC774\uB984\uC774 \uC5EC\uC12F \uAC1C \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591908
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD2C0\uB824\uB3C4 \uB3FC. \uC5EC\uAE30\uC5D4 \uC810\uC218\uAC00 \uC5C6\uC73C\uB2C8\uAE4C. \uCC9C\uCC9C\uD788, \uD55C \uC904\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369207
    m_Localized: "\uB4E4\uC5B4\uAC00\uC11C \uBB34\uC2A8 \uB73B\uC778\uC9C0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563657
    m_Localized: "\uC548\uC5D0\uC11C \uCD5C\uD558\uB9B0\uC774 \uB9E4\uD2B8 \uC704\uC5D0 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBD88\uC740 \uCF1C\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563656
    m_Localized: "\uBC24, \uD654\uC7A5\uC2E4 \uAC00\uB294 \uAE38\uC5D0 \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC774 \uC870\uAE08 \uC5F4\uB824 \uC788\uB294 \uAC78 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563515
    m_Localized: "\uC0AC\uB78C\uC774 \uBB34\uC12D\uC9C0 \uC54A\uC740 \uACE0\uC591\uC774\uC600\uB2E4. \uC544\uB2C8\uBA74, \uC0AC\uB78C\uC744 \uAE30\uB2E4\uB9AC\uB294 \uB370 \uC775\uC219\uD55C \uACE0\uC591\uC774\uC600\uAC70\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563644
    m_Localized: "\uC544\uBB34\uD558\uACE0\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uBC25\uB3C4 \uC81C\uC77C \uB9C8\uC9C0\uB9C9\uC5D0, \uAD6C\uC11D\uC5D0\uC11C \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146353
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD. \uC6B0\uB9AC \uB5A0\uB09C\uB2E4. \uB0A8\uCABD\uC73C\uB85C. UBC \uCABD\uC5D0\uC11C \uAD6C\uC870 \uACBD\uB85C \uC815\uBCF4\uAC00 \uC654\uC5B4. \uAC70\uAE30\uC11C \uB2E4\uB978 \uD5EC\uAE30\uB97C \uAE30\uB2E4\uB9AC\uAE30\uB85C \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146352
    m_Localized: "\uBB34\uC804\uAE30\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC5B4\uB518\uAC00 \uB4E4\uB72C, \uADF8\uB7EC\uBA74\uC11C\uB3C4 \uC9C0\uCE5C \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563655
    m_Localized: "\uADF8 \uC560\uAC00 \uC2A4\uC2A4\uB85C \uC815\uD55C \uBC8C\uC774\uC5C8\uB2E4. \uB07C\uC5B4\uB4E4\uACE0 \uC2F6\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC8C \uC633\uC740\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563654
    m_Localized: "\uADF8\uB0E5 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563653
    m_Localized: "\uC591\uB3D9\uC774 \uD55C\uCABD \uC190\uC7A1\uC774\uB97C \uC7A1\uC558\uB2E4. \uB458\uC774\uC11C \uB9D0\uC5C6\uC774 \uC6B4\uB3D9\uC7A5\uC744 \uAC00\uB85C\uC9C8\uB800\uB2E4. \uBB34\uAC70\uC6B4 \uAC74 \uBC18\uC73C\uB85C \uB098\uB258\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563509
    m_Localized: "\uCD1B\uBD88 \uC544\uB798\uC5D0\uC11C \uC120\uC0DD\uB2D8\uC774 \uC61B\uB0A0\uC774\uC57C\uAE30\uB97C \uD588\uB2E4. \uC815\uC804\uC774 \uC7A6\uB358 \uC2DC\uACE8 \uBD84\uAD50\uC5D0\uC11C \uCCAB \uBC1C\uB839\uC744 \uBC1B\uC558\uB358 \uC774\uC57C\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563510
    m_Localized: "\uBC1C\uC804\uAE30\uB294 \uACE0\uCCD0 \uB193\uC744 \uB54C\uAE4C\uC9C0 \uB3CC\uC9C0 \uC54A\uB294\uB2E4. \uB0AE\uC5D0 \uC2DC\uAC04\uC744 \uB0B4\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563645
    m_Localized: "\uBC24\uC774\uBA74 \uC190\uBC14\uB2E5\uC5D0 \uBB3C\uC9D1\uC774 \uC7A1\uD78C \uCC44 \uC7A4\uB2E4. \uC544\uCE68\uC774\uBA74 \uB610 \uC591\uB3D9\uC774\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146343
    m_Localized: "\uC544\uCE68. \uAE34 \uBC24\uC774 \uC9C0\uB098\uAC14\uB2E4. \uC0AC\uAC70\uB9AC \uCABD\uC740 \uC870\uC6A9\uD588\uB2E4. \uAC15\uCCA0\uACFC\uC758 \uC57D\uC18D\uC774, \uC9C0\uCF1C\uC9C4 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146344
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uC900\uC774 \uC11C \uC788\uC5C8\uB2E4. \uC6B0\uBE44\uB97C \uBC97\uC740 \uCC44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563511
    m_Localized: "\uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uC55E\uC5D0 \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBE44\uCA4D \uB9C8\uB978 \uC0BC\uC0C9 \uACE0\uC591\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563512
    m_Localized: "\uD55C\uCABD \uADC0 \uB05D\uC774 \uC870\uAE08 \uC798\uB824 \uC788\uC5C8\uB2E4. \uB3D9\uB124\uC5D0\uC11C \uB204\uAD70\uAC00 \uB3CC\uBCF4\uB358 \uACE0\uC591\uC774\uB77C\uB294 \uD45C\uC2DC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146345
    m_Localized: "\uC900: \uB204\uB098. \uD5EC\uAE30\u2026 \uC800\uB3C4 \uD0C8 \uC218 \uC788\uC5B4\uC694? \uAC80\uC0AC, \uC800 \uC548 \uBB3C\uB838\uC5B4\uC694. \uC9C4\uC9DC\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146346
    m_Localized: "\uC900\uC744 \uBA85\uB2E8\uC5D0 \uC62C\uB9AC\uACE0 \uD568\uAED8 \uAC00\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563513
    m_Localized: "\uADF8 \uACE0\uC591\uC774\uC600\uB2E4. \uB4F1\uAD63\uAE38 \uACE8\uBAA9 \uB2F4 \uC704\uC5D0\uC11C, \uADF8\uB9AC\uACE0 \uBA87 \uC8FC \uC804 \uC800\uB141 \uC774 \uACC4\uB2E8\uC5D0\uC11C \uBCF8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146347
    m_Localized: "{0}: \uAC19\uC774 \uAC00. \uBA85\uB2E8\uC5D0 \uB124 \uC774\uB984 \uC62C\uB9B4\uAC8C. \uC624\uB298\uBD80\uD130 \uB108\uB294 \uC0AC\uAC70\uB9AC \uD30C \uB9D0\uACE0, \uADF8\uB0E5 \uC900\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563646
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uD558\uB9B0 \uCABD\uC744 \uBA87 \uBC88 \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4. \uD55C\uB54C \uB458\uC740 \uB298 \uBD99\uC5B4 \uB2E4\uB154\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146351
    m_Localized: "\uC0AC\uAC70\uB9AC \uCABD\uC744 \uD55C \uBC88 \uBC14\uB77C\uBCF4\uC558\uB2E4. \uC774 \uB3D9\uB124\uC758 \uACA8\uC6B8\uC774 \uB05D\uB098 \uAC00\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174856
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB354 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uC57D\uC7A5 \uBAA9\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC904\uC744 \uAC19\uC774 \uCC44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563647
    m_Localized: "\uB3C4\uD604\uC740 \uCD5C\uD558\uB9B0\uC774 \uC9C0\uB098\uAC08 \uB54C\uB9C8\uB2E4 \uBAB8\uC744 \uBE44\uCF1C \uC130\uB2E4. \uBB34\uC11C\uC6CC\uC11C\uC778\uC9C0, \uAE38\uC744 \uB0B4\uC8FC\uB824\uB294 \uAC74\uC9C0 \uBAA8\uB97C \uBAB8\uC9D3\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563648
    m_Localized: "\uADF8\uAC74 \uC0AC\uACFC\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB807\uB2E4\uACE0 \uC544\uBB34\uAC83\uB3C4 \uC544\uB2CC \uAC83\uB3C4 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146348
    m_Localized: "\uC900\uC774 \uC6B8\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC785\uC220\uC744 \uAE68\uBB3C\uC5C8\uB2E4. \uACB0\uAD6D \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563514
    m_Localized: "\uC774\uCABD\uC744 \uBE64\uD788 \uBCF4\uB354\uB2C8 \uC57C\uC639, \uD558\uACE0 \uC6B8\uC5C8\uB2E4. \uB3C4\uB9DD\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146349
    m_Localized: "\uC791\uBCC4\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146350
    m_Localized: "\uC900\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uD615\uB4E4\uC774\uB791 \uB0A8\uACA0\uB2E4\uACE0 \uD588\uB2E4. \uC5EC\uAE30\uAC00 \uC790\uAE30 \uB3D9\uB124\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786236
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uB4A4\uB85C\uB294 \uAE30\uC5B4\uC11C \uB2E4\uB154\uC5B4. \uBCF4\uAC74\uC2E4, \uAD50\uBB34\uC2E4, \uBCF8\uAD00 \uCC3D\uACE0. \uD558\uB8E8\uC5D0 \uD55C \uACF3\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369098
    m_Localized: "\uC815\uC218 \uC7A5\uCE58\uBD80\uD130 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369099
    m_Localized: "\uD398\uD2B8\uBCD1, \uC22F, \uBAA8\uB798, \uC790\uAC08. \uAD50\uACFC\uC11C \uADF8\uB9BC\uB300\uB85C \uC313\uC544 \uC62C\uB838\uB2E4. \uD759\uD0D5\uBB3C\uC774 \uB9D1\uC740 \uBB3C\uBC29\uC6B8\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174854
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB4E4\uC740 \uB370\uB824\uB2E4\uC92C\uC5B4. \uADF8\uAC74 \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146364
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uC790\uC804\uAC70 \uD55C \uB300\uAC00 \uBA48\uCDC4\uB2E4. \uB2E4\uB9AC\uB97C \uC0B4\uC9DD \uC800\uB294 \uB0A8\uC790\uC560. \uBBFC\uADDC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369100
    m_Localized: "\uACFC\uD559\uBD80 \uB54C \uB9CC\uB4E4\uC5B4 \uBCF8 \uC7A5\uCE58\uC600\uB2E4. \uC22F\uC740 \uD55C \uBC88 \uC53B\uC5B4\uC11C, \uBAA8\uB798\uB294 \uACE0\uC6B4 \uAC83\uBD80\uD130. \uC190\uC774 \uC21C\uC11C\uB97C \uAE30\uC5B5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786199
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uAD6D\uC774\uB77C. \uC57D\uC740 \uC6B0\uB9AC\uD55C\uD14C \uC81C\uC77C \uBD80\uC871\uD55C \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460158
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: 2\uD559\uB144. \uC774\uB984\uC740?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980532
    m_Localized: "\uD145 \uBE48 \uD2B8\uB799 \uC704\uB85C \uBC14\uB78C\uC774 \uC9C0\uB098\uAC14\uB2E4. \uC5B8\uC820\uAC00 \uC800\uAE30\uB97C \uB2E4\uC2DC \uB2EC\uB9B4 \uC218 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706401
    m_Localized: "\uB4B7\uC0B0 \uAC1C\uC6B8\uAE4C\uC9C0 \uC62C\uB77C\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706400
    m_Localized: "\uB451\uAE38 \uB05D\uC5D0\uC11C \uADF8\uAC83\uB4E4\uC758 \uADF8\uB9BC\uC790\uB97C \uBD24\uB2E4. \uB3CC\uC544\uC11C \uB6F0\uB2E4\uAC00 \uBE44\uD0C8\uC5D0\uC11C \uBBF8\uB044\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786198
    m_Localized: "\uC804\uB2E8\uC9C0 \uADC0\uD241\uC774\uC5D0 \uB204\uAD70\uAC00 \uBCFC\uD39C\uC73C\uB85C \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCD0 \uB450\uC5C8\uB2E4. \uB098\uBCF4\uB2E4 \uBA3C\uC800 \uC774\uAC78 \uBCF8 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174876
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB978 \uAC83?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369101
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACFC\uD559 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uC168\uC73C\uBA74 \uC0C1 \uC8FC\uC168\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923588
    m_Localized: "\uC65C \uC54C\uB824 \uC8FC\uB0D0\uACE0 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369102
    m_Localized: "\uC2E4\uD5D8 \uB178\uD2B8\uB97C \uC77D\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369103
    m_Localized: "'3\uD559\uB144 \uB3D9\uC544\uB9AC \uC815\uC218\uC7A5 \uACAC\uD559 \uCDE8\uC18C. \uC2DC\uCCAD \uC5F0\uB77D, \uC218\uC9C8 \uAC80\uC0AC \uACB0\uACFC \uC774\uC0C1.' \uB0A0\uC9DC\uB294 \uC0AC\uD0DC \uC0AC\uD758 \uC804\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369104
    m_Localized: "\uB178\uD2B8\uB97C \uB36E\uB294 \uC190\uC774 \uC870\uAE08 \uCC28\uAC00\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369105
    m_Localized: "\uAD50\uBB34\uC2E4\uC740 \uC11C\uB958 \uB354\uBBF8\uC600\uB2E4. \uCC45\uC0C1\uB9C8\uB2E4 \uC2DC\uD5D8\uC9C0\uC640 \uAC00\uC815\uD1B5\uC2E0\uBB38\uC774 \uC313\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591887
    m_Localized: "\uAD1C\uCC2E\uB2E4\uB294 \uB9D0\uC774 \uB610 \uBA3C\uC800 \uB098\uC654\uB2E4. \uB4E3\uB294 \uC0AC\uB78C\uB3C4 \uC5C6\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563780
    m_Localized: "{0}: \uADF8\uAC74 \uC6C3\uC740 \uAC8C \uC544\uB2C8\uC57C. \uBC84\uD2F4 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563779
    m_Localized: "\uCD5C\uD558\uB9B0: \uB108\uB3C4 \uC6C3\uC5C8\uC796\uC544. \uB298. \uADF8\uB798\uC11C \uB2E4\uB4E4\u2026 \uAD1C\uCC2E\uC740 \uC904."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174881
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uACF5\uD559 \uCABD\uC740 \uB124\uAC00 \uB0AB\uC796\uC544. \uC790\uC7AC \uB109\uB109\uD788 \uBAA8\uC544\uC11C \uAC19\uC774 \uB9CC\uB4E4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146363
    m_Localized: "\uD2B8\uB7ED\uC774 \uC0AC\uAC70\uB9AC\uB97C \uB3CC\uC544 \uC0AC\uB77C\uC9C8 \uB54C\uAE4C\uC9C0 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4. \uB9C8\uD2B8 \uAC04\uD310\uC758 \uBD88 \uAEBC\uC9C4 '\uB354\uBD88\uC5B4' \uAE00\uC790\uAC00 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563778
    m_Localized: "\uCD5C\uD558\uB9B0: \uADF8\uB0A0 \uADF8\uB0E5\u2026 \uC7A5\uB09C\uC774\uC5C8\uC5B4. \uADF8\uB807\uAC8C \uB420 \uC904 \uBAB0\uB790\uC5B4. \uB2E4\uC74C \uB0A0 \uAEBC\uB0B4 \uC8FC\uB824\uACE0 \uD588\uB294\uB370, \uADF8 \uB2E4\uC74C \uB0A0\uC774\u2026 \uADF8\uAC70\uC600\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923587
    m_Localized: "\uCD5C\uD558\uB9B0: \uC678\uC6E0\uC5B4? \u2026\uC88B\uC544. \uB2E4\uC74C\uC5D4 \uB124\uAC00 \uC55E\uC7A5\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923586
    m_Localized: "\uD558\uB9B0\uC774 \uC55E\uC7A5\uC11C\uACE0 \uB098\uB294 \uD55C \uBC1C \uB4A4\uC5D0\uC11C \uB530\uB77C \uAC78\uC5C8\uB2E4. \uBD84\uD544 \uC704 \uACE8\uBAA9\uC744 \uC190\uAC00\uB77D\uC73C\uB85C \uBA87 \uBC88\uC774\uB098 \uC9DA\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923585
    m_Localized: "\uAE38\uC744 \uB530\uB77C \uC678\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923584
    m_Localized: "\uCD5C\uD558\uB9B0: \uC815 \uBC18\uC7A5 \uC0AC\uB78C\uB4E4, \uC0AC\uC2E4 \uB2E4 \uC774 \uB3D9\uB124 \uC544\uC800\uC528\uB4E4\uC774\uC57C. \uBB34\uC12D\uAC8C \uAD74\uC5B4\uB3C4 \uAC81\uBA39\uC740 \uAC74 \uB611\uAC19\uC544. \uBB50 \uC8FC\uBA74 \uC870\uC6A9\uD574\uC9C0\uB294\uC9C0\uB3C4 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563777
    m_Localized: "\uADF8 \uC560\uAC00 \uCC98\uC74C \uD55C \uB9D0\uC774\uC5C8\uB2E4. \uC0AC\uACFC\uB3C4, \uBCC0\uBA85\uB3C4 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563776
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uB108, \uC0B4\uC544 \uC788\uC5C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174923
    m_Localized: "\uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uB3C4\uD604\uC740 \uBC15 \uC120\uC0DD\uB2D8 \uBB34\uB98E\uC744 \uBCA0\uACE0 \uC790\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369106
    m_Localized: "1\uD559\uB144 \uBD80\uC7A5 \uC120\uC0DD\uB2D8 \uCC45\uC0C1 \uC606 \uCE90\uBE44\uB2DB. '1\uD559\uB144 \uD559\uC0DD\uC0DD\uD65C\uAE30\uB85D\uBD80'\uB77C\uACE0 \uC801\uD78C \uD30C\uC77C\uCCA0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369107
    m_Localized: "\uADF8 \uC548\uC5D0 \uB0B4 \uC774\uB984\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146430
    m_Localized: "{0}: \uC774\uAC70 \uAC00\uC838\uAC00. \uC5B4\uB450\uC6B4 \uB370 \uAC00\uBA74 \uCF1C. \uADF8\uB9AC\uACE0 \uB098 \uC0DD\uAC01\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146429
    m_Localized: "\uC544\uB07C\uB358 \uC190\uC804\uB4F1\uC744 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786197
    m_Localized: "'\uC0C8\uBCBD\uC57D\uAD6D \xB7 2\uCE35 \uC5F0\uC138\uC758\uC6D0. \uB3C4\uBCF4 3\uBD84.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369108
    m_Localized: "\uC9C0\uC6B0\uAC1C\uB85C \uC9C0\uC6B4 \uC790\uAD6D \uC704\uC5D0 \uB2E4\uC2DC \uC4F4 \uAE00\uC528\uAC00 \uC788\uC5C8\uB2E4. \uBBF8\uC220\uBD80\uC5D0\uC11C \uBC11\uADF8\uB9BC \uC790\uAD6D\uC744 \uBCF4\uB358 \uB208\uC774 \uADF8\uAC78 \uBA3C\uC800 \uCC3E\uC544\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369109
    m_Localized: "\uB2F4\uC784 \uC758\uACAC\uB780\uC5D0 \uC5F0\uD544\uB85C \uC801\uD78C \uBA54\uBAA8\uAC00 \uBCF4\uC600\uB2E4. \uAC19\uC740 \uC911\uD559\uAD50 \uCD9C\uC2E0 \uD559\uC0DD\uB4E4\uACFC\uC758 \uAD00\uACC4 \uAD00\uCC30 \uC694\uB9DD, \uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146362
    m_Localized: "\uC190\uC744 \uD754\uB4E4\uC5B4 \uBC30\uC6C5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146361
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798. \uADF8\uB54C \uACE0\uAE30 \uD55C \uBC88 \uB354 \uAD7D\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923583
    m_Localized: "\uCD5C\uD558\uB9B0: \uC774 \uBCBD\uC5D0 \uB3D9\uADF8\uB77C\uBBF8 \uC788\uC9C0. \uC0AC\uAC70\uB9AC \uD30C\uAC00 \uC4F0\uB294 \uD45C\uC2DC\uC57C. \uB3D9\uADF8\uB77C\uBBF8 \uC548\uC5D0 \uC904 \uD558\uB098\uB294 \uD1B5\uD589\uC138, \uB450 \uAC1C\uB294 \uB4E4\uC5B4\uC624\uC9C0 \uB9D0\uB77C\uB294 \uB73B."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923582
    m_Localized: "\uCD5C\uD558\uB9B0: \uB098 \uC5EC\uAE30\uC11C \uCEF8\uC5B4. \uC911\uD559\uAD50 \uB54C \uC560\uB4E4\uC774\uB791 \uBAB0\uB798 \uB2E4\uB2C8\uB358 \uAE38\uC774\uC57C. \uC5B4\uB978\uB4E4\uC740 \uBAB0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369110
    m_Localized: "\uB204\uAD70\uAC00\uB294 \uB208\uCE58\uCC44\uACE0 \uC788\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uAC70\uAE30\uAE4C\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369111
    m_Localized: "\uB0B4 \uAE30\uB85D\uC744 \uB05D\uAE4C\uC9C0 \uC77D\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369112
    m_Localized: "\uC911\uD559\uAD50 \uC0C1\uB2F4 \uAE30\uB85D \uC0AC\uBCF8\uC774 \uB07C\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uADF8\uB54C \uB0B4\uAC00 \uD588\uB358 \uB9D0\uB4E4\uC774 \uB0A8\uC758 \uAE00\uC528\uB85C \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369113
    m_Localized: "\uC190\uC774 \uB5A8\uB838\uC9C0\uB9CC \uB05D\uAE4C\uC9C0 \uC77D\uC5C8\uB2E4. \uC774\uAC74 \uB0B4 \uC774\uC57C\uAE30\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369114
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uD30C\uC77C\uC744 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369115
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD30C\uC77C\uC744 \uBC1B\uC544 \uB4E4\uACE0 \uCCAB \uC7A5\uC744 \uB118\uACBC\uB2E4. \uD45C\uC815\uC774 \uCC9C\uCC9C\uD788 \uAD73\uC5B4 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563775
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uC791\uC558\uB2E4. \uC544\uB2C8\uBA74 \uB0B4\uAC00 \uCEE4\uC9C4 \uAC78\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460240
    m_Localized: "\uC0B4\uC544\uC11C \uB3CC\uC544\uC654\uB2E4. \uADF8\uAC8C \uBA3C\uC800\uC600\uB2E4. \uB4A4\uB3CC\uC544\uBCF4\uB294 \uAC74 \uC0B4\uC544\uB0A8\uC740 \uB2E4\uC74C\uC758 \uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826502
    m_Localized: "\uC6B0\uB9AC\uB9CC \uB0A8\uC740 \uAC8C \uC544\uB2C8\uC5C8\uB2E4. \uADF8 \uC0DD\uAC01 \uD558\uB098\uB85C \uC624\uB298 \uBC24\uC740 \uC7A0\uC774 \uC798 \uC62C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369116
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB098\uC911\uC5D0 \uC77D\uC744\uAC8C. \uC9C0\uAE08\uC740 \uB108\uB791 \uAC19\uC774 \uC788\uC744 \uB54C \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786196
    m_Localized: "\uD3B8\uC758\uC810 \uACC4\uC0B0\uB300 \uB4A4 \uBCBD\uC5D0 \uADFC\uCC98 \uAC00\uAC8C \uC804\uB2E8\uC9C0\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786195
    m_Localized: "\uC11C\uB958\uB97C \uACF5\uCC45 \uC0AC\uC774\uC5D0 \uB07C\uC6CC \uB450\uC5C8\uB2E4. \uC5B8\uC820\uAC00 \uBB3C\uC5B4\uBCFC \uC218 \uC788\uC744 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174877
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC758\uC871\uC774\uC694. \uC9C4\uC9DC \uAC19\uC740 \uAC74 \uBABB \uB9CC\uB4E4\uC5B4\uB3C4, \uC11C\uC11C \uBA87 \uAC78\uC74C \uAC77\uB294 \uC815\uB3C4\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757773
    m_Localized: "\uC720\uB791\uC790: \uADF8\uB798. \uC774\uD574\uD55C\uB2E4. \uB2E4\uB4E4 \uADF8\uB807\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146360
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC\uC694. \uB0A8\uCABD\uC5D0\uC11C \uB2E4\uC2DC \uB9CC\uB098\uC694. \uAF2D\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923581
    m_Localized: "\uD558\uB9B0\uC740 \uB0AE\uC5D0 \uAC19\uC774 \uB098\uAC04 \uAE38\uC744 \uBC14\uB2E5\uC5D0 \uBD84\uD544\uB85C \uADF8\uB838\uB2E4. \uBE4C\uB77C \uC0AC\uC774 \uACE8\uBAA9, \uB2F4\uC7A5 \uAD6C\uBA4D, \uCCA0\uB9DD\uC774 \uCC22\uC5B4\uC9C4 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923580
    m_Localized: "\uCD5C\uD558\uB9B0: \uC0AC\uAC70\uB9AC \uCABD, \uD070\uAE38 \uB9D0\uACE0 \uB2E4\uB2C8\uB294 \uAE38\uC774 \uC788\uC5B4. \uC54C\uB824 \uC904\uAE4C. \uC2EB\uC73C\uBA74 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117976
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uADDC\uCE59\uC744 \uD55C \uBC88 \uB4E3\uACE0 \uB2E4 \uC678\uC6E0\uB2E4. \uADF8\uB9AC\uACE0 \uB0B4\uAC00 \uC2E4\uC218\uD560 \uB54C\uB9C8\uB2E4 \uC791\uAC8C \uC190\uAC00\uB77D\uC73C\uB85C \uCE78\uC744 \uAC00\uB9AC\uCF1C \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146428
    m_Localized: "\uC190\uBC14\uB2E5\uC744 \uB9DE\uB300 \uBB38\uC9C8\uB800\uB2E4. \uB3C4\uD604\uC740 \uADF8\uC81C\uC57C \uAC00\uBC29\uC744 \uBCA0\uACE0 \uB204\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146337
    m_Localized: "\uAC15\uCCA0\uC774 \uAD50\uBB38 \uC55E\uC5D0\uC11C \uC7A5\uAC11\uC744 \uBC97\uC5C8\uB2E4. \uC190\uB4F1\uC774 \uAC08\uB77C\uC838 \uD53C\uAC00 \uB9FA\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117975
    m_Localized: "\uB2E4\uC2DC \uD588\uB2E4. \uD558\uB9B0\uC774 \uC774\uACBC\uB2E4. \uD558\uB9B0\uC740 \uC774\uAE34 \uAC78 \uD2F0 \uB0B4\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC785\uC220\uC744 \uAFB9 \uB2E4\uBB3C\uC5C8\uB2E4. \uB2E4 \uD2F0\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117974
    m_Localized: "\uCD5C\uD558\uB9B0: \uC57C, \uB108 \uBC29\uAE08 \uD328 \uBD24\uC9C0. \uB2E4\uC2DC \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117973
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uCC98\uC74C\uC5D4 \uC2DC\uC2DC\uD558\uB2E4\uB294 \uC5BC\uAD74\uC774\uC5C8\uB2E4. \uB450 \uBC88\uC9F8 \uD310\uBD80\uD130\uB294 \uCE74\uB4DC\uB97C \uC954 \uC190\uC5D0 \uD798\uC774 \uB4E4\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117972
    m_Localized: "\uB3C4\uD604\uC740 \uB9D0\uC744 \uC5C5\uC5B4 \uAC00\uB2E4\uAC00, \uB0B4 \uB9D0\uC740 \uC7A1\uC9C0 \uC54A\uACE0 \uC2AC\uCA4D \uBE44\uCF1C \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117971
    m_Localized: "\uB3C4\uD604: \uB204\uB098, \uC774\uAC70 \uC6B0\uB9AC \uD560\uBA38\uB2C8 \uC9D1\uC5D0\uC11C \uD558\uB358 \uAC70\uC608\uC694! \uD560\uBA38\uB2C8\uB294 \uB9E8\uB0A0 \uB4B7\uB3C4 \uB098\uC624\uBA74 \uC6C3\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146359
    m_Localized: "\uB0A8\uACA8 \uC900 \uBB3C\uC790\uC5D0 \uACE0\uB9D9\uB2E4\uACE0 \uBB34\uC804\uC744 \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757772
    m_Localized: "\uBBF8\uC548\uD558\uB2E4\uACE0, \uC904 \uC218 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563530
    m_Localized: "\uB2F4\uC7A5\uACFC \uBB38\uC744 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117988
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uCC98\uC74C\uC5D4 \uB530\uB77C \uBD80\uB974\uC9C0 \uC54A\uC558\uB2E4. \uBC15\uC790\uB9CC \uBB34\uB98E \uC704\uC5D0\uC11C \uC190\uAC00\uB77D\uC73C\uB85C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117989
    m_Localized: "\uD6C4\uB834\uC5D0\uC11C, \uC544\uC8FC \uC791\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uB0B4 \uBAA9\uC18C\uB9AC \uC544\uB798\uB85C \uB4E4\uC5B4\uC654\uB2E4. \uB9D1\uC558\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uD6E8\uC52C."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987459
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798\uD588\uC5B4. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987460
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC11C\uB78D\uC5D0\uC11C \uC190\uC804\uB4F1 \uD558\uB098\uB97C \uAEBC\uB0B4 \uAC74\uB138\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923605
    m_Localized: "\uD558\uB9B0\uC740 \uD55C\uCC38 \uC190\uBC14\uB2E5\uC744 \uBCF4\uB2E4\uAC00, \uD540\uC744 \uC8FC\uBA38\uB2C8\uC5D0 \uB3C4\uB85C \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923606
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC54C\uC558\uC5B4. \uAE30\uB2E4\uB9B4\uAC8C. \uC548 \uD574\uB3C4 \uB418\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340769
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC878\uC5C5\uC7A5\uC740 \uC5C6\uB2E4. \uB300\uC2E0 \uC774\uB984\uC744 \uBD80\uB974\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706403
    m_Localized: "\uBC14\uC704\uC5D0 \uC549\uC544 \uBC1C\uC744 \uB2F4\uADF8\uACE0 \uC788\uC73C\uB2C8, \uC138\uC0C1\uC774 \uB05D\uB0AC\uB2E4\uB294 \uAC8C \uAC70\uC9D3\uB9D0 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706404
    m_Localized: "\uC774\uB07C \uB080 \uBC14\uC704\uC5D0\uC11C \uBBF8\uB044\uB7EC\uC838 \uAC1C\uC6B8\uC5D0 \uBE60\uC84C\uB2E4. \uD314\uAFC8\uCE58\uAC00 \uC4F8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460237
    m_Localized: "\uC800 \uAE38 \uB05D \uC815\uB958\uC7A5\uC5D0\uC11C {0}\uC758 \uAC00\uBC29\uB048\uC744 \uBD24\uC5C8\uB2E4. \uADF8 \uB4A4\uB85C\uB294 \uADF8\uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563789
    m_Localized: "\uC6A9\uC11C\uD55C\uB2E4\uACE0 \uB9D0\uD55C\uB2E4. \uB098\uB97C \uC704\uD574\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563529
    m_Localized: "\uB2F4\uC7A5 \uB108\uBA38\uB85C \uB0AE\uC740 \uBAA9\uC18C\uB9AC \uBA87 \uAC1C\uAC00 \uC9C0\uB098\uAC14\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uB3C4 \uC11E\uC5EC \uC788\uC5C8\uB2E4. \uD55C\uCC38 \uB4A4\uC5D0\uC57C \uC228\uC744 \uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923579
    m_Localized: "\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4. \uD558\uB9B0\uB3C4 \uB354 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC218\uAC74\uC740 \uB2E4\uC74C \uB0A0 \uAC1C\uCF1C\uC9C4 \uCC44 \uB0B4 \uC790\uB9AC\uC5D0 \uB3CC\uC544\uC640 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174857
    m_Localized: "\uB9D0\uC5C6\uC774 \uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC744 \uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174941
    m_Localized: "\uBCF5\uB3C4 \uB05D \uCC3D\uD2C0\uB85C \uBB3C\uC774 \uC2A4\uBA84\uB2E4. \uAD50\uC2E4 \uBCBD\uC5D0 \uACF0\uD321\uC774 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923578
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923577
    m_Localized: "\uC218\uAC74 \uD558\uB098\uB97C \uC138\uBA74\uB300 \uC606\uC5D0 \uB193\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563528
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uCCA0\uC870\uB9DD \uD55C \uACF3\uC774 \uC798\uB824 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uB4E4\uC5B4\uC654\uB2E4\uAC00, \uC544\uBB34\uAC83\uB3C4 \uAC00\uC838\uAC00\uC9C0 \uC54A\uACE0 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563527
    m_Localized: "\uB204\uAD70\uAC00 \uC774 \uD559\uAD50\uB97C \uC0B4\uD3B4\uBCF4\uACE0 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563526
    m_Localized: "\uAD50\uBB38 \uC606 \uB2F4\uC7A5\uC5D0 \uB0AF\uC120 \uD45C\uC2DC\uAC00 \uC0DD\uACBC\uB2E4. \uD398\uC778\uD2B8\uB85C \uADF8\uB9B0 \uB3D9\uADF8\uB77C\uBBF8\uC640 \uD654\uC0B4\uD45C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563525
    m_Localized: "\uADF8\uB0A0 \uC800\uB141, \uAD1C\uD788 \uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uCABD\uC744 \uBA87 \uBC88 \uB3CC\uC544\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923576
    m_Localized: "\uC218\uAC74\uC744 \uAC74\uB124\uACE0 \uB098\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923575
    m_Localized: "\uC544\uCE68\uC5D0 \uD558\uB9B0\uC740 \uBAA8\uC790\uB97C \uB20C\uB7EC\uC4F0\uACE0 \uB098\uC654\uB2E4. \uC544\uBB34\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923574
    m_Localized: "\uB098\uB294 \uBB38 \uC55E\uC5D0\uC11C \uB3CC\uC544\uC130\uB2E4. \uC9C0\uAE08\uC740 \uD63C\uC790 \uC788\uACE0 \uC2F6\uC744 \uAC83 \uAC19\uC558\uB2E4. \uB098\uB3C4 \uADF8\uB7AC\uC744 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923573
    m_Localized: "\uB9D0\uC5C6\uC774 \uC790\uB9AC\uB97C \uBE44\uCF1C \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786233
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 \uAC19\uC774 \uAC00 \uBCF4\uC790. \uB2E4\uC74C \uD559\uAE30\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563774
    m_Localized: "\uB4F1 \uB4A4\uB85C \uC2DC\uC120\uC774 \uC624\uB798 \uB530\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146358
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC758 \uD2B8\uB7ED\uC774 \uD559\uAD50 \uC55E\uC744 \uCC9C\uCC9C\uD788 \uC9C0\uB098\uAC14\uB2E4. \uC9D0\uCE78\uC758 \uC5B4\uB978\uB4E4\uC774 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786235
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD37C\uC9C0\uAE30 \uC804\uC5D0 \uB05D\uB0B4\uC57C \uD55C\uB2E4\uB294 \uC0DD\uAC01\uBFD0\uC774\uC5C8\uC5B4. \uBCF4\uAC74\uC2E4\uC774 \uAC00\uAE4C\uC6CC\uC11C \uB2E4\uD589\uC774\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563773
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798, \uC870\uC2EC\uD558\uB294 \uAC8C \uB9DE\uC9C0. \uB9C8\uC74C \uBC14\uB00C\uBA74 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146338
    m_Localized: "\uAC15\uCCA0: \uB05D\uAE4C\uC9C0 \uC9C0\uCF30\uB2E4. \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4. \uCCB4\uC721\uAD00 \uAC04\uD310\uC5D0 \uC368 \uBD99\uC5EC \uB1A8\uB358 \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923572
    m_Localized: "\uAC00\uC704\uC9C8\uC774 \uC11C\uD234\uB7EC \uB4B7\uBA38\uB9AC\uAC00 \uC090\uB6A4\uC5C8\uB2E4. \uD558\uB9B0\uC740 \uADF8\uAC83\uB3C4 \uADF8\uB0E5 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923571
    m_Localized: "\uCD5C\uD558\uB9B0: \uAC70\uC6B8 \uBCFC \uB54C\uB9C8\uB2E4 \uADF8\uB54C \uC5BC\uAD74\uC774 \uBCF4\uC5EC\uC11C. \uADF8\uB798\uC11C \uC790\uB974\uB294 \uAC70\uC57C. \uBCC4 \uB73B \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923570
    m_Localized: "\uCD5C\uD558\uB9B0: \uC774 \uC0C9, \uADF8\uB54C \uD588\uB358 \uAC70\uC57C. \uD559\uAE30 \uCD08\uC5D0. \uB2E4\uB4E4 \uB530\uB77C \uD588\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923569
    m_Localized: "\uB098\uB97C \uBCF4\uACE0\uB3C4 \uD558\uB9B0\uC740 \uC190\uC744 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563772
    m_Localized: "\uC815\uC911\uD788 \uAC70\uC808\uD558\uACE0 \uB3CC\uC544\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786234
    m_Localized: "\u2014 1\uB9C9 \xB7 \uC0DD\uC874, \uB05D \u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174855
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563524
    m_Localized: "\uACE0\uC591\uC774\uB294 \uC11C\uC6B4\uD558\uB2E4\uB294 \uB4EF \uB3CC\uC544\uBCF4\uACE0 \uB2F4\uC7A5 \uB108\uBA38\uB85C \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146357
    m_Localized: "\uC815 \uBC18\uC7A5: \uD2B8\uB7ED\uC5D0 \uB2E4 \uC548 \uC2E4\uB824\uC11C \uADF8\uB7EC\uB294\uB370, \uB0A8\uC740 \uAC70 \uAD50\uBB38 \uC55E\uC5D0 \uB450\uACE0 \uAC08\uAC8C. \uC300 \uC870\uAE08\uC774\uB791 \uC5F0\uB8CC \uD55C \uD1B5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117970
    m_Localized: "\uB3C4\uD604\uC740 \uC737\uC744 \uB358\uC9C8 \uB54C\uB9C8\uB2E4 \uC18C\uB9AC\uB97C \uC9C8\uB800\uB2E4. \uBAA8\uAC00 \uB098\uC624\uC790 \uBC8C\uB5A1 \uC77C\uC5B4\uB098 \uCDA4\uAE4C\uC9C0 \uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117969
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC774\uAE38 \uB54C\uB9C8\uB2E4 \"\uAD1C\uCC2E\uC544, \uB2E4\uC74C \uD310\uC740 \uB124\uAC00 \uC774\uAE38 \uC218\uB3C4 \uC788\uC5B4\"\uB77C\uACE0 \uD588\uB2E4. \uD55C \uBC88\uB3C4 \uC9C0\uC9C0 \uC54A\uC73C\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117968
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC57C\uAC04 \uADFC\uBB34 \uB54C \uB2F9\uC9C1\uC2E4\uC5D0\uC11C \uBC30\uC6E0\uC5B4. \uC0C8\uBCBD \uC138 \uC2DC\uC5D4 \uC774\uAC83\uB3C4 \uCC98\uCE58\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146356
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB0A0 \uCC3D\uACE0 \uC9C0\uCF1C \uC900 \uAC70, \uC6B0\uB9AC \uC2DD\uAD6C\uB4E4 \uB2E4 \uAE30\uC5B5\uD574. \uB108\uB294 \uC6B0\uB9AC \uC740\uC778\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563523
    m_Localized: "\uCAD3\uC544 \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563635
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uC5C6\uC774 \uC18C\uB3C5\uC57D\uC744 \uAEBC\uB0C8\uB2E4. \uC900\uC774 \uC774\uB97C \uC545\uBB34\uB294 \uB3D9\uC548 \uC190\uC744 \uC7A1\uC544 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563636
    m_Localized: "\uBC30\uC6B4 \uB300\uB85C \uC9C0\uD608\uD558\uACE0, \uC18C\uB3C5\uD558\uACE0, \uAC10\uC558\uB2E4. \uC900\uC774 \uC6B8\uC74C\uC744 \uCC38\uB290\uB77C \uC5B4\uAE68\uB97C \uB5A8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563637
    m_Localized: "\uC544\uCE68\uC5D0 \uC900\uC740 \uC6B0\uBE44\uB97C \uBC97\uC5B4 \uB450\uACE0 \uAC14\uB2E4. \uC6B0\uBE44 \uC8FC\uBA38\uB2C8\uC5D0 \uC0AC\uD0D5 \uD558\uB098\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4. \uACE0\uB9D9\uB2E4\uB294 \uB9D0 \uB300\uC2E0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146339
    m_Localized: "\uC544\uCE68. \uC6B0\uBE44\uB4E4\uC740 \uBB3C\uB7EC\uAC14\uB2E4. \uAD50\uBB38 \uC55E \uB208 \uC704\uC5D0 \uBD89\uC740 \uD398\uC778\uD2B8 \uD1B5\uC774 \uC4F0\uB7EC\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563638
    m_Localized: "\uBA39\uC744 \uAC83\uC744 \uC950\uC5EC \uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563639
    m_Localized: "\uD1B5\uC870\uB9BC \uB450 \uAC1C\uB97C \uC950\uC5EC \uC8FC\uC5C8\uB2E4. \uC900\uC740 \uBA87 \uBC88\uC774\uB098 \uB3CC\uC544\uBCF4\uBA70 \uC0AC\uAC70\uB9AC \uCABD\uC73C\uB85C \uC808\uB69D\uC774\uBA70 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563640
    m_Localized: "\uCAD3\uC544\uB0B8\uB2E4. \uC0AC\uAC70\uB9AC \uD30C\uB294 \uC0AC\uAC70\uB9AC \uD30C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563641
    m_Localized: "{0}: \uAC00. \uB2E4\uC2DC\uB294 \uC624\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563642
    m_Localized: "\uC900\uC774 \uC77C\uC5B4\uB098 \uBE44\uD2C0\uAC70\uB9AC\uBA70 \uC5B4\uB460 \uC18D\uC73C\uB85C \uC0AC\uB77C\uC84C\uB2E4. \uADF8 \uB4B7\uBAA8\uC2B5\uC774, \uCC3D\uACE0 \uBB38 \uC55E\uC5D0 \uC11C \uC788\uB358 \uB204\uAD70\uAC00\uCC98\uB7FC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175005
    m_Localized: "\uCC38\uACE0\uC11C\uB791 \uBB38\uC81C\uC9D1\uC744 \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757779
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uC0AC\uB78C\uC774\uAD6C\uB098. \uC6D0\uB9DD\uD558\uC9C0 \uB9C8\uB77C. \uC6B0\uB9AC\uB3C4 \uADF8\uB7F4 \uC218 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340770
    m_Localized: "\uC878\uC5C5\uC2DD\uC744 \uB05D\uAE4C\uC9C0 \uCE58\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146711
    m_Localized: "\uC11C\uB958\uB97C \uC120\uC0DD\uB2D8\uAED8 \uB0B4\uBC00\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC548\uACBD\uC744 \uBC97\uC5C8\uB2E4\uAC00, \uB2E4\uC2DC \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146710
    m_Localized: "\uC11C\uB958\uB97C \uB4E4\uACE0 \uC120\uC0DD\uB2D8 \uBA38\uB9AC\uB9E1\uC5D0 \uC549\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uC740 \uCC44 \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563643
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uC2DC\uD0A4\uC9C0 \uC54A\uC740 \uC77C\uC744 \uD588\uB2E4. \uD654\uC7A5\uC2E4 \uCCAD\uC18C, \uC4F0\uB808\uAE30 \uBB3B\uAE30, \uC591\uB3D9\uC774 \uB098\uB974\uAE30. \uC81C\uC77C \uB354\uB7FD\uACE0 \uC81C\uC77C \uBB34\uAC70\uC6B4 \uAC83\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563522
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE09\uC2DD\uC774\uB77C\uB2C8. \uC791\uBA85 \uC13C\uC2A4\uAC00\u2026 \uC544\uB2C8\uB2E4, \uC88B\uB2E4. \uC798 \uC5B4\uC6B8\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563521
    m_Localized: "\uBC24\uC774\uBA74 \uCC3D\uD2C0 \uB108\uBA38\uC5D0\uC11C \uC548\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uB294 \uB208\uC774 \uC788\uC5C8\uB2E4. \uB4E4\uC5B4\uC624\uACE0 \uC2F6\uC740 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563520
    m_Localized: "\uADF8 \uB4A4\uB85C \uC0AC\uD758\uC5D0 \uD55C \uBC88\uC529 \uCC3E\uC544\uC654\uB2E4. \uC774\uB984\uC740 '\uAE09\uC2DD'\uC774 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563519
    m_Localized: "\uACE0\uC591\uC774\uB294 \uD5C8\uAC81\uC9C0\uAC81 \uBA39\uACE0 \uB098\uC11C \uB0B4 \uBC1C\uBAA9\uC5D0 \uBAB8\uC744 \uBE44\uBCD0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563518
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uC870\uAE08 \uB35C\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563517
    m_Localized: "\uB3C4\uD604: \uB9CC\uC838\uB3C4 \uB3FC\uC694? \u2026\uC544, \uC548 \uB418\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146355
    m_Localized: "\uC815 \uBC18\uC7A5: \u2026\uADF8\uB0A0 \uC77C\uC740 \uC11C\uC6B4\uD588\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uC0B4\uC544 \uC788\uC73C\uB2C8\uAE4C. \uC798 \uC9C0\uB0B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146354
    m_Localized: "\uC815 \uBC18\uC7A5: \uB108\uD76C \uD559\uAD50 \uD5EC\uAE30\uB294 \uC5EC\uB35F \uC790\uB9AC\uB77C\uBA70. \uC6B0\uB9AC \uC2DD\uAD6C\uB294 \uC11C\uB978\uC774 \uB118\uC5B4. \uD55C \uB2EC\uC529 \uB3CC\uC544\uAC00\uBA70 \uAE30\uB2E4\uB9AC\uB290\uB2C8, \uAE38\uC744 \uCC3E\uC544 \uB098\uC11C\uB294 \uAC8C \uB0AB\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706468
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBE57\uC7A5\uC744 \uD55C \uBC88 \uD754\uB4E4\uC5B4 \uBCF4\uC558\uB2E4. \uAFC8\uCA4D\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826504
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798\uC694, \uC870\uC2EC\uD558\uB294 \uAC8C \uB9DE\uC9C0. \uC8FC\uD30C\uC218\uB294 \uC5F4\uC5B4 \uB458\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460266
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB0B4\uC77C \uC544\uCE68\uC5D0 \uADF8 \uACF5\uCC45 \uB098\uB3C4 \uBCF4\uC5EC \uC918. \uB124 \uB208\uC774 \uC6B0\uB9AC \uACBD\uBCF4\uAE30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460265
    m_Localized: "\uC815\uBB38 \uC14B, \uCCA0\uBD09 \uB137. \uC6C0\uC9C1\uC784\uC774 \uC720\uB09C\uD788 \uB290\uB9B0 \uAC83 \uD558\uB098. \uB0A0\uC9DC \uC606\uC5D0 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460264
    m_Localized: "\uB05D\uAE4C\uC9C0 \uC138\uC5B4 \uACF5\uCC45\uC5D0 \uC801\uC5B4 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460263
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 \uBCF8\uB2E4\uB294 \uAC74 \uC0DD\uAC01\uBCF4\uB2E4 \uD798\uC774 \uB4DC\uB294 \uC77C\uC774\uC57C. \uACC4\uC18D \uBCF4\uACE0\uB9CC \uC788\uC73C\uBA74, \uC0AC\uB78C\uC774 \uB2F3\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460262
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB108\uB294 \uAC81\uC774 \uB098\uB3C4 \uB208\uC744 \uC548 \uAC10\uB354\uB77C. \uCC3D\uACE0 \uBB38 \uC5F4\uB358 \uB0A0\uB3C4 \uADF8\uB7AC\uC5B4. \uB098\uB97C \uB611\uBC14\uB85C \uBD24\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563516
    m_Localized: "\uB3C4\uD604\uC774 \uB4F1 \uB4A4\uC5D0\uC11C \uC228\uC744 \uC8FD\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146340
    m_Localized: "\uAC15\uCCA0\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB0A8\uC544 \uD559\uAD50\uB97C \uC62C\uB824\uB2E4\uBCF4\uB2E4\uAC00, \uBAA8\uC790\uB97C \uBC97\uC5B4 \uD55C \uBC88 \uB4E4\uC5B4 \uBCF4\uC774\uACE0 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117967
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uCE74\uB4DC\uB97C \uC11E\uB294 \uC190\uC774 \uC774\uC0C1\uD558\uAC8C \uB2A5\uC219\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117966
    m_Localized: "\uC138 \uD310\uC744 \uB0B4\uB9AC \uC84C\uB2E4. \uC720\uB791\uC790\uB294 \uC0AC\uD0D5 \uD558\uB098\uB97C \uC7A5\uAE30\uD310 \uC704\uC5D0 \uC62C\uB824\uB193\uC558\uB2E4. \uC704\uB85C\uB77C\uB294 \uB73B \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117965
    m_Localized: "\uC720\uB791\uC790: \uC0B0 \uB300\uD53C\uC18C\uC5D0\uC120 \uBE44 \uC624\uBA74 \uC774\uAC83\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4. \uC9C0\uB294 \uC0AC\uB78C\uC774 \uBB3C \uAE38\uC5B4 \uC624\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923568
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uAE08 \uAC04 \uAC70\uC6B8 \uC55E\uC5D0\uC11C \uBA38\uB9AC \uB05D\uC744 \uC790\uB974\uACE0 \uC788\uC5C8\uB2E4. \uC5FC\uC0C9\uD55C \uAC08\uC0C9 \uBD80\uBD84\uB9CC. \uC138\uBA74\uB300\uC5D0 \uBA38\uB9AC\uCE74\uB77D\uC774 \uC313\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923567
    m_Localized: "\uC0C8\uBCBD, \uC138\uBA74\uC2E4\uC5D0\uC11C \uAC00\uC704 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923566
    m_Localized: "(\uC1A1\uC608\uC9C0\uAC00 '\uACC1\uC5D0 \uC788\uAE30'\uB97C \uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923565
    m_Localized: "\uC608\uC9C0\uAC00 \uB4F1\uC744 \uC870\uAE08 \uB354 \uAE30\uB314\uB2E4. \uADF8 \uBB34\uAC8C\uAC00 \uC2EB\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369206
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC6B4\uC774\uB77C\uB294 \uB9D0, \uC800\uB294 \uBCC4\uB85C \uC548 \uBBFF\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591907
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC30\uCE58\uACE0\uC0AC \uAD6D\uC5B4 1\uB4F1\uC774\uC5C8\uC9C0? \uB108\uBB34 \uC798 \uC77D\uC73C\uBA74 \uC120\uC0DD\uB2D8\uC774 \uD560 \uC77C\uC774 \uC5C6\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146341
    m_Localized: "\uC544\uCE68. \uCC3D\uACE0 \uBB38\uC774 \uB72F\uACA8 \uC788\uC5C8\uB2E4. \uC57D\uC7A5\uB3C4 \uBC18\uCBE4 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC625\uC0C1 \uBB38\uC740 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146342
    m_Localized: "\uAC15\uCCA0\uC740 \uC625\uC0C1 \uACC4\uB2E8 \uC55E\uC5D0\uC11C \uBA48\uCDC4\uB2E4\uACE0, \uB204\uAD70\uAC00 \uB9D0\uD588\uB2E4. \uC560\uB4E4 \uC788\uB294 \uB370\uAE4C\uC9C4 \uC548 \uC62C\uB77C\uC654\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637175008
    m_Localized: "\uC18C\uC124\uCC45 \uD55C \uAD8C\uC744 \uACE8\uB77C \uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174981
    m_Localized: "{0}: \uADF8\uB9AC\uACE0 \uC2DD\uD310\uC774\uC694. \uC2DD\uD310\uC5D0 \uBA39\uACE0 \uC2F6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786205
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uB9C8. \uADF8\uB7EC\uB2C8\uAE4C \uC900\uBE44\uD558\uC790. \uBB34\uC11C\uC6CC\uD558\uB294 \uAC74 \uC900\uBE44\uAC00 \uB05D\uB09C \uB2E4\uC74C\uC5D0 \uD574\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146712
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uB300\uC7A5, \uB0B4 \uC790\uB9AC\uC5D0\uC11C \uC138 \uCE78 \uC606 \uC11C\uB78D\uC774\uB2E4. \uB098\uB294 \uADF8 \uC11C\uB78D\uC744 \uB9E4\uC77C \uC5F4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174950
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uCD08\uBCF5\uC774\uB2E4. \uC6D0\uB798\uB294 \uAE09\uC2DD\uC5D0 \uC0BC\uACC4\uD0D5 \uB098\uC624\uB294 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460163
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uC624\uB298\uBD80\uD130 \uC2DD\uAD6C\uB2E4. \uB300\uC2E0 \uADDC\uCE59\uC740 \uC9C0\uCF1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460164
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310\uC5D0 \uB9DD \uBCF4\uB294 \uC21C\uC11C\uB97C \uC801\uC790, 2\uD559\uB144\uC740 \uADF8\uAC78 \uD55C \uBC88 \uBCF4\uACE0 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117983
    m_Localized: "\uC74C\uC545\uC2E4 \uBB38\uC744 \uB2EB\uACE0, \uC190\uC804\uB4F1\uC744 \uCC9C\uC7A5\uC73C\uB85C \uD5A5\uD558\uAC8C \uC138\uC6CC \uB450\uC5C8\uB2E4. \uBC16\uC73C\uB85C \uC18C\uB9AC\uAC00 \uC0C8\uC9C0 \uC54A\uAC8C \uC791\uAC8C, \uC544\uC8FC \uC791\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174977
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADC0\uAC00\uBD80 \uC2E4\uB825\uC774\uB124. \uADF8 \uAE38, \uD3C9\uBA74\uB3C4\uC5D0 \uADF8\uB824 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369146
    m_Localized: "\uC785\uAF2C\uB9AC\uAC00 \uC62C\uB77C\uAC00\uB2E4 \uBA48\uCDC4\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uB530\uB77C \uC6C3\uC9C0 \uC54A\uC558\uB2E4. \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146714
    m_Localized: "{0}: \uC120\uC0DD\uB2D8 \uC798\uBABB \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174978
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD55C \uBC88\uC5D0 \uB2E4\uB294 \uBABB \uD574. \uC5B4\uB514\uBD80\uD130 \uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174979
    m_Localized: "\uAE09\uC2DD\uC2E4\uBD80\uD130. \uBA39\uB294 \uAC8C \uBA3C\uC800\uC608\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117984
    m_Localized: "\uBC29\uC1A1\uBD80 \uC810\uC2EC\uC2DC\uAC04 \uBC84\uB987\uB300\uB85C, \uCCAB \uACE1 \uC18C\uAC1C\uB97C \uC791\uAC8C \uC911\uC5BC\uAC70\uB838\uB2E4. \"\uB2E4\uC74C \uACE1\uC740\u2026\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117985
    m_Localized: "\uC120\uBC30\uAC00 \uAE30\uD0C0\uB97C \uBB34\uB98E\uC5D0 \uC62C\uB838\uB2E4. \uC904 \uD558\uB098\uB97C \uD295\uAE30\uACE0, \uB098\uB97C \uBCF4\uC558\uB2E4. \uC2DC\uC791\uD558\uB77C\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706497
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F4 \uB098\uB294\uAD6C\uB098. \uC624\uB298\uC740 \uBB34\uB9AC\uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987458
    m_Localized: "\uBCF8\uAD00 \uCC3D\uACE0 \uCCA0\uBB38\uC774 \uB2EB\uD788\uC790 \uB458 \uB2E4 \uD55C\uCC38 \uC228\uB9CC \uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174980
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD604\uC2E4\uC801\uC774\uAD6C\uB098. \uC88B\uC544. \uB0C9\uC7A5\uACE0\uB294 \uBABB \uC368\uB3C4 \uC870\uB9AC\uB300\uB791 \uD070 \uC1A5\uC774 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706467
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uBB38\uC740 \uC548\uC5D0\uC11C \uC7A0\uADF8\uB294 \uAC70\uC57C. \uC6B0\uB9AC\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174873
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC88B\uC544. \uADF8 \uC870\uAC74, \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174939
    m_Localized: "\uC544\uCE68\uBD80\uD130 \uBE44\uAC00 \uADF8\uCE58\uC9C0 \uC54A\uC558\uB2E4. \uC77C\uAE30\uC608\uBCF4\uAC00 \uC788\uC5C8\uB2E4\uBA74 \uC7A5\uB9C8 \uC2DC\uC791\uC774\uB77C\uACE0 \uD588\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146713
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAB0\uB790\uB2E4\uB294 \uAC74 \uD551\uACC4\uAC00 \uC548 \uB418\uACA0\uC9C0. \uBAB0\uB790\uB358 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013763
    m_Localized: "\uAD6C\uC11D\uC5D0 \uB300\uD68C\uC6A9 \uC0DD\uC218 \uBC15\uC2A4\uC640 \uC811\uD78C \uB9E4\uD2B8\uAC00 \uC788\uC5C8\uB2E4. \uB700\uD2C0, \uACF5 \uBC14\uAD6C\uB2C8, \uC190\uC7A1\uC774\uAC00 \uB179\uC2A8 \uC904\uB118\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013762
    m_Localized: "\uD734\uB300\uD3F0\uC740 \uC2E0\uD638\uAC00 \uC7A1\uD788\uC9C0 \uC54A\uC558\uB2E4. \uBC30\uD130\uB9AC\uB294 61%. \uD654\uBA74\uC744 \uB044\uACE0 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013761
    m_Localized: "\uBA40\uB9AC\uC11C 1\uAD50\uC2DC \uC885\uC774 \uC6B8\uB838\uB2E4. \uADF8\uB9AC\uACE0 2\uAD50\uC2DC \uC885\uB3C4. \uC544\uBB34\uB3C4 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 312271393013760
    m_Localized: "\uC190\uC7A1\uC774\uB97C \uB3CC\uB824\uB3C4, \uBB38\uC744 \uB450\uB4DC\uB824\uB3C4, \uB300\uB2F5\uD558\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 312271237824512
    m_Localized: "\uC5B4\uB460. \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC740 \uBC16\uC5D0\uC11C \uC7A0\uACA8 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563652
    m_Localized: "\uAC19\uC774 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563651
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uBA48\uCE6B\uD588\uB2E4. \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uADF8\uB0A0 \uC800\uB141\uC5D4 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uACFC \uAC19\uC740 \uC2DC\uAC04\uC5D0 \uBC25\uC744 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563650
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC. \uD654\uC7A5\uC2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563649
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 315716581736451
    m_Localized: "\uCCAB\uC9F8 \uB0A0. \uD574\uAC00 \uC9C0\uC790 \uBB38\uD2C8\uC758 \uBE5B\uB3C4 \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757919
    m_Localized: "\uC785\uAE40\uC774 \uC774\uBD88 \uC704\uB85C \uD558\uC597\uAC8C \uC62C\uB77C\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757918
    m_Localized: "\uBC24\uC774 \uCD94\uC6E0\uB2E4. \uC774\uBD88\uC774 \uBAA8\uC790\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757917
    m_Localized: "\uC774 \uACC4\uC808\uC774 \uC9C0\uB098\uBA74 \uC6B4\uB3D9\uC7A5\uC740 \uD558\uC598\uC9C8 \uAC83\uC774\uB2E4. \uADF8\uB54C\uB3C4 \uC5EC\uAE30\uC11C \uC774\uAC78 \uBCF4\uACE0 \uC788\uAE30\uB97C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757916
    m_Localized: "\uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uC6B4\uB3D9\uC7A5\uC774 \uAE08\uC0C9\uC73C\uB85C \uCD9C\uB801\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460176
    m_Localized: "\uB9D0\uD558\uB2E4 \uB9D0\uACE0 \uC6C3\uC74C\uC774 \uB0AC\uB2E4. \uB610 \uAD1C\uCC2E\uB2E4\uACE0 \uD558\uB824\uB358 \uCC38\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460175
    m_Localized: "{0}: \uC5D0\uC774, \uADF8 \uC815\uB3C4\uB294\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460174
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB118\uC5B4\uC9C4 \uAC74 \uAD1C\uCC2E\uC9C0 \uC54A\uC558\uC744 \uD150\uB370. \uBB34\uB98E\uC5D0 \uD53C \uB0AC\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460173
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uB124\uAC00 '\uAD1C\uCC2E\uC544\uC694'\uB77C\uACE0 \uD55C \uD69F\uC218. \uBB3C \uAE38\uC5B4 \uC62C \uB54C, \uACC4\uB2E8\uC5D0\uC11C \uB118\uC5B4\uC84C\uC744 \uB54C, \uBC25\uC774 \uD0D4\uC744 \uB54C. \uADF8\uB9AC\uACE0 \uBC29\uAE08."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757981
    m_Localized: "\uAC15\uCCA0: \uB137\uC774\uBA74 \uCDA9\uBD84\uD558\uB2E4. \uB108\uD76C \uBAAB \uB0A8\uACA8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757980
    m_Localized: "\uD1B5\uC870\uB9BC \uB2E4\uC12F \uAC1C\uB97C \uAC74\uB138\uB2E4. \uAC15\uCCA0\uC740 \uBC1B\uC544\uC11C \uD55C \uBC88 \uB4E4\uC5B4 \uBCF4\uB354\uB2C8, \uD558\uB098\uB97C \uB2E4\uC2DC \uB0B4 \uC190\uC5D0 \uC950\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460172
    m_Localized: "{0}: \uBB50\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146491
    m_Localized: "\uAC00\uC7A5 \uAE34 \uBC24\uC744 \uADF8\uB0E5 \uD568\uAED8 \uACAC\uB518\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146490
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2EC\uB2E4. \uB098\uC05C \uAE30\uC6B4\uC774 \uB2EC\uC544\uC11C \uB3C4\uB9DD\uAC00\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146489
    m_Localized: "\uC120\uC0DD\uB2D8 \uC785\uC5D0 \uD55C \uC21F\uAC00\uB77D\uC529 \uB5A0 \uB123\uC5B4 \uB4DC\uB838\uB2E4. \uB450 \uC21F\uAC00\uB77D\uC9F8\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146488
    m_Localized: "\uC300\uC744 \uC624\uB798 \uB053\uC5EC \uD325\uC744 \uD480\uC5C8\uB2E4. \uB108\uBB34 \uB2EC\uC544\uC11C \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC0C8\uC54C\uC2EC \uB300\uC2E0 \uB123\uC740 \uB5A1 \uC870\uAC01\uC740 \uCAC0\uB4DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146487
    m_Localized: "\uD1B5\uC870\uB9BC \uD325\uC73C\uB85C \uD325\uC8FD \uBE44\uC2B7\uD55C \uAC83\uC744 \uC468\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146486
    m_Localized: "\uD325\uC740 \uC5C6\uC5C8\uB2E4. \uD1B5\uC870\uB9BC \uD325\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4. \uBE59\uC218\uC6A9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757979
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0, \uACA8\uC6B8 \uC2DD\uB7C9\uC744 \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757978
    m_Localized: "\uAC15\uCCA0: \uC560\uB4E4 \uC9C0\uD0A4\uB294 \uC77C\uC774\uBA74, \uCCB4\uC721\uAD00 \uBB38 \uB2EB\uC740 \uB4A4\uB85C \uCC98\uC74C\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146485
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6D0\uB798\uB294 \uD325\uC8FD\uC744 \uC464\uC5B4 \uBA39\uC5B4. \uB098\uC05C \uAE30\uC6B4 \uCAD3\uC73C\uB77C\uACE0. \uB0B4\uC77C\uBD80\uD130\uB294 \uB0AE\uC774 \uC870\uAE08\uC529 \uAE38\uC5B4\uC9C0\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146484
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC774 \uB3D9\uC9C0\uC57C. \uC77C \uB144 \uC911\uC5D0 \uBC24\uC774 \uC81C\uC77C \uAE34 \uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146483
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC774\uBD88 \uC18D\uC5D0\uC11C \uC190\uAC00\uB77D\uC73C\uB85C \uCC3D\uBC16\uC744 \uAC00\uB9AC\uCF30\uB2E4. \uD574\uAC00 \uBC8C\uC368 \uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146482
    m_Localized: "\uADF8\uAC83\uB4E4\uC758 \uBC1C\uC790\uAD6D\uB3C4 \uB208 \uC544\uB798 \uB2E4 \uC9C0\uC6CC\uC84C\uB2E4. \uB0B4\uC77C\uC774\uBA74 \uB2E4\uC2DC \uC0DD\uAE30\uACA0\uC9C0\uB9CC, \uC624\uB298 \uD558\uB8E8\uB9CC\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146481
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uB458 \uB2E4 \uAC19\uC740 \uAC78 \uBE4C\uC5C8\uB294\uC9C0\uB294 \uC601\uC601 \uBAA8\uB974\uACA0\uAD6C\uB098. \u2026\uADF8\uAC83\uB3C4 \uAD1C\uCC2E\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146480
    m_Localized: "{0}: \uC800\uB3C4 \uBE4C\uC5C8\uC5B4\uC694. \uC800\uB3C4 \uB9D0 \uC548 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146479
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB\uB208 \uC624\uBA74 \uC18C\uC6D0 \uBE48\uB2E4\uB358\uB370. \uB098\uB294 \uBC8C\uC368 \uBE4C\uC5C8\uB2E4. \uB9D0\uC740 \uC548 \uD574 \uC904 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174811
    m_Localized: "\uC774\uAC74 \uB0B4\uAC00 \uB300\uC2E0 \uC77D\uC5B4\uB3C4 \uB418\uB294 \uB9D0\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117838
    m_Localized: "\uC77D\uB2E4\uAC00 \uC6C3\uC74C\uC774 \uB0AC\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC0DD\uD65C\uAE30\uB85D\uBD80\uC5D0 \uC801\uC5B4 \uC8FC\uB358 \uB9D0\uD22C\uB791 \uB611\uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369154
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB124\uAC00 \uC6C3\uC744 \uB54C\uB9C8\uB2E4 \uAD1C\uCC2E\uC740 \uC904 \uC54C\uC558\uC5B4. \uC544\uB2C8, \uADF8\uB807\uAC8C \uBBFF\uACE0 \uC2F6\uC5C8\uB358 \uAC70\uACA0\uC9C0. \uB0B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654312
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC624\uB298\uC740 \uBC15\uC790\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654311
    m_Localized: "\uC74C\uC545 \uC2DC\uAC04\uC774\uB77C\uACE0 \uD574\uB3C4, \uC18C\uB9AC\uB97C \uB0BC \uC218\uB294 \uC5C6\uC5C8\uB2E4. \uCC3D\uBC16 \uC5B4\uB514\uC11C \uBB34\uC5C7\uC774 \uB4E3\uACE0 \uC788\uC744\uC9C0 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826519
    m_Localized: "\uC720\uB791\uC790\uB294 \uB2A5\uC120\uACFC \uACC4\uACE1\uACFC, \uB538\uC774 \uCC98\uC74C \uC815\uC0C1\uC5D0 \uC120 \uB0A0\uC758 \uD558\uB298\uC0C9\uC744 \uB9D0\uD588\uB2E4. \uB9D0\uD558\uB294 \uB3D9\uC548 \uC0AC\uD0D5 \uAECD\uC9C8\uC744 \uACC4\uC18D \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146738
    m_Localized: "\uD55C\uD30C\uAC00 \uC774\uC5B4\uC84C\uB2E4. \uC5F0\uB8CC\uAC00 \uBC14\uB2E5\uC744 \uBCF4\uC600\uB2E4. \uAE30\uB984\uD1B5\uC744 \uD754\uB4E4\uC790 \uBC14\uB2E5\uC5D0\uC11C \uCC30\uB791 \uC18C\uB9AC\uB9CC \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146737
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uBCF4\uB958\uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146736
    m_Localized: "\uAD6C\uC870\uAC00 \uC624\uAE30\uB294 \uD558\uB294\uC9C0\uC870\uCC28 \uC544\uC9C1 \uBAA8\uB978\uB2E4. \uADF8\uB798\uB3C4 \uB204\uAD70\uAC00 \uC624\uBA74, \uAC00\uC7A5 \uBA3C\uC800 \uB118\uAE38 \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146735
    m_Localized: "\uAD6C\uC870\uB300\uAC00 \uC624\uBA74 \uB118\uAE38 \uAC83. \uADF8\uB9AC\uACE0 \uADF8 \uC704\uC758 \uB204\uAD70\uAC00\uC5D0\uAC8C\uAE4C\uC9C0, \uB05D\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146734
    m_Localized: "\uC885\uC774\uB4E4\uC744 \uD55C \uC7A5\uB3C4 \uBE60\uC9D0\uC5C6\uC774 \uBE44\uB2D0\uC5D0 \uB123\uACE0, \uD14C\uC774\uD504\uB85C \uC138 \uBC88 \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146733
    m_Localized: "{0}\uC5D0\uAC8C \uCC98\uC74C \uD138\uC5B4\uB193\uB358 \uC544\uCE68\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB9D0\uD558\uB294 \uAC74, \uD55C \uBC88 \uD574 \uBCF4\uBA74 \uB2E4\uC74C\uC774 \uC870\uAE08 \uC26C\uC6CC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146732
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uCC98\uB7FC \uB208\uC744 \uB5BC\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB9CC \uC774\uBC88\uC5D0\uB294, \uBCF4\uB294 \uB370\uC11C \uBA48\uCD94\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146731
    m_Localized: "\uC608\uC804 \uAC19\uC73C\uBA74 \uC774 \uC885\uC774\uB4E4\uC744 \uADF8\uB300\uB85C \uB450\uACE0 \uBA3C\uC800 \uC77C\uC5B4\uB0AC\uC744 \uAC83\uC774\uB2E4. \uC624\uB298\uC740 \uB05D\uAE4C\uC9C0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146730
    m_Localized: "\uC608\uC804 \uAC19\uC73C\uBA74 \uC5EC\uAE30\uC11C \uC6C3\uC5B4 \uBC84\uB838\uC744 \uAC83\uC774\uB2E4. \uBCC4\uC77C \uC544\uB2C8\uB77C\uB294 \uB4EF\uC774. \uC6C3\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706394
    m_Localized: "\uD55C \uC0AC\uB78C\uC774 \uC54C\uACE0 \uC788\uB2E4\uB294 \uAC83. \uCC3D\uACE0\uC758 \uC5FF\uC0C8 \uB3D9\uC548, \uADF8\uB9AC\uACE0 \uADF8 \uB4A4\uB85C\uB3C4 \uC190\uC5D0 \uC950\uACE0 \uC788\uB358 \uAC74 \uADF8\uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706395
    m_Localized: "\"\uB2E4 \uB9D0\uD558\uC9C0 \uBABB\uD574\uB3C4 \uAD1C\uCC2E\uC544. \uC870\uAE08\uC529\uC774\uBA74 \uB3FC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706396
    m_Localized: "\uADF8\uB0A0\uC740 \uC544\uC8FC \uC870\uAE08\uB9CC \uB9D0\uD588\uB2E4. \uADF8 \uB4A4\uB85C\uB3C4 \uC870\uAE08\uC529. \uC120\uC0DD\uB2D8\uC5D0\uAC8C, \uC77C\uAE30\uC7A5\uC5D0, \uB098 \uC790\uC2E0\uC5D0\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706397
    m_Localized: "\uD559\uAD50 \uB4A4 \uD558\uCC9C \uC0B0\uCC45\uB85C\uAE4C\uC9C0 \uB098\uAC00 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654305
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC544. \uADF8\uB7FC \uAC19\uC774 \uC77D\uC790. \uBAA8\uB974\uB294 \uAC74 \uBAA8\uB978\uB2E4\uACE0 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146729
    m_Localized: "\uD654\uAC00 \uB098\uC57C \uD558\uB294\uB370, \uC774\uC0C1\uD558\uAC8C \uC190\uC774 \uCC28\uBD84\uD588\uB2E4. \uC2DC\uD5D8\uC9C0 \uB2F5\uC744 \uB2E4 \uB9DE\uCDB0 \uBCF8 \uB4A4\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146728
    m_Localized: "\uB204\uAD70\uAC00 \uBBF8\uB9AC \uC54C\uC558\uACE0, \uB9D0\uD588\uACE0, \uBB35\uC0B4\uB2F9\uD588\uB2E4. \uB204\uAD70\uAC00\uB294 \uBCF4\uB958\uB77C\uACE0 \uC801\uC5C8\uB2E4. \uADF8 \uC0AC\uC774 \uB3C4\uC2DC\uB294 \uBB3C\uC744 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786285
    m_Localized: "\uB3C4\uD604: \uAC15\uB3C4\uD604\uC774\uC694. \uC0C8\uBCBD\uC911 3\uD559\uB144. \uD615 \uD559\uAD50 \uAD6C\uACBD \uC654\uB2E4\uAC00\u2026 \uADF8\uB0A0\uBD80\uD130 \uC5EC\uAE30 \uC788\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786284
    m_Localized: "\uC791\uC740 \uC544\uC774\uC600\uB2E4. \uC911\uD559\uAD50 \uCCB4\uC721\uBCF5, \uC2E0\uBC1C \uD55C \uC9DD\uC740 \uB048\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174791
    m_Localized: "\uC800\uB141\uC744 \uBA39\uB2E4 \uC120\uC0DD\uB2D8\uC758 \uC21F\uAC00\uB77D\uC774 \uBA48\uCDC4\uB2E4. \uC190\uB4F1\uC5D0 \uD54F\uC904\uC774 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146727
    m_Localized: "\uC120\uC774 \uBAA8\uB450 \uD55C \uC810\uC73C\uB85C \uBAA8\uC600\uB2E4. \uC0C8\uBCBD\uC815\uC218\uC7A5. \uADF8\uB9AC\uACE0 \uADF8 \uBB3C\uC744 \uBC1B\uC544 \uC4F0\uB358 \uACF3\uB4E4. \uC6B0\uB9AC \uD559\uAD50 \uC74C\uC218\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146726
    m_Localized: "\uBE68\uAC04 \uD39C\uC73C\uB85C \uC120\uC744 \uADF8\uC5C8\uB2E4. \uB0A0\uC9DC\uC5D0\uC11C \uB0A0\uC9DC\uB85C, \uB3C4\uC7A5\uC5D0\uC11C \uB3C4\uC7A5\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146725
    m_Localized: "\uADF8\uB9AC\uACE0 \uC885\uC774\uB85C\uB294 \uC5C6\uB294 \uAC83. \uCC3D\uACE0\uC5D0 \uAC07\uD600 \uC788\uB358 \uADF8 \uC77C\uC8FC\uC77C, \uBCBD \uB108\uBA38\uB85C \uB4E4\uB9AC\uB358 \uC18C\uB9AC\uB4E4. \uCC98\uC74C\uC774 \uC544\uB2C8\uB77C\uB294 \uAE30\uBD84."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654304
    m_Localized: "{0}: \uC54C\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654303
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBBF8\uB9AC \uB9D0\uD574 \uB450\uB294\uB370, \uB098 \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC778 \uAC70 \uC54C\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654302
    m_Localized: "\uACFC\uD559 \uAD50\uACFC\uC11C\uB97C \uCC45\uC0C1\uC5D0 \uD3BC\uCCE4\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uD5DB\uAE30\uCE68\uC744 \uD55C \uBC88 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826520
    m_Localized: "\uB098\uB294 \uB9E4\uC9C1\uC73C\uB85C \uCC45\uC0C1 \uBAA8\uC11C\uB9AC\uC5D0 '\uC791\uC5C5\uB300'\uB77C\uACE0 \uC37C\uB2E4. \uAE00\uC528\uAC00 \uC090\uB6A4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706398
    m_Localized: "\uD558\uCC9C \uB451\uC5D0 \uB0C9\uC774\uC640 \uC465\uC774 \uC794\uB729 \uC62C\uB77C\uC640 \uC788\uC5C8\uB2E4. \uD55C \uC90C\uC529 \uB72F\uC5B4 \uBD09\uC9C0\uC5D0 \uB2F4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146724
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uC9C0\uD558\uC758 \uD30C\uC77C. \uD734\uBA74 \uC0C1\uD0DC \uAC10\uC5FC \uCD94\uC801 \uAD00\uCC30. \uB300\uC678\uBE44."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146723
    m_Localized: "\uADF8 \uB4A4. \uB77C\uB514\uC624 DJ\uAC00 \uAE30\uC5B5\uD558\uB358, \uC5F0\uAD6C\uC6D0\uC758 \uB9C8\uC9C0\uB9C9 \uBB34\uC804."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174919
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uAC74\uC73C\uB85C \uB3C4\uD604\uC758 \uC5BC\uAD74\uC744 \uB36E\uC5C8\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC218\uAC74 \uBC11\uC5D0\uC11C \uC0C8\uC5B4 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786283
    m_Localized: "\uC18C\uB9AC\uB294 \uD55C\uCC38 \uB354 \uC774\uC5B4\uC9C0\uB2E4 \uBA48\uCDC4\uB2E4. \uADF8\uB0A0 \uBC24\uC740 \uC7A0\uC774 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786282
    m_Localized: "\uBABB \uB4E4\uC740 \uAC78\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174790
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544\u2026 \uAC00\uB054 \uC774\uB798. \uAE08\uBC29 \uC9C0\uB098\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146722
    m_Localized: "\uADF8\uB0A0. \uC9C0\uD558\uCCA0 \uC5ED\uBB34\uC2E4\uC5D0 \uBA48\uCDB0 \uC788\uB358 \uB9C8\uC9C0\uB9C9 \uC548\uB0B4 \uBC29\uC1A1."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146721
    m_Localized: "\uC0AC\uD0DC \uBA70\uCE60 \uC804. \uAD50\uB0B4 \uB300\uAE30 \uACF5\uBB38. \uADF8 \uC704\uC5D0 \uB204\uAD70\uAC00 \uC801\uC740 \uBCF4\uB958 \uD574\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146720
    m_Localized: "\uC0AC\uD0DC \uC0AC\uD758 \uC804. \uD559\uAD50\uC5D0 \uC628 \uACF5\uBB38. \uC74C\uC218\uB300 \uC0AC\uC6A9 \uC911\uC9C0 \uC694\uCCAD. \uCC98\uB9AC \uCE78\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146719
    m_Localized: "\uC0AC\uD0DC \uB2F7\uC0C8 \uC804. \uD30C\uCD9C\uC18C \uC11C\uB958\uCCA0. \uC0C8\uBCBD\uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9, \uAE34\uAE09 \uCD9C\uC785 \uD1B5\uC81C \uD611\uC870 \uC694\uCCAD."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706399
    m_Localized: "\uBB3C\uC18C\uB9AC\uAC00 \uCEE4\uC11C, \uC624\uB79C\uB9CC\uC5D0 \uB0B4 \uBC1C\uC18C\uB9AC\uB97C \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uACE0 \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369153
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC228\uAE34 \uAC70 \uD0D3\uD558\uC9C0 \uC54A\uC544. \uC228\uAE30\uACE0 \uC2F6\uC744 \uB9CC\uD588\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369152
    m_Localized: "\uD654\uB09C \uBAA9\uC18C\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB798\uC11C \uB354 \uC544\uD320\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369151
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70\u2026 \uB124\uAC00 \uC228\uACA8 \uB454 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369150
    m_Localized: "\uAC00\uBC29\uC744 \uC815\uB9AC\uD558\uB358 \uC120\uC0DD\uB2D8\uC774 \uBA48\uCDC4\uB2E4. \uC190\uC5D0 \uADF8 \uD30C\uC77C\uC774 \uB4E4\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757762
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uCC3D\uBC16\uC740 \uBC8C\uC368 \uACA8\uC6B8\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146384
    m_Localized: "\uC724\uC601\uD604. \uC774\uBC88\uC5D0\uB294 \uB9DD\uC124\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146385
    m_Localized: "\uC120\uC0DD\uB2D8 \uC774\uB984\uC744 \uBD80\uB97C \uCC28\uB840\uC5D0\uC11C, \uC7A0\uAE50 \uBA48\uCDC4\uB2E4. \uBA85\uB2E8\uC5D0 \uC624\uB978\uB2E4\uACE0 \uD5EC\uAE30\uC5D0 \uC624\uB974\uB294 \uAC74 \uC544\uB2C8\uB77C\uB294 \uAC78 \uC54C\uC558\uB2E4. \uADF8\uB798\uB3C4 \uBD88\uB800\uB2E4. \uC724\uC601\uD604."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146386
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC5D0 \uB0B4 \uC774\uB984\uC744 \uBD88\uB800\uB2E4. \uBAA9\uC774 \uBA54\uC5B4\uC11C \uB450 \uBC88 \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174852
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uD39C\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786238
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77C\uC8FC\uC77C\uC774\uB098 \uAC78\uB838\uB124. \uBBF8\uC548\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786239
    m_Localized: "\uADF8\uB0A0 \uC598\uAE30\uB97C \uB354 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146387
    m_Localized: "DJ: \uB2E4 \uBC1B\uC558\uC5B4\uC694. \u2026\uD55C \uBA85\uB3C4 \uC548 \uBE60\uC84C\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146388
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0\uB9CC \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146389
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC\uC694. \uC815\uB9D0\uB85C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146390
    m_Localized: "DJ: \uB098\uC911\uC5D0 \uC9C1\uC811 \uB9CC\uB098\uC11C \uD574\uC694, \uADF8 \uB9D0. \uC18C\uBCF4\uB85C \uBE75 \uC0AC \uC904\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146391
    m_Localized: "DJ: \uBA85\uB2E8\uC740 \uB0B4\uAC00 \uC54C\uC544\uC11C \uBD88\uB7EC \uB458\uAC8C\uC694. \uD559\uAD50\uC5D0 \uC788\uB2E4\uACE0 \uB4E4\uC740 \uC774\uB984\uC740, \uD558\uB098\uB3C4 \uC548 \uBE7C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146392
    m_Localized: "\uBB34\uC804\uC774 \uB04A\uAE34 \uB4A4\uC5D0\uB3C4 \uD55C\uCC38, \uC1A1\uC2E0 \uBC84\uD2BC\uC5D0\uC11C \uC190\uC744 \uB5BC\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146393
    m_Localized: "DJ: \uB3C4\uD604 \uD559\uC0DD, \uAC70\uAE30 \uC788\uC5B4\uC694? \u2026\uCC3E\uC558\uC5B4\uC694. \uCCB4\uC721\uACF5\uC6D0\uC5D0\uC11C \uB118\uC5B4\uC628 \uC0AC\uB78C\uB4E4 \uBA85\uB2E8\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146394
    m_Localized: "DJ: \uC9C0\uAE08 \uC606\uC5D0 \uACC4\uC138\uC694. \uBC14\uAFD4 \uB4DC\uB9B4\uAC8C\uC694. \uBC30\uD130\uB9AC \uAC71\uC815\uC740 \uC624\uB298\uB9CC \uD558\uC9C0 \uB9D0\uC544\uC694. \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146395
    m_Localized: "\uBB34\uC804\uAE30 \uB108\uBA38\uAC00 \uC7A0\uAE50 \uC870\uC6A9\uD588\uB2E4. \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C, \uC228 \uACE0\uB974\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146396
    m_Localized: "???: \u2026\uB3C4\uD604\uC544. \uC5C4\uB9C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174851
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD574\uC5F4\uC81C\uB97C \uB098\uB220 \uC8FC\uACE0, \uC870\uD1F4\uC99D\uC5D0 \uB3C4\uC7A5\uC744 \uCC0D\uC5C8\uC5B4. \uBC31 \uC7A5\uB3C4 \uB118\uAC8C. \uC9D1\uC5D0 \uAC00\uC11C \uC26C\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786240
    m_Localized: "{0}: \uADF8\uB798\uB3C4 \uC624\uC168\uC796\uC544\uC694. \uADF8\uAC70\uBA74 \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786241
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uB9D0, \uC624\uB798 \uAE30\uC5B5\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146397
    m_Localized: "\uB3C4\uD604\uC774 \uBB34\uC804\uAE30\uB97C \uB450 \uC190\uC73C\uB85C \uBD99\uC7A1\uC558\uB2E4. \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4. \uC785\uB9CC \uC5F4\uB838\uB2E4 \uB2EB\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146398
    m_Localized: "???: \uB3C4\uC2DC\uB77D \uB2E4 \uBA39\uC5C8\uC5B4? \uADF8\uB0A0 \uC2F8 \uC900 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146399
    m_Localized: "\uB3C4\uD604: \u2026\uB2E4 \uBA39\uC5C8\uC5B4. \uC5C4\uB9C8. \uB2E4 \uBA39\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146400
    m_Localized: "\uB3C4\uD604: \uACC4\uB780\uB9D0\uC774\uB3C4 \uB2E4 \uBA39\uC5C8\uC5B4. \uB9DB\uC5C6\uB2E4\uACE0 \uD588\uB358 \uAC70, \uADF8\uAC70 \uAC70\uC9D3\uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146401
    m_Localized: "???: \uC54C\uC544. \uC5C4\uB9C8\uB3C4 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146402
    m_Localized: "\uB3C4\uD604\uC758 \uAC00\uC2B4 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC811\uD78C \uCABD\uC9C0 \uB05D\uC774 \uBCF4\uC600\uB2E4. \uB0C9\uC7A5\uACE0 \uBB38\uC5D0\uC11C \uB5BC\uC5B4 \uC628 \uADF8 \uCABD\uC9C0. \uAF2D \uC640. \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146403
    m_Localized: "???: \uAD6C\uC870\uB418\uBA74 \uCCB4\uC721\uACF5\uC6D0\uC73C\uB85C \uC640. \uC5C4\uB9C8 \uAC70\uAE30 \uC788\uC744\uAC8C. \uC774\uBC88\uC5D4 \uC5B4\uB514 \uC548 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146404
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB3C4\uD604\uC740 \uBB34\uC804\uAE30\uB97C \uC548\uACE0 \uC7A4\uB2E4. \uC544\uBB34\uB3C4 \uB044\uB77C\uACE0 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146405
    m_Localized: "\uBC30\uD130\uB9AC\uAC00 \uB2F3\uB294 \uAC78 \uC54C\uBA74\uC11C\uB3C4, \uADF8 \uBC24\uB9CC\uC740 \uB2E4\uB4E4 \uBAA8\uB978 \uCC99\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146406
    m_Localized: "DJ: \uC0C8\uBCBD\uC2DC \uC5B4\uB518\uAC00\uC5D0\uC11C \uC544\uC9C1 \uAE68\uC5B4 \uC788\uB294 \uC5EC\uB7EC\uBD84. \uC624\uB298\uC774 \uC81C \uB9C8\uC9C0\uB9C9 \uC815\uADDC \uBC29\uC1A1\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146407
    m_Localized: "DJ: \uAD6C\uC870\uAC00 \uC2DC\uC791\uB418\uBA74, \uC800\uB3C4 \uC774 \uB9C8\uC774\uD06C\uB97C \uB044\uACE0 \uC904\uC744 \uC11C\uC57C \uD558\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146408
    m_Localized: "DJ: \uCC98\uC74C\uC5D4 \uC544\uBB34\uB3C4 \uC548 \uB4E3\uB294 \uC904 \uC54C\uC558\uC5B4\uC694. \uD63C\uC7A3\uB9D0\uCC98\uB7FC \uB5A0\uB4E4\uC5C8\uC8E0. \uADF8\uB7EC\uB2E4 \uCCAB \uC0AC\uC5F0\uC774 \uC654\uC5B4\uC694. \uADF8\uB0A0 \uC6B8\uC5C8\uC5B4\uC694. \uBC29\uC1A1 \uC911\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146409
    m_Localized: "DJ: \uC624\uB298\uC758 \uC2E0\uCCAD\uACE1\uC740\u2026 \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC5D0\uC11C \uB4E4\uC5B4\uC628 \uAC70\uC608\uC694. \uBA87 \uB2EC \uC804\uC5D0 '\uC2E0\uB098\uB294 \uAC78\uB85C'\uB77C\uACE0 \uD588\uB358."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146410
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C \uC2E0\uB098\uB294 \uB178\uB798\uAC00 \uD758\uB800\uB2E4. \uB2E4\uB4E4 \uCC98\uC74C\uC5D4 \uAC00\uB9CC\uD788 \uB4E3\uB2E4\uAC00, \uD558\uB098\uB458 \uBC1C\uB85C \uBC15\uC790\uB97C \uB9DE\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146411
    m_Localized: "\uB3C4\uD604\uC774 \uBA3C\uC800 \uC77C\uC5B4\uB098 \uC5B4\uAE68\uB97C \uB4E4\uC369\uC600\uB2E4. \uB204\uAD70\uAC00 \uC6C3\uC74C\uC744 \uD130\uB728\uB838\uACE0, \uC6C3\uC74C\uC774 \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146412
    m_Localized: "\uBC29\uC1A1\uC2E4 \uCABD \uBCBD \uB108\uBA38\uC5D0\uC11C \uB611, \uB611, \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBC15\uC790\uC5D0 \uB9DE\uCDB0, \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146413
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB204\uC6B4 \uCC44\uB85C \uC774\uBD88 \uC704\uC5D0 \uC190\uAC00\uB77D\uC73C\uB85C \uBC15\uC790\uB97C \uC9DA\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146414
    m_Localized: "\uB178\uB798\uAC00 \uB05D\uB098\uACE0, \uC7A0\uAE50 \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146415
    m_Localized: "DJ: \uB0B4\uC77C\uB3C4 \uC0B4\uC544 \uC788\uC5B4\uC694. \uADF8\uAC8C \uC624\uB298\uC758, \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9 \uC219\uC81C\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146416
    m_Localized: "DJ: \uADF8\uB7FC\u2026 \uC625\uC0C1\uC5D0\uC11C \uB9CC\uB098\uC694. \uB2E4\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174850
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uB098\uB294 \uBCF4\uAC74\uC2E4\uC5D0 \uC788\uC5C8\uC5B4. \uC5F4\uB098\uB294 \uC560\uB4E4\uC774 \uC904\uC744 \uC130\uC9C0. \uCC98\uC74C\uC5D4 \uB2E4 \uB3C5\uAC10\uC778 \uC904 \uC54C\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786242
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uB0A0 \uBCF8 \uAC83\uB4E4\uC744 \uCC9C\uCC9C\uD788, \uD558\uB098\uC529 \uC774\uC57C\uAE30\uD588\uB2E4. \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174942
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A5\uB9C8\uB294 \uD55C \uB2EC\uCBE4 \uAC08 \uAC70\uC57C. \uBB3C\uC740 \uB118\uCE58\uB294\uB370 \uB9C8\uC2E4 \uBB3C\uC740 \uBAA8\uC790\uB780 \uACC4\uC808\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146417
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC9C0\uC9C1\uAC70\uB9BC \uB4A4\uB85C, \uADF8 \uC8FC\uD30C\uC218\uC5D0\uB294 \uBC14\uB78C \uC18C\uB9AC\uB9CC \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146418
    m_Localized: "\uBC24. \uB3C4\uD604\uC774 \uAC00\uBC29\uC744 \uB2E4 \uC2F8 \uB193\uACE0\uB3C4 \uC7A0\uB4E4\uC9C0 \uBABB\uD558\uACE0 \uC788\uC5C8\uB2E4. \uAC00\uBC29\uB048\uC744 \uD480\uC5C8\uB2E4 \uBB36\uC5C8\uB2E4 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146419
    m_Localized: "\uB3C4\uD604: \uB204\uB098. \uAD6C\uC870\uB418\uBA74 \uC5C4\uB9C8\uD55C\uD14C \uBA3C\uC800 \uAC00\uC694. \uADFC\uB370 \uADF8\uB2E4\uC74C\uC5D4\u2026 \uB204\uB098 \uC5B4\uB514 \uC788\uB294\uC9C0 \uAF2D \uC54C\uB824 \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174955
    m_Localized: "\uB540\uC744 \uD758\uB9AC\uBA70 \uBA39\uC5C8\uB2E4. \uC5EC\uB984\uC774\uB77C\uC11C\uC778\uC9C0, \uB530\uB73B\uD574\uC11C\uC778\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980533
    m_Localized: "{0}: \uC800 \uB2EC\uB9AC\uAE30 \uC2EB\uC5B4\uD588\uC5B4\uC694. \uCCB4\uC721\uB300\uD68C \uB0A0\uB9C8\uB2E4 \uBE44 \uC624\uB77C\uACE0 \uBE4C\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146420
    m_Localized: "\uB3C4\uD604: \uC5C4\uB9C8\uAC00 \uADF8\uB7EC\uB294\uB370, \uBB34\uC804\uC73C\uB85C \uB204\uB098 \uC598\uAE30\uB97C \uC5C4\uCCAD \uD588\uB300\uC694. \uC800\uB294 \uAE30\uC5B5\uB3C4 \uC548 \uB098\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146421
    m_Localized: "\uB3C4\uD604: \uB204\uB098. \uAD6C\uC870\uB418\uBA74 \uC5C4\uB9C8 \uCC3E\uC744 \uAC70\uC608\uC694. \uCC3E\uC744 \uB54C\uAE4C\uC9C0. \uB204\uB098\uAC00 \uADF8\uB7AC\uC796\uC544\uC694. \uAE38 \uC798 \uCC3E\uB294 \uC0AC\uB78C\uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146422
    m_Localized: "\uB3C4\uD604: \uCCB4\uC721\uACF5\uC6D0\uBD80\uD130 \uAC08 \uAC70\uC608\uC694. \uAC70\uAE30 \uC5C6\uC73C\uBA74 \uADF8\uB2E4\uC74C \uB300\uD53C\uC18C. \uADF8\uB2E4\uC74C, \uADF8\uB2E4\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146423
    m_Localized: "\uB3C4\uD604: \uB204\uB098 \uC5C6\uC5C8\uC73C\uBA74 \uC800 \uADF8 \uC9D1 \uBB38 \uC55E\uC5D0\uC11C \uADF8\uB0E5 \uC788\uC5C8\uC744 \uAC70\uC608\uC694. \uBB38 \uB450\uB4DC\uB9AC\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146424
    m_Localized: "\uB3C4\uD604: \uC774 \uD559\uAD50\uC5D0\uC11C \uC800 \uC9C4\uC9DC \uB9CE\uC774 \uCEF8\uC5B4\uC694. \uD0A4 \uB9D0\uACE0\uC694. \u2026\uD0A4\uB3C4 \uC880 \uCEF8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146425
    m_Localized: "\uAF2D \uB2E4\uC2DC \uB9CC\uB098\uC790\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174849
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC7A0 \uC548 \uC640? \uB098\uB3C4. \uC549\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786243
    m_Localized: "\uC774\uC81C \uADF8\uB9CC \uC26C\uC2DC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786244
    m_Localized: "{0}: \uC624\uB298\uC740 \uADF8\uB9CC\uD574\uC694. \uBD95\uB300 \uAC08\uACE0 \uC26C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146426
    m_Localized: "\uC0C8\uB07C\uC190\uAC00\uB77D\uC744 \uAC78\uC5C8\uB2E4. \uB3C4\uD604\uC774 \uC5C4\uC9C0\uB85C \uB3C4\uC7A5\uAE4C\uC9C0 \uCC0D\uC5C8\uB2E4. \uCD08\uB4F1\uD559\uC0DD\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146427
    m_Localized: "\uB3C4\uD604: \uBCF5\uC0AC\uB3C4 \uD574\uC694. \uBCF5\uC0AC. \uC774\uAC70 \uC548 \uD558\uBA74 \uBB34\uD6A8\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146336
    m_Localized: "\uC544\uCE68. \uB2F4\uC7A5 \uC544\uB798 \uB208\uBC2D\uC774 \uC628\uD1B5 \uC9D3\uBC1F\uD600 \uC788\uC5C8\uB2E4. \uC624 \uC528 \uD328\uAC70\uB9AC\uB294 \uAC15\uBCC0 \uCABD\uC73C\uB85C \uD769\uC5B4\uC84C\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146335
    m_Localized: "\uBC1C\uC18C\uB9AC\uAC00 \uACC4\uB2E8 \uC544\uB798\uC5D0\uC11C \uBA48\uCDC4\uB2E4. \uC62C\uB77C\uC624\uC9C0 \uC54A\uC558\uB2E4. \uC544\uB798\uC5D0\uC11C \uB204\uAD70\uAC00 \uC9E7\uAC8C \uB9D0\uD588\uB2E4. \uB410\uB2E4, \uC5EC\uAE30\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146334
    m_Localized: "1\uCE35\uC774 \uB6AB\uB838\uB2E4. \uCC3D\uACE0 \uBB38 \uB72F\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC6B0\uB9AC\uB294 \uC625\uC0C1 \uACC4\uB2E8 \uC55E\uC5D0 \uBAA8\uC5EC \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146333
    m_Localized: "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0A8\uC740 \uAC74 \uAC15\uCCA0\uC774\uC5C8\uB2E4. \uADF8\uB294 \uD55C\uCC38 \uC625\uC0C1\uC744 \uC62C\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146332
    m_Localized: "\uACC4\uB2E8 \uD558\uB098, \uBB38 \uD558\uB098\uB97C \uB450\uACE0 \uBC24\uC0C8 \uBC00\uACE0 \uBC00\uB838\uB2E4. \uC0C8\uBCBD\uC774 \uB418\uC790 \uC6B0\uBE44\uB4E4\uC758 \uBC1C\uC18C\uB9AC\uAC00 \uD558\uB098\uC529 \uAD50\uBB38 \uBC16\uC73C\uB85C \uBE60\uC838\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146331
    m_Localized: "\uAC15\uCCA0: \uADF8\uB7EC\uB2C8\uAE4C \uBE68\uB9AC \uB05D\uB0B4\uC790\uB294 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146330
    m_Localized: "{0}: \uAC15\uCCA0 \uC544\uC800\uC528! \uD5EC\uAE30\uB294 \uC2F8\uC6B0\uB294 \uB370\uC5D4 \uC548 \uB0B4\uB824\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146329
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uBB38\uC73C\uB85C \uB2E4\uC12F, \uC67C\uCABD \uACC4\uB2E8\uC73C\uB85C \uC14B. \uC625\uC0C1 \uBB38\uC740 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C. \uC624\uB298\uC740 \uB098\uB3C4 \uBB38 \uC55E\uC5D0 \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146328
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBCBD\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC130\uB2E4. \uC544\uBB34\uB3C4 \uB9D0\uB9AC\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786232
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984\uC774 \uC640. \uB365\uACE0, \uAE38\uACE0, \uC544\uB9C8 \uB354 \uD798\uB4E4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786231
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC544\uC774 \uC77C\uC740\u2026 \uC26C\uC6B4 \uC120\uD0DD\uC774 \uC544\uB2C8\uC5C8\uB2E4\uB294 \uAC70 \uC54C\uC544. \uB108\uBB34 \uC624\uB798 \uBD99\uB4E4\uACE0 \uC788\uC9C4 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174858
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uC791\uC558\uB2E4. \uC18C\uB3C5\uC57D \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146327
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146326
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC758\uC871\uC744 \uACE0\uCCD0 \uCC44\uC6B0\uACE0 \uC77C\uC5B4\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146325
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uB208\uC774 \uB418\uC5B4 \uC8FC\uB9C8. \uC815\uBB38\uC73C\uB85C \uB2E4\uC12F, \uC67C\uCABD \uACC4\uB2E8\uC73C\uB85C \uC14B. \uC625\uC0C1 \uBB38\uC740 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146324
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146323
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uBB38\uC73C\uB85C \uB2E4\uC12F, \uC67C\uCABD \uACC4\uB2E8\uC73C\uB85C \uC14B. \uC625\uC0C1 \uBB38\uC740 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C. \uC624\uB298\uC740 \uB098\uB3C4 \uBB38 \uC55E\uC5D0 \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146322
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC625\uC0C1 \uBB38 \uC55E\uC5D0 \uC130\uB2E4. \uC5F4\uC774 \uB0B4\uB9B0 \uBAB8\uC73C\uB85C, \uB611\uBC14\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460276
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBD95\uB300\uB97C \uAC08 \uB54C \uB298 \uB4F1\uC744 \uB3CC\uB9B0\uB2E4. \uB05D\uB098\uACE0 \uB3CC\uC544\uBCF4\uB294 \uC5BC\uAD74\uC740 \uC5B8\uC81C\uB098 \uC6C3\uACE0 \uC788\uB2E4. \uADF8 \uC804\uC758 \uC5BC\uAD74\uC740 \uD55C \uBC88\uB3C4 \uBCF8 \uC801\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146321
    m_Localized: "\uC120\uBC30\uB294 \uB9E1\uAE34 \uB300\uB85C \uC67C\uCABD \uACC4\uB2E8\uCC38\uC5D0 \uC130\uB2E4. \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC774\uACE0, \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786230
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uD604\uC774\uB97C \uB370\uB824\uC628 \uAC74 \uB124 \uC120\uD0DD\uC774\uC5C8\uC5B4. \uADF8 \uC560\uD55C\uD14C\uB3C4, \uB098\uD55C\uD14C\uB3C4 \uD070\uC77C\uC774\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786229
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uBAA9\uBC1C, \uB0B4\uAC00 \uBC1B\uC740 \uC120\uBB3C \uC911\uC5D0 \uC81C\uC77C \uC88B\uC740 \uAC70\uC57C. \uC9C4\uC2EC\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174859
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC774\uB7EC\uBA74 \uB0B4\uAC00 \uC704\uB85C\uBC1B\uB294 \uCABD\uC774 \uB418\uC796\uC544. \uBC18\uCE59\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146320
    m_Localized: "\uACC4\uB2E8\uCC38\uC5D0 \uC120 \uC120\uBC30\uB97C \uBCF4\uACE0, \uC55E\uC7A5\uC120 \uC6B0\uBE44 \uD558\uB098\uAC00 \uBA48\uCE6B\uD588\uB2E4. \uADF8 \uD55C \uBC15\uC790\uC5D0 \uACC4\uB2E8 \uD558\uB098\uB97C \uB354 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146319
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 3\uCE35 \uCC3D\uAC00\uC5D0\uC11C \uC190\uC804\uB4F1\uC744 \uC138 \uBC88 \uAE5C\uBE61\uC600\uB2E4. \uC815\uBB38, \uB2E4\uC12F."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146318
    m_Localized: "\uCD5C\uD558\uB9B0: \uC0AC\uB78C\uC774 \uC0AC\uB78C \uBB38 \uB530\uB294 \uAC70, \uC81C\uC77C \uC2EB\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146317
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uC815\uBB38 \uCABD \uACC4\uB2E8\uC73C\uB85C \uB0B4\uB824\uAC00\uBA70 \uC911\uC5BC\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146316
    m_Localized: "\uBB34\uB9AC \uC18D\uC5D0 \uC900\uC740 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC8C \uB2E4\uD589\uC778\uC9C0 \uC544\uB2CC\uC9C0, \uC0DD\uAC01\uD560 \uD2C8\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146315
    m_Localized: "\uAC15\uCCA0: \uC625\uC0C1\uB9CC \uBE44\uC6CC. \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4. \uADF8\uAC83\uB3C4 \uC6D0\uCE59\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146314
    m_Localized: "\uAC15\uCCA0: \uC77C\uC8FC\uC77C \uC92C\uB2E4. \uC6D0\uCE59\uB300\uB85C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786228
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD798\uB4E0 \uB0A0\uB3C4, \uAD1C\uCC2E\uC740 \uB0A0\uB3C4 \uC788\uC5C8\uC9C0. \uADF8\uAC8C \uC0AC\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786227
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uB054 \uB108\uBB34 \uD63C\uC790 \uACAC\uB514\uB824\uACE0 \uD574. \uAE30\uB300\uB3C4 \uB3FC. \uB098\uB77C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174860
    m_Localized: "\uC57D\uC7A5\uC5D0 \uB0A8\uC740 \uAC74 \uBD95\uB300 \uB450 \uB864\uACFC \uC9C4\uD1B5\uC81C \uBA87 \uC54C\uC774 \uC804\uBD80\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146313
    m_Localized: "\uB9E8 \uC55E\uC5D0 \uAC15\uCCA0\uC774 \uC788\uC5C8\uB2E4. \uC6B0\uBE44\uB4E4\uC774 \uADF8 \uB4A4\uB85C \uB05D\uC5C6\uC774 \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146312
    m_Localized: "\uAD6C\uC870\uB97C 3\uC8FC \uC55E\uB454 \uBC24. \uBD89\uC740 \uD398\uC778\uD2B8\uB97C \uCE60\uD55C \uAD50\uBB38\uC774 \uC1E0\uC0AC\uC2AC \uB04A\uAE30\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146311
    m_Localized: "\uB0A0\uC774 \uBC1D\uC744 \uBB34\uB835\uC5D0\uC57C \uC18C\uB780\uC774 \uAC00\uB77C\uC549\uC558\uB2E4. \uC625\uC0C1 \uBB38\uC740 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146310
    m_Localized: "\uB2F4\uC7A5 \uD55C\uCABD\uC774 \uBB34\uB108\uC84C\uB2E4. \uBA87\uC774 \uCC3D\uACE0 \uCABD\uC73C\uB85C \uB6F0\uC5B4\uB4E4\uC5C8\uB2E4. \uC6B0\uBE44\uB4E4\uC774 \uADF8 \uB4A4\uB97C \uCAD3\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146309
    m_Localized: "\uC624 \uC528 \uD328\uAC70\uB9AC\uAC00 \uBB3C\uB7EC\uB098\uB294 \uC18C\uB9AC\uAC00 \uAC15\uBCC0 \uCABD\uC73C\uB85C \uBA40\uC5B4\uC84C\uB2E4. \uC815\uBB38\uC740 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146308
    m_Localized: "\uB2F4\uC7A5 \uC704\uC640 \uC544\uB798\uC5D0\uC11C \uACE0\uD568\uC774 \uC624\uAC14\uB2E4. \uAE30\uB984\uD1B5 \uD558\uB098\uAC00 \uB208\uBC2D\uC5D0 \uAD74\uB800\uB2E4. \uBD88\uC740 \uBD99\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146307
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uB9D9\uB2E4\uB294 \uB9D0\uC740 \uB0B4\uC77C \uC544\uCE68\uC5D0 \uD558\uC790. \uC624\uB298\uC740 \uBB38\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786226
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uB108\uB294\u2026 \uC798 \uC6C3\uAC8C \uB410\uC5B4. \uADF8\uAC8C \uC81C\uC77C \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786225
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAB8\uB3C4 \uB2E8\uB2E8\uD574\uC84C\uC5B4. \uCC98\uC74C \uCC3D\uACE0 \uBB38 \uC5F4\uC5C8\uC744 \uB54C\uB791 \uAC78\uC74C\uC774 \uB2EC\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174861
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC815\uD574\uC57C \uD560 \uAC8C \uC788\uC5B4. \uC57D\uC774 \uC774 \uC815\uB3C4\uBC16\uC5D0 \uC5C6\uC744 \uB54C, \uB204\uAC00 \uBA3C\uC800 \uC4F0\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146306
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC67C\uCABD \uACC4\uB2E8, \uC14B. \uBD81\uCABD \uB2F4\uC7A5\uC740 \uAC15\uCCA0 \uC528 \uCABD\uC5D0 \uB9E1\uAE30\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146305
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uAC00\uC5D0\uC11C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146304
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uC11C \uB2E4 \uBCF4\uC778\uB2E4. \uC67C\uCABD \uACC4\uB2E8, \uC14B. \uAC15\uCCA0 \uC528 \uCABD\uC740 \uBD81\uCABD \uB2F4\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758021
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4. \uBAA9\uC18C\uB9AC\uB294 \uC791\uC558\uC9C0\uB9CC \uB610\uB837\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758020
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC67C\uCABD \uACC4\uB2E8, \uC14B. \uBD81\uCABD \uB2F4\uC7A5\uC740 \uAC15\uCCA0 \uC528 \uCABD\uC5D0 \uB9E1\uAE30\uC790. \uC6B0\uB9AC\uB294 \uC6B0\uB9AC \uBB38\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758019
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC625\uC0C1 \uBB38 \uC55E\uC5D0\uC11C \uBB34\uC804\uAE30\uB97C \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758018
    m_Localized: "{0}: \uC624\uB298 \uBC24\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758017
    m_Localized: "\uB3C4\uD604: \uC800 \uC0AC\uB78C\uB4E4\u2026 \uC6B0\uB9AC \uD3B8 \uB9DE\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758016
    m_Localized: "\uB3C4\uD604\uC774 \uB0B4 \uC18C\uB9E4\uB97C \uC7A1\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758015
    m_Localized: "\uAC15\uCCA0: \uCC98\uC74C\uBD80\uD130. \uB124\uAC00 \uC548 \uB4E4\uC5C8\uC744 \uBFD0\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758014
    m_Localized: "\uC624 \uC528: \uD615\uB2D8\uC774 \uC5B8\uC81C\uBD80\uD130 \uC560\uB4E4 \uD3B8\uC774\uC5C8\uC18C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758013
    m_Localized: "\uAC15\uCCA0: \uC624 \uC528! \uC5EC\uAE30 \uC560\uB4E4 \uD559\uAD50\uB2E4. \uB3CC\uC544\uAC00\uB77C. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758012
    m_Localized: "\uADF8\uB54C \uB2F4\uC7A5 \uC704\uB85C \uC190\uC804\uB4F1 \uBD88\uBE5B\uC774 \uD558\uB098, \uB458, \uC5F4 \uAC1C \uB118\uAC8C \uCF1C\uC84C\uB2E4. \uC6B0\uBE44\uB4E4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758011
    m_Localized: "\uC624 \uC528: \uC57D \uC788\uB294 \uAC70 \uC548\uB2E4! \uBC18\uB9CC \uB0B4\uB194. \uADF8\uB7FC \uC544\uBB34\uB3C4 \uC548 \uB2E4\uCE5C\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460275
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC57D \uC0C1\uC790\uB97C \uC140 \uB54C\uB9C8\uB2E4 \uD55C \uBC88\uC529 \uC190\uC744 \uBA48\uCD98\uB2E4. \uAC19\uC740 \uC22B\uC790\uB97C \uB450 \uBC88 \uC13C\uB2E4. \uB204\uAD70\uAC00\uC758 \uBAAB\uC744 \uB530\uB85C \uB5BC\uC5B4 \uB450\uB294 \uC0AC\uB78C\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758010
    m_Localized: "\uB9E8 \uC55E\uC5D0\uC11C \uC624 \uC528\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758009
    m_Localized: "\uB208 \uC704\uB85C \uADF8\uB9BC\uC790\uB4E4\uC774 \uD559\uAD50\uB97C \uD5A5\uD574 \uAC78\uC5B4\uC654\uB2E4. \uC880\uBE44\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uC190\uC5D0 \uC1E0\uD30C\uC774\uD504\uC640 \uAE30\uB984\uD1B5\uC744 \uB4E0 \uC0AC\uB78C\uB4E4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758008
    m_Localized: "\uAD6C\uC870\uB97C 3\uC8FC \uC55E\uB454 \uBC24. \uB9C8\uC9C0\uB9C9 \uD55C\uD30C\uC600\uB2E4. \uAC15\uCCA0\uC774 \uB9D0\uD55C \uBC14\uB85C \uADF8\uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758007
    m_Localized: "\uADF8\uB0A0\uBD80\uD130 \uC544\uBB34\uB3C4 \uAD50\uBB38 \uCABD \uCC3D\uBB38\uC744 \uC5F4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758006
    m_Localized: "\uAC15\uCCA0: \uADF8\uB798. \uADF8\uB7FC \uADF8\uB0A0 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758005
    m_Localized: "{0}: \uC548 \uBE44\uC6CC\uC694. \uC5EC\uAE30\uB294 \uC6B0\uB9AC \uD559\uAD50\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758004
    m_Localized: "\uBE44\uC6B0\uC9C0 \uC54A\uB294\uB2E4. \uC5EC\uAE30\uB294 \uC6B0\uB9AC \uD559\uAD50\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758003
    m_Localized: "\uAC15\uCCA0: \uC77C\uC8FC\uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758002
    m_Localized: "\uB0B4 \uB9D0\uC740 \uBC14\uB78C\uC5D0 \uD769\uC5B4\uC84C\uB2E4. \uAC15\uCCA0\uC774 \uB4F1\uC744 \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758001
    m_Localized: "\uAC15\uCCA0: \uBA85\uB2E8. \uAC70\uAE30 \uB0B4 \uC774\uB984 \uB9D0\uACE0, \uC6B0\uB9AC \uC560\uB4E4 \uC774\uB984 \uBA3C\uC800 \uC62C\uB824\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649758000
    m_Localized: "\uAC15\uCCA0\uC774 \uC6C3\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uD398\uC778\uD2B8 \uD1B5\uC744 \uBC1C\uB85C \uBC00\uC5B4 \uB118\uC5B4\uB728\uB838\uB2E4. \uBD89\uC740 \uAE00\uC528 \uC704\uB85C \uD398\uC778\uD2B8\uAC00 \uD758\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757999
    m_Localized: "{0}: \uAC80\uC0AC\uB294 \uC544\uBB34\uB3C4 \uBABB \uC18D\uC5EC\uC694. \uADF8\uB798\uB3C4 \uBA85\uB2E8\uC5D0 \uC774\uB984\uC740 \uC62C\uB824 \uC904 \uC218 \uC788\uC5B4\uC694. \uBB34\uC804\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757998
    m_Localized: "{0}: \uAD6C\uC870\uB300\uB294 \uC2F8\uC6B0\uB294 \uACF3\uC5D4 \uC548 \uB0B4\uB824\uC694. \uC625\uC0C1\uC5D0 \uD53C\uAC00 \uBB3B\uC73C\uBA74, \uADF8\uB0A0 \uD5EC\uAE30\uB294 \uADF8\uB0E5 \uC9C0\uB098\uAC00\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757997
    m_Localized: "\uD5EC\uAE30\uB294 \uBAA8\uB450\uB97C \uD0DC\uC6B4\uB2E4\uACE0, \uC2F8\uC6B0\uBA74 \uC544\uBB34\uB3C4 \uBABB \uD0C4\uB2E4\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460274
    m_Localized: "\uB3C4\uD604\uC740 \uBC25\uC744 \uBA39\uC744 \uB54C\uB9C8\uB2E4 \uBB38 \uCABD \uC790\uB9AC\uC5D0 \uC549\uB294\uB2E4. \uC21F\uAC00\uB77D\uC744 \uB4E4\uAE30 \uC804\uC5D0 \uAF2D \uD55C \uBC88 \uCC3D\uBC16\uC744 \uBCF8\uB2E4. \uB204\uAD6C\uB97C \uAE30\uB2E4\uB9AC\uB294 \uB208\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460273
    m_Localized: "\uBD04\uBC24 \uCC3D\uAC00\uC5D0\uC11C \uADF8\uB9BC\uC790\uB97C \uC138\uB358 \uACF5\uCC45\uC740 \uC544\uC9C1 \uC4F0\uACE0 \uC788\uB2E4. \uC694\uC998\uC740 \uC22B\uC790 \uC606\uC5D0 \uC0AC\uB78C\uB4E4 \uC5BC\uAD74\uC758 \uB0A0\uC528\uB3C4 \uC801\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757996
    m_Localized: "\uAC15\uCCA0: \u2026\uD5EC\uAE30\uC5D0 \uC6B0\uB9AC \uC790\uB9AC \uD558\uB098\uB9CC \uBB3C\uC5B4\uBD10 \uC918\uB77C. \uC548 \uB418\uBA74 \uB9D0\uACE0. \uADF8\uAC78\uB85C \uB05D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757995
    m_Localized: "\uAC15\uCCA0\uC774 \uC624\uB798 \uC900\uC744 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC190\uC744 \uB4E4\uC5B4 \uBB34\uB9AC\uB97C \uBB3C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757994
    m_Localized: "\uC900: \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4\uBA74\uC11C\uC694. \uC800\uB3C4 \uC560\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757993
    m_Localized: "\uC900: \uD615. \uC800 \uD559\uAD50 \uB204\uB098\uAC00 \uC800 \uC0B4\uB838\uC5B4\uC694. \uD615\uB4E4\uC774 \uB450\uACE0 \uAC14\uC744 \uB54C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757992
    m_Localized: "\uC900\uC774 \uAC15\uCCA0 \uC55E\uC744 \uB9C9\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757991
    m_Localized: "\uBB34\uB9AC \uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uC55E\uC73C\uB85C \uAC78\uC5B4 \uB098\uC654\uB2E4. \uC900\uC774\uC5C8\uB2E4. \uC6B0\uBE44 \uC18C\uB9E4 \uC544\uB798\uB85C \uBD95\uB300 \uC790\uAD6D\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786224
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACF5\uBD80\uBCF4\uB2E4 \uC0B4\uC544\uB0A8\uB294 \uAC8C \uBA3C\uC800\uC600\uC9C0. \uADF8\uAC78 \uD0D3\uD560 \uC0AC\uB78C\uC740 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786223
    m_Localized: "\uB3C4\uD604\uC740 \uB05D\uAE4C\uC9C0 \uC190\uC804\uB4F1\uC744 \uBD99\uB4E4\uACE0 \uC788\uC5C8\uB2E4. \uB5A8\uB9AC\uB294 \uC190\uC774\uC5C8\uC9C0\uB9CC, \uB193\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980488
    m_Localized: "\uADF8\uB0A0\uBD80\uD130 \uCC3D\uAC00 \uC758\uC790\uB294 \uB3C4\uD604\uC758 \uC790\uB9AC\uAC00 \uB410\uB2E4. \uACF5\uCC45\uC758 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uD558\uB8E8\uC5D0 \uD55C \uC7A5\uC529 \uB298\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174808
    m_Localized: "\uBC1B\uB294 \uC0AC\uB78C \uC774\uB984\uC740 \uC801\uD600 \uC788\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uC11C \uB354 \uBC84\uB9B4 \uC218 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460339
    m_Localized: "\uB0AE\uC758 \uC5F4\uAE30\uAC00 \uC2DD\uC740 \uC625\uC0C1 \uBC14\uB2E5\uC5D0 \uB204\uC6E0\uB2E4. \uBD88 \uAEBC\uC9C4 \uB3C4\uC2DC \uC704\uB85C \uC740\uD558\uC218\uAC00 \uD750\uB9BF\uD558\uAC8C \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460340
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAC8C \uACAC\uC6B0, \uC800\uAC8C \uC9C1\uB140. \uC77C \uB144\uC5D0 \uD55C \uBC88 \uB9CC\uB09C\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146691
    m_Localized: "{0}: \u2026\uC724 \uC120\uC0DD\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146692
    m_Localized: "\uB300\uB2F5\uC774 \uC870\uAE08 \uB2A6\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uC740 \uCC44\uB85C \uC190\uC744 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146693
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB124. \uCD9C\uC11D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146694
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uB984 \uBD80\uB97C \uB54C\uB294 \uACE0\uAC1C\uB97C \uB4E4\uC5B4\uB77C. \uADF8\uB798\uC57C \uB300\uB2F5\uD558\uB294 \uC0AC\uB78C\uB3C4 \uACE0\uAC1C\uB97C \uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174788
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uAE30\uCE68\uC744 \uCC38\uC73C\uBA70 \uC6C3\uC5C8\uB2E4. \uC774\uB7F0 \uC544\uCE68\uC774 \uBA87 \uBC88 \uB354 \uB0A8\uC558\uB294\uC9C0, \uB458 \uB2E4 \uC138\uC9C0 \uC54A\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460341
    m_Localized: "{0}: \uC77C \uB144\uC5D0 \uD55C \uBC88\uC774\uBA74\u2026 \uC6B0\uB9AC \uAD6C\uC870\uB3C4 \uADF8\uCBE4\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460342
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4. \uBCC4 \uD558\uB098\uAC00 \uAE38\uAC8C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706449
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC21F\uAC00\uB77D\uC73C\uB85C \uD55C \uC785 \uB5A0\uC11C, \uC624\uB798 \uC785\uC5D0 \uBB3C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117848
    m_Localized: "\uC606\uC5D0 \uB2E4 \uC4F4 \uC885\uC774 \uBA87 \uC7A5\uC774 \uB9C8\uB974\uACE0 \uC788\uC5C8\uB2E4. \uD14C\uB450\uB9AC\uAC00 \uC778\uC1C4\uB41C \uC885\uC774. \uB9E8 \uC704\uC5D0 \uCEE4\uB2E4\uB797\uAC8C, \uC878\uC5C5\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117849
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC4F0\uACE0 \uC788\uB294 \uC774\uB984\uC774 \uBCF4\uC600\uB2E4. \uB0B4 \uC774\uB984\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786279
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0 \uAC00\uB294 \uAC74 \uC548 \uB3FC. \uAC00\uB824\uBA74 \uB0AE\uC5D0, \uC870\uC6A9\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174945
    m_Localized: "\uB3C4\uD604: \uD615\uC774\uB791 \uC7A5\uB9C8 \uB54C \uC6B0\uC0B0 \uD558\uB098 \uAC19\uC774 \uC37C\uB294\uB370. \uB458 \uB2E4 \uBC18\uC529 \uC816\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369140
    m_Localized: "\uC65C \uBAB0\uB790\uB0D0\uACE0, \uCC98\uC74C\uC73C\uB85C \uD654\uB97C \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369141
    m_Localized: "{0}: \uC120\uC0DD\uB2D8\uB4E4\uC740 \uC65C \uC544\uBB34\uB3C4 \uBAB0\uB790\uC5B4\uC694? \uB2E4\uB4E4 \uBCF4\uACE0 \uC788\uC5C8\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786190
    m_Localized: "\uADF8 \uC544\uB798\uC5D0 \uB204\uAD70\uAC00 \uBCFC\uD39C\uC73C\uB85C \uC904\uC744 \uAE0B\uACE0, \uB2E4\uC2DC \uADF8 \uC704\uC5D0 '\uBCF4\uB958 \uD574\uC81C'\uB77C\uACE0 \uC801\uC5B4 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146695
    m_Localized: "\uC544\uC9C1\uC740 \uC120\uC0DD\uB2D8\uC774 \uBD80\uB974\uC2DC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146696
    m_Localized: "{0}: \uC544\uC9C1\uC740 \uC120\uC0DD\uB2D8\uC774 \uBD80\uB974\uC138\uC694. \uC81C \uC774\uB984\uB3C4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146697
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uC9D1\uC740. \uB204\uAD74 \uB2EE\uC558\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146698
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uB0B4\uC77C\uB3C4 \uB0B4\uAC00 \uBD80\uB974\uB9C8. \uBAA9\uC18C\uB9AC\uAC00 \uB0A8\uC544 \uC788\uB294 \uB3D9\uC548\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146699
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uC120\uC0DD\uB2D8\uC740 \uB204\uC6B4 \uCC44\uB85C \uCD9C\uC11D\uC744 \uBD88\uB800\uB2E4. \uC774\uB984\uACFC \uC774\uB984 \uC0AC\uC774\uC758 \uC228\uC774 \uAE38\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146700
    m_Localized: "\uC544\uBB34\uB3C4 \uC7AC\uCD09\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB4E4 \uC81C \uC774\uB984\uC774 \uBD88\uB9B4 \uB54C\uAE4C\uC9C0 \uACE0\uAC1C\uB97C \uB4E4\uACE0 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117850
    m_Localized: "\uB9C8\uB974\uACE0 \uC788\uB294 \uC885\uC774 \uC911 \uD558\uB098\uC5D0 \uB3C4\uD604\uC758 \uC774\uB984\uB3C4 \uC788\uC5C8\uB2E4. \uC544\uB798\uC5D0 \uC791\uC740 \uAE00\uC528\uB85C '\uC911\uD559\uAD50 \uACFC\uC815 \uC218\uB8CC\uB97C \uC778\uC815\uD568'. \uC120\uC0DD\uB2D8\uC774 \uC9C1\uC811 \uC9C0\uC5B4 \uB123\uC740 \uB9D0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117851
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: (\uD63C\uC7A3\uB9D0) \u2026\uD559\uAD50\uC7A5 \uC9C1\uC778\uC740 \uC5C6\uC9C0\uB9CC. \uB2F4\uC784 \uB3C4\uC7A5\uC740 \uC788\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786189
    m_Localized: "'\uC6D0\uC778 \uBD88\uBA85 \uBC1C\uC5F4 \uD658\uC790 \uBC1C\uC0DD \uC2DC \uB4F1\uAD50 \uD559\uC0DD \uADC0\uAC00 \uC870\uCE58 \uBCF4\uB958 \uBC0F \uAD50\uB0B4 \uB300\uAE30.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174880
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uBD88\uB800\uB2E4. \uC885\uC774\uC5D0 \uCE58\uC218\uC640 \uADF8\uB9BC\uC744 \uADF8\uB824 \uAC74\uB138\uB2E4. \uD50C\uB77C\uC2A4\uD2F1 \uAD00, \uB048, \uCFE0\uC158."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757766
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uB0AF\uC120 \uC0AC\uB78C\uC774 \uC11C \uC788\uC5C8\uB2E4. \uB0A1\uC740 \uB4F1\uC0B0\uBCF5, \uBAA8\uC790\uB97C \uAE4A\uC774 \uB20C\uB7EC\uC4F4 \uC5BC\uAD74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757765
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC81C \uD55C \uACC4\uC808 \uB0A8\uC558\uB2E4. \uC5F4\uC138 \uC8FC. \uAD6C\uC870\uB300\uAC00 \uC624\uAE30 \uC804\uAE4C\uC9C0, \uB9C8\uC9C0\uB9C9 \uD559\uAE30\uB77C\uACE0 \uC0DD\uAC01\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757764
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB3D9\uC548 \uB098\uB294 \uAC00\uB974\uCE60 \uC218 \uC788\uB294 \uAC78 \uB2E4 \uAC00\uB974\uCE60 \uAC70\uACE0, \uB108\uB294 \uBC30\uC6B8 \uC218 \uC788\uB294 \uAC78 \uB2E4 \uBC30\uC6B0\uB294 \uAC70\uB2E4. \uADF8\uAC8C \uC6B0\uB9AC \uB9C8\uC9C0\uB9C9 \uD559\uAE30\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117852
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBD93\uD39C\uC744 \uB0B4\uB824\uB193\uACE0 \uC885\uC774\uB97C \uCD1B\uBD88\uC5D0 \uBE44\uCDB0 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC544\uC8FC \uC791\uAC8C, \uB9CC\uC871\uD55C \uB4EF \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117853
    m_Localized: "\uC5B8\uC81C \uC904 \uC0DD\uAC01\uC778\uC9C0\uB294 \uBB3B\uC9C0 \uC54A\uC544\uB3C4 \uC54C \uAC83 \uAC19\uC558\uB2E4. \uADF8\uB0A0\uC774 \uC62C \uAC70\uB77C\uACE0, \uC120\uC0DD\uB2D8\uC740 \uADF8\uB807\uAC8C \uBBFF\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117854
    m_Localized: "\uB4E4\uC5B4\uAC00\uC11C \uCD1B\uBD88\uC744 \uAC00\uAE4C\uC774 \uC62E\uACA8 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146701
    m_Localized: "\uAD50\uBB34\uC2E4 \uC11C\uB958\uD568\uC744 \uC815\uB9AC\uD558\uB2E4\uAC00 \uBB38\uC11C \uC811\uC218 \uB300\uC7A5\uC744 \uCC3E\uC558\uB2E4. \uCE90\uBE44\uB2DB\uC5D0\uC11C \uCC59\uACA8 \uB454 \uADF8 \uC11C\uB958\uC758 \uBC88\uD638\uAC00 \uAC70\uAE30 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146702
    m_Localized: "\uB300\uC7A5\uC758 \uADF8 \uC904\uC5D0\uB294 \uC811\uC218 \uB3C4\uC7A5\uB9CC \uCC0D\uD600 \uC788\uC5C8\uB2E4. \uCC98\uB9AC \uCE78\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146703
    m_Localized: "\uCC59\uACA8 \uB454 \uC11C\uB958\uB97C \uB2E4\uC2DC \uD3BC\uCCE4\uB2E4. \uCC98\uC74C \uCC59\uAE38 \uB54C\uB294 \uB05D\uAE4C\uC9C0 \uC77D\uC9C0 \uC54A\uC558\uB358 \uC885\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146638
    m_Localized: "\uADF8 \uC560\uB294 \"\uADF8\uB7FC \uC624\uB298 \uC6B4\uC138\uB294 \uB0B4 \uAC78\uB85C \uAC19\uC774 \uBD10\" \uD558\uACE0 \uD654\uBA74\uC744 \uB0B4 \uCABD\uC73C\uB85C \uAE30\uC6B8\uC600\uB2E4. \uADF8\uAC8C \uADF8 \uC560\uD558\uACE0 \uBCF8 \uB9C8\uC9C0\uB9C9 \uC6B4\uC138\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146537
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uBA38\uC9C0\uB294 \uB124\uAC00 \uC774\uBBF8 \uC548\uB2E4. \uB0B4\uAC00 \uAC00\uB974\uCE5C \uAC8C \uC544\uB2C8\uB77C, \uB124\uAC00 \uBC84\uD2F0\uBA74\uC11C \uBC30\uC6B4 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146536
    m_Localized: "{0}: \uADF8\uAC8C \uB2E4\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146535
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24 \uD0D0\uD5D8\uC740 \uC774\uD2C0 \uC5F0\uC18D \uB123\uC9C0 \uB9C8\uB77C. \uADF8\uB9AC\uACE0 \uC26C\uB294 \uB0A0\uC744 \uAF2D \uD558\uB098 \uBE44\uC6CC \uB46C. \uADF8\uAC8C \uB2E4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146534
    m_Localized: "\uC120\uC0DD\uB2D8\uAED8 \uC870\uC5B8\uC744 \uAD6C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146533
    m_Localized: "{0}: \uADF8\uAC74 \uC548 \uACE0\uCE60 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786252
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD9C\uC11D \uC644\uB8CC. \u2026\uB2E4\uB4E4 \uC5B4\uB518\uAC00\uC5D0\uC11C \uB300\uB2F5\uD558\uACE0 \uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340622
    m_Localized: "{0}: \uD55C \uB2EC\uC774\uBA74 \uB2E4\uC74C \uD5EC\uAE30\uAC00 \uC640\uC694. \uADF8\uB54C \uAC19\uC774 \uAC00\uC694. \uC81C \uC790\uB9AC\uB294 \uB2E4\uB978 \uC0AC\uB78C\uD55C\uD14C \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706482
    m_Localized: "\uCEF4\uD4E8\uD130\uC2E4 \uBAA8\uB2C8\uD130\uB294 \uC804\uBD80 \uAE4C\uB9E3\uAC8C \uAEBC\uC838 \uC788\uC5C8\uB2E4. \uD654\uBA74 \uD558\uB098\uC5D0 \uB178\uB780 \uCABD\uC9C0\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706483
    m_Localized: "'\uC218\uD589\uD3C9\uAC00 \uC81C\uCD9C \uAE08\uC694\uC77C\uAE4C\uC9C0!!' \uB290\uB08C\uD45C\uAC00 \uB450 \uAC1C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706484
    m_Localized: "\uADF8 \uAE08\uC694\uC77C\uC740 \uC624\uC9C0 \uC54A\uC558\uB2E4. \uCABD\uC9C0\uB97C \uB5BC\uC5B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uACE0, \uBCF8\uCCB4\uB97C \uC5F4\uC5B4 \uC4F8 \uB9CC\uD55C \uBD80\uD488\uC744 \uBE90\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826500
    m_Localized: "\uC544\uB294 \uAC78 \uB098\uB204\uB294 \uAC74 \uD558\uB098\uB3C4 \uC904\uC9C0 \uC54A\uB294 \uC77C\uC774\uC5C8\uB2E4. \uC77D\uACE0 \uB098\uB2C8 \uC624\uD788\uB824 \uBA38\uB9BF\uC18D\uC774 \uC815\uB9AC\uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340621
    m_Localized: "{0}: \uC800\uB3C4 \uC548 \uAC08\uB798\uC694. \uC120\uC0DD\uB2D8\uC774 \uD63C\uC790 \uB0A8\uB294 \uAC70, \uC2EB\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174806
    m_Localized: "\uAC00\uBC29\uC5D0 \uB123\uC5B4 \uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146637
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC774 \uB5A0\uC62C\uB790\uB2E4. {0} \uC6B4\uC138 \uC571\uC744 \uB0B4\uBC00\uBA70 \uD608\uC561\uD615 \uAD81\uD569\uC744 \uBCF4\uC790\uACE0 \uD588\uC5C8\uB2E4. \uB098\uB294 \uB0B4 \uD608\uC561\uD615\uB3C4 \uBAA8\uB978\uB2E4\uBA70 \uC6C3\uC5B4\uB118\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146636
    m_Localized: "\uD559\uC0DD \uAC74\uAC15 \uAE30\uB85D\uC758 \uB0B4 \uCE78\uC5D0\uB294 \"\uBBF8\uAC80\uC0AC\"\uB77C\uACE0\uB9CC \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117828
    m_Localized: "\uC811\uC5B4 \uD540\uC73C\uB85C \uACE0\uC815\uD55C \uBC14\uC9D3\uB2E8 \uC704\uC5D0 \uB2F4\uC694\uB97C \uB36E\uC740 \uCC44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786251
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC774\uB984\uAE4C\uC9C0 \uBD80\uB974\uACE0 \uB098\uC11C, \uC120\uC0DD\uB2D8\uC740 \uCD9C\uC11D\uBD80\uB97C \uB36E\uACE0 \uCE60\uD310 \uC606\uC5D0 \uC138\uC6CC \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174843
    m_Localized: "'\uD63C\uC790\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uB4E3\uACE0 \uC788\uB2E4\uBA74, \uC0B4\uC544 \uC788\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146532
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB9CC \uBC24\uB9C8\uB2E4 \uB098\uB97C \uB123\uC9C0\uB294 \uB9C8\uB77C. \uB108 \uC798 \uC2DC\uAC04\uC774 \uC5C6\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146531
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB0B4\uAC00 \uC9E0 \uAC83\uBCF4\uB2E4 \uB0AB\uB2E4. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980484
    m_Localized: "\uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uC190\uD1B1\uC73C\uB85C \uADF8\uC5C8\uB358 \uAE08\uC774 \uB5A0\uC62C\uB790\uB2E4. \uC138\uB294 \uAC83\uB3C4 \uD558\uB8E8 \uC77C\uACFC\uAC00 \uB418\uB358 \uB0A0\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826515
    m_Localized: "\uB3C4\uD604\uC740 \uD55C\uCC38 \uB9D0\uD588\uB2E4. \uD615\uC774 \uB77C\uBA74\uC744 \uB053\uC774\uBA74 \uAF2D \uACC4\uB780\uC744 \uB450 \uAC1C \uB123\uC5C8\uB2E4\uB294 \uAC83\uAE4C\uC9C0. \uB9D0\uD558\uB294 \uB3D9\uC548 \uB3C4\uD604\uC740 \uD55C \uBC88\uB3C4 '\uC600\uB2E4'\uB77C\uACE0 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706358
    m_Localized: "{0}: \u2026\uC0AC\uC2E4 \uBB34\uB98E, \uC544\uD30C\uC694. \uB9CE\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146530
    m_Localized: "\uC120\uC0DD\uB2D8 \uB3CC\uBCF4\uAE30\uB97C \uC5B4\uB514\uC5D0 \uB123\uC744\uC9C0 \uD55C\uCC38 \uB9DD\uC124\uC774\uB2E4, \uB9E4\uC77C \uBC24 \uCE78\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146529
    m_Localized: "\uD0D0\uD5D8, \uACF5\uBD80, \uD734\uC2DD, \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uB3CC\uBCF4\uAE30. \uCE78\uC744 \uD558\uB098\uC529 \uCC44\uC6CC \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146528
    m_Localized: "\uD63C\uC790 \uACC4\uD68D\uC744 \uC138\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146527
    m_Localized: "\uCE60\uD310 \uC55E\uC5D0 \uC130\uB2E4. \uBD04\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uADF8\uC5B4 \uB454 \uCE78\uB4E4\uC774 \uD76C\uBBF8\uD558\uAC8C \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uBD84\uD544\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uBB34\uAC70\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146526
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uBD80\uD130 \uB0B4\uAC00 \uC9DC\uB294 \uAC78 \uB2E4 \uBD24\uC796\uC544. \uC5B8\uC820\uAC00 \uD574\uC57C \uD558\uB294 \uAC70\uBA74, \uB0B4\uAC00 \uBCFC \uC218 \uC788\uC744 \uB54C \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146525
    m_Localized: "{0}: \uC800 \uD63C\uC790\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146524
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uBC88 \uC8FC \uACC4\uD68D\uD45C, \uB124\uAC00 \uC9DC \uBCFC\uB798? \uB098\uB294 \uBCF4\uAE30\uB9CC \uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706359
    m_Localized: "\uB9D0\uD558\uACE0 \uB098\uB2C8 \uC774\uC0C1\uD558\uAC8C \uB354 \uC544\uD320\uB2E4. \uC544\uD508 \uAC78 \uC544\uD504\uB2E4\uACE0 \uD558\uBA74, \uADF8\uAC8C \uC9C4\uC9DC\uAC00 \uB418\uB294 \uAC83 \uAC19\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706360
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uAD6C\uAE09\uD568\uC744 \uB04C\uC5B4\uB2F9\uACBC\uB2E4. \uC18C\uB3C5\uC57D\uC774 \uB2FF\uC744 \uB54C \uC18C\uB9AC\uB97C \uB0C8\uB2E4. \uCC38\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706361
    m_Localized: "\uC774\uAC83\uB3C4 \uB0B4\uAC00 \uAC00\uC9C4 \uAC83\uC774\uB2E4. \uB0A8\uC744 \uC6C3\uAC8C \uD558\uB294 \uC7AC\uC8FC. \uC774\uAC78\uB85C \uBC84\uD2F4 \uB0A0\uC774, \uB098 \uB9D0\uACE0\uB3C4 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146523
    m_Localized: "\uB0AE\uC5D0\uB294 \uBA40\uCA61\uD558\uB2E4\uAC00\uB3C4 \uD574\uAC00 \uC9C0\uBA74 \uC5F4\uC774 \uC62C\uB790\uB2E4. \uC774\uB9C8\uC5D0 \uC5B9\uC740 \uBB3C\uC218\uAC74\uC774 \uAE08\uBC29 \uBBF8\uC9C0\uADFC\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460211
    m_Localized: "\"\uC6C3\uC5B4\uB3C4 \uB3FC. \uADF8\uAC8C \uB108\uB97C \uBC84\uD2F0\uAC8C \uD588\uC73C\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460210
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uC5D0\uAC8C \uD55C\uB9C8\uB514 \uD560 \uC218 \uC788\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460209
    m_Localized: "\uC544\uB798\uCE35\uC5D0\uC11C \uB3C4\uD604\uC774 \uB0B4 \uBE44\uC0C1\uC2DD\uB7C9 \uD3C9\uAC00\uB97C \uD749\uB0B4 \uB0B4\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uBCC4 \uC138 \uAC1C \uBC18. \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460208
    m_Localized: "\uC9C0\uAE08\uB3C4 \uD558\uB8E8\uC5D0 \uBA87 \uBC88\uC529 \uADF8 \uB9D0\uC744 \uD55C\uB2E4. \uADF8\uB798\uB3C4 \uC694\uC998\uC740, \uAC00\uB054 \uC9C4\uC9DC\uC77C \uB54C\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460207
    m_Localized: "\uCC98\uC74C\uC73C\uB85C \uC548 \uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uD588\uB358 \uBC24\uC774 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uB4A4\uB85C \uAD1C\uCC2E\uB2E4\uB294 \uB9D0\uC774 \uC870\uAE08 \uAC00\uBCBC\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460206
    m_Localized: "\uC138\uBA74\uC2E4 \uAC70\uC6B8 \uC18D, \uC6C3\uC9C0 \uC54A\uC740 \uC5BC\uAD74\uC774 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC5BC\uAD74\uB3C4 \uADF8\uB0A0 \uC800\uAE30 \uC11C \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146522
    m_Localized: "\uACA8\uC6B8\uC758 \uCCAB \uBC24. \uCC3D\uD2C0\uC5D0 \uC131\uC5D0\uAC00 \uAF08\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC774\uC81C \uD558\uB8E8\uC758 \uB300\uBD80\uBD84\uC744 \uB204\uC6CC\uC11C \uC9C0\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786250
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC774\uB984\uC744 \uD558\uB098\uC529 \uBD88\uB800\uB2E4. \uB300\uB2F5\uC740 \uB0B4\uAC00 \uD588\uB2E4. \"\uB124.\" \uC11C\uB978\uB450 \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786249
    m_Localized: "\uAC19\uC774 \uC77D\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174844
    m_Localized: "\uC544\uB798\uC5D0\uB294 \uB204\uAD70\uAC00 \uBCFC\uD39C\uC73C\uB85C \uB367\uC368 \uB450\uC5C8\uB2E4. '\uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C \uC0AC\uB78C\uB4E4 \uC5EC\uAE30 \uC788\uC74C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146521
    m_Localized: "???: \u2026\uAC70\uAE30, \uB204\uAD6C \uC788\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146520
    m_Localized: "\uBB38\uC5D0 \uC774\uB9C8\uB97C \uB300\uACE0, \uADF8 \uC0AC\uB78C\uC774 \uB9D0\uD558\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uC228\uC744 \uACE8\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146519
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uADF8 \uC18C\uB9AC\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uC54C\uC558\uB2E4. \uADF8\uAC83\uB4E4\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uC0AC\uB78C\uC774\uC5C8\uB2E4. \uC5EC\uAE30\uAE4C\uC9C0 \uAE30\uC5B4\uC11C\uB77C\uB3C4 \uC640 \uC8FC\uB294 \uC0AC\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826516
    m_Localized: "\uD55C\uCC38 \uB4A4 \uD558\uB9B0\uC774 \uC791\uAC8C \uB9D0\uD588\uB2E4. \"\uACE0\uB9C8\uC6CC.\" \uCC98\uC74C \uB4E3\uB294 \uB9D0\uC774\uC5C8\uB2E4. \uD558\uB9B0\uB3C4 \uCC98\uC74C \uD558\uB294 \uB9D0 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460205
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uC800\uAE30\uC11C, \uB098\uB294 '\uAD1C\uCC2E\uC544' \uD558\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460204
    m_Localized: "\uD574 \uC9C8 \uB158 \uC625\uC0C1. \uB09C\uAC04 \uB108\uBA38\uB85C \uAD50\uBB38 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4\uAC00 \uBCF4\uC600\uB2E4. \uC2E0\uD638\uB4F1\uC740 1\uB144\uC9F8 \uAEBC\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826542
    m_Localized: "{0}: \uB124. \u2026\uADFC\uB370 \uC774\uAC83\uB3C4 \uC88B\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706486
    m_Localized: "\uC74C\uC545\uC2E4 \uD53C\uC544\uB178 \uB69C\uAED1 \uC704\uC5D0 \uBA3C\uC9C0\uAC00 \uC587\uAC8C \uC549\uC544 \uC788\uC5C8\uB2E4. \uB69C\uAED1\uC744 \uC5F4\uC790 \uD558\uC580 \uAC74\uBC18\uC774 \uC904\uC9C0\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340620
    m_Localized: "\uB098\uB3C4 \uB0A8\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340619
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC624\uB798 \uC6C3\uB2E4\uAC00, \uADF8\uB7EC\uC790\uACE0 \uD588\uB2E4. \uAC70\uC9D3\uB9D0\uC778 \uC904 \uC54C\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146518
    m_Localized: "\uC77C\uACF1\uC9F8 \uB0A0 \uC0C8\uBCBD. \uBB38 \uB108\uBA38\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uAE30\uC5B4 \uC624\uB294 \uC18C\uB9AC. \uB04C\uACE0, \uBA48\uCD94\uACE0, \uC228\uC744 \uACE0\uB974\uACE0, \uB2E4\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146517
    m_Localized: "\uC774 \uBC24\uC744 \uC804\uC5D0\uB3C4 \uD55C \uBC88 \uC9C0\uB098\uC628 \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774 \uB4E4\uC5C8\uB2E4. \uC774\uC0C1\uD558\uAC8C \uBB34\uC12D\uC9C0 \uC54A\uC558\uB2E4. \uB4E0\uB4E0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146516
    m_Localized: "\uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uAE08\uC744 \uD558\uB098 \uB354 \uADF8\uC5C8\uB2E4. \uC5EC\uC12F."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146515
    m_Localized: "\uD658\uAE30\uCC3D\uC73C\uB85C \uB4E4\uC774\uCE58\uB294 \uBE57\uBB3C\uC744 \uBE48 \uBCD1\uC5D0 \uBC1B\uC558\uB2E4. \uC190\uC774 \uBA3C\uC800 \uBCD1\uC744 \uCC3E\uC558\uB2E4. \uC5B4\uB514\uC5D0 \uB450\uC5B4\uC57C \uBB3C\uC774 \uC798 \uACE0\uC774\uB294\uC9C0, \uC774\uBBF8 \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146514
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uAC00\uC0AC\uAC00 \uB05D\uAE4C\uC9C0 \uAE30\uC5B5\uB0AC\uB2E4. {0} \uC774\uC5B4\uD3F0 \uD55C\uCABD\uC744 \uB0B4 \uADC0\uC5D0 \uAF42\uC544 \uC8FC\uBA70 \uAC19\uC774 \uB4E3\uB358 \uB178\uB798\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146513
    m_Localized: "\uC5EC\uC12F\uC9F8 \uB0A0. \uBE44\uAC00 \uC654\uB2E4. \uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C \uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB838\uB2E4. \uB5A1\uBCF6\uC774 \uAC00\uAC8C \uC55E\uC5D0\uC11C \uB4E3\uB358 \uB178\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146512
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uCD94\uC704\uC5D0 \uB354\uC704\uB97C \uC65C \uD314\uC544. \u2026\uADF8\uB798, \uC0AC \uC904\uAC8C. \uB300\uC2E0 \uC62C\uC5EC\uB984\uC740 \uC6B0\uB9AC \uAC19\uC774 \uB365\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146511
    m_Localized: "{0}: \uC120\uC0DD\uB2D8! \u2026\uB0B4 \uB354\uC704 \uC0AC \uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786295
    m_Localized: "\uB3C4\uD604: \uB4E4\uC5EC\uBCF4\uB0B4 \uC8FC\uC2DC\uBA74 \uBB50\uB4E0 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786294
    m_Localized: "\uB3C4\uD604: \uBB3C\u2026 \uACE0\uB9C8\uC6E0\uC5B4\uC694. \uADFC\uB370 \uD63C\uC790\uB294 \uC774\uC81C \uBABB \uC788\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174794
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBBF8\uC548, \uAE68\uC6E0\uC9C0. \u2026\uC870\uAE08\uB9CC \uC788\uC73C\uBA74 \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786248
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uB984\uC774\uB77C\uB3C4 \uD55C \uBC88 \uBD88\uB7EC \uBCF4\uACE0 \uC2F6\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786247
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD45C\uC9C0\uB97C \uC4F0\uB2E4\uB4EC\uAE30\uB9CC \uD558\uACE0 \uD55C\uCC38 \uD3B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706487
    m_Localized: "\uC190\uAC00\uB77D \uD558\uB098\uB97C \uAC74\uBC18\uC5D0 \uC62C\uB838\uB2E4\uAC00, \uB204\uB974\uC9C0 \uC54A\uACE0 \uB0B4\uB838\uB2E4. \uC774 \uAC74\uBB3C\uC5D0\uC11C \uC18C\uB9AC\uB294 \uBD80\uB974\uB294 \uC2E0\uD638\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706488
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC774\uC57C\uAE30\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706489
    m_Localized: "\uBC29\uC1A1\uC2E4 \uCC45\uC0C1\uC5D0 \uC6D0\uACE0 \uD55C \uC7A5\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4. '\uD559\uC0DD \uC5EC\uB7EC\uBD84\uC740 \uC9C0\uAE08 \uC788\uB294 \uAD50\uC2E4\uC5D0\uC11C \uB300\uAE30\uD558\uC2ED\uC2DC\uC624.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460198
    m_Localized: "\uC785\uAF2C\uB9AC\uB97C \uC62C\uB824 \uBCF4\uC558\uB2E4. \uB208\uC740 \uC870\uAE08 \uB35C \uC6C3\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uB0B4\uC77C\uC740 \uC4F8 \uB9CC\uD560 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460197
    m_Localized: "\uAC70\uC6B8 \uC55E\uC5D0\uC11C \uB0B4\uC77C \uC4F8 \uC6C3\uB294 \uC5BC\uAD74\uC744 \uB2E4\uB4EC\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460196
    m_Localized: "\uC548 \uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uD574 \uBCF8 \uC801\uC774 \uC788\uB2E4. \uADF8 \uB4A4\uB85C \uC6C3\uC74C\uC774 \uC870\uAE08 \uAC00\uBCBC\uC6CC\uC84C\uB2E4. \uC544\uC8FC \uC870\uAE08."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460195
    m_Localized: "\uBC24\uB2A6\uAC8C, \uC138\uBA74\uC2E4\uC758 \uAE08 \uAC04 \uAC70\uC6B8 \uC55E\uC5D0 \uC130\uB2E4. \uAC70\uC6B8 \uC18D \uC5BC\uAD74\uC774 \uC544\uC9C1 \uC6C3\uB294 \uBAA8\uC591\uC744 \uD558\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460194
    m_Localized: "\uC6C3\uC74C \uB2F9\uBC88. \uC5B8\uC81C\uBD80\uD130\uC778\uAC00 \uADF8\uAC74 \uB0B4 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460193
    m_Localized: "\uB204\uAD70\uAC00 \uD53C\uC2DD \uC6C3\uC5C8\uB2E4. \uADF8\uB2E4\uC74C\uC5D4 \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4. \uBCC4 \uBC18 \uAC1C\uB294 \uB354 \uC918\uC57C \uD55C\uB2E4\uB294 \uC0AC\uB78C\uB3C4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460192
    m_Localized: "{0}: \uC624\uB298\uC758 \uBE44\uC0C1\uC2DD\uB7C9 \uD3C9\uAC00. \uC8FD, \uBCC4 \uB450 \uAC1C. \uBB3C\uC744 \uB108\uBB34 \uC0AC\uB791\uD55C \uC8FD."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460191
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC21F\uAC00\uB77D\uC744 \uB0B4\uB824\uB193\uACE0 \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4. \uADF8 \uD55C\uC228\uC774 \uAD50\uC2E4\uC744 \uD55C \uBC14\uD034 \uB3CC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460190
    m_Localized: "\uB3C4\uD604\uC774 \uC21F\uAC00\uB77D\uC744 \uB0B4\uB824\uB193\uACE0 \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4. \uADF8 \uD55C\uC228\uC774 \uAD50\uC2E4 \uC804\uCCB4\uB85C \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460189
    m_Localized: "\uD558\uB8E8 \uC885\uC77C \uBE44\uAC00 \uC654\uACE0, \uC800\uB141\uC740 \uBB3D\uC740 \uC8FD\uC774\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174845
    m_Localized: "\uC804\uB2E8\uC9C0\uB97C \uC811\uC5B4 \uD488\uC5D0 \uB123\uC5C8\uB2E4. \uB3CC\uC544\uC640\uC11C \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uBCF4\uC5EC \uC8FC\uC790, \uC120\uC0DD\uB2D8\uC774 \uC8FC\uD30C\uC218 \uC22B\uC790\uB97C \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146510
    m_Localized: "\uB354\uC704\uB97C \uD310\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146509
    m_Localized: "\uC18C\uC6D0\uC740 \uD558\uB098\uC600\uB2E4. \uBAA8\uB450 \uD568\uAED8, \uC800 \uBB38\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146508
    m_Localized: "\uB2EC\uC774 \uC815\uB9D0 \uCEF8\uB2E4. \uAD6C\uC870 \uD5EC\uAE30\uAC00 \uB0B4\uB824\uC62C \uC625\uC0C1 \uC704\uB85C, \uB465\uAE00\uAC8C \uB5A0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146507
    m_Localized: "\uBC24\uC5D0 \uD070 \uB2EC\uC744 \uBCF4\uBA70 \uC18C\uC6D0\uC744 \uBE48\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340618
    m_Localized: "{0}: \uC5F4\uB9CC \uB0B4\uB9AC\uBA74 \uB3FC\uC694. \uAC80\uC9C4 \uADF8\uAC70, \uC18D\uC77C \uC218 \uC788\uC5B4\uC694. \uAC19\uC774 \uAC00\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340617
    m_Localized: "\uAC10\uC5FC\uC744 \uC228\uAE30\uACE0 \uD568\uAED8 \uD0C0\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340616
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38\uC744 \uB2EB\uAE30 \uC804\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4. \uC544\uCE68\uB9C8\uB2E4 \uBC29\uC1A1\uC73C\uB85C \uCD9C\uC11D\uC744 \uBD80\uB97C \uAC70\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826543
    m_Localized: "\uAD50\uBB38\uC744 \uB2EB\uAE30 \uC804\uC5D0, \uAE38 \uCABD\uC5D0 \uB300\uACE0 \uC791\uAC8C \uB9D0\uD588\uB2E4. \uB2E4\uB140\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706490
    m_Localized: "\uADF8 \uC544\uB798\uC5D0 \uD39C\uC73C\uB85C \uAE09\uD558\uAC8C \uB367\uC4F4 \uC904\uC774 \uC788\uC5C8\uB2E4. '\uB300\uAE30 \uCDE8\uC18C. \uC6B4\uB3D9\uC7A5\uC73C\uB85C' \u2014 \uAC70\uAE30\uC11C \uAE00\uC528\uAC00 \uB04A\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706491
    m_Localized: "\uB9C8\uC774\uD06C \uC804\uC6D0\uC740 \uAEBC\uC838 \uC788\uC5C8\uB2E4. \uC6D0\uACE0\uB97C \uC811\uC5B4 \uB4E4\uACE0 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706492
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB0A0 \uC544\uCE68 \uBC29\uC1A1, \uB098\uB3C4 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706493
    m_Localized: "\uC18C\uAE08\uC5D0 \uC808\uC5EC \uC0B4\uB824 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460183
    m_Localized: "\uADF8\uB0A0 \uBC24\uC740 \uB458 \uB2E4 \uC77C\uCC0D \uC7A0\uB4E4\uC5C8\uB2E4. \uC6C3\uB2E4\uAC00 \uC7A0\uB4DC\uB294 \uBC24\uB3C4 \uC788\uB2E4\uB294 \uAC78, \uCC3D\uACE0\uC5D0\uC11C\uB294 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146506
    m_Localized: "\uB545\uCF69 \uB300\uC2E0 \uB9D0\uB9B0 \uCF69\uC744 \uAE68\uBB3C\uC5C8\uB2E4. \uC774\uAC00 \uC544\uD320\uB2E4. \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146505
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uCE68\uC5D4 \uBD80\uB7FC\uC744 \uAE68\uACE0, \uB354\uC704\uB97C \uD314\uACE0, \uBC24\uC5D4 \uB2EC\uC5D0 \uC18C\uC6D0\uC744 \uBE4C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146504
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC815\uC6D4\uB300\uBCF4\uB984. \uC77C \uB144 \uC911 \uB2EC\uC774 \uC81C\uC77C \uD06C\uACE0 \uBC1D\uC740 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146503
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB204\uC6B4 \uCC44\uB85C \uBD80\uB7FC \uB300\uC2E0 \uB9D0\uB9B0 \uCF69 \uD55C \uC54C\uC744 \uC6B0\uB9AC \uC190\uC5D0 \uD558\uB098\uC529 \uC950\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786246
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uB9E1\uC744 \uBC18\uC774\uC5C8\uC5B4. \uCCAB \uC218\uC5C5\uC774 \uC0AC\uD0DC \uB2E4\uC74C \uC8FC\uC600\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786245
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uACE0\uB9C8\uC6CC. \u2026\uBD88 \uB04C\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174846
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6C\uC2ED\uD314 \uC810 \uC0BC. \u2026\uB77C\uB514\uC624\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4. \uC544\uB2C8, \uC5B8\uC820\uAC00 \uB4E3\uAC8C \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980485
    m_Localized: "\uB3C4\uD604: \uADF8\uB9AC\uACE0\u2026 \uD615 \uCC3E\uC73C\uB7EC \uAC08 \uB54C\uB3C4, \uC774\uAC8C \uC788\uC73C\uBA74 \uAE38\uC744 \uC54C \uC218 \uC788\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706412
    m_Localized: "\uC5BC\uC74C \uAC00\uC7A5\uC790\uB9AC\uAC00 \uAC08\uB77C\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBAB8\uC744 \uB358\uC9C0\uB4EF \uB451\uC73C\uB85C \uBE60\uC838\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706411
    m_Localized: "\uBCFC\uC774 \uC5BC\uC5BC\uD574\uC9C8 \uB54C\uAE4C\uC9C0 \uB180\uC558\uB2E4. \uB3CC\uC544\uC624\uB294 \uAE38\uC5D0 \uC190\uC774 \uB179\uC9C0 \uC54A\uC544 \uC11C\uB85C \uC785\uAE40\uC744 \uBD88\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706410
    m_Localized: "\uBE44\uB8CC \uD3EC\uB300\uB97C \uAE54\uACE0 \uC5BC\uC74C \uC704\uB97C \uBBF8\uB044\uB7EC\uC84C\uB2E4. \uB118\uC5B4\uC9C0\uACE0 \uC6C3\uACE0, \uB610 \uD0D4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826523
    m_Localized: "\uB098\uB294 \uB300\uB2F5 \uB300\uC2E0 \uD5C8\uB9AC\uB048\uC744 \uD55C \uBC88 \uB354 \uC870\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118065
    m_Localized: "\uB3C4\uD604\uC774 \uC77C\uC5B4\uB098 \uC549\uC558\uB2E4. \uC190\uAC00\uB77D\uC73C\uB85C \uC624\uB298 \uB118\uC740 \uC904\uB118\uAE30 \uC218\uB97C \uC14C\uB2E4. \uC774\uBC88 \uB2EC \uB0B4\uB0B4 \uACF5\uCC45\uC5D0 \uC801\uC5B4 \uC628 \uC22B\uC790\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118066
    m_Localized: "\uB3C4\uD604: \uC774\uAC70 \uBD10\uC694. \uD558\uB8E8\uB3C4 \uC548 \uBE60\uC84C\uC5B4\uC694. \uD615 \uB9CC\uB098\uBA74 \uBCF4\uC5EC \uC904 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118067
    m_Localized: "\uD55C \uBC88 \uB354 \uACA8\uB904 \uBCF4\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118068
    m_Localized: "{0}: \uADF8\uB7FC \uD615 \uB9CC\uB098\uAE30 \uC804\uC5D0 \uB098\uBD80\uD130 \uC774\uACA8 \uBD10. \uCCB4\uC721\uAD00 \uB450 \uBC14\uD034."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786178
    m_Localized: "\uBD88\uC774 \uB4E4\uC5B4\uC628 \uB4A4\uB85C \uC120\uC0DD\uB2D8\uC740 \uBC24\uB9C8\uB2E4 \uAD50\uBB34\uC2E4 \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB97C \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786179
    m_Localized: "\uCD1B\uBD88\uC774 \uC9E7\uC544\uC9C8 \uB54C\uAE4C\uC9C0 \uC120\uC0DD\uB2D8\uC740 \uAD50\uBB34\uC2E4 \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB97C \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369190
    m_Localized: "\uADF8\uB9AC\uACE0 \uBAA9\uBC1C\uC744 \uC9DA\uC740 \uC724 \uC120\uC0DD\uB2D8\uC744 \uBCF4\uACE0\uB294 \uB9D0\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118069
    m_Localized: "\uB3C4\uD604\uC740 \uC2E0\uBC1C \uB048\uC744 \uB2E4\uC2DC \uB9F8\uB2E4. \uB098\uB294 \uC84C\uB2E4. \uC9C4\uC2EC\uC73C\uB85C \uB6F0\uC5C8\uB294\uB370\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118070
    m_Localized: "\uD615 \uC774\uC57C\uAE30\uB97C \uB354 \uB4E4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118071
    m_Localized: "{0}: \uD615\uC740 \uC5B4\uB5A4 \uC0AC\uB78C\uC774\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826567
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC885\uC774 \uC21C\uC11C\uB300\uB85C\uB9CC \uD574\uB3C4 \uB9CE\uC774 \uC0B4\uC544. \uB2E4\uC74C\uC5D4 \uADF8\uAC83\uB3C4 \uB5BC\uC5B4 \uC640. \uAC19\uC774 \uC678\uC6B0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711538
    m_Localized: "\uBD04\uC758 \uB9C8\uC9C0\uB9C9 \uBC24. \uC120\uC0DD\uB2D8\uC774 \uCD9C\uC11D\uBD80 \uB300\uC2E0 \uACF5\uCC45 \uD55C \uAD8C\uC744 \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711539
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: 1\uD559\uAE30 \uC911\uAC04 \uD3C9\uAC00, \uD560\uAC8C. \uB0B4 \uB9C8\uC74C\uB300\uB85C\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711540
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACF5\uBD80\uB294\u2026 \uC194\uC9C1\uD788 \uB180\uB790\uC5B4. \uC774\uB7F0 \uB370\uC11C\uB3C4 \uB108\uB294 \uACC4\uC18D \uBC30\uC6B0\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591983
    m_Localized: "{0}: \uACE0\uCE58\uBA74\u2026 \uC5F0\uB77D\uC774 \uC62C\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369189
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBD95\uB300\uAC00 \uC774\uAC83\uBC16\uC5D0 \uC5C6\uC5B4? \uC18C\uB3C5\uC57D\uC740? \uC544\uB2C8, \uC774\uAC74 \uC720\uD1B5\uAE30\uD55C\uC774\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369188
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBCF4\uAC74\uC2E4 \uBB38\uC744 \uC5F4\uC790\uB9C8\uC790 \uC57D\uC7A5\uBD80\uD130 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118073
    m_Localized: "\uCCB4\uC721\uAD00 \uC5F4 \uBC14\uD034\uB97C \uB3CC\uACE0 \uB9E4\uD2B8\uC5D0 \uB204\uC6E0\uC744 \uB54C, \uCD5C\uD558\uB9B0\uC774 \uBA3C\uC800 \uC785\uC744 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118074
    m_Localized: "\uCD5C\uD558\uB9B0: \uB098 \uC911\uD559\uAD50 \uB550 \uACC4\uC8FC \uB9C8\uC9C0\uB9C9 \uC8FC\uC790\uC600\uC5B4. \uC560\uB4E4\uC774 \uB098\uB9CC \uCCD0\uB2E4\uBD24\uC5B4. \uADF8\uAC8C \uC88B\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118075
    m_Localized: "\uCD5C\uD558\uB9B0: \uACE0\uB4F1\uD559\uAD50 \uC640\uC11C\uB3C4 \uC560\uB4E4\uC774 \uB098\uB9CC \uCCD0\uB2E4\uBCF4\uAE38 \uBC14\uB790\uB098 \uBD10. \u2026\uADF8\uB798\uC11C \uADF8\uB7AC\uB098 \uBD10. \uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118076
    m_Localized: "\uD558\uB9B0\uC740 \uADF8 '\uB2E4'\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118077
    m_Localized: "\uCD5C\uD558\uB9B0: \uADFC\uB370 \uC5EC\uAE30\uC11C \uB108\uB791 \uB6F8 \uB550, \uC544\uBB34\uB3C4 \uC548 \uCCD0\uB2E4\uBCF4\uC796\uC544. \uADF8\uAC8C \uB354 \uC88B\uB354\uB77C. \uC6C3\uAE30\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118078
    m_Localized: "\uB2E4\uC74C\uC5D0\uB3C4 \uAC19\uC774 \uB6F0\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905741
    m_Localized: "\uC190\uC744 \uB4E4\uC5C8\uC9C0\uB9CC \uC544\uBB34\uB3C4 \uC774\uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905740
    m_Localized: "\uAFC8\uC18D\uC758 \uAD50\uC2E4\uC740 \uD3C9\uBC94\uD588\uB2E4. \uCD9C\uC11D\uC744 \uBD80\uB974\uB294\uB370, \uC774\uB984\uC774 \uBD88\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uBA87 \uBC88\uC744 \uB2E4\uC2DC \uBD88\uB7EC\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369187
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB300\uB2F5\uC744 \uC548 \uD558\uB294 \uAC83\uB3C4 \uB300\uB2F5\uC774\uC57C. \uB2E4\uC74C\uC5D4 \uBB38 \uC55E\uC5D0 \uBB50\uB77C\uB3C4 \uB450\uACE0 \uC640 \uBD10. \uB9D0 \uB300\uC2E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369186
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC81\uC774 \uB9CE\uC740 \uC0AC\uB78C\uC77C \uAC70\uC57C. \uADF8\uAC8C \uC9C0\uAE08\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC740 \uC774\uC720\uC77C \uC218\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905739
    m_Localized: "\uBCF5\uB3C4 \uB05D\uC5D0 \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC774 \uBCF4\uC600\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC548\uC5D0\uC11C \uC7A0\uACA8 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905738
    m_Localized: "\uAFC8\uC5D0\uC11C \uBCF5\uB3C4\uB97C \uB2EC\uB9AC\uACE0 \uC788\uC5C8\uB2E4. \uB4A4\uC5D0\uC11C \uBC1C\uC18C\uB9AC\uAC00 \uB530\uB77C\uC654\uB2E4. \uB3CC\uC544\uBCF4\uBA74 \uC544\uBB34\uB3C4 \uC5C6\uACE0, \uC55E\uC744 \uBCF4\uBA74 \uBCF5\uB3C4\uAC00 \uB05D\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905737
    m_Localized: "\uAFC8\uC18D\uC758 \uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0\uB294 \uAE08\uC774 \uB05D\uB3C4 \uC5C6\uC774 \uADF8\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249336905736
    m_Localized: "\uB610 \uADF8 \uCC3D\uACE0 \uAFC8\uC774\uC5C8\uB2E4. \uBB38 \uBC16\uC758 \uC6C3\uC74C\uC18C\uB9AC. \uC190\uC7A1\uC774\uB97C \uC544\uBB34\uB9AC \uB3CC\uB824\uB3C4 \uC5F4\uB9AC\uC9C0 \uC54A\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118079
    m_Localized: "{0}: \uB2E4\uC74C \uC8FC\uC5D0\uB3C4. \uC5F4\uD55C \uBC14\uD034."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118080
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC5F4\uB450 \uBC14\uD034. \uC9C0\uB294 \uC0AC\uB78C\uC774 \uBB3C \uB5A0 \uC624\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711541
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACF5\uBD80\uB294 \uAFB8\uC900\uD588\uC5B4. \uD558\uB8E8\uB3C4 \uAC70\uB974\uC9C0 \uC54A\uC740 \uC0AC\uB78C\uCC98\uB7FC \uBCF4\uC774\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654276
    m_Localized: "\uB3CC\uC544\uC624\uC790\uB9C8\uC790 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uD314\uC744 \uBD99\uC7A1\uC558\uB2E4. \uC190\uB05D\uC774 \uCC28\uAC00\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706478
    m_Localized: "\uACFC\uD559\uC2E4 \uBCBD\uC5D0 \uC8FC\uAE30\uC728\uD45C\uAC00 \uBC18\uCBE4 \uCC22\uC5B4\uC9C4 \uCC44 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC2E4\uD5D8\uB300 \uC11C\uB78D\uB9C8\uB2E4 \uC54C\uCF54\uC62C\uB7A8\uD504\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369185
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC774\uC57C\uAE30\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591984
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAA8\uB974\uACA0\uC5B4. \uADF8\uB798\uB3C4 \uCF1C \uBCF4\uAE30 \uC804\uC5D4 \uC544\uBB34\uB3C4 \uBAA8\uB974\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591985
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uC1A1\uC2E4\uAE4C\uC9C0\uB294 \uB098\uB3C4 \uBAA9\uBC1C\uB85C \uAC00 \uBCFC\uAC8C. \uC190\uC740 \uB124\uAC00, \uC124\uBA85\uC740 \uB0B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591986
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uAC70\uAE30\uAE4C\uC9C0 \uAC08 \uC218 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370. \uB300\uC2E0 \uBCF8 \uAC78 \uD558\uB098\uB3C4 \uBE7C\uB193\uC9C0 \uB9D0\uACE0 \uADF8\uB824 \uC640 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118081
    m_Localized: "\uD558\uB9B0\uC774 \uBA3C\uC800 \uC77C\uC5B4\uB098 \uC190\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uC7A1\uACE0 \uC77C\uC5B4\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118082
    m_Localized: "\uADF8\uB0E5 \uC606\uC5D0 \uC549\uC544 \uC788\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118083
    m_Localized: "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uD558\uB9B0 \uC606\uC5D0 \uC549\uC544 \uC228\uC744 \uACE8\uB790\uB2E4. \uCCB4\uC721\uAD00 \uCC3D\uC73C\uB85C \uB2EC\uBE5B\uC774 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826566
    m_Localized: "\uAC07\uD600 \uC788\uB358 \uACF3\uC774, \uC9C0\uD0A4\uB294 \uACF3\uC774 \uB418\uC5C8\uB2E4. \uADF8\uB0A0 \uBC24\uC740 \uBB38 \uCABD\uC744 \uBCF4\uC9C0 \uC54A\uACE0\uB3C4 \uC7A0\uB4E4 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118085
    m_Localized: "\uB178\uB798 \uC5F0\uC2B5\uC774 \uB05D\uB0AC\uB294\uB370 \uC1A1\uC608\uC9C0\uAC00 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174916
    m_Localized: "\uC0C8\uBCBD \uB124 \uC2DC\uCBE4 \uB3C4\uD604\uC758 \uC774\uB9C8\uAC00 \uC2DD\uC5C8\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uACFC \uB098\uB294 \uB3D9\uC2DC\uC5D0 \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369184
    m_Localized: "\uACE8\uBAA9 \uB05D\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB04C\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uB354 \uBA38\uBB3C \uC218\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369183
    m_Localized: "\uD55C\uCC38\uC744 \uAE30\uB2E4\uB838\uC9C0\uB9CC \uB300\uB2F5\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757753
    m_Localized: "\uD574\uAC00 \uB728\uC790 \uD559\uAD50\uB97C \uB458\uB7EC\uC30C\uB358 \uBC1C\uC18C\uB9AC\uAC00 \uD558\uB098\uB458 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757754
    m_Localized: "\uBB38 \uD558\uB098\uAC00 \uBC84\uD2F0\uC9C0 \uBABB\uD588\uB2E4. \uCC2C\uBC14\uB78C\uACFC \uD568\uAED8 \uBB34\uC5B8\uAC00 \uBC00\uB824 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118086
    m_Localized: "\uC1A1\uC608\uC9C0: \uD569\uCC3D\uBD80 \uADF8\uB9CC\uB454 \uAC70, \uBAA9\uC774 \uC544\uD30C\uC11C\uB77C\uACE0 \uD588\uC5C8\uB294\uB370. \uAC70\uC9D3\uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118087
    m_Localized: "\uC1A1\uC608\uC9C0: \uBB34\uB300\uC5D0\uC11C \uB2E4\uB4E4 \uB098\uB97C \uBCF4\uB294 \uAC8C \uBB34\uC11C\uC6E0\uC5B4. \uBCF4\uC774\uB294 \uAC8C. \uADF8\uB798\uC11C \uADF8 \uB4A4\uB85C\uB294\u2026 \uBCF4\uB294 \uCABD\uC5D0\uB9CC \uC788\uC5C8\uC5B4. \uB298."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118088
    m_Localized: "\uC608\uC9C0\uAC00 \uB0B4 \uCABD\uC744 \uBCF4\uC9C0 \uBABB\uD558\uACE0 \uBC14\uB2E5\uC744 \uBCF4\uC558\uB2E4. \uADF8 \uB9D0\uC774 \uBB34\uC5C7\uC744 \uB73B\uD558\uB294\uC9C0, \uB098\uB294 \uC870\uAE08 \uC54C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118089
    m_Localized: "\uC1A1\uC608\uC9C0: \uADFC\uB370 \uB108\uB791 \uBD80\uB97C \uB550 \uBB34\uC12D\uC9C0 \uC54A\uC544. \uC774\uC0C1\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118090
    m_Localized: "\uAC19\uC774 \uD55C \uACE1 \uB354 \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118091
    m_Localized: "{0}: \uD55C \uACE1\uB9CC \uB354. \uC774\uBC88\uC5D4 \uB124\uAC00 \uBA3C\uC800 \uC2DC\uC791\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118092
    m_Localized: "\uC608\uC9C0\uAC00 \uC228\uC744 \uB4E4\uC774\uC26C\uC5C8\uB2E4. \uCCAB \uC18C\uC808\uC774 \uB5A8\uB838\uB2E4. \uB450 \uBC88\uC9F8 \uC18C\uC808\uBD80\uD130\uB294 \uB5A8\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB294 \uADF8 \uC544\uB798\uB85C \uC870\uC6A9\uD788 \uD654\uC74C\uC744 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654277
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B4\uB514. \uBCF4\uC5EC \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174885
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC130\uB2E4. \uB098, \uC130\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786180
    m_Localized: "{0}: \uADF8 \uC5F4\uC1E0, \uACC4\uC18D \uBCF4\uC2DC\uB358\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786181
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0AC\uD0DC \uBA70\uCE60 \uC804\uC5D0 \uAD50\uBB34\uC2E4\uC5D0 \uACF5\uBB38\uC774 \uC654\uC5C8\uC5B4. \uB2E4\uB4E4 \uADF8\uB0E5 \uB3C5\uAC10 \uB300\uC751 \uC9C0\uCE68\uC778 \uC904 \uC54C\uC558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654278
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC0C1\uCC98 \uB458\uB808\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uCC9C\uCC9C\uD788 \uC9DA\uC5B4 \uB098\uAC14\uB2E4. \uC787\uC790\uAD6D\uC774 \uC788\uB294\uC9C0 \uBCF4\uB294 \uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654279
    m_Localized: "\uD55C\uCC38 \uB4A4\uC5D0\uC57C \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654280
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uAE01\uD78C \uAC70\uC57C. \uBB3C\uB9B0 \uAC74 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654281
    m_Localized: "\uADF8 \uB9D0\uC744 \uD558\uB294 \uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706409
    m_Localized: "\uC5BC\uC5B4\uBD99\uC740 \uD558\uCC9C\uC5D0\uC11C \uC370\uB9E4\uB97C \uD0C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118093
    m_Localized: "\uC870\uC6A9\uD788 \uB4E4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118094
    m_Localized: "\uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uC608\uC9C0\uAC00 \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC744 \uB2E4 \uD560 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563538
    m_Localized: "\uB3C4\uD604\uC774 \uBB34\uC804\uAE30 \uCABD\uC73C\uB85C \uBAB8\uC744 \uAE30\uC6B8\uC600\uB2E4. \uC785\uC220\uC774 \uBA87 \uBC88 \uB2EC\uC2F9\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369182
    m_Localized: "\uBB38\uD2C8 \uC544\uB798\uB85C \uADF8\uB9BC\uC790\uAC00 \uD55C \uBC88 \uC6C0\uC9C1\uC600\uB2E4\uAC00, \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369181
    m_Localized: "{0}: \uC800\uAE30\uC694. \uC0C8\uBCBD\uACE0 \uD559\uC0DD\uC774\uC5D0\uC694. \uD574\uCE58\uB824\uB294 \uAC70 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369180
    m_Localized: "\uB450 \uBC88 \uB178\uD06C\uD588\uB2E4. \uC548\uCABD\uC758 \uC228\uC18C\uB9AC\uAC00 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369179
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uCABD\uC9C0\uB97C \uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0 \uB07C\uC6CC \uB450\uC790\uACE0 \uD588\uB2E4. \uACE0\uB9C8\uC6B4 \uB9D0\uC740 \uC783\uC5B4\uBC84\uB9AC\uBA74 \uC548 \uB41C\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369178
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uB9D9\uB2E4\uB294 \uB9D0\uC744 \uBC1B\uC740 \uAC70\uB124. \uC694\uC998 \uAC19\uC740 \uB54C\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369177
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38 \uB0B4\uB0B4 \uCABD\uC9C0\uB97C \uC190\uC5D0 \uC950\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369176
    m_Localized: "'\uC694' \uC790\uC758 \uB9C8\uC9C0\uB9C9 \uD68D\uC774 \uB3D9\uADF8\uB797\uAC8C \uB9D0\uB824 \uC62C\uB77C\uAC00 \uC788\uC5C8\uB2E4. \uAE30\uC5B5\uC740 \uB05D\uB0B4 \uC190\uC5D0 \uC7A1\uD788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369175
    m_Localized: "\uAE00\uC528\uAC00 \uB465\uAE00\uC5C8\uB2E4. \uC5B4\uB514\uC11C \uBCF8 \uAC83 \uAC19\uAE30\uB3C4 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174917
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC744 \uB5B4\uB2E4. \uC6B0\uB9AC \uB458\uC744 \uBC88\uAC08\uC544 \uBCF4\uB354\uB2C8, \uC270 \uBAA9\uC18C\uB9AC\uB85C \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563537
    m_Localized: "DJ: \uC790\uC804\uAC70\uB85C \uB2E4\uB2C8\uB294 \uC6B4\uBC18\uC870\uAC00 \uC788\uC5B4\uC694. \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88 \uB3D9\uB124\uB97C \uB3CC\uC544\uC694. \uD544\uC694\uD55C \uAC8C \uC788\uC73C\uBA74, \uC11C\uB85C \uBC14\uAFC0 \uC218 \uC788\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563536
    m_Localized: "DJ: \uC6B0\uB9AC\uB294 UBC\uC608\uC694. \uC61B \uBC29\uC1A1\uAD6D \uAC74\uBB3C. \uC2A4\uBB34 \uBA85\uCBE4 \uC0B4\uC544\uC694. \uCCB4\uC721\uACF5\uC6D0\uC5D0\uC11C \uB118\uC5B4\uC628 \uC0AC\uB78C\uB4E4\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826565
    m_Localized: "\uBD84\uD544 \uAC00\uB8E8\uAC00 \uC120\uC0DD\uB2D8 \uC18C\uB9E4\uC5D0 \uD558\uC597\uAC8C \uBB3B\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0 \uBCF4\uB294 \uBAA8\uC2B5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118096
    m_Localized: "\uB178\uB798\uAC00 \uB05D\uB0AC\uB294\uB370 \uC120\uBC30\uAC00 \uAE30\uD0C0\uB97C \uB0B4\uB824\uB193\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uCC98\uC74C \uB4E3\uB294 \uACE1\uC744 \uCE58\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118097
    m_Localized: "\uC545\uBCF4\uB3C4 \uC5C6\uACE0 \uAC00\uC0AC\uB3C4 \uC5C6\uB294 \uACE1\uC774\uC5C8\uB2E4. \uB290\uB9AC\uACE0, \uC911\uAC04\uC5D0 \uD55C \uBC88 \uBA48\uCDC4\uB2E4\uAC00, \uB2E4\uC2DC \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706408
    m_Localized: "\uC5B4\uB978\uB4E4\uACFC \uC544\uC774\uB4E4\uC774 \uD55C \uBD88 \uC55E\uC5D0 \uB458\uB7EC\uC549\uC558\uB2E4. \uC5F0\uAE30\uAC00 \uD558\uB298\uB85C \uACE7\uAC8C \uC62C\uB77C\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706407
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uAD50 \uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uACE0\uAE30\uB97C \uAD7D\uB2E4\uB2C8. \uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uBA74 \uAE30\uC808\uD558\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118098
    m_Localized: "\uACE1\uC774 \uB05D\uB098\uC790 \uC120\uBC30\uAC00 \uACF5\uCC45\uC744 \uAEBC\uB0B4 \uD55C \uC904\uC744 \uC37C\uB2E4. \u300C\uB0B4\uAC00 \uB9CC\uB4E0 \uAC70. \uC544\uC9C1 \uB05D\uC774 \uC5C6\uC5B4.\u300D"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757755
    m_Localized: "\uADF8\uB2E4\uC74C\uC740 \uC18C\uB9AC\uB85C\uB9CC \uAE30\uC5B5\uB09C\uB2E4. \uB118\uC5B4\uC9C0\uB294 \uCC45\uC0C1, \uB204\uAD70\uAC00\uC758 \uC678\uCE68, \uADF8\uB9AC\uACE0 \uD574\uAC00 \uB730 \uB54C\uC758 \uC870\uC6A9\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757756
    m_Localized: "\uC2B5\uACA9\uC774 \uC9C0\uB098\uAC04 \uC0C8\uBCBD. \uB2E4\uB4E4 \uAD50\uC2E4 \uBC14\uB2E5\uC5D0 \uC4F0\uB7EC\uC9C0\uB4EF \uB204\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174884
    m_Localized: "\uD55C \uAC78\uC74C. \uB450 \uAC78\uC74C. \uC138 \uAC78\uC74C\uC9F8\uC5D0 \uBE44\uD2C0\uD588\uC9C0\uB9CC, \uB118\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786182
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB3C4 \uACB0\uC7AC\uD310\uC744 \uB118\uAE30\uBA74\uC11C \uC81C\uBAA9\uB9CC \uBD24\uC5B4. \uB05D\uAE4C\uC9C0 \uC77D\uC740 \uC0AC\uB78C\uC774 \uC788\uC5C8\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786183
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4 \uB9E8 \uC548\uCABD \uCE90\uBE44\uB2DB. \uD639\uC2DC \uAC70\uAE30 \uB0A8\uC544 \uC788\uC73C\uBA74\u2026 \uC544\uB2C8\uB2E4. \uB098\uC911\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369174
    m_Localized: "'\uACE0\uB9C8\uC6CC\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706479
    m_Localized: "\uBD88\uC744 \uBD99\uC774\uBA74 \uBB3C\uC744 \uB053\uC77C \uC218 \uC788\uB2E4. \uADF8 \uC0DD\uAC01\uC774 \uBA3C\uC800 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706480
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB7A8\uD504 \uCC59\uACA8 \uC654\uC5B4? \uC798\uD588\uB2E4. \uACFC\uD559 \uC120\uC0DD\uB2D8 \uCC45\uC0C1\uC5D0 \uAD50\uACFC\uC11C\uB3C4 \uC788\uC5C8\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369173
    m_Localized: "\uB300\uC2E0 \uBE48 \uC0DD\uC218\uBCD1 \uD558\uB098\uAC00 \uBC18\uB4EF\uD558\uAC8C \uC138\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uB69C\uAED1 \uC704\uC5D0 \uC791\uC740 \uC885\uC774\uAC00 \uB07C\uC6CC\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369172
    m_Localized: "\uB2E4\uC74C\uC5D0 \uADF8 \uACE8\uBAA9\uC744 \uC9C0\uB0A0 \uB54C, 102\uD638 \uBB38 \uC55E\uC5D0 \uB450\uACE0 \uC628 \uD1B5\uC870\uB9BC\uC774 \uC5C6\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369171
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0AE\uC5D0\uB9CC \uAC00. \uBC24\uC758 \uACE8\uBAA9\uC740 \uC6B0\uB9AC \uD3B8\uC774 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118099
    m_Localized: "\uC120\uBC30\uAC00 \uACF5\uCC45\uC744 \uB118\uACA8 \uB2E4\uC74C \uC904\uC744 \uC37C\uB2E4. \u300C\uB05D\uC740 \uC5EC\uAE30\uC11C \uB098\uAC00\uBA74 \uB9CC\uB4E4 \uAC70\uC57C.\u300D"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118100
    m_Localized: "\uD765\uC5BC\uAC70\uB9AC\uBA70 \uB530\uB77C \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118101
    m_Localized: "\uB450 \uBC88\uC9F8 \uC5F0\uC8FC\uC5D0\uC11C \uB098\uB294 \uAC00\uC0AC \uC5C6\uC774 \uD765\uC5BC\uAC70\uB838\uB2E4. \uC120\uBC30\uAC00 \uBA48\uCDC4\uB358 \uADF8 \uC790\uB9AC\uC5D0\uC11C, \uB0B4 \uD765\uC5BC\uAC70\uB9BC\uC774 \uBE48 \uACF3\uC744 \uBA54\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118102
    m_Localized: "\uC120\uBC30\uAC00 \uB098\uB97C \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uADF8 \uC790\uB9AC\uB97C \uB2E4\uC74C\uBD80\uD130 \uBE44\uC6CC \uB450\uACE0 \uCCE4\uB2E4. \uB0B4 \uBAAB\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118103
    m_Localized: "\uACE1 \uC774\uB984\uC744 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118104
    m_Localized: "{0}: \uC774 \uACE1 \uC774\uB984\uC774 \uBB50\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826564
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0, \uBC15\uC790\uB97C \uACC4\uC18D \uB450\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711551
    m_Localized: "\uBD88\uC744 \uB044\uAE30 \uC804, \uC120\uC0DD\uB2D8\uC774 \uBD95\uB300\uB97C \uAC08\uB2E4\uAC00 \uC190\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369170
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A0\uAE34 \uBB38\uC774 \uC788\uC73C\uBA74 \uC5B5\uC9C0\uB85C \uC5F4\uC9C0 \uB9C8. \uC548\uC5D0 \uB204\uAC00 \uC788\uB2E4\uBA74, \uADF8 \uC0AC\uB78C\uD55C\uD14C\uB294 \uADF8 \uBB38\uC774 \uC804\uBD80\uC77C \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369169
    m_Localized: "\uB3C4\uD604: \uC0C8\uBCBD\uB3D9\uC774\uC694? \uC6B0\uB9AC \uC9D1 \uAC70\uAE30\uC608\uC694. \uBE68\uAC04 \uC9C0\uBD95."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369168
    m_Localized: "\uB3C4\uD604\uC774 \uC9C0\uB3C4 \uC704\uB85C \uACE0\uAC1C\uB97C \uB0B4\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369167
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0C8\uBCBD\uB3D9\uC774\uAD6C\uB098. \uC0AC\uB78C\uC774 \uC0B4\uB358 \uACF3\uC774\uB2C8 \uC4F8 \uB9CC\uD55C \uAC8C \uB9CE\uACA0\uC9C0. \uADF8\uB9AC\uACE0\u2026 \uC0AC\uB78C\uC774 \uB0A8\uC544 \uC788\uC744 \uC218\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711552
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uC598\uAE30, \uD55C \uBC88\uB3C4 \uC548 \uD588\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711553
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uACFC \uD6C4\uC600\uC5B4. \uAD50\uBB38\uC73C\uB85C \uC0AC\uB78C\uB4E4\uC774 \uBC00\uB824 \uB4E4\uC5B4\uC654\uACE0, \uC6B0\uB9AC\uB294 \uCCB4\uC721\uAD00 \uCABD\uC73C\uB85C \uC548\uB0B4\uD558\uACE0 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711554
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2E4 \uB204\uAD70\uAC00 \uB0B4 \uB2E4\uB9AC\uB97C \uBD99\uC7A1\uC558\uC5B4. \uADF8\uB2E4\uC74C \uC77C\uC740\u2026 \uC9C0\uAE08\uB3C4 \uC18C\uB9AC\uB85C\uB9CC \uAE30\uC5B5\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118106
    m_Localized: "\uC7A5\uAE30\uB97C \uB2E4\uC12F \uD310\uC9F8 \uB450\uB2E4\uAC00, \uC720\uB791\uC790\uAC00 \uB9D0\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118107
    m_Localized: "\uC720\uB791\uC790: \uC0B0 \uB300\uD53C\uC18C\uC5D0 \uB538\uC774\uB791 \uC790\uC8FC \uAC14\uB2E4. \uBE44 \uC624\uBA74 \uC774\uB807\uAC8C \uC7A5\uAE30\uB97C \uB480\uC9C0. \uB538\uC740 \uB298 \uC84C\uB2E4. \uC838 \uC8FC\uB294 \uCC99\uD558\uB294 \uC904\uB3C4 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118108
    m_Localized: "\uC720\uB791\uC790\uAC00 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC0AC\uD0D5\uC744 \uAEBC\uB0C8\uB2E4. \uB298 \uAC16\uACE0 \uB2E4\uB2C8\uB358 \uADF8 \uC0AC\uD0D5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563535
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4, \uC544\uC9C1 \uAE68\uC5B4 \uC788\uC5B4\uC694? \uC774\uAC74 \uBC29\uC1A1 \uC544\uB2C8\uACE0 \uADF8\uB0E5 \uD1B5\uD654\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563534
    m_Localized: "\uBC29\uC1A1\uC774 \uB05D\uB09C \uB4A4, 3\uBC88 \uCC44\uB110\uC5D0\uC11C DJ \uC0C8\uBCBD\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uB2E4. \uBC29\uC1A1 \uB54C\uBCF4\uB2E4 \uB0AE\uACE0 \uC870\uC6A9\uD55C \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369166
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uB9D0\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC9C0\uB3C4\uB97C \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757757
    m_Localized: "\uB204\uAD70\uAC00 \uCF54\uB97C \uACE8\uAE30 \uC2DC\uC791\uD588\uB2E4. \uC6C3\uC744 \uAE30\uC6B4\uB3C4 \uC5C6\uC5C8\uB294\uB370, \uC6C3\uC74C\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757758
    m_Localized: "\uBB34\uB108\uC9C4 \uBB38 \uCABD\uC5D0\uC11C \uCC2C\uBC14\uB78C\uC774 \uB4E4\uC5B4\uC654\uB2E4. \uB2F4\uC694\uB97C \uD558\uB098\uC529 \uB354 \uAEBC\uB0B4 \uB36E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757759
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBC29\uC1A1\uC2E4 \uBB34\uC804\uAE30\uB85C \uAC00\uC744 \uD3C9\uAC00\uB97C \uC2DC\uC791\uD588\uB2E4. \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uBAA9\uC18C\uB9AC\uAC00 \uAD50\uC2E4\uC5D0 \uB0AE\uAC8C \uAE54\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174883
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC758\uC871\uC744 \uB07C\uC6B0\uACE0 \uBCBD\uC744 \uC9DA\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC190\uC744 \uB5BC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786184
    m_Localized: "{0}: \uBB50\uAC00 \uC801\uD600 \uC788\uC5C8\uB294\uC9C0 \uAD81\uAE08\uD558\uC9C0 \uC54A\uC73C\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786185
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD81\uAE08\uD574. \uADF8\uB798\uC11C \uBB34\uC11C\uC6CC. \uC5B4\uB978\uB4E4\uC774 \uBB58 \uC54C\uACE0 \uC788\uC5C8\uB294\uC9C0, \uC54C\uAC8C \uB420\uAE4C \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369165
    m_Localized: "\uACE8\uBAA9 \uC5B4\uB518\uAC00\uC5D0\uC11C \uAC1C \uC9D6\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4\uAC00, \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174918
    m_Localized: "\uB3C4\uD604: \uB204\uB098\uB791 \uC324\uC774 \uC5C4\uB9C8 \uAC19\uC544\uC694. \u2026\uB458\uC774 \uD569\uCCD0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369164
    m_Localized: "\uC5B4\uB290 \uC9D1 \uCC3D\uBB38\uC5D0 '\uC0AC\uB78C \uC788\uC5B4\uC694'\uB77C\uACE0 \uC4F4 \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC5B8\uC81C \uBD99\uC778 \uAC74\uC9C0\uB294 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369163
    m_Localized: "\uBA87\uBA87 \uBCA0\uB780\uB2E4\uC5D0\uB294 \uC544\uC9C1 \uBE68\uB798\uAC00 \uAC78\uB824 \uC788\uC5C8\uB2E4. \uBC14\uB78C\uC5D0 \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369162
    m_Localized: "\uD3B8\uC758\uC810 \uC625\uC0C1\uC5D0\uC11C \uBCF4\uB2C8 \uACE8\uBAA9 \uB108\uBA38\uB85C \uBE4C\uB77C\uCD0C\uC774 \uC774\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369161
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD30C\uC77C\uC744 \uAC00\uBC29\uC5D0 \uB3C4\uB85C \uB123\uC5B4 \uC8FC\uACE0, \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563533
    m_Localized: "\uBA70\uCE60 \uB3D9\uC548 \uBC24\uC5D0 \uBD88\uC744 \uCF1C\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB4E4 \uB9D0\uC218\uAC00 \uC904\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118109
    m_Localized: "\uC720\uB791\uC790: \uAC54\uAC00 \uC88B\uC544\uD558\uB358 \uAC70\uB2E4. \uC774\uAC70 \uB2E4 \uB5A8\uC5B4\uC9C0\uAE30 \uC804\uC5D0\uB294 \uCC3E\uC744 \uAC70\uB77C\uACE0, \uADF8\uB807\uAC8C \uC815\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118110
    m_Localized: "\uC0AC\uD0D5\uC774 \uBA87 \uAC1C \uB0A8\uC9C0 \uC54A\uC558\uB2E4\uB294 \uAC78, \uB098\uB294 \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711555
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBD95\uB300 \uB05D\uC744 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4. \uBB34\uB98E \uC544\uB798, \uBE44\uC5B4 \uC788\uB294 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706406
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uC22F\uACFC \uACE0\uAE30 \uD1B5\uC870\uB9BC\uC744 \uAC00\uC838\uC654\uB2E4. \uC6B0\uB9AC\uB294 \uC300\uACFC \uAE40\uCE58\uB97C \uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118111
    m_Localized: "\uD55C \uD310 \uB354 \uB450\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118112
    m_Localized: "{0}: \uD55C \uD310 \uB354\uC694. \uC774\uBC88\uC5D4 \uC838 \uC8FC\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340649
    m_Localized: "\uB3C4\uD604: \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4\uACE0 \uD588\uC796\uC544. \uBC24 \uB2F9\uBC88 \uB54C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369160
    m_Localized: "\uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369159
    m_Localized: "\uADF8\uB0A0 \uBC24, \uCC98\uC74C\uC73C\uB85C \uADF8 \uC774\uC57C\uAE30\uB97C \uC870\uAE08 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369158
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB124\uAC00 \uC0AC\uACFC\uD560 \uC77C\uC774 \uC544\uB2C8\uC57C. \uC0AC\uACFC\uB294 \uB0B4\uAC00 \uD574\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757760
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uB85C \uAC00\uC744 \uD3C9\uAC00\uB97C \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757761
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uBC88 \uACC4\uC808\uC740 \uAE38\uC5C8\uB2E4. \uADF8\uB807\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174882
    m_Localized: "\uB048\uC744 \uC138 \uBC88 \uC870\uC774\uACE0, \uCFE0\uC158\uC744 \uB450 \uBC88 \uBC14\uAFE8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786186
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB9D0\uC744 \uB05D\uB9FA\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786187
    m_Localized: "\uD55C\uCC38 \uB4A4, \uAFB8\uB7EC\uBBF8\uC5D0\uC11C \uC791\uC740 \uC5F4\uC1E0 \uD558\uB098\uB97C \uBE7C\uC11C \uCC45\uC0C1 \uC704\uC5D0 \uC62C\uB824 \uB450\uC5C8\uB2E4. \uC9D1\uC5B4 \uAC00\uB77C\uB294 \uB9D0\uB3C4, \uB450\uB77C\uB294 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786301
    m_Localized: "\uADF8 \uB4A4\uB85C 3\uCE35\uC5D0\uC11C \uB178\uD06C \uC18C\uB9AC\uB294 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786300
    m_Localized: "\uB300\uC2E0 \uD1B5\uC870\uB9BC \uB450 \uAC1C\uB97C \uBB38\uD2C8\uC73C\uB85C \uBC00\uC5B4 \uC8FC\uC5C8\uB2E4. \uBC1C\uC18C\uB9AC\uAC00 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174798
    m_Localized: "\uD574\uAC00 \uB730 \uB54C\uAE4C\uC9C0 \uC190\uC744 \uC7A1\uACE0 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBA87 \uBC88\uC774\uB098 \uACE0\uB9D9\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340648
    m_Localized: "\uB3C4\uD604: \uB204\uB098, \uB098 \uC548 \uD0C0\uB3C4 \uB3FC. \uC9C4\uC9DC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340647
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uD604\uC774\uB791 \uC900\uC740 \uC148\uC5D0\uC11C \uBE7C\uB77C. \uADF8 \uB458\uC740 \uBB34\uC870\uAC74 \uD0C4\uB2E4. \uADF8\uAC74 \uB0B4\uAC00 \uC815\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340646
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uC6B0\uAC1C \uC4F8 \uB54C\uAC00 \uB410\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340645
    m_Localized: "\uBA87 \uBC88\uC744 \uB2E4\uC2DC \uC138\uC5B4\uB3C4, \uC5EC\uB35F\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174831
    m_Localized: "\uB0A8\uC790\uAC00 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117927
    m_Localized: "\uC57C\uC639. \uC9E7\uAC8C \uD55C \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729279
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBC18 \uC54C\uB85C \uB420 \uAC78 \uD55C \uC54C \uC4F0\uC9C0 \uC54A\uB294 \uAC70. \uADF8\uAC8C \uB0B4\uAC00 \uC774\uC2ED \uB144 \uB3D9\uC548 \uBC30\uC6B4 \uAC70\uC57C. \uC774\uC81C \uB124 \uAC83\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729280
    m_Localized: "\uD39C\uB77C\uC774\uD2B8\uB97C \uBC1B\uC544 \uBD88\uC744 \uCF1C \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729281
    m_Localized: "\uB538\uAE4D. \uC791\uC740 \uBE5B\uC774 \uCC9C\uC7A5\uC5D0 \uB3D9\uADF8\uB797\uAC8C \uB5B4\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729282
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAC74\uC804\uC9C0\uB294 \uC544\uAEF4. \uADF8\uAC74 \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729283
    m_Localized: "\uB538 \uC774\uB984\uC744 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729284
    m_Localized: "{0}: \uB530\uB2D8 \uC774\uB984, \uC54C\uB824 \uC8FC\uC2E4\uB798\uC694? \uAD6C\uC870\uB418\uBA74 \uCC3E\uC744 \uB54C \uAC19\uC774 \uBD80\uB974\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729285
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC774\uB984\uC744 \uD55C \uAE00\uC790\uC529 \uCC9C\uCC9C\uD788 \uB9D0\uD588\uB2E4. \uC624\uB798 \uBD80\uB974\uC9C0 \uC54A\uC740 \uC774\uB984\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729286
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uACE0\uB9C8\uC6CC. \uC18C\uB9AC \uB0B4\uC11C \uB9D0\uD55C \uAC70, \uC624\uB79C\uB9CC\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117928
    m_Localized: "\uB3C4\uD604: \uC7E4 \uB204\uB098 \uAE30\uB2E4\uB9B0 \uAC70 \uAC19\uC740\uB370\uC694. \uBC25\uB54C \uB9DE\uCDB0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117929
    m_Localized: "\uB610 \uBC25\uC744 \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117930
    m_Localized: "\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uACC4\uB2E8\uC5D0 \uC549\uC544 \uC788\uC5B4\uB3C4 \uB2E4\uAC00\uC640 \uBA39\uC5C8\uB2E4. \uB2E4 \uBA39\uB354\uB2C8, \uAF2C\uB9AC\uB85C \uB0B4 \uC815\uAC15\uC774\uB97C \uD22D \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117931
    m_Localized: "\uC774\uB984\uC774 \uC788\uC5B4\uC57C \uD560 \uAC83 \uAC19\uC558\uB2E4. \uAE09\uC2DD\uC2E4 \uC55E\uC5D0\uC11C \uB9CC\uB0AC\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729287
    m_Localized: "(\uBC15 \uC120\uC0DD\uB2D8\uC5D0\uAC8C\uC11C '\uC544\uAEF4 \uC4F0\uB294 \uC190'\uC744 \uBC30\uC6E0\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729288
    m_Localized: "\uB3C4\uD604: \uB204\uB098, \uC7A0\uAE50\uB9CC\uC694. \uBCF4\uC5EC \uC904 \uAC8C \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729289
    m_Localized: "\uB3C4\uD604\uC774 \uACF5\uCC45\uC744 \uBB34\uB98E\uC5D0 \uD3BC\uCCE4\uB2E4. \uCC3D\uAC00\uC5D0\uC11C \uB0AE \uB3D9\uC548 \uADF8\uB9B0 \uC6B4\uB3D9\uC7A5\uACFC \uACE8\uBAA9. \uC791\uC740 \uB3D9\uADF8\uB77C\uBBF8, \uD654\uC0B4\uD45C, \uADF8 \uC606\uC5D0 \uC2DC\uAC04."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729290
    m_Localized: "\uB3C4\uD604: \uB3D9\uADF8\uB77C\uBBF8\uB294 \uC11C \uC788\uB294 \uAC70, \uC138\uBAA8\uB294 \uAC77\uB294 \uAC70. \uD654\uC0B4\uD45C \uB450 \uAC1C\uB294 \uBE68\uB9AC \uC624\uB294 \uAC70\uC608\uC694. \uC774\uAC74 \uB204\uB098\uB9CC \uC54C\uBA74 \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729291
    m_Localized: "\uB3C4\uD604: \uADF8\uB9AC\uACE0 \uC774 \uC810\uC120. \uD574 \uC9C8 \uB54C \uC800\uAC83\uB4E4\uC774 \uC815\uBB38 \uCABD\uC73C\uB85C \uBAB0\uB9AC\uB294 \uAE38\uC774\uC5D0\uC694. \uC694\uC998 \uC774\uD2C0\uC5D0 \uD55C \uBC88\uC529 \uBC14\uB00C\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729292
    m_Localized: "\uB3C4\uD604: \uC120\uBC30\uD55C\uD14C\uB3C4 \uBCF4\uC5EC \uC92C\uB294\uB370, \uACE0\uAC1C\uB9CC \uB044\uB355\uC600\uC5B4\uC694. \uADF8\uAC70 \uCE6D\uCC2C \uB9DE\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729293
    m_Localized: "\uD45C\uC2DC\uBC95\uC744 \uD558\uB098\uC529 \uC678\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729294
    m_Localized: "\uB3D9\uADF8\uB77C\uBBF8, \uC138\uBAA8, \uD654\uC0B4\uD45C \uB458. \uB3C4\uD604\uC740 \uC120\uC0DD\uB2D8\uCC98\uB7FC \uBB38\uC81C\uB97C \uB0C8\uB2E4. \uB0B4\uAC00 \uC138\uBAA8\uB97C \uB3D9\uADF8\uB77C\uBBF8\uB85C \uC77D\uC790 \uC190\uBC14\uB2E5\uC73C\uB85C \uC774\uB9C8\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729295
    m_Localized: "\uB3C4\uD604: \uB204\uB098 \uADF8\uB7EC\uB2E4 \uC8FD\uC5B4\uC694. \uB2E4\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729296
    m_Localized: "\uC138 \uBC88\uC9F8\uC5D0 \uB2E4 \uB9DE\uD614\uB2E4. \uB3C4\uD604\uC774 \uACF5\uCC45 \uB9E8 \uB4B7\uC7A5\uC5D0 \uC791\uAC8C '\uD569\uACA9'\uC774\uB77C\uACE0 \uC368 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729297
    m_Localized: "\uC774\uAC70 \uC9C4\uC9DC \uC798\uD588\uB2E4\uACE0 \uB9D0\uD574 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729298
    m_Localized: "{0}: \uB3C4\uD604\uC544. \uC774\uAC70 \uC5B4\uB978\uB4E4\uB3C4 \uBABB \uD574. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729299
    m_Localized: "\uB3C4\uD604\uC740 \uADC0\uAE4C\uC9C0 \uBE68\uAC1C\uC838\uC11C \uACF5\uCC45\uC744 \uB36E\uC5C8\uB2E4\uAC00, \uB2E4\uC2DC \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117932
    m_Localized: "{0}: \uAE09\uC2DD. \uB108 \uC774\uC81C \uAE09\uC2DD\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117933
    m_Localized: "\uAE09\uC2DD\uC740 \uB300\uB2F5 \uB300\uC2E0 \uD558\uD488\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117934
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE09\uC2DD\uC774\uB77C\uB2C8. \uC791\uBA85 \uC13C\uC2A4\uAC00\u2026 \uC544\uB2C8\uB2E4, \uC88B\uB2E4. \uC798 \uC5B4\uC6B8\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117935
    m_Localized: "\uC624\uB298\uC740 \uADF8\uB0E5 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729300
    m_Localized: "\uB3C4\uD604: \u2026\uD615\uC774 \uB9E8\uB0A0 \uC800\uBCF4\uACE0 \uC0B0\uB9CC\uD558\uB2E4\uACE0 \uD588\uAC70\uB4E0\uC694. \uADF8 \uD615\uD55C\uD14C\uB3C4 \uBCF4\uC5EC \uC8FC\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729301
    m_Localized: "\uD574 \uC9C8 \uB158, \uB3C4\uD604\uC774 \uAD50\uBB38 \uC55E\uC5D0\uC11C \uB098\uB97C \uBD88\uB800\uB2E4. \uC190\uC5D0 \uD30C\uB780 \uCC9C \uC870\uAC01\uC774 \uC788\uC5C8\uB2E4. \uAE38\uAC8C \uCC22\uC740 \uCCB4\uC721\uBCF5 \uC548\uAC10\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729302
    m_Localized: "\uAD50\uBB38 \uCC3D\uC0B4\uC5D0 \uBC8C\uC368 \uB9AC\uBCF8 \uBA87 \uAC1C\uAC00 \uB9E4\uC5EC \uC788\uC5C8\uB2E4. \uBE44\uC5D0 \uBC14\uB798\uC11C \uD558\uB298\uC0C9\uC774 \uB41C \uAC83\uB3C4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729303
    m_Localized: "\uB3C4\uD604: \uC5C4\uB9C8\uB791 \uC57D\uC18D\uD55C \uAC70\uC608\uC694. \uD5E4\uC5B4\uC9C0\uBA74 \uD30C\uB780 \uB9AC\uBCF8. \uC0B4\uC544 \uC788\uC73C\uBA74 \uADF8 \uADFC\uCC98\uC5D0 \uC788\uB2E4\uB294 \uB73B."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729304
    m_Localized: "\uB3C4\uD604: \uC5C4\uB9C8\uAC00 \uC9C0\uB098\uAC00\uB2E4 \uBCF4\uBA74 \uC54C \uAC70\uC608\uC694. \uC5EC\uAE30 \uC788\uB2E4\uB294 \uAC70. \uC544\uC9C1 \uC0B4\uC544 \uC788\uB2E4\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729305
    m_Localized: "\uB9E4\uB4ED\uC774 \uC790\uAFB8 \uD480\uB838\uB2E4. \uC190\uC774 \uB5A8\uB824\uC11C\uC600\uB2E4. \uCD94\uC6CC\uC11C\uB294 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729306
    m_Localized: "\uB3C4\uD604: \uB204\uB098, \uC5EC\uAE30 \uC880 \uC7A1\uC544 \uC904\uB798\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729307
    m_Localized: "\uB9E4\uB4ED \uB05D\uC744 \uC7A1\uC544 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729308
    m_Localized: "\uB0B4\uAC00 \uD55C\uCABD \uB05D\uC744 \uC7A1\uACE0, \uB3C4\uD604\uC774 \uB2E8\uB2E8\uD788 \uBB36\uC5C8\uB2E4. \uB450 \uBC88, \uC138 \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729309
    m_Localized: "\uB3C4\uD604: \uC774\uAC74 \uC548 \uD480\uB824\uC694. \uBC14\uB78C \uBD88\uC5B4\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563802
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC785\uC744 \uC5F4\uC5C8\uB2E4\uAC00, \uB2E4\uC2DC \uB2E4\uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117936
    m_Localized: "\uBA39\uC744 \uAC83\uC774 \uB109\uB109\uD558\uC9C0 \uC54A\uC558\uB2E4. \uACE0\uC591\uC774\uB294 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00, \uC11C\uC6B4\uD558\uB2E4\uB294 \uB4EF \uB3CC\uC544\uC11C \uB2F4\uC7A5 \uB108\uBA38\uB85C \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826575
    m_Localized: "\uC591\uB3D9\uC774\uAC00 \uAE08\uBC29 \uCC3C\uB2E4. \uC815\uC218\uD558\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117938
    m_Localized: "\uBC24\uB2A6\uAC8C \uCC3D\uBB38 \uCABD\uC5D0\uC11C \uAE01\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC2EC\uC7A5\uC774 \uB0B4\uB824\uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117939
    m_Localized: "\uC190\uC804\uB4F1\uC744 \uBE44\uCD94\uC790, \uCC3D\uD2C0 \uD2C8\uC5D0 \uC0BC\uC0C9 \uD138\uC774 \uB07C\uC5B4 \uC788\uC5C8\uB2E4. \uAE09\uC2DD\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729310
    m_Localized: "\uB3CC\uC544\uC11C\uB294 \uB3C4\uD604\uC758 \uAC78\uC74C\uC774, \uC62C \uB54C\uBCF4\uB2E4 \uC870\uAE08 \uAC00\uBCBC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729311
    m_Localized: "\uD558\uB098 \uB354 \uBB36\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729312
    m_Localized: "{0}: \uD558\uB098 \uB354 \uBB36\uC790. \uD615 \uBAAB\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729313
    m_Localized: "\uB3C4\uD604\uC740 \uB300\uB2F5 \uB300\uC2E0 \uCC9C\uC744 \uD55C \uBC88 \uB354 \uCC22\uC5C8\uB2E4. \uB450 \uB9AC\uBCF8\uC774 \uB098\uB780\uD788 \uCC3D\uC0B4\uC5D0\uC11C \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460236
    m_Localized: "\uADF8\uB7F0\uB370 \uBC1C\uC774 \uBA48\uCDC4\uB2E4. \uC65C\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4. \uB4F1 \uB4A4\uC758 \uAE38\uC774 \uAC11\uC790\uAE30 \uAD81\uAE08\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460235
    m_Localized: "\uAD50\uBB38 \uAE30\uB465\uC5D0 \uC190\uC774 \uB2FF\uC558\uB2E4. \uB4E4\uC5B4\uAC00\uAE30\uB9CC \uD558\uBA74 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729314
    m_Localized: "\uB3C4\uD604: \u2026\uD615\uC740 \uD30C\uB780\uC0C9 \uC2EB\uC5B4\uD588\uB294\uB370. \uADF8\uB798\uB3C4 \uBD10 \uC8FC\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729315
    m_Localized: "\uBC24 \uB2F9\uBC88 \uCC28\uB840\uC600\uB2E4. \uBB38 \uC55E\uC5D0 \uAC00 \uBCF4\uB2C8 \uC758\uC790\uC5D0 \uBC8C\uC368 \uB204\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uB2F4\uC694\uB97C \uB458\uB7EC\uC4F4 \uB3C4\uD604\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729316
    m_Localized: "\uBB34\uB98E \uC704\uC5D0 \uB098\uBB34 \uBC29\uB9DD\uC774, \uC190\uBAA9\uC5D0\uB294 \uAE61\uD1B5 \uC904 \uB05D\uC774 \uBB36\uC5EC \uC788\uC5C8\uB2E4. \uC904\uC774 \uD754\uB4E4\uB9AC\uBA74 \uBC14\uB85C \uC54C \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117940
    m_Localized: "\uBE44\uC5D0 \uC816\uC740 \uBAB8\uC73C\uB85C, \uB4E4\uC5EC\uBCF4\uB0B4 \uB2EC\uB77C\uB294 \uB4EF \uC720\uB9AC\uC5D0 \uC774\uB9C8\uB97C \uAFB9 \uB300\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117941
    m_Localized: "\uCC3D\uC744 \uC5F4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117942
    m_Localized: "\uAE09\uC2DD\uC740 \uB4E4\uC5B4\uC624\uC790\uB9C8\uC790 \uBAB8\uC744 \uD138\uC5B4 \uBB3C\uBC29\uC6B8\uC744 \uC0AC\uBC29\uC5D0 \uD280\uACBC\uB2E4. \uADF8\uB7EC\uACE0\uB294 \uB0B4 \uCE68\uB0AD \uC704\uC5D0 \uB2F9\uC5F0\uD558\uB2E4\uB294 \uB4EF \uBAB8\uC744 \uB9D0\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117943
    m_Localized: "{0}: \uAC70\uAE30 \uB0B4 \uC790\uB9AC\uC778\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729317
    m_Localized: "\uB3C4\uD604: \uC624\uB298\uC740 \uC81C\uAC00 \uC124\uAC8C\uC694. \uB204\uB098 \uC5B4\uC81C\uB3C4 \uB098\uAC14\uB2E4 \uC654\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563803
    m_Localized: "\uB300\uB2F5\uC740 \uD544\uC694 \uC5C6\uC5C8\uB2E4. \uC774 \uB9D0\uC740 \uADF8 \uC560\uAC00 \uC544\uB2C8\uB77C \uB098\uB97C \uC704\uD55C \uAC70\uC600\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563804
    m_Localized: "{0}: \uC774\uC81C \uAC08\uAC8C. \uAC01\uC790 \uC0B4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729318
    m_Localized: "{0}: \uB108 \uC544\uC9C1 \uC911\uD559\uC0DD\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729319
    m_Localized: "\uB3C4\uD604: \uC54C\uC544\uC694. \uADFC\uB370 \uCC98\uC74C\uC5D0 \uB204\uB098\uAC00 \uBB38 \uC5F4\uC5B4 \uC92C\uC796\uC544\uC694. \uADF8\uB54C \uC800 \uC9C4\uC9DC \uC8FD\uB294 \uC904 \uC54C\uC558\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729320
    m_Localized: "\uB3C4\uD604: \uADF8 \uB4A4\uB85C \uB9E8\uB0A0 \uB204\uB098\uAC00 \uC9C0\uCF30\uC5B4\uC694. \uC774\uBC88\uC5D4 \uC81C\uAC00 \uC9C0\uD0AC\uAC8C\uC694. \uC18C\uB9AC \uD558\uB098\uB3C4 \uC548 \uB193\uCCD0\uC694. \uC800 \uADC0 \uC88B\uC740 \uAC70 \uC54C\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729321
    m_Localized: "\uB3C4\uD604\uC758 \uB208\uC774 \uBC18\uC9DD\uC600\uB2E4. \uBB34\uC11C\uC6C0\uC744 \uAFB9 \uB20C\uB7EC \uB454 \uB208\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729322
    m_Localized: "\uB9E1\uAE30\uACE0 \uB530\uB73B\uD55C \uBB3C\uC744 \uAC74\uB128\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729323
    m_Localized: "\uB530\uB73B\uD55C \uBB3C \uD55C \uCEF5\uC744 \uC190\uC5D0 \uC950\uC5EC \uC8FC\uC5C8\uB2E4. \uB3C4\uD604\uC740 \uB450 \uC190\uC73C\uB85C \uBC1B\uACE0, \uBB38 \uCABD\uC73C\uB85C \uB2E4\uC2DC \uBAB8\uC744 \uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806670729324
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB098\uB294 \uC624\uB79C\uB9CC\uC5D0 \uAE68\uC9C0 \uC54A\uACE0 \uC7A4\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uB3C4\uD604\uC758 \uACF5\uCC45\uC5D0 \uC0C8 \uC904\uC774 \uBE7C\uACE1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117944
    m_Localized: "\uB300\uB2F5\uC774 \uC5C6\uC5C8\uB2E4. \uADF8\uB0A0 \uBC24 \uB098\uB294 \uCE68\uB0AD \uB044\uD2B8\uBA38\uB9AC\uC5D0\uC11C \uC7A4\uB2E4. \uC774\uC0C1\uD558\uAC8C \uC798 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563805
    m_Localized: "\uB3CC\uC544\uC11C\uB294 \uB4F1 \uB4A4\uB85C \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uCC98\uC74C\uC73C\uB85C, \uADF8 \uCE68\uBB35\uC774 \uB0B4 \uBAAB\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117945
    m_Localized: "\uADF8 \uB4A4\uB85C \uAE09\uC2DD\uC740 \uAC70\uCC98\uB97C \uC81C \uC9D1\uCC98\uB7FC \uB3CC\uC544\uB2E4\uB154\uB2E4. \uBC25\uB54C\uB97C \uC54C\uB9AC\uB294 \uAC74 \uB298 \uAE09\uC2DD\uC774 \uBA3C\uC800\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174983
    m_Localized: "\uB3C4\uC11C\uAD00\uBD80\uD130. \uCC45\uC774 \uD544\uC694\uD574\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117946
    m_Localized: "\uCC3D\uC744 \uC5F4\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923520
    m_Localized: "\uADF8\uB7FC \uB458\uC774 \uAC19\uC774 \uC11C\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923521
    m_Localized: "{0}: \uADF8\uB7FC \uBC18\uBC18. \uB124\uAC00 \uC55E, \uB0B4\uAC00 \uB4A4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923522
    m_Localized: "\uB3C4\uD604\uC774 \uC6C3\uC5C8\uB2E4. \uB458\uC774\uC11C \uBB38\uC744 \uB4F1\uC9C0\uACE0 \uC549\uC544, \uC904\uC774 \uD754\uB4E4\uB9B4 \uB54C\uB9C8\uB2E4 \uB3D9\uC2DC\uC5D0 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923523
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB3C4\uD604\uC774 \uAFB8\uBC85 \uC878\uC558\uB2E4. \uB098\uB294 \uAE68\uC6B0\uC9C0 \uC54A\uC558\uB2E4. \uC904\uC740 \uB0B4\uAC00 \uC7A1\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923524
    m_Localized: "(\uB3C4\uD604\uC5D0\uAC8C '\uBC24\uB208'\uC774 \uC0DD\uACBC\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923525
    m_Localized: "\uB3C4\uC11C\uC2E4 \uC11C\uAC00 \uC0AC\uC774, \uBC14\uB2E5\uC5D0 \uC1A1\uC608\uC9C0\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uC791\uC740 \uC218\uCCA9\uC5D0 \uC5F0\uD544\uC774 \uC0AC\uAC01\uC0AC\uAC01 \uC6C0\uC9C1\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923526
    m_Localized: "\uB0B4 \uBC1C\uC18C\uB9AC\uC5D0 \uC608\uC9C0\uAC00 \uC218\uCCA9\uC744 \uB36E\uC73C\uB824\uB2E4, \uB2A6\uC5C8\uB2E4. \uD3BC\uCCD0\uC9C4 \uCABD\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923527
    m_Localized: "\uB2F4\uC694\uB97C \uB36E\uACE0 \uB098\uB780\uD788 \uB204\uC6B4 \uC0AC\uB78C\uB4E4. \uC5BC\uAD74\uC740 \uADF8\uB9AC\uC9C0 \uC54A\uACE0 \uC5B4\uAE68\uC640 \uBA38\uB9AC\uCE74\uB77D\uB9CC. \uADF8\uB798\uB3C4 \uB204\uAC00 \uB204\uAD70\uC9C0 \uB2E4 \uC54C \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117947
    m_Localized: "\uC5EC\uAE30\uB294 \uC0AC\uB78C\uC774 \uBC84\uD2F0\uB294 \uACF3\uC774\uB2E4. \uACE0\uC591\uC774\uAE4C\uC9C0 \uC9C0\uCF1C \uC904 \uC790\uC2E0\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117948
    m_Localized: "\uAE09\uC2DD\uC740 \uD55C\uCC38 \uCC3D\uD2C0\uC5D0 \uC549\uC544 \uC788\uB2E4\uAC00 \uC0AC\uB77C\uC84C\uB2E4. \uB2E4\uC74C \uB0A0 \uC544\uCE68, \uCC3D\uD2C0\uC5D0 \uC791\uC740 \uBC1C\uC790\uAD6D\uB9CC \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826574
    m_Localized: "\uC57D\uC740 \uB354 \uC544\uD50C \uB54C\uB97C \uC704\uD574 \uB0A8\uACA8 \uB450\uC5C8\uB2E4. \uAE34 \uBC24\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117950
    m_Localized: "\uBC29\uC1A1\uBC18 \uC9C4\uC5F4\uC7A5\uC758 \uB9C8\uC9C0\uB9C9 \uCE78\uC5D0 CD\uB97C \uAF42\uC558\uB2E4. \uC5EC\uB35F \uCE78\uC774 \uAF49 \uCC3C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923528
    m_Localized: "\uB9E8 \uB05D, \uC774\uBD88\uC744 \uAC77\uC5B4\uCC2C \uC791\uC740 \uC0AC\uB78C\uC774 \uB3C4\uD604\uC774\uC5C8\uB2E4. \uBC1C \uBAA8\uC591\uB9CC \uBD10\uB3C4 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923529
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uC5BC\uAD74\uC740 \uC548 \uADF8\uB838\uC5B4. \uD5C8\uB77D \uC548 \uBC1B\uC558\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923530
    m_Localized: "\uC1A1\uC608\uC9C0: \uB2E4\uB4E4 \uC790\uB294 \uAC70 \uBCF4\uBA74 \uADF8\uB9AC\uACE0 \uC2F6\uC5B4\uC838. \uADF8 \uC2DC\uAC04\uC5D4 \uC544\uBB34\uB3C4 \uC548 \uBB34\uC11C\uC6CC \uBCF4\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923531
    m_Localized: "\uB354 \uBCF4\uC5EC \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923532
    m_Localized: "{0}: \uB2E4\uB978 \uAC83\uB3C4 \uC788\uC5B4? \uBCF4\uACE0 \uC2F6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563806
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uD559\uAD50\uC5D0 \uC628 \uCCAB\uB0A0 \uBC24. \uC544\uBB34\uB3C4 \uADF8 \uC560 \uC606\uC5D0 \uC549\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923533
    m_Localized: "\uC608\uC9C0\uB294 \uD55C\uCC38 \uB9DD\uC124\uC774\uB2E4 \uC218\uCCA9\uC744 \uB118\uACBC\uB2E4. \uCC3D\uBC16\uC758 \uD558\uB298, \uB053\uB294 \uB0C4\uBE44, \uB204\uAD70\uAC00\uC758 \uB4B7\uBAA8\uC2B5. \uC0AC\uB78C \uC5C6\uB294 \uCABD\uC774 \uB354 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923534
    m_Localized: "\uC1A1\uC608\uC9C0: \uC774\uB7F0 \uAC70 \uBCF4\uC5EC \uC900 \uAC70, \uCC98\uC74C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117951
    m_Localized: "\uC878\uC5C5 \uBC29\uC1A1, \uC0C8\uBCBD \uD3B8\uC758\uC810, \uC57D\uAD6D, \uC625\uD0D1 \uD569\uC8FC\uC2E4, \uC6D4\uC694\uC77C \uC544\uCE68 \uC5F4\uCC28, \uB9C8\uD2B8\uC758 \uC624\uD6C4, \uAD50\uB300 \uB05D\uB09C \uC21C\uACBD, \uADF8\uB9AC\uACE0 \"\uC544\uBE60 \uD798\uB0B4\"."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117952
    m_Localized: "\uD55C \uBC88\uB3C4 \uB9CC\uB09C \uC801 \uC5C6\uB294 \uC5EC\uB35F \uC0AC\uB78C\uC758 \uC74C\uC545\uC774 \uD55C \uC120\uBC18\uC5D0 \uB098\uB780\uD788 \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117953
    m_Localized: "\uC774 \uC0AC\uB78C\uB4E4\uC774 \uC5B4\uB514\uC5D0 \uC788\uB294\uC9C0\uB294 \uBAA8\uB978\uB2E4. \uADF8\uB798\uB3C4 \uB178\uB798\uB294 \uC5EC\uAE30 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117954
    m_Localized: "\uD63C\uC790 \uCC98\uC74C\uBD80\uD130 \uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923535
    m_Localized: "\uBABB \uBCF8 \uCC99 \uCC45\uC744 \uACE0\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923536
    m_Localized: "\uB098\uB294 \uC11C\uAC00 \uCABD\uC73C\uB85C \uBAB8\uC744 \uB3CC\uB824 \uC544\uBB34 \uCC45\uC774\uB098 \uBF51\uC558\uB2E4. \uB4F1 \uB4A4\uC5D0\uC11C \uC5F0\uD544 \uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923537
    m_Localized: "\uB098\uAC00\uB824\uB294\uB370 \uC608\uC9C0\uAC00 \uC791\uAC8C \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923538
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uACE0\uB9C8\uC6CC. \uBAA8\uB978 \uCC99\uD574 \uC918\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923539
    m_Localized: "\uC1A1\uC608\uC9C0: \uBD80\uD0C1\uC774 \uC788\uC5B4. \uC2ED \uBD84\uB9CC \uAC00\uB9CC\uD788 \uC549\uC544 \uC788\uC5B4 \uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923540
    m_Localized: "\uC608\uC9C0\uAC00 \uD070 \uC2A4\uCF00\uCE58\uBD81\uC744 \uBB34\uB98E\uC5D0 \uC138\uC6E0\uB2E4. \uB098\uB294 \uCC3D\uAC00 \uC758\uC790\uC5D0 \uC549\uC558\uB2E4. \uC190\uC744 \uC5B4\uB514 \uB46C\uC57C \uD560\uC9C0 \uBAB0\uB77C \uBB34\uB98E \uC704\uC5D0 \uACB9\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563807
    m_Localized: "\uADF8 \uC560\uB294 \uC790\uAE30 \uBAAB\uC758 \uBC25\uC744 \uBC18\uB9CC \uBA39\uACE0 \uB098\uBA38\uC9C0\uB97C \uB3C4\uB85C \uB0C4\uBE44\uC5D0 \uBD80\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757743
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC67C\uCABD \uCC3D. \uADF8\uB2E4\uC74C \uB4B7\uBB38. \uC5EC\uAE30\uC11C\uB294 \uB2E4 \uB4E4\uB824. \uB0B4\uAC00 \uADC0\uAC00 \uB3FC \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757744
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC624\uB298\uC740 \uB098\uB3C4 \uBB38 \uC55E\uC5D0 \uC11C\uACA0\uB2E4. \uB9D0\uB9AC\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923541
    m_Localized: "\uC1A1\uC608\uC9C0: \uC5BC\uAD74, \uADF8\uB824\uB3C4 \uB3FC? \uC774\uBC88\uC5D4 \uD5C8\uB77D\uBC1B\uACE0 \uC2F6\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923542
    m_Localized: "\uC5F0\uD544\uC774 \uC624\uB798 \uC6C0\uC9C1\uC600\uB2E4. \uC608\uC9C0\uB294 \uB098\uB97C \uBCF4\uB2E4\uAC00, \uC885\uC774\uB97C \uBCF4\uB2E4\uAC00, \uB2E4\uC2DC \uB098\uB97C \uBCF4\uC558\uB2E4. \uADF8\uB3D9\uC548 \uD55C \uBC88\uB3C4 \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923543
    m_Localized: "\uC1A1\uC608\uC9C0: \uC608\uC804\uC5D4 \uB108 \uC5BC\uAD74 \uB611\uBC14\uB85C \uBABB \uBD24\uC5B4. \uCC3D\uACE0 \uC77C \uB54C\uBB38\uC5D0. \u2026\uC9C0\uAE08\uC740 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923544
    m_Localized: "\uC1A1\uC608\uC9C0: \uC0DD\uAC01\uBCF4\uB2E4 \uB9CE\uC774 \uC6C3\uB294\uB2E4, \uB108. \uADF8\uB824 \uBCF4\uB2C8\uAE4C \uC54C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117955
    m_Localized: "\uBD88\uC744 \uB044\uACE0 \uD50C\uB808\uC774\uC5B4\uB97C \uBB34\uB98E\uC5D0 \uC62C\uB838\uB2E4. \uCCAB \uACE1\uC758 \uD53C\uC544\uB178\uAC00 \uAD50\uC815\uC758 \uBD04\uC744 \uB370\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117956
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uACE1\uC758 \uC624\uB974\uACE8\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0, \uB098\uB294 \uC544\uBB34 \uC0DD\uAC01\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117957
    m_Localized: "\uB2E4 \uAC19\uC774 \uB4E4\uC73C\uB7EC \uC624\uB77C\uACE0 \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117958
    m_Localized: "\uBC29\uC1A1\uBC18 \uBC14\uB2E5\uC5D0 \uB2E4\uB4E4 \uB458\uB7EC\uC549\uC558\uB2E4. \uB204\uAD6C\uB294 \uB9E4\uC7A5 \uC74C\uC545\uC5D0\uC11C \uC6C3\uC5C8\uACE0, \uB204\uAD6C\uB294 \uB3D9\uC694\uC5D0\uC11C \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174890
    m_Localized: "\uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790 \uADF8 \uC560\uAC00 \uBB34\uB98E \uC704\uC758 \uACF5\uCC45\uC744 \uB36E\uC5C8\uB2E4. \uB36E\uB294 \uBC14\uB78C\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uBBF8\uB044\uB7EC\uC838 \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592000
    m_Localized: "{0}: (4\uC77C\uC9F8) \uC57C, \uB108 \uD639\uC2DC \uD559\uAD50\uC5D0 \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592001
    m_Localized: "{0}: (5\uC77C\uC9F8) {1} \uC81C\uBC1C \uB2F5\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174964
    m_Localized: "\uC5F4\uB300\uC57C\uC600\uB2E4. \uCC3D\uBB38\uC744 \uC5F4\uBA74 \uBAA8\uAE30\uAC00, \uB2EB\uC73C\uBA74 \uC228\uC774 \uB9C9\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980572
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAA8\uB974\uC9C0. \uC2DC\uC778\uB3C4 \uB0A0\uC9DC\uB294 \uC548 \uC801\uC5B4 \uB1A8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980571
    m_Localized: "{0}: \uADF8 \uBD04\uC740, \uC5B8\uC81C \uC640\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980570
    m_Localized: "\uC2DC\uAC00 \uB05D\uB098\uACE0\uB3C4 \uD55C\uB3D9\uC548 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980569
    m_Localized: "\uAC00\uB9CC\uD788 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923545
    m_Localized: "\uB2E4 \uADF8\uB9B4 \uB54C\uAE4C\uC9C0 \uAC00\uB9CC\uD788 \uC788\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923546
    m_Localized: "\uC2ED \uBD84\uC774 \uC0BC\uC2ED \uBD84\uC774 \uB418\uC5C8\uB2E4. \uD574\uAC00 \uAE30\uC6B8\uC5B4 \uADF8\uB9BC\uC790\uAC00 \uBC14\uB00C\uC790 \uC608\uC9C0\uAC00 \uD600\uB97C \uCC3C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923547
    m_Localized: "\uC1A1\uC608\uC9C0: \uB0B4\uC77C \uB610 \uC549\uC544. \uBE5B\uC774 \uB2EC\uB77C\uC84C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923548
    m_Localized: "\uB2E4\uC74C \uB0A0 \uB098\uB294 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC549\uC558\uB2E4. \uC608\uC9C0\uB294 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC5F0\uD544\uC744 \uAE4E\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923549
    m_Localized: "\uB098\uB3C4 \uB108\uB97C \uADF8\uB824 \uBCF4\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923550
    m_Localized: "{0}: \uB2E4\uC74C\uC5D4 \uB0B4\uAC00 \uADF8\uB9B4\uAC8C. \uB108 \uC549\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923551
    m_Localized: "\uB0B4\uAC00 \uADF8\uB9B0 \uC608\uC9C0\uB294 \uAC10\uC790 \uAC19\uC558\uB2E4. \uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC11C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923552
    m_Localized: "\uC1A1\uC608\uC9C0: \uC774\uAC70 \uBC84\uB9AC\uC9C0 \uB9C8. \uB0B4\uAC00 \uAC00\uC9C8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923553
    m_Localized: "\uBC24, \uC77C\uAE30\uB97C \uC4F0\uB294\uB370 \uC608\uC9C0\uAC00 \uB4F1\uC744 \uB9DE\uB300\uACE0 \uC549\uC558\uB2E4. \uB298 \uD558\uB358 \uAC83\uCC98\uB7FC. \uB9D0\uC744 \uAC78\uC9C0 \uC54A\uACE0, \uADF8\uB0E5 \uAC70\uAE30 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923554
    m_Localized: "\uD55C\uCC38 \uB4A4\uC5D0 \uC608\uC9C0\uAC00 \uB0B4 \uC190\uC5D0 \uBB54\uAC00\uB97C \uC950\uC5EC \uC8FC\uC5C8\uB2E4. \uCC9C \uC870\uAC01\uC744 \uAFF0\uB9E4 \uB9CC\uB4E0 \uC791\uC740 \uD0A4\uB9C1\uC774\uC5C8\uB2E4. \uBCC4 \uBAA8\uC591, \uBC14\uB290\uC9C8\uC774 \uC090\uB6A4\uC090\uB6A4\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923555
    m_Localized: "\uC1A1\uC608\uC9C0: \uB450 \uAC1C \uB9CC\uB4E4\uC5C8\uC5B4. \uD558\uB098\uB294 \uB0B4 \uAC00\uBC29\uC5D0 \uB2EC\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923556
    m_Localized: "\uC1A1\uC608\uC9C0: \uC608\uC804\uC5D0 \uD558\uB9B0\uC774\uB791 \uB9DE\uCD98 \uAC70 \uC788\uC5C8\uAC70\uB4E0. \uADF8\uAC74 \uBC84\uB838\uC5B4. \uC774\uAC74\u2026 \uB0B4\uAC00 \uC815\uD55C \uAC70\uC57C. \uB204\uAD6C \uC606\uC5D0 \uC788\uC744\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923557
    m_Localized: "\uC1A1\uC608\uC9C0: \uD560 \uB9D0\uC740 \uC5C6\uC5B4. \uADF8\uB0E5 \uB124\uAC00 \uD798\uB4E4\uC5B4 \uBCF4\uC774\uBA74, \uC606\uC5D0 \uC549\uC544 \uC788\uC744\uAC8C. \uADF8\uAC74 \uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923558
    m_Localized: "\uBCF5\uB3C4 \uB05D\uC5D0\uC11C \uD558\uB9B0\uC774 \uC774\uCABD\uC744 \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4. \uC608\uC9C0\uB294 \uADF8\uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4. \uD53C\uD558\uB294 \uAC8C \uC544\uB2C8\uB77C, \uADF8\uB0E5 \uC5EC\uAE30\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980505
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBCF4\uACE0 \uC2F6\uC5B4\uC9C0\uBA74 \uB9D0\uD574. \uBB38\uC81C\uB294 \uC548 \uBC14\uAFC0 \uAC70\uC57C. \uBBF8\uB9AC \uBD10\uB3C4 \uBAA8\uB978 \uCC99\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980504
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2DC\uD5D8\uC9C0\uB97C \uBC18\uC73C\uB85C \uC811\uC5B4 \uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174814
    m_Localized: "\uC2E0\uD638\uB4F1 \uC544\uB798 \uBC84\uC2A4 \uC815\uB958\uC7A5\uC5D0, \uBE44\uB3C4 \uC548 \uC624\uB294\uB370 \uC6B0\uBE44\uB97C \uC785\uC740 \uC0AC\uB78C \uC14B\uC774 \uC549\uC544 \uC788\uC5C8\uB2E4. \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706457
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC70\uC57C. \uC74C\uC545\uC740 \uAC19\uC774 \uB9DE\uCD94\uB294 \uAC70\uC57C. \uD06C\uAC8C \uC548 \uD574\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706456
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC138\uC0C1\uC774 \uC774\uB807\uAC8C \uB410\uB294\uB370, \uBB3C\uC740 \uC5EC\uC804\uD788 100\uB3C4\uC5D0 \uB053\uC796\uC544. \uC548 \uBC14\uB00C\uB294 \uAC8C \uC788\uB2E4\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706455
    m_Localized: "{0}: \uC65C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706454
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \"\uBB3C\uC740 1\uAE30\uC555\uC5D0\uC11C 100\uB3C4\uC5D0 \uB053\uB294\uB2E4.\" \u2026\uC774 \uBB38\uC7A5, \uC0DD\uAC01\uBCF4\uB2E4 \uB4E0\uB4E0\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826534
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC798 \uD0C8 \uAC70\uC57C. \uC774\uBC88 \uACA8\uC6B8\uC5D4 \uC774\uAC8C \uB354 \uC4F8\uBAA8 \uC788\uC744\uC9C0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980568
    m_Localized: "\uC790\uAE30 \uC804\uC5D0 \uC18D\uC73C\uB85C \uD55C \uBC88 \uB354 \uC678\uC6E0\uB2E4. \uB2E4\uC74C \uC904\uB3C4 \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174963
    m_Localized: "\uC625\uC0C1 \uD143\uBC2D\uC758 \uC0C1\uCD94\uAC00 \uBCD5\uC744 \uBC1B\uC544 \uBC18\uC9DD\uC600\uB2E4. \uC6B0\uB9AC\uAC00 \uB418\uCC3E\uC740 \uB4E4\uC740 \uC544\uC9C1 \uC774 \uC815\uB3C4\uB2E4. \uADF8\uB798\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980567
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uB294 \uADF8\uB807\uAC8C \uB0A8\uB294 \uAC70\uC57C. \uC885\uC774\uAC00 \uC5C6\uC5B4\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980566
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB410\uB2E4. \uC774\uC81C \uC774 \uC2DC\uB97C \uC678\uC6B0\uB294 \uC0AC\uB78C\uC774 \uC5EC\uAE30 \uB458\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592002
    m_Localized: "{0}: (6\uC77C\uC9F8) \uBC30\uD130\uB9AC \uC5BC\uB9C8 \uC548 \uB0A8\uC558\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592003
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68, \uC2E0\uD638\uAC00 \uBC14\uB00C\uC790\uB9C8\uC790 \uBA3C\uC800 \uAC74\uB10C \uD6A1\uB2E8\uBCF4\uB3C4\uAC00 \uB5A0\uC62C\uB790\uB2E4. {0} \uB4A4\uC5D0 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980565
    m_Localized: "\uB450 \uBC88 \uB9CC\uC5D0 \uC678\uC6E0\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uBF09\uC744 \uCE58\uB824\uB2E4 \uC18C\uB9AC \uB0A0\uAE4C \uBD10 \uD5C8\uACF5\uC5D0\uC11C \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369215
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC790\uAE30 \uD314\uC744 \uB0B4\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369214
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uAD50\uACFC\uC11C\uB294 \uB36E\uC5B4. \uC190\uC73C\uB85C \uBC30\uC6B0\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174929
    m_Localized: "\uB0A8\uC740 \uC2DD\uB7C9\uC740 \uC77C\uC8FC\uC77C\uC744 \uBC84\uD2F0\uAE30\uB3C4 \uBE60\uB4EF\uD588\uB2E4. \uB2E4\uB4E4 \uB098\uB97C \uBCF4\uC558\uB2E4. \uC120\uC0DD\uB2D8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591912
    m_Localized: "\uB2E4\uC74C \uC2DC\uAC04\uB3C4 \uAE30\uB300\uD560\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591911
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uACE0\uB9C8\uC6CC. \uC624\uB79C\uB9CC\uC5D0 \uC0AC\uB78C\uC774 \uC77D\uB294 \uBB38\uC7A5\uC744 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591910
    m_Localized: "\uC77D\uB294 \uB3D9\uC548 \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uB2E4. \uC218\uC5C5\uC744 \uB4E3\uB294 \uCABD\uC740 \uC624\uD788\uB824 \uC120\uC0DD\uB2D8 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591909
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB124 \uC131\uC801\uC740 \uC120\uC0DD\uB2D8\uB3C4 \uC544\uC9C1 \uBAB0\uB77C. \uADF8\uB798\uC11C \uC88B\uC544. \uC624\uB298\uBD80\uD130 \uBCF4\uBA74 \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460314
    m_Localized: "\uC6D0\uB798 \uC774\uB9D8\uB54C\uB294 \uD604\uC7A5\uCCB4\uD5D8\uD559\uC2B5 \uB0A0\uC774\uC5C8\uB2E4. \uAC00\uC815\uD1B5\uC2E0\uBB38\uC5D0\uB294 '\uB3C4\uC2DC\uB77D \uC9C0\uCC38'\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460315
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC218\uC5C5 \uC5C6\uC5B4. \uC18C\uD48D\uC774\uC57C. \uBAA9\uBC1C \uC9DA\uACE0 \uB098\uB3C4 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460316
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uC218\uC5C5 \uC5C6\uC5B4. \uC18C\uD48D\uC774\uC57C. \uB098\uB294 \uCC3D\uAC00\uC5D0\uC11C \uBCFC\uAC8C. \uB2E4\uB140\uC640\uC11C \uB2E4 \uC598\uAE30\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460317
    m_Localized: "\uC8FC\uBA39\uBC25 \uB450 \uAC1C\uC640 \uBB3C \uD55C \uBCD1\uC744 \uAC00\uBC29\uC5D0 \uB123\uC5C8\uB2E4. \uADF8\uAC83\uB9CC\uC73C\uB85C \uAC00\uBC29\uC774 \uC870\uAE08 \uB4E4\uB72C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117959
    m_Localized: "{0}: \uB2E4\uC74C\uC5D4 \uC6B0\uB9AC\uAC00 \uD55C \uC7A5 \uB9CC\uB4E4\uC5B4 \uBCFC\uAE4C. \uC5EC\uAE30\uC11C \uBC84\uD2F4 \uB178\uB798\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826573
    m_Localized: "\uC544\uAE5D\uC9C0\uB9CC, \uC774 \uB354\uC704\uC5D0 \uBC30\uD0C8\uC774 \uB098\uBA74 \uB354 \uD070\uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117961
    m_Localized: "\uAD50\uBB34\uC2E4 \uCE90\uBE44\uB2DB\uC5D0\uC11C \uCC3E\uC740 \uB0A1\uC740 \uC7A5\uAE30\uD310\uACFC \uC737, \uADC0\uD241\uC774\uAC00 \uB2F3\uC740 \uCE74\uB4DC \uD55C \uBC8C. \uC624\uB298 \uBC24\uC740 \uADF8\uAC78\uB85C \uBC84\uD2F0\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117962
    m_Localized: "\uADC0\uAC00\uBD80\uC5D0\uAC8C\uB294 \uCC98\uC74C \uD574 \uBCF4\uB294 \uBC29\uACFC\uD6C4 \uD65C\uB3D9\uC774\uC5C8\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uB098\uC058\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369213
    m_Localized: "\uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592004
    m_Localized: "\uD55C \uBC88\uB9CC \uB3CC\uC544\uBD24\uC73C\uBA74, \uADF8 \uC5BC\uAD74\uC744 \uD55C \uBC88 \uB354 \uBD24\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624592005
    m_Localized: "7\uC77C\uC9F8\uBD80\uD130\uB294, \uC0C8 \uBA54\uC2DC\uC9C0\uAC00 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369212
    m_Localized: "\uAD1C\uCC2E\uC744 \uAC70\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC5EC\uAE30 \uC788\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369211
    m_Localized: "\uBAA8\uB978 \uCC99\uD558\uACE0 \uB3CC\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369210
    m_Localized: "\uC218\uCCA9 \uCCAB \uC7A5\uC5D0 \uB0A0\uC9DC\uC640 \uCCB4\uC628, \uC0C1\uCC98 \uBAA8\uC591\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369209
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB3C\uB9B0 \uC0AC\uB78C \uC911\uC5D0 \uC774\uB807\uAC8C \uBA40\uCA61\uD55C \uACBD\uC6B0\uB294 \uCC98\uC74C \uBD10. \uADF8\uB7EC\uB2C8\uAE4C \uAE30\uB85D\uD574 \uB458 \uAC70\uC57C. \uB9E4\uC8FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369208
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uB9DD\uC124\uC774\uB2E4\uAC00 \uC218\uCCA9\uC744 \uD3BC\uCCD0 \uBCF4\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117963
    m_Localized: "\uC694\uB9AC\uBD80 \uB54C\uCC98\uB7FC \uAC04\uC2DD\uBD80\uD130 \uCC59\uACBC\uB2E4. \uAC74\uBE75 \uD55C \uBD09\uC9C0\uB97C \uC811\uC2DC\uC5D0 \uACE0\uB974\uAC8C \uB098\uB220 \uB2F4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117964
    m_Localized: "\uC720\uB791\uC790\uB294 \uC7A5\uAE30\uD310\uC744 \uBCF4\uC790\uB9C8\uC790 \uB9D0\uC5C6\uC774 \uB9D0\uC744 \uB193\uAE30 \uC2DC\uC791\uD588\uB2E4. \uCC28, \uD3EC, \uB9C8. \uC190\uC774 \uAE30\uC5B5\uD558\uB294 \uC21C\uC11C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923559
    m_Localized: "\uD0A4\uB9C1\uC744 \uAC00\uBC29\uC5D0 \uB2E8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923560
    m_Localized: "\uB450 \uAC00\uBC29\uC774 \uBCBD \uACE0\uB9AC\uC5D0 \uB098\uB780\uD788 \uAC78\uB838\uB2E4. \uAC19\uC740 \uBCC4 \uB450 \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923561
    m_Localized: "\uADF8\uB0A0 \uBC24 \uAFC8\uC744 \uAFB8\uC9C0 \uC54A\uC558\uB2E4. \uB4F1 \uB4A4\uAC00 \uB530\uB73B\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923562
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923563
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC. \uC774\uBC88\uC5D4 \uB124 \uD3B8\uC774\uB77C\uACE0 \uD55C \uAC70, \uC9C4\uC9DC\uC600\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923564
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uC751. \uB2A6\uC5C8\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563658
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC5EC\uAE30 \uB9E4\uC77C \uC640. \uB124\uAC00 \uC788\uB358 \uB370\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563659
    m_Localized: "\uCD5C\uD558\uB9B0: \uBB38 \uB2EB\uD788\uB294 \uC18C\uB9AC, \uB098\uB3C4 \uB4E4\uC5C8\uC5B4. \uADF8\uB0A0 \uBC24\uC5D0 \uC9D1\uC5D0\uC11C. \uC774\uBD88\uC744 \uB4A4\uC9D1\uC5B4\uC368\uB3C4 \uB4E4\uB838\uC5B4. \uC774\uC0C1\uD558\uC9C0. \uB098\uB294 \uBC16\uC5D0 \uC788\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563660
    m_Localized: "\uBB38\uC744 \uC5F4\uC5B4 \uB454 \uCC44 \uC606\uC5D0 \uC549\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563661
    m_Localized: "\uBB38\uC740 \uD65C\uC9DD \uC5F4\uC5B4 \uB450\uC5C8\uB2E4. \uB458\uC774\uC11C \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563508
    m_Localized: "\uC624\uB298 \uBC24\uC740 \uCD1B\uBD88\uC744 \uCF1C\uACE0 \uC9C0\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563507
    m_Localized: "\uB0A0\uC774 \uBC1D\uC73C\uBA74 \uC790\uC7AC\uB97C \uCC59\uACA8 \uC81C\uB300\uB85C \uACE0\uCCD0\uC57C \uD55C\uB2E4. \uADF8\uB54C\uAE4C\uC9C0 \uD559\uAD50\uB294 \uAE5C\uAE5C\uD560 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563506
    m_Localized: "\uC774\uBC88\uC5D4 \uC5F0\uB8CC \uD544\uD130\uC600\uB2E4. \uB208 \uAC10\uACE0\uB3C4 \uCC3E\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563505
    m_Localized: "\uAE30\uB984\uB54C \uBB3B\uC740 \uC190\uC73C\uB85C \uD55C \uC2DC\uAC04. \uACE0\uC7A5 \uB09C \uACF3\uC740 \uCC3E\uC558\uC9C0\uB9CC, \uBC24\uC5D0 \uC190\uC73C\uB85C \uB420 \uC77C\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563504
    m_Localized: "\uC190\uC804\uB4F1\uC744 \uB4E4\uACE0 \uC5B4\uB514\uAC00 \uBB38\uC81C\uC778\uC9C0 \uC0B4\uD3B4\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563503
    m_Localized: "\uC774\uC81C\uB294 \uBA48\uCD9C \uB54C \uB098\uB294 \uC18C\uB9AC\uB9CC \uB4E3\uACE0\uB3C4 \uC5B4\uB514\uAC00 \uBB38\uC81C\uC778\uC9C0 \uB300\uCDA9 \uC54C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563662
    m_Localized: "{0}: \uC5EC\uAE30 \uC774\uC81C \uBB38 \uC548 \uC7A0\uACA8. \uADF8\uAC70 \uD655\uC778\uD558\uB7EC \uC624\uB294 \uAC70\uBA74, \uAC19\uC774 \uC640\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563663
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC5B4 \uC6B8\uC5C8\uB2E4. \uB098\uB294 \uC6B8\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uB05D\uAE4C\uC9C0 \uC606\uC5D0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563664
    m_Localized: "\uC870\uC6A9\uD788 \uBB38\uC744 \uC5F4\uC5B4 \uB450\uACE0 \uB3CC\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563665
    m_Localized: "\uBB38\uC744 \uB05D\uAE4C\uC9C0 \uC5F4\uC5B4 \uB450\uACE0 \uC654\uB2E4. \uADF8 \uC560\uAC00 \uAC70\uAE30\uC11C \uBB34\uC5C7\uC744 \uD655\uC778\uD558\uB294\uC9C0\uB294, \uADF8 \uC560\uC758 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563666
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uBA3C\uC800 \uB9D0\uC744 \uAC78\uC5B4\uC654\uB2E4. \uCC98\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563667
    m_Localized: "\uCD5C\uD558\uB9B0: \uB9C8\uD2B8\uC5D0 \uC788\uC744 \uB54C \uB4E4\uC740 \uAC8C \uC788\uC5B4. \uC624 \uC528 \uC544\uC800\uC528. \uC57D\uC744 \uB530\uB85C \uC228\uACA8 \uB46C. \uCC3D\uACE0 \uB4A4 \uB0C9\uB3D9\uACE0 \uC548\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563668
    m_Localized: "\uCD5C\uD558\uB9B0: \uC815 \uBC18\uC7A5\uC740 \uBAB0\uB77C. \uACA8\uC6B8 \uB418\uBA74 \uADF8\uAC78\uB85C \uC0AC\uB78C\uB4E4 \uC904 \uC138\uC6B8 \uAC70\uB77C\uACE0, \uC790\uAE30\uB124\uB07C\uB9AC \uADF8\uB7AC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563669
    m_Localized: "\uCD5C\uD558\uB9B0: \uB9D0 \uC548 \uD558\uB824\uACE0 \uD588\uC5B4. \uADFC\uB370 \uC5EC\uAE30\uC11C\uB294\u2026 \uC544\uBB34\uB3C4 \uB204\uAD6C\uB97C \uAC00\uB450\uC9C0 \uC54A\uB294\uB2E4\uBA70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563670
    m_Localized: "\uC815 \uBC18\uC7A5\uC5D0\uAC8C \uBB34\uC804\uC73C\uB85C \uC54C\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563502
    m_Localized: "\uC18C\uB9AC \uD558\uB098\uAC00 \uC5C6\uC5B4\uC84C\uC744 \uBFD0\uC778\uB370 \uD559\uAD50\uAC00 \uD145 \uBE48 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563501
    m_Localized: "\uD55C\uBC24\uC911, \uB298 \uB4E4\uB9AC\uB358 \uB0AE\uC740 \uC6C5\uC6C5 \uC18C\uB9AC\uAC00 \uC0AC\uB77C\uC84C\uB2E4. \uC870\uC6A9\uD574\uC11C \uAE7C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563671
    m_Localized: "\uBB34\uC804\uAE30 \uB108\uBA38\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC774 \uD55C\uCC38 \uC870\uC6A9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563672
    m_Localized: "\uC815 \uBC18\uC7A5: \u2026\uADF8 \uC560\uAC00? \uADF8\uB798. \uACE0\uB9D9\uB2E4\uACE0 \uC804\uD574 \uC918. \uC870\uC6A9\uD788 \uCC98\uB9AC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563673
    m_Localized: "\uC9C0\uAE08\uC740 \uC6B0\uB9AC\uB9CC \uC54C\uACE0 \uC788\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563674
    m_Localized: "{0}: \uC54C\uB824 \uC918\uC11C \uACE0\uB9C8\uC6CC. \uC774\uAC74 \uC6B0\uB9AC\uAC00 \uC950\uACE0 \uC788\uC790. \uD544\uC694\uD560 \uB54C \uC4F0\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563675
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6B0\uB9AC\uB77C\uB294 \uB9D0\uC5D0 \uADF8 \uC560\uAC00 \uC544\uC8FC \uC870\uAE08 \uB180\uB780 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563676
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uADF8 \uC720\uB791\uC790\uAC00 \uC138 \uBC88\uC9F8\uB85C \uB098\uD0C0\uB0AC\uB2E4. \uB4F1\uC5D0 \uBA54\uACE0 \uC788\uB358 \uBC30\uB0AD\uC774 \uB208\uC5D0 \uB744\uAC8C \uAC00\uBCBC\uC6CC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563677
    m_Localized: "\uC720\uB791\uC790: \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB4E4\uB800\uB2E4. \uB0A8\uCABD\uC73C\uB85C \uAC04\uB2E4. \uAD6C\uC870\uB300\uAC00 \uC628\uB2E4\uB294 \uBC29\uC1A1, \uB098\uB3C4 \uB4E4\uC5C8\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563678
    m_Localized: "\uC720\uB791\uC790: \uBC31\uC774\uB77C\uACE0 \uBD88\uB7EC. \uC0B0 \uC548\uB0B4\uC6D0\uC774\uC5C8\uB2E4. \uAE38\uC740 \uC798 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460261
    m_Localized: "{0}: \uC138\uC5B4 \uB450\uBA74 \uB35C \uBB34\uC11C\uC6CC\uC694. \uBAA8\uB974\uB294 \uAC8C \uB354 \uBB34\uC12D\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460260
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB610 \uBCF4\uACE0 \uC788\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460259
    m_Localized: "\uD558\uB098, \uB458\u2026 \uC77C\uACF1. \uC5B4\uC81C\uBCF4\uB2E4 \uB458 \uB9CE\uC558\uB2E4. \uC815\uBB38 \uCABD\uC5D0 \uC14B, \uCCA0\uBD09 \uC606\uC5D0 \uB137."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563679
    m_Localized: "\uBC31: \uC0AC\uAC70\uB9AC \uB188\uB4E4, \uACA8\uC6B8 \uB4E4\uC5B4\uC11C \uC0AC\uB78C\uC774 \uB298\uC5C8\uC5B4. \uB9C8\uC9C0\uB9C9 \uD55C\uD30C \uB54C \uD06C\uAC8C \uD55C \uBC88 \uC62C \uAC70\uB2E4. \uBD81\uCABD \uB2F4\uC7A5\uC774 \uC57D\uD574. \uAC70\uAE30\uBD80\uD130 \uB9C9\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563500
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB610 \uC090\uC84C\uB098 \uBCF4\uB2E4. \uC7E4\uB3C4 \uB354\uC6B4\uAC00 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563499
    m_Localized: "\uC800\uB141\uC744 \uBA39\uB294\uB370 \uD615\uAD11\uB4F1\uC774 \uB450 \uBC88 \uAE5C\uBE61\uC774\uB354\uB2C8 \uAEBC\uC84C\uB2E4. \uBC29\uC1A1\uC2E4 \uCABD \uBC1C\uC804\uAE30 \uC18C\uB9AC\uAC00 \uBA4E\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563680
    m_Localized: "\uBC31: \uBD81\uCABD \uB2F4\uC7A5\uC774 \uC57D\uD574. \uB0B4\uAC00 \uBCF4\uAE30\uC5D4 \uADF8\uB798. \uACA8\uC6B8 \uC624\uAE30 \uC804\uC5D0 \uB9C9\uC544 \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563681
    m_Localized: "\uADF8\uAC00 \uBD81\uCABD \uB2F4\uC7A5\uC744 \uAC00\uB9AC\uD0A4\uBA70, \uC5B4\uB514\uC5D0 \uBB34\uC5C7\uC744 \uB367\uB300\uC57C \uD558\uB294\uC9C0 \uD558\uB098\uD558\uB098 \uC54C\uB824 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563682
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0, \uBB34\uC0AC\uD788 \uAC00\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563683
    m_Localized: "\uBC31\uC740 \uBAA8\uC790\uB97C \uC0B4\uC9DD \uB4E4\uC5B4 \uBCF4\uC600\uB2E4. \uADF8\uB9AC\uACE0 \uB5A0\uB098\uAE30 \uC804\uC5D0, \uD558\uB098\uB9CC \uB354 \uB450\uACE0 \uAC00\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563684
    m_Localized: "\uC5EC\uAE30 \uAC19\uC774 \uC788\uC790\uACE0 \uBD99\uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563685
    m_Localized: "\uBC31: \uACE0\uB9D9\uB2E4. \uADF8 \uB9D0, \uC624\uB798 \uBABB \uB4E4\uC5C8\uB2E4. \uADFC\uB370 \uB098\uB294 \uAC78\uC5B4\uC57C \uC0AC\uB294 \uC0AC\uB78C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563686
    m_Localized: "\uADF8\uB294 \uC6C3\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uBC30\uB0AD\uC744 \uB0B4\uB824\uB193\uC558\uB2E4. \uB5A0\uB098\uAE30 \uC804\uC5D0 \uC904 \uAC8C \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563687
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC544\uCE68\uBD80\uD130 \uB4E4\uB5A0 \uC788\uC5C8\uB2E4. \uCE60\uD310 \uD55C\uAC00\uC6B4\uB370 \uD07C\uC9C1\uD558\uAC8C \uC37C\uB2E4. 10\uC6D4 9\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563688
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uD55C\uAE00\uB0A0. \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uD55C\uD14C\uB294 \uC124\uB0A0 \uAC19\uC740 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563498
    m_Localized: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uB204\uAD70\uAC00 \uC544, \uD558\uACE0 \uC9E7\uAC8C \uD0C4\uC2DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563497
    m_Localized: "\uBC1C\uC804\uAE30\uAC00 \uD138\uD138\uAC70\uB9AC\uB2E4 \uBA48\uCDC4\uB2E4. \uAD50\uC2E4 \uBD88\uC774 \uAEBC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563496
    m_Localized: "{0}: \uBE44\uC0C1\uC2DD\uB7C9 \uD3C9\uAC00\uC5D0 \uD558\uB098 \uCD94\uAC00. \uB098. \uBAA8\uAE30 \uAE30\uC900 \uBCC4 \uB2E4\uC12F \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563495
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uD314\uC5D0 \uC5F4\uB450 \uAD70\uB370\uB97C \uBB3C\uB824 \uC788\uC5C8\uB2E4. \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563494
    m_Localized: "\uADF8\uB0E5 \uCC38\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563493
    m_Localized: "\uC9C0\uB09C\uBC88 \uBAA8\uAE30\uC7A5\uC740 \uC5B4\uB290\uC0C8 \uAD6C\uBA4D\uC774 \uB098 \uC788\uC5C8\uB2E4. \uC774\uBC88\uC5D4 \uADC0\uD241\uC774\uB97C \uB450 \uBC88\uC529 \uAE30\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563492
    m_Localized: "\uC790\uC7AC\uB97C \uC870\uAE08 \uC37C\uC9C0\uB9CC, \uC624\uB79C\uB9CC\uC5D0 \uAE4A\uC774 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174899
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uD3B8\uC9C0\uB97C \uBC1B\uC544 \uB4E4\uACE0 \uC624\uB798 \uC950\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563689
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC61B \uAE00\uC790\uB85C \uCCAB \uC904\uC744 \uC74A\uC5C8\uB2E4. \uB098\uB78F\uB9D0\uC2F8\uBBF8 \uB4D5\uADC1\uC5D0 \uB2EC\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563690
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9D0\uC774 \uC11C\uB85C \uD1B5\uD558\uC9C0 \uC54A\uC544\uC11C, \uBC31\uC131\uC774 \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC744 \uAE00\uB85C \uC4F0\uC9C0 \uBABB\uD574\uC11C, \uADF8\uAC8C \uC548\uD0C0\uAE4C\uC6CC\uC11C \uB9CC\uB4E0 \uAE00\uC790\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563691
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC624\uB298 \uC219\uC81C. \uD558\uACE0 \uC2F6\uC5C8\uB294\uB370 \uBABB \uD588\uB358 \uB9D0\uC744 \uD558\uB098\uC529 \uC368 \uBCF4\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563692
    m_Localized: "\uCE60\uD310 \uAD6C\uC11D\uC5D0 \uD558\uACE0 \uC2F6\uC5C8\uB358 \uB9D0\uC744 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563693
    m_Localized: "\uBD84\uD544\uC744 \uB4E4\uACE0 \uD55C\uCC38 \uC11C \uC788\uB2E4\uAC00 \uC37C\uB2E4. \uC9E7\uC740 \uB9D0\uC774\uC5C8\uB2E4. \uB204\uAD6C\uC5D0\uAC8C \uD558\uB294 \uB9D0\uC778\uC9C0\uB294 \uC4F0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563694
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78 \uC77D\uACE0, \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uAE00\uC790\uB294 \uBA70\uCE60 \uB3D9\uC548 \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563695
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB4E4\uB824\uC8FC\uB294 \uD55C\uAE00 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563696
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2E0\uC774 \uB098\uC11C \uAE30\uC5ED, \uB2C8\uC740, \uB514\uADFF\uC774 \uC5B4\uB5BB\uAC8C \uC0DD\uACA8\uB0AC\uB294\uC9C0 \uC774\uC57C\uAE30\uD588\uB2E4. \uD600\uC640 \uC774\uC640 \uC785\uC220\uC758 \uBAA8\uC591."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563491
    m_Localized: "\uCEE4\uD2BC \uCC9C\uC73C\uB85C \uBAA8\uAE30\uC7A5\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563490
    m_Localized: "\uC815\uC218\uD558\uAE30 \uC804\uC5D0 \uB69C\uAED1\uBD80\uD130 \uB36E\uC790\uACE0, \uC77C\uAE30\uC7A5 \uB9E8 \uC704\uC5D0 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563489
    m_Localized: "\uBE57\uBB3C \uBC1B\uC544 \uB454 \uD1B5\uC5D0 \uC7A5\uAD6C\uBC8C\uB808\uAC00 \uC0DD\uACBC\uB2E4. \uADF8\uB0A0 \uBC24\uBD80\uD130 \uBAA8\uAE30\uAC00 \uB450 \uBC30\uB85C \uB298\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460258
    m_Localized: "\uBC24. \uC6B4\uB3D9\uC7A5 \uCABD \uCC3D\uAC00\uC5D0\uC11C \uADF8\uB9BC\uC790\uB97C \uC138\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826538
    m_Localized: "\uADF8 \uC0AC\uB78C\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6D0\uB9DD\uD558\uB294 \uC5BC\uAD74\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB798\uC11C \uB354 \uC624\uB798 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706470
    m_Localized: "\uAD50\uC2E4\uB3D9 \uC591\uD638\uC2E4 \uCE68\uB300\uC5D0\uB294 \uC2DC\uD2B8\uAC00 \uBC18\uB4EF\uD558\uAC8C \uAE54\uB824 \uC788\uC5C8\uB2E4. \uB204\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC815\uB9AC\uD558\uACE0 \uB098\uAC04 \uADF8\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706471
    m_Localized: "\uBCBD\uC5D0 '\uC751\uAE09\uCC98\uCE58 \uC21C\uC11C'\uAC00 \uC801\uD78C \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC9C0\uD608, \uC18C\uB3C5, \uACE0\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706472
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uADF8 \uC774\uC57C\uAE30\uB97C \uD558\uC790, \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826503
    m_Localized: "\uC138 \uC0AC\uB78C\uC758 \uC774\uB984\uC744 \uBC29\uC1A1\uC2E4 \uBCBD\uC5D0 \uBD99\uC740 \uC885\uC774\uC5D0 \uC801\uC5C8\uB2E4. \uC9C0\uCF1C\uC57C \uD560 \uC774\uB984\uC774 \uB298\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460252
    m_Localized: "\"\uBE68\uB9AC \uAC78\uC5B4\uB3C4 \uB3FC. \uADF8 \uAC78\uC74C\uC774 \uB108\uB97C \uC5EC\uAE30\uAE4C\uC9C0 \uB370\uB824\uC654\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563488
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A1\uC558\uC5B4? \u2026\uBABB \uC7A1\uC558\uAD6C\uB098. \uC18C\uB9AC\uB85C \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174898
    m_Localized: "{0}: \uB124\uAC00 \uC9C1\uC811 \uC904 \uC218 \uC788\uC744 \uB54C \uBC1B\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563697
    m_Localized: "\uC785 \uBAA8\uC591\uC744 \uB530\uB77C \uD558\uB2E4 \uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563698
    m_Localized: "\uB0A0\uC774 \uAC11\uC790\uAE30 \uCD94\uC6CC\uC84C\uB2E4. \uC724 \uC120\uC0DD\uB2D8\uC774 \uC190\uBC14\uB2E5\uC744 \uBE44\uBE44\uBA70 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563699
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE40\uC7A5\uD560 \uB54C\uB2E4. \uACA8\uC6B8 \uBC18\uCC2C\uC740 \uC9C0\uAE08 \uB9CC\uB4E4\uC5B4 \uB46C\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563700
    m_Localized: "\uC625\uC0C1 \uD143\uBC2D\uC5D0\uC11C \uD0A4\uC6B4 \uBC30\uCD94\uAC00 \uC791\uACE0 \uB2E8\uB2E8\uD588\uB2E4. \uC2DC\uB4E0 \uAC89\uC78E\uC744 \uB5BC\uB2C8 \uC18D\uC774 \uB178\uB7AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563701
    m_Localized: "\uBC30\uCD94\uB294 \uC5C6\uC5C8\uB2E4. \uB9C8\uD2B8\uC5D0\uC11C \uAD6C\uD55C \uBB34\uC640 \uC2DC\uB4E0 \uAC13, \uD1B5\uC870\uB9BC \uACE0\uCD94\uB97C \uBAA8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563702
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC5D0\uC11C \uACE0\uCDA7\uAC00\uB8E8 \uD55C \uBD09\uC9C0\uAC00 \uC654\uB2E4. \uCABD\uC9C0\uC5D0 \uC815 \uBC18\uC7A5\uC758 \uAE00\uC528. '\uAE40\uC7A5\uC740 \uC6D0\uB798 \uB098\uB220 \uD558\uB294 \uAC70\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563703
    m_Localized: "\uB2E4 \uAC19\uC774 \uAE40\uC7A5\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563704
    m_Localized: "\uC190\uC774 \uBE68\uAC1B\uAC8C \uC5BC\uACE0, \uACE0\uCDA7\uAC00\uB8E8\uAC00 \uB208\uC5D0 \uB4E4\uC5B4\uAC00 \uB2E4\uB4E4 \uC6B8\uBA74\uC11C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563487
    m_Localized: "\uC790\uB2E4\uAC00 \uB0B4 \uBEA8\uC744 \uB0B4\uAC00 \uB54C\uB838\uB2E4. \uC190\uBC14\uB2E5\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563486
    m_Localized: "\uBD88\uC744 \uCF1C\uBA74 \uC0AC\uB77C\uC9C0\uACE0, \uB044\uBA74 \uB2E4\uC2DC \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563485
    m_Localized: "\uBC24\uC0C8 \uBAA8\uAE30\uAC00 \uADD3\uAC00\uC5D0\uC11C \uC575\uC575\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563484
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB807\uACA0\uC9C0. \uAF64 \uC624\uB798 \uAC19\uC774 \uB2E4\uB154\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563483
    m_Localized: "{0}: \uB2E4\uB9AC\uAC00 \uADF8\uB9AC\uC6B4\uAC00 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563482
    m_Localized: "\uB18D\uB2F4\uC73C\uB85C \uB118\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563481
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC5C8\uC9C0\uB9CC, \uADF8\uB0A0 \uBC24 \uAE30\uCE68\uC744 \uBA87 \uBC88 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563480
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uADF8\uB798. \uC794\uC18C\uB9AC\uAFBC\uC774 \uB458\uC774 \uB410\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563479
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uAED8 \uAF2D \uB9D0\uD558\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563705
    m_Localized: "\uD56D\uC544\uB9AC \uB300\uC2E0 \uD070 \uAE40\uCE58\uD1B5 \uB450 \uAC1C\uB97C \uADF8\uB298\uC9C4 \uAD50\uC2E4 \uAD6C\uC11D\uC5D0 \uBB3B\uC5C8\uB2E4. \uACA8\uC6B8 \uB0B4\uB0B4 \uAEBC\uB0B4 \uBA39\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563706
    m_Localized: "\uC774\uBC88 \uD574\uB294 \uAC74\uB108\uB6F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563707
    m_Localized: "\uC7AC\uB8CC\uAC00 \uC544\uAE4C\uC6E0\uB2E4. \uB300\uC2E0 \uB0A8\uC740 \uBB34\uB97C \uC370\uC5B4 \uAD6D\uC744 \uB053\uC600\uB2E4. \uAE40\uC7A5 \uB0C4\uC0C8 \uBE44\uC2B7\uD55C \uAC83\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563708
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uB2F4\uC7A5 \uC606 \uAC10\uB098\uBB34\uC5D0 \uAC10\uC774 \uC8FC\uD669\uC0C9\uC73C\uB85C \uB9E4\uB2EC\uB824 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uB530\uC9C0 \uC54A\uC740 \uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563709
    m_Localized: "\uAC10\uB098\uBB34 \uAF2D\uB300\uAE30\uC5D0 \uAE4C\uCE58 \uD55C \uB9C8\uB9AC\uAC00 \uC549\uC544 \uD64D\uC2DC\uB97C \uCABC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563710
    m_Localized: "\uBC24\uC0AC\uC774 \uB5A8\uC5B4\uC9C4 \uD64D\uC2DC\uAC00 \uC6B4\uB3D9\uC7A5\uC5D0 \uC8FC\uD669\uC0C9 \uC810\uCC98\uB7FC \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563711
    m_Localized: "\uAC10\uB098\uBB34 \uAC00\uC9C0\uAC00 \uB0A0\uB9C8\uB2E4 \uC870\uAE08\uC529 \uAC00\uBCBC\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563712
    m_Localized: "\uC7A5\uB300\uB85C \uAC10\uC744 \uB534\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563713
    m_Localized: "\uC7A5\uB300\uB97C \uD718\uB450\uB974\uB2E4 \uAC10\uC774 \uB5A8\uC5B4\uC838 \uD130\uC84C\uB2E4. \uADF8\uB798\uB3C4 \uBA87 \uAC1C\uB294 \uBA40\uCA61\uD588\uB2E4. \uCC3D\uAC00\uC5D0 \uB298\uC5B4\uB193\uC73C\uB2C8 \uBC29\uC774 \uD658\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563478
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uAE30\uB85D\uD55C\uB2E4\uB358 \uADF8 \uC218\uCCA9\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563477
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC694\uC998\uC740 \uBC24\uB9C8\uB2E4 \uC880 \uB354 \uADF8\uB798. \uC5F4\uC774 \uB098\uB294 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563476
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC0C1\uD558\uC9C0. \uC5C6\uB294 \uB2E4\uB9AC\uAC00 \uAC00\uB054 \uC800\uB824. \uBC1C\uAC00\uB77D\uC774 \uAC04\uC9C0\uB7FD\uAE30\uB3C4 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563475
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC5C6\uB294 \uCABD \uB2E4\uB9AC\uB97C \uC190\uC73C\uB85C \uAC10\uC30C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563474
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB9D0\uD558\uACE0 \uC2F6\uC5B4\uC9C0\uBA74, \uADF8 \uC774\uB984\uBD80\uD130 \uBD88\uB7EC. \uB098\uB294 \uB4E4\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460251
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uC5D0\uAC8C \uD55C\uB9C8\uB514 \uD560 \uC218 \uC788\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563473
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB300\uC2E0 \uADF8 \uD559\uC0DD\uC99D, \uC783\uC5B4\uBC84\uB9AC\uC9C0 \uB9D0\uACE0 \uC798 \uAC16\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563714
    m_Localized: "\uC81C\uC77C \uC798 \uC775\uC740 \uAC83 \uD558\uB098\uB97C \uC120\uC0DD\uB2D8 \uBA38\uB9AC\uB9E1\uC5D0 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563715
    m_Localized: "\uAE4C\uCE58\uBC25\uC73C\uB85C \uB0A8\uACA8 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563716
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAF2D\uB300\uAE30 \uBA87 \uAC1C\uB294 \uB0A8\uACA8 \uB450\uB294 \uAC70\uC57C. \uAE4C\uCE58\uBC25. \uACA8\uC6B8\uC5D0 \uC0C8\uB4E4\uB3C4 \uBA39\uC5B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563717
    m_Localized: "\uADF8 \uB9D0\uC774 \uC774\uC0C1\uD558\uAC8C \uC624\uB798 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563718
    m_Localized: "\uAC00\uC744 \uCCAB \uBC24. \uBC29\uC1A1\uC2E4 \uBB34\uC804\uAE30\uAC00 \uB610\uB837\uD55C \uBAA9\uC18C\uB9AC\uB97C \uD1A0\uD574 \uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563719
    m_Localized: "DJ: \uC0C8\uBCBD\uC2DC \uC5B4\uB518\uAC00\uC5D0\uC11C \uC544\uC9C1 \uAE68\uC5B4 \uC788\uB294 \uC5EC\uB7EC\uBD84, \uC88B\uC740 \uBC24\uC785\uB2C8\uB2E4. \uC624\uB298\uB3C4 \uC0B4\uC544 \uC788\uC5B4 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563720
    m_Localized: "DJ: \uC800\uB294 DJ \uC0C8\uBCBD. \uC9C4\uC9DC DJ\uB294 \uC544\uB2C8\uACE0, \uC61B\uB0A0\uC5D0 \uB3D9\uB124 \uB77C\uB514\uC624\uC5D0\uC11C \uC0AC\uC5F0 \uC77D\uB358 \uC0AC\uB78C\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563721
    m_Localized: "DJ: \uC624\uB298\uC758 \uD65C\uB3D9 \uC608\uBCF4. \uBD81\uCABD \uC0C1\uAC00\uB294 \uC870\uC6A9\uD558\uACE0, \uAC15\uBCC0 \uCABD\uC740 \uC2DC\uB044\uB7FD\uC2B5\uB2C8\uB2E4. \uAC15\uBCC0\uC740 \uD53C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563722
    m_Localized: "DJ: \uD639\uC2DC \uC774 \uBC29\uC1A1 \uB4E3\uB294 \uBD84 \uC788\uC73C\uBA74\u2026 3\uBC88 \uCC44\uB110\uB85C \uC2E0\uD638 \uD55C \uBC88\uB9CC \uC918\uC694. \uD63C\uC790 \uB5A0\uB4DC\uB294 \uAC70, \uC0DD\uAC01\uBCF4\uB2E4 \uC678\uB86D\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563472
    m_Localized: "\uC544\uC9C1\uC740 \uB9D0\uD558\uAE30 \uC5B4\uB835\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563471
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uB2C8, \uB9CC\uB0A0 \uAC70\uC57C. \uC6B0\uB9AC\uB294 \uADF8\uB807\uAC8C \uB9D0\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563723
    m_Localized: "\uC1A1\uC2E0 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB300\uB2F5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563724
    m_Localized: "{0}: \uB4E4\uB824\uC694. \uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50\uC608\uC694. \uC5EC\uAE30, \uC0AC\uB78C \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563725
    m_Localized: "\uC7A0\uAE50\uC758 \uCE68\uBB35. \uADF8\uB9AC\uACE0 \uC6C3\uC74C\uC774 \uC11E\uC778 \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563726
    m_Localized: "DJ: \u2026\uC640. \uD559\uAD50\uC694? \uD559\uC0DD\uC774\uC5D0\uC694? \uC138\uC0C1\uC5D0. \uC624\uB298 \uBC29\uC1A1\uC740 \uADF8\uCABD\uC5D0 \uBC14\uCE69\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563727
    m_Localized: "\uB300\uB2F5\uD558\uC9C0 \uC54A\uACE0 \uB4E3\uAE30\uB9CC \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563728
    m_Localized: "DJ\uB294 \uB300\uB2F5\uC774 \uC5C6\uC5B4\uB3C4 \uACC4\uC18D \uC774\uC57C\uAE30\uD588\uB2E4. \uB3D9\uB124 \uBE75\uC9D1 \uC774\uC57C\uAE30, \uBE44 \uC624\uB294 \uB0A0 \uC774\uC57C\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563729
    m_Localized: "\uADF8 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA70 \uC624\uB79C\uB9CC\uC5D0 \uAE4A\uC774 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563730
    m_Localized: "DJ: \uC624\uB298\uC758 \uC18C\uC2DD. \uC0C8\uBCBD\uB9C8\uD2B8\uC5D0 \uC5B4\uB978 \uBA87 \uBD84\uC774 \uC790\uB9AC\uB97C \uC7A1\uC73C\uC168\uB300\uC694. \uBB3C\uB958\uCC3D\uACE0\uAE4C\uC9C0 \uC4F0\uC2E0\uB2E4\uB2C8 \uBD80\uB7FD\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563731
    m_Localized: "DJ: \uC2A4\uC2A4\uB85C '\uB354\uBD88\uC5B4 \uB9C8\uD2B8'\uB77C\uACE0 \uBD80\uB978\uB300\uC694. \uC774\uB984\uC740 \uC88B\uB124\uC694. \uC774\uB984\uB9CC\uD07C\uB9CC \uD558\uC2DC\uAE38."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563732
    m_Localized: "DJ: \uAC70\uAE30 \uB300\uD45C\uAC00 \uBB3C\uB958\uCC3D\uACE0 \uBC18\uC7A5 \uCD9C\uC2E0\uC774\uB798\uC694. \uC9C0\uAC8C\uCC28\uB3C4 \uBAB0 \uC904 \uC548\uB2E4\uACE0. \uC694\uC998 \uC138\uC0C1\uC5D4 \uADF8\uAC8C \uC790\uACA9\uC99D\uBCF4\uB2E4 \uB0AB\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563733
    m_Localized: "DJ: \uAC70\uB798\uB3C4 \uD55C\uB2E4\uB358\uB370\u2026 \uC870\uC2EC\uC740 \uD558\uC138\uC694. \uC0AC\uB78C\uC774 \uC81C\uC77C \uBB34\uC11C\uC6B4 \uC138\uC0C1\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563734
    m_Localized: "{0}: \uAC70\uB798\uB77C\uB294 \uAC8C\u2026 \uBB58 \uC8FC\uACE0 \uBB58 \uBC1B\uB294 \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563735
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC\uD55C\uD14C \uB0A8\uB294 \uAC78 \uC8FC\uACE0, \uBAA8\uC790\uB780 \uAC78 \uBC1B\uB294 \uAC70\uC9C0. \uBB38\uC81C\uB294 \uC0AC\uB78C\uB9C8\uB2E4 '\uB0A8\uB294 \uAC83'\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563771
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38\uC774 \uC870\uAE08 \uB35C \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563770
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD\uC774 \uD611\uC0C1\uC744 \uD558\uB124. \uC88B\uC544, \uBB34\uC804 \uCC44\uB110 \uD558\uB098 \uC815\uD558\uC790. \uBB34\uC2A8 \uC77C \uC788\uC73C\uBA74 \uC11C\uB85C \uBD80\uB974\uB294 \uAC78\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563769
    m_Localized: "\uC11C\uB85C \uB3D5\uC790\uACE0, \uC815\uAE30\uC801\uC73C\uB85C \uC5F0\uB77D\uD558\uC790\uACE0 \uC81C\uC548\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563768
    m_Localized: "\uC57D\uD488 \uB450 \uC0C1\uC790\uC640 \uC300 \uD55C \uD3EC\uB300. \uC815 \uBC18\uC7A5\uC774 \uC545\uC218\uB97C \uCCAD\uD588\uB2E4. \uC190\uC774 \uAC70\uCE60\uACE0 \uB530\uB73B\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563736
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9C8\uD2B8\uB77C. \uBB3C\uC790\uB294 \uB9CE\uACA0\uC9C0. \uADF8\uB9AC\uACE0 \uC0AC\uB78C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563737
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uAC8C \uB418\uBA74 \uB9D0\uC744 \uC544\uB07C\uACE0, \uC6B0\uB9AC\uAC00 \uC5B4\uB514 \uC788\uB294\uC9C0\uB294 \uC27D\uAC8C \uC54C\uB824 \uC8FC\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563738
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uC6C3\uC73C\uBA74\uC11C \uBA3C\uC800 \uB2E4\uAC00\uC624\uB294 \uC0AC\uB78C\uD55C\uD14C\uB294, \uAC19\uC774 \uC6C3\uC5B4 \uC8FC\uACE0 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563739
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uD070\uAE38 \uBAA8\uD241\uC774\uC5D0 \uD30C\uCD9C\uC18C\uAC00 \uBCF4\uC600\uB2E4. \uC21C\uCC30\uCC28 \uBC14\uD034\uB294 \uB2E4 \uC8FC\uC800\uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563740
    m_Localized: "\uBB38\uC5D0 \uC190\uAE00\uC528 \uC885\uC774\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uAE00\uC528\uB294 \uBE57\uBB3C\uC5D0 \uBC88\uC838 \uC77D\uC744 \uC218 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563741
    m_Localized: "'\uB300\uD53C' \uB450 \uAE00\uC790\uC640 \uD654\uC0B4\uD45C \uD558\uB098\uB9CC \uACA8\uC6B0 \uBCF4\uC600\uB2E4. \uD654\uC0B4\uD45C\uB294 \uAC15 \uCABD\uC744 \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563742
    m_Localized: "\uCC3D \uC548\uCABD \uAC8C\uC2DC\uD310\uC5D0\uB294 \uC0AC\uB78C\uC744 \uCC3E\uB294 \uC804\uB2E8\uC774 \uACB9\uACB9\uC774 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uB0A0\uC9DC\uB294 \uBAA8\uB450 \uC0AC\uD0DC \uCCAB \uC8FC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563743
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD30C\uCD9C\uC18C\uB77C\u2026 \uBB34\uAE30\uACE0\uB294 \uC7A0\uACA8 \uC788\uACA0\uC9C0\uB9CC, \uBC24\uC774\uB77C\uBA74 \uC9C0\uD0A4\uB294 \uC0AC\uB78C\uB3C4 \uC5C6\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563744
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD1D \uAC19\uC740 \uAC74 \uC0DD\uAC01\uB3C4 \uD558\uC9C0 \uB9C8. \uC6B0\uB9AC\uAC00 \uD544\uC694\uD55C \uAC74 \uB9C9\uC744 \uC218 \uC788\uB294 \uAC83\uBFD0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563745
    m_Localized: "{0}: \uB9C9\uC744 \uC218 \uC788\uB294 \uAC70\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563746
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uD328\uB4E0, \uC870\uB07C\uB4E0. \uB2E4\uCE58\uC9C0 \uC54A\uB294 \uAC8C \uC774\uAE30\uB294 \uAC70\uC57C. \uC6B0\uB9AC\uD55C\uD14C\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460250
    m_Localized: "\uC625\uC0C1 \uBB38\uC744 \uC5F4\uC790 \uAD50\uBB38 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4\uAC00 \uB0B4\uB824\uB2E4\uBCF4\uC600\uB2E4. \uADF8\uB0A0 \uC544\uCE68, \uC2E0\uD638\uAC00 \uBC14\uB00C\uC790\uB9C8\uC790 \uBA3C\uC800 \uAC74\uB10C \uACF3."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460249
    m_Localized: "\uC120\uC0DD\uB2D8 \uC606\uC5D0\uC11C \uB290\uB9AC\uAC8C \uAC77\uB358 \uBD04\uBC24\uC758 \uBCF5\uB3C4\uAC00 \uB5A0\uC62C\uB790\uB2E4. \uCC3D\uBC16\uC5D0 \uB2EC\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460248
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0\uC11C \uCC98\uC74C \uB4A4\uB97C \uB3CC\uC544\uBD24\uB358 \uB0A0\uC774 \uB5A0\uC62C\uB790\uB2E4. \uC544\uBB34\uAC83\uB3C4 \uB530\uB77C\uC624\uC9C0 \uC54A\uB358, \uD145 \uBE48 \uAE38."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460247
    m_Localized: "\uB098\uB294 \uBA87 \uBC88\uC774\uACE0 \uB9E8 \uBA3C\uC800 \uB3C4\uCC29\uD588\uB2E4. \uBB38\uACE0\uB9AC\uB97C \uC7A1\uACE0 \uB3CC\uC544\uBCF4\uBA74, \uB2E4\uB4E4 \uC544\uC9C1 \uACC4\uB2E8 \uC911\uAC04\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460246
    m_Localized: "\uAD6C\uC870\uB300\uAC00 \uB0B4\uB9B4 \uC625\uC0C1\uAE4C\uC9C0 \uAC00\uB294 \uAE38\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC5F0\uC2B5\uD588\uB2E4. \uBCF5\uB3C4 \uB05D\uC5D0\uC11C \uC625\uC0C1 \uBB38\uAE4C\uC9C0, \uACC4\uB2E8 \uC5F4\uC5EC\uC12F \uCE78."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563747
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uB05D\uC5D0, DJ\uAC00 \uC544\uB2CC \uB0AF\uC120 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uB610\uBC15\uB610\uBC15\uD55C, \uD6C8\uB828\uB41C \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563748
    m_Localized: "\uAD6C\uC870\uB300: \uC0C8\uBCBD\uC2DC \uC77C\uB300 \uC0DD\uC874\uC790\uC5D0\uAC8C \uC54C\uB9BD\uB2C8\uB2E4. \uAD6C\uC870\uB300\uAC00 \uB0B4\uB144 3\uC6D4 \uB458\uC9F8 \uC8FC\uC5D0 \uB3C4\uCC29\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563749
    m_Localized: "\uAD6C\uC870\uB300: \uC9C0\uC815 \uCC29\uB959 \uC9C0\uC810\uC740 \uC625\uC0C1, \uB610\uB294 \uB113\uC740 \uACF5\uD130\uC785\uB2C8\uB2E4. \uB0AE\uC5D0 SOS\uB97C \uD45C\uC2DC\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563750
    m_Localized: "\uAD6C\uC870\uB300: \uD0D1\uC2B9 \uC804 \uC804\uC6D0 \uAC80\uC9C4\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4. \uAC10\uC5FC\uC774 \uD655\uC778\uB41C \uC0AC\uB78C\uC740 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uBC18\uBCF5\uD569\uB2C8\uB2E4. \uAC10\uC5FC\uC790\uB294 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563751
    m_Localized: "\uAD6C\uC870\uB300: \uD22C\uC785 \uD5EC\uAE30\uB294 \uD55C \uB300, 1\uD68C \uD0D1\uC2B9 \uC778\uC6D0\uC740 \uC5EC\uB35F \uBA85 \uB0B4\uC678\uC785\uB2C8\uB2E4. \uB2E4\uC74C \uC6B4\uD56D\uAE4C\uC9C0\uB294 \uCD5C\uC18C \uD55C \uB2EC\uC774 \uAC78\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563752
    m_Localized: "\uAD6C\uC870\uB300: \uC778\uADFC\uC5D0\uC11C \uB2E4\uB978 \uC0DD\uC874\uC790 \uC2E0\uD638\uB3C4 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uB05D\uAE4C\uC9C0 \uBC84\uD168 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563767
    m_Localized: "\uC57D \uC870\uAE08\uACFC \uC2DD\uB7C9\uC744 \uBC14\uAFBC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563753
    m_Localized: "\uBC29\uC1A1\uC774 \uB05D\uB098\uC790 \uC544\uBB34\uB3C4 \uB9D0\uC744 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563754
    m_Localized: "\uADF8\uB7EC\uB2E4 \uB3C4\uD604\uC774 \uC18C\uB9AC\uB97C \uC9C8\uB800\uB2E4. \uC774\uAE34 \uCD95\uAD6C \uACBD\uAE30\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563755
    m_Localized: "\uADF8\uB7EC\uB2E4 \uB0B4\uAC00 \uBA3C\uC800 \uC18C\uB9AC\uB97C \uC9C8\uB800\uB2E4. \uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC84C\uB2E4. \uC0C1\uAD00\uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563756
    m_Localized: "\uAC19\uC774 \uC18C\uB9AC \uC9C0\uB974\uBA70 \uAE30\uBED0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563757
    m_Localized: "\uB2E4 \uAC19\uC774 \uAEF4\uC548\uC558\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uBAA9\uBC1C\uC744 \uB193\uCE58\uBA70 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563758
    m_Localized: "\uB2E4 \uAC19\uC774 \uAEF4\uC548\uC558\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uBCBD\uC744 \uC9DA\uC740 \uCC44 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563759
    m_Localized: "22\uC8FC. \uC190\uAC00\uB77D\uC73C\uB85C \uC138\uC5B4 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563760
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uC5BC\uAD74\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826539
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8\uAC70\uBA74 \uB3FC. \uADF8 \uB9D0, \uC55E\uC73C\uB85C\uB3C4 \uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706474
    m_Localized: "\uAC00\uC0AC \uC2E4\uC2B5\uC2E4 \uC870\uB9AC\uB300 \uC704\uC5D0 \uC55E\uCE58\uB9C8\uAC00 \uAC78\uB9B0 \uCC44\uC600\uB2E4. \uC774\uB984\uD45C\uC5D0 1\uD559\uB144 \uB204\uAD70\uAC00\uC758 \uC774\uB984\uC774 \uC090\uB6A4\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706475
    m_Localized: "\uCC2C\uC7A5 \uC548\uCABD\uC5D0\uC11C \uC300 \uD3EC\uB300\uC640 \uBD80\uD0C4\uAC00\uC2A4\uB97C \uCC3E\uC558\uB2E4. \uB0C4\uBE44\uB3C4, \uAD6D\uC790\uB3C4 \uADF8\uB300\uB85C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706476
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uC2A4\uAC00 \uC788\uC73C\uBA74 \uB370\uC6CC \uBA39\uC744 \uC218 \uC788\uACA0\uB2E4. \u2026\uC694\uB9AC, \uBC30\uC6CC \uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563761
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uB2E4\uB9CC \uC6C3\uB294 \uC5BC\uAD74 \uADF8\uB300\uB85C \uC790\uAE30 \uB2E4\uB9AC\uB97C \uD55C \uBC88 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563762
    m_Localized: "\uAC10\uC5FC\uC790\uB294 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uADF8 \uBB38\uC7A5\uC774 \uBA38\uB9BF\uC18D\uC5D0\uC11C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563763
    m_Localized: "\uC5EC\uB35F \uBA85. \uD55C \uB2EC. \uBC29\uC1A1 \uB05D\uC5D0 \uC9C0\uB098\uAC04 \uC22B\uC790 \uB450 \uAC1C\uB3C4, \uC774\uC0C1\uD558\uAC8C \uADC0\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563764
    m_Localized: "\uB9C8\uD2B8 \uC0AC\uBB34\uC2E4. \uAC00\uC6B4\uB370 \uB0A8\uC790\uB294 \uC790\uC2E0\uC744 \uC815 \uBC18\uC7A5\uC774\uB77C\uACE0 \uC18C\uAC1C\uD588\uB2E4. \uC6D0\uB798 \uBB3C\uB958\uCC3D\uACE0 \uBC18\uC7A5\uC774\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563765
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uAD50\uC5D0 \uC120\uC0DD\uB2D8\uD558\uACE0 \uC560\uB4E4 \uBA87\uC774 \uC788\uB2E4\uACE0? \uB300\uB2E8\uD558\uB124. \uC6B0\uB9B0 \uC5EC\uAE30 \uC5F4\uD55C \uBA85\uC774\uC57C. \uB354\uBD88\uC5B4 \uB9C8\uD2B8\uB77C\uACE0\uB4E4 \uD574. \uC774\uB984\uC740 \uB0B4\uAC00 \uC9C0\uC740 \uAC70 \uC544\uB2C8\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563766
    m_Localized: "\uC815 \uBC18\uC7A5: \uC6B0\uB9AC\uB294 \uBA39\uC744 \uAC8C \uB9CE\uACE0, \uC57D\uC774 \uC5C6\uC5B4. \uB108\uD76C\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146436
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC190\uB54C \uBB3B\uC740 \uC218\uCCA9\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uB9E4\uC8FC \uC801\uC740 \uAE30\uB85D. \uCCB4\uC628, \uC0C1\uCC98, \uB0A0\uC528, \uC6B0\uB9AC \uC774\uB984."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146435
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC774 \uC57D\uC7A5, \uCC98\uC74C \uC5F4\uC5C8\uC744 \uB54C \uBD95\uB300 \uB450 \uB864\uC774\uC5C8\uC9C0. \uAE30\uC5B5\uB098?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146434
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uAC74\uC2E4 \uC57D\uC7A5\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC815\uB9AC\uD558\uACE0 \uC788\uC5C8\uB2E4. \uBE48 \uCE78\uC774 \uB354 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146433
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB3C4\uD604\uC740 \uC190\uC804\uB4F1\uC744 \uAF2D \uC954 \uCC44 \uC7A0\uB4E4\uC5C8\uB2E4. \uD55C \uBC88\uB3C4 \uCF1C\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146432
    m_Localized: "\uB3C4\uD604: \uC774\uAC70 \uB204\uB098\uAC00 \uBC24 \uD0D0\uD5D8 \uAC08 \uB54C\uB9C8\uB2E4 \uC4F0\uB358 \uAC70\uC796\uC544\uC694. \u2026\uC9C4\uC9DC \uC5B4\uB450\uC6B8 \uB54C\uB9CC \uCF24\uAC8C\uC694. \uC544\uAEF4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146431
    m_Localized: "\uB3C4\uD604\uC774 \uC190\uC804\uB4F1\uC744 \uCF30\uB2E4 \uAED0\uB2E4 \uD558\uBA70 \uC6C3\uC5C8\uB2E4. \uCC9C\uC7A5\uC5D0 \uB3D9\uADF8\uB780 \uBE5B\uC774 \uB5B4\uB2E4 \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460280
    m_Localized: "{0}: \uB3C4\uD604\uC544. \uBB38 \uCABD \uC790\uB9AC, \uB0B4\uC77C\uC740 \uB0B4\uAC00 \uC549\uC744\uAC8C. \uB9DD\uC740 \uB0B4\uAC00 \uBCFC \uD14C\uB2C8\uAE4C \uB108\uB294 \uBC25 \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460279
    m_Localized: "\uBCF8 \uAC83\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460278
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68, \uB098\uB294 \uADF8 \uBB34\uB9AC\uB97C \uB611\uBC14\uB85C \uBD24\uB2E4. \uBCF4\uB294 \uAC74 \uD560 \uC218 \uC788\uB2E4. \uC5B4\uB824\uC6B4 \uAC74 \uBCF8 \uB2E4\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460277
    m_Localized: "\uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB4E4 \uAD1C\uCC2E\uC740 \uCC99\uD558\uB294 \uB370\uB294 \uC120\uC218\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174827
    m_Localized: "\uB0A8\uC790: \uB9D0 \uC798 \uD1B5\uD558\uB124. \uC55E\uC73C\uB85C \uC0AC\uAC70\uB9AC \uC9C0\uB0A0 \uB54C \uC6B0\uBE44 \uBCF4\uBA74 \uC190 \uD754\uB4E4\uC5B4. \uC548 \uC3E0 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980531
    m_Localized: "\uCC3D\uAC00\uC5D0\uC11C \uC6B4\uB3D9\uC7A5\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460157
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uC190\uAC00\uB77D \uB450 \uAC1C\uAC00 \uC62C\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460156
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBA87 \uD559\uB144\uC774\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460155
    m_Localized: "\uCC3D\uACE0 \uBB38 \uC55E\uC5D0\uC11C, \uC724 \uC120\uC0DD\uB2D8\uC774 \uB0AF\uC120 \uC5BC\uAD74\uC744 \uD55C\uCC38 \uBC14\uB77C\uBD24\uB2E4. \uD749\uD130\uC5D0\uC11C \uC7A0\uAE50 \uBA48\uCD98 \uB208\uC774, \uB2E4\uC2DC \uADF8 \uC0AC\uB78C\uC758 \uB208\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826545
    m_Localized: "\uC120\uC0DD\uB2D8 \uC606\uC5D0\uC11C \uB208\uC744 \uAC10\uC558\uB2E4. \uBCF4\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB294 \uBC24\uC774, \uCC98\uC74C\uC73C\uB85C \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987441
    m_Localized: "\uD658\uAE30\uCC3D\uC73C\uB85C \uB4E4\uC774\uCE58\uB294 \uBE57\uBB3C\uC744 \uBE48 \uBCD1\uC5D0 \uBC1B\uC558\uB2E4. \uBC18 \uBCD1\uCBE4. \uADF8\uAC83\uB9CC\uC73C\uB85C\uB3C4 \uBD80\uC790\uAC00 \uB41C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987440
    m_Localized: "\uC5B4\uB514\uC11C \uBC30\uC6E0\uB294\uC9C0 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294 \uB178\uB798\uC600\uB2E4. \uAC00\uC0AC\uB294 \uC911\uAC04\uBD80\uD130 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987439
    m_Localized: "\uC5EC\uC12F\uC9F8 \uB0A0. \uBE44\uAC00 \uC654\uB2E4. \uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C \uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706498
    m_Localized: "\uC57D\uC744 \uBA39\uACE0 \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706499
    m_Localized: "\uC57D\uC744 \uC0BC\uD0A4\uACE0 \uB2F4\uC694 \uC18D\uC5D0\uC11C \uB540\uC744 \uD758\uB838\uB2E4. \uC0C8\uBCBD\uB158\uC5D0 \uC5F4\uC774 \uB0B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706500
    m_Localized: "\uC57D\uC744 \uC544\uB07C\uACE0 \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706501
    m_Localized: "\uCC9C\uC7A5 \uBAA8\uC11C\uB9AC\uC5D0\uC11C \uBB3C\uBC29\uC6B8\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uC5D0 \uC7A0\uC774 \uAE7C\uB2E4. \uB611, \uB611, \uB611."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460149
    m_Localized: "\uBA39\uC744 \uAC83\uB9CC \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460148
    m_Localized: "\uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00, \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uB9AC\uACE0 \uC138 \uAC78\uC74C\uCBE4 \uB5A8\uC5B4\uC838 \uB0B4 \uB4A4\uB97C \uB530\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987432
    m_Localized: "\uC228\uC744 \uCC38\uC558\uB2E4. \uC18C\uB9AC\uB294 \uC544\uC8FC \uC624\uB798 \uBA38\uBB3C\uB2E4 \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987431
    m_Localized: "\uBC1C\uC18C\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uD55C\uCABD \uBC1C\uC744 \uB04C\uBA70 \uAC77\uB294, \uC544\uC8FC \uB290\uB9B0 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987430
    m_Localized: "\uB2E4\uC12F\uC9F8 \uB0A0. \uBB38 \uBC14\uB85C \uBC16\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB04C\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460147
    m_Localized: "{0}: \uC6B0\uB9AC \uCABD\uC5D0 \uC5B4\uB978\uC774 \uD55C \uBD84 \uACC4\uC138\uC694. \uAC19\uC774 \uAC00\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460146
    m_Localized: "\uAC19\uC774 \uAC00\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460145
    m_Localized: "\uACE0\uAC1C\uB97C \uD55C \uBC88 \uAC00\uB85C\uC800\uC5C8\uB2E4. \uB300\uB2F5\uC740 \uADF8\uAC8C \uC804\uBD80\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460144
    m_Localized: "{0}: \u2026\uC800\uAE30, \uAD1C\uCC2E\uC544\uC694? \uBB3C\uB9B0 \uB370\uB294\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987425
    m_Localized: "{0}\uC5D0\uAC8C \uD138\uC5B4\uB193\uC558\uB358 \uC774\uC57C\uAE30\uAC00 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC560\uB294 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987424
    m_Localized: "\uB0A0\uC9DC\uB97C \uC78A\uC9C0 \uC54A\uC73C\uB824\uACE0 \uB9E4\uD2B8 \uADC0\uD241\uC774\uC5D0 \uC190\uD1B1\uC73C\uB85C \uAE08\uC744 \uADF8\uC5C8\uB2E4. \uD558\uB098, \uB458, \uC14B, \uB137."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987423
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBCF8 \uD654\uBA74\uC740 '\uC11C\uBE44\uC2A4 \uC5C6\uC74C', \uADF8\uB9AC\uACE0 \uBC30\uD130\uB9AC 1%."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987422
    m_Localized: "\uD734\uB300\uD3F0 \uD654\uBA74\uC774 \uAEBC\uC84C\uB2E4. \uB2E4\uC2DC \uCF1C\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987421
    m_Localized: "\uB137\uC9F8 \uB0A0. \uC815\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460143
    m_Localized: "\uBA85\uCC30 \uC790\uB9AC\uC5D0\uB294 \uB72F\uAE34 \uC2E4\uBC25\uB9CC \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uCCB4\uC721\uBCF5 \uC18C\uB9E4\uC758 \uC904 \uC0C9\uAE54\uC740 2\uD559\uB144 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460142
    m_Localized: "\uADF8 \uC0AC\uB78C\uC740 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB3C4\uB9DD\uCE58\uC9C0\uB3C4, \uB2E4\uAC00\uC624\uC9C0\uB3C4 \uC54A\uC558\uB2E4. \uADF8\uB0E5 \uB098\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460141
    m_Localized: "\uC67C\uCABD \uBEA8\uC5D0\uC11C \uD131 \uC544\uB798\uB97C \uC9C0\uB098 \uBAA9\uAE4C\uC9C0, \uAE38\uAC8C \uC774\uC5B4\uC9C4 \uD749\uD130\uAC00 \uC788\uC5C8\uB2E4. \uC774\uBBF8 \uC544\uBB38, \uADF8\uB7EC\uB098 \uC624\uB798\uB418\uC9C0\uB294 \uC54A\uC740 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460140
    m_Localized: "\uAD50\uBCF5 \uC704\uC5D0 \uCCB4\uC721\uBCF5\uC744 \uACB9\uCCD0 \uC785\uC740 \uD559\uC0DD \uD558\uB098. \uC190\uC5D0 \uB4E0 \uAC74 \uBE48 \uBB3C\uBCD1\uBFD0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987416
    m_Localized: "\uBC1C\uC18C\uB9AC\uB294 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987415
    m_Localized: "{0}: \uC5EC\uAE30\uC694! \uC5EC\uAE30 \uC0AC\uB78C \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987414
    m_Localized: "\uB204\uAD70\uAC00 \uBCF5\uB3C4\uB97C \uB2EC\uB824\uAC14\uB2E4. \uBB38\uC744 \uB450\uB4DC\uB9AC\uACE0 \uC18C\uB9AC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987413
    m_Localized: "\uC14B\uC9F8 \uB0A0. \uC0AC\uC774\uB80C\uC774 \uC6B8\uB838\uB2E4. \uBA40\uB9AC\uC11C \uBE44\uBA85 \uAC19\uC740 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460139
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uCCB4\uC721\uAD00 \uB4A4\uD3B8 \uADF8\uB298\uC5D0\uC11C \uB204\uAD70\uAC00\uC640 \uB208\uC774 \uB9C8\uC8FC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826546
    m_Localized: "\uBCF4\uB294 \uC0AC\uB78C\uC774 \uAF2D \uB9D0\uD574\uC57C \uD558\uB294 \uAC74 \uC544\uB2C8\uC5C8\uB2E4. \uAC00\uB054\uC740 \uAC70\uAE30 \uC788\uB294 \uAC78\uB85C \uCDA9\uBD84\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987410
    m_Localized: "\uBC15\uC2A4 \uB4A4\uC5D0\uC11C \uC774\uC628\uC74C\uB8CC \uD55C \uC0C1\uC790\uB97C \uB354 \uCC3E\uC558\uB2E4. \uB2E8 \uAC74 \uC544\uAEF4 \uB450\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987409
    m_Localized: "\uBB3C\uB9DB\uC774 \uC774\uC0C1\uD558\uAC8C \uB2EC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987408
    m_Localized: "\uB300\uD68C\uC6A9 \uC0DD\uC218 \uBC15\uC2A4\uB97C \uCC98\uC74C\uC73C\uB85C \uB72F\uC5C8\uB2E4. \uD55C \uBCD1\uC744 \uD558\uB8E8\uC5D0 \uB098\uB220 \uB9C8\uC2DC\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987407
    m_Localized: "\uBC29\uC1A1\uC740 \uADF8\uAC8C \uB9C8\uC9C0\uB9C9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987406
    m_Localized: "\uBC29\uC1A1\uD558\uB358 \uBAA9\uC18C\uB9AC\uAC00 \uC911\uAC04\uC5D0 \uD55C \uBC88 \uB04A\uACBC\uB2E4\uAC00, \uAC19\uC740 \uBB38\uC7A5\uC744 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987405
    m_Localized: "\uB458\uC9F8 \uB0A0. \uD559\uAD50 \uBC29\uC1A1\uC774 \uC6B8\uB838\uB2E4. \uC218\uB3D7\uBB3C\uC744 \uB9C8\uC2DC\uC9C0 \uB9D0\uB77C\uB294 \uC548\uB0B4\uC600\uB2E4. \uC774\uC720\uB294 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706502
    m_Localized: "\uC9C0\uBD95\uC744 \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706503
    m_Localized: "\uC790\uC7AC\uB97C \uB367\uB300 \uC0C8\uB294 \uACF3\uC744 \uB9C9\uC558\uB2E4. \uC774\uBC88 \uC7A5\uB9C8\uB294 \uBC84\uD2F8 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987402
    m_Localized: "\uBC30\uAC00 \uACE0\uD320\uB2E4. \uC0DD\uC218 \uD55C \uBCD1\uC744 \uBC18\uCBE4 \uB9C8\uC2DC\uACE0 \uB69C\uAED1\uC744 \uAF2D \uB2EB\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987401
    m_Localized: "\uADF8\uB798\uC11C\uC600\uC744\uAE4C. \u2026\uC544\uB2C8\uB2E4. \uBB38\uC744 \uC7A0\uADFC \uAC74 \uADF8 \uC560\uB4E4\uC774\uC5C8\uB2E4. \uB0B4\uAC00 \uC5B4\uB5A4 \uC5BC\uAD74\uC744 \uD588\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987400
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uD6A1\uB2E8\uBCF4\uB3C4\uAC00 \uB5A0\uC62C\uB790\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uBA48\uCD94\uB358 \uC21C\uAC04. \uADF8 \uC560\uB4E4\uACFC \uB208\uC774 \uB9C8\uC8FC\uCE58\uB358 \uC21C\uAC04."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987399
    m_Localized: "{0}: \uB0B4\uC77C\uC740\u2026 \uB204\uAC00 \uC624\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987398
    m_Localized: "{0}: \uC624\uB298\u2026 \uB5A1\uBCF6\uC774 \uBA39\uAE30\uB85C \uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987397
    m_Localized: "\uC800\uB141 \uBB34\uB835 \uBCF5\uB3C4\uC5D0\uC11C \uB6F0\uC5B4\uAC00\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uBA87 \uBC88 \uC9C0\uB098\uAC14\uB2E4. \uBB38\uC744 \uB450\uB4DC\uB838\uC9C0\uB9CC, \uC544\uBB34\uB3C4 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987396
    m_Localized: "\uC624\uD6C4 \uB0B4\uB0B4 \uCCB4\uC721 \uC218\uC5C5\uC740 \uC5C6\uC5C8\uB2E4. \uACF5\uC744 \uAC00\uC9C0\uB7EC \uC624\uB294 \uC0AC\uB78C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987395
    m_Localized: "\uBC16\uC5D0\uC11C \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uBA40\uC5B4\uC9C0\uB358 \uAC83\uC744 \uAE30\uC5B5\uD55C\uB2E4. \uBB38\uC740 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987394
    m_Localized: "\uBC84\uD2F0\uC790. \uBB38\uC774 \uC5F4\uB9B4 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987393
    m_Localized: "{0}: \uCCB4\uC721 \uC2DC\uAC04\uC774 \uB418\uBA74 \uB204\uAC00 \uACF5 \uAC00\uC9C0\uB7EC \uC62C \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 777607644987392
    m_Localized: "{0}: \u2026\uB204\uAD70\uAC00 \uC624\uACA0\uC9C0. \uACE7."
    m_Metadata:
      m_Items: []
  - m_Id: 777607569489920
    m_Localized: "\uB192\uC740 \uACF3\uC5D0 \uC190\uBC14\uB2E5\uB9CC \uD55C \uD658\uAE30\uCC3D\uC774 \uD558\uB098. \uD558\uB298\uB9CC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757915
    m_Localized: "\uADF8\uB0E5 \uBC14\uB77C\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757914
    m_Localized: "\uC816\uC9C0 \uC54A\uC740 \uAC83\uB9CC \uACE8\uB77C \uC790\uB8E8\uC5D0 \uB2F4\uC558\uB2E4. \uACA8\uC6B8 \uBD88\uC3D8\uC2DC\uAC1C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757913
    m_Localized: "\uB099\uC5FD \uB354\uBBF8\uC5D0 \uB6F0\uC5B4\uB4E4\uACE0 \uC2F6\uC740 \uAC78 \uCC38\uC558\uB2E4. \uBC18\uCBE4\uC740 \uBABB \uCC38\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757912
    m_Localized: "\uAE01\uC5B4\uBAA8\uC544 \uB554\uAC10\uC73C\uB85C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757911
    m_Localized: "\uACE0\uC591\uC774\uC600\uB2E4. \uC5B4\uB514\uC120\uAC00 \uC798 \uC9C0\uB0B4\uB294 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757910
    m_Localized: "\uAE09\uC2DD\uC774 \uB2E4\uB140\uAC04 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757909
    m_Localized: "\uB099\uC5FD \uC704\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uB098 \uC788\uC5C8\uB2E4. \uC791\uACE0 \uAC00\uBCBC\uC6B4 \uBC1C\uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757908
    m_Localized: "\uC740\uD589\uC78E\uC774\uC5C8\uB2E4. \uB0C4\uC0C8\uAC00 \uC870\uAE08 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757907
    m_Localized: "\uBC24\uC0C8 \uBC14\uB78C\uC774 \uBD88\uB354\uB2C8 \uAD50\uC2E4 \uCC3D\uD2C0\uC5D0 \uB178\uB780 \uC78E\uC774 \uC218\uBD81\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757906
    m_Localized: "\uBC1F\uC744 \uB54C\uB9C8\uB2E4 \uBC14\uC2A4\uB77D \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC624\uB298\uB9CC\uD07C\uC740 \uADF8 \uC18C\uB9AC\uAC00 \uBB34\uC12D\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757905
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0 \uB099\uC5FD\uC774 \uBC1C\uBAA9\uAE4C\uC9C0 \uC313\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757904
    m_Localized: "\uC9C0\uC6B4 \uC790\uAD6D\uC740 \uADF8\uB798\uB3C4 \uD76C\uBBF8\uD558\uAC8C \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757903
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC73C\uBA70 '\uB9C8\uC9C0\uB9C9'\uC744 \uC9C0\uC6B0\uACE0 '\uB2E4\uC74C'\uC774\uB77C\uACE0 \uACE0\uCCD0 \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757902
    m_Localized: "{0}: \uB9C8\uC9C0\uB9C9\uC774\uB77C\uACE0 \uC4F0\uC9C0 \uB9C8\uC138\uC694. \uADF8\uB0E5 \uB2E4\uC74C \uC218\uC5C5\uC774\uB77C\uACE0 \uC368\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757901
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uAC19\uC740 \uB9D0 \uD558\uC9C0 \uB9D0\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757900
    m_Localized: "\uBE44\uC6CC \uB454 \uCE78 \uC704\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uC5F0\uD544\uB85C \uC544\uC8FC \uC791\uAC8C \uBB3C\uC74C\uD45C\uB97C \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757899
    m_Localized: "\uD558\uB098\uC529 \uACE0\uCCD0 \uB098\uAC14\uB2E4. \uC2DC, \uC18C\uC124, \uD3B8\uC9C0 \uC4F0\uAE30. \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9 \uCE78\uC740 \uBE44\uC6CC \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757898
    m_Localized: "\uAC19\uC774 \uACC4\uD68D\uD45C\uB97C \uB2E4\uB4EC\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174869
    m_Localized: "{0}: \uBC16\uC5D0 \uB098\uAC00\uB294 \uC0AC\uB78C\uC774 \uC4F0\uB7EC\uC9C0\uBA74 \uB2E4 \uAC19\uC774 \uAD76\uC5B4\uC694. \uADF8\uB7EC\uB2C8\uAE4C \uB098\uAC00\uB294 \uC0AC\uB78C \uBA3C\uC800\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757897
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4\uAC00 \uC544\uB2C8\uC5B4\uB3C4 \uB3FC. \uC694\uB9AC\uB4E0, \uBCC4\uC790\uB9AC\uB4E0. \uB124\uAC00 \uB098\uD55C\uD14C \uAC00\uB974\uCCD0 \uC8FC\uB294 \uAC70\uC5EC\uB3C4 \uC88B\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757896
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC740 \uB124\uAC00 \uC815\uD574. \uBB34\uC5C7\uC774\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757895
    m_Localized: "\uAE00\uC528\uAC00 \uAD70\uB370\uAD70\uB370 \uD754\uB4E4\uB824 \uC788\uC5C8\uB2E4. \uC5F4 \uB54C\uBB38\uC774\uB77C\uB294 \uAC78 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757894
    m_Localized: "\uCE60\uD310\uC5D0 \uC8FC\uCC28\uBCC4 \uB2E8\uC6D0\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uC904\uC5D0\uB294 '\uB9C8\uC9C0\uB9C9 \uC218\uC5C5 \u2014 \uC8FC\uC81C \uC790\uC720'."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757893
    m_Localized: "\uC885\uC774\uC5D0 \uC8FC\uCC28\uBCC4 \uB2E8\uC6D0\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uC904\uC5D0\uB294 '\uB9C8\uC9C0\uB9C9 \uC218\uC5C5 \u2014 \uC8FC\uC81C \uC790\uC720'."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757892
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC218\uC5C5 \uACC4\uD68D\uC744 \uC138\uC6E0\uB2E4. \uB0A8\uC740 \uC8FC \uC218\uC5D0 \uB9DE\uCDB0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757891
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uC544\uB798 \uD2C8\uC73C\uB85C \uC885\uC774 \uD55C \uC7A5\uC774 \uBC00\uB824 \uB098\uC654\uB2E4. \uBB38 \uB108\uBA38\uC5D0\uC11C \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757890
    m_Localized: "\uADF8\uAC8C \uCD94\uC704 \uB54C\uBB38\uC774\uAE30\uB97C \uBC14\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757889
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC624\uB298\uB530\uB77C \uC870\uAE08 \uC26C\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757888
    m_Localized: "\uC870\uC6A9\uD788 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757887
    m_Localized: "\uCE78\uC774 \uB2E4\uC12F \uAC1C\uC600\uB2E4. \uBAA9\uD45C, \uC900\uBE44\uBB3C, \uC2DC\uC791, \uD65C\uB3D9, \uB9C8\uBB34\uB9AC. \uB9C8\uBB34\uB9AC \uCE78\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uC368 \uB450\uC5C8\uB2E4. '\uC624\uB298 \uBC30\uC6B4 \uAC83\uC744 \uD55C \uBB38\uC7A5\uC73C\uB85C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757886
    m_Localized: "\uADF8\uB0A0 \uBC24, \uC120\uC0DD\uB2D8\uC740 \uC218\uC5C5 \uACC4\uD68D\uC11C \uC4F0\uB294 \uBC95\uC744 \uC54C\uB824 \uC8FC\uC5C8\uB2E4. \uC9C4\uC9DC \uAD50\uC0AC\uB4E4\uC774 \uC4F0\uB294 \uC591\uC2DD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757885
    m_Localized: "\uADF8 \uBC29\uBC95\uC744 \uB354 \uC54C\uB824 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757884
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC5D0\uB294 \uB0B4\uAC00 \uB108\uD55C\uD14C\uC11C \uAEBC\uB0C8\uC9C0. \uC774\uC81C \uB124 \uCC28\uB840\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757883
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uB974\uCE5C\uB2E4\uB294 \uAC74 \uB9D0\uC774\uC57C, \uB0B4\uAC00 \uC544\uB294 \uAC78 \uC8FC\uB294 \uAC8C \uC544\uB2C8\uB77C \uC0C1\uB300\uAC00 \uC774\uBBF8 \uAC00\uC9C4 \uAC78 \uAEBC\uB0B4 \uC8FC\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757882
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC8C \uBE44\uACB0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757881
    m_Localized: "{0}: \uADF8\uB0E5\u2026 \uC81C\uAC00 \uD5F7\uAC08\uB838\uB358 \uB370\uBD80\uD130 \uB9D0\uD574 \uC900 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757880
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uB09C\uBC88\uC5D0 \uB124\uAC00 \uB098\uD55C\uD14C \uBB3C \uAC70\uB974\uB294 \uBC95 \uC124\uBA85\uD574 \uC900 \uAC70 \uC788\uC9C0. \uB0B4 \uC218\uC5C5\uBCF4\uB2E4 \uC26C\uC6E0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757879
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uD604\uC774\uAC00 \uADF8\uB7EC\uB354\uB77C. \uB124\uAC00 \uAC00\uB974\uCCD0 \uC900 \uC218\uD559\uC774 \uD559\uC6D0\uBCF4\uB2E4 \uB0AB\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757878
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB300\uC2E0 \uD558\uB098\uB9CC \uC57D\uC18D\uD574. '\uADF8\uB2E4\uC74C'\uC774\uB77C\uB294 \uB9D0\uC744 \uBB34\uC11C\uC6CC\uD558\uC9C0 \uC54A\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757877
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAB0\uB77C\uB3C4 \uB3FC. \uBAA8\uB974\uB294 \uAC78 \uC544\uB294 \uAC83\uB3C4 \uACF5\uBD80\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757876
    m_Localized: "\uC544\uC9C1 \uBAA8\uB974\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757875
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC77C\uC744 \uD558\uAC8C \uB418\uBA74, \uB098\uD55C\uD14C \uC81C\uC77C \uBA3C\uC800 \uC54C\uB824 \uC918. \uC5B4\uB514\uC11C\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757874
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC740 \uB300\uB2F5\uC774\uB2E4. \uC815\uD655\uD788 \uBAA8\uB97C \uB54C \uD558\uB294 \uB300\uB2F5 \uC911\uC5D0 \uC81C\uC77C \uC88B\uC740 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757873
    m_Localized: "{0}: \uC544\uC9C1 \uC815\uD655\uD788\uB294 \uBAA8\uB974\uACA0\uB294\uB370\uC694. \uB204\uAD70\uAC00\uB97C \uB3D5\uB294 \uC77C\uC774\uBA74 \uC88B\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826537
    m_Localized: "\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uD749\uD130\uB9CC \uD55C\uCC38 \uB208\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706466
    m_Localized: "{0}: \u2026\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757872
    m_Localized: "\uD558\uACE0 \uC2F6\uC740 \uAC8C \uC0DD\uACBC\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757871
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098? \uB098\uB294\u2026 \uB108 \uBA3C\uC800 \uB9D0\uD574. \uC219\uC81C\uB294 \uD559\uC0DD\uC774 \uBA3C\uC800 \uB0B4\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757870
    m_Localized: "{0}: \uC120\uC0DD\uB2D8\uC740\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757869
    m_Localized: "\uCC3D\uACE0\uC5D0 \uAC07\uD600 \uC788\uB358 \uC77C\uC8FC\uC77C \uB3D9\uC548\uC740 \uB0B4\uC77C\uAE4C\uC9C0\uB9CC \uC0DD\uAC01\uD588\uB2E4. \uBD04\uC5D0\uB294 \uB2E4\uC74C \uC8FC\uAE4C\uC9C0. \uC9C0\uAE08\uC740\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757868
    m_Localized: "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC9C8\uBB38\uC774\uC5C8\uB2E4. \uADF8\uB2E4\uC74C, \uC774\uB77C\uB294 \uB9D0\uC744 \uC624\uB79C\uB9CC\uC5D0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757867
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC8C \uB2E4 \uB05D\uB098\uBA74, \uADF8\uB2E4\uC74C\uC5D4 \uBB50 \uD558\uACE0 \uC2F6\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757866
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6C\uC870\uB300\uAC00 \uC624\uBA74, \uADF8\uB2E4\uC74C\uC5D4 \uBB50 \uD558\uACE0 \uC2F6\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757865
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB4E4\uB3C4 \uC5B4\uB518\uAC00\uC5D0\uC11C, \uC624\uB298\uC774 \uBB34\uC2A8 \uB0A0\uC778\uC9C0 \uAE30\uC5B5\uD558\uACE0 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757864
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC774\uC57C\uAE30\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uCC3D\uBC16\uC744 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757863
    m_Localized: "\uAD6D\uC5B4 \uC601\uC5ED 1\uBC88\uBD80\uD130. \uBC18\uB3C4 \uBABB \uD480\uC5C8\uC9C0\uB9CC, \uB05D\uAE4C\uC9C0 \uC549\uC544 \uC788\uC5C8\uB2E4. 100\uBD84 \uB3D9\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757862
    m_Localized: "\uB0A8\uC544 \uC788\uB358 \uC2DC\uD5D8\uC9C0\uB97C \uD480\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757861
    m_Localized: "\uB9E8 \uB05D \uCC45\uC0C1\uC758 \uC218\uD5D8\uD45C\uC5D0\uB294 \uC0AC\uC9C4 \uC606\uC5D0 \uC791\uC740 \uBCC4 \uC2A4\uD2F0\uCEE4\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uD589\uC6B4\uC744 \uBE4C\uC5B4 \uC900 \uB204\uAD70\uAC00\uAC00 \uC788\uC5C8\uB358 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757860
    m_Localized: "\uB204\uAD70\uAC00 \uB3CC\uC544\uC624\uBA74 \uCC3E\uAE30 \uC27D\uAC8C. \uADF8\uB7F0 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757859
    m_Localized: "\uC218\uD5D8\uD45C\uB97C \uD558\uB098\uD558\uB098 \uAC00\uC9C0\uB7F0\uD788 \uB193\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757858
    m_Localized: "\uCE60\uD310 \uADC0\uD241\uC774\uC5D0 'D-247'\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uADF8 \uC22B\uC790\uB97C \uC904\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757857
    m_Localized: "\uC8FC\uC778 \uC5C6\uB294 \uC0AC\uC9C4 \uC218\uC2ED \uC7A5\uC774 \uC774\uCABD\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757856
    m_Localized: "3\uD559\uB144 \uAD50\uC2E4\uC5D0 \uB4E4\uC5B4\uAC00 \uBD24\uB2E4. \uCC45\uC0C1\uB9C8\uB2E4 \uC218\uD5D8\uD45C\uAC00 \uB4E0 \uD22C\uBA85 \uD30C\uC77C\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uBBF8\uB9AC \uB098\uB220 \uC900 \uAC83\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757855
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uC218\uB2A5\uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757854
    m_Localized: "\uD3EC\uC2A4\uD130\uB97C \uAD50\uC2E4 \uBB38\uC5D0 \uBD99\uC600\uB2E4. \uC190\uB2D8\uC740 \uC624\uC9C0 \uC54A\uC558\uC9C0\uB9CC, \uBB38\uC774 \uC870\uAE08 \uB35C \uC4F8\uC4F8\uD574 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757853
    m_Localized: "'1\uD559\uB144 3\uBC18 \uB5A1\uBCF6\uC774 \u2014 \uB9DB\uC5C6\uC73C\uBA74 \uD658\uBD88'. \uB2E4 \uADF8\uB9AC\uACE0 \uB098\uC11C {0} \uC0DD\uAC01\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757852
    m_Localized: "\uADF8\uB54C \uADF8\uB9AC\uB824\uB358 \uD3EC\uC2A4\uD130\uB97C \uADF8\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757851
    m_Localized: "\uBC15\uC218 \uC18C\uB9AC\uAC00 \uD145 \uBE48 \uAC15\uB2F9\uC5D0 \uD06C\uAC8C \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757850
    m_Localized: "\uB098\uB294 \uC2DC\uB97C \uC77D\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uBC30\uC6B4 \uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757849
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uBB34\uB300\uC5D0 \uC624\uB974\uC9C0 \uC54A\uC558\uC9C0\uB9CC, \uB9E8 \uC55E\uC904\uC5D0\uC11C \uC81C\uC77C \uD06C\uAC8C \uBC15\uC218\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757848
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB178\uB798\uB97C \uD588\uB2E4. \uC758\uC678\uB85C \uD2B8\uB85C\uD2B8\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757847
    m_Localized: "\uB3C4\uD604\uC740 \uB9AC\uCF54\uB354\uB97C \uBD88\uC5C8\uB2E4. \uC74C\uC774 \uC138 \uBC88 \uD2C0\uB838\uACE0, \uC138 \uBC88 \uB2E4 \uB2F9\uB2F9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757846
    m_Localized: "\uAC15\uB2F9\uC5D0\uC11C \uC791\uC740 \uBC1C\uD45C\uD68C\uB97C \uC5F0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757845
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD95\uC81C\uB294 \uC6D0\uB798 \uC900\uBE44\uD560 \uB54C\uAC00 \uC81C\uC77C \uC7AC\uBC0C\uC5B4. \uC624\uB298 \uD558\uB8E8, \uC900\uBE44\uD574 \uBCFC\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757844
    m_Localized: "\uACC4\uD68D\uD45C \uADC0\uD241\uC774\uC5D0 \uB204\uAC00 \uB099\uC11C\uCC98\uB7FC \uC801\uC5B4 \uB193\uC558\uB2E4. '3\uBC18 1\uB4F1 \uAC00\uC988\uC544'."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757843
    m_Localized: "1\uD559\uB144 3\uBC18, \uB5A1\uBCF6\uC774 \uAC00\uAC8C. \uB0B4 \uC774\uB984\uB3C4 \uAC70\uAE30 \uC788\uC5C8\uB2E4. \uB2F4\uB2F9\uC740 \uD3EC\uC2A4\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786211
    m_Localized: "\uBC24\uC5D0 \uBC88\uAC08\uC544 \uC9C0\uD0A4\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786210
    m_Localized: "\uB9E4\uB4ED\uC744 \uC138 \uBC88\uC529 \uD655\uC778\uD588\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uC73C\uB85C \uB2F9\uACA8 \uBCF4\uB354\uB2C8 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174870
    m_Localized: "\uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC5C8\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC740 \uADF8 \uC6D0\uCE59\uC744 \uC57D\uC7A5 \uBB38\uC5D0 \uC801\uC5C8\uB2E4. \uAE00\uC528\uAC00 \uC870\uAE08 \uB531\uB531\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757842
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uD559\uAD50 \uCD95\uC81C \uB0A0\uC774\uC5C8\uB2E4. \uAD50\uBB34\uC2E4 \uAC8C\uC2DC\uD310\uC5D0 \uBC18\uBCC4 \uBD80\uC2A4 \uACC4\uD68D\uD45C\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757841
    m_Localized: "\uB0B4\uB824\uC624\uB294\uB370 \uB204\uAD70\uAC00 \uB2EC \uBD24\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4. \uBD24\uB2E4\uACE0 \uD588\uB2E4. \uCEF8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757840
    m_Localized: "\uB2EC\uC774 \uCEF8\uB2E4. \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4. \uBB34\uC5C7\uC744 \uBE4C\uC5C8\uB294\uC9C0\uB294 \uC77C\uAE30\uC5D0\uB3C4 \uC801\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757839
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uBCF4\uB984\uB2EC\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757838
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC0C1 \uC55E\uC5D0\uC11C \uC7A0\uAE50 \uB208\uC744 \uAC10\uC558\uB2E4. \uB204\uAD6C\uB97C \uC0DD\uAC01\uD558\uB294\uC9C0\uB294 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757837
    m_Localized: "\uB3C4\uD604\uC774 \"\uC81C\uAC00 \uC81C\uC77C \uD070 \uC870\uAC01\" \uD558\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757836
    m_Localized: "\uAE09\uC2DD\uC2E4\uC5D0 \uC0C1\uC744 \uD3B4\uACE0 \uB2E4 \uAC19\uC774 \uB458\uB7EC\uC549\uC558\uB2E4. \uD1B5\uC870\uB9BC \uAF41\uCE58, \uC300\uBC25, \uADF8\uB9AC\uACE0 \uC0AC\uACFC \uD558\uB098\uB97C \uC0AC\uB78C \uC218\uB300\uB85C \uB098\uB220\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757835
    m_Localized: "\uC544\uAEF4 \uB454 \uD1B5\uC870\uB9BC\uC73C\uB85C \uC0C1\uC744 \uCC28\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757834
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC1A1\uD3B8\uC740 \uBABB \uBE5A\uC5B4\uB3C4 \uC0C1\uC740 \uCC28\uB9B4 \uC218 \uC788\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757833
    m_Localized: "\uB77C\uB514\uC624\uC5D0\uC11C DJ\uAC00 \uB2E4\uB4E4 \uACE0\uD5A5 \uC0DD\uAC01\uB098\uC8E0, \uD558\uACE0 \uB9D0\uD558\uB2E4\uAC00 \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757832
    m_Localized: "\uC624\uB298\uC740 \uCD94\uC11D\uC774\uC5C8\uB2E4. \uC6D0\uB798\uB77C\uBA74 \uD560\uBA38\uB2C8 \uB301\uC5D0\uC11C \uC1A1\uD3B8\uC744 \uBE5A\uC5C8\uC744 \uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757831
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0 \uB3CC\uC544\uC130\uB2E4. \uCEF5\uC740 \uB450\uACE0 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757830
    m_Localized: "\uADF8\uAC78\uB85C \uCDA9\uBD84\uD588\uB2E4. \uC9C0\uAE08\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757829
    m_Localized: "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uACE0\uAC1C\uB9CC \uB044\uB355\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757828
    m_Localized: "\uCEF5\uC758 \uBB3C\uC774 \uC544\uC9C1 \uB530\uB73B\uD588\uB2E4. \uB2E4 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757827
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C \uB0B4 \uB208\uC744 \uB611\uBC14\uB85C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757826
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC. \uB2A6\uC5B4\uB3C4 \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757825
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757824
    m_Localized: "\uC1A1\uC608\uC9C0: \uB098, \uC774\uBC88\uC5D0\uB294 \uB124 \uD3B8\uC774\uC57C. \uB2A6\uC5C8\uC9C0\uB9CC. \uADF8\uAC70 \uB9D0\uD558\uACE0 \uC2F6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757823
    m_Localized: "\uC1A1\uC608\uC9C0: \uC608\uC804\uC5D0 \uB098\uB294 \uB298 \uD558\uB9B0\uC774 \uC606\uC5D0 \uC11C \uC788\uC5C8\uC796\uC544. \uC6C3\uC9C0\uB3C4, \uB9D0\uB9AC\uC9C0\uB3C4 \uC54A\uACE0. \uADF8\uAC8C \uC81C\uC77C \uC26C\uC6B4 \uC790\uB9AC\uC600\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757822
    m_Localized: "\uC1A1\uC608\uC9C0: \uD558\uB9B0\uC774\uB294\u2026 \uC548 \uC654\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757821
    m_Localized: "\uC1A1\uC608\uC9C0: \uC5EC\uAE30 \uB370\uB824\uC628 \uAC83\uB3C4 \uBD24\uC5B4. \uB098 \uAC19\uC73C\uBA74 \uBABB \uD588\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757820
    m_Localized: "\uC1A1\uC608\uC9C0: \uD558\uB9B0\uC774 \uB9CC\uB0AC\uB2E4\uBA74\uC11C. \u2026\uAD1C\uCC2E\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757819
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uC870\uC6A9\uD788 \uB2E4\uAC00\uC654\uB2E4. \uC190\uC5D0 \uB530\uB73B\uD55C \uBB3C \uD55C \uCEF5\uC744 \uB4E4\uACE0 \uC788\uC5C8\uB2E4. \uB0B4 \uC55E\uC5D0 \uB0B4\uB824\uB193\uACE0\uB3C4 \uBC14\uB85C \uAC00\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786209
    m_Localized: "\uB0A8\uC740 \uC790\uC7AC\uB85C \uBB38 \uC55E \uCC45\uC0C1\uC744 \uC774\uC911\uC73C\uB85C \uBB36\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786208
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC\uBD80\uD130 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174871
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uD310\uB2E8\uD574 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757818
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB3C4\uD604\uC740 \uB0B4 \uC606\uC790\uB9AC\uC5D0 \uC774\uBD88\uC744 \uD3C8\uB2E4. \uC544\uBB34 \uB9D0 \uC5C6\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757817
    m_Localized: "\uB3C4\uD604\uC740 \uD55C\uCC38 \uC6B8\uC5C8\uB2E4. \uB2E4 \uC6B8\uACE0 \uB098\uC11C \uACE0\uB9D9\uB2E4\uACE0 \uD588\uB2E4. \uC194\uC9C1\uD558\uAC8C \uB9D0\uD574 \uC918\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757816
    m_Localized: "\uBAA8\uB978\uB2E4\uACE0, \uADF8\uB798\uB3C4 \uAC19\uC774 \uAE30\uB2E4\uB9AC\uC790\uACE0 \uC194\uC9C1\uD558\uAC8C \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757815
    m_Localized: "\uB3C4\uD604\uC740 \uD55C\uCC38 \uCC3D\uBC16 \uB0A8\uCABD\uC744 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757814
    m_Localized: "\uB3C4\uD604\uC740 \uAC00\uC2B4 \uC8FC\uBA38\uB2C8\uC758 \uCABD\uC9C0\uB97C \uD55C \uBC88 \uB9CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757813
    m_Localized: "\uB3C4\uD604: \uD30C\uB780 \uB9AC\uBCF8\uC774\uC694. \uD0D0\uD5D8 \uB098\uAC00\uBA74, \uD639\uC2DC \uBCF4\uC774\uBA74 \uC54C\uB824 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757812
    m_Localized: "\uB3C4\uD604: \u2026\uB124. \uADF8\uB807\uC8E0. \uC5C4\uB9C8\uB294 \uC6D0\uB798 \uAE38 \uC798 \uCC3E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757811
    m_Localized: "\uBD84\uBA85 \uC0B4\uC544 \uC788\uC744 \uAC70\uB77C\uACE0 \uB9D0\uD574 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757810
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC84C\uB2E4. \uB300\uB2F5\uC744 \uAE30\uB2E4\uB9AC\uB294 \uB208\uC774 \uB098\uB97C \uD5A5\uD574 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757809
    m_Localized: "\uB3C4\uD604: \uC774\uB3D9\uD588\uB2E4\uB294 \uAC70\uC8E0? \uB2E4 \uC8FD\uC740 \uAC8C \uC544\uB2C8\uB77C. \uC774\uB3D9\uD55C \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757808
    m_Localized: "\uB3C4\uD604\uC774 \uBB34\uC804\uAE30 \uC55E\uC5D0\uC11C \uAD73\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757807
    m_Localized: "DJ: \uB300\uD53C\uC18C \uC0AC\uB78C\uB4E4\uC774 \uAE38\uBAA8\uD241\uC774\uB9C8\uB2E4 \uD30C\uB780 \uB9AC\uBCF8\uC744 \uBB36\uC5B4 \uB450\uACE0 \uAC14\uB300\uC694. \uADF8\uAC78 \uB530\uB77C\uAC00\uBA74 \uB41C\uB300\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923665
    m_Localized: "\uB208\uC744 \uAC10\uC558\uB2E4 \uB728\uACE0, \uAD6D\uC790\uBD80\uD130 \uB2E4\uC2DC \uCC3E\uC558\uB2E4. \uC138 \uBC88\uC9F8\uC5D0 \uC190\uAC00\uB77D\uC774 \uADF8 \uBCC4\uC5D0 \uB2FF\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706452
    m_Localized: "\uC6B0\uB9AC\uB294 \uB9D0\uC5C6\uC774 \uADF8\uB987 \uBC14\uB2E5\uC774 \uBCF4\uC77C \uB54C\uAE4C\uC9C0 \uBA39\uC5C8\uB2E4. \uBC30\uBCF4\uB2E4 \uC190\uC774 \uBA3C\uC800 \uB530\uB73B\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340765
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uC878\uC5C5\uC2DD \uB0A0\uC774\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uD559\uAE30\uC758 \uB9C8\uC9C0\uB9C9 \uD589\uC0AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174805
    m_Localized: "{0}\uC758 \uC5BC\uAD74\uC774 \uACB9\uCCD0 \uBCF4\uC600\uB2E4. \uADF8 \uC560\uB3C4 \uC5B4\uB518\uAC00\uC5D0\uC11C \uC774\uB7F0 \uB9D0\uC744 \uACE0\uB974\uACE0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340764
    m_Localized: "\uC885\uC774\uB97C \uC811\uC5B4 \uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4. \uC783\uC5B4\uBC84\uB9AC\uBA74 \uC548 \uB418\uB294 \uAC83\uB4E4\uC774 \uBAA8\uC774\uB294 \uACF3."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340763
    m_Localized: "\uC14B\uC744 \uC4F0\uB824\uB2E4 \uD39C\uC744 \uBA48\uCDC4\uB2E4. \uC14B\uC9F8\uB294 \uC544\uC9C1 \uC4F8 \uC218 \uC5C6\uC5C8\uB2E4. \uC368 \uBC84\uB9AC\uBA74 \uC774\uB8E8\uC5B4\uC9C0\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340762
    m_Localized: "\uC885\uC774 \uD55C \uC7A5\uC5D0 \uC801\uC5C8\uB2E4. \uD558\uB098, \uC0B4\uC544\uB0A8\uAE30. \uB458, \uADF8\uB2E4\uC74C\uC5D0 \uD558\uACE0 \uC2F6\uC740 \uAC78 \uCC3E\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340761
    m_Localized: "\uC0C8\uD574 \uACB0\uC2EC\uC744 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340760
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC791\uB144 \uD574\uB3CB\uC774\uB294 \uC774\uBD88 \uC18D\uC5D0\uC11C \uD734\uB300\uD3F0\uC73C\uB85C \uBD24\uB2E4. \uC774\uAC8C \uB0AB\uB2E4. \uD6E8\uC52C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340759
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC26C\uC5C4\uC26C\uC5C4 \uC62C\uB77C\uC640 \uB09C\uAC04\uC744 \uBD99\uC7A1\uACE0 \uD574\uB97C \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340758
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD574\uAC00 \uC774\uB807\uAC8C \uCEF8\uB098. \uC791\uB144\uC5D4 \uC774\uBD88 \uC18D\uC5D0\uC11C \uBD24\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340757
    m_Localized: "\uC120\uC0DD\uB2D8 \uBAAB\uC73C\uB85C \uD734\uB300\uD3F0 \uC0AC\uC9C4\uC744 \uD55C \uC7A5 \uCC0D\uC5C8\uB2E4. \uB0B4\uB824\uAC00\uC11C \uBCF4\uC5EC \uB4DC\uB9AC\uC790 \uC120\uC0DD\uB2D8\uC774 \uD654\uBA74\uC744 \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460303
    m_Localized: "\uD574 \uC9C8 \uB158 \uC625\uC0C1. \uB09C\uAC04 \uB108\uBA38\uB85C \uAD50\uBB38 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4\uAC00 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826535
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uB2F4\uC694\uB97C \uB04C\uC5B4\uC62C\uB838\uB2E4. \uAD1C\uCC2E\uB2E4\uB294 \uB9D0\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uC27D\uAC8C \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706458
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC544\uC8FC \uC791\uAC8C, \uC785\uC548\uC5D0\uC11C\uB9CC \uAD50\uAC00\uB97C \uD765\uC5BC\uAC70\uB838\uB2E4. \uAC00\uC0AC\uB294 \uC5C6\uC774 \uAC00\uB77D\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706459
    m_Localized: "{0}: \uADF8 \uB178\uB798 \uC2EB\uC5B4\uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706460
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB4E4 \uADF8\uB798. \u2026\uADFC\uB370 \uC9C0\uAE08 \uB4E4\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174817
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uD45C\uC2DC\uB294, \uB2E4\uC74C\uC740 \uC5EC\uAE30\uB77C\uB294 \uB73B\uC77C \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706461
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uAC04\uD45C. \uAD50\uC2E4\uC774 \uC0DD\uACBC\uC73C\uB2C8\uAE4C, \uC218\uC5C5\uB3C4 \uC81C\uB300\uB85C \uD574\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460297
    m_Localized: "\"\uC798 \uBD24\uC5B4. \uBB34\uC11C\uC6E0\uB294\uB370\uB3C4, \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uC558\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460296
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uC5D0\uAC8C \uD55C\uB9C8\uB514 \uD560 \uC218 \uC788\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460295
    m_Localized: "\uADF8 \uB4A4\uB85C \uC0AC\uB78C\uB4E4\uC758 \uC5BC\uAD74\uC744 \uBD24\uB2E4. \uBCF8 \uAC83\uC744 \uB9D0\uD558\uB294 \uBC95\uB3C4, \uC870\uAE08\uC740 \uBC30\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460294
    m_Localized: "\uB9C8\uD2B8 \uCC3D\uACE0\uC5D0\uC11C \uADF8 \uC560\uC640 \uB9C8\uC8FC \uC130\uB2E4. \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uACE0. \uADF8\uB9AC\uACE0 \uB0B4 \uCABD\uC5D0\uC11C \uC815\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174818
    m_Localized: "\uD45C\uC2DC\uB97C \uC9C0\uC6B0\uACE0, \uAD50\uBB38\uC744 \uB354 \uB2E8\uB2E8\uD788 \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460293
    m_Localized: "\uADF8 \uC560\uB294 \uC9C0\uAE08 \uC544\uB798\uCE35\uC5D0\uC11C \uC591\uB3D9\uC774\uB97C \uB098\uB974\uACE0 \uC788\uB2E4. \uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uB294 \uC774\uB7F0 \uB0A0\uC744 \uC0C1\uC0C1\uB3C4 \uBABB \uD588\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460292
    m_Localized: "\uB9C8\uD2B8 \uCC3D\uACE0\uC5D0\uC11C, \uD558\uACE0 \uC2F6\uB358 \uB9D0\uC744 \uB05D\uAE4C\uC9C0 \uD588\uB2E4. \uB300\uB2F5\uC740 \uC5C6\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uADF8 \uB9D0\uC740 \uC774\uC81C \uB0B4 \uC548\uC5D0 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460291
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uC800\uAE30\uC11C, \uB098\uB294 \uADF8 \uBB34\uB9AC\uB97C \uB611\uBC14\uB85C \uBD24\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uBA48\uCDC4\uACE0, \uC2EC\uC7A5\uC774 \uADC0\uC5D0\uC11C \uB6F0\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460290
    m_Localized: "\uD574 \uC9C8 \uB158 \uC625\uC0C1. \uB09C\uAC04\uC5D0 \uAE30\uB300\uC5B4 \uAD50\uBB38 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4\uB97C \uB0B4\uB824\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826536
    m_Localized: "\uACB0\uAD6D \uB0A8\uC740 \uAC83\uB3C4 \uBC84\uB824\uC57C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706462
    m_Localized: "\uAD6D\uC5B4, \uC0DD\uC874, \uC751\uAE09\uCC98\uCE58. \uADF8\uB9AC\uACE0 \uB9E8 \uC544\uB798\uC5D0 \uC0C8\uB85C \uC801\uD78C \uCE78. \uACFC\uD559, \uC74C\uC545, \uACF5\uD559."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146567
    m_Localized: "\uBE68\uAC04 \uD39C\uC73C\uB85C \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uB450 \uBC88, \uC138 \uBC88. \uD39C \uB05D\uC774 \uC885\uC774\uB97C \uB6AB\uC744 \uBED4\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146566
    m_Localized: "\uB3C4\uC11C\uAD00\uC5D0\uC11C \uAC00\uC838\uC628 \uC2DC\uB0B4 \uC9C0\uB3C4\uB97C \uAD50\uC2E4 \uBC14\uB2E5\uC5D0 \uD3BC\uCCE4\uB2E4. \uAC15\uBCC0\uC758 \uC0C8\uBCBD\uC815\uC218\uC7A5. \uADF8 \uC606\uC758 \uC791\uC740 \uAC74\uBB3C, \uC5F0\uAD6C\uB3D9."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706453
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 '\uBB3C\uC758 \uB053\uB294\uC810' \uB2E8\uC6D0\uC744 \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uC5C8\uB2E4. \uC2DC\uB97C \uC77D\uC744 \uB54C\uC640 \uB611\uAC19\uC740 \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460325
    m_Localized: "\uC5EC\uAE30\uC11C \uBCF4\uB2C8 \uAD50\uC2E4\uB3D9 \uCC3D\uBB38 \uD558\uB098\uD558\uB098\uAC00, \uD558\uB098\uC529 \uD574\uB0B8 \uC77C \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460324
    m_Localized: "\uC625\uC0C1 \uB09C\uAC04 \uC544\uB798\uB85C \uD559\uAD50\uAC00 \uB2E4 \uBCF4\uC600\uB2E4. \uC6B0\uB9AC\uAC00 \uC9C0\uB098\uC628 \uAE38\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460323
    m_Localized: "\uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00 \uB3C4\uC2DC\uB77D\uC744 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174813
    m_Localized: "\uAEBC\uC9C4 \uC2E0\uD638\uB4F1 \uAE30\uB465\uB9C8\uB2E4 \uBD89\uC740 \uD398\uC778\uD2B8\uB85C \uAC19\uC740 \uD45C\uC2DC\uAC00 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4. \uB3D9\uADF8\uB77C\uBBF8 \uC548\uC5D0 \uC5D1\uC2A4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980511
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78 \uC154\uCE20 \uC8FC\uBA38\uB2C8\uC5D0 \uAF42\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174951
    m_Localized: "\uB2ED\uC740 \uC5C6\uC5C8\uB2E4. \uB2ED\uAC00\uC2B4\uC0B4 \uD1B5\uC870\uB9BC \uD558\uB098\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340756
    m_Localized: "\uC625\uC0C1 \uACC4\uB2E8 \uC5F4\uC5EC\uC12F \uCE78\uC744 \uC62C\uB790\uB2E4. \uD574\uAC00 \uAC15 \uB108\uBA38\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC62C\uB77C\uC654\uB2E4. \uC190\uC774 \uC5BC\uC5C8\uC9C0\uB9CC \uB05D\uAE4C\uC9C0 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146565
    m_Localized: "\uB2E4\uB4E4 \uC190\uAC00\uB77D\uC744 \uD3C8\uB2E4. \uD558\uC9C0\uB9CC \uADF8\uB0A0 \uBC24, \uC544\uBB34\uB3C4 \uADF8 \uC22B\uC790\uB97C \uC78A\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146564
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB798. \uADF8\uB54C \uAC00\uC11C. \uB2E4\uB9CC \uADF8\uB54C\uB294 \uAF2D \uC138\uC57C \uD55C\uB2E4. \uD53C\uD558\uBA74 \uB0A8\uC774 \uB300\uC2E0 \uC13C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146563
    m_Localized: "{0}: \uC544\uC9C1 \uB450 \uB2EC\uB3C4 \uB118\uAC8C \uB0A8\uC558\uC5B4\uC694. \uADF8\uB54C \uAC00\uC11C \uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786257
    m_Localized: "\uC7A0\uC774 \uC624\uC9C0 \uC54A\uB294 \uBC24\uC774\uC5C8\uB2E4. \uCC3D\uD2C0\uC5D0 \uAE30\uB300\uC5B4 \uBC14\uAE65\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786256
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uCD9C\uC11D\uBD80\uB97C \uC11C\uB78D \uB9E8 \uC548\uCABD\uC5D0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174840
    m_Localized: "\uADF8\uB0A0 \uBC24 \uCC98\uC74C\uC73C\uB85C, \uAD50\uBB38 \uCABD\uC5D0\uC11C \uB4E4\uB9AC\uB294 \uBAA8\uB4E0 \uC18C\uB9AC\uC5D0 \uC7A0\uC774 \uAE7C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146562
    m_Localized: "\uC544\uC9C1\uC740 \uC138\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146561
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798 \uC801\uC5C8\uB2E4. \uB2E4\uB9CC \uADF8 \uC885\uC774\uB294 \uB05D\uAE4C\uC9C0 \uC5F0\uD544\uB85C \uB46C\uB77C. \uC9C0\uC6B8 \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980497
    m_Localized: "\uC77C\uACF1 \uAC1C. \uD559\uAD50 \uB2E4\uB2D0 \uB54C\uB294 \uBC1B\uC544 \uBCF8 \uC801 \uC5C6\uB294 \uC22B\uC790\uC600\uB2E4. \uC2DC\uD5D8\uC9C0\uB97C \uD55C \uBC88 \uB354 \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923664
    m_Localized: "\uD63C\uC790\uC11C \uBD81\uCABD\uC744 \uB2E4\uC2DC \uCC3E\uC544\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923663
    m_Localized: "\uC720\uB791\uC790: \uC800\uAC8C \uBD81\uCABD\uC774\uB2E4. \uC800\uAC74 \uC548 \uC6C0\uC9C1\uC5EC. \uC138\uC0C1\uC774 \uC774\uB798\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146560
    m_Localized: "\uB2E4 \uC801\uACE0 \uB098\uB2C8 \uADF8 \uC885\uC774\uAC00 \uBB34\uC11C\uC6E0\uB2E4. \uBC18\uC73C\uB85C \uC811\uC5B4 \uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146559
    m_Localized: "\uC885\uC774\uC5D0 \uC5EC\uB35F \uCE78\uC744 \uADF8\uB838\uB2E4. \uC774\uB984\uC744 \uD558\uB098\uC529 \uC801\uC5C8\uB2E4. \uB0A8\uB294 \uCE78\uC740 \uB0A8\uB294 \uB300\uB85C, \uBAA8\uC790\uB77C\uBA74 \uBAA8\uC790\uB780 \uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146558
    m_Localized: "\uC5EC\uB35F \uCE78\uC744 \uADF8\uB9AC\uACE0 \uBA85\uB2E8\uC744 \uBBF8\uB9AC \uC801\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923662
    m_Localized: "\uADF8\uC758 \uC190\uAC00\uB77D\uC744 \uB530\uB77C\uAC00\uB2C8 \uD63C\uC790 \uC870\uC6A9\uD788 \uB5A0 \uC788\uB294 \uBCC4 \uD558\uB098\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923661
    m_Localized: "\uC720\uB791\uC790: \uC9C0\uB3C4\uAC00 \uC5C6\uC5B4\uB3C4 \uAE38\uC740 \uCC3E\uB294\uB2E4. \uC800\uAE30, \uAD6D\uC790 \uBAA8\uC591 \uBCF4\uC774\uC9C0. \uB05D\uC758 \uB450 \uBCC4\uC744 \uC774\uC5B4\uC11C \uB2E4\uC12F \uBC30\uB9CC\uD07C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923660
    m_Localized: "\uB0B4\uAC00 \uC606\uC5D0 \uC549\uC790, \uADF8\uAC00 \uCC98\uC74C\uC73C\uB85C \uBAA8\uC790\uB97C \uB4A4\uB85C \uC816\uD614\uB2E4. \uD587\uBCD5\uC5D0 \uADF8\uC744\uB9B0, \uC8FC\uB984 \uAE4A\uC740 \uC5BC\uAD74\uC774\uC5C8\uB2E4. \uB208\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uC21C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923659
    m_Localized: "\uADF8\uB0A0 \uBC24, \uC720\uB791\uC790\uB294 \uBC14\uB85C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4. \uD604\uAD00 \uC55E \uACC4\uB2E8\uC5D0 \uC549\uC544 \uD558\uB298\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uC815\uC804\uB41C \uB3D9\uB124 \uC704\uB85C \uBCC4\uC774 \uC3DF\uC544\uC9C8 \uB4EF \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923658
    m_Localized: "\uC720\uB791\uC790: \uB2E8 \uAC70 \uBA39\uC73C\uBA74\uC11C \uC9C0\uB3C4 \uBCF4\uB294 \uAC70, \uC0B0\uC5D0\uC11C \uD558\uB358 \uBC84\uB987\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340755
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uD574\uB3CB\uC774\uB97C \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711633
    m_Localized: "\uB3C4\uD604: \uB9DD \uBCF4\uB294 \uAC70\uC694. \uC800 \uB208 \uC88B\uC544\uC694. 3\uCE35\uC5D0\uC11C \uC77C\uC8FC\uC77C \uB0B4\uB0B4 \uCC3D\uBC16\uB9CC \uBD24\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563628
    m_Localized: "\uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uACE0 \uD560 \uC77C\uC744 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146557
    m_Localized: "\uD55C \uB2EC. \uC774 \uACA8\uC6B8\uC5D0 \uB2E4\uC74C \uD5EC\uAE30\uB97C \uAE30\uB2E4\uB9AC\uB294 \uD55C \uB2EC\uC740, \uC5BC\uB9C8\uB098 \uAE34 \uC2DC\uAC04\uC77C\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146556
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC148\uC740 \uC815\uD655\uD558\uAC8C \uD574\uC57C\uC9C0. \uADF8\uB798\uC57C \uB0A8\uB294 \uC790\uB9AC\uB97C \uB204\uAD6C\uD55C\uD14C \uC904\uC9C0 \uBBF8\uB9AC \uC0DD\uAC01\uD574 \uB458 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146555
    m_Localized: "{0}: \uADF8\uB7F0 \uB9D0 \uD558\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146554
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uBE7C\uACE0 \uC138\uB77C. \uC5B4\uCC28\uD53C \uAC80\uC9C4\uC5D0\uC11C \uAC78\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786255
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8\uB54C \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786254
    m_Localized: "{0}: \uB098\uC911\uC5D0 \uBD10\uC694. \uB2E4 \uAC19\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174841
    m_Localized: "\uAC00\uAC8C \uC720\uB9AC\uBB38 \uC548\uCABD\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uD14C\uC774\uD504\uB85C \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uC190\uAE00\uC528\uB97C \uBCF5\uC0AC\uD55C \uC804\uB2E8\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146553
    m_Localized: "\uC0AC\uAC70\uB9AC\uC758 \uC6B0\uBE44\uB4E4, \uB9C8\uD2B8 \uC2DD\uAD6C\uB4E4, \uB77C\uB514\uC624 \uB108\uBA38\uC758 \uBAA9\uC18C\uB9AC\uB4E4. \uADF8 \uC0AC\uB78C\uB4E4\uAE4C\uC9C0 \uC138\uB824\uB2C8, \uC190\uAC00\uB77D\uC774 \uBAA8\uC790\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146552
    m_Localized: "\uADF8\uB9AC\uACE0 \uC0AC\uAC70\uB9AC\uC758 \uC900. \uD5EC\uAE30 \uC598\uAE30\uB9CC \uB098\uC624\uBA74 \uB208\uC774 \uBC18\uC9DD\uC774\uB358 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563629
    m_Localized: "\uC885\uC774\uB97C \uB5BC\uC5B4 \uBD88\uC3D8\uC2DC\uAC1C\uB85C \uC37C\uB2E4. \uC190\uC740 \uB5A8\uB838\uC9C0\uB9CC, \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C\uB3C4 \uBD88\uC740 \uBD99\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563630
    m_Localized: "\uBC24, \uAD50\uBB38 \uCABD\uC5D0\uC11C \uC2E0\uC74C \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC190\uC804\uB4F1\uC744 \uBE44\uCD94\uC790 \uC6B0\uBE44 \uCC28\uB9BC\uC758 \uC544\uC774\uAC00 \uB2F4\uC7A5 \uC544\uB798 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146551
    m_Localized: "\uC120\uBC30. \uC190\uAC00\uB77D\uC774 \uC811\uD788\uB294 \uAC78 \uBCF4\uACE0\uB3C4 \uC120\uBC30\uB294 \uC544\uBB34 \uBC18\uC751\uC774 \uC5C6\uC5C8\uB2E4. \uB298 \uADF8\uB807\uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146550
    m_Localized: "\uCD5C\uD558\uB9B0. \uADF8 \uC774\uB984\uC5D0\uC11C \uC190\uAC00\uB77D\uC774 \uC544\uC8FC \uC7A0\uAE50 \uBA48\uCDC4\uB2E4. \uD558\uB9B0\uC774 \uADF8\uAC78 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146549
    m_Localized: "\uC1A1\uC608\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146548
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146547
    m_Localized: "\uB3C4\uD604."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340754
    m_Localized: "\uB204\uAD70\uAC00 \uC0C8\uD574 \uBCF5 \uB9CE\uC774 \uBC1B\uC73C\uB77C\uACE0 \uD588\uB2E4. \uADF8 \uB9D0\uC774 \uC774\uB807\uAC8C \uC9C4\uC2EC\uC73C\uB85C \uB4E4\uB9B0 \uC801\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340753
    m_Localized: "\uC0C8\uD574 \uCCAB\uB0A0. \uC0C8 \uB2EC\uB825\uC774 \uC5C6\uC5B4\uC11C, \uC791\uB144 \uB2EC\uB825 \uB4B7\uBA74\uC5D0 \uC5F4\uB450 \uCE78\uC744 \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980483
    m_Localized: "\uB3C4\uD604: \uD560 \uAC8C \uC5C6\uC5C8\uAC70\uB4E0\uC694. \uBB34\uC11C\uC6B0\uB2C8\uAE4C, \uC138\uB294 \uAC70\uB77C\uB3C4 \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146546
    m_Localized: "\uB204\uAD70\uAC00 \uC190\uAC00\uB77D\uC744 \uC811\uAE30 \uC2DC\uC791\uD588\uB2E4. \uB098\uB3C4 \uBAA8\uB974\uAC8C \uB530\uB77C \uC811\uC5C8\uB2E4. \uB098. \uC724 \uC120\uC0DD\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146545
    m_Localized: "\uBC29\uC1A1\uC774 \uB05D\uB0AC\uB2E4. \uCC98\uC74C \uACF5\uC9C0 \uB54C\uCC98\uB7FC \uC18C\uB9AC \uC9C0\uB974\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146544
    m_Localized: "\uAD6C\uC870\uB300: \uD0D1\uC2B9\uC740 \uAC80\uC9C4\uC744 \uD1B5\uACFC\uD55C \uBD84\uBD80\uD130, \uD604\uC7A5 \uD310\uB2E8\uC5D0 \uB530\uB985\uB2C8\uB2E4. \uB2E4\uC2DC \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uD55C \uBC88\uC5D0 \uC5EC\uB35F \uBA85\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146543
    m_Localized: "\uAD6C\uC870\uB300: \uB2E4\uC74C \uC6B4\uD56D\uC740 \uCD5C\uC18C \uD55C \uB2EC \uB4A4\uC785\uB2C8\uB2E4. \uAE30\uC0C1\uACFC \uC5F0\uB8CC \uC0AC\uC815\uC5D0 \uB530\uB77C \uB354 \uB2A6\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786253
    m_Localized: "\uC11C\uB78D\uC5D0 \uB2E4\uC2DC \uB123\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174943
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC7A5\uB9C8\uAC00 \uB05D\uB098\uBA74 \uBC14\uB85C \uB354\uC704\uB2E4. \uC9C0\uAE08 \uBC1B\uC544 \uB450\uB294 \uBB3C\uC774 8\uC6D4\uC744 \uBC84\uD2F0\uAC8C \uD574 \uC904 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980482
    m_Localized: "{0}: \u2026\uC774\uAC70, \uC77C\uC8FC\uC77C \uB3D9\uC548 \uD63C\uC790 \uADF8\uB9B0 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174842
    m_Localized: "'UBC \uC0DD\uC874\uC790 \uBC29\uC1A1. \uB9E4\uC77C \uBC24 \uC544\uD649 \uC2DC. \uC8FC\uD30C\uC218 98.3.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146542
    m_Localized: "\uAD6C\uC870\uB300: \uD22C\uC785\uB418\uB294 \uD5EC\uAE30\uB294 \uD55C \uB300\uC785\uB2C8\uB2E4. \uC5F0\uB8CC\uC640 \uAC70\uB9AC \uB54C\uBB38\uC5D0, \uD55C \uBC88\uC5D0 \uD0DC\uC6B8 \uC218 \uC788\uB294 \uC778\uC6D0\uC740 \uC5EC\uB35F \uBA85 \uB0B4\uC678\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146541
    m_Localized: "\uAD6C\uC870\uB300: \uC0C8\uBCBD\uC2DC \uC77C\uB300 \uC0DD\uC874\uC790\uC5D0\uAC8C 2\uCC28 \uC548\uB0B4\uB97C \uB4DC\uB9BD\uB2C8\uB2E4. \uC798 \uB4E4\uC5B4 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146540
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9BC \uB05D\uC5D0, \uADF8 \uB610\uBC15\uB610\uBC15\uD55C \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uB2E4. \uAC00\uC744 \uACF5\uC9C0 \uC774\uD6C4 \uCC98\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146539
    m_Localized: "\uC774\uBC88 \uC8FC \uCE60\uD310\uC5D0\uB294 \uC120\uC0DD\uB2D8 \uAE00\uC528\uAC00 \uD55C \uC904\uB3C4 \uC5C6\uC5C8\uB2E4. \uCC98\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146538
    m_Localized: "\uC9E7\uC740 \uC870\uC5B8\uC774\uC5C8\uB2E4. \uADF8 \uC9E7\uC74C\uC774 \uC870\uAE08 \uC2AC\uD390\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117827
    m_Localized: "\uBAA9\uBC1C\uC744 \uCC45\uC0C1\uC5D0 \uAE30\uB300 \uB450\uACE0, \uBB34\uB98E\uC5D0 \uB2F4\uC694\uB97C \uB36E\uC740 \uCC44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117826
    m_Localized: "\uC758\uC871\uC744 \uD480\uC5B4 \uCC45\uC0C1 \uB2E4\uB9AC\uC5D0 \uAE30\uB300 \uB450\uACE0, \uBB34\uB98E\uC5D0 \uB2F4\uC694\uB97C \uB36E\uC740 \uCC44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117825
    m_Localized: "\uBC24, \uAD50\uC2E4\uC5D0 \uCD1B\uBD88 \uD558\uB098. \uC724 \uC120\uC0DD\uB2D8\uC774 \uD559\uC0DD \uCC45\uC0C1\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826587
    m_Localized: "\uADF8\uAC8C, \uADF8\uB0A0 \uBCF8 {0}\uC758 \uB9C8\uC9C0\uB9C9 \uBAA8\uC2B5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146635
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8, \uD608\uC561\uD615 B. \uADF8 \uC544\uB798 \uBE44\uACE0 \uCE78\uC5D0 \uC791\uC740 \uAE00\uC528\uAC00 \uC788\uC5C8\uB2E4. \uD5CC\uD608 \uC2A4\uBB34 \uD68C \uC774\uC0C1, \uD45C\uCC3D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146634
    m_Localized: "\uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798 \uCE78\uC5D0\uC11C \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D \uCCA0\uC744 \uCC3E\uC558\uB2E4. \uBA3C\uC9C0 \uC704\uB85C \uC190\uAC00\uB77D \uC790\uAD6D\uC774 \uAE38\uAC8C \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146633
    m_Localized: "\uBD04\uC5D0 \uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798 \uCE78\uC5D0\uC11C \uCC98\uC74C \uD3BC\uCCD0 \uBD24\uB358 \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D. \uADF8\uB54C\uB294 \uADF8 \uCE78 \uD558\uB098\uAC00 \uC774\uB807\uAC8C \uBB34\uAC70\uC6CC\uC9C8 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146632
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5, \uCC98\uCE58 \uC808\uCC28 \uB9E8 \uC544\uB798\uC5D0 \uC9E7\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uCC98\uCE58 \uC911 \uC218\uD608 \uD544\uC694. \uD608\uC561\uD615 \uD655\uC778 \uD544\uC218.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146631
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uC624\uB294 \uAE38\uBD80\uD130 \uBA3C\uC800 \uBD10 \uB450\uACE0 \uB4E4\uC5B4\uAC00\uB77C. \uD53C \uD55C \uD329\uBCF4\uB2E4 \uB124\uAC00 \uBA3C\uC800\uB2E4. \uAF2D \uB3CC\uC544\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146630
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB9D0\uB824\uB3C4 \uAC08 \uC5BC\uAD74\uC774\uAD6C\uB098. \uBD04\uC5D0 \uCC3D\uACE0 \uBB38\uC744 \uCC98\uC74C \uC5F4\uC5C8\uC744 \uB54C\uB3C4, \uB124\uAC00 \uADF8 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146629
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0 \uAC70\uAE38 \uAC00\uACA0\uB2E4\uB294 \uAC70\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146628
    m_Localized: "\uD608\uC561 \uD329\uC774 \uB0A8\uC544 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uB0AE\uC5D0\uB294 \uADF8 \uACE8\uBAA9\uC5D0 \uB108\uBB34 \uB9CE\uB2E4. \uAC00\uB824\uBA74 \uBC24\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146627
    m_Localized: "\uB5A0\uC624\uB974\uB294 \uACF3\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4. \uC57D\uAD6D 2\uCE35 \uC758\uC6D0 \uCC98\uCE58\uC2E4. \uC815\uC804\uC5D0\uB3C4 \uBC84\uD2F0\uAC8C \uBC30\uD130\uB9AC\uB97C \uB2E8 \uBCF4\uB0C9 \uC0C1\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923686
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uBC31\uC740 \uB0A8\uCABD\uC73C\uB85C \uB5A0\uB0AC\uB2E4. \uC885\uC774 \uC704\uC758 \uD654\uC0B4\uD45C\uB294 \uADF8\uB300\uB85C \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923685
    m_Localized: "\uADF8\uB294 \uBAA8\uC790\uB97C \uB20C\uB7EC\uC4F0\uACE0 \uC6C3\uC5C8\uB2E4. \uC774\uBC88\uC5D4 \uBAA8\uC790 \uC544\uB798\uB85C\uB3C4 \uC6C3\uB294 \uAC8C \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923684
    m_Localized: "\uBC31: \uADF8\uB798\uB77C. \uC0B0\uC5D0\uC11C \uAE38 \uC783\uC740 \uC0AC\uB78C \uCC3E\uC744 \uB54C\uCC98\uB7FC, \uD06C\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146626
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB2E4\uB4E4 \uC790\uAE30 \uD608\uC561\uD615\uC744 \uB9D0\uD588\uB2E4. \uC544\uB294 \uC0AC\uB78C\uB3C4, \uBAA8\uB974\uB294 \uC0AC\uB78C\uB3C4 \uC788\uC5C8\uB2E4. \uD655\uC2E4\uD558\uAC8C \uB9DE\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146625
    m_Localized: "\uB0B4 \uD53C\uB85C\uB294 \uB4DC\uB9B4 \uC218 \uC5C6\uB2E4. \uB9DE\uC9C0 \uC54A\uB294 \uD53C\uB294 \uC57D\uC774 \uC544\uB2C8\uB77C \uB3C5\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146624
    m_Localized: "\uD559\uC0DD \uAC74\uAC15 \uAE30\uB85D\uC758 \uB0B4 \uCE78\uC744 \uBA87 \uBC88\uC774\uACE0 \uB2E4\uC2DC \uBD24\uB2E4. \uAE00\uC790\uB294 \uBC14\uB00C\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146623
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8, \uD608\uC561\uD615 B. \uADF8 \uC544\uB798 \uBE44\uACE0 \uCE78\uC5D0 \uC791\uC740 \uAE00\uC528\uAC00 \uC788\uC5C8\uB2E4. \uD5CC\uD608 \uC2A4\uBB34 \uD68C \uC774\uC0C1, \uD45C\uCC3D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146622
    m_Localized: "\uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798 \uCE78\uC5D0\uC11C \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D \uCCA0\uC744 \uCC3E\uC558\uB2E4. \uBA3C\uC9C0 \uC704\uB85C \uC190\uAC00\uB77D \uC790\uAD6D\uC774 \uAE38\uAC8C \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146621
    m_Localized: "\uBD04\uC5D0 \uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798 \uCE78\uC5D0\uC11C \uCC98\uC74C \uD3BC\uCCD0 \uBD24\uB358 \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D. \uADF8\uB54C\uB294 \uADF8 \uCE78 \uD558\uB098\uAC00 \uC774\uB807\uAC8C \uBB34\uAC70\uC6CC\uC9C8 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146620
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5, \uCC98\uCE58 \uC808\uCC28 \uB9E8 \uC544\uB798\uC5D0 \uC9E7\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uCC98\uCE58 \uC911 \uC218\uD608 \uD544\uC694. \uD608\uC561\uD615 \uD655\uC778 \uD544\uC218.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923683
    m_Localized: "{0}: \uAD6C\uC870\uB418\uBA74 \uB0A8\uCABD\uC5D0\uC11C \uCC3E\uC744\uAC8C\uC694. \uBC31 \uC544\uC800\uC528\uB77C\uACE0 \uBD80\uB974\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923682
    m_Localized: "\uB0A8\uCABD\uC5D0\uC11C \uB2E4\uC2DC \uB9CC\uB098\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923681
    m_Localized: "(\uBC31\uC758 \uB098\uCE68\uBC18\uC744 \uC5BB\uC5C8\uB2E4. \uD0D0\uD5D8\uD560 \uB54C \uB098\uAC00\uB294 \uAE38\uC744 \uC9DA\uC5B4 \uC900\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923680
    m_Localized: "\uBC31: \uC798 \uB410\uB124. \uB108\uB294 \uC800\uCABD, \uB098\uB294 \uC774\uCABD."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923679
    m_Localized: "\uB098\uCE68\uBC18 \uBC14\uB298\uC774 \uB5A8\uB9AC\uB2E4\uAC00 \uD55C\uCABD\uC744 \uAC00\uB9AC\uCF30\uB2E4. \uAD50\uC2E4 \uCC3D\uBB38 \uCABD, \uBC31\uC774 \uAC78\uC5B4\uAC08 \uBC29\uD5A5\uACFC \uBC18\uB300\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146619
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \u2026\uACE0\uB9D9\uB2E4. \uADF8 \uB9D0\uC740 \uBBF8\uB9AC \uD574 \uB450\uB9C8. \uB098\uC911\uC5D4 \uBABB \uD560\uC9C0\uB3C4 \uBAA8\uB974\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146618
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD558\uB098\uB9CC \uC57D\uC18D\uD574\uB77C. \uB124\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC9C0\uBA74, \uADF8\uB0A0\uB85C \uADF8\uB9CC\uC774\uB2E4. \uADF8\uAC74 \uB0B4\uAC00 \uC815\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786268
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAC83\uB4E4, \uBB34\uB9AC\uB97C \uC9D3\uAE30 \uC2DC\uC791\uD588\uC5B4. \uC774\uBC88 \uC8FC \uC548\uC5D0 \uD55C \uBC88\uC740 \uD06C\uAC8C \uC62C \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174944
    m_Localized: "\uB3C4\uD604\uC774 \uCC3D\uC5D0 \uC774\uB9C8\uB97C \uB300\uACE0 \uBE57\uC904\uAE30\uB97C \uC138\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174834
    m_Localized: "\uB0A8\uC790: \uD765\uC815\uC740 \uAC81 \uC548 \uBA39\uC740 \uC0AC\uB78C\uC774 \uD558\uB294 \uAC70\uC57C. \uD615\uB2D8\uC774 \uBCC4\uB85C \uC548 \uC88B\uC544\uD558\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146617
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uCCB4\uBA74\uC740 \uB098\uC911\uC5D0 \uCC28\uB9AC\uC138\uC694. \uBC14\uB298\uC740 \uC81C\uAC00 \uAF42\uC544\uC694. \uC598\uAC00 \uD560 \uC77C\uC740 \uC798 \uBA39\uACE0 \uC798 \uC790\uB294 \uAC70\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146616
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC83\uB3C4 \uD559\uC0DD\uD55C\uD14C. \uCCB4\uBA74\uC774 \uB9D0\uC774 \uC544\uB2C8\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146615
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC2A4\uBB34 \uBC88\uC744 \uC92C\uB294\uB370, \uBC1B\uB294 \uB0A0\uC774 \uC62C \uC904\uC740 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146614
    m_Localized: "{0}: \uC120\uC0DD\uB2D8. \uC81C \uD53C, \uB9DE\uC544\uC694. \uB4DC\uB9B4 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146613
    m_Localized: "\uD559\uC0DD \uAC74\uAC15 \uAE30\uB85D\uC758 \uB0B4 \uCE78\uC744 \uB2E4\uC2DC \uD655\uC778\uD588\uB2E4. \uC190\uAC00\uB77D\uC73C\uB85C \uD55C \uAE00\uC790\uC529 \uC9DA\uC5B4 \uAC00\uBA70. \uB0B4 \uD53C\uB77C\uBA74, \uC120\uC0DD\uB2D8\uAED8 \uB4DC\uB9B4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146612
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8, \uD608\uC561\uD615 B. \uADF8 \uC544\uB798 \uBE44\uACE0 \uCE78\uC5D0 \uC791\uC740 \uAE00\uC528\uAC00 \uC788\uC5C8\uB2E4. \uD5CC\uD608 \uC2A4\uBB34 \uD68C \uC774\uC0C1, \uD45C\uCC3D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146611
    m_Localized: "\uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798 \uCE78\uC5D0\uC11C \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D \uCCA0\uC744 \uCC3E\uC558\uB2E4. \uBA3C\uC9C0 \uC704\uB85C \uC190\uAC00\uB77D \uC790\uAD6D\uC774 \uAE38\uAC8C \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146610
    m_Localized: "\uBD04\uC5D0 \uBCF4\uAC74\uC2E4 \uC11C\uB78D \uB9E8 \uC544\uB798 \uCE78\uC5D0\uC11C \uCC98\uC74C \uD3BC\uCCD0 \uBD24\uB358 \uAD50\uC9C1\uC6D0 \uAC74\uAC15 \uAE30\uB85D. \uADF8\uB54C\uB294 \uADF8 \uCE78 \uD558\uB098\uAC00 \uC774\uB807\uAC8C \uBB34\uAC70\uC6CC\uC9C8 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146609
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5, \uCC98\uCE58 \uC808\uCC28 \uB9E8 \uC544\uB798\uC5D0 \uC9E7\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uCC98\uCE58 \uC911 \uC218\uD608 \uD544\uC694. \uD608\uC561\uD615 \uD655\uC778 \uD544\uC218.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146608
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB54C \uB300\uB2F5\uD560 \uC0AC\uB78C\uC774 \uD558\uB098\uB294 \uC788\uC5B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923678
    m_Localized: "\uB098\uCE68\uBC18\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923677
    m_Localized: "\uBC31: \uBCC4\uC774 \uC548 \uBCF4\uC774\uB294 \uB370\uC120 \uC774\uAC8C \uBD81\uCABD\uC774\uB2E4. \uB098\uB294 \uC774\uC81C \uBCC4\uB9CC \uC788\uC73C\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923676
    m_Localized: "\uADF8\uAC00 \uBC30\uB0AD \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC791\uC740 \uB18B\uC1E0 \uB098\uCE68\uBC18\uC744 \uAEBC\uB0B4 \uB0B4 \uC190\uC5D0 \uC950\uC5EC \uC8FC\uC5C8\uB2E4. \uB69C\uAED1\uC5D0 \uAE01\uD78C \uC790\uAD6D\uC774 \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923675
    m_Localized: "\uBC31: \uAE4A\uC774 \uB4E4\uC5B4\uAC00\uBA74 \uB4E4\uC5B4\uC628 \uAE38\uB85C \uBABB \uB098\uC62C \uB54C\uAC00 \uC788\uB2E4. \uADF8\uB7F4 \uB550 \uC774 \uD654\uC0B4\uD45C\uB2E4. \uD55C\uCABD\uC73C\uB85C\uB9CC \uC5F4\uB9AC\uB294 \uBB38. \uBC16\uC5D0\uC120 \uC548 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923674
    m_Localized: "\uBC31: \uC0B0 \uC548\uB0B4\uC6D0 \uD558\uAE30 \uC804\uC5D0 \uC2DC\uC124 \uAD00\uB9AC \uC77C\uC744 \uD588\uB2E4. \uC774 \uB3D9\uB124 \uC9C0\uD558\uB294 \uB2E4 \uC774\uC5B4\uC838 \uC788\uC5B4. \uC0AC\uB78C\uB4E4\uC774 \uBAA8\uB97C \uBFD0\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786267
    m_Localized: "\uC694\uC998 \uBC24\uB9C8\uB2E4 \uC18C\uB9AC\uAC00 \uAC00\uAE4C\uC6CC\uC84C\uB2E4. \uC6B4\uB3D9\uC7A5 \uCABD\uC5D0\uC11C, \uADF8\uB9AC\uACE0 \uC5B4\uC81C\uB294 \uACC4\uB2E8 \uC544\uB798\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786266
    m_Localized: "\uD654\uBA74\uC774 \uD55C\uCC38 \uAE4C\uB9E3\uB2E4\uAC00, \uB85C\uACE0\uAC00 \uC9C0\uB098\uAC00\uACE0 \uB0AF\uC775\uC740 \uBC30\uACBD \uD654\uBA74\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174835
    m_Localized: "\uADF8\uB294 \uB0B4\uAC00 \uB0B4\uBBFC \uD1B5\uC870\uB9BC\uB9CC \uCC59\uACA8 \uB3CC\uC544\uC130\uB2E4. \uB2F4\uC7A5\uC758 \uD45C\uC2DC\uB294 \uADF8\uB300\uB85C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923673
    m_Localized: "\uC9C0\uD558 \uC8FC\uCC28\uC7A5, \uADF8 \uC544\uB798 \uBC30\uC218 \uD1B5\uB85C, \uC0C1\uAC00 \uC9C0\uD558\uB97C \uC787\uB294 \uAD00\uB9AC\uC6A9 \uBCF5\uB3C4. \uACC4\uB2E8\uB9C8\uB2E4 \uC791\uC740 \uD654\uC0B4\uD45C, \uB9E8 \uB05D\uC5D0 \uBE44\uC0C1\uAD6C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923672
    m_Localized: "\uBC31\uC774 \uAD50\uC2E4 \uBC14\uB2E5\uC5D0 \uD070 \uC885\uC774\uB97C \uD3C8\uB2E4. \uC5F0\uD544\uB85C, \uAE30\uC5B5\uB9CC\uC73C\uB85C, \uC120\uC744 \uD558\uB098\uC529 \uADF8\uC5B4 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923671
    m_Localized: "\uADF8 \uB9D0\uC740 \uC2AC\uD504\uAC8C \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB0E5, \uADF8 \uC0AC\uB78C\uC774 \uBC84\uD2F0\uB294 \uBC29\uBC95 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923670
    m_Localized: "\uC720\uB791\uC790: \uBA48\uCD94\uBA74 \uC0DD\uAC01\uC774 \uB098. \uAC77\uB294 \uB3D9\uC548\uC740 \uAE38\uB9CC \uC0DD\uAC01\uD558\uBA74 \uB418\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174812
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38, \uD559\uAD50 \uC55E \uD070 \uC0AC\uAC70\uB9AC\uC5D0\uC11C \uBC1C\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146607
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC885\uC774, \uBC84\uB9AC\uC9C0 \uB9C8\uB77C. \uC5B8\uC820\uAC00 \uB204\uAC00 \uBB3C\uC744 \uAC70\uB2E4. \uADF8\uB54C \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB0D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146606
    m_Localized: "\uBAA9\uAD6C\uBA4D\uAE4C\uC9C0 \uC62C\uB77C\uC628 \uB9D0\uC744 \uB2E4\uC2DC \uC0BC\uCF30\uB2E4. \uC544\uC9C1\uC740. \uC870\uAE08\uB9CC \uB354 \uBAA8\uC73C\uACE0 \uB098\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146605
    m_Localized: "\uAC00\uBC29 \uC548\uCABD\uC5D0 \uC811\uC5B4 \uB454 \uACF5\uBB38\uC774 \uC0DD\uAC01\uB0AC\uB2E4. \uBD04\uBD80\uD130 \uC544\uBB34\uC5D0\uAC8C\uB3C4 \uBCF4\uC5EC \uC8FC\uC9C0 \uC54A\uC740 \uC885\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146604
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6B0\uB9AC \uD559\uAD50\uB3C4 \uB4E3\uC9C0 \uC54A\uC740 \uCABD\uC774\uC5C8\uC744\uC9C0 \uBAA8\uB974\uACA0\uB2E4. \uB098\uB3C4 \uD3EC\uD568\uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146603
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uB208\uC774 \uAD50\uBB34\uC2E4 \uCABD\uC73C\uB85C \uAC14\uB2E4. \uBD04\uC5D0 \uB0B4\uAC00 \uBCF4\uC5EC \uB4DC\uB9B0 \uADF8 \uACF5\uBB38. \uAD50\uB0B4 \uB300\uAE30, \uADF8 \uC704\uC758 \uBCF4\uB958 \uD574\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146602
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC8C \uC81C\uC77C \uBB34\uC12D\uB2E4. \uC880\uBE44\uBCF4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146601
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB204\uAD70\uAC00\uB294 \uBBF8\uB9AC \uC54C\uC558\uACE0, \uB204\uAD70\uAC00\uB294 \uB9D0\uD588\uACE0, \uB204\uAD70\uAC00\uB294 \uB4E3\uC9C0 \uC54A\uC558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146600
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD55C\uB3D9\uC548 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146599
    m_Localized: "\uAC19\uC740 \uC0AC\uB78C\uC758 \uAE00\uC528\uC600\uB2E4. \uB9C8\uC9C0\uB9C9 \uC904\uB9CC \uBCF4\uB4DC\uAC00 \uD328\uC77C \uB9CC\uD07C \uAFB9\uAFB9 \uB20C\uB7EC \uC4F4 \uC790\uAD6D\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4\uACE0, \uB098\uB294 \uB367\uBD99\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146598
    m_Localized: "\uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9 \uC904. \uBCF4\uACE0\uD588\uC73C\uB098 \uBB35\uC0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786265
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC11C\uB78D\uC5D0\uC11C \uCC3E\uC544 \uC900 \uCF00\uC774\uBE14\uC744 \uAF42\uC558\uB2E4. \uC190\uC774 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786264
    m_Localized: "\uB3CC\uC544\uC624\uB294 \uAE38\uC5D0 \uC8FC\uC6B4 \uBCF4\uC870\uBC30\uD130\uB9AC \uD558\uB098. \uB208\uAE08\uC740 \uAC70\uC758 \uBC14\uB2E5\uC774\uC5C8\uC9C0\uB9CC, \uBD88\uBE5B\uC774 \uD55C \uCE78 \uAE5C\uBE61\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174836
    m_Localized: "\uAC70\uC808\uD55C\uB2E4. \uC6B0\uB9AC \uAC83\uC740 \uC6B0\uB9AC\uAC00 \uC9C0\uD0A8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146597
    m_Localized: "\uC0AC\uD0DC \uC5FF\uC0C8 \uC804. \uAC19\uC740 \uC2DC\uB8CC, \uAC19\uC740 \uBC18\uC751. \uC7AC\uBCF4\uACE0. \uAE09\uC218 \uC77C\uC2DC \uC911\uB2E8 \uAC74\uC758."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146596
    m_Localized: "\uC0AC\uD0DC \uC5F4\uD558\uB8E8 \uC804. \uC815\uC218 \uACF5\uC815 \uC2DC\uB8CC B-7, \uBC18\uC751 \uC774\uC0C1. \uC0C1\uBD80 \uBCF4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146595
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0\uC11C \uBCA0\uAEF4 \uC628 \uBA54\uBAA8\uB97C, \uB09C\uB86F\uBD88 \uC606\uC5D0\uC11C \uC120\uC0DD\uB2D8\uAED8 \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uC5B4 \uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146594
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB0B4 \uBAB8 \uC598\uAE30\uB77C\uC11C \uD558\uB294 \uB9D0\uC740 \uC544\uB2C8\uB2E4. \uC774\uAC74 \uB098\uBCF4\uB2E4 \uC624\uB798 \uB0A8\uC544\uC57C \uD558\uB294 \uC885\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146593
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC219\uC81C\uB97C \uBC1B\uC558\uB124. \uB0A8\uC774 \uBABB\uB2E4 \uD558\uACE0 \uAC04 \uC219\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146592
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC0AC\uB78C\uB4E4\uC774 \uB0A8\uAE34 \uAC70\uAD6C\uB098. \uB05D\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146591
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uADF8 \uAE00\uC528\uB97C \uC190\uB05D\uC73C\uB85C \uD55C \uBC88 \uC4F8\uC5C8\uB2E4. \uCC44\uC810\uD560 \uB54C\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786263
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uB807\uAC8C \uB9D0\uD558\uBA74\uC11C\uB3C4, \uADF8\uB0A0 \uBC24 \uB2A6\uAC8C\uAE4C\uC9C0 \uCC3D\uBC16\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786262
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBAA8\uB974\uACA0\uC5B4. \uC798\uBABB \uB4E4\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174837
    m_Localized: "{0}: \uC904 \uAC70 \uC5C6\uC5B4\uC694. \uB3CC\uC544\uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146590
    m_Localized: "\uB204\uC6CC \uC788\uB358 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB9CC \uB3CC\uB824 \uADF8 \uAE00\uC528\uB97C \uC624\uB798 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146589
    m_Localized: "\uB77C\uB514\uC624\uC5D0\uC11C DJ\uAC00 \uB9D0\uD558\uB358 \uADF8 \uC5F0\uAD6C\uC6D0. \uC5F0\uB77D\uC774 \uB04A\uAE30\uBA74 \uAE30\uB85D\uC740 \uC9C0\uD558\uC5D0 \uC788\uB2E4\uACE0 \uD588\uB358 \uC0AC\uB78C. \uADF8 \uC0AC\uB78C\uC758 \uAE00\uC528\uC77C\uC9C0\uB3C4 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146588
    m_Localized: "\"\uC774 \uAE30\uB85D\uC744 \uC77D\uB294 \uC0AC\uB78C\uC5D0\uAC8C. \uC6B0\uB9AC\uB294 \uB2A6\uC5C8\uB2E4. \uB2F9\uC2E0\uC740 \uC544\uB2D0 \uC218\uB3C4 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146587
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC7A5 \uC544\uB798\uC5D0 \uC778\uC1C4\uAC00 \uC544\uB2CC \uBCFC\uD39C \uAE00\uC528\uAC00 \uC788\uC5C8\uB2E4. \uAE09\uD558\uAC8C, \uADF8\uB798\uB3C4 \uB610\uBC15\uB610\uBC15 \uC4F4 \uAE00\uC528."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146586
    m_Localized: "\uC77C\uBD80. \uADF8 \uB2E8\uC5B4\uC5D0\uC11C \uC190\uAC00\uB77D\uC774 \uBA48\uCDC4\uB2E4. \uC77C\uBD80\uB77C\uB294 \uAC74, \uB098\uBA38\uC9C0\uAC00 \uC788\uB2E4\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146585
    m_Localized: "\uC7AC\uD65C\uC131 \uCD08\uAE30\uC5D0 \uD2B9\uC815 \uD56D\uC0DD\uC81C \uC870\uD569\uACFC \uD574\uC5F4 \uCC98\uCE58\uB97C \uD568\uAED8 \uD558\uBA74, \uC77C\uBD80\uC5D0\uC11C \uC9C4\uD589\uC774 \uBA48\uCDC4\uB2E4\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146584
    m_Localized: "\uD734\uBA74 \uAC10\uC5FC. \uC7AC\uD65C\uC131 \uC870\uAC74. \uB0AE\uC5D0\uB294 \uAC00\uB77C\uC549\uACE0 \uBC24\uC5D0 \uC624\uB974\uB294 \uC5F4. \uC6B0\uB9AC\uAC00 \uBA87 \uB2EC \uB3D9\uC548 \uC801\uC5B4 \uC628 \uAC83\uACFC \uAC19\uC740 \uB9D0\uB4E4\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146583
    m_Localized: "\uBCF4\uAC74\uC2E4\uC5D0\uC11C \uAC00\uC838\uC628 \uC57D\uD488 \uC0AC\uC804\uC744 \uC606\uC5D0 \uD3B4 \uB193\uACE0, \uBAA8\uB974\uB294 \uB2E8\uC5B4\uB9C8\uB2E4 \uC5F0\uD544\uB85C \uBC11\uC904\uC744 \uADF8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146582
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC5EC\uAE30 \uBD10. \uC7AC\uD65C\uC131 \uCD08\uAE30\uC5D0 \uD2B9\uC815 \uD56D\uC0DD\uC81C \uC870\uD569\uC774\uB791 \uD574\uC5F4 \uCC98\uCE58\uB97C \uAC19\uC774 \uD558\uBA74, \uC77C\uBD80\uC5D0\uC11C \uC9C4\uD589\uC774 \uBA48\uCDC4\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146581
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB0AE\uC5D0\uB294 \uAC00\uB77C\uC549\uACE0 \uBC24\uC5D0 \uC624\uB974\uB294 \uC5F4. \uC190\uB05D\uBD80\uD130 \uC2DD\uB294 \uAC70. \uB2E4 \uC5EC\uAE30 \uC788\uC5B4. \uC6B0\uB9AC\uBCF4\uB2E4 \uD6E8\uC52C \uBA3C\uC800."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786261
    m_Localized: "{0}: \uD5EC\uAE30\u2026 \uC600\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786260
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB108\uB3C4 \uB4E4\uC5C8\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174838
    m_Localized: "\uB0A8\uC790\uAC00 \uC5B4\uAE68\uB97C \uC73C\uC4F1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146580
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD734\uBA74 \uAC10\uC5FC\u2026 \uC7AC\uD65C\uC131 \uC870\uAC74\u2026 \uC774\uAC70, \uC6B0\uB9AC\uAC00 \uBA87 \uB2EC \uB3D9\uC548 \uC801\uC740 \uAC70\uB791 \uB611\uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146579
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC548\uACBD\uC744 \uACE0\uCCD0 \uC4F0\uACE0 \uB9C8\uB978 \uC7A5\uBD80\uD130 \uB118\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146578
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uC9C0\uD558\uC5D0\uC11C \uB4E4\uACE0 \uB098\uC628 \uD30C\uC77C\uC740 \uBB3C\uAE30\uB97C \uBA39\uC5B4 \uADC0\uD241\uC774\uAC00 \uC6B8\uC5B4 \uC788\uC5C8\uB2E4. \uD55C \uC7A5\uC529 \uB5BC\uC5B4 \uB09C\uB85C \uC606\uC5D0 \uB110\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146577
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uB3C4\uC5D0 \uB3CC\uC544\uC624\uB294 \uAE38\uB3C4 \uADF8\uB824 \uB46C\uB77C. \uAC00\uB294 \uAE38\uB9CC \uADF8\uB9AC\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146576
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB9D0\uB824\uB3C4 \uC18C\uC6A9\uC5C6\uB2E4\uB294 \uAC78 \uC544\uB294 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146575
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uB204\uC6B4 \uCC44\uB85C \uACE0\uAC1C\uB9CC \uB3CC\uB824 \uC9C0\uB3C4\uB97C \uBCF4\uC558\uB2E4. \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB9D0\uB824\uB3C4 \uC18C\uC6A9\uC5C6\uB2E4\uB294 \uAC78 \uC544\uB294 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146574
    m_Localized: "\uAC15\uBCC0\uC740 \uB0AE\uC5D0 \uC9C0\uB098\uAC00 \uBCF8 \uC801\uC774 \uC788\uC5C8\uB2E4. \uB451 \uC544\uB798 \uADF8\uB298\uB9C8\uB2E4 \uC7A0\uB4E0 \uAC83\uB4E4\uC774 \uACB9\uACB9\uC774 \uB204\uC6CC \uC788\uC5C8\uB2E4. \uAC00\uC57C \uD55C\uB2E4\uBA74, \uBC24\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146573
    m_Localized: "DJ\uC758 \uB9D0\uC774 \uB5A0\uC62C\uB790\uB2E4. \uC5F0\uAD6C\uB3D9\uC740 \uBC24\uC5D0\uB9CC \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC744 \uAC70\uB77C\uACE0. \uB0AE\uC5D0\uB294 \uAC70\uAE30 \uC7A0\uB4E0 \uBB34\uB9AC\uAC00 \uB108\uBB34 \uB9CE\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786259
    m_Localized: "\uC18C\uB9AC\uB294 \uD55C\uCC38 \uD558\uB298 \uC5B4\uB518\uAC00\uB97C \uB9F4\uB3CC\uB2E4\uAC00, \uB0A8\uCABD\uC73C\uB85C \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786258
    m_Localized: "\uC544\uC8FC \uBA40\uB9AC\uC11C, \uB0AE\uAC8C \uC6C5\uC6C5\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBC14\uB78C \uC18C\uB9AC\uC640\uB294 \uB2EC\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174839
    m_Localized: "\uB0A8\uC790: \uADF8\uB798. \uD615\uB2D8\uD55C\uD14C \uADF8\uB807\uAC8C \uC804\uD560\uAC8C. \uBC24\uC5D0 \uBB38 \uC798 \uC7A0\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146572
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB0AE\uC5D4 \uAC00\uC9C0 \uB9C8. \uAC70\uAE30 \uC7A0\uB4E0 \uAC8C \uB108\uBB34 \uB9CE\uB300. \uAC00\uC57C \uD55C\uB2E4\uBA74\u2026 \uBC24\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146571
    m_Localized: "\uD559\uAD50\uC5D0\uC11C \uC815\uC218\uC7A5\uAE4C\uC9C0 \uC190\uAC00\uB77D\uC73C\uB85C \uAE38\uC744 \uC9DA\uC5C8\uB2E4. \uAC15\uC744 \uB530\uB77C \uD55C \uBC88, \uB2E4\uB9AC\uB97C \uAC74\uB108 \uD55C \uBC88. \uC0DD\uAC01\uBCF4\uB2E4 \uBA40\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146570
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uC5F4\uC774 \uC65C \uBC24\uC5D0\uB9CC \uC624\uB974\uB294\uC9C0. \uADF8 \uB2F5\uC774 \uC5B4\uB518\uAC00 \uC788\uB2E4\uBA74, \uAC70\uAE30\uC77C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146569
    m_Localized: "\uD30C\uCD9C\uC18C \uC11C\uB958\uCCA0\uC5D0 \uC801\uD600 \uC788\uB358 \uC774\uB984\uB3C4 \uAC19\uC558\uB2E4. \uC0C8\uBCBD\uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9, \uAE34\uAE09 \uCD9C\uC785 \uD1B5\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706363
    m_Localized: "\uC785\uAF2C\uB9AC\uB97C \uB0B4\uB838\uB2E4. \uAC70\uC6B8 \uC18D \uC5BC\uAD74\uC774 \uB0AF\uC124\uC5C8\uB2E4. \uD53C\uACE4\uD558\uACE0, \uC870\uAE08 \uD654\uAC00 \uB098 \uC788\uACE0, \uB9CE\uC774 \uC5B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706364
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uD6A1\uB2E8\uBCF4\uB3C4\uC5D0\uC11C, \uC6C3\uC74C \uB4A4\uC5D0 \uC788\uB358 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706365
    m_Localized: "\uC6C3\uC74C\uC740 \uAC11\uC637\uC774\uC5C8\uB2E4. \uBB34\uAC81\uACE0, \uAC00\uB054\uC740 \uC228\uC774 \uB9C9\uD614\uC9C0\uB9CC, \uADF8\uAC8C \uC5C6\uC5C8\uC73C\uBA74 \uADF8 \uBCF5\uB3C4\uB97C \uC9C0\uB098\uC9C0 \uBABB\uD588\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706366
    m_Localized: "\uC624\uB298\uC740 \uAC11\uC637 \uB9D0\uACE0, \uADF8\uB0E5 \uC6C3\uC5C8\uB2E4. \uB178\uC744\uC774 \uB108\uBB34 \uC6B0\uC2A4\uC6B4 \uC0C9\uC774\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563632
    m_Localized: "\uC900: \u2026\uD615\uB4E4\uC774 \uB450\uACE0 \uAC14\uC5B4\uC694. \uB530\uB77C\uC624\uB2E4 \uB118\uC5B4\uC84C\uB294\uB370, \uC544\uBB34\uB3C4 \uC548 \uB3CC\uC544\uBD24\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980523
    m_Localized: "\uBCF5\uB3C4\uB97C \uB2EC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980524
    m_Localized: "\uC2E0\uBC1C\uC744 \uBC97\uACE0 \uC591\uB9D0\uB9CC \uC2E0\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC190\uAC00\uB77D\uC73C\uB85C \uC14B\uC744 \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340615
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uB9D9\uB2E4. \uB2E4\uB978 \uC0AC\uB78C\uB4E4 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uC548 \uB418\uB294 \uAC70\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340614
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uB73B\uB300\uB85C, \uBC29\uC1A1\uC2E4\uB85C \uBAA8\uC154 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340613
    m_Localized: "\uD310\uC11C\uB294 \uB0B4\uAC00 \uD588\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBD80\uB974\uB294 \uB300\uB85C, \uD55C \uAE00\uC790\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340612
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC774 \uC788\uC5C8\uB2E4. \uD559\uC0DD\uC740 \uD558\uB098\uC600\uACE0, \uC120\uC0DD\uB2D8\uC740 \uB204\uC6CC\uC11C \uAC00\uB974\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786293
    m_Localized: "\uBC24\uC911\uC5D0 \uCC3D\uACE0 \uCCA0\uBB38\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB450\uB4DC\uB9AC\uB294 \uC18C\uB9AC. \uBB38\uD2C8\uC73C\uB85C \uBCF4\uB2C8 3\uCE35\uC758 \uADF8 \uC544\uC774\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786292
    m_Localized: "\uB3C4\uD604: \uC9C0\uD0AC\uAC8C\uC694. \uB2E4 \uC9C0\uD0AC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174793
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB059\uB059 \uC553\uB294 \uC18C\uB9AC\uC5D0 \uAE7C\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uBD95\uB300 \uAC10\uC740 \uC790\uB9AC\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C \uBB38\uC9C0\uB974\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340611
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uB2E4. \uCE60\uD310 \uC9C0\uC6B0\uACE0, \uBD84\uD544 \uC0C8\uAC83\uC73C\uB85C. \uC8FC\uC81C\uB294\u2026 \uB124\uAC00 \uC815\uD55C \uAC70\uC600\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340610
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC744 \uD574 \uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340609
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC815\uD558\uC790. \uB0B4\uAC00 \uC5B4\uB5BB\uAC8C \uB0A8\uC744\uC9C0. \uB124\uAC00 \uC815\uD574\uB3C4 \uB418\uACE0, \uB0B4 \uB9D0\uC744 \uB4E4\uC5B4\uB3C4 \uB418\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340608
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uC74C \uD5EC\uAE30\uB294 \uD55C \uB2EC \uB4A4\uB77C\uC9C0. \uADF8 \uD55C \uB2EC\uC744 \uB0B4 \uBAB8\uC774 \uBC84\uD168 \uC904\uC9C0\uB294, \uB098\uB3C4 \uBAA8\uB974\uACA0\uB2E4. \uADF8\uB7EC\uB2C8 \uADF8 \uC790\uB9AC \uC148\uC5D0 \uB098\uB97C \uB123\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146792
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC80\uC9C4\uC774 \uC788\uB2E4\uACE0 \uD588\uC9C0. \uB098\uB294 \uBABB \uD0C4\uB2E4. \uADF8\uAC74 \uC54C\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146791
    m_Localized: "\uAD6C\uC870 \uC77C\uC8FC\uC77C \uC804 \uBC24. \uC120\uC0DD\uB2D8\uC774 \uBAA8\uB450\uB97C \uB0B4\uBCF4\uB0B4\uACE0 \uB098\uB97C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146790
    m_Localized: "\uC124\uB9C8, \uB77C\uB294 \uB9D0\uC744 \uB05D\uB0B4 \uC785 \uBC16\uC5D0 \uB0B4\uC9C0 \uBABB\uD588\uB2E4. \uC18C\uB9AC \uB0B4\uC5B4 \uB9D0\uD558\uBA74 \uC544\uB2D0 \uAC83 \uAC19\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706367
    m_Localized: "\"\uC548 \uAD1C\uCC2E\uC544\uB3C4 \uB3FC. \uADF8\uB807\uAC8C \uB9D0\uD574\uB3C4 \uC544\uBB34\uB3C4 \uB108\uB97C \uB5A0\uB098\uC9C0 \uC54A\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706368
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB098\uB294 \uADF8\uAC78 \uBAB0\uB790\uB2E4. \uAD1C\uCC2E\uC9C0 \uC54A\uC73C\uBA74 \uB204\uAD70\uAC00 \uC2E4\uB9DD\uD560 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706369
    m_Localized: "\uB3CC\uC544\uAC00\uC11C \uC120\uC0DD\uB2D8 \uC606\uC5D0\uC11C \uAC77\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706370
    m_Localized: "\uACC4\uB2E8\uCC38\uC5D0\uC11C \uB0B4\uB824\uC640 \uC120\uC0DD\uB2D8 \uC606\uC5D0 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706371
    m_Localized: "\uD55C \uBC88, \uC26C\uACE0, \uB610 \uD55C \uBC88. \uADF8 \uC18D\uB3C4\uB85C \uAC78\uC73C\uB2C8 \uBCF5\uB3C4\uAC00 \uCC98\uC74C\uC73C\uB85C \uAE38\uC5C8\uB2E4. \uCC3D\uBC16\uC5D0 \uB2EC\uC774 \uC788\uC5C8\uB2E4. \uB298 \uC9C0\uB098\uCE58\uAE30\uB9CC \uD558\uB358 \uCC3D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706372
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB290\uB9AC\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980525
    m_Localized: "\uBCF5\uB3C4 \uB05D \uC18C\uD654\uC804\uC744 \uCC0D\uACE0 \uB3CC\uC544\uC654\uB2E4. \uBBF8\uB044\uB7EC\uC838\uC11C \uBCBD\uC744 \uC9DA\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174953
    m_Localized: "\uC300 \uD55C \uC90C, \uD1B5\uC870\uB9BC \uD558\uB098, \uB9C8\uB298 \uB300\uC2E0 \uB9C8\uB298 \uAC00\uB8E8. \uAD6D\uBB3C\uC774 \uBF40\uC597\uAC8C \uC6B0\uB7EC\uB0AC\uB2E4. \uBE44\uC2B7\uD588\uB2E4. \uC544\uC8FC \uC870\uAE08."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146789
    m_Localized: "'\uB2E4\uC74C\uC5D0 \uAC00\uC790'\uACE0 \uBBF8\uB918\uB358 \uB5A1\uBCF6\uC774\uAC00 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC560\uB294 '\uB0B4\uC77C\uC740 \uBB34\uC870\uAC74'\uC774\uB77C\uACE0 \uD588\uC5C8\uB2E4. \uADF8 \uB0B4\uC77C\uC774, 1\uB144 \uB2A6\uAC8C \uC62C\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146788
    m_Localized: "\uADF8\uB0A0 \uBC29\uACFC \uD6C4\uC5D0 \uBA39\uAE30\uB85C \uD588\uB358 \uB5A1\uBCF6\uC774\uAC00 \uB5A0\uC62C\uB790\uB2E4. \uC9C0\uD0A4\uC9C0 \uBABB\uD55C \uC57D\uC18D. \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC740 \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786291
    m_Localized: "\uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uAE30. \uD63C\uC790 \uB098\uAC00\uC9C0 \uC54A\uAE30. \uBA39\uC744 \uAC74 \uAC19\uC774 \uB098\uB204\uAE30. \uB3C4\uD604\uC774 \uC190\uAC00\uB77D\uC73C\uB85C \uD558\uB098\uC529 \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786290
    m_Localized: "\uAC19\uC774 \uC9C0\uB0B4\uB418 \uADDC\uCE59\uBD80\uD130 \uC815\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174830
    m_Localized: "{0}: \uBC18\uB9CC \uC904\uAC8C\uC694. \uB300\uC2E0 \uC6B0\uB9AC \uCABD \uB2F4\uC7A5\uC5D4 \uB2E4\uC2DC \uD45C\uC2DC\uD558\uC9C0 \uB9C8\uC138\uC694. \uADF8\uB9AC\uACE0 \uD559\uAD50 \uC55E\uC5D0\uC11C \uCD1D\uC740 \uAEBC\uB0B4\uC9C0 \uB9D0\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146787
    m_Localized: "\uC778\uADFC \uC8FC\uD0DD\uAC00. 102\uD638 \uBB38 \uC55E\uC5D0 \uBC18\uB4EF\uD558\uAC8C \uC138\uC6CC\uC838 \uC788\uB358 \uBE48 \uC0DD\uC218\uBCD1. \uB3D9\uADF8\uB797\uAC8C \uB9D0\uB824 \uC62C\uB77C\uAC04 '\uC694' \uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146786
    m_Localized: "\uC7A1\uC74C\uB9CC \uB0A8\uC558\uB2E4. \uC1A1\uC2E0 \uBC84\uD2BC\uC744 \uBA87 \uBC88\uC774\uACE0 \uB20C\uB800\uB2E4. \uB300\uB2F5\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146785
    m_Localized: "\uAD6C\uC870\uB300: \uC2E0\uD638\uAC00 \uC57D\uD569\uB2C8\uB2E4. \uB2E4\uC74C \uAD50\uC2E0 \uB54C. \uB05D\uAE4C\uC9C0 \uBC84\uD168 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146784
    m_Localized: "{0}: \u2026\uC774\uB984\uC740\uC694? \uADF8 \uC0AC\uB78C \uC774\uB984\uC774 \uBB50\uC608\uC694?\uD478\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146783
    m_Localized: "\uBB34\uC804\uAE30\uB97C \uC954 \uC190\uC774 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806658146782
    m_Localized: "\uAD6C\uC870\uB300: \uB530\uB77C\uC11C \uC0C8\uBCBD\uACE0 \uD0D1\uC2B9 \uAC00\uB2A5 \uC778\uC6D0\uC740 \uC77C\uACF1 \uBA85\uC785\uB2C8\uB2E4. \uB2E4\uC74C \uC6B4\uD56D\uC740 \uADF8\uB85C\uBD80\uD130 \uCD5C\uC18C \uD55C \uB2EC \uB4A4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786289
    m_Localized: "\uB3C4\uD604: \u2026\uC9C4\uC9DC\uC694? \uC800 \uBC25 \uB9CE\uC774 \uC548 \uBA39\uC5B4\uC694. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786288
    m_Localized: "\uC774\uC81C \uC5EC\uAE30\uC11C \uAC19\uC774 \uC9C0\uB0B4\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117919
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uC870\uAE08 \uB35C\uC5B4 \uACC4\uB2E8\uC5D0 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117918
    m_Localized: "\uACE0\uC591\uC774\uB294 \uC774\uBC88\uC5D0\uB3C4 \uB098\uB97C \uBCF8 \uCC99\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uB3C4\uB9DD\uAC00\uC9C0\uB294 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117917
    m_Localized: "\uADF8\uB54C \uC774 \uACE0\uC591\uC774\uB294 \uACE8\uBAA9 \uB05D\uB9CC \uB178\uB824\uBCF4\uBA70 \uD138\uC744 \uC138\uC6B0\uACE0 \uC788\uC5C8\uB2E4. \uBB34\uC5C7\uC744 \uBD24\uB358 \uAC78\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118113
    m_Localized: "\uC720\uB791\uC790\uB294 \uC815\uB9D0\uB85C \uC838 \uC8FC\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB294 \uCC98\uCC38\uD558\uAC8C \uC84C\uB2E4. \uC720\uB791\uC790\uB294 \uC624\uB298 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118114
    m_Localized: "\uC0B0 \uC774\uC57C\uAE30\uB97C \uB354 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679118115
    m_Localized: "{0}: \uADF8 \uC0B0, \uC5B4\uB5A4 \uC0B0\uC774\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654425
    m_Localized: "{0}: \uB300\uB2E8\uD558\uB2E4, \uADF8 \uBC30\uC9F1."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654424
    m_Localized: "\uC544\uC9C1 \uD655\uC778 \uC548 \uD588\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654423
    m_Localized: "{0}: \uAD1C\uCC2E\uC544. \uB300\uC2E0 \uB108 \uCCB4\uC721\uC740 \uC798\uD558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654422
    m_Localized: "\uB9D0\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uC544\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117916
    m_Localized: "\uC5B4\uB514\uC11C \uBD24\uB354\uB77C. \uC0DD\uAC01\uD558\uB2E4\uAC00 \uC54C\uC558\uB2E4. \uADF8\uB0A0 \uC544\uCE68, \uBE4C\uB77C \uACE8\uBAA9 \uB2F4 \uC704\uC5D0\uC11C \uB0B4\uAC00 \uC190\uC744 \uD754\uB4E4\uC5B4\uB3C4 \uBCF8 \uCC99\uB3C4 \uC548 \uD558\uB358 \uACE0\uC591\uC774\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117915
    m_Localized: "\uD55C\uCABD \uADC0 \uB05D\uC774 \uC870\uAE08 \uC798\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654421
    m_Localized: "{0}: \uC911\uAC04\uC774 \uC81C\uC77C \uD3B8\uD574. \uAE30\uB300\uB3C4 \uC5C6\uACE0 \uAC71\uC815\uB3C4 \uC5C6\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654420
    m_Localized: "\uB531 \uC911\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654419
    m_Localized: "{0}: \uC5ED\uC2DC\u2026 \uACF5\uBD80\uD558\uB294 \uC560\uB294 \uB2E4\uB974\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563532
    m_Localized: "\uBD88\uBE5B\uC744 \uC904\uC774\uACE0 \uC228\uC8FD\uC5EC \uC9C0\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654418
    m_Localized: "\uC0DD\uAC01\uBCF4\uB2E4 \uC798 \uB098\uC654\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654417
    m_Localized: "{0}: \uADFC\uB370 \uBC30\uCE58\uACE0\uC0AC \uACB0\uACFC \uB098\uC654\uC796\uC544. \uB108 \uBA87 \uB4F1 \uD588\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826509
    m_Localized: "\uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uC9C0\uB9CC, \uC544\uBB34\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117914
    m_Localized: "\uD574\uAC00 \uC9C8 \uBB34\uB835, \uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uC55E \uACC4\uB2E8\uC5D0 \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBE44\uCA4D \uB9C8\uB978 \uC0BC\uC0C9 \uACE0\uC591\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826577
    m_Localized: "{0}: \uC624\uCF00\uC774, \uC800\uC7A5 \uC644\uB8CC. \uC774\uBC88\uC5D4 \uC9C4\uC9DC \uC548 \uAE4C\uBA39\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117912
    m_Localized: "\uCABD\uC9C0\uC5D0\uB294 \uC090\uB6A4\uC090\uB6A4\uD55C \uAE00\uC528\uB85C \uD55C \uC904\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \"\uBC29\uC1A1 \uC798 \uB4E3\uACE0 \uC788\uC5B4\uC694. \uD798\uB0B4\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706319
    m_Localized: "{0}: \uB124?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706320
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0DD\uD65C\uAE30\uB85D\uBD80\uC5D4 \"\uB531\uD788 \uC5C6\uC74C\"\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uC5C8\uB294\uB370. \uC774\uC81C\uB294 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706321
    m_Localized: "\uBB3C\uACFC \uACFC\uC790\uB97C \uAC74\uB124\uACE0, \uAC70\uC810 \uC704\uCE58\uB97C \uC54C\uB824 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706322
    m_Localized: "\uB3C4\uD604: \uBCF8\uAD00 1\uCE35\u2026 \uCC3D\uACE0\uC694. \uAE30\uC5B5\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654411
    m_Localized: "O\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654410
    m_Localized: "{0}: B\uD615\uC740 '\uC608\uC0C1\uCE58 \uBABB\uD55C \uB9CC\uB0A8'\uC774\uB798. \uBB50\uC57C \uADF8\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654409
    m_Localized: "B\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117911
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uC815\uBB38 \uCCA0\uB9DD\uC5D0 \uBE44\uB2D0\uBD09\uC9C0 \uD558\uB098\uAC00 \uB9E4\uB2EC\uB824 \uC788\uC5C8\uB2E4. \uD1B5\uC870\uB9BC \uBA87 \uAC1C\uC640 \uC811\uD78C \uCABD\uC9C0\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826578
    m_Localized: "{0}: \uADF8\uB7FC \uB0B4\uAC00 \uC989\uC11D\uC73C\uB85C \uD574 \uC904\uAC8C. \uB300\uCDA9 \uB9DE\uC544, \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117909
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC\uC694. \uD544\uC694\uD558\uBA74 \uC5F0\uB77D\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654408
    m_Localized: "{0}: \uD5D0. \uC624\uB298 \uC870\uC2EC\uD574\uB77C \uC9C4\uC9DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654407
    m_Localized: "A\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654406
    m_Localized: "{0}: \uC57C, \uC624\uB298 A\uD615 \uC6B4\uC138 \uCD5C\uC545\uC774\uB798. \u314B\u314B \uB108 \uBB34\uC2A8 \uD615\uC774\uC5C8\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654405
    m_Localized: "{0}\uAC00 \uD734\uB300\uD3F0 \uD654\uBA74\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uC6B4\uC138 \uC571\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563531
    m_Localized: "\uC790\uC7AC\uB97C \uC544\uB07C\uC9C0 \uC54A\uC558\uB2E4. \uD45C\uC2DC \uC704\uC5D0\uB294 '\uBE48 \uD559\uAD50'\uB77C\uACE0 \uB367\uCE60\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826510
    m_Localized: "\uD63C\uC790 \uD328\uB97C \uB450 \uBC8C\uB85C \uB098\uB220 \uC591\uC190\uC73C\uB85C \uACA8\uB918\uB2E4. \uC624\uB978\uC190\uC774 \uC774\uACBC\uB2E4. \uC870\uAE08 \uC6B0\uC2A4\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706323
    m_Localized: "\uC544\uC774\uB294 \uBB3C\uBCD1\uC744 \uB450 \uC190\uC73C\uB85C \uAF2D \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117908
    m_Localized: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uAC70\uB9AC\uB97C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117907
    m_Localized: "\uC815 \uBC18\uC7A5: \uC88B\uC544\uC694. \uB2E4\uC74C\uC5D0 \uC6B0\uB9AC \uC560\uB4E4\uC774 \uADF8\uCABD \uC9C0\uB098\uAC08 \uB54C \uB9D0 \uAC78\uB77C\uACE0 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117906
    m_Localized: "{0}: \uC790\uC7AC\uB294 \uC870\uAE08 \uC788\uC5B4\uC694. \uBA39\uC744 \uAC8C \uD544\uC694\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706324
    m_Localized: "\uC870\uC6A9\uD788 \uBB38\uC744 \uB2EB\uACE0 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706325
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC6B0\uB9AC \uD559\uAD50 \uC560\uAD6C\uB098. \uD63C\uC790 \uB2E4\uB2C8\uB294 \uAC70\uC57C? \uB2E4\uCE5C \uB370\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706326
    m_Localized: "\"\uD559\uAD50\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uACC4\uC138\uC694. \uAC19\uC774 \uAC00\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711690
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: (\uBB38 \uB108\uBA38) \uCD1B\uBD88\uC740 \uC5C6\uC9C0\uB9CC, \uC18C\uC6D0\uC740 \uBE4C\uC5B4\uB3C4 \uB3FC. \u2026\uB0B4\uB144 \uC0DD\uC77C\uC5D4 \uCF00\uC774\uD06C\uB85C \uD558\uC790. \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711689
    m_Localized: "\uBB38 \uC55E\uC5D0 \uC549\uC544 \uD070 \uC18C\uB9AC\uB85C \uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD588\uB2E4. \uBB38 \uB108\uBA38\uC5D0\uC11C \uC791\uAC8C \uC6C3\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711688
    m_Localized: "'\uC0DD\uC77C \uCD95\uD558\uD574. \uBB38\uC740 \uC5F4\uC9C0 \uB9D0\uACE0, \uB300\uC2E0 \uD06C\uAC8C \uB9D0\uD574 \uC918. \uB2E4 \uB4E4\uB824. \u2014 \uC724'"
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711687
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uACA9\uB9AC\uD55C \uAD50\uC2E4 \uBB38\uD2C8\uC73C\uB85C \uCABD\uC9C0 \uD55C \uC7A5\uC774 \uBC00\uB824 \uB098\uC640 \uC788\uC5C8\uB2E4. \uAE00\uC528\uAC00 \uB9CE\uC774 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340644
    m_Localized: "\uB098. \uC724 \uC120\uC0DD\uB2D8. \uBC15 \uC120\uC0DD\uB2D8. \uB3C4\uD604. \uC1A1\uC608\uC9C0. \uCD5C\uD558\uB9B0. \uC120\uBC30. \uADF8\uB9AC\uACE0 \uC900."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340643
    m_Localized: "\uAD6C\uC870\uB300\uB294 \uC0C8\uBCBD\uACE0 \uBAAB\uC774 \uC77C\uACF1 \uC790\uB9AC\uB77C\uACE0 \uD588\uB2E4. \uBA3C\uC800 \uD0DC\uC6B4 \uC0DD\uC874\uC790 \uD55C \uBA85 \uB54C\uBB38\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340642
    m_Localized: "\uAD6C\uC870 \uC774\uD2C0 \uC804 \uBC24. \uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0 \uB07C\uC6CC \uB454 \uC885\uC774\uB97C \uB2E4\uC2DC \uAEBC\uB0C8\uB2E4. \uC5F0\uD544\uB85C \uADF8\uB9B0 \uC5EC\uB35F \uCE78."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117905
    m_Localized: "\uAC70\uB798 \uC774\uC57C\uAE30\uB97C \uD574 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117904
    m_Localized: "\uC815 \uBC18\uC7A5: \uAC70\uAE30 \uC0AC\uB78C\uB4E4 \uC0DD\uAC01\uBCF4\uB2E4 \uC57C\uBB34\uC9C0\uB124. \uBB3C\uAC74 \uBC14\uAFC0 \uC77C \uC788\uC73C\uBA74 \uC774 \uC8FC\uD30C\uC218\uB85C \uBD88\uB7EC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117903
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uAD50 \uBC29\uC1A1, \uC798 \uB4E4\uC5C8\uC5B4\uC694. \uB354\uBD88\uC5B4 \uB9C8\uD2B8 \uC815 \uBC18\uC7A5\uC785\uB2C8\uB2E4. \uC6B0\uB9AC\uB3C4 \uBB34\uC804\uAE30\uAC00 \uD558\uB098 \uC788\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706327
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC724 \uC120\uC0DD\uB2D8\uC774? \uC0B4\uC544 \uACC4\uC154? \u2026\uAC00\uC790. \uC57D\uC7A5\uBD80\uD130 \uCC59\uAE38\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706328
    m_Localized: "\uC704\uCE58\uB9CC \uC54C\uB824 \uC8FC\uACE0 \uBA3C\uC800 \uB3CC\uC544\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706329
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uB300\uB2F5 \uB300\uC2E0 \uC77C\uC5B4\uC130\uB2E4. \uB2E4\uB9AC\uAC00 \uD6C4\uB4E4\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706330
    m_Localized: "\uBB3C\uACFC \uBA39\uC744 \uAC83\uB9CC \uB450\uACE0 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706331
    m_Localized: "\uD1B5\uC870\uB9BC \uB450 \uAC1C\uC640 \uBB3C\uBCD1\uC744 \uBC14\uB2E5\uC5D0 \uB0B4\uB824\uB193\uC558\uB2E4. \uADF8 \uC560\uB294 \uC190\uC744 \uBED7\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706332
    m_Localized: "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB3CC\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706333
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uCC98\uB7FC \uB208\uC774 \uB9C8\uC8FC\uCCE4\uB2E4. \uC774\uBC88\uC5D0\uB294 \uADF8 \uC560\uAC00 \uBA3C\uC800 \uB208\uC744 \uB0B4\uB9AC\uAE54\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786299
    m_Localized: "\uBBF8\uC548\uD558\uB2E4\uACE0, \uC9C0\uAE08\uC740 \uC548 \uB41C\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786298
    m_Localized: "\uB3C4\uD604\uC740 \uB4E4\uC5B4\uC624\uC790\uB9C8\uC790 \uBC14\uB2E5\uC5D0 \uC8FC\uC800\uC549\uC544 \uD55C\uCC38\uC744 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174797
    m_Localized: "\uACC1\uC5D0\uC11C \uBC24\uC744 \uAC19\uC774 \uC0CC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340641
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \u2026\uACE0\uB9D9\uB2E4. \uBBF8\uB9AC \uD574 \uB454 \uB9D0 \uB9D0\uACE0, \uC774\uBC88\uC5D4 \uC81C\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340640
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800 \uBC16\uC5D0\uB3C4 \uC5F4\uC774 \uBC24\uC5D0\uB9CC \uC624\uB974\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC788\uC744 \uAC70\uB2E4. \uC774\uAC74 \uADF8 \uC0AC\uB78C\uB4E4 \uBAAB\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340639
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uAE30\uB85D, \uAD6C\uC870\uB300\uD55C\uD14C \uAF2D \uB118\uACA8\uB77C. \uB098 \uD558\uB098 \uB098\uC740 \uAC8C \uC911\uC694\uD55C \uAC8C \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117902
    m_Localized: "\uBC29\uC1A1\uC744 \uB044\uB824\uB294\uB370 \uB2E4\uB978 \uC8FC\uD30C\uC218\uC5D0\uC11C \uAD75\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uB07C\uC5B4\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826579
    m_Localized: "\uC624\uD788\uB824 \uC88B\uC544. \uC9D1\uC5D0\uC11C \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117900
    m_Localized: "\uC544\uC774: \uD558\uC740\uC774\uC694. \uB3D9\uC0DD\uC740 \uD558\uC900\uC774. \uC6B0\uB9AC \uC5C4\uB9C8\uB791 \uC14B\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706334
    m_Localized: "\uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uACE0 \uADF8 \uC55E\uC5D0 \uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706335
    m_Localized: "\uD55C \uAC78\uC74C. \uB610 \uD55C \uAC78\uC74C. \uADF8 \uC560\uAC00 \uD1B5\uC870\uB9BC\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706336
    m_Localized: "\uBB38\uC744 \uB2EB\uACE0 \uB3CC\uC544\uC120\uB2E4 (\uC9C0\uAE08\uC740 \uC544\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711676
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC791\uB144\uC5D4 \uB0B4\uAC00 \uB9E1\uC740 \uBC18\uC774 \uACC4\uC8FC \uAF34\uCC0C\uC600\uC5B4. \uBC14\uD1B5\uC744 \uB450 \uBC88 \uB5A8\uC5B4\uB728\uB838\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711675
    m_Localized: "\uD2B8\uB799\uC758 \uD770 \uC904\uC740 \uBC18\uCBE4 \uC9C0\uC6CC\uC84C\uACE0, \uBCF8\uBD80\uC11D \uCC9C\uB9C9\uC740 \uBF08\uB300\uB9CC \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711674
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC774 \uB0B4\uB824\uB2E4\uBCF4\uC774\uB294 \uCC3D\uAC00. \uC6D0\uB798\uB77C\uBA74 \uC624\uB298\uC774 \uCCB4\uC721\uB300\uD68C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706337
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4\uB294 \uAF64 \uD558\uB124. \uC218\uD559\uC740\u2026 \uB0B4\uC77C \uB2E4\uC2DC \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117899
    m_Localized: "{0}: \uC774\uB984\uC774 \uBB50\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117898
    m_Localized: "\uC774\uB984\uC744 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117897
    m_Localized: "\uC544\uC774\uAC00 \"\uC57D\uC18D\uC774\uC5D0\uC694!\" \uD558\uACE0 \uC18C\uB9AC\uCE58\uACE0\uB294 \uBB34\uC804\uC744 \uB04A\uC5C8\uB2E4. \uC57D\uC18D\uC774 \uD558\uB098 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706338
    m_Localized: "\uC2DC\uD5D8\uC9C0\uB97C \uCC22\uC5B4 \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706339
    m_Localized: "\uC885\uC774\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uC9C8\uACBC\uB2E4. \uADF8\uB798\uB3C4 \uB05D\uAE4C\uC9C0 \uCC22\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826511
    m_Localized: "\uD63C\uC790 \uD765\uC5BC\uAC70\uB838\uB2E4. \uB0B4 \uBAA9\uC18C\uB9AC\uAC00 \uC774\uB807\uAC8C \uC0DD\uACBC\uC5C8\uB098 \uC2F6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706340
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC870\uAC01\uB4E4\uC744 \uBAA8\uC544 \uBD88\uC3D8\uC2DC\uAC1C \uC0C1\uC790\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706341
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uD504\uAE34 \uD574. \uADF8\uB798\uB3C4 \uADF8\uB0A0 \uADF8\uB807\uAC8C \uC548 \uD588\uC73C\uBA74, \uC9C0\uAE08 \uB108\uB791 \uC774 \uC598\uAE30\uB3C4 \uBABB \uD588\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706342
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uC774\uC0C1 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB098\uB3C4 \uB354 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706343
    m_Localized: "\uC800\uB294 \uAD1C\uCC2E\uC544\uC694. \uC8FC\uBB34\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117896
    m_Localized: "{0}: \uADF8\uB7FC \uB2E4\uC74C \uC8FC\uC5D0 \uCCAB \uACE1\uC73C\uB85C \uD2C0\uC5B4 \uC904\uAC8C. \uB3D9\uC0DD\uD55C\uD14C \uAE30\uB2E4\uB9AC\uB77C\uACE0 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117895
    m_Localized: "\uB2E4\uC74C \uBC29\uC1A1\uC5D0 \uAF2D \uD2C0\uC5B4 \uC8FC\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117894
    m_Localized: "\uC544\uC774: \uADF8\uB54C \uB098\uC628 \uB178\uB798 \uB610 \uD2C0\uC5B4 \uC8FC\uBA74 \uC548 \uB3FC\uC694? \uB3D9\uC0DD\uC774 \uADF8 \uB178\uB798 \uB4E4\uC73C\uBA74 \uC548 \uC6B8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706344
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. {0}, \uB0B4\uC77C\uB3C4 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706345
    m_Localized: "\uBA40\uCA61\uD55C \uBD80\uBD84\uC744 \uACE8\uB77C \uC0B4\uB824 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654379
    m_Localized: "3\uC6D4 \uB458\uC9F8 \uC8FC, \uC6D4\uC694\uC77C \uC544\uCE68."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711662
    m_Localized: "5\uC6D4 15\uC77C. \uB2EC\uB825\uC5D0 \uC791\uAC8C '\uC2A4\uC2B9\uC758 \uB0A0'\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8 \uAE00\uC528\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uC774 \uB2EC\uB825\uC744 \uAC78\uC5B4 \uB454 \uB204\uAD70\uAC00\uC758 \uAE00\uC528\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826512
    m_Localized: "\uD63C\uC790 \uC904\uB118\uAE30\uB97C \uD588\uB2E4. \uC270\uC744 \uB118\uAE30\uACE0 \uAC78\uB838\uB2E4. \uB2E4\uC74C\uC5D4 \uC608\uC21C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706346
    m_Localized: "\uCE7C\uB85C \uC0C1\uD55C \uBD80\uBD84\uC744 \uB3C4\uB824\uB0B4\uACE0, \uB053\uC77C \uC218 \uC788\uB294 \uAC74 \uB053\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591987
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD80\uD488\uC740 \uC790\uC7AC\uB85C \uB300\uC2E0\uD558\uACE0, \uB098\uBA38\uC9C0\uB294 \uACF5\uBD80\uB85C \uBA54\uC6B0\uC790. \uACF5\uD559 \uCABD\uC744 \uC880 \uD574 \uB46C\uC57C \uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340638
    m_Localized: "\uC6C3\uC74C\uC774 \uAC00\uB77C\uC549\uC790 \uC120\uC0DD\uB2D8\uC774 \uC77C\uC9C0\uB97C \uB2EC\uB77C\uACE0 \uD588\uB2E4. \uD55C\uCC38\uC744 \uB118\uACA8 \uBCF4\uB2E4\uAC00, \uB9E8 \uB4B7\uC7A5\uC5D0 \uBB34\uC5B8\uAC00\uB97C \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340637
    m_Localized: "\uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0, \uC544\uBB34 \uAC71\uC815 \uC5C6\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340636
    m_Localized: "\uB3C4\uD604: \uADF8\uB7FC \uC800\uB294 \uC606\uC5D0\uC11C \uACE0\uAC1C \uB044\uB355\uC77C\uAC8C\uC694. \uC5C4\uCCAD \uC138\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340635
    m_Localized: "{0}: \uD1B5\uACFC \uBABB \uD558\uBA74 \uC81C\uAC00 \uB530\uC9C8 \uAC70\uC608\uC694. \uC774 \uC77C\uC9C0 \uB4E4\uACE0, \uD55C \uC7A5 \uD55C \uC7A5 \uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340634
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD1B5\uACFC \uBABB \uD558\uBA74 \uC81C\uAC00 \uAD6C\uC870\uB300\uB97C \uBD99\uC7A1\uACE0 \uB530\uC9C8 \uAC70\uC608\uC694. \uC77C\uC9C0 \uB4E4\uACE0. \uD55C \uC7A5 \uD55C \uC7A5 \uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786297
    m_Localized: "\uBB38\uC744 \uC5F4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117893
    m_Localized: "\uC544\uC774: \uC800\uAE30\uC694\u2026 \uD559\uAD50 \uBC29\uC1A1 \uC5B8\uB2C8 \uB9DE\uC8E0? \uC800 \uC544\uD30C\uD2B8\uC5D0\uC11C \uC190\uC804\uB4F1 \uD558\uB358 \uC560\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117892
    m_Localized: "\uBB34\uC804\uAE30\uC5D0\uC11C \uC7A1\uC74C \uC11E\uC778 \uC791\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC5B4\uB978 \uBAA9\uC18C\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826580
    m_Localized: "\uBC31\uC124\uACF5\uC8FC, \uB274\uD134, \uBBF8\uC548\uD558\uB2E4\uB294 \uB9D0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563627
    m_Localized: "\uB2E4\uC74C \uB0A0 \uAD50\uBB38\uC758 \uC885\uC774\uAC00 \uC0AC\uB77C\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706347
    m_Localized: "\uC0DD\uAC01\uBCF4\uB2E4 \uB9CE\uC774 \uAC74\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706348
    m_Localized: "\uAD1C\uCC2E\uC544 \uBCF4\uC600\uB294\uB370, \uC800\uB141\uBD80\uD130 \uBC30\uAC00 \uB4A4\uD2C0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706349
    m_Localized: "\uAC00\uBC29\uC5D0\uC11C \uD1B5\uC870\uB9BC \uB450 \uAC1C\uB97C \uAEBC\uB0B4 \uAC74\uB138\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654373
    m_Localized: "\uBE57\uC904\uAE30\uAC00 \uAD75\uC5B4\uC9C0\uC790 \uCC3D\uD2C0 \uC544\uB798\uB85C \uBB3C\uC774 \uC2A4\uBA70\uB4E4\uC5C8\uB2E4. \uBC14\uB2E5\uC5D0 \uAC78\uB808\uB97C \uAE54\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654372
    m_Localized: "\uBC24\uC0C8 \uB0B4\uB9B0 \uBE44\uC5D0 \uAD50\uC2E4 \uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0DC\uB2E4. \uB9E4\uD2B8\uB9AC\uC2A4 \uD55C\uCABD\uC774 \uC816\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826513
    m_Localized: "\uB2A6\uAC8C \uB4E4\uB978 \uC724 \uC120\uC0DD\uB2D8\uC774 \uC5B4\uAE68 \uB108\uBA38\uB85C \uBB38\uC81C\uB97C \uBCF4\uACE0, \uBE68\uAC04 \uD39C\uC73C\uB85C \uC791\uC740 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uADF8\uB824 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786296
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC774\uCABD\uC744 \uBCF4\uC558\uB2E4. \uB124\uAC00 \uC815\uD558\uB77C\uB294 \uB208\uBE5B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174796
    m_Localized: "\uC57D\uC744 \uC0BC\uD0A4\uACE0 \uD55C\uCC38 \uB4A4, \uC120\uC0DD\uB2D8\uC758 \uC228\uC18C\uB9AC\uAC00 \uACE0\uB974\uAC8C \uBC14\uB00C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117890
    m_Localized: "\uCF1C\uC84C\uB2E4, \uAEBC\uC84C\uB2E4, \uB2E4\uC2DC \uCF1C\uC84C\uB2E4. \uC800\uCABD \uBD88\uBE5B\uC774 \uD55C \uBC88 \uB354 \uAE5C\uBE61\uC774\uACE0 \uAEBC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117889
    m_Localized: "\uC190\uC804\uB4F1\uC73C\uB85C \uB611\uAC19\uC774 \uB300\uB2F5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117888
    m_Localized: "\uB2E4\uC74C \uBC29\uC1A1 \uC6D0\uACE0 \uB9E8 \uC704\uC5D0 \"\uBB3C\uC740 \uAF2D \uB053\uC5EC\uC11C\"\uB77C\uACE0 \uD06C\uAC8C \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706350
    m_Localized: "\uB450 \uC190\uC73C\uB85C \uBC1B\uC544 \uB4E4\uACE0, \uACE0\uAC1C\uB97C \uC544\uC8FC \uC870\uAE08 \uC219\uC600\uB2E4. \uADF8\uB9AC\uACE0 \uB2E4\uC2DC \uADF8\uB298 \uC18D\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706351
    m_Localized: "\uBABB \uBCF8 \uCC99 \uC9C0\uB098\uCE5C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706352
    m_Localized: "\uBC1C\uAC78\uC74C\uC744 \uC7AC\uCD09\uD588\uB2E4. \uB4A4\uC5D0\uC11C \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706353
    m_Localized: "\uADF8 \uBC24, \uC790\uAE30 \uCC28\uB840\uAC00 \uB418\uC790 \uB9D0\uC5C6\uC774 \uC77C\uC5B4\uB098 \uCC3D\uAC00\uB85C \uAC14\uB2E4. \uC544\uBB34\uB3C4 \uAE68\uC6B0\uC9C0 \uC54A\uC558\uB294\uB370\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654366
    m_Localized: "\uBAA9\uC774 \uB530\uB054\uAC70\uB9AC\uB354\uB2C8 \uBAB8\uC774 \uBB34\uAC70\uC6CC\uC84C\uB2E4. \uD55C\uD30C\uAC00 \uBAB8\uC18D\uAE4C\uC9C0 \uB4E4\uC5B4\uC628 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711648
    m_Localized: "3\uBC88\uC740 \uD2C0\uB9B0 \uAC83 \uAC19\uC558\uB2E4. 7\uBC88\uC740 \uC218\uC5C5 \uB54C \uC120\uC0DD\uB2D8\uC774 \uB450 \uBC88 \uB9D0\uD55C \uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711647
    m_Localized: "\uCC45\uC0C1 \uD558\uB098\uB97C \uCC3D\uAC00\uB85C \uC62E\uACA8 \uC549\uC558\uB2E4. \uC5F0\uD544 \uAE4E\uB294 \uC18C\uB9AC\uAC00 \uC774\uB807\uAC8C \uD070 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340633
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC80\uC9C4, \uD1B5\uACFC\uD558\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340632
    m_Localized: "\uADF8\uB0A0 \uC800\uB141, \uC120\uC0DD\uB2D8\uC740 \uB204\uAD6C\uC758 \uBD80\uCD95\uB3C4 \uC5C6\uC774 \uD63C\uC790 \uC77C\uC5B4\uB098 \uC549\uC544 \uC788\uC5C8\uB2E4. \uCD9C\uC11D\uBD80\uB97C \uC9D1\uC5B4 \uB4E4\uACE0, \uD45C\uC9C0\uB97C \uD55C \uBC88 \uC4F8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340631
    m_Localized: "\uBC24\uC774\uBA74 \uC624\uB974\uB358 \uC5F4\uC774, \uC774\uC81C \uBC24\uC5D0\uB3C4 \uC624\uB974\uC9C0 \uC54A\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uCC98\uC74C\uC73C\uB85C \uBC24\uC0C8 \uD55C \uBC88\uB3C4 \uAE68\uC9C0 \uC54A\uACE0 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117887
    m_Localized: "\uC190\uC804\uB4F1\uC744 \uC138 \uBC88 \uAE38\uAC8C, \uB450 \uBC88 \uC9E7\uAC8C \uAE5C\uBE61\uC600\uB2E4. \uBB34\uC2A8 \uB73B\uC778\uC9C0 \uBAB0\uB77C\uB3C4, \uACC4\uC18D \uB4E3\uACE0 \uC788\uC73C\uB77C\uB294 \uB9C8\uC74C\uC740 \uB2FF\uC558\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117886
    m_Localized: "\uBB3C \uB053\uC774\uB294 \uBC95\uC744 \uB2E4\uC74C \uBC29\uC1A1\uC5D0\uC11C \uB2E4\uC2DC \uC54C\uB824 \uC8FC\uACA0\uB2E4\uACE0 \uC2E0\uD638\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117885
    m_Localized: "\uB204\uAD70\uAC00 \uC190\uC804\uB4F1\uC73C\uB85C \uB300\uB2F5\uD558\uACE0 \uC788\uC5C8\uB2E4. \uCC3D\uAC00\uC5D0 \uC791\uC740 \uADF8\uB9BC\uC790 \uB458\uACFC \uD070 \uADF8\uB9BC\uC790 \uD558\uB098\uAC00 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711646
    m_Localized: "\uC9C4\uC9C0\uD558\uAC8C \uC2DC\uD5D8\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711645
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uD5D8 \uC2DC\uAC04\uC740 \uC624\uC2ED \uBD84. \uBD80\uC815\uD589\uC704\uB294\u2026 \uBCFC \uC0AC\uB78C\uC774 \uC5C6\uC73C\uB2C8 \uBBFF\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711644
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6D0\uB798 \uC624\uB298\uC774 1\uD559\uAE30 \uC911\uAC04\uACE0\uC0AC \uCCAB\uB0A0\uC774\uC5C8\uC5B4. \uAE30\uBD84\uB9CC\uC774\uB77C\uB3C4 \uB0B4 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711643
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC190 \uAE00\uC528\uB85C \uB9CC\uB4E0 \uC2DC\uD5D8\uC9C0\uB97C \uB0B4\uBC00\uC5C8\uB2E4. \uAD6D\uC5B4 \uC5F4 \uBB38\uC81C. \uC774\uBA74\uC9C0 \uB4B7\uBA74\uC5D0 \uC790\uB97C \uB300\uACE0 \uADF8\uC740 \uC904\uC774 \uBC18\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654365
    m_Localized: "\uBC24\uC0C8 \uC624\uD55C\uC774 \uB0AC\uB2E4. \uB2F4\uC694\uB97C \uB450 \uACB9 \uB36E\uC5B4\uB3C4 \uC774\uAC00 \uB531\uB531 \uBD80\uB52A\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826514
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5 \uB300\uC2E0 \uC218\uCCA9\uC744 \uB36E\uC5B4 \uB0B4 \uC190\uC5D0 \uC950\uC5EC \uC8FC\uC5C8\uB2E4. \uB2E4\uC74C \uC7A5\uBD80\uD130\uB294 \uB124\uAC00 \uC4F0\uB77C\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706354
    m_Localized: "\uB098\uB294 \uADF8 \uC0AC\uB78C\uC744 \uC120\uBC30\uB77C\uACE0 \uBD80\uB974\uAE30\uB85C \uD588\uB2E4. \uB098\uBCF4\uB2E4 \uD55C \uD559\uB144 \uC704\uB2C8\uAE4C. \uADF8 \uB9D0\uC5D0\uB3C4 \uC120\uBC30\uB294 \uADF8\uB0E5 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340630
    m_Localized: "\uC77C\uC8FC\uC77C\uC9F8 \uAC19\uC740 \uAE00\uC790\uC600\uB2E4. \uC55E \uC7A5\uB4E4\uC744 \uB118\uAE30\uBA74, \uBA87 \uB2EC \uB3D9\uC548 \uC22B\uC790\uB4E4\uC774 \uC624\uB974\uB0B4\uB9B0 \uC790\uAD6D\uC774 \uBE7C\uACE1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340629
    m_Localized: "\uCCB4\uC628\uACC4\uB97C \uB0B4\uB824\uB193\uACE0 \uAD00\uCC30 \uC77C\uC9C0\uC5D0 \uC801\uC5C8\uB2E4. \uC815\uC0C1."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340628
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uCCB4\uC628\uACC4\uB97C \uB0B4\uB824\uB193\uACE0 \uC218\uCCA9\uC5D0 \uC801\uC5C8\uB2E4. \uC815\uC0C1."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340627
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC120\uD0DD, \uD0D3\uD558\uC9C0 \uB9C8\uB77C. \uB124\uAC00 \uC0B4\uC544\uB0A8\uB294 \uCABD\uC744 \uACE8\uB790\uB2E4\uB294 \uAC8C \uB0B4 \uC790\uB791\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340626
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uB108\uBA38\uB85C \uC778\uC0AC\uB97C \uD588\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBB38 \uB108\uBA38\uC5D0\uC11C \uB300\uB2F5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174946
    m_Localized: "\uC591\uB3D9\uC774\uC640 \uBE48 \uD1B5\uC744 \uBAA8\uB450 \uAEBC\uB0B4 \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174976
    m_Localized: "{0}: \uCCB4\uC721\uAD00 \uB4A4\uB85C \uB3CC\uBA74 \uC6B4\uB3D9\uC7A5\uC744 \uC548 \uC9C0\uB098\uB3C4 \uB3FC\uC694. \uB298 \uADF8 \uAE38\uB85C \uC9D1\uC5D0 \uAC14\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174795
    m_Localized: "\uC9C4\uD1B5\uC81C\uB97C \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340625
    m_Localized: "\uC870\uC6A9\uD788 \uC791\uBCC4 \uC778\uC0AC\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340624
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC6B0\uB294 \uAC78 \uCC98\uC74C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117884
    m_Localized: "\uBC29\uC1A1\uC744 \uB044\uACE0 \uCC3D\uBC16\uC744 \uBCF4\uB294\uB370, \uAE38 \uAC74\uB108 \uC544\uD30C\uD2B8 \uAF2D\uB300\uAE30 \uCE35\uC5D0\uC11C \uBD88\uBE5B\uC774 \uAE5C\uBE61\uC600\uB2E4. \uCF1C\uC84C\uB2E4, \uAEBC\uC84C\uB2E4, \uB2E4\uC2DC \uCF1C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826581
    m_Localized: "\"\uB9CE\uC774 \uC18D\uC0C1\uD588\uACA0\uB2E4\u2026\""
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706355
    m_Localized: "\uC9C0\uAE08\uC740 \uC5B4\uB835\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706356
    m_Localized: "{0}: \uC9C0\uAE08\uC740\u2026 \uC5B4\uB824\uC6B8 \uAC83 \uAC19\uC544\uC694. \uBBF8\uC548\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706357
    m_Localized: "\"\u2026\uC0AC\uC2E4 \uBB34\uB98E, \uC544\uD30C\uC694.\" \uCC98\uC74C\uC73C\uB85C \uB9D0\uD574 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460389
    m_Localized: "\uAE38\uC774 \uBB34\uB108\uC838 \uC788\uC5B4 \uD55C\uCC38 \uB3CC\uC544\uAC14\uB2E4. \uB118\uC5B4\uC9C0\uACE0, \uAE01\uD788\uACE0, \uD574\uAC00 \uAE30\uC6B8\uC5B4\uC11C\uC57C \uC804\uB9DD\uB300\uC5D0 \uB2FF\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460388
    m_Localized: "\uADF8 \uB108\uBA38\uB85C, \uC544\uC8FC \uBA40\uB9AC, \uD68C\uC0C9 \uB760\uCC98\uB7FC \uBC14\uB2E4\uAC00 \uB204\uC6CC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654359
    m_Localized: "\uB354\uC704\uAC00 \uBA70\uCE60\uC9F8 \uC774\uC5B4\uC84C\uB2E4. \uBC18\uCC2C \uD1B5 \uB69C\uAED1\uC744 \uC5F4\uC790\uB9C8\uC790 \uB2E4\uC2DC \uB2EB\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654358
    m_Localized: "\uD55C\uB0AE\uC758 \uC5F4\uAE30\uAC00 \uCC3D\uACE0 \uC548\uAE4C\uC9C0 \uB4E4\uC5B4\uCC3C\uB2E4. \uC2DD\uB7C9 \uC0C1\uC790\uC5D0\uC11C \uC270\uB0B4\uAC00 \uC62C\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711634
    m_Localized: "\uB3C4\uD604\uC774 \uACF5\uCC45 \uD55C \uC7A5\uC744 \uB0B4\uBC00\uC5C8\uB2E4. \uC6B4\uB3D9\uC7A5 \uADF8\uB9BC \uC704\uC5D0 \uC791\uC740 \uB3D9\uADF8\uB77C\uBBF8\uB4E4, \uADF8 \uC606\uC5D0 \uC2DC\uAC04\uC774 \uBE7C\uACE1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340752
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6D0\uB798 \uC74C\uCE58\uB2E4. \uD559\uC0DD\uB4E4 \uC55E\uC5D0\uC11C\uB294 \uD55C \uBC88\uB3C4 \uC548 \uBD88\uB800\uC5B4. \uC624\uB298 \uB108\uD76C\uAC00 \uCC98\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340751
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBC15\uC790\uB97C \uB193\uCE58\uBA74\uC11C\uB3C4 \uB05D\uAE4C\uC9C0 \uB530\uB77C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340750
    m_Localized: "\uC791\uC740 \uBAA9\uC18C\uB9AC\uB85C \uBD88\uB800\uB2E4. \uCC3D\uBC16\uC73C\uB85C \uC18C\uB9AC\uAC00 \uC0C8\uC9C0 \uC54A\uAC8C, \uB2F4\uC694\uB97C \uBA38\uB9AC\uAE4C\uC9C0 \uB4A4\uC9D1\uC5B4\uC4F0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340749
    m_Localized: "\uB2E4 \uAC19\uC774 \uCE90\uB7F4\uC744 \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340748
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD84\uD544\uC774\uB77C. \u2026\uC218\uC5C5\uC744 \uB354 \uD558\uB77C\uB294 \uB73B\uC774\uAD6C\uB098. \uC54C\uC558\uB2E4. \uB2E4 \uC4F8 \uB54C\uAE4C\uC9C0 \uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174803
    m_Localized: "'\uB0B4\uC77C \uAF2D \uC0AC\uACFC\uD560\uAC8C. \uC9C4\uC9DC\uB85C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340747
    m_Localized: "\uB098\uB294 \uC120\uC0DD\uB2D8\uAED8 \uC0C8 \uBD84\uD544 \uD55C \uC0C1\uC790\uB97C \uB4DC\uB838\uB2E4. \uB9E4\uC810 \uCC3D\uACE0 \uAD6C\uC11D\uC5D0\uC11C \uCC3E\uC740 \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340746
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uC900\uBE44\uD55C \uAC8C \uC5C6\uB2E4\uBA70 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4. \uB300\uC2E0 \uADF8\uB0A0 \uC124\uAC70\uC9C0\uB97C \uD63C\uC790 \uB2E4 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340745
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uBAA8\uB450\uC758 \uC5BC\uAD74\uC744 \uC5F0\uD544\uB85C \uADF8\uB9B0 \uC885\uC774 \uD55C \uC7A5\uC744 \uCE60\uD310\uC5D0 \uBD99\uC600\uB2E4. \uB0B4 \uC5BC\uAD74\uC740 \uC2E4\uC81C\uBCF4\uB2E4 \uC870\uAE08 \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340744
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC9C1\uC811 \uB72C \uBAA9\uB3C4\uB9AC\uB97C \uB0B4\uBC00\uC5C8\uB2E4. \uD55C\uCABD \uB05D\uC774 \uC870\uAE08 \uB354 \uAE38\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340743
    m_Localized: "\uB3C4\uD604\uC740 \uB098\uBB34 \uC870\uAC01\uC73C\uB85C \uAE4E\uC740 \uBD80\uC5C9\uC774\uB97C \uB0B4\uBC00\uC5C8\uB2E4. \uB208\uC774 \uC9DD\uC9DD\uC774\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340742
    m_Localized: "\uC11C\uB85C\uC5D0\uAC8C \uC791\uC740 \uC120\uBB3C\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340741
    m_Localized: "\uCC3D\uBC16\uC73C\uB85C \uB208\uC774 \uB0B4\uB838\uB2E4. \uD654\uC774\uD2B8 \uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uB124, \uB204\uAD70\uAC00 \uC791\uAC8C \uB9D0\uD588\uB2E4. \uC544\uBB34\uB3C4 \uC6C3\uC9C0 \uC54A\uC558\uB294\uB370 \uB2E4\uB4E4 \uC870\uAE08\uC529 \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340740
    m_Localized: "\uD06C\uB9AC\uC2A4\uB9C8\uC2A4. \uAD50\uC2E4 \uAD6C\uC11D\uC5D0 \uB300\uAC78\uB808 \uC790\uB8E8\uB85C \uD2B8\uB9AC\uB97C \uC138\uC6E0\uB2E4. \uC7A5\uC2DD\uC740 \uC740\uBC15\uC9C0\uC640 \uBCD1\uB69C\uAED1, \uAF2D\uB300\uAE30\uC5D0\uB294 \uC885\uC774\uB85C \uC811\uC740 \uBCC4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340739
    m_Localized: "\uB0B4\uC77C, \uBB38\uC774 \uC5F4\uB9B0\uB2E4. \uC774\uBC88\uC5D0\uB294 \uBC16\uC5D0\uC11C\uAC00 \uC544\uB2C8\uB77C, \uC6B0\uB9AC\uAC00 \uC5F0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340738
    m_Localized: "\uADF8\uB7EC\uB2E4 \uD55C \uC904\uB9CC \uC37C\uB2E4. \uCCAB \uC7A5\uC758 \uCCAB \uC904\uACFC \uAC19\uC740 \uBB38\uC7A5\uC774 \uB418\uC9C0 \uC54A\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340737
    m_Localized: "52\uC8FC\uC9F8. \uC4F8 \uB9D0\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C, \uD39C \uB05D\uC774 \uD55C\uCC38 \uC885\uC774 \uC704\uC5D0 \uBA38\uBB3C\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340736
    m_Localized: "\uC77C\uAE30\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC744 \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340735
    m_Localized: "\uB0B4\uB824\uC624\uB294 \uAE38\uC5D0 \uB204\uAD70\uAC00 \uC791\uAC8C \uC22B\uC790\uB97C \uC14C\uB2E4. \uC625\uC0C1 \uACC4\uB2E8 \uC5F4\uC5EC\uC12F \uCE78. \uB0B4\uC77C \uC544\uCE68, \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC624\uB97C \uCE78\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340734
    m_Localized: "\uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uAC19\uC740 \uBCC4\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340733
    m_Localized: "\uC625\uC0C1 \uBB38\uC744 \uC5F4\uC5C8\uB2E4. \uBA87 \uB2EC \uB3D9\uC548 \uBC24\uB9C8\uB2E4 \uAC78\uC5B4 \uC7A0\uADF8\uB358 \uBB38\uC774\uC5C8\uB2E4. \uC624\uB298\uC740 \uC7A0\uADF8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340732
    m_Localized: "\uBAA8\uB450\uC640 \uC625\uC0C1\uC5D0\uC11C \uBC24\uD558\uB298\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340731
    m_Localized: "\uAC00\uBC29\uC740 \uC2F8\uC9C0 \uC54A\uC558\uB2E4. \uC724 \uC120\uC0DD\uB2D8\uACFC \uCD5C\uD558\uB9B0\uACFC \uC14B\uC774\uC11C, \uB0A8\uB294 \uD55C \uB2EC\uC758 \uB2F9\uBC88\uD45C\uB97C \uCE60\uD310 \uADC0\uD241\uC774\uC5D0 \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340730
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCE60\uD310\uC5D0 \uC4F0\uB358 \uAC78 \uB9C8\uCE68\uB0B4 \uB05D\uAE4C\uC9C0 \uC37C\uB2E4. \uADF8\uB9AC\uACE0 \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4. \uB0B4\uC77C \uB5A0\uB098\uB294 \uC0AC\uB78C\uB4E4 \uBAAB\uC774\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340729
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uCC3D\uAC00\uC5D0\uC11C \uC120\uBC30\uC640 \uB098\uB780\uD788 \uC549\uC544 \uC788\uC5C8\uB2E4. \uB458 \uB2E4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uCC98\uC74C\uC73C\uB85C, \uADF8 \uCE68\uBB35\uC774 \uBD88\uD3B8\uD574 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340728
    m_Localized: "\uAC00\uBC29\uC744 \uC30C\uB2E4. \uB2E4 \uC2F8 \uB193\uACE0, \uC9C0\uD37C\uB294 \uC7A0\uADF8\uC9C0 \uC54A\uC558\uB2E4. \uB0B4\uC77C \uADF8 \uAC00\uBC29\uC744 \uB4E4\uACE0 \uB0B4\uB9B4\uC9C0\uB3C4 \uBAA8\uB974\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340727
    m_Localized: "\uB450 \uC120\uC0DD\uB2D8\uC740 \uB0A8\uB294 \uD1B5\uC870\uB9BC\uC744 \uD55C \uB2EC \uCE58\uB85C \uB2E4\uC2DC \uB098\uB204\uC5C8\uB2E4. \uB450 \uC0AC\uB78C \uBAAB. \uBC15 \uC120\uC0DD\uB2D8\uC774 \"\uB2F9\uBC88 \uC77C\uC9C0\"\uB77C\uACE0 \uC801\uD78C \uACF5\uCC45\uC744 \uC0C8\uB85C \uD3C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340726
    m_Localized: "\uC774\uB984\uC740 \uB05D\uB0B4 \uB4E3\uC9C0 \uBABB\uD588\uB2E4. \uADF8\uB798\uB3C4 \uC190\uC774 \uBA3C\uC800 \uC54C\uACE0 \uC788\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340725
    m_Localized: "\uCD9C\uC11D\uBD80 \uC0AC\uC774\uC5D0\uC11C 102\uD638 \uCABD\uC9C0\uB97C \uAEBC\uB0C8\uB2E4. \uB3D9\uADF8\uB797\uAC8C \uB9D0\uB824 \uC62C\uB77C\uAC04 '\uC694' \uC790. \uAD6C\uC870\uB300\uAC00 \uBA3C\uC800 \uD0DC\uC6B4\uB2E4\uB294 \uC0DD\uC874\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340724
    m_Localized: "\uCE60\uD310\uC5D0\uB294 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC758 \uD310\uC11C\uAC00 \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340723
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD574\uC5F4\uC81C\uB97C \uD55C \uC54C \uB354 \uC0BC\uD0A4\uACE0, \uAC70\uC6B8 \uC55E\uC5D0\uC11C \uC624\uB798 \uC5BC\uAD74\uC744 \uB9E4\uB9CC\uC84C\uB2E4. \uB098\uB294 \uBAA8\uB978 \uCC99\uD588\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uBAA8\uB978 \uCC99\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340722
    m_Localized: "\uC120\uC0DD\uB2D8 \uACC1\uC5D0 \uB2F4\uC694\uB97C \uAE54\uC558\uB2E4. \uB0B4\uC77C \uC544\uCE68, \uB098\uB294 \uC625\uC0C1\uC5D0 \uC624\uB974\uC9C0 \uC54A\uB294\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uADF8 \uC598\uAE30\uB97C \uB2E4\uC2DC \uAEBC\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340721
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uC55E\uC5D0 \uCD9C\uC11D\uBD80\uB97C \uB450\uACE0 \uC654\uB2E4. \uBB38 \uB108\uBA38\uC5D0\uC11C \uC544\uC8FC \uC791\uAC8C, \uD398\uC774\uC9C0 \uB118\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980481
    m_Localized: "\uB3C4\uD604: \uB0AE\uC5D4 \uC800\uAC83\uB4E4\uC774 \uC5B4\uB514\uCBE4 \uC11C \uC788\uB294\uC9C0, \uD574 \uC9C0\uBA74 \uC5B4\uB290 \uCABD\uBD80\uD130 \uC6C0\uC9C1\uC774\uB294\uC9C0 \uB2E4 \uC801\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174947
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uAD6C\uC11D\uAE4C\uC9C0 \uD1B5\uC744 \uB298\uC5B4\uB193\uC558\uB2E4. \uBE57\uC18C\uB9AC\uAC00 \uD1B5\uB9C8\uB2E4 \uB2E4\uB978 \uC74C\uC73C\uB85C \uC6B8\uB838\uB2E4. \uC815\uC218\uD558\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174802
    m_Localized: "'\uADF8\uAC8C \uD551\uACC4\uB77C\uB294 \uAC83\uB3C4 \uC54C\uC544.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340720
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uAD50\uC2E4 \uCE60\uD310\uC744 \uAE68\uB057\uC774 \uC9C0\uC6B0\uACE0, \uB9E8 \uC704\uC5D0 \uB0A0\uC9DC\uB97C \uC801\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uADF8 \uC544\uB798\uC5D0, \uB0B4\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340719
    m_Localized: "\uC120\uBC30\uB294 \uB298 \uC549\uB358 \uCC3D\uAC00 \uAD6C\uC11D\uC5D0\uC11C \uC625\uC0C1 \uCABD\uC744 \uC62C\uB824\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uAC00\uBC29\uC740 \uC624\uD6C4\uC5D0 \uC774\uBBF8 \uB2E4 \uC2F8 \uB450\uC5C8\uB2E4. \uB2E8\uCD9C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340718
    m_Localized: "\uC120\uBC30\uB294 \uAC00\uBC29\uC744 \uC2F8\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uC625\uC0C1 \uBB3C\uD0F1\uD06C \uC606\uC5D0 \uC885\uC774 \uC0C1\uC790 \uD558\uB098\uB97C \uB193\uACE0, \uB2F4\uC694\uB97C \uC811\uC5B4 \uAE54\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340717
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uBCF5\uB3C4 \uB05D \uCC3D\uAC00\uC5D0 \uD63C\uC790 \uC11C \uC788\uC5C8\uB2E4. \uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790 \uD55C \uAC78\uC74C \uC606\uC73C\uB85C \uBE44\uCF1C \uC790\uB9AC\uB97C \uB0B4\uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340716
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uAD50\uC2E4 \uCE60\uD310\uC5D0 \uBB34\uC5B8\uAC00\uB97C \uC4F0\uB2E4\uAC00 \uC9C0\uC6B0\uACE0, \uB2E4\uC2DC \uC37C\uB2E4. \uB05D\uB0B4 \uBB34\uC5C7\uC744 \uC37C\uB294\uC9C0\uB294 \uBCF4\uC5EC \uC8FC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340715
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC57D\uC7A5\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC815\uB9AC\uD588\uB2E4. \uB0A8\uB294 \uC57D\uC5D0\uB294 \uC774\uB984\uD45C\uB97C \uBD99\uC600\uB2E4. \uB2E4\uC74C\uC5D0 \uC774 \uD559\uAD50\uC5D0 \uC62C \uB204\uAD70\uAC00\uB97C \uC704\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340714
    m_Localized: "\uB3C4\uD604\uC740 \uAC00\uBC29\uC744 \uC138 \uBC88\uC774\uB098 \uB2E4\uC2DC \uC30C\uB2E4. \uC138 \uBC88 \uB2E4, \uB9E8 \uC704\uC5D0 \uB123\uC740 \uAC74 \uAC19\uC740 \uC0AC\uC9C4 \uD55C \uC7A5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340713
    m_Localized: "\uC625\uC0C1\uC758 SOS \uAE00\uC528\uB97C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB2E4\uC2DC \uCE60\uD588\uB2E4. \uB208 \uC704\uC5D0 \uBE68\uAC04 \uD398\uC778\uD2B8\uAC00 \uC120\uBA85\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340712
    m_Localized: "\uAD6C\uC870 \uC804\uB0A0 \uBC24. \uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340711
    m_Localized: "\uC544\uBB34\uB3C4 \uB354 \uB9D0\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uC885\uC774\uC758 \uC5EC\uB35F \uCE78 \uC911 \uC138 \uCE78\uC744 \uC9C0\uC6E0\uB2E4. \uC774\uC0C1\uD558\uAC8C \uC190\uC774 \uB5A8\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340710
    m_Localized: "\uCD5C\uD558\uB9B0: \uB450 \uBC88\uC740 \uC5C6\uC5B4. \uB108\uB97C \uAC70\uAE30 \uB450\uACE0 \uB098 \uD63C\uC790 \uB098\uC624\uB294 \uAC70. \uD55C \uBC88\uC774\uBA74 \uCDA9\uBD84\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340709
    m_Localized: "{0}: \uD558\uB9B0\uC544, \uB108\uB294\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340708
    m_Localized: "\uCD5C\uD558\uB9B0: \uB098\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340707
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uCC98\uC74C\uC73C\uB85C \uB5A8\uB838\uB2E4. \uD654\uAC00 \uB098\uC11C\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340706
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB7FC \uB098\uB3C4 \uB0A8\uB294\uB2E4. \uD559\uC0DD\uC744 \uD63C\uC790 \uB450\uACE0 \uD0C0\uB294 \uAD50\uC0AC\uB294 \uC5C6\uB2E4. \uB2E4\uB9AC \uD55C\uCABD\uC73C\uB85C\uB3C4 \uADF8\uAC74 \uC548 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340705
    m_Localized: "{0}: \uC120\uC0DD\uB2D8\uC774 \uC800\uB97C \uCC3D\uACE0\uC5D0\uC11C \uAEBC\uB0B4 \uC92C\uC796\uC544\uC694. \uC774\uBC88\uC5D4 \uC81C\uAC00 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0A8\uC544\uC11C, \uBB38 \uB2EB\uB294 \uC0AC\uB78C\uC774 \uB420\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340704
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC548 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340703
    m_Localized: "{0}: \uC81C\uAC00 \uB0A8\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340702
    m_Localized: "\uB0B4\uAC00 \uB0A8\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340701
    m_Localized: "\uC120\uBC30\uAC00 \uAE30\uD0C0\uB97C \uB4F1\uC5D0 \uBA68\uB2E4. \uC625\uC0C1\uC5D0\uC11C \uD55C \uB2EC. \uC5F0\uC8FC\uD560 \uC2DC\uAC04\uC740 \uB9CE\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340700
    m_Localized: "\uC120\uBC30\uC758 \uC785\uAF2C\uB9AC\uAC00 \uC544\uC8FC \uC870\uAE08 \uC62C\uB77C\uAC14\uB2E4. \uADF8\uAC8C \uB300\uB2F5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340699
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC625\uC0C1 \uACE0\uC591\uC774. \uAC54 \uB450\uACE0 \uBABB \uAC00\uACA0\uB2E4\uB294 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340698
    m_Localized: "\uC120\uBC30\uB294 \uCC9C\uC7A5 \uCABD, \uC625\uC0C1\uC744 \uC190\uAC00\uB77D\uC73C\uB85C \uAC00\uB9AC\uCF30\uB2E4. \uADF8\uB9AC\uACE0 \uB450 \uC190\uC744 \uB3D9\uADF8\uB797\uAC8C \uBAA8\uC544 \uBB34\uC5B8\uAC00\uB97C \uC548\uB294 \uC2DC\uB289\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340697
    m_Localized: "{0}: \uC544\uC9C1 \uC544\uBB34 \uB9D0\uB3C4 \uC548 \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340696
    m_Localized: "\uC120\uBC30\uAC00 \uCC3D\uBC16\uC5D0\uC11C \uB208\uC744 \uB5BC\uACE0 \uB098\uB97C \uBD24\uB2E4. \uADF8\uB9AC\uACE0, \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706463
    m_Localized: "{0}: \uC74C\uC545\uB3C4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174819
    m_Localized: "\uC2DC\uBA58\uD2B8 \uAC00\uB8E8\uB97C \uBB3C\uC5D0 \uAC1C\uC5B4 \uD45C\uC2DC\uB97C \uB36E\uC5C8\uB2E4. \uC190\uC774 \uB5A8\uB824\uC11C \uBA87 \uBC88\uC774\uB098 \uB2E4\uC2DC \uCE60\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980512
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uC0AC \uC0DD\uD65C \uC2ED \uB144 \uB9CC\uC5D0 \uCC98\uC74C \uBC1B\uC544 \uBCF8\uB2E4. \uC9C4\uC9DC \uCE74\uB124\uC774\uC158."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980513
    m_Localized: "{0}: \uC885\uC774\uC778\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340695
    m_Localized: "{0}: \uC120\uBC30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340694
    m_Localized: "\uC120\uBC30\uC5D0\uAC8C \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340693
    m_Localized: "\uC120\uBC30\uB294 \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC600\uB2E4. \uB298 \uADF8\uB7AC\uB4EF\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340692
    m_Localized: "\uC1A1\uC608\uC9C0: \uC120\uBC30\uB3C4\uC694? \u2026\uAC19\uC774 \uC788\uC5B4 \uC8FC\uC2DC\uB294 \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340691
    m_Localized: "\uC120\uBC30\uAC00 \uC77C\uC5B4\uB098 \uC1A1\uC608\uC9C0\uC758 \uAC00\uBC29\uC744 \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uB2E4\uC2DC \uB0B4\uB824\uB193\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340690
    m_Localized: "\uC608\uC9C0\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC870\uAE08 \uB5A8\uB838\uB2E4. \uAC01\uC624\uC778\uC9C0 \uCCB4\uB150\uC778\uC9C0, \uB098\uB294 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340689
    m_Localized: "\uC608\uC9C0\uAC00 \uAC00\uBC29\uC5D0 \uB2E8 \uBCC4 \uD0A4\uB9C1\uC744 \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4. \uB0B4 \uAC00\uBC29\uC5D0\uB3C4 \uAC19\uC740 \uBCC4\uC774 \uB2EC\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340688
    m_Localized: "\uC1A1\uC608\uC9C0: \uC54C\uC544\uC694. \uADF8\uB798\uC11C \uACE0\uB974\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340687
    m_Localized: "{0}: \uADF8\uAC74 \uBC8C \uBC1B\uB294 \uAC8C \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340686
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8\uB54C \uC800\uB294 \uBCF4\uAE30\uB9CC \uD588\uC796\uC544\uC694. \uC774\uBC88\uC5D4, \uC81C\uAC00 \uACE0\uB97C\uAC8C\uC694. \uC81C\uAC00 \uB0A8\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340685
    m_Localized: "\uC1A1\uC608\uC9C0: \uB124. \uC800\uB3C4 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340684
    m_Localized: "{0}: \uC608\uC9C0\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980480
    m_Localized: "\uB3C4\uD604\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0 \uB4F1\uC744 \uB3CC\uB838\uB2E4. \uC228\uC18C\uB9AC\uAC00 \uC624\uB798\uB3C4\uB85D \uACE0\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786308
    m_Localized: "\uAD1C\uCC2E\uB2E4\uACE0, \uB2E4\uC2DC \uC790\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174801
    m_Localized: "'\uC5B4\uC81C \uC77C\uC740 \uB0B4\uAC00 \uC798\uBABB\uD588\uC5B4. \uBAA8\uB974\uB294 \uCC99\uD574\uC11C \uBBF8\uC548\uD574. \uB2E4\uB4E4 \uBCF4\uACE0 \uC788\uC5B4\uC11C \uADF8\uB7AC\uC5B4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340683
    m_Localized: "\uC1A1\uC608\uC9C0\uC5D0\uAC8C \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706464
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC751. \uC0AC\uB78C\uC740 \uC0B4\uC544\uB0A8\uAE30\uB9CC \uD558\uBA74 \uAE08\uBC29 \uC9C0\uCCD0. \uADF8\uB798\uC11C \uD559\uAD50\uC5D0 \uC74C\uC545 \uC2DC\uAC04\uC774 \uC788\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174820
    m_Localized: "\uC9C0\uC6B4\uB2E4\uACE0 \uC5C6\uB358 \uC77C\uC774 \uB418\uC9C0\uB294 \uC54A\uB294\uB2E4. \uADF8\uB798\uB3C4, \uC6B0\uB9AC\uAC00 \uC5EC\uAE30\uC11C \uBCF4\uACE0 \uC788\uB2E4\uB294 \uAC74 \uC54C \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980514
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uB4E4\uC9C0 \uC54A\uC796\uC544. \uADF8\uB7EC\uB2C8\uAE4C \uC9C4\uC9DC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980515
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD558\uB8E8 \uC885\uC77C \uAF43\uC744 \uBE7C\uC9C0 \uC54A\uC558\uB2E4. \uC800\uB141\uC5D0 \uBB3C\uC744 \uB728\uB7EC \uAC08 \uB54C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340682
    m_Localized: "\uC120\uBC30\uB294 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uC885\uC774\uB97C \uAC00\uB9AC\uD0A4\uACE0, \uC190\uAC00\uB77D \uB450 \uAC1C\uB97C \uD3B4 \uBCF4\uC600\uB2E4. \uB450 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340681
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uBB50\uC57C. \uC120\uBC30\uB294 \uC65C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340680
    m_Localized: "\uADF8\uB54C \uC120\uBC30\uAC00 \uCC3D\uAC00\uC5D0\uC11C \uC77C\uC5B4\uB098, \uCD5C\uD558\uB9B0 \uC606\uC5D0 \uC640 \uC549\uC558\uB2E4. \uAC00\uBC29\uC744 \uBC14\uB2E5\uC5D0 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340679
    m_Localized: "\uD558\uB9B0\uC740 \uB05D\uAE4C\uC9C0 \uB0B4 \uB208\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340678
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uADF8\uB798\uB3C4, \uB124\uAC00 \uB098\uD55C\uD14C \uBB3C\uC5B4\uBD10 \uC918\uC11C \uC880 \uC88B\uB2E4. \uC774\uC0C1\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340677
    m_Localized: "\uCD5C\uD558\uB9B0: \uAC70\uC9D3\uB9D0. \uADFC\uB370 \uAD1C\uCC2E\uC544. \uB098\uB294 \uC5EC\uAE30 \uD55C \uB2EC \uB354 \uC788\uC5B4\uB3C4 \uB3FC. \uADF8\uB798\uB3C4 \uC2F8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340676
    m_Localized: "{0}: \uADF8\uB7F0 \uB73B \uC544\uB2C8\uC57C. \uADF8\uB0E5\u2026 \uB124\uAC00 \uC81C\uC77C \uC624\uB798 \uBC84\uD2F8 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786307
    m_Localized: "\uB2E4 \uB4E3\uACE0 \uB098\uC11C, \uD560 \uC218 \uC788\uB294 \uB9D0\uC740 \uD558\uB098\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4. \"\uAC19\uC774 \uCC3E\uC544\uBCF4\uC790. \uC5B8\uC820\uAC00.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786306
    m_Localized: "\uD615\uC774 3\uD559\uB144 \uAD50\uC2E4\uC5D0 \uC788\uC5C8\uB2E4\uACE0 \uD588\uB2E4. \uAC19\uC774 \uC9D1\uC5D0 \uAC00\uAE30\uB85C \uD588\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174800
    m_Localized: "\uC5F0\uC2B5\uC7A5\uC744 \uCC22\uC740 \uC885\uC774\uC600\uB2E4. \uBA87 \uBC88\uC744 \uC9C0\uC6E0\uB2E4 \uB2E4\uC2DC \uC4F4 \uC790\uAD6D\uC774 \uBE44\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340675
    m_Localized: "\uCD5C\uD558\uB9B0: \uC54C\uC544. \uB098 \uBD80\uB97C \uC904 \uC54C\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340674
    m_Localized: "{0}: \uD558\uB9B0\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340673
    m_Localized: "\uD558\uB9B0\uC5D0\uAC8C \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340672
    m_Localized: "\uC885\uC774 \uB9E8 \uC544\uB798\uC5D0, \uCE78 \uBC16\uC73C\uB85C \uB3D9\uADF8\uB77C\uBBF8 \uD558\uB098\uB97C \uB354 \uADF8\uB838\uB2E4. \uADF8\uB9AC\uACE0 \uADF8 \uC606\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC791\uAC8C \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340671
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00, \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340670
    m_Localized: "{0}: \u2026\uD63C\uC790\uB294 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340669
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uADF8 \uC560\uB294 \uC5EC\uAE30 \uD63C\uC790 \uB0A8\uB294\uB2E4. \uCC98\uC74C \uC640 \uBCF4\uB294 \uD559\uAD50\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340668
    m_Localized: "{0}: \uADF8 \uC560\uB77C\uBA74, \uB0B4\uB824 \uC904 \uAC70\uC608\uC694. \uC790\uAE30 \uC790\uB9AC\uB97C \uC904 \uAC70\uC608\uC694. \uADF8\uB7F0 \uC560\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340667
    m_Localized: "{0}: \uAD6C\uC870\uB300\uAC00 \uBA3C\uC800 \uD0DC\uC6B4 \uC0AC\uB78C. \uADF8 102\uD638 \uCABD\uC9C0\uB97C \uC4F4 \uC0AC\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340666
    m_Localized: "\uD5EC\uAE30\uC5D0 \uBA3C\uC800 \uD0C0 \uC788\uC744 {0}\uC5D0\uAC8C \uBD80\uD0C1\uD558\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786305
    m_Localized: "\uC606\uC5D0 \uC549\uC544 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706465
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uCC3D\uACE0 \uBB38\uC740 \uBC16\uC5D0\uC11C \uC7A0\uACA8 \uC788\uC5C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174821
    m_Localized: "\uD45C\uC2DC \uC606\uC5D0 '\uBE48 \uD559\uAD50. \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC74C.'\uC774\uB77C\uACE0 \uB367\uCE60\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980516
    m_Localized: "\uC9E7\uC740 \uD3B8\uC9C0\uB97C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980517
    m_Localized: "\uACF5\uCC45 \uD55C \uC7A5\uC744 \uCC22\uC5B4 \uBA87 \uC904\uC744 \uC37C\uB2E4. \uACE0\uB9D9\uB2E4\uB294 \uB9D0\uC744 \uC4F0\uB824\uACE0 \uD588\uB294\uB370 \uB2E4\uB978 \uB9D0\uC774 \uBA3C\uC800 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786304
    m_Localized: "\uB3C4\uD604: \u2026\uC8C4\uC1A1\uD574\uC694. \uC2DC\uB044\uB7EC\uC6E0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174799
    m_Localized: "\uD0D0\uD5D8 \uC911 \uC8FC\uC6B4 \uD3B8\uC9C0 \uD55C \uC7A5. 2\uD559\uB144 \uB204\uAD70\uAC00\uAC00 \uAC19\uC740 \uBC18 \uCE5C\uAD6C\uC5D0\uAC8C \uC4F4, \uBD80\uCE58\uC9C0 \uBABB\uD55C \uD3B8\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340665
    m_Localized: "\uC885\uC774\uC758 \uC5EC\uB35F \uCE78 \uC911 \uB450 \uCE78\uC744 \uC9C0\uC6E0\uB2E4. \uC9C0\uC6B0\uAC1C \uAC00\uB8E8\uAC00 \uCD9C\uC11D\uBD80 \uC704\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340664
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uADF8 \uB9D0\uC744 \uD558\uACE0 \uB098\uC11C \uB098\uB97C \uBCF4\uC9C0 \uC54A\uC558\uB2E4. \uC57D \uC0C1\uC790\uB9CC \uB2E4\uC2DC \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340663
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD39C\uB77C\uC774\uD2B8\uB294 \uB124\uAC00 \uAC16\uACE0 \uAC00. \uD55C \uB2EC \uB4A4\uC5D0 \uB3CC\uB824\uBC1B\uC744 \uAC70\uC57C. \uAC74\uC804\uC9C0 \uC544\uAEF4 \uC4F0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340662
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0, \uC18C\uB9AC \uB0B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340661
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uD55C \uB2EC \uB3D9\uC548 \uC120\uC0DD\uB2D8 \uB2E4\uB9AC \uC18C\uB3C5\uC740 \uB204\uAC00 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340660
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC5B4\uB978\uB4E4\uC758 \uCC45\uC784\uC774\uC796\uC544\uC694. \uD55C \uC0AC\uB78C\uB9CC \uB0A8\uC73C\uBA74 \uADF8\uAC74 \uD76C\uC0DD\uC774\uACE0, \uB458\uC774 \uB0A8\uC73C\uBA74 \uADF8\uB0E5 \uB2F9\uBC88\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340659
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC15 \uC120\uC0DD\uB2D8, \uD55C \uC790\uB9AC\uBA74 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340658
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uC800\uB3C4 \uB0A8\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340657
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uB9D0\uC744 \uB124\uAC00 \uBA3C\uC800 \uD574 \uC918\uC11C \uB2E4\uD589\uC774\uB2E4. \uB0B4\uAC00 \uAEBC\uB0C8\uC73C\uBA74, \uB108\uD76C\uAC00 \uB9D0\uB838\uC744 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460284
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uB4E4\uCF30\uB124. \uB108, \uB208\uC774 \uC88B\uAD6C\uB098. \uBB34\uC12D\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460283
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC774 \uBA48\uCDC4\uB2E4. \uD55C\uCC38 \uB4A4\uC5D0\uC57C \uB300\uB2F5\uC774 \uC654\uB2E4. \uB538 \uBAAB\uC774\uB77C\uACE0. \uADF8\uB0E5 \uC2B5\uAD00\uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174822
    m_Localized: "\uD07C\uC9C1\uD558\uAC8C, \uB300\uCDA9, \uBC84\uB824\uC9C4 \uACF3\uCC98\uB7FC \uBCF4\uC774\uAC8C \uC37C\uB2E4. \uCC3D\uBB38\uC5D0\uB294 \uC77C\uBD80\uB7EC \uBA3C\uC9C0\uB97C \uBB3B\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980518
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD3B8\uC9C0\uB97C \uB450 \uBC88 \uC77D\uACE0, \uC138 \uBC88\uC9F8\uB294 \uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uACE0 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980519
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB2F5\uC7A5\uC740 \uBABB \uC4F0\uACA0\uB2E4. \uAE00 \uAC00\uB974\uCE58\uB294 \uC0AC\uB78C\uC774 \uC774\uB7EC\uBA74 \uC548 \uB418\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174952
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uB2E4 \uAC19\uC774 \uB098\uB220 '\uC0BC\uACC4\uD0D5'\uC744 \uB053\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980520
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB300\uC2E0 \uC774\uAC74 \uC57D\uC18D\uD560\uAC8C. \uB0B4\uB144 \uC624\uB298\uB3C4 \uB098\uB294 \uB124 \uC120\uC0DD\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340656
    m_Localized: "{0}: \uC120\uC0DD\uB2D8. \uD55C \uB2EC\uB9CC\u2026 \uAE30\uB2E4\uB824 \uC8FC\uC2E4 \uC218 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786303
    m_Localized: "\uAE68\uC5B4\uB09C \uB3C4\uD604\uC740 \uB540\uC5D0 \uC816\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786302
    m_Localized: "\uC0C8\uBCBD, \uB3C4\uD604\uC774 \uBAB8\uC744 \uC6C5\uD06C\uB9B0 \uCC44 \uC7A0\uAF2C\uB300\uB97C \uD588\uB2E4. \uD615, \uD615 \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174829
    m_Localized: "\uC870\uAC74\uC744 \uBD99\uC5EC \uD611\uC0C1\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340655
    m_Localized: "\uC120\uC0DD\uB2D8\uB4E4\uAED8 \uB2E4\uC74C \uD5EC\uAE30\uB97C \uBD80\uD0C1\uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340654
    m_Localized: "\uBAA8\uB450\uC758 \uB208\uC774 \uB098\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uC120\uBC30\uB9CC\uC774 \uCC3D\uBC16\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uB298 \uADF8\uB807\uB4EF\uC774, \uB9E1\uAE30\uBA74 \uD558\uACA0\uB2E4\uB294 \uC5BC\uAD74\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340653
    m_Localized: "\uCD5C\uD558\uB9B0: \uC815\uD574. \uB124\uAC00. \uB2E4\uB4E4 \uADF8\uAC78 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340652
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB204\uAC00 \uB0A8\uB4E0, \uD55C \uB2EC\uC774\uC57C. \uC57D\uC740 \uD55C \uB2EC \uCE58 \uB109\uB109\uD788 \uB0A8\uACA8 \uB458\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174823
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC18D\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4. \uC0AC\uB78C\uC740 \uBE44\uC5B4 \uC788\uB2E4\uB294 \uB9D0\uC744 \uC81C\uC77C \uC548 \uBBFF\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980521
    m_Localized: "\uD3B8\uC9C0\uB294 \uCD9C\uC11D\uBD80 \uB9E8 \uB4B7\uC7A5\uC5D0 \uB07C\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980522
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC18 \uACC4\uC8FC \uB300\uC2E0, \uBCF5\uB3C4 \uB05D\uAE4C\uC9C0 \uC655\uBCF5 \uC5B4\uB54C. \uC18C\uB9AC\uB294 \uB0B4\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340651
    m_Localized: "\uC900\uC774 \uC6B0\uBE44 \uC18C\uB9E4\uB97C \uAF2D \uC950\uACE0, \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806662340650
    m_Localized: "{0}: \uC548 \uB3FC. \uADF8\uAC74 \uC120\uC0DD\uB2D8 \uB9D0\uC774 \uB9DE\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923655
    m_Localized: "\uC0AC\uD0D5\uC744 \uD558\uB098 \uAE4C\uC11C \uB098\uB220 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923654
    m_Localized: "\uB2E4 \uB4E3\uACE0 \uB098\uB2C8 \uC9C0\uB3C4\uAC00 \uCC98\uC74C \uBCF4\uB294 \uB3D9\uB124 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923653
    m_Localized: "\uC120 \uD558\uB098\uB9C8\uB2E4 \uADF8\uAC00 \uB9D0\uC744 \uBD99\uC600\uB2E4. \uC5EC\uAE34 \uBE44 \uC624\uBA74 \uBB3C \uCC28, \uC5EC\uAE34 \uAC1C\uAC00 \uC788\uC5B4, \uC5EC\uAE34 \uB0AE\uC5D0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923652
    m_Localized: "\uC0C8 \uAE38\uC744 \uD558\uB098\uC529 \uB530\uB77C \uC9DA\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923651
    m_Localized: "\uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC0AC\uD0D5 \uBA87 \uAC1C\uAC00 \uAD74\uB7EC \uB098\uC640 \uC9C0\uB3C4 \uC704\uC5D0 \uD769\uC5B4\uC84C\uB2E4. \uBE44\uB2D0 \uAECD\uC9C8\uC774 \uC190\uC804\uB4F1 \uBE5B\uC5D0 \uBC18\uC9DD\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923650
    m_Localized: "\uC720\uB791\uC790: \uC0AC\uB78C\uC740 \uAE38\uB85C \uB2E4\uB2C8\uACE0, \uC9D0\uC2B9\uC740 \uAE38 \uC606\uC73C\uB85C \uB2E4\uB2CC\uB2E4. \uC9C0\uAE08\uC740 \uC9D0\uC2B9\uCC98\uB7FC \uB2E4\uB140\uC57C \uC0B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174949
    m_Localized: "\uB77D\uC2A4\uB97C \uC544\uAEF4 \uAC00\uBA70 \uBCBD\uC744 \uB2E6\uC558\uB2E4. \uB0C4\uC0C8\uAC00 \uB3C5\uD588\uC9C0\uB9CC, \uBC24\uC5D0 \uC228\uC26C\uAE30\uAC00 \uD55C\uACB0 \uD3B8\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980498
    m_Localized: "\uB298 \uADF8\uB7AC\uB4EF \uB531 \uC911\uAC04\uCBE4. \uADF8\uB7F0\uB370 \uC624\uB298\uC740 \uADF8 \uC911\uAC04\uC774 \uC774\uC0C1\uD558\uAC8C \uBFCC\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923649
    m_Localized: "\uADF8\uAC00 \uBABD\uB2F9\uC5F0\uD544\uC744 \uAEBC\uB0B4 \uC9C0\uB3C4 \uC704\uC5D0 \uAC00\uB294 \uC120\uC744 \uBA87 \uC904 \uB354\uD588\uB2E4. \uC544\uD30C\uD2B8 \uB4A4 \uBC30\uC218\uB85C, \uACF5\uC6D0 \uCCA0\uB9DD \uD2C8, \uC0C1\uAC00 \uC625\uC0C1\uB07C\uB9AC \uBD99\uC740 \uACF3."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923648
    m_Localized: "\uC720\uB791\uC790: \uC798 \uADF8\uB838\uB2E4. \uADFC\uB370 \uAE38\uC774 \uD070\uAE38\uBFD0\uC774\uB124. \uD070\uAE38\uC740 \uC800\uAC83\uB4E4\uB3C4 \uC88B\uC544\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923647
    m_Localized: "\uBC24\uC5D0 \uAC00 \uBCF4\uB2C8 \uADF8\uB294 \uD604\uAD00 \uACC4\uB2E8\uC5D0 \uC549\uC544 \uB0B4 \uC9C0\uB3C4\uB97C \uB4E4\uC5EC\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uCC45\uC0C1\uC5D0 \uB450\uACE0 \uC628 \uAC78 \uB204\uAC00 \uAC00\uC838\uB2E4\uC900 \uBAA8\uC591\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923646
    m_Localized: "\uD574 \uC9C8 \uB158, \uB5A0\uB0AC\uB358 \uC720\uB791\uC790\uAC00 \uAD50\uBB38\uC73C\uB85C \uB3CC\uC544\uC654\uB2E4. \uBE44\uAC00 \uC62C \uAC83 \uAC19\uB2E4\uACE0, \uD604\uAD00 \uCC98\uB9C8 \uBC11\uB9CC \uD558\uB8FB\uBC24 \uBE4C\uB9AC\uC790\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923645
    m_Localized: "\uBC24, \uCCB4\uC721\uAD00 \uB9E4\uD2B8 \uC704\uC5D0\uC11C \uC720\uB791\uC790\uAC00 \uB0B4 \uC9C0\uB3C4\uB97C \uB4E4\uC5EC\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uD0D0\uD5D8 \uB2E4\uB2C8\uBA70 \uC190\uC73C\uB85C \uADF8\uB824 \uC628, \uAD50\uC2E4 \uCC45\uC0C1\uC5D0 \uD3BC\uCCD0 \uB454 \uADF8 \uC9C0\uB3C4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923644
    m_Localized: "(\uC120\uBC30\uAC00 \uD604\uAD00\uC744 '\uB4E0\uB4E0\uD55C \uB4F1'\uC73C\uB85C \uC9C0\uD0A8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923643
    m_Localized: "\uD604\uAD00 \uC55E \uBCF5\uB3C4\uAC00 \uCC98\uC74C\uC73C\uB85C \uAC70\uC2E4\uCC98\uB7FC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980499
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC8C \uB124 \uCCAB \uC131\uC801\uC774\uB124. \uB0B4\uAC00 \uC544\uB294 \uD55C\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980500
    m_Localized: "\uC624\uB298\uC740 \uB561\uB561\uC774\uCE5C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923642
    m_Localized: "\uBC29\uC5D0 \uC788\uB358 \uC0AC\uB78C\uB4E4\uAE4C\uC9C0 \uAE68\uC6CC \uB370\uB824\uC654\uB2E4. \uC120\uBC30\uB294 \uC0AC\uB78C\uC774 \uB298\uC5B4\uB3C4 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923641
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4 \uBD80\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923640
    m_Localized: "\uADF8\uB0A0 \uBC24, \uC624\uB79C\uB9CC\uC5D0 \uBAA8\uB450 \uAC19\uC740 \uC2DC\uAC04\uC5D0 \uC7A0\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923639
    m_Localized: "\uC544\uBB34\uB3C4 \uBC15\uC218 \uCE58\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC8C \uB9DE\uB294 \uAC83 \uAC19\uC558\uB2E4. \uC120\uBC30\uB294 \uC7A0\uC2DC \uB4A4 \uC904\uC744 \uB2E4\uC2DC \uD295\uACBC\uB2E4. \uB450 \uBC88\uC9F8 \uACE1."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923638
    m_Localized: "\uB2E4\uC74C \uACE1\uC744 \uAE30\uB2E4\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923637
    m_Localized: "\uACE1\uC774 \uB05D\uB098\uC790 \uC120\uBC30\uB294 \uAE30\uD0C0\uB97C \uB0B4\uB824\uB193\uACE0 \uBC14\uB9AC\uCF00\uC774\uB4DC \uD310\uC790 \uD558\uB098\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C \uB450 \uBC88 \uCCE4\uB2E4. \uADF8\uB9AC\uACE0 \uB098\uB97C \uBCF4\uC558\uB2E4. \uC774 \uBB38\uC740 \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4\uB294 \uB73B \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923636
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB208\uC744 \uAC10\uC558\uB2E4. \uC190\uAC00\uB77D\uC774 \uBB34\uB98E \uC704\uC5D0\uC11C \uBC15\uC790\uB97C \uC9DA\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460322
    m_Localized: "\uADF8 \uB9D0\uC774 \uC774\uC0C1\uD558\uAC8C \uC2AC\uD504\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460321
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uB144 \uBD04\uC5D0\uB3C4 \uC774 \uB098\uBB34\uB294 \uD544 \uAC70\uC57C. \uC6B0\uB9AC\uAC00 \uBCF4\uB4E0 \uC548 \uBCF4\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460320
    m_Localized: "\uAF43\uC78E\uC774 \uC8FC\uBA39\uBC25 \uC704\uC5D0 \uB0B4\uB824\uC549\uC558\uB2E4. \uD138\uC5B4 \uB0B4\uC9C0 \uC54A\uACE0 \uADF8\uB0E5 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923635
    m_Localized: "\uBCF5\uB3C4\uC5D0 \uD558\uB098\uB458 \uC0AC\uB78C\uB4E4\uC774 \uB098\uC654\uB2E4. \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB4E4 \uBCBD\uC5D0 \uAE30\uB300 \uC549\uC544 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923634
    m_Localized: "\uC544\uC8FC \uC791\uAC8C. \uC785\uC740 \uB2E4\uBB38 \uCC44, \uCF67\uC18C\uB9AC\uB85C \uD765\uC5BC\uAC70\uB9AC\uBA74\uC11C. \uAC00\uC0AC\uB294 \uC5C6\uC5C8\uB2E4. \uC544\uB294 \uB178\uB798 \uAC19\uAE30\uB3C4 \uD558\uACE0 \uCC98\uC74C \uB4E3\uB294 \uB178\uB798 \uAC19\uAE30\uB3C4 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923633
    m_Localized: "\uADF8\uB9AC\uACE0 \uCC98\uC74C\uC73C\uB85C, \uC120\uBC30\uAC00 \uAE30\uD0C0\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806674923632
    m_Localized: "\uC120\uBC30\uAC00 \uBC14\uB9AC\uCF00\uC774\uB4DC \uACC4\uB2E8\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBB34\uB98E\uC5D0 \uADF8 \uAE30\uD0C0\uAC00 \uC788\uC5C8\uB2E4. \uC606\uC5D0\uB294 \uC5B4\uB514\uC11C \uC8FC\uC6CC \uC628 CD \uCF00\uC774\uC2A4 \uD558\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980501
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACB0\uC11D \uCC98\uB9AC. \uB300\uC2E0 \uC625\uC0C1 \uCCAD\uC18C \uBC8C\uC810\uC774\uB2E4. \u2026\uB18D\uB2F4\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980502
    m_Localized: "{0}: \uC2DC\uD5D8 \uC548 \uBD10\uB3C4 \uB418\uB294 \uC138\uC0C1\uC774 \uB410\uB294\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460319
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uBC9A\uB098\uBB34 \uC544\uB798\uC5D0 \uB3D7\uC790\uB9AC\uB97C \uD3B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460318
    m_Localized: "\uB3C4\uD604\uC774 \uC6B4\uB3D9\uD654 \uB048\uC744 \uB450 \uBC88\uC774\uB098 \uACE0\uCCD0 \uBB36\uC5C8\uB2E4. \uC18C\uD48D \uAC00 \uBCF8 \uAC8C \uC5B8\uC81C\uC600\uB294\uC9C0 \uBAA8\uB974\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174995
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB9DB\uC788\uB2E4. \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174994
    m_Localized: "\uC694\uB9AC\uBD80\uC5D0\uC11C \uBC30\uC6B4 \uB300\uB85C \uBB3C\uC744 \uC870\uAE08 \uB354 \uC7A1\uACE0, \uB0A8\uC740 \uAE40\uCE58\uB97C \uC798\uAC8C \uC370\uC5B4 \uB123\uC5C8\uB2E4. \uB77C\uBA74 \uD558\uB098\uAC00 \uB458\uC774 \uBA39\uAE30\uC5D0 \uB109\uB109\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174993
    m_Localized: "\uAC00\uC2A4\uBC84\uB108 \uD558\uB098\uB85C \uB053\uC778 \uB77C\uBA74\uC774\uC5C8\uC9C0\uB9CC, \uC2DD\uD310\uC5D0 \uB35C\uC5B4 \uBA39\uC73C\uB2C8 \uC774\uC0C1\uD558\uAC8C \uD559\uAD50 \uAE09\uC2DD \uB9DB\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174992
    m_Localized: "\uC624\uB298 \uC800\uB141\uC740 \uB2E4 \uAC19\uC774 \uC5EC\uAE30\uC11C \uBA39\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174991
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 1\uD559\uB144\uC740 4\uAD50\uC2DC\uAC00 \uCCB4\uC721\uC774\uC5C8\uC9C0. \uB2E4\uB4E4 \uBC30\uACE0\uD320\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174990
    m_Localized: "{0}: \u2026\uCE74\uB808\uC600\uAD6C\uB098. \uADF8\uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174926
    m_Localized: "\uC1A1\uC608\uC9C0: \uACBD\uACC4 \uC11C\uB290\uB77C \uBC30\uACE0\uD30C\uC11C \uADF8\uB7AC\uC5B4. \uD55C \uAC1C\uC57C, \uD55C \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591893
    m_Localized: "\uADF8\uB9AC\uACE0, \uC0AC\uB78C\uC758 \uBAA9\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117882
    m_Localized: "\uC77D\uB2E4\uAC00 \uBAA9\uC774 \uBA54\uC5B4 \uD55C \uBC88 \uBA48\uCDC4\uB2E4. \uC1A1\uCD9C \uC911\uC774\uB77C\uB294 \uAC78 \uC54C\uBA74\uC11C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117881
    m_Localized: "{0}: \"\uBC25 \uC798 \uCC59\uACA8 \uBA39\uC5B4. \uB204\uB098\uB294 \uC798 \uC788\uC5B4. \uBD04\uC774 \uC624\uBA74 \uB2E4\uB9AC \uC55E\uC5D0\uC11C \uAE30\uB2E4\uB9B4\uAC8C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117880
    m_Localized: "DJ \uC0C8\uBCBD\uC774 \uC804\uD574 \uC900 \uC0AC\uC5F0 \uD558\uB098\uB97C \uC77D\uC5C8\uB2E4. \uAC15 \uAC74\uB108\uC5D0 \uC0AC\uB294 \uB204\uAD70\uAC00\uAC00, \uD5E4\uC5B4\uC9C4 \uB3D9\uC0DD\uC5D0\uAC8C \uBCF4\uB0B4\uB294 \uC9E7\uC740 \uD3B8\uC9C0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826582
    m_Localized: "{0}: \uACB0\uACFC \uB098\uC654\uB2E4. \uC74C\u2026 \uB0B4\uAC00 \uC0DD\uAC01\uD55C \uB108\uB791 \uAC70\uC758 \uAC19\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117878
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC606\uC5D0\uC11C \uC0C1\uCC98 \uC18C\uB3C5\uD558\uB294 \uBC95\uC744 \uD55C \uC904 \uB354 \uBD88\uB7EC \uC8FC\uC5C8\uB2E4. \uB098\uB294 \uADF8\uB300\uB85C \uB530\uB77C \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117877
    m_Localized: "\uACF5\uCC45\uC5D0 \uC801\uC5B4 \uB454 \uAC83\uC744 \uB610\uBC15\uB610\uBC15 \uC77D\uC5C8\uB2E4. \uBE57\uBB3C\uC740 \uAF2D \uB053\uC5EC \uB9C8\uC2E4 \uAC83. \uD070\uAE38\uBCF4\uB2E4 \uACE8\uBAA9\uC774 \uC870\uC6A9\uD558\uB2E4\uB294 \uAC83. \uD574 \uC9C0\uAE30 \uC804\uC5D0 \uBB38\uC744 \uC7A0\uAE00 \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826583
    m_Localized: "{0}: \uADF8\uB7F0 \uC0AC\uB78C\uC774 \uC81C\uC77C \uC6B4 \uC88B\uB300. \uBC29\uAE08 \uB0B4\uAC00 \uC9C0\uC5B4\uB0C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117875
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4 \uC120\uACE1 \uC88B\uB124\uC694. \uC774\uAC70 \uC6B0\uB9AC \uCABD\uC5D0\uC11C\uB3C4 \uD55C \uBC88 \uB354 \uD2C0\uAC8C\uC694. \uC800\uC791\uAD8C\uC740\u2026 \uBB50, \uC774\uC81C \uB530\uC9C8 \uC0AC\uB78C\uB3C4 \uC5C6\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117874
    m_Localized: "\uACE1\uC774 \uB05D\uB098\uC790 3\uBC88 \uCC44\uB110\uC5D0\uC11C DJ \uC0C8\uBCBD\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB07C\uC5B4\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117873
    m_Localized: "CD\uB97C \uD50C\uB808\uC774\uC5B4\uC5D0 \uB123\uACE0, \uB9C8\uC774\uD06C\uB97C \uC2A4\uD53C\uCEE4 \uC55E\uC5D0 \uAC00\uAE4C\uC774 \uB314\uB2E4. \uC74C\uC9C8\uC740 \uD615\uD3B8\uC5C6\uC744 \uAC83\uC774\uB2E4. \uADF8\uB798\uB3C4 \uB178\uB798\uB294 \uB178\uB798\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826584
    m_Localized: "\uB531\uD788 \uC5C6\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117871
    m_Localized: "{0}: \uB204\uAD70\uC9C0\uB294 \uB9D0 \uC548 \uD560\uAC8C\uC694. \uADF8\uB0E5\u2026 \uC544\uC9C1 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294 \uAC83\uB9CC \uC54C\uB824 \uC8FC\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117870
    m_Localized: "\uC774\uB984 \uC5C6\uC774 \uBAA9\uC18C\uB9AC\uB9CC \uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117869
    m_Localized: "\uC1A1\uCD9C\uC744 \uB044\uACE0 \uB098\uC11C\uC57C \uC228\uC744 \uC26C\uC5C8\uB2E4. \uC7A1\uC74C \uB108\uBA38 \uC5B4\uB518\uAC00\uC5D0\uC11C \uB204\uAD70\uAC00 \uC774 \uB9D0\uC744 \uB4E4\uC5C8\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460387
    m_Localized: "\uBC18\uB098\uC808\uC744 \uAC78\uC5C8\uB2E4. \uC228\uC774 \uD131\uAE4C\uC9C0 \uCC3C\uC744 \uB54C \uC804\uB9DD\uB300 \uB09C\uAC04\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460386
    m_Localized: "\uAC78\uC5B4\uC11C \uB4B7\uC0B0 \uB108\uBA38 \uC804\uB9DD\uB300\uAE4C\uC9C0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460385
    m_Localized: "\uBC30\uB0AD\uC5D0 \uC774\uD2C0 \uCE58 \uBA39\uC744 \uAC83\uACFC \uBB3C, \uB2F4\uC694\uB97C \uB123\uC5C8\uB2E4. \uD558\uB8FB\uBC24 \uD559\uAD50\uB97C \uBE44\uC6B4\uB2E4\uB294 \uAC8C \uC2E4\uAC10 \uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460384
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9B4\uAC8C. \uAC00\uB294 \uAE38\uC774 \uB108\uBB34 \uBA40\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460383
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C \uB05D\uC5D0 \uACE0\uBB34\uB97C \uC0C8\uB85C \uAC10\uC558\uB2E4. \uBA3C \uAE38\uC744 \uAC08 \uCC44\uBE44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460382
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC5EC\uAE30 \uB0A8\uC744\uAC8C. \uB204\uAD70\uAC00\uB294 \uD559\uAD50\uB97C \uC9C0\uCF1C\uC57C\uC9C0. \u2026\uC0AC\uC9C4 \uB300\uC2E0 \uC774\uC57C\uAE30\uB97C \uAC00\uC838\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460381
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uB144\uC740 \uBAA8\uB974\uB2C8\uAE4C, \uC62C\uD574 \uAC00\uC790. \uC6B0\uB9AC\uB07C\uB9AC \uC218\uD559\uC5EC\uD589."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460380
    m_Localized: "\uC6D0\uB798 \uC774\uBC88 \uC8FC\uB294 2\uD559\uB144 \uC120\uBC30\uB4E4\uC758 \uC218\uD559\uC5EC\uD589 \uC8FC\uAC04\uC774\uC5C8\uB2E4. 1\uD559\uB144\uC740 \uB0B4\uB144\uC774 \uB420 \uAC70\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826530
    m_Localized: "\uBB38 \uB108\uBA38\uC5D0\uC11C \uC791\uAC8C \uC228\uC744 \uB4E4\uC774\uCF1C\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706438
    m_Localized: "\uC120\uBC30\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uB9AC\uACE0 \uC544\uC8FC \uC791\uAC8C, \uC228\uC774 \uC0C8\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC6C3\uC74C\uC774\uC5C8\uB2E4. \uCC98\uC74C \uB4E3\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706439
    m_Localized: "\uC120\uBC30\uB294 '2\uD559\uB144' \uC606\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uCD9C\uC11D."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706440
    m_Localized: "\uC120\uBC30\uB294 \uCD9C\uC11D\uBD80\uB97C \uB3CC\uB824\uC8FC\uACE0 \uCC3D\uAC00 \uC790\uB9AC\uB85C \uB3CC\uC544\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706441
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 \uC774\uAC74 \uC800\uC808\uB85C \uC548 \uB098\uC544. \uC774\uB7F0 \uB370\uC120 \uC791\uC740 \uC0C1\uCC98\uAC00 \uC81C\uC77C \uBB34\uC11C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460374
    m_Localized: "\uD574\uAC00 \uB2E4 \uB5A0\uC624\uB97C \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uAC19\uC740 \uAC78 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460373
    m_Localized: "\uC0C8\uBCBD, \uC625\uC0C1 \uBB38\uC744 \uC5F4\uC790 \uC228\uC774 \uD558\uC597\uAC8C \uC5BC\uC5C8\uB2E4. \uB3D9\uCABD \uD558\uB298 \uB05D\uC774 \uC544\uC8FC \uCC9C\uCC9C\uD788 \uBD89\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460372
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uD574 \uB728\uB294 \uAC78 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460371
    m_Localized: "\uB3C4\uD604\uC774 \uB208\uC0AC\uB78C \uC606\uC5D0 \uC791\uC740 \uB208\uC0AC\uB78C\uC744 \uD558\uB098 \uB354 \uB9CC\uB4E4\uC5C8\uB2E4. \uC5C4\uB9C8 \uAC70\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460370
    m_Localized: "\uB2E8\uCD94 \uB300\uC2E0 \uBCD1\uB69C\uAED1, \uCF54\uB294 \uC5F0\uD544. \uBAA9\uB3C4\uB9AC\uB294 \uB0B4 \uAC83\uC744 \uD480\uC5B4 \uAC10\uC544 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460369
    m_Localized: "\uB208\uC744 \uAD74\uB9AC\uACE0 \uAD74\uB838\uB2E4. \uBA38\uB9AC\uB97C \uC62C\uB9AC\uB294 \uB370 \uB458\uC774 \uD544\uC694\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460368
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0 \uB208\uC0AC\uB78C\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460367
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB208 \uC624\uB294 \uB0A0 \uAD50\uC2E4\uC5D0 \uC549\uC544 \uC788\uB294 \uAC74 \uC8C4\uC57C. \uB098\uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460366
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uB2F4\uC694\uB97C \uB450\uB974\uACE0 \uCC3D\uAC00\uC5D0 \uC549\uC558\uB2E4. \uC190\uC744 \uD754\uB4E4\uC5B4 \uC6B0\uB9AC\uB97C \uB0B4\uBCF4\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460365
    m_Localized: "\uBC24\uC0C8 \uB208\uC774 \uB0B4\uB838\uB2E4. \uC6B4\uB3D9\uC7A5\uC774 \uCC98\uC74C \uBCF4\uB294 \uACF3\uCC98\uB7FC \uD558\uC5AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826531
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC54C\uC558\uC5B4. \uBAB8 \uC870\uC2EC\uD558\uACE0. \uC5EC\uAE30 \uC77C \uC815\uB9AC\uD558\uBA74\u2026 \uC0DD\uAC01\uD574 \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706442
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC0C1\uC790\uC5D0 \uBD95\uB300\uAC00 \uB0A8\uC544 \uC788\uC73C\uB2C8\uAE4C, \uC624\uB298 \uBC24\uC5D4 \uD479 \uC790. \uC790\uAE30 \uC804\uC5D0 \uB0B4\uAC00 \uAC10\uC544 \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706443
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC774 \uD558\uB098\uB3C4 \uC5C6\uB124\u2026. \uB2E4\uC74C\uC5D0 \uB098\uAC00\uBA74 \uBD95\uB300\uB4E0 \uC18C\uB3C5\uC57D\uC774\uB4E0, \uBCF4\uC774\uB294 \uAC74 \uAF2D \uCC59\uACA8 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706444
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 {0}, \uB2E4\uCE58\uBA74 \uC228\uAE30\uC9C0 \uB9C8. \uC808\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706445
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC625\uC0C1\uC774\uB791 \uD648\uD1B5\uC744 \uD0C0\uACE0 \uB0B4\uB824\uC628 \uBB3C\uC774\uC57C. \uBB50\uAC00 \uC11E\uC600\uB294\uC9C0 \uBAB0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460359
    m_Localized: "\uB0B4\uB824\uC624\uB294 \uAE38\uC5D0 \uBC1C\uBAA9\uC744 \uC811\uC9C8\uB800\uB2E4. \uC808\uB69D\uC774\uBA70 \uB3CC\uC544\uC624\uB294 \uAE38\uC774 \uB450 \uBC30\uB85C \uAE38\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460358
    m_Localized: "\uADF8 \uC21C\uAC04\uB9CC\uD07C\uC740, \uC544\uBB34\uAC83\uB3C4 \uBB34\uC12D\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460357
    m_Localized: "\uB2A5\uC120\uAE4C\uC9C0 \uC624\uB974\uC790 \uC0B0 \uC804\uCCB4\uAC00 \uBD88\uBD99\uC740 \uAC83\uCC98\uB7FC \uBD89\uC5C8\uB2E4. \uBC24\uACFC \uB3C4\uD1A0\uB9AC\uB97C \uC8FC\uBA38\uB2C8 \uAC00\uB4DD \uC8FC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460356
    m_Localized: "\uB4B7\uC0B0 \uB2E8\uD48D\uAE38\uC744 \uC624\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460355
    m_Localized: "\uAC00\uC7A5 \uBD89\uC740 \uC78E \uD558\uB098\uB97C \uACE8\uB77C \uC77C\uAE30\uC7A5 \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460354
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC5B4 \uC6C3\uC5C8\uB2E4. \uC6C3\uACE0 \uB098\uC11C \uC2A4\uC2A4\uB85C \uB180\uB780 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460353
    m_Localized: "\uB099\uC5FD\uC744 \uC0B0\uCC98\uB7FC \uC313\uC544 \uB193\uACE0 \uADF8 \uC704\uB85C \uB6F0\uC5B4\uB4E4\uC5C8\uB2E4. \uBC14\uC2A4\uB77D \uC18C\uB9AC\uAC00 \uC628\uBAB8\uC744 \uB36E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460352
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uB099\uC5FD\uC744 \uBAA8\uC740\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460351
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB180\uC774\uACF5\uC6D0\uC740 \uBABB \uAC00\uB3C4, \uB2E8\uD48D\uC740 \uACF5\uC9DC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460350
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC870\uAE08 \uC26C\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460349
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC624\uB298 \uC880 \uC274\uAC8C. \uB300\uC2E0 \uB2E8\uD48D \uC0AC\uC9C4\uCC98\uB7FC, \uB208\uC5D0 \uB2F4\uC544 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460348
    m_Localized: "\uD558\uB298\uC774 \uB192\uC558\uB2E4. \uC6D0\uB798 \uAC00\uC744 \uC18C\uD48D\uC740 \uB180\uC774\uACF5\uC6D0\uC774\uC5C8\uB2E4\uACE0 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826532
    m_Localized: "\uBC1C\uC18C\uB9AC\uAC00 \uACC4\uB2E8\uC5D0 \uC6B8\uB838\uB2E4. \uB4A4\uC5D0\uC11C \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706446
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE68\uB057\uD55C \uCC9C\uC73C\uB85C \uD55C \uBC88 \uAC70\uB974\uACE0, \uB053\uC5EC\uC11C \uC2DD\uD600. \uADF8\uB2E4\uC74C\uC5D0 \uB9C8\uC154."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706447
    m_Localized: "{0}: \uADF8\uB0E5 \uBE44\uC778\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706448
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uADF8\uB0E5 \uBE44. \uADFC\uB370 \uC9C0\uAE08\uC740 \uBC30\uD0C8 \uD55C \uBC88\uC774 \uBAA9\uC228\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174807
    m_Localized: "\uC5B8\uC820\uAC00 \uC8FC\uC778\uC744 \uB9CC\uB098\uBA74 \uC804\uD574 \uC8FC\uACE0 \uC2F6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980486
    m_Localized: "\uB9DD \uBCF4\uB294 \uBC95\uC744 \uAC00\uB974\uCCD0 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980487
    m_Localized: "\uC18C\uB9AC \uC2E0\uD638 \uC138 \uAC00\uC9C0. \uC9E7\uAC8C \uB450 \uBC88\uC740 '\uC228\uC5B4', \uAE38\uAC8C \uD55C \uBC88\uC740 '\uAD1C\uCC2E\uC544', \uBC14\uB2E5\uC744 \uC138 \uBC88 \uB450\uB4DC\uB9AC\uBA74 '\uB3CC\uC544\uC640'. \uB3C4\uD604\uC740 \uAE08\uBC29 \uC678\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117868
    m_Localized: "{0}: \uC5EC\uAE30\uB294 \uD559\uAD50\uC608\uC694. \uC6B0\uB9AC\uB294 \uC544\uC9C1 \uC5EC\uAE30 \uC788\uC5B4\uC694. \uBA87 \uBA85\uC774\uC11C, \uC798 \uBC84\uD2F0\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117867
    m_Localized: "\uD559\uAD50 \uC774\uB984\uC744 \uBC1D\uD78C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117866
    m_Localized: "{0}: \u2026\uC544, \uC544. \uB4E4\uB9AC\uC138\uC694? \uC5EC\uAE30\uB294\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117865
    m_Localized: "\uB3C4\uD604\uC774 \uBB38\uAC04\uC5D0 \uC11C\uC11C \uC591\uC190 \uC5C4\uC9C0\uB97C \uB4E4\uC5B4 \uBCF4\uC600\uB2E4. \uC18C\uB9AC\uB294 \uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117864
    m_Localized: "\uBA87 \uB2EC \uB3D9\uC548 \uC6B0\uB9AC\uB294 \uB4E3\uAE30\uB9CC \uD588\uB2E4. \uC624\uB298\uC740 \uCC98\uC74C\uC73C\uB85C \uC774\uCABD\uC5D0\uC11C \uB9D0\uC744 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117863
    m_Localized: "\uBC29\uC1A1\uC2E4 \uC1A1\uCD9C \uBC84\uD2BC \uC704\uC5D0 \uC190\uAC00\uB77D\uC744 \uC62C\uB838\uB2E4. \uBE68\uAC04 \uBD88\uC774 \uB4E4\uC5B4\uC624\uC790 \uC190\uB05D\uC774 \uB5A8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826585
    m_Localized: "{0}: \uC9D1\uC5D0 \uBE68\uB9AC \uAC00\uB294 \uAC83\uB3C4 \uC7AC\uB2A5\uC774\uC57C. \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117861
    m_Localized: "\uC878\uC5C5\uC2DD \uB0A0 \uCC98\uC74C \uBCF4\uB294 \uAC8C \uB9DE\uC744 \uAC83 \uAC19\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uADF8\uB807\uAC8C \uC815\uD588\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117860
    m_Localized: "\uBB38\uC744 \uC18C\uB9AC \uB098\uC9C0 \uC54A\uAC8C \uB2EB\uC558\uB2E4. \uBB38\uD2C8\uC758 \uBE5B\uC774 \uAC00\uB298\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117859
    m_Localized: "\uBABB \uBCF8 \uCC99 \uBB38\uC744 \uC0B4\uC9DD \uB2EB\uC544 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117858
    m_Localized: "\uB098\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uB9AC\uACE0 \uB9C8\uB978 \uC885\uC774\uB4E4\uC744 \uC21C\uC11C\uB300\uB85C \uACB9\uCCD0 \uB193\uB294 \uAC78 \uB3C4\uC654\uB2E4. \uC774\uB984 \uD558\uB098\uD558\uB098\uB97C \uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uACE0 \uC77D\uC73C\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117857
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC6D0\uB798 \uC878\uC5C5\uC2DD \uB0A0 \uCC98\uC74C \uBCF4\uB294 \uAC74\uB370. \u2026\uBE44\uBC00\uB85C \uD574 \uC904\uB798? \uB2E4\uB978 \uC560\uB4E4\uD55C\uD14C\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117856
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uAE5C\uC9DD \uB180\uB77C \uC885\uC774\uB97C \uC5CE\uC73C\uB824\uB2E4, \uADF8\uB9CC\uB450\uC5C8\uB2E4. \uB4E4\uD0A8 \uC0AC\uB78C\uC758 \uC6C3\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806679117855
    m_Localized: "{0}: \uC5B4\uB450\uC6CC\uC694, \uC120\uC0DD\uB2D8. \uC774\uAC70 \uAC00\uAE4C\uC774 \uB450\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654230
    m_Localized: "\uBC24 \uB2F9\uBC88\uC744 \uC11C\uB2E4\uAC00, \uCC3D\uAC00\uC758 \uC120\uBC30\uB97C \uBCF4\uC558\uB2E4. \uB2EC\uBE5B\uC5D0 \uD749\uD130\uAC00 \uD558\uC597\uAC8C \uB4DC\uB7EC\uB098 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826526
    m_Localized: "\uC608\uC9C0\uB294 \uBB3C \uD55C \uBCD1\uACFC \uBE75 \uBA87 \uC870\uAC01\uC744 \uCC59\uACA8 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706422
    m_Localized: "\uD559\uAD50\uB294 \uB5A0\uB0A0 \uB54C \uADF8\uB300\uB85C\uC600\uB2E4. \uADF8\uAC8C \uC774\uB807\uAC8C \uACE0\uB9C8\uC6B8 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706423
    m_Localized: "\uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC870\uAC1C\uAECD\uB370\uAE30 \uD558\uB098\uB97C \uAEBC\uB0B4 \uC120\uC0DD\uB2D8 \uCC45\uC0C1\uC5D0 \uC62C\uB824 \uB450\uC5C8\uB2E4. \uAE30\uB150\uD488\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706424
    m_Localized: "\uC804\uB9DD\uB300\uC5D0\uC11C \uC8FC\uC6B4 \uC791\uC740 \uB3CC \uD558\uB098\uB97C \uC120\uC0DD\uB2D8 \uCC45\uC0C1\uC5D0 \uC62C\uB824 \uB450\uC5C8\uB2E4. \uBC14\uB2E4\uAC00 \uBCF4\uC774\uB358 \uACF3\uC758 \uB3CC\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706425
    m_Localized: "\uC120\uBC30\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uAC8C \uB2E4\uC600\uB2E4. \uADF8\uB798\uB3C4 \uADF8 \uB044\uB355\uC784\uC740, \uC544\uCE68 \uCE60\uD310 \uC55E\uC5D0\uC11C\uBCF4\uB2E4 \uC870\uAE08 \uB290\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654224
    m_Localized: "{0}: \uACE0\uB9C8\uC6CC\uC694, \uC120\uBC30."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654223
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654222
    m_Localized: "\uC120\uBC30\uB294 \uAC00\uBC29\uC744 \uB0B4\uB824\uB193\uACE0 \uB298 \uC549\uB358 \uC790\uB9AC, \uCC3D\uAC00 \uAD6C\uC11D\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4. \uCE6D\uCC2C\uC744 \uAE30\uB2E4\uB9AC\uB294 \uC5BC\uAD74\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711478
    m_Localized: "{0}: (4\uC77C\uC9F8) \uADF8\uB54C \uB124\uAC00 \uB9D0\uD574 \uC900 \uAC70, \uACC4\uC18D \uC0DD\uAC01\uB098. \uB098 \uADF8\uB54C \uC544\uBB34\uAC83\uB3C4 \uBABB \uD588\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711477
    m_Localized: "{0}: (3\uC77C\uC9F8) \uC804\uD654 \uC880 \uBC1B\uC544. \uB108\uD76C \uC9D1 \uCABD\uB3C4 \uB09C\uB9AC\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711476
    m_Localized: "{0}: (2\uC77C\uC9F8) \uD559\uAD50 \uC55E \uC774\uC0C1\uD574. \uACBD\uCC30\uCC28\uAC00 \uB9C9\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711475
    m_Localized: "{0}: (1\uC77C\uC9F8) \uC624\uB298 \uC65C \uBA3C\uC800 \uAC14\uC5B4? \uB0B4\uC77C\uC740 \uB5A1\uBCF6\uC774 \uBB34\uC870\uAC74\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711474
    m_Localized: "{0}: (1\uC77C\uC9F8) \uC5B4\uB514\uC57C? \uB5A1\uBCF6\uC774 \uBA39\uAE30\uB85C \uD588\uC796\uC544. \uAD50\uBB38 \uC55E\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711473
    m_Localized: "\uC804\uC6D0\uC774 \uB4E4\uC5B4\uC654\uB2E4. \uC54C\uB9BC\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uC3DF\uC544\uC84C\uB2E4. \uC804\uBD80 \uAC19\uC740 \uC774\uB984\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654221
    m_Localized: "\uC120\uBC30\uB294 \uB3C4\uD604\uC744 \uC7A0\uAE50 \uBCF4\uB2E4\uAC00, \uC5B4\uAE68\uB97C \uD55C \uBC88 \uC73C\uC4F1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654220
    m_Localized: "\uB3C4\uD604: \uC120\uBC30, \uC9C4\uC9DC \uB300\uBC15\uC774\uB2E4. \uADFC\uB370 \uBB34\uC12D\uC9C0 \uC54A\uC558\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654219
    m_Localized: "\uB354 \uB9CE\uC9C0\uB3C4, \uC801\uC9C0\uB3C4 \uC54A\uC558\uB2E4. \uB9E1\uAE34 \uB9CC\uD07C\uB9CC. \uC815\uD655\uD558\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654218
    m_Localized: "\uC800\uB141\uC5D0 \uC120\uBC30\uAC00 \uB3CC\uC544\uC654\uB2E4. \uAC00\uBC29\uC744 \uC5F4\uC790 \uCE60\uD310\uC5D0 \uC801\uD78C \uADF8\uB300\uB85C \uB098\uC654\uB2E4. \uBD95\uB300 \uB450 \uB864, \uAC74\uC804\uC9C0 \uB124 \uAC1C, \uC131\uB0E5 \uD55C \uAC11, \uC218\uAC74 \uD55C \uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654217
    m_Localized: "\uC120\uBC30\uB294 \uCE60\uD310\uC744 \uD55C \uBC88 \uBCF4\uACE0, \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uBB3B\uC9C0\uB3C4 \uC54A\uACE0, \uD45C\uC815\uB3C4 \uC5C6\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654216
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: 2\uD559\uB144, \uC774\uAC70 \uBD80\uD0C1\uD574\uB3C4 \uB418\uACA0\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654215
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: 2\uD559\uB144, \uC774\uAC70 \uC57D\uAD6D \uCABD\uC5D0\uC11C \uC880 \uAD6C\uD574 \uC62C \uC218 \uC788\uACA0\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654214
    m_Localized: "\uC544\uCE68\uC5D0 \uCE60\uD310\uC5D0 \uD544\uC694\uD55C \uAC83\uB4E4\uC744 \uC801\uC5C8\uB2E4. \uBD95\uB300, \uAC74\uC804\uC9C0, \uC131\uB0E5, \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uBB34\uB98E\uC5D0 \uB308 \uC218\uAC74."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711464
    m_Localized: "\uC5B4\uB514\uC120\uAC00 \uB0C9\uC7A5\uACE0\uAC00 \uC6C5, \uD558\uACE0 \uAE68\uC5B4\uB098\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uD559\uAD50\uAC00 \uC228\uC744 \uD55C \uBC88 \uC270 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563633
    m_Localized: "\uC900: \uC800 \uC0AC\uAC70\uB9AC \uD30C \uB9DE\uC544\uC694. \uADFC\uB370 \uC544\uBB34\uAC83\uB3C4 \uC548 \uD6D4\uCCE4\uC5B4\uC694. \uC9C4\uC9DC\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563634
    m_Localized: "\uBCF4\uAC74\uC2E4\uB85C \uB370\uB824\uAC00 \uC0C1\uCC98\uB97C \uCE58\uB8CC\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711463
    m_Localized: "\uB458\uC740 \uD55C\uCC38 \uADF8 \uBD88\uBE5B \uD558\uB098\uB9CC \uBC14\uB77C\uBCF4\uC558\uB2E4. \uD558\uC597\uACE0, \uC870\uAE08 \uB5A8\uB9AC\uACE0, \uB208\uC774 \uC2DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711462
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uBD88\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711461
    m_Localized: "\uBCF5\uB3C4 \uB05D \uD615\uAD11\uB4F1 \uD558\uB098\uAC00 \uAE5C\uBE61\uC774\uB2E4 \uCF1C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711460
    m_Localized: "\uB808\uBC84\uB97C \uB0B4\uB9AC\uC790 \uBC1C\uC804\uAE30\uAC00 \uAE30\uCE68\uD558\uB4EF \uBA87 \uBC88 \uB5A8\uB354\uB2C8, \uB0AE\uAC8C \uC6B8\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826527
    m_Localized: "\uD558\uB9B0\uC740 \uBE75 \uB450 \uC870\uAC01\uACFC \uBB3C \uD55C \uBCD1\uB9CC \uCC59\uACBC\uB2E4. \uB354 \uAC00\uC838\uAC00\uB77C\uACE0 \uD574\uB3C4 \uAC00\uC838\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706426
    m_Localized: "\uB2E4\uC74C\uC5D4 \uAC19\uC774 \uAC00\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706427
    m_Localized: "{0}: \uB2E4\uC74C\uC5D4 \uC800\uB3C4 \uB370\uB824\uAC00\uC694. \uAE38 \uC880 \uBC30\uC6B0\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706428
    m_Localized: "\uC120\uBC30\uB294 \uD55C\uCC38 \uB098\uB97C \uBCF4\uB2E4\uAC00, \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uBD84\uD544\uB85C \uC791\uC740 \uC9C0\uB3C4\uB97C \uADF8\uB838\uB2E4. \uC57D\uAD6D\uAE4C\uC9C0 \uAC00\uB294 \uAE38. \uB9C9\uD78C \uACE8\uBAA9\uB9C8\uB2E4 \uAC00\uC704\uD45C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706429
    m_Localized: "\uC0C8\uBCBD\uC774 \uB418\uC790 \uC120\uBC30\uAC00 \uB2F4\uC694 \uD55C\uCABD\uC744 \uB0B4 \uBB34\uB98E \uC704\uB85C \uBC00\uC5B4 \uC8FC\uC5C8\uB2E4. \uC2DC\uD0A4\uC9C0 \uC54A\uC740 \uC77C\uC744 \uD558\uB294 \uAC74 \uCC98\uC74C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654208
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uC5B4\uC9C0\uB7EC\uC6E0\uB2E4. \uB204\uAD70\uAC00 \uC654\uB2E4\uAC00, \uB9C9\uD600\uC11C \uB3CC\uC544\uAC04 \uD754\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460410
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544. \uBB3C\uAC74\uC740 \uB610 \uAD6C\uD558\uBA74 \uB3FC. \uB108\uD76C\uAC00 \uB3CC\uC544\uC654\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460409
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uCC3D\uACE0 \uAD6C\uC11D\uC5D0 \uBAB8\uC744 \uC228\uAE30\uACE0 \uC788\uC5C8\uB2E4. \uC6B0\uB9AC\uB97C \uBCF4\uC790 \uADF8\uC81C\uC57C \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460408
    m_Localized: "\uC6B0\uB9AC\uAC00 \uC5C6\uB294 \uB3D9\uC548\uC774\uC5C8\uB2E4. \uB2E4\uB4E4 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uCE5C \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711450
    m_Localized: "\uC77C\uC8FC\uC77C \uB118\uAC8C \uAEBC\uC838 \uC788\uB358 \uD734\uB300\uD3F0\uC774 \uC8FC\uBA38\uB2C8 \uC18D\uC5D0\uC11C \uAC11\uC790\uAE30 \uBB34\uAC81\uAC8C \uB290\uAEF4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711449
    m_Localized: "{0}: \uD734\uB300\uD3F0\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711448
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uCE60 \uC218\uB9CC \uC788\uC73C\uBA74 \uBD88\uC744 \uCF1C\uACE0, \uD734\uB300\uD3F0\uB3C4 \uCDA9\uC804\uD560 \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711447
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCB4\uC721\uB300\uD68C \uB0A0\uC5D4 \uC6B4\uB3D9\uC7A5 \uC2A4\uD53C\uCEE4\uAC00 \uB2E4 \uADF8\uAC78\uB85C \uB3CC\uC544\uAC14\uB300. \uC815\uC804\uC774 \uB098\uB3C4 \uBC29\uC1A1\uC740 \uB098\uAC00\uC57C \uD558\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711446
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC29\uC1A1\uC2E4\uC5D0 \uBE44\uC0C1 \uBC1C\uC804\uAE30\uAC00 \uC788\uC5B4. \uD559\uAD50 \uD589\uC0AC \uB54C \uC4F0\uB358 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460407
    m_Localized: "\uAD50\uBB38 \uC0AC\uC2AC\uC774 \uB04A\uACA8 \uC788\uC5C8\uB2E4. \uCC3D\uACE0 \uBB38\uC9DD\uC774 \uB72F\uACA8 \uC788\uACE0, \uC2DD\uB7C9 \uC0C1\uC790 \uBA87 \uAC1C\uAC00 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460406
    m_Localized: "\uD559\uAD50 \uC9C0\uBD95\uC774 \uBCF4\uC774\uC790 \uC774\uC0C1\uD558\uAC8C \uC228\uC774 \uB193\uC600\uB2E4. \uC9D1\uC5D0 \uC624\uB294 \uAE30\uBD84\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826528
    m_Localized: "\uC120\uBC30\uB294 \uC2DD\uB7C9 \uC870\uAE08\uC744 \uCC59\uACA8 \uB5A0\uB0AC\uB2E4. \uD604\uAD00\uC774 \uC870\uAE08 \uB113\uC5B4 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706430
    m_Localized: "\uACF5\uCC45\uACFC \uC5F0\uD544\uC744 \uAC74\uB128\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706431
    m_Localized: "{0}: \uD558\uACE0 \uC2F6\uC740 \uB9D0 \uC788\uC73C\uBA74, \uC5EC\uAE30 \uC368\uC694. \uC774\uB984\uC774\uB4E0, \uBB50\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706432
    m_Localized: "\uC120\uBC30\uB294 \uACF5\uCC45\uC744 \uC624\uB798 \uB4E4\uACE0 \uC788\uC5C8\uB2E4. \uC5F0\uD544 \uB05D\uC774 \uC885\uC774\uC5D0 \uB2FF\uC558\uB2E4\uAC00, \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706433
    m_Localized: "\uADF8 \uB0A8\uC790\uC5D0\uAC8C \uC120\uBC30\uC5D0 \uB300\uD574 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460400
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: (\uB5A0\uB098\uB358 \uC544\uCE68) \uD559\uAD50 \uAC71\uC815\uC740 \uD558\uC9C0 \uB9C8. \uB108\uD76C\uB098 \uC798 \uC790. \u2026\uC544\uB2C8, \uC798 \uB180\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460399
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC5C6\uB294 \uBC24\uC740 \uCC98\uC74C\uC774\uC5C8\uB2E4. \uB5A0\uB098\uC62C \uB54C \uC120\uC0DD\uB2D8\uC774 \uD55C \uB9D0\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711436
    m_Localized: "\uC870\uC6A9\uD588\uB2E4. \uB108\uBB34 \uC870\uC6A9\uD574\uC11C \uC0C8\uC18C\uB9AC\uAC00 \uD06C\uAC8C \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711435
    m_Localized: "\uCCA0\uB9DD \uAD6C\uBA4D \uB108\uBA38\uB85C \uB9C8\uC744\uC774 \uBCF4\uC600\uB2E4. \uC544\uD30C\uD2B8, \uB0AE\uC740 \uC9C0\uBD95\uB4E4, \uAD50\uD68C \uCCA8\uD0D1, \uADF8 \uB4A4\uB85C \uD750\uB9B0 \uC0B0."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711434
    m_Localized: "\uC625\uC0C1 \uAC00\uC7A5\uC790\uB9AC\uB294 \uB192\uC740 \uCCA0\uB9DD\uC73C\uB85C \uB458\uB7EC\uC838 \uC788\uC5C8\uB2E4. \uB9E8 \uC704\uC5D0\uB294 \uAC00\uC2DC\uCCA0\uC0AC\uAC00 \uAC10\uACA8 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711433
    m_Localized: "\uBB38\uC744 \uBC00\uC790 \uBC14\uB78C\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uB4E4\uC774\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1040249332711432
    m_Localized: "\uAD50\uC2E4\uB3D9 \uB9E8 \uC704 \uACC4\uB2E8\uC740 \uC625\uC0C1 \uCCA0\uBB38\uC5D0\uC11C \uB05D\uB0AC\uB2E4. \uB179\uC2A8 \uBB38\uC740 \uC7A0\uACA8 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460398
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC218\uD559\uC5EC\uD589 \uBC24\uC5D4 \uC6D0\uB798 \uC7A0 \uC548 \uC790\uACE0 \uC774\uC57C\uAE30\uD558\uB294 \uAC70\uC57C. \uC120\uC0DD\uB2D8\uC740 \uBAA8\uB978 \uCC99\uD574 \uC8FC\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460397
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBD88 \uC606\uC5D0 \uBAA9\uBC1C\uC744 \uB215\uD600 \uB450\uACE0 \uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460396
    m_Localized: "\uC804\uB9DD\uB300 \uC544\uB798 \uBC14\uC704 \uADF8\uB298\uC5D0 \uC791\uC740 \uBD88\uC744 \uD53C\uC6E0\uB2E4. \uC800 \uBA40\uB9AC \uBC14\uB2E4 \uCABD \uD558\uB298\uC774 \uC870\uAE08 \uB354 \uC5B4\uB450\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460395
    m_Localized: "\uBAA8\uB798\uC0AC\uC7A5\uC5D0 \uC720\uBAA9\uC744 \uBAA8\uC544 \uC791\uC740 \uBD88\uC744 \uD53C\uC6E0\uB2E4. \uD30C\uB3C4 \uC18C\uB9AC\uAC00 \uBAA8\uB4E0 \uC18C\uB9AC\uB97C \uB36E\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826529
    m_Localized: "\uC0DD\uD65C\uAE30\uB85D\uBD80\uC758 '\uC88B\uC544\uD558\uB294 \uACFC\uBAA9' \uCE78\uC740 \uC544\uC9C1 \uBE44\uC5B4 \uC788\uB2E4. \uB2E4\uC74C\uC5D0 \uC4F8 \uB54C\uB294 \uCC44\uC6B8 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706434
    m_Localized: "{0}: \uC774 \uC0AC\uB78C\u2026 \uC608\uC804\uC5D0 \uC5B4\uB560\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706435
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790: \uC5B4\uB560\uAE34. \uBB34\uC11C\uC6E0\uC9C0. \uADFC\uB370 \uADF8\uB0A0 \uC774\uD6C4\uB85C \uC18C\uC2DD\uC774 \uB04A\uACBC\uB2E4\uB354\uB77C. \uBAA9\uC5D0 \uADF8\uAC70 \uC0DD\uAE30\uACE0 \uB098\uC11C\uB294 \uB9D0\uC744 \uC548 \uD55C\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706436
    m_Localized: "\uC6B0\uBE44 \uB0A8\uC790: \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0\uB294 \uB098\uB3C4 \uBAB0\uB77C. \uC544\uB294 \uB188\uB4E4\uC740 \uB2E4\u2026 \uC774\uC81C \uC5C6\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706437
    m_Localized: "{0}: \uC120\uBC30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757770
    m_Localized: "\uC720\uB791\uC790: \uACE0\uB9D9\uB2E4. \uC774 \uC740\uD61C\uB294\u2026 \uAE30\uC5B5\uD574 \uB450\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757771
    m_Localized: "\uADF8\uB294 \uBAA8\uC790\uB97C \uC0B4\uC9DD \uB4E4\uC5B4 \uBCF4\uC774\uACE0 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174878
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC73C\uB824\uB2E4\uAC00, \uC6C3\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786193
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC54C\uB824 \uC918\uC11C \uACE0\uB9C8\uC6CC. \uC774\uAC74 \uC6B0\uB9AC \uB458\uC774 \uB05D\uAE4C\uC9C0 \uAE30\uC5B5\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806628786194
    m_Localized: "\uD63C\uC790\uB9CC \uAC04\uC9C1\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174922
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uADF8\uAC8C \uB9DE\uC544. \uB108\uB294 \uC790. \uC5EC\uAE30\uB294 \uB0B4 \uC77C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369124
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBBF8\uC548\uD558\uB2E4. \uBAB0\uB790\uB2E4\uB294 \uAC74 \uBCC0\uBA85\uC774 \uC548 \uB3FC. \uC5B4\uB978\uC774 \uBAB0\uB790\uC73C\uBA74 \uC548 \uB418\uB294 \uAC70\uC600\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369123
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4 \uD559\uAD50\uC5D0\uC11C. \uB0B4\uAC00 \uBAA8\uB974\uB294 \uC0AC\uC774\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369122
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uD55C\uB3D9\uC548 \uB9D0\uC744 \uC787\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369121
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB0A0 \uB108\uB97C \uCC3D\uACE0\uC5D0 \uAC00\uB454 \uAC8C\u2026 \uADF8 \uC560\uB4E4\uC774\uC5C8\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369120
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC77D\uC5C8\uC5B4. \uC804\uBD80."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369119
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uC190\uC804\uB4F1 \uBD88\uBE5B \uC544\uB798\uC5D0\uC11C \uC624\uB798 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBB34\uB98E \uC704\uC5D0 \uADF8 \uD30C\uC77C\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369118
    m_Localized: "\uC544\uBB34\uB3C4 \uBAA8\uB974\uAC8C. \uC9C0\uAE08\uC740 \uC544\uBB34\uC5D0\uAC8C\uB3C4 \uBCF4\uC5EC \uC8FC\uACE0 \uC2F6\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369117
    m_Localized: "\uD30C\uC77C\uC744 \uBAB0\uB798 \uAC00\uBC29 \uAE4A\uC219\uC774 \uB123\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591980
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uB370\uB824\uAC00. \uC26C\uC5C4\uC26C\uC5C4 \uC62C\uB77C\uAC00\uBA74 \uB418\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591979
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC70\uAE30\uB77C\uBA74 \uBE44\uB3C4 \uBC1B\uC744 \uC218 \uC788\uACE0, \uBA40\uB9AC\uB3C4 \uBCFC \uC218 \uC788\uACA0\uB2E4. \uC6B0\uB9AC \uC625\uC0C1\uC73C\uB85C \uC4F0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591978
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F0\uAE30\uAC00 \uB09C\uB2E4\uB294 \uAC74, \uB204\uAC00 \uBD88\uC744 \uD53C\uC6E0\uB2E4\uB294 \uAC70\uC57C. \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563539
    m_Localized: "\uB3C4\uD604: \u2026\uCCB4\uC721\uACF5\uC6D0\uC5D0\uC11C \uC628 \uC0AC\uB78C\uB4E4 \uC911\uC5D0, \uD639\uC2DC\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563540
    m_Localized: "DJ: \uC774\uB984 \uBD88\uB7EC \uC918\uC694. \uBA85\uB2E8 \uC788\uC5B4\uC694. \uCC3E\uC544\uBCFC\uAC8C\uC694. \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563541
    m_Localized: "\uBB3C\uC790\uB97C \uC8FC\uACE0\uBC1B\uB294 \uC774\uC57C\uAE30\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563542
    m_Localized: "{0}: \uC57D\uC774 \uC81C\uC77C \uD544\uC694\uD574\uC694. \uB300\uC2E0 \uC6B0\uB9AC\uB294 \uBD80\uD488\uC774\uB791 \uC5F0\uB8CC\uB97C \uC870\uAE08 \uAD6C\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563543
    m_Localized: "DJ: \uC88B\uC544\uC694. \uC6B4\uBC18\uC870\uD55C\uD14C \uD559\uAD50 \uC55E\uC744 \uCF54\uC2A4\uC5D0 \uB123\uC73C\uB77C\uACE0 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563544
    m_Localized: "\uC548\uD14C\uB098 \uBD80\uD488\uC744 \uBA3C\uC800 \uBCF4\uB0B4 \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591977
    m_Localized: "{0}: \uAC70\uAE34 \uC544\uBB34\uB3C4 \uC5C6\uC5B4\uC694. \uBC14\uB78C\uC774\uB791, \uC5F0\uAE30 \uD55C \uC904\uAE30\uB9CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591976
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC625\uC0C1\uAE4C\uC9C0 \uAC14\uB2E4 \uC654\uC5B4? \uC704\uD5D8\uD558\uC9C4 \uC54A\uC558\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174935
    m_Localized: "\uD6A8\uC728\uC801\uC778 \uADDC\uCE59\uC774\uC5C8\uB2E4. \uADF8\uB0A0 \uBC24 \uB204\uAD70\uAC00 \uD63C\uC790 \uB2A6\uAC8C\uAE4C\uC9C0 \uC77C\uD558\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uBC30\uAC00 \uACE0\uD30C\uC11C\uC600\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591975
    m_Localized: "\uB3CC\uC544\uC624\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591974
    m_Localized: "\uC5EC\uAE30\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4. \uBC1C\uC18C\uB9AC\uB3C4, \uC2E0\uC74C\uB3C4. \uBC14\uB78C\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591973
    m_Localized: "\uBA40\uB9AC \uC5F0\uAE30 \uD55C \uC904\uAE30\uAC00 \uC62C\uB77C\uAC00\uACE0 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uC544\uC9C1 \uC800\uAE30 \uC788\uB2E4\uB294 \uB73B\uC77C\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591972
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B8\uC820\uAC00 \uB098\uB3C4 \uAC70\uAE30\uC11C \uD558\uB298 \uD55C\uBC88 \uBCF4\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591971
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F4\uC5EC\uC12F \uCE78\uC774\uB77C\uACE0? \uC26C\uC5C4\uC26C\uC5C4 \uAC00\uBA74 \uB418\uACA0\uB2E4. \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uB370\uB824\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563455
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uB4F1\uD559\uAD50 \uB54C \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uAE00\uC744 \uC77D\uACE0 \uADF8\uB7AC\uC5B4. \uB108\uB294 \uB0A8\uC758 \uB9D0\uC744 \uC798 \uB4E3\uB294 \uAE00\uC744 \uC4F4\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563545
    m_Localized: "{0}: \uBC29\uC1A1 \uC7A1\uC74C\uC774 \uC2EC\uD558\uB358\uB370\uC694. \uBD80\uD488 \uBA87 \uAC1C \uBCF4\uB0BC\uAC8C\uC694. \uADF8\uB0E5\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563546
    m_Localized: "DJ: \u2026\uADF8\uB0E5\uC774\uB77C\uB294 \uB9D0, \uC624\uB79C\uB9CC\uC5D0 \uB4E4\uC5B4 \uBCF4\uB124\uC694. \uACE0\uB9C8\uC6CC\uC694. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563547
    m_Localized: "\uADF8\uB0E5 \uC774\uC57C\uAE30\uB97C \uB098\uB208\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563548
    m_Localized: "\uD544\uC694\uD55C \uAC83 \uC774\uC57C\uAE30\uB294 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uC88B\uC544\uD558\uB294 \uB178\uB798, \uD559\uAD50 \uB9E4\uC810\uC758 \uBE75 \uC774\uC57C\uAE30\uB97C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563549
    m_Localized: "DJ: \uADF8 \uBE75, \uC800\uB3C4 \uC54C\uC544\uC694. \uC18C\uBCF4\uB85C \uB9DE\uC8E0? \uD559\uAD50 \uB2E4\uB2D0 \uB54C \uC800\uB3C4 \uADF8\uAC70 \uBA39\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563550
    m_Localized: "DJ: \uD559\uAD50 \uCE5C\uAD6C\uB4E4, \uBBF8\uC548\uD574\uC694. \uBD80\uD0C1\uD560 \uAC8C \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563551
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uB5A8\uB838\uB2E4. \uBC29\uC1A1 \uB54C\uB294 \uD55C \uBC88\uB3C4 \uB5A8\uB9B0 \uC801 \uC5C6\uB294 \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591970
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F0\uAE30\uAC00 \uB09C\uB2E4\uB294 \uAC74, \uB204\uAC00 \uBD88\uC744 \uD53C\uC6E0\uB2E4\uB294 \uAC70\uC57C. \uBC25\uC744 \uD558\uB4E0 \uBAB8\uC744 \uB179\uC774\uB4E0. \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591969
    m_Localized: "\uBC14\uB78C, \uC0C8\uC18C\uB9AC, \uC5F0\uAE30 \uD55C \uC904\uAE30. \uB9D0\uD558\uB294 \uB3D9\uC548 \uC120\uC0DD\uB2D8\uC740 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591968
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5B4\uB560\uC5B4? \uD558\uB098\uB3C4 \uBE7C\uB193\uC9C0 \uB9D0\uACE0 \uB9D0\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591967
    m_Localized: "\uB3CC\uC544\uC624\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591966
    m_Localized: "\uC5EC\uAE30\uC11C\uB294, \uC7A0\uAE50\uC774\uC9C0\uB9CC, \uC228\uC744 \uAE4A\uAC8C \uC274 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591965
    m_Localized: "\uC625\uC0C1 \uBC14\uB2E5\uC740 \uB113\uACE0 \uD3C9\uD3C9\uD588\uB2E4. \uBB34\uC5C7\uC774\uB4E0 \uB0B4\uB824\uC549\uC744 \uC218 \uC788\uC744 \uB9CC\uD07C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591964
    m_Localized: "\uBA40\uB9AC \uC5F0\uAE30 \uD55C \uC904\uAE30\uAC00 \uC62C\uB77C\uAC00\uACE0 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uC544\uC9C1 \uC800\uAE30 \uC788\uB2E4\uB294 \uB73B\uC77C\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591963
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uB798 \uCE78\uC740 \uB0B4\uAC00 \uBA3C\uC800 \uB2E4\uB140\uAC14\uC5B4. \uC190\uC774 \uAC70\uAE30\uAE4C\uC9C0\uBC16\uC5D0 \uC548 \uB2FF\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591962
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uBCF4\uAC74\uC2E4 \uC774\uC57C\uAE30\uB97C \uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC7A0\uAE50 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563552
    m_Localized: "DJ: \uC6B4\uBC18\uC870 \uBBFC\uADDC\uAC00 \uC5B4\uC81C \uAC15\uBCC0 \uCABD\uC73C\uB85C \uB098\uAC00\uC11C \uC548 \uB3CC\uC544\uC654\uC5B4\uC694. \uC5F4\uC544\uD649 \uC0B4\uC774\uC5D0\uC694. \uB9C8\uC9C0\uB9C9 \uBB34\uC804\uC774 \uD559\uAD50 \uADFC\uCC98\uC600\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563553
    m_Localized: "DJ: \uC6B0\uB9AC \uCABD\uC5D0\uC11C \uAC70\uAE30\uAE4C\uC9C0\uB294 \uB108\uBB34 \uBA40\uC5B4\uC694. \uD639\uC2DC\u2026 \uD639\uC2DC \uAC00\uAE4C\uC774 \uC788\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563554
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC5BC\uAD74\uC744 \uBCF4\uC558\uB2E4. \uC774\uBC88\uC5D0\uB294 \uB9D0\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB807\uB2E4\uACE0 \uAC00\uB77C\uACE0 \uD558\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591961
    m_Localized: "\uCABD\uC9C0\uC5D0\uAC8C \uC18D\uC73C\uB85C \uBBF8\uC548\uD558\uB2E4\uACE0 \uD588\uB2E4. \uC9C0\uAE08\uC740 \uC120\uC0DD\uB2D8 \uB2E4\uB9AC\uC5D0 \uAC10\uC744 \uBD95\uB300\uAC00 \uBA3C\uC800\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174934
    m_Localized: "{0}: \uC77C\uD55C \uB9CC\uD07C \uBA39\uC5B4\uC694. \uADF8\uAC8C \uACF5\uD3C9\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591960
    m_Localized: "\uBD95\uB300\uC640 \uC18C\uB3C5\uC57D\uC744 \uAC00\uBC29\uC5D0 \uB123\uC5C8\uB2E4. \uD30C\uC77C\uC740 \uADF8\uB300\uB85C \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591959
    m_Localized: "\uC57D\uD488\uB9CC \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591958
    m_Localized: "\uD30C\uC77C\uC740 \uAC00\uBC29 \uB9E8 \uC548\uCABD\uC5D0 \uB123\uC5C8\uB2E4. \uBD95\uB300\uC640 \uC18C\uB3C5\uC57D\uC740 \uCABD\uC9C0 \uB9D0\uB300\uB85C, \uC870\uAE08\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591957
    m_Localized: "\uC65C \uC774\uAC78 \uAE30\uC5B5\uD574 \uB450\uACE0 \uC2F6\uC740\uC9C0\uB294 \uC2A4\uC2A4\uB85C\uB3C4 \uC798 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591956
    m_Localized: "\uD30C\uC77C\uC744 \uB118\uAE30\uB2E4 '\uC724' \uC131\uC758 \uC774\uB984 \uC55E\uC5D0\uC11C \uC190\uC774 \uBA48\uCDC4\uB2E4. \uD608\uC561\uD615 \uCE78\uC774 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591955
    m_Localized: "\uD30C\uC77C\uC744 \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563454
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC65C \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC774 \uB410\uB0D0\uACE0? \uADF8\uAC70 \uBA74\uC811 \uB54C \uC9C8\uBB38\uC774\uB791 \uB611\uAC19\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563555
    m_Localized: "\uB0A0\uC774 \uBC1D\uAE30 \uC804\uC5D0 \uAC15\uBCC0 \uCABD\uC744 \uCC3E\uC544\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563453
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC73C\uBA70 \uCD9C\uC11D\uBD80\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uB098\uBA38\uC9C0 \uC774\uB984\uC740 \uC18C\uB9AC \uB0B4\uC5B4 \uBD80\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591954
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uB3CC\uC544\uC624\uB294 \uAE38\uC744 \uBA3C\uC800 \uBD10 \uB46C. \uB4E4\uC5B4\uAC00\uB294 \uAE38\uBCF4\uB2E4 \uB098\uC624\uB294 \uAE38\uC774 \uC911\uC694\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591953
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCC3D\uACE0 \uCABD\uC5D0\uB294 \uC0C1\uC790\uAC00 \uB9CE\uC744 \uAC70\uACE0, \uC0AC\uBB34\uC2E4\uC740 \uC7A0\uACA8 \uC788\uC744 \uC218\uB3C4 \uC788\uC5B4. \uBB34\uB9AC\uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591952
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uAD50 \uBC16\uC774\uAD6C\uB098. \uAC70\uB9AC\uAC00 \uC9E7\uC73C\uB2C8 \uD574 \uC9C0\uAE30 \uC804\uC5D0 \uB2E4\uB140\uC62C \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591951
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uB9D0\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591950
    m_Localized: "\uD559\uAD50 \uBC16\uC740 \uCC98\uC74C\uC774\uC5C8\uB2E4. \uADF8 \uAE38\uC744 \uAC74\uB108\uB294 \uC0C1\uC0C1\uB9CC\uC73C\uB85C \uC190\uBC14\uB2E5\uC5D0 \uB540\uC774 \uCC3C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174933
    m_Localized: "\uBC16\uC5D0 \uB098\uAC00\uACE0 \uC77C\uD558\uB294 \uC0AC\uB78C\uC774 \uBA3C\uC800 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591949
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0\uB294 \uBB38\uC774 \uC5F4\uB9B0 \uCC44 \uC11C \uC788\uB294 \uCC28 \uD55C \uB300. \uADF8 \uC606\uC5D0 \uB5A8\uC5B4\uC9C4 \uC2E0\uBC1C \uD55C \uC9DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563452
    m_Localized: "\uC791\uAC8C \uC190\uB9CC \uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563556
    m_Localized: "\uB451 \uC544\uB798 \uBC30\uC218\uB85C \uC548\uC5D0\uC11C \uC790\uC804\uAC70 \uBC14\uD034\uAC00 \uBCF4\uC600\uB2E4. \uADF8 \uC606\uC5D0 \uB2E4\uB9AC\uB97C \uB2E4\uCE5C \uB0A8\uC790\uC560\uAC00 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563557
    m_Localized: "\uBBFC\uADDC: \u2026UBC \uC0AC\uB78C\uC774\uC5D0\uC694? \uC544\uB2C8, \uD559\uAD50? \uD559\uAD50\uC5D0\uC11C \uC654\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563558
    m_Localized: "\uBBFC\uADDC\uB97C \uBD80\uCD95\uD574 \uD559\uAD50\uB85C \uB370\uB824\uC654\uB2E4. \uBB34\uC804 \uB108\uBA38\uC5D0\uC11C DJ\uAC00 \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563559
    m_Localized: "DJ: \uACE0\uB9C8\uC6CC\uC694. \uC774 \uBE5A\uC740\u2026 \uC774 \uBE5A\uC740 \uAF2D \uAC1A\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563560
    m_Localized: "\uAC15\uBCC0\uC740 \uB113\uACE0 \uC5B4\uB450\uC6E0\uB2E4. \uADF8\uAC83\uB4E4\uC758 \uC18C\uB9AC\uAC00 \uAC00\uAE4C\uC6CC\uC838 \uB3CC\uC544\uC11C\uC57C \uD588\uB2E4. \uB118\uC5B4\uC9C0\uBA70 \uD314\uC744 \uAE4A\uAC8C \uAE01\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563451
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC1C\uADFC\uC774\uB124. \uB300\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563450
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uD145 \uBE48 \uBCF5\uB3C4\uAE4C\uC9C0 \uC6B8\uB838\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uCD9C\uC11D\uBD80\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563449
    m_Localized: "{0}: \uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563448
    m_Localized: "\uD06C\uAC8C \uB300\uB2F5\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563447
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD9C\uC11D \uBD80\uB974\uACA0\uB2E4. {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563446
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uAD50\uC2E4 \uC55E\uC5D0 \uC11C\uC11C \uCD9C\uC11D\uBD80\uB97C \uD3BC\uCCE4\uB2E4. \uC9C4\uC9DC \uCD9C\uC11D\uBD80\uC600\uB2E4. \uAD50\uBB34\uC2E4\uC5D0\uC11C \uAC00\uC838\uC628."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563445
    m_Localized: "\uC624\uB298\uC740 2\uD559\uAE30 \uAC1C\uD559 \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563444
    m_Localized: "\uAFC8\uC5D0\uC11C \uBD88\uAF43\uB180\uC774\uB97C \uBD24\uB2E4. \uC606\uC5D0 \uB204\uAC00 \uC788\uC5C8\uB294\uC9C0\uB294 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563443
    m_Localized: "\uC77C\uCC0D \uC794\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563442
    m_Localized: "\uB2E4 \uAC19\uC774 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563441
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAC8C \uBC31\uC870\uC790\uB9AC\uB2E4. \uC544\uB2C8, \uC544\uB2D0 \uC218\uB3C4 \uC788\uB2E4. \uAD6D\uC5B4 \uC120\uC0DD\uC774\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563440
    m_Localized: "\uBD88\uAF43\uC740 \uC5C6\uC5C8\uB2E4. \uB300\uC2E0 \uBCC4\uC774 \uB9CE\uC558\uB2E4. \uB3C4\uC2DC\uC5D0 \uBD88\uC774 \uAEBC\uC9C0\uB2C8 \uBCC4\uC774 \uC774\uB807\uAC8C \uB9CE\uC558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563439
    m_Localized: "\uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00 \uAC15 \uCABD \uD558\uB298\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563438
    m_Localized: "\uC624\uB298\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563437
    m_Localized: "\uB3C4\uC11C\uAD00\uC5D0\uC11C \uAC00\uC838\uC628 \uC2E0\uBB38 \uC0AC\uC774\uC5D0 \uC804\uB2E8\uC9C0\uAC00 \uB07C\uC5B4 \uC788\uC5C8\uB2E4. \uC0C8\uBCBD\uC2DC \uC5EC\uB984 \uCD95\uC81C, 7\uC6D4 28\uC77C, \uAC15\uBCC0 \uBD88\uAF43\uB180\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563436
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uADF8 \uC544\uB798\uC5D0 \uC791\uAC8C \uB367\uBD99\uC600\uB2E4. '\uC120\uC0DD\uB2D8\uB3C4 \uAC19\uC774.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563561
    m_Localized: "\uBBFC\uADDC\uB294 \uCC3E\uC9C0 \uBABB\uD588\uB2E4. \uBB34\uC804\uAE30\uC5D0 \uB300\uACE0 \uADF8 \uB9D0\uC744 \uD558\uB294 \uAC8C \uAC15\uBCC0\uBCF4\uB2E4 \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563435
    m_Localized: "\uB3D9\uADF8\uB77C\uBBF8 \uC2DC\uAC04\uD45C\uB97C \uADF8\uB838\uB2E4. \uACF5\uBD80, \uD0D0\uD5D8, \uD734\uC2DD, \uADF8\uB9AC\uACE0 \uB9E8 \uC544\uB798 '\uC625\uC0C1\uC5D0\uC11C \uBCC4 \uBCF4\uAE30'."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563434
    m_Localized: "\uBC29\uD559 \uACC4\uD68D\uD45C\uB97C \uC9E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563433
    m_Localized: "\uAE68\uC5B4 \uBCF4\uB2C8 \uB204\uAC00 \uBC30 \uC704\uC5D0 \uC218\uAC74\uC744 \uB36E\uC5B4 \uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563432
    m_Localized: "\uC624\uB79C\uB9CC\uC5D0 \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB9E4\uBBF8 \uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA70 \uB0AE\uC7A0\uC744 \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563431
    m_Localized: "\uD558\uB8E8 \uC885\uC77C \uD479 \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563430
    m_Localized: "\uB3C4\uD604: \u2026\uADFC\uB370 \uC0DD\uAC01\uBCF4\uB2E4 \uB098\uC058\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563429
    m_Localized: "\uB3C4\uD604: \uBC29\uD559\uC778\uB370 \uD559\uAD50\uC5D0 \uC788\uB294 \uAC74 \uCC98\uC74C\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563428
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544, \uD558\uB098 \uB354. \uAC1C\uD559 \uB0A0 \uB2E4 \uAC19\uC774 \uC5EC\uAE30 \uC788\uAE30. \uC774\uAC8C \uC81C\uC77C \uC911\uC694\uD55C \uC219\uC81C\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563427
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984\uBC29\uD559\uC774\uB2E4. \uC219\uC81C\uB294\u2026 \uC0B4\uC544\uB0A8\uAE30. \uADF8\uB9AC\uACE0 \uC77C\uAE30 \uC4F0\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563426
    m_Localized: "\uAD50\uC7A5 \uC120\uC0DD\uB2D8 \uD6C8\uD654 \uB300\uC2E0 \uC120\uC0DD\uB2D8\uC774 \uC9E7\uAC8C \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563425
    m_Localized: "\uC6D0\uB798\uB77C\uBA74 \uAC15\uB2F9\uC5D0 \uC904\uC9C0\uC5B4 \uC549\uC544 \uC878\uBA74\uC11C \uD6C8\uD654\uB97C \uB4E4\uC5C8\uC744 \uAC83\uC774\uB2E4. \uC131\uC801\uD45C\uB97C \uBC1B\uACE0, \uB204\uAD6C\uB791 \uBC14\uB2E4\uC5D0 \uAC08\uC9C0 \uC815\uD588\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563424
    m_Localized: "\uC624\uB298\uC740 \uC6D0\uB798 \uBC29\uD559\uC2DD \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563423
    m_Localized: "\uC2DC\uD5D8\uC9C0\uB294 \uCE60\uD310 \uC606\uC5D0 \uBD99\uC5B4 \uC788\uC5C8\uB2E4. \uBA70\uCE60 \uB4A4 \uBCF4\uB2C8 \uBE48\uCE78\uC774 \uBA87 \uAC1C \uCC44\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uB204\uAD6C \uAE00\uC528\uC778\uC9C0\uB294 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563422
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798, \uC2DC\uD5D8\uC740 \uB3C4\uB9DD \uC548 \uAC04\uB2E4. \uC2DC\uD5D8\uC9C0\uAC00 \uBA3C\uC800 \uB3C4\uB9DD\uAC00\uACA0\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563421
    m_Localized: "\uC624\uB298\uC740 \uC26C\uACE0 \uC2F6\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563420
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC74 \uC791\uAC00\uB3C4 \uBAB0\uB77C. \uADF8\uB798\uB3C4 \uC624\uB2F5 \uB178\uD2B8\uB294 \uB0B4\uC77C\uAE4C\uC9C0. \uB18D\uB2F4 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563562
    m_Localized: "DJ: \u2026\uAC00 \uC918\uC11C \uACE0\uB9C8\uC6CC\uC694. \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574\uC694. \uC815\uB9D0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563563
    m_Localized: "\uC9C0\uB3C4\uB97C \uD3BC\uCCD0 \uB193\uACE0 \uBB34\uC804\uC73C\uB85C \uAC15\uBCC0 \uAE38\uC744 \uC54C\uB824 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563419
    m_Localized: "\uD2C0\uB9B0 \uB450 \uBB38\uC81C\uB294 \uB458 \uB2E4 '\uC791\uAC00\uC758 \uC758\uB3C4'\uB97C \uBB3B\uB294 \uBB38\uC81C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563418
    m_Localized: "10\uBB38\uC81C \uC911 8\uAC1C\uB97C \uB9DE\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBE68\uAC04 \uD39C\uC73C\uB85C \uB3D9\uADF8\uB77C\uBBF8\uB97C \uD06C\uAC8C \uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563417
    m_Localized: "\uC2DC\uD5D8\uC744 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563416
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC10\uB3C5\uC740 \uCCA0\uC800\uD788 \uD55C\uB2E4. \uC549\uC544\uC11C \uD558\uB294 \uC77C\uC774\uB2C8\uAE4C \uC790\uC2E0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563415
    m_Localized: "{0}: \uCEE8\uB2DD\uD558\uBA74\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591948
    m_Localized: "\uAE38 \uAC74\uB108 \uD3B8\uC758\uC810 \uAC04\uD310. \uBD88\uC740 \uAEBC\uC84C\uC9C0\uB9CC \uC720\uB9AC\uBB38\uC740 \uBA40\uCA61\uD574 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591947
    m_Localized: "4\uCE35 \uBCF5\uB3C4 \uCC3D\uC73C\uB85C \uAD50\uBB38 \uBC16\uC774 \uB0B4\uB824\uB2E4\uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591946
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBB34\uC11C\uC6B4 \uAC8C \uB9DE\uC544. \uBB34\uC12D\uB2E4\uACE0 \uB9D0\uD560 \uC904 \uC544\uB294 \uC0AC\uB78C\uC774 \uC624\uB798 \uBC84\uD168."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563414
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9113 \uBC94\uC704\uB85C \uB530\uB85C \uB0C8\uC5B4. \uAC71\uC815 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563564
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uADF8\uB9B0 \uC9C0\uB3C4\uB97C \uD3BC\uCCE4\uB2E4. \uBC30\uC218\uB85C, \uB9C9\uD78C \uACE8\uBAA9, \uC228\uC744 \uACF3\uC744 \uD558\uB098\uC529 \uBD88\uB7EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563565
    m_Localized: "\uC6B0\uB9AC\uAC00 \uB2E4\uB140 \uBCF8 \uAE38\uC744 \uB5A0\uC62C\uB9AC\uBA70 \uBC30\uC218\uB85C, \uB9C9\uD78C \uACE8\uBAA9, \uC228\uC744 \uACF3\uC744 \uD558\uB098\uC529 \uBD88\uB7EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563566
    m_Localized: "\uC0C8\uBCBD \uBB34\uB835, DJ\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uB2E4. \uBBFC\uADDC\uAC00 \uC9C0\uB3C4 \uAE38\uC744 \uB530\uB77C \uAE30\uC5B4\uC11C \uB3CC\uC544\uC654\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563567
    m_Localized: "\uC704\uD5D8\uD574\uC11C \uAC08 \uC218 \uC5C6\uB2E4\uACE0 \uC194\uC9C1\uD558\uAC8C \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563568
    m_Localized: "{0}: \uBBF8\uC548\uD574\uC694. \uC5EC\uAE30 \uC0AC\uB78C\uB4E4\uC744 \uB450\uACE0 \uB098\uAC08 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563569
    m_Localized: "DJ: \uC54C\uC544\uC694. \uB9DE\uB294 \uB9D0\uC774\uC5D0\uC694. \u2026\uADF8\uB798\uB3C4 \uB4E3\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uB9D0\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563570
    m_Localized: "\uADF8\uB0A0 \uBC24 \uBC29\uC1A1\uC740 \uB178\uB798 \uC5C6\uC774 \uB05D\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563571
    m_Localized: "\uBC24\uB2A6\uAC8C \uBB34\uC804\uAE30\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC8FC\uBCC0\uC744 \uC0B4\uD53C\uB294 \uB4EF \uBAA9\uC18C\uB9AC\uB97C \uB0AE\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563572
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD, \uB098\uC57C. \uC9E7\uAC8C \uB9D0\uD560\uAC8C. \uC6B0\uB9AC \uC548\uC5D0 \uBB38\uC81C\uAC00 \uC880 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563413
    m_Localized: "\uB3C4\uD604: \uC800\uB3C4\uC694? \uC800 \uC911\uD559\uC0DD\uC778\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563412
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBCF4\uAC74\uC740 \uB0B4\uAC00 \uB0BC\uAC8C. \uC804\uBD80 \uC11C\uC220\uD615\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563411
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2DC\uD5D8 \uBCFC\uB798? \uB0B4\uAC00 \uC9C1\uC811 \uCD9C\uC81C\uD588\uB2E4. \uAD6D\uC5B4 10\uBB38\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563410
    m_Localized: "\uAD50\uC2E4 \uC55E\uBB38\uC5D0 '\uC2DC\uD5D8 \uC911 \u2014 \uCD9C\uC785 \uAE08\uC9C0'\uB77C\uACE0 \uC4F4 \uC885\uC774\uB97C \uBD99\uC774\uB294 \uAC74 \uC120\uC0DD\uB2D8\uC758 \uACE0\uC9D1\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563409
    m_Localized: "\uB2EC\uB825\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uCCD0\uC9C4 \uB0A0. \uC6D0\uB798\uB77C\uBA74 \uAE30\uB9D0\uACE0\uC0AC \uCCAB\uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563408
    m_Localized: "\uB044\uAE30 \uC9C1\uC804, \uB178\uB7AB\uC18C\uB9AC\uAC00 \uC544\uC8FC \uC7A0\uAE50 \uB2E4\uC2DC \uB4E4\uB9B0 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563407
    m_Localized: "\uC804\uB825\uC744 \uC544\uB07C\uB824\uACE0 \uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563406
    m_Localized: "\uB204\uAD70\uAC00 \uC800 \uBC16\uC5D0\uC11C \uC74C\uC545\uC744 \uD2C0\uACE0 \uC788\uB2E4. \uADF8 \uC0AC\uC2E4\uB9CC\uC73C\uB85C \uC774\uC0C1\uD558\uAC8C \uB9C8\uC74C\uC774 \uB193\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563405
    m_Localized: "\uD55C \uC2DC\uAC04 \uB3D9\uC548 \uB2E4\uC774\uC5BC\uC744 \uB3CC\uB838\uC9C0\uB9CC \uB2E4\uC2DC \uC7A1\uD788\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uC8FC\uD30C\uC218 \uC22B\uC790\uB97C \uCE60\uD310\uC5D0 \uC801\uC5B4 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174936
    m_Localized: "\uB0B4 \uBAAB\uC744 \uC904\uC5EC\uC11C \uB098\uB220 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563573
    m_Localized: "\uC815 \uBC18\uC7A5: \uBD80\uBC18\uC7A5 \uC624 \uC528 \uC54C\uC9C0? \uC57D \uC5C6\uC73C\uBA74 \uACA8\uC6B8 \uBABB \uB09C\uB2E4\uACE0, \uD559\uAD50\uB97C \uD138\uC790\uB294 \uB9D0\uC744 \uD558\uACE0 \uB2E4\uB140. \uB530\uB974\uB294 \uC0AC\uB78C\uC774 \uB137\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563574
    m_Localized: "\uC815 \uBC18\uC7A5: \uB0B4\uAC00 \uB9C9\uACE0\uB294 \uC788\uB294\uB370\u2026 \uD639\uC2DC \uBAA8\uB974\uB2C8 \uBB38\uB2E8\uC18D \uC798\uD574. \uC774 \uB9D0 \uD558\uB294 \uAC83\uB3C4 \uC6B0\uB9AC \uCABD\uC5D4 \uBC30\uC2E0\uC774\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563575
    m_Localized: "\uACE0\uB9D9\uB2E4\uACE0 \uD558\uACE0 \uBC29\uC5B4\uB97C \uB2E8\uB2E8\uD788 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563576
    m_Localized: "\uADF8\uB0A0 \uBC24 \uAD50\uBB38\uACFC \uCC3D\uACE0 \uBB38\uC5D0 \uBE57\uC7A5\uC744 \uD558\uB098\uC529 \uB354 \uAC78\uC5C8\uB2E4. \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uACC4\uC18D \uADC0\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563577
    m_Localized: "\uC758\uC57D\uD488\uC744 \uC870\uAE08 \uBCF4\uB0B4 \uAC08\uB4F1\uC744 \uB204\uADF8\uB7EC\uB728\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563578
    m_Localized: "{0}: \uC57D \uC870\uAE08 \uBCF4\uB0BC\uAC8C\uC694. \uC624 \uC528\uAC00 \uBB34\uC11C\uC6CC\uD558\uB294 \uAC74 \uC57D\uC774 \uC5C6\uB294 \uACA8\uC6B8\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563579
    m_Localized: "\uC815 \uBC18\uC7A5: \u2026\uD559\uC0DD\uC774 \uC5B4\uB978\uBCF4\uB2E4 \uB0AB\uB124. \uADF8\uAC70\uBA74 \uD55C\uB3D9\uC548 \uC870\uC6A9\uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563580
    m_Localized: "\uB9C8\uD2B8 \uC77C\uC5D0\uB294 \uB07C\uC9C0 \uC54A\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563581
    m_Localized: "{0}: \uADF8\uAC74 \uB9C8\uD2B8 \uC548\uC758 \uC77C\uC774\uC5D0\uC694. \uC6B0\uB9AC \uC77C\uC740 \uC6B0\uB9AC\uAC00 \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563582
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB798. \uADF8\uAC8C \uB9DE\uC744 \uC218\uB3C4 \uC788\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563583
    m_Localized: "\uC544\uCE68, \uB9C8\uD2B8 \uCABD \uD558\uB298\uC5D0 \uAC80\uC740 \uC5F0\uAE30\uAC00 \uC62C\uB790\uB2E4. \uBB34\uC804\uAE30\uAC00 \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563404
    m_Localized: "\uC8FC\uD30C\uC218\uB97C \uC870\uAE08\uC529 \uB3CC\uB824 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563403
    m_Localized: "\uC18C\uB9AC\uAC00 \uB04A\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563402
    m_Localized: "???: \u2026\uC5EC\uAE30\uB294 \uC720, \uBE44, \uC528\u2026 \uB4E3\uB294 \uC0AC\uB78C \uC788\uC73C\uBA74\u2026 \uB0B4\uC77C\uB3C4 \uC774 \uC2DC\uAC04\uC5D0\u2026 \uC2E0\uCCAD\uACE1\uC740\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563401
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C \uC74C\uC545\uC774 \uBA87 \uB9C8\uB514. \uADF8\uB9AC\uACE0 \uB204\uAD70\uAC00\uC758 \uC6C3\uC74C\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563400
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB34\uC804\uAE30\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uC0AC\uB78C \uBAA9\uC18C\uB9AC \uBE44\uC2B7\uD55C \uAC83\uC774 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563399
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uC5B4\uAE68\uB97C \uB450\uB4DC\uB824 \uC8FC\uC5C8\uB2E4. \uB3C4\uD604\uC774 \uCABD\uC9C0\uB97C \uC811\uC5B4 \uAC00\uC2B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563398
    m_Localized: "\uB3C4\uD604: \u2026\uC0B4\uC544 \uC788\uC744 \uC218\uB3C4 \uC788\uACA0\uC8E0? \uB300\uD53C\uC18C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591945
    m_Localized: "\uC194\uC9C1\uD788 \uBB34\uC11C\uC6CC\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563397
    m_Localized: "\uB3C4\uD604\uC740 \uCABD\uC9C0\uB97C \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4. \uC6B8\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC785\uC220\uC744 \uAE68\uBB3C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563584
    m_Localized: "\uC815 \uBC18\uC7A5: \uC624 \uC528\uAC00 \uB137 \uB370\uB9AC\uACE0 \uB098\uAC14\uC5B4. \uC57D\uC774\uB791 \uC5F0\uC7A5 \uCC59\uACA8\uC11C. \uC0AC\uAC70\uB9AC\uB85C \uAC14\uC5B4. \uC0AC\uAC70\uB9AC \uD30C\uD55C\uD14C \uBD99\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563585
    m_Localized: "\uC815 \uBC18\uC7A5: \uADF8\uB188\uB4E4\uC774 \uC624\uB298 \uBC24 \uCC3D\uACE0 \uD138\uB7EC \uB2E4\uC2DC \uC628\uB300. \uC624 \uC528\uAC00 \uCC3D\uACE0 \uAD6C\uC870\uB97C \uB2E4 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563586
    m_Localized: "\uC815 \uBC18\uC7A5: \uD559\uC0DD\uB124 \uADF8 \uC5EC\uC790\uC560\uAC00 \uBBF8\uB9AC \uB9D0\uD574 \uC918\uC11C \uC57D \uC808\uBC18\uC740 \uC62E\uACA8 \uB1A8\uC5B4. \uACE0\uB9D9\uB2E4\uACE0 \uC804\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563587
    m_Localized: "\uC815 \uBC18\uC7A5: \uB3C4\uC640 \uB2EC\uB77C\uB294 \uB9D0\uC740 \uC548 \uD560\uAC8C. \uB108\uD76C\uB3C4 \uBC84\uD2F0\uAE30 \uBC14\uC058\uB2C8\uAE4C. \uADF8\uB0E5\u2026 \uC54C\uB824 \uC8FC\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563588
    m_Localized: "\uB9C8\uD2B8\uB85C \uAC00\uC11C \uAC19\uC774 \uCC3D\uACE0\uB97C \uC9C0\uD0A8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563589
    m_Localized: "\uBC24\uC0C8 \uCC3D\uACE0 \uC154\uD130 \uC55E\uC744 \uC9C0\uCF30\uB2E4. \uC0C8\uBCBD\uC5D0 \uBAB0\uB824\uC628 \uC6B0\uBE44\uB4E4\uC740 \uBD88\uBE5B\uACFC \uC0AC\uB78C \uC218\uB97C \uBCF4\uACE0 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563590
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uB0B4 \uC5B4\uAE68\uB97C \uB450 \uBC88 \uB450\uB4DC\uB838\uB2E4. \uB9D0\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563591
    m_Localized: "\uC154\uD130\uAC00 \uBC00\uB824 \uC62C\uB77C\uAC14\uB2E4. \uBAB8\uC2F8\uC6C0 \uB05D\uC5D0 \uB204\uAD70\uAC00 \uD718\uB450\uB978 \uC1E0\uD30C\uC774\uD504\uC5D0 \uD314\uC744 \uB9DE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563592
    m_Localized: "\uADF8\uB798\uB3C4 \uCC3D\uACE0\uB294 \uC9C0\uCF30\uB2E4. \uC815 \uBC18\uC7A5\uC774 \uB0B4 \uD314\uC5D0 \uBD95\uB300\uB97C \uAC10\uC73C\uBA70 \uC774\uB97C \uC545\uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563593
    m_Localized: "\uC0AC\uAC70\uB9AC\uB85C \uCC3E\uC544\uAC00 \uC624 \uC528\uC640 \uAC15\uCCA0 \uC0AC\uC774\uC5D0\uC11C \uB2F4\uD310\uC744 \uC9D3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980602
    m_Localized: "\uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C \uB2E4\uB978 \uC18C\uB9AC\uAC00 \uC11E\uC600\uB2E4. \uAD50\uC2E4 \uB4A4\uD3B8 \uBC14\uB2E5\uC5D0 \uBB3C\uC774 \uACE0\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980601
    m_Localized: "\uCC9C\uC7A5 \uC5BC\uB8E9\uC774 \uD558\uB8FB\uBC24 \uC0C8 \uB450 \uBC30\uB85C \uBC88\uC84C\uB2E4. \uB611, \uB611. \uBB3C\uBC29\uC6B8\uC774 \uCC45\uC0C1 \uC704\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980600
    m_Localized: "\uBC24\uC0C8 \uBE44\uAC00 \uC654\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0C8\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591944
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC190\uC804\uB4F1 \uAF2D \uCC59\uAE30\uACE0. \uBB34\uB9AC\uD558\uBA74 \uBC14\uB85C \uB3CC\uC544\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591943
    m_Localized: "\uD574 \uBCFC\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591942
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD559\uAD50 \uC548\uC774\uB77C\uBA74\u2026 \uC5F0\uC2B5 \uC0BC\uC544 \uD55C \uBC88\uCBE4\uC740 \uAD1C\uCC2E\uC744\uC9C0\uB3C4 \uBAB0\uB77C. \uB124\uAC00 \uC6D0\uD55C\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591941
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC704\uD5D8\uD574. \uADF8\uB798\uB3C4 \uBC24\uC5D0\uB9CC \uAC08 \uC218 \uC788\uB294 \uACF3\uC774 \uC788\uC5B4. \uD558\uC9C0\uB9CC \uBC24\uC744 \uADF8\uB807\uAC8C \uBCF4\uB0B4\uACE0 \uB098\uBA74 \uC7A0\uC774 \uBE5A\uCC98\uB7FC \uC313\uC774\uB2C8\uAE4C \uC8FC\uC758\uD574\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174932
    m_Localized: "\uBD88\uB9CC\uC774 \uC5C6\uC9C0\uB294 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uD45C\uAC00 \uBD99\uC740 \uB4A4\uB85C\uB294 \uC544\uBB34\uB3C4 \uC0C1\uC790 \uC55E\uC5D0\uC11C \uC5B8\uC131\uC744 \uB192\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980599
    m_Localized: "\uB458\uC740 \uD55C\uCC38 \uB9D0\uC5C6\uC774 \uD558\uB298\uB9CC \uBCF4\uC558\uB2E4. \uB0B4\uB824\uAC00\uB294 \uACC4\uB2E8\uB3C4 \uC5F4\uC5EC\uC12F \uCE78\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563594
    m_Localized: "{0}: \uCC3D\uACE0 \uD138\uBA74 \uB9C8\uD2B8\uB3C4 \uD559\uAD50\uB3C4 \uACA8\uC6B8 \uBABB \uB098\uC694. \uADF8\uB7FC \uC0AC\uAC70\uB9AC\uB294 \uB2E4\uC74C \uACA8\uC6B8 \uB204\uAD6C\uD55C\uD14C\uC11C \uBC1B\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563595
    m_Localized: "\uAC15\uCCA0\uC774 \uD55C\uCC38 \uC6C3\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC624 \uC528\uC758 \uB4F1\uC744 \uB5A0\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757737
    m_Localized: "\uB178\uB798 \uB300\uC2E0 \uD55C\uCC38 \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC\uB9CC \uB0AC\uB2E4. \uADF8\uB798\uB3C4 \uC544\uBB34\uB3C4 \uB77C\uB514\uC624\uB97C \uB044\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757738
    m_Localized: "\uCCAB \uD55C\uD30C\uAC00 \uBAB0\uB824\uC628 \uBC24. \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC218\uC2ED \uAC1C\uC758 \uBC1C\uC18C\uB9AC\uAC00 \uD559\uAD50\uB97C \uB458\uB7EC\uC30C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757739
    m_Localized: "\uC785\uAE40\uC774 \uD558\uC597\uAC8C \uBC88\uC84C\uB2E4. \uCC3D\uD2C0\uC5D0 \uC11C\uB9AC \uB07C\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B4 \uB9CC\uD07C \uC870\uC6A9\uD558\uB2E4\uAC00, \uD55C\uAEBC\uBC88\uC5D0 \uC2DC\uB044\uB7EC\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174893
    m_Localized: "\uC77D\uC5B4\uB3C4 \uB418\uB0D0\uACE0 \uBB3B\uACE0, \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC77D\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591994
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 {0}, \uBC24\uC5D0\uB294 \uBD88 \uD558\uB098\uB9CC \uCF1C\uC790. \uCEE4\uD2BC\uB3C4 \uAF2D \uCE58\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591995
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774 \uB3D9\uB124\uC5D0\uC11C \uBD88 \uCF1C\uC9C4 \uCC3D\uBB38\uC740 \uC5EC\uAE30 \uD558\uB098\uBFD0\uC77C \uAC70\uC57C. \uBCF4\uB294 \uAC8C \uC0AC\uB78C\uB9CC\uC740 \uC544\uB2D0 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980586
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB450 \uD1B5. \uC544\uCE68\uC5D0 \uAC19\uC774 \uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980585
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uB098\uB97C \uBCF4\uB2E4\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980584
    m_Localized: "{0}: \u2026\uB0B4\uC77C \uBB3C\uC740 \uBA87 \uD1B5 \uBC1B\uC544\uC57C \uD574\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174969
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uC77C \uC544\uCE68\uC5D0 \uB2E4 \uAC19\uC774 \uB4F1 \uBC30\uAE30\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591920
    m_Localized: "\uB458\uC774\uC11C \uB2F4\uC694\uC640 \uBB3C\uD1B5\uC744 \uC62E\uACBC\uB2E4. \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uC791\uAC8C \uC801\uC5C8\uB2E4. \"1\uD559\uB144 0\uBC18\"."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591919
    m_Localized: "\uC5EC\uAE30\uB97C \uC0C8 \uAC70\uC810\uC73C\uB85C \uC0BC\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591918
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uBA74 \uC218\uC5C5\uD558\uAE30\uB294 \uD6E8\uC52C \uB0AB\uACA0\uB2E4. \uB2E4\uB9CC \uCC3D\uACE0\uBCF4\uB2E4\uB294 \uBC16\uC5D0\uC11C \uC798 \uBCF4\uC774\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591917
    m_Localized: "\uCC3D\uC73C\uB85C \uC624\uD6C4 \uD587\uBE5B\uC774 \uB4E4\uC5B4\uC654\uB2E4. \uCE60\uD310\uC5D0\uB294 \uB204\uAD70\uAC00 \uC4F0\uB2E4 \uB9CC \uC2DC\uAC04\uD45C\uAC00 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980583
    m_Localized: "\uB2E4\uB978 \uC774\uC57C\uAE30\uB97C \uAEBC\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757740
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC77C\uC5B4\uC11C\uC9C0 \uBABB\uD588\uB2E4. \uB300\uC2E0 \uB204\uC6B4 \uCC44 \uC190\uC804\uB4F1\uC744 \uC950\uACE0 \uBB38 \uCABD\uC744 \uBE44\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174892
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8\uAC70\u2026 \uBC84\uB9AC\uB824\uB358 \uAC70\uC57C. \uB3CC\uB824\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591996
    m_Localized: "\uCC3D\uBB38\uB9C8\uB2E4 \uCEE4\uD2BC\uC744 \uB05D\uAE4C\uC9C0 \uCCE4\uB2E4. \uD615\uAD11\uB4F1 \uD558\uB098 \uC544\uB798 \uB458\uC774 \uB9C8\uC8FC \uC549\uC73C\uB2C8, \uBC29\uC774 \uAC11\uC790\uAE30 \uC881\uC544 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591997
    m_Localized: "\uCDA9\uC804\uAE30\uC5D0 \uAF42\uC740 \uD734\uB300\uD3F0 \uD654\uBA74\uC5D0 \uBC30\uD130\uB9AC \uBAA8\uC591\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980582
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC740 \uCE5C\uAD6C\uB124. \uAF2D \uB2E4\uC2DC \uB9CC\uB098\uC11C, \uB5A1\uBCF6\uC774 \uC0AC \uC918. \uB2A6\uC740 \uB2F5\uC7A5 \uAC12\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174968
    m_Localized: "\uB108\uBB34 \uB354\uC6CC\uC11C \uAE09\uC2DD\uC2E4 \uC2A4\uD14C\uC778\uB9AC\uC2A4 \uC870\uB9AC\uB300\uC5D0 \uB4F1\uC744 \uB300\uACE0 \uB204\uC6E0\uB2E4. \uC1E0\uAC00 \uCC28\uAC00\uC6CC\uC11C, \uADF8\uAC83\uB9CC\uC73C\uB85C \uC0B4 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980581
    m_Localized: "{0}: \u2026\uB2F5\uC7A5 \uB290\uB9B0 \uC560\uC694. \uADF8\uB798\uB3C4 \uB5A1\uBCF6\uC774\uB294 \uAF2D \uAC19\uC774 \uBA39\uB294 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980580
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uC560\uB294 \uB124 \uC598\uAE30\uB97C \uC5B4\uB5BB\uAC8C \uD560\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591916
    m_Localized: "\uAD50\uC2E4\uB3D9 1\uCE35 \uB05D \uAD50\uC2E4. \uCC45\uC0C1\uC744 \uBC00\uC5B4 \uBB38\uC744 \uB9C9\uC790 \uC0DD\uAC01\uBCF4\uB2E4 \uB113\uC740 \uACF5\uAC04\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591915
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB354 \uBB3B\uC9C0 \uC54A\uACE0 \uD3EC\uC2A4\uD130 \uADC0\uD241\uC774\uC5D0 \uC624\uB298 \uB0A0\uC9DC\uB97C \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591914
    m_Localized: "\uACE0\uAC1C\uB9CC \uB044\uB355\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591913
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7FC \uC219\uC81C\uB97C \uB0B4\uC57C\uACA0\uB124. \uB18D\uB2F4\uC774\uC57C. \uBC18\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174967
    m_Localized: "\uC0C8\uBCBD\uB158\uC5D0\uC57C \uBC14\uB78C\uC774 \uD55C \uC904\uAE30 \uB4E4\uC5B4\uC654\uB2E4. \uADF8 \uBC14\uB78C\uC5D0 \uB2E4\uB4E4 \uD55C\uAEBC\uBC88\uC5D0 \uC7A0\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757741
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB294 \uC5EC\uAE30\uC11C \uBD88\uC744 \uBE44\uCD9C\uAC8C. \uB108\uD76C\uB294 \uBCF4\uC774\uB294 \uAC83\uB9CC \uB9C9\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757742
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uB108\uBA38\uC5D0\uC11C, \uBB34\uC804\uAE30\uB85C \uC120\uC0DD\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174891
    m_Localized: "\uC8FC\uC6CC \uBCF4\uB2C8 \uB9E8 \uC704\uC5D0 \uB0B4 \uC774\uB984\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uD3B8\uC9C0\uC600\uB2E4. \uBD80\uCE58\uC9C0 \uC54A\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591998
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCF1C\uC9C0\uBA74\u2026 \uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uB9CE\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591999
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0, \uBE68\uAC04 \uBC30\uD130\uB9AC \uCE78\uC774 \uD558\uB098 \uCC44\uC6CC\uC9C0\uB294 \uAC78 \uC9C0\uCF1C\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980579
    m_Localized: "\uB9D0\uD558\uB2E4 \uBCF4\uB2C8 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980578
    m_Localized: "\uC2DC\uD5D8 \uC804\uB0A0\uC774\uBA74 '\uC624\uB298\uC758 \uC6B4\uC138'\uAC00 \uB098\uC058\uB2E4\uACE0 \uACF5\uBD80\uB97C \uC811\uB358 \uC560. \uADF8\uB7EC\uACE0\uB294 \uB098\uBCF4\uB2E4 \uC798 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174966
    m_Localized: "\uBC24\uC778\uB370\uB3C4 \uB354\uC704\uAC00 \uC2DD\uC9C0 \uC54A\uC558\uB2E4. \uB204\uAC00 \uBD80\uCC44\uC9C8\uD558\uB294 \uC18C\uB9AC\uB9CC \uBC24\uC0C8 \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980577
    m_Localized: "\uB5A1\uBCF6\uC774\uB97C \uC88B\uC544\uD558\uACE0, \uC0DD\uC77C\uC744 \uB9E8\uB0A0 \uAE4C\uBA39\uACE0, \uC6B4\uC138 \uC571\uC744 \uBBFF\uB294 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980576
    m_Localized: "{0} \uC774\uC57C\uAE30\uB97C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980575
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC00\uB054 \uAEBC\uC9C4 \uD734\uB300\uD3F0\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uB354\uB77C. \uAE30\uB2E4\uB9AC\uB294 \uCE5C\uAD6C\uAC00 \uC788\uC9C0. \uC5B4\uB5A4 \uC560\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980574
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uD734\uB300\uD3F0 \uC18D \uCE5C\uAD6C. \uC5B4\uB5A4 \uC560\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174965
    m_Localized: "\uC816\uC740 \uC218\uAC74\uC744 \uBAA9\uC5D0 \uB450\uB974\uACE0 \uBC14\uB2E5\uC5D0 \uB204\uC6E0\uB2E4. \uC2DC\uBA58\uD2B8 \uBC14\uB2E5\uB9CC \uC870\uAE08 \uC11C\uB298\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980573
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uB3C4 '\uC624\uBA74'\uC774\uB77C\uACE0 \uC37C\uC796\uC544. '\uC628\uB2E4\uBA74'\uC774 \uC544\uB2C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563808
    m_Localized: "\uB3C4\uD604\uC740 \uB098\uB97C \uCCD0\uB2E4\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563809
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563810
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563811
    m_Localized: "\uB2E4\uB4E4 \uB0B4\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD560\uC9C0 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4. \uC774 \uAD50\uC2E4\uC5D0\uC11C \uADF8 \uC560\uB97C \uBBF8\uC6CC\uD560 \uC774\uC720\uAC00 \uAC00\uC7A5 \uB9CE\uC740 \uC0AC\uB78C\uC774 \uB098\uB77C\uB294 \uAC78, \uBAA8\uB450 \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757723
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB2F4\uC694\uB97C \uB36E\uC740 \uCC44 \uB77C\uB514\uC624\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uD45C\uC815\uC774 \uC774\uC0C1\uD558\uAC8C \uD3B8\uC548\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757724
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB204\uAD70\uAC00\uB294 \uAE30\uB85D\uD558\uACE0 \uC788\uC5C8\uAD6C\uB098. \uB2E4\uD589\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757725
    m_Localized: "\uC1A1\uC2E0 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB354 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757726
    m_Localized: "DJ: \uC5F0\uAD6C\uB3D9\uC740 \uBC24\uC5D0\uB9CC \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC744 \uAC70\uC608\uC694. \uB0AE\uC5D0\uB294 \uAC70\uAE30 \uC7A0\uB4E0 \uBB34\uB9AC\uAC00 \uB108\uBB34 \uB9CE\uB300\uC694. \uC870\uC2EC\uD574\uC694, \uD559\uC0DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757727
    m_Localized: "DJ: \uADF8\uB9AC\uACE0\u2026 \uADF8 \uAE30\uB85D \uCC3E\uAC8C \uB418\uBA74 \uBC29\uC1A1\uC73C\uB85C \uC54C\uB824 \uC918\uC694. \uB098\uB3C4 \uC54C\uACE0 \uC2F6\uC5B4\uC694. \uADF8 \uC0AC\uB78C\uC774 \uD5DB\uB418\uC9C0 \uC54A\uC558\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757728
    m_Localized: "\uB178\uD2B8\uC5D0 \uBC1B\uC544 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174895
    m_Localized: "'\uB124\uAC00 \uBB38\uC744 \uB450\uB4DC\uB9AC\uB358 \uC18C\uB9AC, \uC544\uC9C1\uB3C4 \uB4E4\uB824. \uBBF8\uC548\uD558\uB2E4\uB294 \uB9D0\uC740 \uB108\uBB34 \uC791\uC544\uC11C \uC548 \uC37C\uC5B4. \uB300\uC2E0 \uB9E4\uC77C \uBC24 \uC5EC\uAE30\uC11C \uBB38 \uCABD\uC744 \uBCFC\uAC8C. \uC774\uBC88\uC5D4 \uC544\uBB34\uB3C4 \uB2EB\uC9C0 \uBABB\uD558\uAC8C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591990
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uB2E4. \uBAA9\uD45C\uAC00 \uAD6C\uCCB4\uC801\uC774\uB77C\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591991
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uBCF5\uB3C4\uB85C \uB098\uAC00\uB354\uB2C8, \uC2A4\uC704\uCE58\uB97C \uD558\uB098\uC529 \uB20C\uB7EC \uBCF4\uC558\uB2E4. \uCF1C\uC9C0\uB294 \uAC83\uBCF4\uB2E4 \uC548 \uCF1C\uC9C0\uB294 \uAC8C \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980591
    m_Localized: "\uBD88 \uAEBC\uC9C4 \uB3C4\uC2DC \uC704\uB85C \uBCC4\uC774 \uC3DF\uC544\uC9C8 \uB4EF \uB9CE\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980590
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB09C\uAC04\uC744 \uBD99\uC7A1\uACE0 \uC55E\uC7A5\uC130\uB2E4. \uC625\uC0C1 \uACC4\uB2E8\uC740 \uC5F4\uC5EC\uC12F \uCE78. \uC26C\uBA74\uC11C \uC138 \uBC88 \uB9CC\uC5D0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591930
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC18D\uC774\uB2E4. \uB098\uB3C4 \uD558\uB098 \uC57D\uC18D\uD560\uAC8C. \uADF8\uAC70 \uC9DA\uACE0 \uC81C\uC77C \uBA3C\uC800 \uC625\uC0C1\uC5D0 \uC62C\uB77C\uAC00 \uBCFC \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591929
    m_Localized: "\uAF2D \uB9CC\uB4E4\uC5B4 \uB4DC\uB9B4\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591928
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8\uB7EC\uBA74 \uC815\uB9D0 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174931
    m_Localized: "{0}: \uC624\uB298\uBD80\uD130 \uBC30\uC2DD\uD45C \uB9CC\uB4E4\uC5B4\uC694. \uB611\uAC19\uC774. \uC800\uB3C4, \uC120\uC0DD\uB2D8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591927
    m_Localized: "{0}: \uBAA9\uBC1C \uAC19\uC740 \uAC70\u2026 \uB9CC\uB4E4 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C\uC694? \uB300\uAC78\uB808 \uC790\uB8E8\uB791 \uD14C\uC774\uD504\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591926
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uC544. \uB298 \uC774\uB798. \uAE30\uC5B4 \uB2E4\uB2C8\uB294 \uAC8C \uC544\uC9C1 \uC775\uC219\uD558\uC9C0 \uC54A\uC744 \uBFD0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980589
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC55E\uC7A5\uC130\uB2E4. \uC625\uC0C1 \uACC4\uB2E8\uC740 \uC5F4\uC5EC\uC12F \uCE78. \uC26C\uBA74\uC11C \uC138 \uBC88 \uB9CC\uC5D0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757729
    m_Localized: "\uC815\uC218\uC7A5. \uC5F0\uAD6C\uB3D9. \uC9C0\uD558. \uAE30\uB85D. \uB2E8\uC5B4 \uB124 \uAC1C\uB97C \uB178\uD2B8\uC5D0 \uC801\uACE0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757730
    m_Localized: "DJ: \uC624\uB298\uC758 \uC2E0\uCCAD\uACE1\uC740\u2026 \uC2E0\uCCAD\uD55C \uC0AC\uB78C\uC774 \uC5C6\uB124\uC694. \uADF8\uB7FC \uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uB178\uB798\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757731
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB294 \uB178\uB798\uAC00 \uAD50\uC2E4\uC744 \uCC44\uC6E0\uB2E4. \uB2E4\uB4E4 \uB9D0\uC5C6\uC774 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757732
    m_Localized: "DJ: \uB0B4\uC77C\uB3C4 \uC0B4\uC544 \uC788\uC5B4\uC694. \uADF8\uAC8C \uC624\uB298\uC758 \uC219\uC81C\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757733
    m_Localized: "DJ: \uC624\uB298\uC740 \uB0A0\uC528 \uC598\uAE30\uB97C \uD574 \uBCFC\uAE4C\uC694. \uCC3D\uBC16\uC744 \uBCF4\uC138\uC694. \u2026\uBCF4\uC168\uC8E0? \uADF8\uAC8C \uC624\uB298\uC758 \uB0A0\uC528\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757734
    m_Localized: "\uC6C3\uC74C \uBE44\uC2B7\uD55C \uC18C\uB9AC\uAC00 \uAD50\uC2E4\uC5D0 \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757735
    m_Localized: "DJ: \uB0B4\uC77C \uB610 \uB9CC\uB098\uC694. \uAF2D\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757736
    m_Localized: "DJ: \uC0AC\uC5F0\uC774 \uD558\uB098 \uB4E4\uC5B4\uC654\uC5B4\uC694. \"\uB3D9\uC0DD\uC774 \uBB34\uC0AC\uD558\uAE38.\" \u2026\uBB34\uC0AC\uD560 \uAC70\uC608\uC694. \uC6B0\uB9AC \uBAA8\uB450."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174894
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uB300\uB2F5 \uB300\uC2E0 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591992
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAE30 \uC2A4\uC704\uCE58 \uC880 \uB20C\uB7EC \uBCFC\uB798? \uD558\uB098\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591993
    m_Localized: "\uCF1C\uC9C0\uB294 \uAC83\uBCF4\uB2E4 \uC548 \uCF1C\uC9C0\uB294 \uAC8C \uB9CE\uC558\uB2E4. \uADF8\uB798\uB3C4 \uD558\uB098\uAC00 \uCF1C\uC9C8 \uB54C\uB9C8\uB2E4 \uC120\uC0DD\uB2D8\uC774 \uC791\uAC8C \uBC15\uC218\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980588
    m_Localized: "\uC774\uBD88\uC744 \uB04C\uC5B4 \uC62C\uB838\uB2E4. \uB9D0\uD558\uC9C0 \uC54A\uC740 \uC774\uB984\uC774 \uD55C\uCC38 \uC785\uC548\uC5D0 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980587
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uB9D0\uD558\uACE0 \uC2F6\uC744 \uB54C \uB9D0\uD574. \uB098\uB294 \uACC4\uC18D \uC5EC\uAE30 \uC788\uC744 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591925
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uBCBD\uC744 \uC9DA\uACE0 \uC77C\uC5B4\uC11C\uB824\uB2E4 \uB2E4\uC2DC \uC8FC\uC800\uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591924
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCC3D\uACE0\uB97C \uC9C0\uD0A4\uB824\uBA74 \uB36B\uC774\uB098 \uACBD\uBCF4 \uAC19\uC740 \uAC83\uB3C4 \uC0DD\uAC01\uD574 \uB46C\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591923
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC2E0\uC911\uD574\uC11C \uC88B\uC544. \uB300\uC2E0 \uBB38 \uCABD \uCC45\uC0C1\uC740 \uB2E8\uB2E8\uD788 \uBB36\uC5B4 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591922
    m_Localized: "\uC7A0\uC740 \uCC3D\uACE0\uC5D0\uC11C, \uB0AE\uC5D0\uB9CC \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174930
    m_Localized: "\uB611\uAC19\uC774 \uB098\uB208\uB2E4. \uB204\uAD6C\uB4E0 \uAC19\uC740 \uC591\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591921
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCE60\uD310\uC774 \uC0DD\uACBC\uC73C\uB2C8 \uAC00\uB974\uCE60 \uC218 \uC788\uB294 \uAC8C \uB298\uACA0\uB2E4. \uC704\uCE35 \uACFC\uD559\uC2E4\uC774\uB791 \uC74C\uC545\uC2E4 \uAC83\uB3C4 \uBE4C\uB824 \uC624\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174970
    m_Localized: "\uC5EC\uB984\uC774 \uB05D\uB098\uAE34 \uD560\uAE4C. \uADF8\uB7F0 \uC0DD\uAC01\uC744 \uD558\uB2E4 \uBCF4\uBA74 \uC544\uCE68\uC774 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563596
    m_Localized: "\uAC15\uCCA0: \uC560\uAC00 \uC7A5\uC0AC\uB97C \uC544\uB124. \uC624 \uC528, \uB108\uB294 \uC5EC\uAE30 \uB0A8\uACE0. \uB9C8\uD2B8 \uCC3D\uACE0\uB294 \uAC74\uB4DC\uB9AC\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563597
    m_Localized: "\uB0B4 \uB9D0\uC740 \uC6B0\uBE44\uB4E4\uC758 \uC6C3\uC74C\uC18C\uB9AC\uC5D0 \uBB3B\uD614\uB2E4. \uCAD3\uACA8\uB098\uB4EF \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563598
    m_Localized: "\uADF8\uB0A0 \uBC24 \uB9C8\uD2B8 \uCC3D\uACE0 \uC808\uBC18\uC774 \uD138\uB838\uB2E4\uB294 \uBB34\uC804\uC774 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563599
    m_Localized: "\uB07C\uC9C0 \uC54A\uB294\uB2E4. \uD559\uAD50\uB97C \uC9C0\uD0A4\uB294 \uAC8C \uBA3C\uC800\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563600
    m_Localized: "\uBB34\uC804\uAE30\uB97C \uAED0\uB2E4. \uC5F0\uAE30\uB294 \uC624\uD6C4\uAE4C\uC9C0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563601
    m_Localized: "\uBA70\uCE60 \uB4A4 \uC815 \uBC18\uC7A5\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB2E4\uC2DC \uB4E4\uB838\uC744 \uB54C, \uADF8\uB294 \uB0B4 \uC774\uB984\uC744 \uBD80\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563602
    m_Localized: "\uC774\uBC88\uC5D4 \uC6B0\uBE44\uAC00 \uC14B\uC774\uC5C8\uB2E4. \uAC00\uC6B4\uB370 \uC0AC\uB78C\uC774 \uBAA8\uC790\uB97C \uBC97\uC5C8\uB2E4. \uB208\uC379\uC744 \uAC00\uB85C\uC9C0\uB974\uB294 \uD749\uD130. \uB9C8\uD754\uCBE4 \uB41C \uB0A8\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563603
    m_Localized: "\uAC15\uCCA0: \uB0B4\uAC00 \uAC15\uCCA0\uC774\uB2E4. \uC9C1\uC811 \uBCF4\uB294 \uAC74 \uCC98\uC74C\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563604
    m_Localized: "\uAC15\uCCA0: \uC0AC\uD0DC \uC804\uC5D4 \uC0AC\uAC70\uB9AC\uC5D0\uC11C \uBCF5\uC2F1 \uCCB4\uC721\uAD00\uC744 \uD588\uC5B4. \uC560\uB4E4 \uAC00\uB974\uCCE4\uC9C0. \uADF8\uB798\uC11C \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB824. \uADF8\uAC8C \uB0B4 \uC6D0\uCE59\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980598
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD88\uC774 \uB2E4 \uAEBC\uC9C0\uB2C8\uAE4C \uBCC4\uC774 \uBCF4\uC774\uB124. \uC88B\uC740 \uC77C\uC740 \uC544\uB2CC\uB370. \uADF8\uB798\uB3C4 \uBCF4\uC774\uAE34 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174971
    m_Localized: "\uC544\uCE68\uBD80\uD130 \uB9E4\uBBF8\uAC00 \uC6B8\uC5C8\uB2E4. \uCC3D\uACE0 \uC548\uC758 \uACF5\uAE30\uAC00 \uB048\uC801\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980597
    m_Localized: "\uBA40\uB9AC \uD55C \uAD70\uB370, \uC544\uC8FC \uC791\uC740 \uBD88\uBE5B\uC774 \uAE5C\uBE61\uC774\uB2E4 \uAEBC\uC84C\uB2E4. \uB458 \uB2E4 \uBCF4\uC558\uACE0, \uB458 \uB2E4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980596
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uC11C \uBCC4 \uC774\uB984\uC740 \uADF8\uAC70 \uD558\uB098\uBC16\uC5D0 \uBAB0\uB77C. \uBCC4 \uBCF4\uACE0 \uC4F4 \uC2DC\uB294 \uBA87 \uD3B8 \uC544\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591940
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC24\uC5D0\uB294 \uC800\uAC83\uB4E4\uC774 \uAE68\uC5B4\uB098\uC11C \uB3CC\uC544\uB2E4\uB140. \uB300\uC2E0 \uB0AE\uC5D0 \uBCF4\uC774\uB358 \uC0AC\uB78C\uB4E4\uC740 \uC228\uACE0, \uC7A0\uB4E0 \uBB34\uB9AC\uB3C4 \uD769\uC5B4\uC9C0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591939
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD560 \uC598\uAE30\uAC00 \uC788\uC5B4. \uBC24\uC5D0 \uB300\uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591938
    m_Localized: "\uADF8\uB0A0 \uC800\uB141, \uC120\uC0DD\uB2D8\uC740 \uCC3D\uACE0 \uC548\uC744 \uBA87 \uBC88\uC774\uACE0 \uC655\uBCF5\uD588\uB2E4. \uBC1C\uC18C\uB9AC\uAC00 \uC870\uAE08 \uC6B0\uC2A4\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591937
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70 \uC9C4\uC9DC \uC798 \uB9CC\uB4E4\uC5C8\uB2E4. \uACF5\uD559 \uC120\uC0DD\uB2D8 \uD558\uB098 \uC0DD\uAE34 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980595
    m_Localized: "{0}: \uC120\uC0DD\uB2D8 \uAD6D\uC5B4 \uC120\uC0DD\uB2D8\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563605
    m_Localized: "\uAC15\uCCA0: \uADFC\uB370 \uACA8\uC6B8\uC774 \uC640. \uC6B0\uB9AC \uC2DD\uAD6C\uAC00 \uB298\uC5C8\uC5B4. \uC774\uBC88 \uACA8\uC6B8 \uC55E\uB450\uACE0, \uD55C \uBC88 \uB354 \uC131\uC758\uB97C \uBCF4\uC5EC \uC92C\uC73C\uBA74 \uD558\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563606
    m_Localized: "\uC774\uBC88 \uD55C \uBC88 \uB354 \uC2DD\uB7C9\uC744 \uB0B4\uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563607
    m_Localized: "\uD1B5\uC870\uB9BC\uC744 \uC0C1\uC790\uC9F8 \uAC74\uB138\uB2E4. \uAC15\uCCA0\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563608
    m_Localized: "\uAC15\uCCA0: \uACA8\uC6B8 \uC9C0\uB098\uBA74 \uAC1A\uC744 \uC77C \uC788\uC744 \uAC70\uB2E4. \uC0AC\uAC70\uB9AC\uB294 \uBC1B\uC740 \uAC74 \uAE30\uC5B5\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563609
    m_Localized: "\uC6D0\uCE59\uC744 \uC9C0\uCF1C \uB2EC\uB77C\uACE0, \uC9C0\uAE08 \uBAAB\uC73C\uB85C \uCDA9\uBD84\uD558\uB2E4\uACE0 \uB9DE\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563610
    m_Localized: "{0}: \uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4\uBA74\uC11C\uC694. \uC560\uB4E4 \uBA39\uC744 \uAC78 \uB354 \uAC00\uC838\uAC00\uB294 \uAC83\uB3C4 \uAC74\uB4DC\uB9AC\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563611
    m_Localized: "\uAC15\uCCA0\uC774 \uB098\uB97C \uC624\uB798 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563612
    m_Localized: "\uAC15\uCCA0: \u2026\uAD00\uC7A5\uB2D8 \uC18C\uB9AC \uB4E4\uC744 \uB54C \uC0DD\uAC01\uB098\uB124. \uB410\uB2E4. \uC9C0\uAE08\uB300\uB85C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563613
    m_Localized: "\uBAA9\uC18C\uB9AC\uAC00 \uAC08\uB77C\uC84C\uB2E4. \uAC15\uCCA0\uC758 \uBD80\uD558 \uD558\uB098\uAC00 \uBE44\uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563614
    m_Localized: "\uAC15\uCCA0: \uC6D0\uCE59\uC740 \uB0B4\uAC00 \uC815\uD558\uB294 \uAC70\uC57C, \uAF2C\uB9C8. \uB2E4\uC74C \uC8FC\uBD80\uD130 \uBB38 \uC870\uC2EC\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563615
    m_Localized: "\uB354\uB294 \uBABB \uB0B8\uB2E4. \uC57D\uC18D\uC740 \uB05D\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980594
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800\uAE30 \uAD6D\uC790 \uBAA8\uC591 \uBCF4\uC5EC? \uAD6D\uC790 \uB05D \uB450 \uBCC4\uC744 \uC774\uC5B4\uC11C \uB2E4\uC12F \uBC30\uCBE4 \uAC00\uBA74 \uBD81\uADF9\uC131\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980593
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC57D\uC18D \uC9C0\uCF30\uC9C0? \uBAA9\uBC1C \uC9DA\uACE0 \uC81C\uC77C \uBA3C\uC800 \uC625\uC0C1\uC5D0 \uC62C\uB77C\uC624\uACA0\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591936
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uC774\uACE0, \uC774\uAC8C \uBB50\uB77C\uACE0 \uB208\uBB3C\uC774 \uB098\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591935
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uBD10. \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591934
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uCC9C\uCC9C\uD788 \uC77C\uC5B4\uC130\uB2E4. \uD55C \uAC78\uC74C. \uB450 \uAC78\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591933
    m_Localized: "\uD14C\uC774\uD504\uB97C \uC138 \uBC88\uC774\uB098 \uB2E4\uC2DC \uAC10\uC558\uB2E4. \uC190\uC7A1\uC774 \uB192\uC774\uB97C \uB450 \uBC88 \uACE0\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591932
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC190\uAC00\uB77D\uC73C\uB85C \uBC14\uB2E5\uC5D0 \uADF8\uB9BC\uC744 \uADF8\uB838\uB2E4. \uACA8\uB4DC\uB791\uC774 \uBC1B\uCE68, \uC190\uC7A1\uC774, \uAE38\uC774. \uC0DD\uAC01\uBCF4\uB2E4 \uC815\uD655\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591931
    m_Localized: "\uC5B4\uB5BB\uAC8C \uB9CC\uB4DC\uB294\uC9C0\uBD80\uD130 \uC54C\uB824 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980592
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC11C\uC6B8\uC5D0\uC11C \uC774\uB7F0 \uD558\uB298\uC744 \uBCFC \uC904\uC740 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563812
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uB098 \uBCF5\uB3C4\uC5D0\uC11C \uC798\uAC8C. \uADF8\uAC8C \uD3B8\uD558\uC796\uC544, \uB2E4\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563813
    m_Localized: "\uBAA8\uB450 \uC55E\uC5D0\uC11C \uADDC\uCE59\uC744 \uB2E4\uC2DC \uC815\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563814
    m_Localized: "\uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uAE30. \uD63C\uC790 \uB098\uAC00\uC9C0 \uC54A\uAE30. \uBA39\uC744 \uAC74 \uAC19\uC774 \uB098\uB204\uAE30. \uADF8\uB9AC\uACE0 \uD558\uB098 \uB354. \uC5EC\uAE30\uC11C\uB294 \uC544\uBB34\uB3C4 \uB204\uAD6C\uB97C \uAC00\uB450\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563815
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uADF8 \uB9C8\uC9C0\uB9C9 \uADDC\uCE59\uC744 \uB4E4\uC73C\uBA70 \uC785\uC220\uC744 \uAE68\uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563816
    m_Localized: "\uB3C4\uD604\uC774 \uC190\uC744 \uB4E4\uC5C8\uB2E4. \uB3C4\uD604: \uADF8 \uADDC\uCE59, \uC800\uB3C4 \uCC2C\uC131\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563817
    m_Localized: "\uADF8 \uC560\uC640 \uAC70\uB9AC\uB97C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563818
    m_Localized: "\uB2E4\uB978 \uAD50\uC2E4\uC5D0\uC11C \uC7A4\uB2E4. \uADF8\uB798\uB3C4 \uBB38\uC740 \uC7A0\uADF8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563819
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uAE68 \uBCF4\uB2C8 \uBCF5\uB3C4 \uCABD \uBB38\uD2C8\uC73C\uB85C \uADF8 \uC560\uC758 \uC228\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC7A0\uB4E4\uC9C0 \uBABB\uD55C \uC228\uC18C\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563820
    m_Localized: "\uB2E8\uB458\uC774 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174897
    m_Localized: "\uC77D\uC9C0 \uC54A\uACE0 \uB3CC\uB824\uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591988
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD88\uC774 \uB4E4\uC5B4\uC624\uBA74 \uC81C\uC77C \uBA3C\uC800 \uBB58 \uD558\uACE0 \uC2F6\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563821
    m_Localized: "\uCD5C\uD558\uB9B0: \uC65C \uB370\uB824\uC654\uC5B4? \uB098 \uAC19\uC73C\uBA74 \uC548 \uB370\uB824\uC654\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563822
    m_Localized: "{0}: \uADF8\uB7EC\uB2C8\uAE4C. \uB108 \uAC19\uC9C0 \uC54A\uC73C\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563823
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uADF8 \uB9D0, \uC5C4\uCCAD \uC544\uD504\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563824
    m_Localized: "{0}: \uC54C\uC544. \uB098\uB3C4 \uC544\uD320\uC5B4. \uADF8\uB0A0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563825
    m_Localized: "\uD30C\uCD9C\uC18C\uC5D0\uC11C \uAC00\uC838\uC628 \uC11C\uB958\uCCA0\uC744 \uC120\uC0DD\uB2D8\uC774 \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563826
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9 \uCD9C\uC785 \uD1B5\uC81C\u2026 \uC0AC\uD0DC \uB2F7\uC0C8 \uC804\uC774\uC57C. \uB204\uAD70\uAC00\uB294 \uC54C\uACE0 \uC788\uC5C8\uB2E4\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563827
    m_Localized: "\uC11C\uB958 \uB9E8 \uC544\uB798\uC5D0 \uACB0\uC7AC \uB3C4\uC7A5\uC774 \uC5EC\uB7EC \uAC1C \uCC0D\uD600 \uC788\uC5C8\uB2E4. \uADF8\uC911 \uD558\uB098\uB294 \uC2DC\uCCAD \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563828
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC5D0 \uB124\uAC00 \uBCF4\uC5EC \uC900 \uADF8 \uACF5\uBB38 \uAE30\uC5B5\uB098? '\uBCF4\uB958 \uD574\uC81C'. \uB0A0\uC9DC\uAC00 \uC774\uAC70\uB791 \uACB9\uCCD0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563829
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uD558\uCCA0 \uBC29\uC1A1, \uACFC\uD559\uC2E4 \uB178\uD2B8, \uC774 \uC11C\uB958. \uB2E4 \uAC19\uC740 \uACF3\uC744 \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563830
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uC791\uAC8C \uC37C\uB2E4. \uC815\uC218\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563831
    m_Localized: "{0}: \uAC00 \uBCFC\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563832
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uC9C1\uC740. \uC54C\uACE0 \uC788\uB294 \uAC83\uACFC \uAC08 \uC218 \uC788\uB294 \uAC83\uC740 \uB2EC\uB77C. \uB3CC\uC544\uC62C \uD798\uBD80\uD130 \uAE38\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563833
    m_Localized: "\uBB34\uAE30\uACE0 \uCCA0\uBB38\uC740 \uC1E0\uC9C0\uB81B\uB300 \uB05D\uC5D0\uC11C \uBE44\uBA85\uC744 \uC9C0\uB974\uBA70 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563834
    m_Localized: "\uC18C\uB9AC\uAC00 \uBCF5\uB3C4 \uB05D\uAE4C\uC9C0 \uC6B8\uB838\uB2E4. \uD55C\uCC38 \uC228\uC744 \uC8FD\uC774\uACE0 \uAE30\uB2E4\uB838\uB2E4. \uC544\uBB34\uAC83\uB3C4 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563835
    m_Localized: "\uCD1D\uAE30 \uBCF4\uAD00\uD568\uC740 \uD145 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uC790\uBB3C\uC1E0\uB294 \uC5F4\uC1E0\uB85C \uC5F4\uB824 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uBA3C\uC800, \uC81C\uB300\uB85C \uAC00\uC838\uAC04 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563836
    m_Localized: "\uB300\uC2E0 \uBCBD\uC5D0 \uC9C4\uC555\uC6A9 \uC870\uB07C\uC640 \uC0BC\uB2E8\uBD09\uC774 \uAC78\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563837
    m_Localized: "\uC870\uB07C\uB294 \uBB34\uAC70\uC6E0\uC9C0\uB9CC \uC785\uC73C\uB2C8 \uC774\uC0C1\uD558\uAC8C \uB4E0\uB4E0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563838
    m_Localized: "\uAC00\uC2B4\uAED8\uC5D0 \uC774\uB984\uD45C \uC790\uAD6D\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uB5BC\uC5B4 \uB0B8 \uC790\uB9AC\uB9CC \uC0C9\uC774 \uC870\uAE08 \uC9C4\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563839
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC870\uB07C\uB97C \uBCF4\uC5EC \uC8FC\uC790 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563840
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC798 \uACE8\uB790\uB2E4. \uADF8\uAC8C \uCD1D\uBCF4\uB2E4 \uB108\uB97C \uC624\uB798 \uC9C0\uCF1C \uC904 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563841
    m_Localized: "\uCD94\uC704\uC640 \uBC30\uACE0\uD514\uC774 \uACB9\uCE5C \uBC24\uC774\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC758 \uAE30\uCE68\uC774 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563842
    m_Localized: "\uCD08\uACA8\uC6B8\uC758 \uBC24. \uC120\uC0DD\uB2D8\uC758 \uAE30\uCE68\uC774 \uBA70\uCE60\uC9F8 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563843
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uCCB4\uC628\uACC4\uB97C \uBCF4\uACE0 \uC5BC\uAD74\uC774 \uAD73\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563844
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: 39\uB3C4. \uC0C1\uCC98 \uC790\uB9AC\uAC00\u2026 \uB2E4\uC2DC \uBD89\uC5B4\uC84C\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563845
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544. \uACB0\uAD6D \uC654\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563846
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB180\uB77C\uC9C0 \uC54A\uC558\uB2E4. \uB9C8\uCE58 \uC624\uB798 \uAE30\uB2E4\uB9B0 \uC190\uB2D8\uC744 \uB9DE\uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563847
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD734\uBA74\uC774\uB77C\uACE0 \uD588\uC9C0. \uC7A0\uB4E4\uC5B4 \uC788\uB358 \uAC70\uC57C. \uADF8\uB0A0\uBD80\uD130 \uCB49."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563470
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC88B\uC740 \uCE5C\uAD6C\uAD6C\uB098. \uAF2D \uB2E4\uC2DC \uB9CC\uB098\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563469
    m_Localized: "\uB9D0\uD558\uB2E4 \uBCF4\uB2C8 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uB3C4 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563468
    m_Localized: "{0}: \uADF8 \uC77C, \uC81C\uAC00 \uCC98\uC74C\uC73C\uB85C \uB9D0\uD55C \uC0AC\uB78C\uC774\uC5D0\uC694. \uC544\uBB34\uAC83\uB3C4 \uBABB \uD574 \uC918\uC11C \uBBF8\uC548\uD558\uB2E4\uACE0 \uD588\uB294\uB370\u2026 \uC800\uB294 \uB4E4\uC5B4 \uC900 \uAC83\uB9CC\uC73C\uB85C \uC88B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563848
    m_Localized: "\uAD6C\uC870\uB300 \uBC29\uC1A1\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uBA38\uB9BF\uC18D\uC5D0\uC11C \uC6B8\uB838\uB2E4. \uAC10\uC5FC\uC790\uB294 \uD0D1\uC2B9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563849
    m_Localized: "\uCE58\uB8CC\uBC95\uC744 \uCC3E\uACA0\uB2E4\uACE0, \uC5B4\uB514\uB4E0 \uAC00\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563850
    m_Localized: "{0}: \uBC29\uBC95\uC774 \uC788\uC744 \uAC70\uC608\uC694. \uC815\uC218\uC7A5\uC774\uB4E0 \uBCD1\uC6D0\uC774\uB4E0, \uC81C\uAC00 \uCC3E\uC544\uC62C\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563851
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uB9D0\uB824\uB3C4 \uC548 \uB4E3\uACA0\uC9C0. \uADF8\uB7FC \uC57D\uC18D\uD574. \uC0B4\uC544\uC11C \uB3CC\uC544\uC628\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563852
    m_Localized: "\uACC1\uC5D0\uC11C \uB3CC\uBCF4\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563853
    m_Localized: "{0}: \uC81C\uAC00 \uC606\uC5D0 \uC788\uC744\uAC8C\uC694. \uC5F4 \uC7AC\uACE0, \uC57D \uCC59\uAE30\uACE0. \uBC15 \uC120\uC0DD\uB2D8\uD55C\uD14C \uB2E4 \uBC30\uC6B8\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563854
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB0B4 \uC190\uC744 \uAF2D \uC950\uC5C8\uB2E4. \uC190\uC774 \uB728\uAC70\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174896
    m_Localized: "\uD3B8\uC9C0\uB97C \uC811\uC5B4 \uB0B4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4. \uB3CC\uB824\uC8FC\uC9C0 \uC54A\uC558\uB2E4. \uC1A1\uC608\uC9C0\uB3C4 \uB2EC\uB77C\uACE0 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591989
    m_Localized: "{0}: \u2026\uB77C\uBA74\uC774\uC694. \uB728\uAC70\uC6B4 \uBB3C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563467
    m_Localized: "{0}: \uADF8\uB0A0\uB3C4 \uB5A1\uBCF6\uC774 \uBA39\uAE30\uB85C \uD588\uC5C8\uC5B4\uC694. \uC81C\uAC00 \uC0B0\uB2E4\uACE0 \uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563466
    m_Localized: "\uB5A1\uBCF6\uC774\uB97C \uC88B\uC544\uD558\uACE0, \uC2DC\uD5D8 \uC804\uB0A0\uC5D0\uB9CC \uACF5\uBD80\uD558\uACE0, \uC6C3\uC744 \uB54C \uCF54\uB97C \uCC21\uADF8\uB9AC\uB294 \uC560."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563465
    m_Localized: "{0}\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563464
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5\uC744 \uC7AC\uCD09\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC190\uC804\uB4F1\uC744 \uB044\uACE0, \uCC3D\uBC16 \uC5B4\uB460 \uCABD\uC73C\uB85C \uBAB8\uC744 \uB3CC\uB838\uB2E4. \uC5BC\uAD74\uC744 \uBCF4\uC9C0 \uC54A\uC544\uB3C4 \uB418\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563463
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: {0} \uC598\uAE30, \uD574 \uC904 \uC218 \uC788\uC5B4? \uAC00\uB054 \uC790\uB2E4\uAC00 \uADF8 \uC774\uB984\uC744 \uBD80\uB974\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563462
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: {0} \uC598\uAE30, \uD574 \uC904 \uC218 \uC788\uC5B4? \uB124\uAC00 \uC790\uAFB8 \uADF8 \uD559\uC0DD\uC99D\uC744 \uB9CC\uC9C0\uAE38\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563461
    m_Localized: "\uC5BC\uAD74\uC774 \uD655 \uB2EC\uC544\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563855
    m_Localized: "\uBAA8\uB450\uB97C \uC704\uD574 \uAC70\uB9AC\uB97C \uB450\uC790\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563856
    m_Localized: "\uC785\uC774 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4. \uBC29\uC1A1\uC2E4\uC5D0\uC11C \uC9C0\uB0B4\uC2DC\uB294 \uAC8C \uC88B\uACA0\uB2E4\uACE0. \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC744 \uC704\uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563857
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8\uAC8C \uB9DE\uB2E4. \uB124\uAC00 \uADF8 \uB9D0\uC744 \uD560 \uC218 \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563858
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC6C3\uC5C8\uB2E4. \uADF8 \uC6C3\uC74C\uC774 \uAC00\uC7A5 \uC544\uD320\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563859
    m_Localized: "\uBC24. \uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563860
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uACE0\uBC31\uD560 \uAC8C \uC788\uB2E4. \uB098\uB294 \uC54C\uACE0 \uC788\uC5C8\uC5B4. \uC5B8\uC820\uAC00 \uC774\uB807\uAC8C \uB420 \uC218 \uC788\uB2E4\uB294 \uAC78."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563861
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBB3C\uB9B0 \uB2E4\uB9AC\uB97C \uC798\uB77C \uB0B4\uACE0 \uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uB4E4 \uC911\uC5D0, \uBA87 \uB2EC \uB4A4\uC5D0 \uB2E4\uC2DC \uC544\uD508 \uC0AC\uB78C\uB4E4\uC774 \uC788\uC5C8\uAC70\uB4E0. \uC18C\uBB38\uC73C\uB85C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563862
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uC11C \uB108\uD55C\uD14C \uB354 \uB9CE\uC774 \uAC00\uB974\uCE58\uACE0 \uC2F6\uC5C8\uC5B4. \uB0B4\uAC00 \uC5C6\uC5B4\uB3C4 \uB124\uAC00 \uD63C\uC790 \uC124 \uC218 \uC788\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563863
    m_Localized: "\uB05D\uAE4C\uC9C0 \uAC19\uC774 \uAC00\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563460
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uBBF8 \uC4F0\uACE0 \uC788\uC5B4. \uB124 \uC77C\uAE30, \uAC00\uB054 \uC18C\uB9AC \uB0B4\uC11C \uC77D\uC796\uC544. \uB2E4 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757696
    m_Localized: "{0}: \uD63C\uC790 \uC11C\uB294 \uAC70 \uB9D0\uACE0, \uAC19\uC774 \uC11C\uB294 \uAC70 \uD560\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757697
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5 \uB300\uC2E0 \uB0B4 \uBA38\uB9AC\uB97C \uD5DD\uD074\uC5B4\uB728\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757698
    m_Localized: "\uB9D0\uC5C6\uC774 \uC190\uC744 \uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757699
    m_Localized: "\uD55C\uCC38\uC744 \uADF8\uB807\uAC8C \uC788\uC5C8\uB2E4. \uCC3D\uBC16\uC73C\uB85C \uCCAB\uB208 \uAC19\uC740 \uAC83\uC774 \uB0A0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757700
    m_Localized: "\uC65C \uC774\uC81C \uB9D0\uD588\uB0D0\uACE0 \uD654\uB97C \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757701
    m_Localized: "{0}: \uC65C \uC774\uC81C \uB9D0\uD574\uC694! \uBBF8\uB9AC \uC54C\uC558\uC73C\uBA74\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757702
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC54C\uC558\uC73C\uBA74 \uBB58 \uD560 \uC218 \uC788\uC5C8\uC744\uAE4C. \uADF8\uB798\uB3C4 \uB124 \uB9D0\uC774 \uB9DE\uB2E4. \uBBF8\uC548\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757703
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uCCA9\uC744 \uD3BC\uCCD0 \uBCF4\uC600\uB2E4. \uBA87 \uB2EC \uCE58 \uAE30\uB85D\uC774 \uBE7C\uACE1\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757704
    m_Localized: "\uB0A0\uC9DC, \uCCB4\uC628, \uC0C1\uCC98 \uC790\uB9AC\uC758 \uC0C9. \uC5EC\uB984 \uB0B4\uB0B4 \uAC19\uC740 \uC22B\uC790\uAC00 \uC774\uC5B4\uC9C0\uB2E4\uAC00, \uAC00\uC744 \uC5B4\uB290 \uB0A0\uBD80\uD130 \uC870\uAE08\uC529 \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563459
    m_Localized: "\uC800\uB3C4 \uADF8\uB7F0 \uAE00\uC744 \uC4F0\uACE0 \uC2F6\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563458
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uC120\uC0DD\uB2D8 \uC774\uB984\uC744 \uB9D0\uD574 \uC8FC\uC5C8\uB2E4. \uC9C0\uAE08\uC740 \uC5B4\uB514 \uACC4\uC2E4\uAE4C, \uD558\uACE0 \uD63C\uC7A3\uB9D0\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563457
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563456
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC8C \uCE6D\uCC2C\uC778 \uC904 \uBAB0\uB790\uB294\uB370, \uB098\uC911\uC5D0 \uBCF4\uB2C8\uAE4C \uC81C\uC77C \uC88B\uC740 \uCE6D\uCC2C\uC774\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757705
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC9C4\uD589\uC740 \uB290\uB824. \uBCF4\uD1B5 \uAC10\uC5FC\uACFC \uB2EC\uB77C. \uC758\uC2DD\uB3C4 \uB610\uB837\uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757706
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB0AE\uC5D0\uB294 \uAC00\uB77C\uC549\uACE0, \uBC24\uC5D0 \uC62C\uB77C\uAC00. \uC800\uAC83\uB4E4\uC774 \uB0AE\uC5D0 \uC7A0\uB4DC\uB294 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757707
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC57D\uC73C\uB85C \uB2A6\uCD9C \uC218\uB294 \uC788\uC744 \uAC70\uC57C. \uAC70\uAE30\uAE4C\uC9C0\uB294 \uB098\uB3C4 \uD655\uC2E0\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757708
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8 \uB108\uBA38\uB294\u2026 \uC815\uB9D0 \uBAA8\uB974\uACA0\uB2E4. \uB204\uAD70\uAC00 \uC5F0\uAD6C\uB97C \uD588\uB2E4\uBA74, \uADF8 \uAE30\uB85D\uC774 \uD544\uC694\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757709
    m_Localized: "{0}: \uBCF4\uAC74\uC2E4 \uC11C\uB78D\uC5D0\uC11C\u2026 \uC120\uC0DD\uB2D8 \uAC74\uAC15\uAC80\uC9C4 \uAE30\uB85D \uBD24\uC5B4\uC694. \uD608\uC561\uD615\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757710
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uADF8\uAC78 \uAE30\uC5B5\uD574 \uB480\uC5B4? \uC801\uC5B4 \uB458\uAC8C. \uC5B8\uC820\uAC00 \uC4F8\uBAA8\uAC00 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757711
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB38 \uB108\uBA38\uC5D0\uC11C \uC724 \uC120\uC0DD\uB2D8\uC774 \uB2E4 \uB4E3\uACE0 \uC788\uC5C8\uB2E4. \uBB34\uC804\uAE30\uC5D0\uC11C \uC791\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757712
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC15 \uC120\uC0DD\uB2D8 \uAE00\uC528 \uC608\uC058\uB2E4\uACE0, \uC804\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757713
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC790\uAE30 \uC598\uAE30\uB97C \uB0A8 \uC598\uAE30\uCC98\uB7FC \uB4E4\uC5C8\uB2E4. \uADF8\uB7EC\uB2E4 \uD55C \uBC88 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757714
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBC15 \uC120\uC0DD\uB2D8 \uAE00\uC528, \uC800\uBCF4\uB2E4 \uC608\uC058\uB124\uC694. \uAD6D\uC5B4 \uC120\uC0DD \uCCB4\uBA74\uC774 \uC548 \uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757715
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uC9C0\uAE08 \uADF8\uAC8C \uC911\uC694\uD574\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757716
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC911\uC694\uD558\uC8E0. \uAE30\uB85D\uC740 \uC77D\uD788\uB77C\uACE0 \uC4F0\uB294 \uAC70\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757717
    m_Localized: "DJ: \uC624\uB298\uC740 \uC0AC\uC5F0 \uD558\uB098 \uC77D\uC744\uAC8C\uC694. \uC544\uB2C8, \uC0AC\uC5F0\uC774\uB77C\uAE30\uBCF4\uB2E4\u2026 \uAE30\uC5B5\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757718
    m_Localized: "DJ: \uC0AC\uD0DC \uCD08\uBC18\uC5D0 \uC800\uD55C\uD14C \uBB34\uC804\uC774 \uC628 \uC801\uC774 \uC788\uC5B4\uC694. \uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9\uC5D0\uC11C \uC77C\uD558\uB358 \uC5F0\uAD6C\uC6D0\uC774\uB77C\uACE0 \uD588\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757719
    m_Localized: "DJ: \uD734\uBA74\uD558\uB294 \uAC10\uC5FC, \uB2E4\uC2DC \uAE68\uC5B4\uB098\uB294 \uAC10\uC5FC\uC5D0 \uB300\uD574 \uACC4\uC18D \uAE30\uB85D\uD558\uACE0 \uC788\uB2E4\uACE0. \uD639\uC2DC \uC790\uAE30\uAC00 \uC5F0\uB77D\uC774 \uB04A\uAE30\uBA74, \uAE30\uB85D\uC740 \uC5F0\uAD6C\uB3D9 \uC9C0\uD558\uC5D0 \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757720
    m_Localized: "DJ: \uADF8 \uC0AC\uB78C\uC774 \uB9C8\uC9C0\uB9C9\uC5D0 \uADF8\uB7AC\uC5B4\uC694. \uB0AE\uC5D0 \uC790\uACE0 \uBC24\uC5D0 \uAE68\uB294 \uAC74 \uC800\uAC83\uB4E4\uB9CC\uC774 \uC544\uB2C8\uB77C\uACE0. \uC0AC\uB78C \uBAB8\uC18D\uC5D0\uC11C\uB3C4 \uADF8\uB807\uAC8C \uC7A0\uB4E4\uC5B4 \uC788\uC744 \uC218 \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757721
    m_Localized: "DJ: \uADF8 \uB4A4\uB85C \uB2E4\uC2DC\uB294 \uC5F0\uB77D\uC774 \uC5C6\uC5C8\uC5B4\uC694. \uC65C \uC774 \uC598\uAE38 \uD558\uB0D0\uBA74\u2026 \uC694\uC998 \uB204\uAC00 \uACC4\uC18D \uC815\uC218\uC7A5 \uCABD\uC744 \uBB3B\uAE38\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806649757722
    m_Localized: "\uBB34\uC804\uAE30 \uC55E\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC758 \uC5F4\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB0AE\uC5D0\uB294 \uAC00\uB77C\uC549\uACE0, \uBC24\uC5D0 \uC624\uB974\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591894
    m_Localized: "???: \u2026\uAC70\uAE30, \uB204\uAD6C \uC788\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591895
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBB3C\uC790\uB97C \uCC3E\uB2E4\uAC00 \uC18C\uB9AC\uB97C \uB4E4\uC5C8\uC5B4. \uC77C\uC8FC\uC77C \uB3D9\uC548 \uD63C\uC790 \uC788\uC5C8\uB358 \uAC70\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591896
    m_Localized: "{0}: \u2026\uBC16\uC5D0, \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174989
    m_Localized: "\uCE74\uB808\uB77C\uC774\uC2A4, \uBBF8\uC5ED\uAD6D, \uAE4D\uB450\uAE30, \uC694\uAD6C\uB974\uD2B8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174988
    m_Localized: "\uC2A4\uD14C\uC778\uB9AC\uC2A4 \uC870\uB9AC\uB300 \uC704\uC5D0 \uC2DD\uD310\uC774 \uC0B0\uCC98\uB7FC \uC313\uC5EC \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uAE09\uC2DD \uBA54\uB274\uD310\uC774 \uBCBD\uC5D0 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174987
    m_Localized: "\uAE09\uC2DD\uC2E4 \uBB38\uC744 \uBC00\uC790 \uC624\uB798\uB41C \uAE30\uB984 \uB0C4\uC0C8\uC640 \uD568\uAED8 \uC11C\uB298\uD55C \uACF5\uAE30\uAC00 \uBC00\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174986
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB3C4\uC11C\uAD00 \uC5F4\uC1E0\uB294 \uAD50\uBB34\uC2E4 \uC5B4\uB518\uAC00\uC5D0 \uC788\uC744 \uAC70\uC57C. \uC5C6\uC73C\uBA74 \uBB38\uC744 \uB530\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174985
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uAC00\uB974\uCE5C \uBCF4\uB78C\uC774 \uC788\uB2E4. \uC544\uB2C8, \uC544\uC9C1 \uAC00\uB974\uCE5C \uAC83\uB3C4 \uBCC4\uB85C \uC5C6\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174984
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uB208\uC774 \uCEE4\uC84C\uB2E4\uAC00, \uC774\uB0B4 \uC6C3\uC74C\uC774 \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563616
    m_Localized: "{0}: \uC774\uC81C \uC548 \uB0B4\uC694. \uC9C0\uD0AC \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563617
    m_Localized: "\uAC15\uCCA0\uC774 \uBAA8\uC790\uB97C \uB2E4\uC2DC \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563618
    m_Localized: "\uAC15\uCCA0: \uADF8\uB798. \uADF8\uAC83\uB3C4 \uC6D0\uCE59\uC774\uC9C0. \uADF8\uB7FC \uC6B0\uB9AC\uB3C4 \uC6B0\uB9AC \uC6D0\uCE59\uB300\uB85C \uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563619
    m_Localized: "\uAD50\uBB38 \uC548\uCABD\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uBABB\uC73C\uB85C \uBC15\uD600 \uC788\uC5C8\uB2E4. \uBD89\uC740 \uB3D9\uADF8\uB77C\uBBF8 \uC548\uC758 \uC5D1\uC2A4, \uADF8\uB9AC\uACE0 \uD55C \uC904."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563620
    m_Localized: "'\uC0AC\uAC70\uB9AC\uB294 \uAE30\uC5B5\uD55C\uB2E4. \u2014 \uAC15\uCCA0'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563621
    m_Localized: "\uB204\uAD70\uAC00 \uBC24\uC0AC\uC774 \uAD50\uBB38\uC744 \uB118\uC5B4 \uB4E4\uC5B4\uC654\uB2E4 \uB098\uAC14\uB2E4\uB294 \uB73B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563622
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAC81\uC8FC\uB824\uB294 \uAC70\uC57C. \uADF8\uB9AC\uACE0\u2026 \uAC81\uC774 \uB098\uAE34 \uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563623
    m_Localized: "\uC790\uC7AC\uB97C \uC368\uC11C \uAD50\uBB38\uACFC \uB2F4\uC7A5\uC744 \uBCF4\uAC15\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563624
    m_Localized: "\uBC24\uB2A6\uAC8C\uAE4C\uC9C0 \uCCA0\uC870\uB9DD\uC744 \uB367\uB300\uACE0 \uAE61\uD1B5\uC744 \uB9E4\uB2EC\uC558\uB2E4. \uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uAE61\uD1B5\uC774 \uC6B8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563625
    m_Localized: "\uB2A6\uC5C8\uC9C0\uB9CC \uC2DD\uB7C9\uC744 \uBCF4\uB0B4 \uD654\uD574\uB97C \uCCAD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563626
    m_Localized: "\uD1B5\uC870\uB9BC \uC138 \uAC1C\uC640 \uCABD\uC9C0\uB97C \uC0AC\uAC70\uB9AC \uC815\uB958\uC7A5\uC5D0 \uB450\uACE0 \uC654\uB2E4. '\uD559\uAD50. \uC774\uBC88 \uACA8\uC6B8\uB9CC \uC870\uC6A9\uD788 \uC9C0\uB098\uAC00\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980534
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB098\uB3C4. \uAD50\uC0AC\uB294 \uC904 \uC138\uC6B0\uACE0 \uCC9C\uB9C9 \uCE58\uB290\uB77C \uB354 \uC2EB\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980535
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 \uC774\uC0C1\uD558\uC9C0. \uC2EB\uC5B4\uD558\uB358 \uAC83\uBD80\uD130 \uBCF4\uACE0 \uC2F6\uC5B4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980536
    m_Localized: "\uC885\uC774 \uC6B8\uB838\uC744 \uC2DC\uAC04\uC774 \uC9C0\uB098\uB3C4\uB85D, \uB458\uC740 \uCC3D\uAC00\uB97C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174956
    m_Localized: "\uC544\uAEF4 \uB450\uACE0, \uC624\uB298\uC740 \uBB3C\uB9CC \uD55C \uC794 \uB354 \uB9C8\uC2E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980537
    m_Localized: "\uBB38\uC5D0 \uB4F1\uC744 \uAE30\uB300\uACE0 \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4. \uBB38 \uB108\uBA38\uC758 \uC228\uC18C\uB9AC\uAC00 \uAC19\uC774 \uBE4C\uC5B4 \uC8FC\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980538
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uBA38\uB9AC\uB9E1\uC5D0 \uCEF5\uB77C\uBA74 \uD558\uB098\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uB3C4\uD604\uC774 \uC0C8\uBCBD\uC5D0 \uBAB0\uB798 \uAC16\uB2E4 \uB193\uC558\uB2E4\uACE0 \uD588\uB2E4. \uC120\uC0DD\uB2D8 \uC2EC\uBD80\uB984\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980539
    m_Localized: "\uB69C\uAED1\uC5D0 \uBCFC\uD39C\uC73C\uB85C \uC4F4 \uAE00\uC528. \uB5A8\uB9AC\uB294 \uAE00\uC528\uC600\uB2E4. '\uC0DD\uC77C \uCD95\uD558\uD574. \u2014 \uC724'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174957
    m_Localized: "\uCD08\uBCF5\uC774\uB77C\uB294 \uB9D0\uB9CC \uBA87 \uBC88 \uC785\uC5D0 \uAD74\uB824 \uBCF4\uC558\uB2E4. \uADF8\uAC83\uB9CC\uC73C\uB85C \uC870\uAE08 \uB35C \uB354\uC6B4 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980540
    m_Localized: "\uC120\uC0DD\uB2D8 \uC774\uBD88 \uACC1\uC5D0 \uC549\uC558\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uB208\uC744 \uB728\uACE0 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980541
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uBA38\uB9AC\uB9E1\uC5D0 \uCEF5\uB77C\uBA74 \uD558\uB098\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uB69C\uAED1\uC5D0 \uBCFC\uD39C\uC73C\uB85C \uC4F4 \uAE00\uC528."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980542
    m_Localized: "'\uC0DD\uC77C \uCD95\uD558\uD574. \u2014 \uC724'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174958
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC544\uCE68\uBD80\uD130 \uCE60\uD310\uC5D0 \uB0A0\uC9DC\uB97C \uD06C\uAC8C \uC37C\uB2E4. 8\uC6D4 15\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980543
    m_Localized: "{0}: \uC81C \uC0DD\uC77C\u2026 \uC5B4\uB5BB\uAC8C \uC544\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980544
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4 \uCEF4\uD4E8\uD130\uC5D0 \uBC18 \uB2F4\uC784\uC774 \uC815\uB9AC\uD574 \uB454 \uD30C\uC77C\uC774 \uC788\uB354\uB77C. \uB2E8\uD1A1\uBC29 \uC0DD\uC77C \uBAA9\uB85D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980545
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4 \uC11C\uB78D\uC5D0 \uBC18 \uB2F4\uC784\uC774 \uAC77\uC5B4 \uB454 \uAE30\uCD08 \uC870\uC0AC\uC11C\uAC00 \uC788\uB354\uB77C. \uC0DD\uC77C \uCE78\uC5D0 \uB124 \uAE00\uC528\uAC00 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174959
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uAD11\uBCF5\uC808. \uBE7C\uC557\uAE34 \uAC78 \uB418\uCC3E\uC740 \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980546
    m_Localized: "\uB2E8\uD1A1\uBC29 \uC0DD\uC77C \uBAA9\uB85D. \uADF8\uB0A0 \uC544\uCE68, {0} \uB9CC\uB4E4\uACA0\uB2E4\uACE0 \uD588\uB358 \uADF8 \uBAA9\uB85D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980547
    m_Localized: "{0} \uB0A8\uC758 \uC0DD\uC77C\uC744 \uB9E8\uB0A0 \uAE4C\uBA39\uC5C8\uB2E4. \uC62C\uD574\uB294 \uAE30\uC5B5\uD558\uACE0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980548
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCD1B\uBD88\uC740 \uC5C6\uC9C0\uB9CC. \uC18C\uC6D0\uC740 \uBE4C\uC5B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980549
    m_Localized: "\uBB3C\uC744 \uB053\uC5EC \uCEF5\uB77C\uBA74\uC744 \uBC18\uC529 \uB098\uB220 \uBA39\uC5C8\uB2E4. \uAD6D\uBB3C\uAE4C\uC9C0 \uB2E4 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174960
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6D\uC5B4 \uC2DC\uAC04\uC5D0 \uC774\uB7F0 \uC2DC\uB97C \uBC30\uC6E0\uC5B4. \uBE7C\uC557\uAE34 \uB4E4\uC5D0\uB3C4 \uBD04\uC740 \uC624\uB294\uAC00, \uD558\uACE0 \uBB3B\uB294 \uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980550
    m_Localized: "\uB208\uC744 \uAC10\uACE0 \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uBB34\uC2A8 \uC18C\uC6D0\uC774\uB0D0\uACE0 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980551
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uB144 \uC0DD\uC77C\uC5D4, \uCF00\uC774\uD06C\uB85C \uD558\uC790. \uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980552
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC65C \uD559\uAD50\uC5D0 \uB0A8\uC558\uB0D0\uACE0? \u2026\uADF8\uB0A0 \uAD50\uBB34\uC2E4\uC5D0 \uB0A8\uC740 \uC0AC\uB78C\uC774 \uB098\uBC16\uC5D0 \uC5C6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980553
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB4E4 \uC544\uC774\uB4E4 \uB370\uB9AC\uB7EC \uC9D1\uC73C\uB85C \uAC14\uC9C0. \uB098\uB294 \uB370\uB9AC\uB7EC \uAC08 \uC0AC\uB78C\uC774 \uC5C6\uC5C8\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980554
    m_Localized: "{0}: \uAC00\uC871\uC740\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980555
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC7A0\uAE50 \uCC3D \uCABD\uC744 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174961
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC2DC\uB97C \uB2E4 \uC678\uC6CC \uC74A\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uCC3D\uBC16\uC744 \uBCF4\uBA70 \uD55C \uC904\uB9CC \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980556
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uC598\uAE30\uB294, \uC5B8\uC820\uAC00. \uC624\uB298\uC740 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980557
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798\uC11C \uB0A8\uC558\uC5B4. \uD639\uC2DC \uB0A8\uC740 \uC544\uC774\uAC00 \uC788\uC744\uAE4C \uBD10. \uACB0\uAD6D \uCC3E\uC740 \uAC74 \uB108 \uD558\uB098\uC600\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980558
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8\uAC78\uB85C \uCDA9\uBD84\uD558\uB2E4\uB294 \uB4EF \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980559
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uC0C1\uD558\uC9C0. \uD55C \uBA85\uC744 \uCC3E\uC558\uB294\uB370, \uAF2D \uBC18 \uC804\uCCB4\uB97C \uCC3E\uC740 \uAC83 \uAC19\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980560
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uC2DC \uD55C \uAD6C\uC808 \uC54C\uB824 \uC904\uAE4C. \uC218\uC5C5 \uB54C \uC4F0\uB824\uACE0 \uC544\uAEF4 \uB454 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980561
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uB85C \uC9E7\uC740 \uC2DC\uB97C \uC74A\uC5C8\uB2E4. \uBD04\uC774 \uC624\uBA74, \uC774\uB77C\uB294 \uB9D0\uB85C \uC2DC\uC791\uD558\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174962
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2F5\uC740 \uC2DC \uC548\uC5D0 \uC788\uC5B4. \uBD04\uC740 \uC640. \uB4E4\uC744 \uB2E4\uC2DC \uCC3E\uC73C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980562
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uCCAB \uBC1C\uB839 \uBC1B\uB358 \uD574\uC5D0 \uAC00\uB974\uCE5C \uC2DC\uC57C. \uADF8\uD574 \uC544\uC774\uB4E4\uC740 \uB2E4 \uC878\uC558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980563
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7F0\uB370 \uD55C \uBA85\uC774 \uC878\uC5C5\uD558\uACE0 \uD3B8\uC9C0\uB97C \uBCF4\uB0C8\uC5B4. \uB2E4\uB978 \uAC74 \uB2E4 \uC78A\uC5C8\uB294\uB370 \uADF8 \uAD6C\uC808\uB9CC \uAE30\uC5B5\uB09C\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980564
    m_Localized: "\uB530\uB77C\uC11C \uC678\uC6CC \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369216
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB0B4 \uD314\uB85C \uD574. \uC138\uAC8C \uAC10\uC73C\uBA74 \uC138\uAC8C \uAC10\uC558\uB2E4\uACE0 \uB9D0\uD574 \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369217
    m_Localized: "\uC555\uBC15 \uBD95\uB300, \uC9C0\uD608\uC810, \uBD80\uBAA9. \uBC15 \uC120\uC0DD\uB2D8\uC758 \uC190\uC740 \uBE60\uB974\uACE0 \uC815\uD655\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369218
    m_Localized: "\uB450 \uBC88\uC9F8 \uBD95\uB300\uB294 \uB108\uBB34 \uB290\uC2A8\uD588\uACE0, \uC138 \uBC88\uC9F8\uB294 \uB108\uBB34 \uC870\uC600\uB2E4. \uB124 \uBC88\uC9F8\uC5D0\uC11C \uBC15 \uC120\uC0DD\uB2D8\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369219
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC798\uD558\uB124. \uC190\uC774 \uCC28\uBD84\uD574. \uC758\uC0AC\uB4E4\uC774 \uC81C\uC77C \uBD80\uB7EC\uC6CC\uD558\uB294 \uAC8C \uADF8\uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369220
    m_Localized: "\uCC98\uC74C \uB4E3\uB294 \uCE6D\uCC2C\uC774\uB77C \uC5B4\uB5A4 \uD45C\uC815\uC744 \uC9C0\uC5B4\uC57C \uD560\uC9C0 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369221
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uD558\uB098\uB9CC \uAE30\uC5B5\uD574. \uB2E4\uCE5C \uC0AC\uB78C\uBCF4\uB2E4 \uB124\uAC00 \uBA3C\uC800 \uAC81\uBA39\uC73C\uBA74 \uC548 \uB3FC. \uAC81\uC740 \uB098\uC911\uC5D0, \uB2E4 \uB05D\uB098\uACE0 \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369222
    m_Localized: "\uAD6C\uC11D\uC5D0\uC11C \uC9C0\uCF1C\uBCF4\uB358 \uC724 \uC120\uC0DD\uB2D8\uC774 \uC791\uAC8C \uBC15\uC218\uB97C \uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369223
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uC74C \uC2DC\uAC04\uC5D4 \uB0B4\uAC00 \uD658\uC790 \uC5ED \uD560\uAC8C. \uC5F0\uAE30\uB294 \uC790\uC2E0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369224
    m_Localized: "\uC8FC\uBA38\uB2C8 \uC18D \uD559\uC0DD\uC99D\uC774 \uACC4\uC18D \uC190\uC5D0 \uB2FF\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369225
    m_Localized: "\uD559\uAD50\uB85C \uB3CC\uC544\uC640\uC11C\uC57C \uAEBC\uB0B4 \uBCFC \uC218 \uC788\uC5C8\uB2E4. \uC0AC\uC9C4 \uC18D {0}\uB294 \uC55E\uBA38\uB9AC\uAC00 \uC870\uAE08 \uC090\uB6A4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174914
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uAC74\uC744 \uC9DC\uB358 \uC190\uC744 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369226
    m_Localized: "\uADF8 \uC815\uB958\uC7A5\uC744 \uC9C0\uB098\uC628 \uB4A4\uB85C \uACC4\uC18D \uAC19\uC740 \uC7A5\uBA74\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB04A\uC5B4\uC9C4 \uAC00\uBC29\uB048. \uAE68\uC9C4 \uD654\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369227
    m_Localized: "\uD559\uC0DD\uC99D\uC744 \uC8FC\uC6CC \uC624\uC9C0 \uBABB\uD55C \uC190\uC774 \uC790\uAFB8 \uC8FC\uBA39\uC744 \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369228
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68, \uB5A1\uBCF6\uC774\uB97C \uBA39\uC790\uACE0 \uD588\uB358 \uBAA9\uC18C\uB9AC\uAC00 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369229
    m_Localized: "'\uB2E4\uC74C\uC5D0 \uAC00\uC790'\uACE0 \uD588\uB358 \uB0B4 \uBAA9\uC18C\uB9AC\uB3C4. \uB2E4\uC74C\uC774 \uC788\uC744 \uC904 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369230
    m_Localized: "\uBA3C\uC800 \uAC74\uB108 \uBC84\uB9B0 \uD6A1\uB2E8\uBCF4\uB3C4. \uADF8 \uC544\uCE68, \uD55C \uBC88\uB3C4 \uB4A4\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369231
    m_Localized: "'\uAD1C\uCC2E\uC544' \uD558\uACE0 \uC6C3\uB358 \uB0B4 \uC5BC\uAD74\uC744, {0} \uADF8\uB0A0 \uC5B4\uB5A4 \uB208\uC73C\uB85C \uBD24\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369232
    m_Localized: "\uADF8 \uBB34\uB9AC\uB97C \uB9C8\uC8FC \uBCF4\uB358 \uC544\uCE68, \uB0B4 \uC18C\uB9E4\uB97C \uBD99\uC7A1\uB358 {0}\uC758 \uC190\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369233
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0 \uC606\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369234
    m_Localized: "\uC18C\uB9AC \uB0B4\uC5B4 \uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369235
    m_Localized: "\uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC \uB0B4\uC11C \uC6B8\uC5C8\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uB4F1\uC744 \uCC9C\uCC9C\uD788 \uB450\uB4DC\uB824 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369236
    m_Localized: "\uB2E4 \uC6B8\uACE0 \uB098\uB2C8 \uBC30\uAC00 \uACE0\uD320\uB2E4. \uADF8\uAC8C \uC774\uC0C1\uD558\uAC8C \uB2E4\uD589\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369237
    m_Localized: "\uC77C\uAE30\uC7A5\uC5D0 {0}\uC5D0\uAC8C \uD3B8\uC9C0\uB97C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369238
    m_Localized: "\uBCF4\uB0BC \uC218 \uC5C6\uB294 \uD3B8\uC9C0. \uADF8\uB798\uB3C4 \uC4F0\uB294 \uB3D9\uC548\uC740 \uAC19\uC774 \uC788\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369239
    m_Localized: "\uC544\uBB34\uB807\uC9C0 \uC54A\uC740 \uCC99\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369240
    m_Localized: "{0}: \uAD1C\uCC2E\uC544\uC694. \uADF8\uB0E5 \uBB3C\uAC74\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369241
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uADF8\uB0A0 \uBC24 \uB0B4 \uB2F4\uC694\uB97C \uD55C \uC7A5 \uB354 \uB36E\uC5B4 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369242
    m_Localized: "\uBC24. \uB3C4\uC11C\uAD00\uC5D0\uC11C \uAC00\uC838\uC628 \uC2DC\uB0B4 \uC9C0\uB3C4\uB97C \uD3BC\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369243
    m_Localized: "\uD559\uAD50\uC5D0\uC11C \uC2ED \uBD84 \uAC70\uB9AC\uC5D0 \uC0C8\uBCBD\uC5ED\uC774 \uC788\uC5C8\uB2E4. \uC9C0\uD558 2\uCE35, \uB300\uD569\uC2E4\uACFC \uC2B9\uAC15\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369244
    m_Localized: "\uC9C0\uB3C4 \uADC0\uD241\uC774 \uB178\uC120\uB3C4\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uB530\uB77C\uAC00 \uBCF4\uC558\uB2E4. \uC138 \uC815\uAC70\uC7A5\uC774\uBA74 \uC2DC\uCCAD, \uB2E4\uC12F \uC815\uAC70\uC7A5 \uB05D\uC774 \uC815\uC218\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369245
    m_Localized: "{0}: \uC911\uD559\uAD50 \uB54C \uC774\uAC70 \uD0C0\uACE0 \uD559\uC6D0 \uB2E4\uB154\uC5B4\uC694. \uB9E8 \uC55E \uCE78\uC5D0 \uD0C0\uBA74 \uD130\uB110\uC774 \uBCF4\uC5EC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174913
    m_Localized: "\uB3C4\uD604\uC774 \uC7A0\uACB0\uC5D0 \uBB34\uC5B8\uAC00 \uC911\uC5BC\uAC70\uB838\uB2E4. \uC5C4\uB9C8, \uB77C\uACE0 \uD588\uB2E4. \uB450 \uBC88."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369246
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC9C0\uD558\uCCA0\uC5ED\uC774\uB77C\u2026 \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uC774 \uD53C\uD588\uB358 \uACF3\uC774\uC57C. \uADF8\uB9CC\uD07C \uB9CE\uC774 \uB0A8\uC544 \uC788\uACA0\uC9C0. \uC0AC\uB78C\uC774\uB4E0, \uC544\uB2C8\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369247
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5ED\uBB34\uC2E4\uC774\uB098 \uB9E4\uC810\uC5D0\uB294 \uC4F8 \uB9CC\uD55C \uAC8C \uC788\uC744 \uAC70\uC57C. \uB0AE\uC5D0\uB3C4 \uC5B4\uB450\uC6B0\uB2C8\uAE4C \uC190\uC804\uB4F1\uC740 \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369248
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0 \uACC4\uB2E8. \uB0B4\uB824\uAC00\uB294 \uACC4\uB2E8\uC740 \uD558\uB098\uC5EC\uB3C4, \uC62C\uB77C\uC624\uB294 \uACC4\uB2E8\uC740 \uB450 \uAC1C \uC774\uC0C1 \uBD10 \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369249
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC9C0\uB3C4 \uC704 \uC0C8\uBCBD\uC5ED\uC5D0 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uCCE4\uB2E4. \uADF8 \uC606\uC5D0 \uC791\uAC8C, '\uB098\uC624\uB294 \uAE38 \uBA3C\uC800'."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369250
    m_Localized: "\uC7AC\uC0DD \uBC84\uD2BC\uC744 \uB204\uB974\uC790 \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC \uB05D\uC5D0 \uCC28\uBD84\uD55C \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369251
    m_Localized: "\uBC29\uC1A1\uBD80\uC5D0\uC11C \uC4F0\uB358 \uAC83\uACFC \uAC19\uC740 \uAE30\uC885\uC774\uC5C8\uB2E4. \uC74C\uB7C9\uC744 \uB0AE\uCD94\uACE0 \uC7A1\uC74C \uD544\uD130\uB97C \uCF1C\uC790 \uBAA9\uC18C\uB9AC\uAC00 \uC870\uAE08 \uB610\uB837\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369252
    m_Localized: "\uC548\uB0B4 \uBC29\uC1A1: \uC2B9\uAC1D \uC5EC\uB7EC\uBD84\uAED8 \uC54C\uB824 \uB4DC\uB9BD\uB2C8\uB2E4. \uD604\uC7AC \uC2DC \uC804\uC5ED\uC5D0\u2026 \uBC1C\uC5F4 \uC99D\uC0C1\uC774 \uC788\uB294 \uBD84\uC740 \uC5F4\uCC28 \uD0D1\uC2B9\uC744\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369253
    m_Localized: "\uC548\uB0B4 \uBC29\uC1A1: \u2026\uC815\uC218\uC7A5 \uBC29\uD5A5 \uC5F4\uCC28\uB294 \uC6B4\uD589\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uBC18\uBCF5\uD569\uB2C8\uB2E4. \uC815\uC218\uC7A5 \uBC29\uD5A5\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369254
    m_Localized: "\uBAA9\uC18C\uB9AC\uB294 \uAC70\uAE30\uC11C \uB04A\uACBC\uB2E4. \uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uBB34\uC5B4\uB77C \uC678\uCE58\uB294 \uC18C\uB9AC\uAC00 \uC9E7\uAC8C \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369255
    m_Localized: "\uB3CC\uC544\uC640\uC11C \uC774\uC57C\uAE30\uD558\uC790 \uC120\uC0DD\uB2D8\uC774 \uC624\uB798 \uC0DD\uAC01\uC5D0 \uC7A0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369256
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC815\uC218\uC7A5 \uBC29\uD5A5\uC774\uB77C\u2026 \uC65C \uD558\uD544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369257
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uD559\uAD50\uC5D0 \uC624\uB294 \uB0B4\uB0B4 \uD55C\uB9C8\uB514\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB0B4 \uB4A4\uB97C \uBC18 \uBC1C\uC9DD \uB5A8\uC5B4\uC838 \uAC78\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369258
    m_Localized: "\uC608\uC804 \uAC19\uC73C\uBA74 \uAC78\uC74C\uC744 \uC7AC\uCD09\uD588\uC744 \uAC83\uC774\uB2E4. \uB4A4\uC5D0\uC11C \uB530\uB77C\uC624\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uC2EB\uC5B4\uC11C. \uC774\uBC88\uC5D4 \uC18D\uB3C4\uB97C \uBC14\uAFB8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369259
    m_Localized: "\uB9D0\uC774 \uC5C6\uB294 \uAC8C \uC5B4\uC0C9\uD574\uC11C, \uD558\uB9C8\uD130\uBA74 \uB18D\uB2F4\uC744 \uD560 \uBED4\uD588\uB2E4. \uD558\uC9C0 \uC54A\uC558\uB2E4. \uC9C0\uAE08\uC740 \uC6C3\uC744 \uB54C\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369260
    m_Localized: "\uAC00\uB054 \uB4A4\uB97C \uB3CC\uC544 \uADF8 \uC560\uB97C \uBD24\uB2E4. \uADF8 \uC560\uB294 \uADF8\uB54C\uB9C8\uB2E4 \uB208\uC744 \uB0B4\uB9AC\uAE54\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369261
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0\uC11C \uADF8 \uC560\uAC00 \uCC98\uC74C \uC785\uC744 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369262
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uB098, \uB4E4\uC5B4\uAC00\uB3C4 \uB3FC? \uC815\uB9D0\uB85C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369263
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uC774\uCABD\uC744 \uBCF4\uC558\uB2E4. \uC774\uBC88\uC5D0\uB3C4 \uB124\uAC00 \uC815\uD558\uB77C\uB294 \uB208\uBE5B\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369264
    m_Localized: "\uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB3C4 \uB41C\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174912
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBB3C\uB9B0 \uAC74 \uC544\uB2C8\uC57C. \uADF8\uB0E5 \uC5EC\uB984 \uAC10\uAE30. \uC560\uB4E4\uC740 \uC6D0\uB798 \uC774\uB807\uAC8C \uB053\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369265
    m_Localized: "{0}: \uADDC\uCE59\uC740 \uC9C0\uCF1C. \uADF8\uAC70\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369266
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uB208\uC744 \uB9C8\uC8FC\uCE58\uC9C0\uB294 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369267
    m_Localized: "\uADF8\uB0A0 \uBC24\uC740 \uC7A0\uC774 \uC798 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369268
    m_Localized: "\uBB3C\uC790\uB97C \uB098\uB220 \uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369269
    m_Localized: "{0}: \uC5EC\uAE30\uB294 \uC548 \uB3FC. \uBBF8\uC548\uD574. \u2026\uC544\uB2C8, \uBBF8\uC548\uD558\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369270
    m_Localized: "\uD1B5\uC870\uB9BC \uC138 \uAC1C\uB97C \uAC74\uB138\uB2E4. \uC1A1\uC608\uC9C0\uB294 \uBC1B\uC544 \uB4E4\uACE0 \uD55C\uCC38 \uC11C \uC788\uB2E4\uAC00 \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369271
    m_Localized: "\uC9C0\uD558\uCCA0\uC5ED\uC5D0\uC11C \uBCF8 \uC5BC\uAD74\uC774 \uACC4\uC18D \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369272
    m_Localized: "\uADF8 \uBB34\uB9AC \uC606\uC5D0 \uB298 \uC11C \uC788\uB358 \uC544\uC774. \uC6C3\uC9C0\uB3C4, \uB9D0\uB9AC\uC9C0\uB3C4 \uC54A\uB358 \uC544\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369273
    m_Localized: "\uADF8 \uC560 \uC0DD\uAC01\uC744 \uC77C\uAE30\uC5D0 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369274
    m_Localized: "\uBBF8\uC6CC\uD558\uB294 \uB9C8\uC74C\uACFC \uBD88\uC30D\uD55C \uB9C8\uC74C\uC774 \uD55C \uD398\uC774\uC9C0\uC5D0 \uAC19\uC774 \uC801\uD614\uB2E4. \uC9C0\uC6B0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174911
    m_Localized: "\uBC24\uC0C8 \uB3C4\uD604\uC758 \uC5F4\uC774 \uB0B4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC816\uC740 \uC218\uAC74\uC744 \uBA87 \uBC88\uC774\uACE0 \uAC08\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369275
    m_Localized: "\uBC24. \uAE09\uC2DD\uC2E4\uC5D0\uC11C \uBB3C\uC744 \uB9C8\uC2DC\uB294\uB370 \uC1A1\uC608\uC9C0\uAC00 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369276
    m_Localized: "\uC1A1\uC608\uC9C0: \uD560 \uB9D0\uC774 \uC788\uC5B4. \u2026\uB4E3\uAE30 \uC2EB\uC73C\uBA74 \uC548 \uB4E4\uC5B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369277
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8\uB54C, \uB098 \uB2E4 \uBD24\uC5B4. \uCC3D\uACE0 \uBB38 \uB2EB\uB294 \uAC83\uB3C4. \uB108 \uC548\uC5D0\uC11C \uBB38 \uB450\uB4DC\uB9AC\uB294 \uC18C\uB9AC\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369278
    m_Localized: "\uC1A1\uC608\uC9C0: \uBB34\uC11C\uC6E0\uC5B4. \uD558\uB9B0\uC774\uD55C\uD14C \uCC0D\uD788\uB294 \uAC8C. \uADF8\uB798\uC11C \uADF8\uB0E5\u2026 \uC9D1\uC5D0 \uAC14\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369279
    m_Localized: "\uC1A1\uC608\uC9C0: \uB108 \uB298 \uC6C3\uC5C8\uC796\uC544. \uC6B0\uB9AC\uAC00 \uBB58 \uD574\uB3C4. \u2026\uAD1C\uCC2E\uC740 \uC904 \uC54C\uC558\uB358 \uAC8C \uC544\uB2C8\uC57C. \uAD1C\uCC2E\uC740 \uC904 \uC54C\uACE0 \uC2F6\uC5C8\uB358 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369280
    m_Localized: "\uC6C3\uC74C\uC740 \uB0B4\uAC00 \uBC84\uD2F0\uB358 \uBC29\uBC95\uC774\uC5C8\uB2E4. \uB204\uAD6C\uC5D0\uAC8C \uB0B4\uC900 \uD5C8\uB77D\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uADF8 \uC560\uB3C4 \uADF8\uAC78 \uC544\uB294 \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369281
    m_Localized: "\uC1A1\uC608\uC9C0: \uB108\uB294 \uC885 \uCE58\uBA74 \uC81C\uC77C \uBA3C\uC800 \uB098\uAC14\uC796\uC544. \uB530\uB77C\uAC00\uC11C \uB9D0 \uAC78 \uD2C8\uC774 \uC5C6\uC5C8\uC5B4. \u2026\uC544\uB2C8, \uC774\uAC83\uB3C4 \uD551\uACC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369282
    m_Localized: "\uC1A1\uC608\uC9C0: \uADF8\uB0A0 \uC544\uCE68, \uB124\uAC00 \uADF8 \uC560\uB4E4 \uCCD0\uB2E4\uBCFC \uB54C. \uB098\uB791\uB3C4 \uB208 \uB9C8\uC8FC\uCCE4\uC5B4. \uB0B4\uAC00 \uBA3C\uC800 \uD53C\uD588\uC5B4. \uADF8\uAC8C \uC81C\uC77C \uBA3C\uC800 \uC0DD\uAC01\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369283
    m_Localized: "\uC1A1\uC608\uC9C0: \uD558\uB9B0\uC774\uB294 \uC0B4\uC544 \uC788\uC5B4. \uB9C8\uD2B8 \uCABD\uC5D0 \uC5B4\uB978\uB4E4\uC774\uB791 \uAC19\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369284
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369285
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uC6B8\uAE30 \uC2DC\uC791\uD588\uB2E4. \uB098\uB294 \uC6B8\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174910
    m_Localized: "\uC1A1\uC608\uC9C0: \uB098\uAC00\uB294 \uAC74 \uB124\uAC00 \uD558\uB2C8\uAE4C. \uAE38\uC774\uB77C\uB3C4 \uB0B4\uAC00 \uADF8\uB9B4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369286
    m_Localized: "{0}: \uC6A9\uC11C\uD55C\uB2E4\uB294 \uB9D0\uC740 \uBABB \uD574. \uC544\uC9C1\uC740. \uADF8\uB798\uB3C4 \uB4E4\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369287
    m_Localized: "\uC544\uC9C1\uC740 \uB4E3\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369288
    m_Localized: "{0}: \uB098\uC911\uC5D0. \uB0B4\uAC00 \uC900\uBE44\uB418\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369289
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0 \uBA3C\uC800 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369290
    m_Localized: "\uB2E4\uC2DC\uB294 \uADF8 \uC598\uAE30 \uD558\uC9C0 \uB9D0\uB77C\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369291
    m_Localized: "\uCEF5\uC744 \uB0B4\uB824\uB193\uB294 \uC18C\uB9AC\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369292
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369293
    m_Localized: "\uC790\uB9AC\uB97C \uB728\uB824\uB2E4, \uBB38 \uC55E\uC5D0\uC11C \uAC78\uC74C\uC744 \uBA48\uCD98\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369294
    m_Localized: "\uCEF5\uC744 \uB0B4\uB824\uB193\uACE0 \uC77C\uC5B4\uC130\uB2E4. \uBC1C\uC774 \uBA3C\uC800 \uBB38 \uCABD\uC73C\uB85C \uAC14\uB2E4. \uB298 \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369295
    m_Localized: "\uBB38\uACE0\uB9AC\uB97C \uC7A1\uACE0\uC11C\uC57C \uBA48\uCDC4\uB2E4. \uB3CC\uC544\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369296
    m_Localized: "{0}: \u2026\uB9C8\uC800 \uD574. \uC5EC\uAE30 \uC11C\uC11C \uB4E4\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174909
    m_Localized: "\uC9C0\uB3C4 \uC704\uC5D0 \uB2E4\uC74C \uD0D0\uD5D8 \uACBD\uB85C\uB97C \uADF8\uB838\uB2E4. \uB3CC\uC544\uC624\uB294 \uAE38\uC744 \uB450 \uAC1C\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369297
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uB9D0\uC744 \uC774\uC5C8\uB2E4. \uB098\uB294 \uBB38 \uC55E\uC5D0 \uC120 \uCC44 \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369298
    m_Localized: "\uB098\uAC08 \uBB38\uC774 \uB4F1 \uB4A4\uC5D0 \uC788\uB2E4\uB294 \uAC78 \uC54C\uC544\uC11C, \uC624\uD788\uB824 \uB05D\uAE4C\uC9C0 \uB4E4\uC744 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369299
    m_Localized: "\uBC24\uC0C8 \uBC14\uB78C\uC774 \uD559\uAD50\uB97C \uD754\uB4E4\uC5C8\uB2E4. \uD0DC\uD48D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369300
    m_Localized: "\uAD50\uC2E4 \uCC3D\uBB38 \uD558\uB098\uAC00 \uAE68\uC9C0\uBA74\uC11C \uBE57\uBB3C\uC774 \uB4E4\uC774\uCCE4\uB2E4. \uBC14\uB9AC\uCF00\uC774\uB4DC \uD55C\uCABD\uC774 \uBB34\uB108\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369301
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2E4\uB4E4 \uAD1C\uCC2E\uC544? \uCC3D\uAC00\uC5D0\uC11C \uB5A8\uC5B4\uC838!"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369302
    m_Localized: "\uBC24\uC0C8 \uBB34\uB108\uC9C4 \uACF3\uC744 \uB9C9\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369303
    m_Localized: "\uC816\uC740 \uCC45\uC0C1\uC744 \uB2E4\uC2DC \uC313\uACE0 \uB048\uC73C\uB85C \uBB36\uC5C8\uB2E4. \uD574 \uB730 \uBB34\uB835\uC5D0\uC57C \uACA8\uC6B0 \uB05D\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369304
    m_Localized: "\uBAA8\uB450 \uCCB4\uC721\uAD00\uC73C\uB85C \uD53C\uC2E0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369305
    m_Localized: "\uB450\uAEBC\uC6B4 \uCCB4\uC721\uAD00 \uBCBD \uB108\uBA38\uB85C \uBC14\uB78C \uC18C\uB9AC\uAC00 \uBA40\uAC8C \uB4E4\uB838\uB2E4. \uB9E4\uD2B8 \uC704\uC5D0 \uBAA8\uC5EC \uC549\uC544 \uC544\uCE68\uC744 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369306
    m_Localized: "\uB2F4\uC694\uB97C \uB4A4\uC9D1\uC5B4\uC4F0\uACE0 \uC9C0\uB098\uAC00\uAE30\uB97C \uAE30\uB2E4\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369307
    m_Localized: "\uBB34\uC11C\uC6E0\uB2E4. \uADF8\uB798\uB3C4 \uC606\uC5D0 \uB204\uAD70\uAC00\uC758 \uC5B4\uAE68\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174908
    m_Localized: "\uB3D9\uB124 \uC9C0\uB3C4\uB85C \uC4F4\uB2E4. \uAC08 \uAE38\uC744 \uBBF8\uB9AC \uADF8\uB824 \uBCF4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369308
    m_Localized: "\uD0DC\uD48D\uC774 \uC9C0\uB098\uAC04 \uB2E4\uC74C \uB0A0 \uBC24. \uD759\uD0D5\uBB3C\uC5D0 \uC4F8\uB824 \uC628 \uAC83\uB4E4\uC774 \uD559\uAD50 \uB2F4\uC7A5 \uC544\uB798\uB85C \uBAA8\uC5EC\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369309
    m_Localized: "\uBB34\uB108\uC9C4 \uB2F4\uC7A5 \uD2C8\uB9C8\uB2E4 \uADF8\uB9BC\uC790\uAC00 \uD558\uB098\uC529 \uAC78\uB824 \uC788\uC5C8\uB2E4. \uC816\uC740 \uC637\uC790\uB77D\uC774 \uBB34\uAC81\uAC8C \uB04C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174907
    m_Localized: "\uADF8\uB0A0 \uC624\uD6C4, \uD45C\uC2DC\uD55C \uACF3\uC744 \uD558\uB098\uC529 \uB9C9\uC558\uB2E4. \uC1A1\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C '\uC6B0\uB9AC'\uB77C\uB294 \uB9D0\uC744 \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369310
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC18C\uB9AC\uB97C \uB4E3\uACE0 \uC628 \uAC70\uC57C. \uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uC57D\uD574\uC9C4 \uAC78 \uC544\uB294 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369311
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298 \uBC24\uC774 \uACE0\uBE44\uB2E4. \uB2E4\uB4E4, \uC81C\uC790\uB9AC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369312
    m_Localized: "\uB3C4\uD604\uC774 \uC190\uC804\uB4F1\uC744 \uC950\uACE0 \uCC3D\uAC00\uB85C \uAC14\uB2E4. \uC5F0\uC2B5\uD55C \uC2E0\uD638\uB97C \uC785\uC18D\uC73C\uB85C \uB418\uB1CC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369313
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBD95\uB300\uC640 \uC18C\uB3C5\uC57D\uC744 \uCC45\uC0C1 \uC704\uC5D0 \uD55C \uC904\uB85C \uB298\uC5B4\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369314
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uB2E4\uCE58\uBA74 \uBC14\uB85C \uC640. \uCC38\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369315
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uCC45\uC0C1 \uD558\uB098\uB97C \uB354 \uBC00\uC5B4 \uBB38 \uC55E\uC5D0 \uBD99\uC600\uB2E4. \uB204\uAC00 \uC2DC\uD0A4\uAE30 \uC804\uC5D0 \uC6C0\uC9C1\uC778 \uAC74 \uCC98\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369316
    m_Localized: "\uBB38\uC774 \uC6B8\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4. \uBD04\uC758 \uADF8 \uBC24\uBCF4\uB2E4 \uBB34\uAC81\uACE0, \uB290\uB9AC\uACE0, \uB048\uC9C8\uAE34 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369317
    m_Localized: "\uC816\uC740 \uCC45\uC0C1 \uB354\uBBF8\uAC00 \uD55C \uBF18\uC529 \uBC00\uB838\uB2E4\uAC00, \uB2E4\uC2DC \uBC00\uB824 \uB4E4\uC5B4\uAC14\uB2E4. \uADF8\uAC78 \uBA87 \uBC88\uC774\uB098 \uB418\uD480\uC774\uD588\uB294\uC9C0 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174906
    m_Localized: "\uB458\uC774\uC11C \uB2F4\uC7A5\uC758 \uD2C8, \uC7A0\uAE30\uC9C0 \uC54A\uB294 \uCC3D\uBB38, \uC18C\uB9AC\uAC00 \uC6B8\uB9AC\uB294 \uBCF5\uB3C4\uB97C \uBE68\uAC04 \uD39C\uC73C\uB85C \uD45C\uC2DC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369318
    m_Localized: "\uBE57\uBB3C\uC774 \uB9C8\uB97C \uBB34\uB835, \uB2F4\uC7A5 \uC544\uB798\uAC00 \uC870\uC6A9\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369319
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uBCF4\uB2E4 \uAE38\uC5C8\uB294\uB370, \uBD04\uBCF4\uB2E4 \uB35C \uBB34\uC11C\uC6E0\uC5B4. \uC774\uC0C1\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369320
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC \uD55C\uCABD\uC774 \uBB34\uB108\uC84C\uB2E4. \uB204\uAD70\uAC00 \uC774\uB984\uC744 \uBD88\uB800\uACE0, \uB204\uAD70\uAC00 \uC190\uC744 \uC7A1\uC544\uB04C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369321
    m_Localized: "\uC5B4\uB5BB\uAC8C \uBC84\uD17C\uB294\uC9C0\uB294 \uC21C\uC11C\uB300\uB85C \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294\uB2E4. \uC816\uC740 \uBC14\uB2E5, \uAEBC\uC9C4 \uC190\uC804\uB4F1, \uB4F1\uC5D0 \uB2FF\uB358 \uB204\uAD70\uAC00\uC758 \uC5B4\uAE68."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369322
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB300\uB2F5\uD574. \uD55C \uBA85\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369323
    m_Localized: "\uB300\uB2F5\uC774 \uB3CC\uC544\uC62C \uB54C\uB9C8\uB2E4 \uC120\uC0DD\uB2D8\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369324
    m_Localized: "\uC5EC\uB984\uC758 \uB9C8\uC9C0\uB9C9 \uBC24. \uC625\uC0C1\uC5D0 \uBAA8\uB450 \uBAA8\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369325
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC758\uC871\uC73C\uB85C \uACC4\uB2E8 \uC5F4\uC5EC\uC12F \uCE78\uC744 \uC9C1\uC811 \uC62C\uB77C\uC654\uB2E4. \uD55C \uCE78 \uC624\uB97C \uB54C\uB9C8\uB2E4 \uC22B\uC790\uB97C \uC14C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369326
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uACC4\uB2E8 \uC5F4\uC5EC\uC12F \uCE78\uC744 \uC62C\uB77C\uC654\uB2E4. \uC911\uAC04\uC5D0 \uB450 \uBC88 \uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174905
    m_Localized: "\uD559\uAD50 \uBC29\uC5B4 \uC9C0\uB3C4\uB85C \uC4F4\uB2E4. \uC57D\uD55C \uACF3\uC744 \uD45C\uC2DC\uD558\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369327
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB0B4 \uB4F1\uC5D0 \uC5C5\uD600 \uC62C\uB77C\uC654\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uAC00\uBCBC\uC6E0\uB2E4. \uADF8\uAC8C \uC870\uAE08 \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369328
    m_Localized: "\uC2B5\uACA9\uC744 \uBC84\uD2F4 \uD559\uAD50 \uC704\uB85C \uBCC4\uC774 \uC3DF\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369329
    m_Localized: "\uBB34\uB108\uC9C4 \uBC14\uB9AC\uCF00\uC774\uB4DC\uB294 \uC544\uC9C1 \uBC18\uCBE4\uB9CC \uB2E4\uC2DC \uC313\uC5EC \uC788\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uBCC4\uC740 \uB611\uAC19\uC774 \uC3DF\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369330
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984 \uD3C9\uAC00 \uC2DC\uAC04\uC774\uB2E4. \uB18D\uB2F4\uC774\uC57C. \uBC18\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369331
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310 \uB300\uC2E0 \uD558\uB298\uC744 \uAC00\uB9AC\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369332
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC5D0 \uC6B0\uB9AC\uB294 \uB458\uC774\uC5C8\uC5B4. \uC9C0\uAE08\uC740 \uBA87 \uBA85\uC778\uC9C0 \uC138\uC5B4 \uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369333
    m_Localized: "\uC190\uAC00\uB77D \uD558\uB098. \uB3C4\uD604. \uB9DD \uBCF4\uB294 \uB208."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174904
    m_Localized: "\uC9C0\uB3C4\uB294 \uB180\uB784 \uB9CC\uD07C \uC815\uD655\uD588\uB2E4. \uC0AC\uAC70\uB9AC\uC758 \uBD89\uC740 \uD45C\uC2DC\uAE4C\uC9C0 \uC791\uAC8C \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369334
    m_Localized: "\uC190\uAC00\uB77D \uD558\uB098. \uBC15 \uC120\uC0DD\uB2D8. \uB530\uB054\uD558\uACE0 \uC815\uD655\uD55C \uC190."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369335
    m_Localized: "\uC190\uAC00\uB77D \uD558\uB098. \uC1A1\uC608\uC9C0. \uC544\uC9C1 \uB208\uC744 \uC798 \uB9C8\uC8FC\uCE58\uC9C0 \uBABB\uD558\uB294. \uADF8\uB798\uB3C4, \uC5EC\uAE30 \uC788\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369336
    m_Localized: "\uADF8\uB9AC\uACE0 \uAE09\uC2DD. \uACE0\uC591\uC774\uB3C4 \uC138\uB098? \uC138\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174903
    m_Localized: "\uC1A1\uC608\uC9C0: \uC6B0\uB9AC\uAC00 \uB2E4\uB2CC \uAE38, \uB9C9\uD78C \uAE38, \uD45C\uC2DC \uC788\uB358 \uB2F4\uC7A5. \uB2E4 \uB123\uC5C8\uC5B4. \u2026\uC4F8\uBAA8 \uC788\uC73C\uBA74 \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369337
    m_Localized: "\uB458. \uC5EC\uC804\uD788 \uB458\uC774\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uBD04\uC758 \uB458\uACFC\uB294 \uB2EC\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369338
    m_Localized: "\uC190\uAC00\uB77D\uC744 \uC811\uC744 \uB54C\uB9C8\uB2E4 \uC870\uAE08\uC529 \uC6C3\uC74C\uC774 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174902
    m_Localized: "\uC1A1\uC608\uC9C0: \uBBF8\uC220 \uD559\uC6D0 \uB2E4\uB154\uC5C8\uC5B4. \uC774\uB7F0 \uAC83\uBC16\uC5D0 \uBABB \uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369339
    m_Localized: "\uBC24. \uB3C4\uD604\uC774 \uCC3D\uAC00\uC5D0 \uC549\uC544 \uC0C8\uBCBD\uB3D9 \uCABD\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369340
    m_Localized: "\uB3C4\uD604: \uB204\uB098. \uC800\uAE30, \uBE68\uAC04 \uC9C0\uBD95 \uBCF4\uC774\uC8E0? \uADF8 \uB4A4\uC5D0 \uC6B0\uB9AC \uC9D1 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369341
    m_Localized: "\uB3C4\uD604: \uC5C4\uB9C8\uAC00 \uADF8\uB0A0 \uC544\uCE68\uC5D0 \uB3C4\uC2DC\uB77D \uC2F8 \uC92C\uAC70\uB4E0\uC694. \uADF8\uAC8C \uB9C8\uC9C0\uB9C9\uC774\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174901
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uCEE4\uB2E4\uB780 \uB3C4\uD654\uC9C0\uB97C \uB4E4\uACE0 \uC654\uB2E4. \uD559\uAD50\uC640 \uC8FC\uBCC0 \uACE8\uBAA9\uC774 \uC5F0\uD544\uB85C \uBE7C\uACE1\uD558\uAC8C \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369342
    m_Localized: "\uB3C4\uD604: \uD55C \uBC88\uB9CC\u2026 \uD55C \uBC88\uB9CC \uAC00 \uBCF4\uBA74 \uC548 \uB3FC\uC694? \uD63C\uC790 \uAC00\uACA0\uB2E4\uB294 \uAC70 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369343
    m_Localized: "\uB2E4\uC74C\uC5D0 \uC8FC\uD0DD\uAC00\uC5D0 \uAC08 \uB54C \uAC19\uC774 \uB4E4\uB974\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369344
    m_Localized: "\uB3C4\uD604: \uC9C4\uC9DC\uC694? \uC57D\uC18D\uC774\uC5D0\uC694. \uC800 \uAE38 \uB2E4 \uC54C\uC544\uC694. \uACE8\uBAA9 \uD558\uB098\uB3C4 \uC548 \uD2C0\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806641369345
    m_Localized: "\uC9C0\uAE08\uC740 \uB108\uBB34 \uC704\uD5D8\uD558\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563392
    m_Localized: "\uB3C4\uD604\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uC9C0\uB9CC, \uADF8\uB0A0 \uBC24 \uB2A6\uAC8C\uAE4C\uC9C0 \uCC3D\uAC00\uC5D0\uC11C \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563393
    m_Localized: "\uBE68\uAC04 \uC9C0\uBD95 \uC9D1. \uD604\uAD00\uBB38\uC740 \uC7A0\uACA8 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563394
    m_Localized: "\uC9D1 \uC548\uC740 \uAE68\uB057\uD588\uB2E4. \uB108\uBB34 \uAE68\uB057\uD574\uC11C, \uC11C\uB458\uB7EC \uB5A0\uB09C \uAC83 \uAC19\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563395
    m_Localized: "\uB0C9\uC7A5\uACE0 \uBB38\uC5D0 \uC790\uC11D\uC73C\uB85C \uBD99\uC740 \uCABD\uC9C0 \uD55C \uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806645563396
    m_Localized: "'\uB3C4\uD604\uC544. \uC5C4\uB9C8\uB791 \uC544\uBE60\uB294 \uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C\uB85C \uAC04\uB2E4. \uAF2D \uC640. \uAF2D.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174900
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uADF8\uB54C\uAE4C\uC9C0 \uC548 \uBC84\uB9B4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980603
    m_Localized: "\uCC9C\uC7A5\uC744 \uACE0\uCCD0 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980604
    m_Localized: "\uD14C\uC774\uD504\uC640 \uBE44\uB2D0\uB85C \uB9C9\uC558\uB2E4. \uAF64 \uADF8\uB7F4\uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980605
    m_Localized: "\uBE44\uB2D0\uC774 \uBB34\uAC8C\uB97C \uBABB \uC774\uAE30\uACE0 \uD130\uC84C\uB2E4. \uC790\uC7AC\uB9CC \uB0A0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980606
    m_Localized: "\uC591\uB3D9\uC774\uB85C \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980607
    m_Localized: "\uBE57\uBB3C\uC740 \uC815\uC218\uD558\uBA74 \uC4F8 \uC218 \uC788\uB2E4. \uBC24\uC0C8 \uC591\uB3D9\uC774\uB97C \uAC08\uC544 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980608
    m_Localized: "\uB208\uC744 \uB5B4\uC744 \uB54C \uC228\uC774 \uAC00\uBE74\uB2E4. \uC190\uBC14\uB2E5\uC774 \uCD95\uCD95\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980609
    m_Localized: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uCE60\uD310\uC758 '1\uD559\uB144 0\uBC18' \uAE00\uC528\uAC00 \uD76C\uBBF8\uD558\uAC8C \uBCF4\uC600\uB2E4. \uC5EC\uAE30\uB294 \uAD50\uC2E4\uC774\uB2E4. \uCC3D\uACE0\uAC00 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980610
    m_Localized: "\uCCA0\uBB38\uC774 \uBCF4\uC600\uB2E4. \uC548\uC5D0\uC11C \uC7A0\uADF8\uB294 \uBB38. \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC7A0\uADFC \uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980611
    m_Localized: "\uC77C\uAE30\uC7A5\uC5D0 \uAFC8\uC744 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980612
    m_Localized: "\uAE00\uB85C \uC4F0\uACE0 \uB098\uB2C8 \uC870\uAE08 \uC791\uC544\uC84C\uB2E4. \uAFC8\uC740 \uAFC8\uC77C \uBFD0\uC774\uB77C\uACE0 \uB9C8\uC9C0\uB9C9 \uC904\uC5D0 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174972
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5EC\uB984\uC774\uB124. \uBC8C\uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980613
    m_Localized: "\uC77C\uAE30\uC7A5 \uC55E\uCABD\uC5D0\uB3C4 \uAC19\uC740 \uC904\uC774 \uBA87 \uBC88 \uC788\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC4F8 \uB54C\uB9C8\uB2E4 \uC870\uAE08\uC529 \uC791\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980614
    m_Localized: "\uC120\uC0DD\uB2D8\uC744 \uAE68\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980615
    m_Localized: "\uC120\uC0DD\uB2D8\uC744 \uBD80\uB974\uB824\uB2E4, \uC774\uC81C \uBD80\uB97C \uC0AC\uB78C\uC774 \uC5C6\uB2E4\uB294 \uAC78 \uB5A0\uC62C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980616
    m_Localized: "\uB300\uC2E0 \uC120\uC0DD\uB2D8\uC774 \uD558\uB358 \uB9D0\uC744 \uC18C\uB9AC \uB0B4\uC5B4 \uB530\uB77C \uD588\uB2E4. \uBB38 \uC5F4\uB824 \uC788\uC5B4. \uBD10, \uC5F4\uB824 \uC788\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980617
    m_Localized: "\uB2EB\uD78C \uBB38 \uB108\uBA38\uB85C \uC791\uAC8C \uBD88\uB800\uB2E4. \uB300\uB2F5\uC740 \uAE08\uBC29 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980618
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC751. \uC5EC\uAE30 \uC788\uC5B4. \uBB38\uC740 \uB2EB\uD600 \uC788\uC5B4\uB3C4, \uB098\uB294 \uC5EC\uAE30 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980619
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC774\uBBF8 \uAE68\uC5B4 \uC788\uC5C8\uB2E4. \uC5F4 \uB54C\uBB38\uC5D0 \uC7A0\uC774 \uC595\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980620
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC751. \uC5EC\uAE30 \uC788\uC5B4. \uC774\uB9AC \uC640, \uC190. \uBB38 \uC5F4\uB824 \uC788\uC9C0? \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980621
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026\uC751. \uC5EC\uAE30 \uC788\uC5B4. \uBB38 \uC5F4\uB824 \uC788\uC5B4. \uBD10, \uC5F4\uB824 \uC788\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174973
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCE60\uD310\uC5D0 \uD559\uAD50 \uD3C9\uBA74\uB3C4\uB97C \uADF8\uB838\uB2E4. \uBD84\uD544\uC774 \uBA87 \uBC88\uC774\uB098 \uBD80\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980622
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC190\uC804\uB4F1\uC73C\uB85C \uBB38\uC744 \uD55C \uBC88 \uBE44\uCDB0 \uC8FC\uACE0, \uB2E4\uC2DC \uC7A0\uB4E4 \uB54C\uAE4C\uC9C0 \uB9D0\uC5C6\uC774 \uB4F1\uC744 \uD1A0\uB2E5\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980623
    m_Localized: "\uC2DD\uB7C9 \uC0C1\uC790 \uBAA8\uC11C\uB9AC\uAC00 \uAC09\uD600 \uC788\uC5C8\uB2E4. \uC950\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980624
    m_Localized: "\uBC24\uC0C8 \uCC9C\uC7A5 \uC704\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB6F0\uC5B4\uB2E4\uB2C8\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uC300 \uBD09\uC9C0\uC5D0 \uAD6C\uBA4D\uC774 \uB098 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980625
    m_Localized: "\uC120\uBC18 \uC544\uB798 \uAE4C\uB9CC \uC54C\uAC31\uC774\uAC00 \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uB610 \uC950\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980626
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC800 \uB140\uC11D\uB4E4, \uC6B0\uB9AC\uBCF4\uB2E4 \uC5EC\uAE30\uC11C \uC624\uB798 \uC0B0 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980627
    m_Localized: "\uB36B\uC744 \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980628
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uB36B\uC774 \uC81C \uC5ED\uD560\uC744 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980629
    m_Localized: "\uB36B\uC740 \uBE44\uC5B4 \uC788\uC5C8\uACE0, \uC0C1\uC790\uB294 \uB354 \uB9CE\uC774 \uAC09\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980630
    m_Localized: "\uC2DD\uB7C9\uC744 \uB192\uC740 \uACF3\uC73C\uB85C \uC62E\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980631
    m_Localized: "\uC62E\uAE30\uB2E4 \uC0C1\uC790 \uD558\uB098\uB97C \uB5A8\uC5B4\uB728\uB838\uB2E4. \uADF8\uB798\uB3C4 \uB098\uBA38\uC9C0\uB294 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980632
    m_Localized: "\uBB3C\uD1B5\uC5D0\uC11C \uC774\uC0C1\uD55C \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980633
    m_Localized: "\uBC1B\uC544 \uB454 \uBB3C \uC704\uC5D0 \uC587\uC740 \uB9C9\uC774 \uB5A0 \uC788\uC5C8\uB2E4. \uC190\uAC00\uB77D\uC744 \uB300\uC790 \uBBF8\uB048\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174974
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBD04\uC740 \uBC84\uD2F0\uB294 \uACC4\uC808\uC774\uC5C8\uC5B4. \uC5EC\uB984\uC740 \uB113\uD788\uB294 \uACC4\uC808\uB85C \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980634
    m_Localized: "\uBB3C\uC744 \uB530\uB974\uB2E4 \uC190\uC774 \uBA48\uCDC4\uB2E4. \uC0C9\uC774 \uC870\uAE08 \uD0C1\uD588\uB2E4. \uB0C4\uC0C8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980635
    m_Localized: "\uB354\uC704 \uD0D3\uC778\uC9C0, \uC694\uC998\uC740 \uBB3C\uC774 \uAE08\uBC29 \uC0C1\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980636
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uB053\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980637
    m_Localized: "\uB053\uC774\uACE0 \uB098\uB2C8 \uB0C4\uC0C8\uAC00 \uC0AC\uB77C\uC84C\uB2E4. \uC5F0\uB8CC\uAC00 \uC544\uAE5D\uC9C0\uB9CC \uBB3C\uC774 \uB354 \uADC0\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980638
    m_Localized: "\uC544\uAE5D\uC9C0\uB9CC \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980639
    m_Localized: "\uBC30\uD0C8\uBCF4\uB2E4\uB294 \uB0AB\uB2E4. \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980640
    m_Localized: "\uC6B4\uB3D9\uC7A5 \uAC00\uC7A5\uC790\uB9AC \uBC9A\uB098\uBB34\uB294 \uAF43\uC774 \uB2E4 \uC9C0\uACE0 \uC78E\uC774 \uC62C\uB77C\uC640 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980641
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCC3D\uAC00\uC5D0 \uC758\uC790\uB97C \uB04C\uC5B4\uB2E4 \uB193\uACE0 \uD55C\uCC38 \uBC14\uAE65\uC744 \uBCF4\uC558\uB2E4. \uC624\uB298\uC740 \uC544\uBB34\uB3C4 \uC11C\uB450\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174975
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD50\uC2E4\uB3D9 \uB9D0\uACE0\uB3C4 \uC4F8 \uB9CC\uD55C \uB370\uAC00 \uB9CE\uC544. \uAE09\uC2DD\uC2E4, \uB3C4\uC11C\uAD00, \uCCB4\uC721\uAD00, \uACFC\uD559\uC2E4, \uAD50\uBB34\uC2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980642
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB0B4\uB9B0 \uBE44\uB85C \uACF5\uAE30\uAC00 \uC11C\uB298\uD588\uB2E4. \uB9E4\uBBF8\uAC00 \uC6B8\uAE30 \uC2DC\uC791\uD558\uAE30 \uC804\uC758 \uC9E7\uC740 \uC2DC\uAC04."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980643
    m_Localized: "\uC120\uC0DD\uB2D8\uACFC \uB098\uB780\uD788 \uC549\uC544 \uBB3C\uC744 \uD55C \uBAA8\uAE08\uC529 \uB098\uB220 \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980644
    m_Localized: "\uC544\uCE68\uBD80\uD130 \uBCD5\uC774 \uB728\uAC70\uC6E0\uB2E4. \uBCF5\uB3C4 \uB05D \uCC3D\uBB38\uC744 \uC5F4\uC790 \uBC14\uB78C\uC774 \uD55C \uC904\uAE30 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980645
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uC740 \uADF8\uB0E5, \uC774\uB807\uAC8C \uC788\uC790. \uD55C \uC2DC\uAC04\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980646
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0 \uB099\uC5FD\uC774 \uC313\uC5EC \uC788\uC5C8\uB2E4. \uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uBC14\uC2A4\uB77D\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980647
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB099\uC5FD \uD558\uB098\uB97C \uC8FC\uC6CC \uAD50\uACFC\uC11C \uC0AC\uC774\uC5D0 \uB07C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980648
    m_Localized: "\uD558\uB298\uC774 \uB192\uC558\uB2E4. \uAD6C\uB984 \uD55C \uC810 \uC5C6\uB294 \uC544\uCE68."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806632980649
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uB7F0 \uB0A0\uC5D4 \uC6D0\uB798 \uC18C\uD48D\uC744 \uAC00\uB294 \uAC70\uC57C. \u2026\uB0B4\uB144\uC5D4 \uAF2D."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806637174828
    m_Localized: "\uADF8\uB0A0 \uC800\uB141 \uBC25\uC774 \uBAA9\uC5D0 \uAC78\uB838\uB2E4. \uC120\uC0DD\uB2D8\uC740 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB0B4 \uBAAB\uC758 \uAD6D\uC744 \uC870\uAE08 \uB354 \uB5A0 \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591886
    m_Localized: "{0}: \uAD1C\uCC2E\uC544. \uC544\uC9C1 \uC788\uC5B4. \uC544\uC9C1."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591885
    m_Localized: "\uC0DD\uC218 \uBC15\uC2A4 \uC548\uC774 \uB208\uC5D0 \uB744\uAC8C \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591884
    m_Localized: "\uADF8 \uB4A4\uB85C\uB294 \uBB38\uC744 \uB450\uB4DC\uB9AC\uC9C0 \uC54A\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591883
    m_Localized: "\uC0AC\uB78C\uC774\uC5C8\uB2E4\uBA74 \uBB38\uC744 \uB450\uB4DC\uB838\uC744 \uAC83\uC774\uB2E4. \uADF8\uAC83\uC740 \uB450\uB4DC\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uBB38 \uC55E\uC5D0 \uC11C \uC788\uAE30\uB9CC \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591882
    m_Localized: "\uB0A8\uC740 \uC0DD\uC218 \uBCD1\uC744 \uB2E4\uC2DC \uC138\uC5C8\uB2E4. \uC138\uB294 \uAC83\uB3C4 \uD558\uB8E8 \uC77C\uACFC\uAC00 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591881
    m_Localized: "\uC624\uB298\uC758 \uC870\uC6A9\uD568\uC740 \uB450 \uBC88\uC9F8 \uCABD\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591880
    m_Localized: "\uC870\uC6A9\uD568\uC5D0\uB3C4 \uC885\uB958\uAC00 \uC788\uB2E4\uB294 \uAC78 \uC54C\uC558\uB2E4. \uC0AC\uB78C\uC774 \uC5C6\uB294 \uC870\uC6A9\uD568\uACFC, \uBAA8\uB450\uAC00 \uC228\uC8FD\uC778 \uC870\uC6A9\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591879
    m_Localized: "{0}\uC758 \uC5BC\uAD74\uC774 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC560\uB294 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591878
    m_Localized: "\uB9E4\uD2B8 \uC704\uC5D0 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0 \uC549\uC558\uB2E4. \uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uB294 \uBC95\uC744, \uC870\uAE08\uC529 \uBC30\uC6B0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591877
    m_Localized: "\uC0AC\uC774\uB80C\uC740 \uD574 \uC9C8 \uBB34\uB835\uC5D0\uC57C \uADF8\uCCE4\uB2E4. \uADF8 \uB4A4\uC758 \uC870\uC6A9\uD568\uC774 \uC0AC\uC774\uB80C\uBCF4\uB2E4 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591876
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB0B4 \uAC78\uC74C\uB3C4 \uADF8\uB7AC\uB2E4. \uADF8\uB798\uC11C \uC6D0\uB9DD\uD560 \uC218\uAC00 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591875
    m_Localized: "\uADF8 \uAC78\uC74C\uC744 \uC548\uB2E4. \uBB34\uC11C\uC6B4 \uAC78 \uC9C0\uB098\uCE60 \uB54C, \uBA48\uCD94\uBA74 \uC548 \uB420 \uAC83 \uAC19\uC544\uC11C \uB354 \uBE68\uB77C\uC9C0\uB294 \uAC78\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591874
    m_Localized: "\uC624\uD6C4\uC5D0\uB294 \uB700\uD2C0 \uC704\uC5D0 \uC62C\uB77C\uAC00 \uD658\uAE30\uCC3D \uBC16\uC744 \uBCF4\uC558\uB2E4. \uC6B4\uB3D9\uC7A5\uC5D0 \uC544\uBB34\uB3C4 \uC5C6\uC5C8\uB2E4. \uB4F1\uAD50\uD558\uB294 \uB0A0\uC778\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591873
    m_Localized: "{0}: \uBE44\uC0C1\uC2DD\uB7C9 \uD3C9\uAC00. \uC774\uC628\uC74C\uB8CC, \uBCC4 \uB2E4\uC12F \uAC1C. \uBC25\uC774 \uC548 \uB418\uB294 \uAC8C \uD760."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806624591872
    m_Localized: "\uD658\uAE30\uCC3D \uB108\uBA38\uB85C \uBCC4 \uD558\uB098\uAC00 \uBCF4\uC600\uB2E4. \uADF8\uAC83\uB9CC \uBCF4\uB2E4\uAC00 \uC7A0\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1372806616203264
    m_Localized: "\uB9E4\uD2B8\uB97C \uD3B4\uACE0 \uB204\uC6E0\uB2E4. \uCCB4\uC721\uAD00 \uBC14\uB2E5 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706504
    m_Localized: "\uC591\uB3D9\uC774\uB85C \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706505
    m_Localized: "\uAD50\uBCF5 \uC7AC\uD0B7\uC774 \uC544\uC9C1 \uBAB8\uC5D0 \uB35C \uB9DE\uB294\uB2E4. \uACE0\uB4F1\uD559\uAD50\uC5D0 \uB4E4\uC5B4\uC628 \uC9C0 \uACA8\uC6B0 \uC77C\uC8FC\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460133
    m_Localized: "\uC544\uAE5D\uB2E4\uB294 \uC0DD\uAC01\uC744 \uAFB9 \uB204\uB974\uACE0 \uC0C1\uC790\uB97C \uBE44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460132
    m_Localized: "\uC0C1\uD55C \uAC83\uAE4C\uC9C0 \uC804\uBD80 \uBC84\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460131
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uAE4C\uC6CC\uB3C4 \uBC84\uB9AC\uB294 \uAC8C \uB9DE\uC744 \uC218\uB3C4 \uC788\uC5B4. \u2026\uB124\uAC00 \uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460130
    m_Localized: "\uC313\uC544 \uB454 \uC2DD\uB7C9 \uC544\uB798\uCABD\uC5D0\uC11C \uBB3C\uAE30\uAC00 \uBC30\uC5B4 \uB098\uC654\uB2E4. \uC544\uB798 \uCE78 \uAC83\uB4E4\uC774 \uB205\uB205\uD558\uAC8C \uBCC0\uD574 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460129
    m_Localized: "\uD1B5\uC870\uB9BC \uD558\uB098\uAC00 \uBD88\uB8E9\uD558\uAC8C \uBD80\uD480\uC5B4 \uC788\uC5C8\uB2E4. \uC606 \uC0C1\uC790\uC758 \uB77C\uBA74 \uBD09\uC9C0\uC5D0\uB3C4 \uACF0\uD321\uC774\uAC00 \uBC88\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460128
    m_Localized: "\uC2B5\uAE30 \uB54C\uBB38\uC5D0 \uBE75\uACFC \uBC18\uCC2C \uBA87 \uAC1C\uAC00 \uC0C1\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460127
    m_Localized: "\uC2DD\uB7C9 \uC0C1\uC790\uC5D0\uC11C \uC2DC\uD07C\uD55C \uB0C4\uC0C8\uAC00 \uC62C\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826547
    m_Localized: "\uC9C0\uAE08\uC740 \uC548\uB2E4. \uB208\uC744 \uAC10\uB294 \uAC83\uB3C4 \uB098\uB97C \uC9C0\uD0A4\uB294 \uBC29\uBC95\uC774\uB2E4. \uADF8\uB9AC\uACE0 \uADF8\uB0A0 \uC77C\uC5B4\uB09C \uC77C\uC740, \uB0B4\uAC00 \uC5B4\uB5A4 \uC5BC\uAD74\uC744 \uD588\uB4E0 \uB0B4 \uD0D3\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706506
    m_Localized: "\uC8FC\uBA38\uB2C8 \uC18D \uD734\uB300\uD3F0\uC774 \uC9E7\uAC8C \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706507
    m_Localized: "\uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uB2EC\uB824\uC624\uB294 \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706508
    m_Localized: "{0}: \uC57C, {1}! \uAC19\uC774 \uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826499
    m_Localized: "\uB178\uB798\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uBC14\uAE65 \uC5B4\uB518\uAC00\uC5D0\uC11C \uB204\uAD70\uAC00 \uAC19\uC740 \uB178\uB798\uB97C \uB4E3\uACE0 \uC788\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460121
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD1C\uCC2E\uB0D0\uACE0 \uBB3C\uC5B4\uBD10 \uC900 \uC0AC\uB78C\uC774 \uB124\uAC00 \uCC98\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460120
    m_Localized: "\uB2E4\uB9AC\u2026 \uAD1C\uCC2E\uC73C\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460119
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uBABB \uC790\uACA0\uC5B4? \uB098\uB3C4 \uADF8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460118
    m_Localized: "{0} \uAE6C \uAC78 \uC54C\uC544\uCC58\uB294\uC9C0, \uC120\uC0DD\uB2D8\uC774 \uC190\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460117
    m_Localized: "\uBD88 \uAEBC\uC9C4 \uCC3D\uACE0. \uC724 \uC120\uC0DD\uB2D8\uC774 \uBCBD\uC5D0 \uB4F1\uC744 \uAE30\uB304 \uCC44 \uBD95\uB300\uB97C \uB2E4\uC2DC \uAC10\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826548
    m_Localized: "\uD55C \uBC88\uC5D0 \uB2E4 \uB9D0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB41C\uB2E4\uB294 \uAC78, 1\uB144 \uAC78\uB824 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706510
    m_Localized: "{0}: \uC544 \uB9DE\uB2E4, \uBC18 \uB2E8\uD1A1\uBC29\uC5D0 \uC0DD\uC77C \uBAA9\uB85D \uB9CC\uB4E0\uB300. \uB108 \uC0DD\uC77C \uC5B8\uC81C\uC600\uC9C0? \uB098 \uB610 \uAE4C\uBA39\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706511
    m_Localized: "{0}: \uADFC\uB370 \uB108 \uADF8 \uAC80\uC0AC \uD574 \uBD24\uC5B4? \uADF8\u2026 \uC5E0\uBE44\uD2F0\u2026 \uC640\uC774?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706512
    m_Localized: "I \uC57C. \uB098\uB294\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706513
    m_Localized: "{0}: \uC624, \uC5ED\uC2DC. \uB531 \uB108 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460111
    m_Localized: "\uB2E4 \uD480\uACE0 \uB098\uB2C8, \uC774\uC0C1\uD558\uAC8C\uB3C4 \uC870\uAE08 \uC228\uC774 \uC26C\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460110
    m_Localized: "\uC5F0\uD544 \uC18C\uB9AC\uB9CC \uCC3D\uACE0\uB97C \uCC44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460109
    m_Localized: "\uC2DC\uAC04\uC744 \uC7AC\uACE0 \uD480\uC5B4 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460108
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAE00\uC384. \uCC44\uC810\uC740 \uB0B4\uAC00 \uD574 \uC904 \uC218 \uC788\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460107
    m_Localized: "{0}: \uC774\uAC78 \uC9C0\uAE08 \uD480\uC5B4\uC11C \uBB50 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460106
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC70\u2026 \uC6B0\uB9AC \uD559\uB144 \uAC70\uB124. \uAD50\uBB34\uC2E4\uB85C \uAC00\uB358 \uC0C1\uC790\uC600\uB098 \uBCF4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460105
    m_Localized: "\uC6D0\uB798\uB77C\uBA74 \uC624\uB298\uC740 \uACE0\uB4F1\uD559\uAD50 \uCCAB \uBAA8\uC758\uACE0\uC0AC \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460104
    m_Localized: "\uD45C\uC9C0\uC5D0 \uCC0D\uD78C \uB0A0\uC9DC\uB294 3\uC6D4 26\uC77C. \uC624\uB298\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460103
    m_Localized: "\uCC3D\uACE0 \uC120\uBC18\uC5D0\uC11C \uBE44\uB2D0\uB3C4 \uC548 \uB72F\uC740 \uC2DC\uD5D8\uC9C0 \uBB36\uC74C\uC774 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826549
    m_Localized: "\uBB34\uB98E\uC774 \uAE4C\uC84C\uB2E4. \uADF8\uB798\uB3C4 \uC8FC\uBA39\uBC25\uC740 \uB05D\uAE4C\uC9C0 \uC190\uC5D0 \uC950\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706514
    m_Localized: "\uBAB0\uB77C. \uD574 \uBCF8 \uC801 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826498
    m_Localized: "\uBE68\uAC04 \uBD88\uC774 \uAEBC\uC84C\uB2E4. \uBC29\uC1A1\uC2E4\uC774 \uB2E4\uC2DC \uC870\uC6A9\uD574\uC84C\uB294\uB370, \uC544\uAE4C\uC640\uB294 \uB2E4\uB978 \uC870\uC6A9\uD568\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706516
    m_Localized: "{0}: 1\uBC88. \uC8FC\uB9D0\uC5D0 \uC57D\uC18D\uC774 \uAC11\uC790\uAE30 \uCDE8\uC18C\uB410\uC5B4. \uB108\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706517
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uD55C\uD14C \uC5F0\uB77D\uD574\uC11C \uB098\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460097
    m_Localized: "\uBC1C\uC774 \uBA3C\uC800 \uB4A4\uB85C \uBB3C\uB7EC\uC130\uB2E4. \uBB38\uAE4C\uC9C0 \uC138 \uAC78\uC74C. \uBAB8\uC774 \uBA3C\uC800 \uAE38\uC744 \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460096
    m_Localized: "\uC785\uAF2C\uB9AC\uAC00 \uBA3C\uC800 \uC62C\uB77C\uAC00\uB824 \uD588\uB2E4. \uC624\uB798\uB41C \uBC84\uB987\uC774\uC5C8\uB2E4. \uC774\uBC88\uC5D4 \uADF8\uB300\uB85C \uB450\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460095
    m_Localized: "\uC190\uC774 \uC800\uC808\uB85C \uC8FC\uBA39\uC744 \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460094
    m_Localized: "\uACE0\uAC1C\uB97C \uB4E0 \uC5BC\uAD74. \uCD5C\uD558\uB9B0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460093
    m_Localized: "\uCC3D\uACE0 \uC0AC\uBB34\uC2E4 \uC548. \uB2F4\uC694\uB97C \uB450\uB978 \uC5EC\uC790\uC544\uC774\uAC00 \uD1B5\uC870\uB9BC\uC744 \uC138\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826550
    m_Localized: "\uD760\uBED1 \uC816\uC740 \uCC44 \uB3CC\uC544\uC624\uC790 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC74C\uC744 \uCC38\uB2E4\uAC00 \uACB0\uAD6D \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826497
    m_Localized: "\uBCF5\uB3C4\uB97C \uAC78\uC5B4 \uB3CC\uC544\uC624\uB294\uB370, \uAD1C\uD788 \uB208\uAC00\uAC00 \uB728\uAC70\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706519
    m_Localized: "{0}: 2\uBC88. '\uC0AC\uACFC' \uD558\uBA74 \uB5A0\uC624\uB974\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706520
    m_Localized: "\uBE68\uAC1B\uACE0 \uC544\uC0AD\uD55C \uACFC\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826496
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uAD6C\uC870\uB418\uBA74 \uD3B8\uC9C0\uB97C \uC368\uC57C\uACA0\uB2E4. \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uD55C \uC904 \uC801\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460087
    m_Localized: "\"\u2026\uC77C\uC5B4\uB098. \uAC19\uC774 \uAC00.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460086
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uB108."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460085
    m_Localized: "\uAC19\uC740 \uC911\uD559\uAD50. \uADF8 \uBB34\uB9AC \uC606\uC5D0 \uB298 \uC11C \uC788\uB358 \uC544\uC774. \uC6C3\uC9C0\uB3C4, \uB9D0\uB9AC\uC9C0\uB3C4 \uC54A\uB358 \uC544\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460084
    m_Localized: "\uC190\uC804\uB4F1 \uBE5B\uC5D0 \uACE0\uAC1C\uB97C \uB4E0 \uC5BC\uAD74\uC744 \uBCF4\uB294 \uC21C\uAC04 \uC228\uC774 \uBA4E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460083
    m_Localized: "\uC2B9\uAC15\uC7A5 \uC606 \uC0AC\uBB34\uC2E4 \uAD6C\uC11D. \uAD50\uBCF5 \uCC28\uB9BC\uC758 \uC5EC\uC790\uC544\uC774\uAC00 \uBB34\uB98E\uC744 \uC548\uACE0 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826551
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uBD88 \uBC18\uB300\uD3B8\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uAC74\uB128 \uACE0\uAE30\uB97C \uBC1B\uC544 \uB4E4\uACE0, \uC624\uB798 \uCCD0\uB2E4\uBCF4\uB2E4\uAC00 \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706522
    m_Localized: "{0}: 3\uBC88. \uCE5C\uAD6C\uAC00 \uC2DC\uD5D8 \uB9DD\uCCE4\uB2E4\uACE0 \uC6B8\uC5B4. \uCCAB\uB9C8\uB514\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706523
    m_Localized: "\"\uBA87 \uC810\uC778\uB370? \uC5B4\uB514\uC11C \uD2C0\uB838\uC5B4?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2293898084106240
    m_Localized: "(\uBC31\uC5D0\uAC8C\uC11C '\uBE60\uC838\uB098\uAC00\uB294 \uAE38'\uC744 \uBC30\uC6E0\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706525
    m_Localized: "{0}: \uB9C8\uC9C0\uB9C9. \uC5EC\uD589 \uAC00\uBA74 \uACC4\uD68D\uD45C \uC9DC?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460077
    m_Localized: "\uC190\uC5D0 \uAC00\uC704\uB97C \uC954 \uCC44 \uC774\uCABD\uC744 \uB178\uB824\uBCF4\uB2E4\uAC00, \uAD50\uBCF5\uC744 \uBCF4\uACE0 \uCC9C\uCC9C\uD788 \uC190\uC744 \uB0B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460076
    m_Localized: "\uC637\uC7A5 \uBB38\uD2C8\uC73C\uB85C \uB0AF\uC775\uC740 \uC5BC\uAD74\uC774 \uBCF4\uC600\uB2E4. \uD559\uAD50 \uBCF4\uAC74\uC2E4\uC5D0\uC11C \uBCF8 \uC801 \uC788\uB294 \uC0AC\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826552
    m_Localized: "\uD55C\uCABD \uBC1C\uC774 \uC816\uC5C8\uACE0, \uC190\uBC14\uB2E5\uC774 \uC5BC\uC74C\uC5D0 \uC4F8\uB838\uB2E4. \uADF8\uB0A0 \uBC24\uC740 \uC624\uB798 \uB5A8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706526
    m_Localized: "\uC2DC\uAC04 \uB2E8\uC704\uB85C \uC9E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706527
    m_Localized: "\uAC00\uC11C \uC815\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706528
    m_Localized: "{0}: O\uD615\uC740 '\uCCB4\uB825 \uAD00\uB9AC'. \uB108\uD55C\uD14C \uB531\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706529
    m_Localized: "AB\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460070
    m_Localized: "\uC544\uC774\uB294 \uD55C\uCC38 \uC190\uC744 \uBCF4\uB2E4\uAC00, \uCC9C\uCC9C\uD788 \uC7A1\uC558\uB2E4. \uC190\uC774 \uCC28\uAC00\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460069
    m_Localized: "\uAC19\uC774 \uAC00\uC790\uACE0 \uC190\uC744 \uB0B4\uBBFC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460068
    m_Localized: "\uBC24\uB9C8\uB2E4 \uB4E4\uB9AC\uB358 \uB178\uD06C \uC18C\uB9AC\uC758 \uC8FC\uC778\uC774\uC5C8\uB2E4. \uC190\uB4F1\uC774 \uBE68\uAC1B\uAC8C \uAE4C\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460067
    m_Localized: "\uB3C4\uD604: \u2026\uC0AC\uB78C, \uB9DE\uC8E0? \uBB3C\uB9B0 \uB370 \uC5C6\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460066
    m_Localized: "\uC774\uCABD\uC744 \uBCF4\uB354\uB2C8 \uC228\uC744 \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460065
    m_Localized: "\uAD50\uC2E4 \uAD6C\uC11D, \uCC45\uC0C1 \uBC11. \uC911\uD559\uC0DD \uD558\uB098\uAC00 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826553
    m_Localized: "\uBE48 \uB3C4\uB85C\uB97C \uB2EC\uB838\uB2E4. \uCC3D\uBB38\uC744 \uB0B4\uB9AC\uC790 \uBC14\uB78C\uC5D0\uC11C \uC18C\uAE08 \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706530
    m_Localized: "{0}: AB\uD615\uC740 '\uC911\uC694\uD55C \uACB0\uC815\uC744 \uBBF8\uB8E8\uC9C0 \uB9D0 \uAC83'. \uC624, \uC758\uBBF8\uC2EC\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706531
    m_Localized: "\uBAB0\uB77C. \uAC80\uC0AC\uD574 \uBCF8 \uC801 \uC5C6\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706532
    m_Localized: "\uC218\uD559\xB7\uACFC\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706533
    m_Localized: "\uCCB4\uC721"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460059
    m_Localized: "\uBD95\uB300\uB97C \uAC10\uB294 \uC190\uC774 \uB5A8\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uC5B4\uB514\uAC00 \uC544\uD508\uC9C0, \uC65C \uC544\uD508\uC9C0\uAC00 \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460058
    m_Localized: "\uB0A8\uC740 \uC7AC\uB8CC\uB85C \uD55C \uB07C\uB97C \uB9DE\uCDC4\uB2E4. \uB0C4\uC0C8\uAC00 \uBCF5\uB3C4\uAE4C\uC9C0 \uD37C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460057
    m_Localized: "\uBAB8\uC774 \uBA3C\uC800 \uAE30\uC5B5\uD558\uB294 \uB3D9\uC791\uC774 \uC0DD\uACBC\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uBA3C\uC800 \uC190\uC774 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460056
    m_Localized: "\uD480\uB9AC\uC9C0 \uC54A\uB358 \uC2DD\uC774 \uD480\uB838\uB2E4. \uC22B\uC790\uB4E4\uC774 \uC81C\uC790\uB9AC\uB97C \uCC3E\uC544 \uB4E4\uC5B4\uAC00\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460055
    m_Localized: "\uC2DC \uD55C \uD3B8\uC744 \uC18C\uB9AC \uB0B4\uC5B4 \uC77D\uC5C8\uB2E4. \uBAA8\uB974\uB294 \uC0AC\uB78C\uC774 \uC4F4 \uBB38\uC7A5\uC778\uB370, \uB0B4 \uC774\uC57C\uAE30 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460054
    m_Localized: "\uC218\uC5C5\uC774 \uB05D\uB098\uACE0\uB3C4 \uACF5\uCC45\uC744 \uB36E\uC9C0 \uBABB\uD588\uB2E4. \uD55C \uC7A5\uB9CC \uB354, \uD558\uB2E4\uAC00 \uCD1B\uBD88\uC774 \uBC18\uCBE4 \uD0D4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826554
    m_Localized: "\uBCC4\uC744 \uC138\uB2E4\uAC00 \uBA87 \uBC88\uC774\uB098 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC14C\uB2E4. \uB2E4 \uC140 \uD544\uC694\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706534
    m_Localized: "\uAE30\uC220\xB7\uAC00\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706535
    m_Localized: "\uC0DD\uBA85\uACFC\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706536
    m_Localized: "\uBBF8\uC220\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706537
    m_Localized: "\uBC29\uC1A1\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460048
    m_Localized: "\uADF8\uB0A0 \uC624\uD6C4 \uC120\uBC30\uB294 \uB5A0\uB0AC\uB2E4. \uD604\uAD00 \uBC14\uB9AC\uCF00\uC774\uB4DC\uC758 \uB290\uC2A8\uD55C \uD310\uC790 \uD558\uB098\uAC00 \uC0C8 \uBABB\uC73C\uB85C \uBC15\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460047
    m_Localized: "\uC120\uBC30\uB294 \uB0B4 \uB9D0\uC744 \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4. \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460046
    m_Localized: "\uC120\uBC30\uAC00 \uCE60\uD310 \uC55E\uC73C\uB85C \uAC00\uC11C, \uAC00\uC704\uD45C\uB97C \uC9C0\uC6B0\uACE0 \uADF8 \uC790\uB9AC\uC5D0 \uC791\uAC8C \uC801\uC5C8\uB2E4. '{0}, \uAC19\uC774.'"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460045
    m_Localized: "\uC120\uBC30\uB294 \uAC00\uBC29 \uB048\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460044
    m_Localized: "\uC120\uBC30\uAC00 \uD604\uAD00 \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C \uBCF4\uC558\uB2E4. \uC790\uAE30\uAC00 \uBD99\uC778 \uD310\uC790\uB4E4\uC744."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460043
    m_Localized: "{0}: \uC120\uBC30 \uC5C6\uC73C\uBA74 \uD604\uAD00\uC740 \uB204\uAC00 \uC9C0\uCF1C\uC694. \uC800 \uD63C\uC790\uC11C\uB294 \uBABB \uBC84\uD168\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460042
    m_Localized: "\uB0A8\uC544 \uB2EC\uB77C\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460041
    m_Localized: "\uC120\uBC30\uB294 \uD55C\uCC38 \uCE60\uD310\uC744 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uAC00\uBC29\uC744 \uB4E4\uC5B4 \uCC3D\uAC00 \uAD6C\uC11D\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460040
    m_Localized: "\uBD09\uC9C0\uB97C \uC120\uBC30 \uAC00\uBC29 \uC704\uC5D0 \uC62C\uB824\uB193\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uCE60\uD310\uC758 \uAC00\uC704\uD45C\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C \uC9C0\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460039
    m_Localized: "\uB0B4 \uBAAB\uC758 \uC2DD\uB7C9\uACFC \uBB3C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460038
    m_Localized: "\uC120\uBC30\uB294 \uB098\uB97C \uBCF4\uACE0 \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC600\uB2E4. \uB298 \uD558\uB358 \uB300\uB85C. \uADF8\uB7F0\uB370 \uC774\uBC88\uC5D4 \uC778\uC0AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460037
    m_Localized: "\uADF8 \uC544\uB798\uC5D0 \uC791\uC740 \uAC00\uC704\uD45C. \uC790\uAE30 \uC790\uB9AC\uB97C \uC9C0\uC6B4 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460036
    m_Localized: "\uC120\uBC30\uB294 \uCE60\uD310 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uCE60\uD310\uC5D0 \uC801\uD78C \uD544\uC694\uD55C \uAC83\uB4E4 \uBAA9\uB85D\uC744 \uC624\uB798 \uBCF4\uB2E4\uAC00, \uBD84\uD544\uB85C \uB9E8 \uC544\uB798\uC5D0 \uC904\uC744 \uD558\uB098 \uADF8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460035
    m_Localized: "\uC544\uCE68, \uCC3D\uAC00 \uAD6C\uC11D\uC758 \uC120\uBC30 \uC790\uB9AC\uAC00 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uAC00\uBC29\uC774 \uD604\uAD00 \uC55E\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uC2E0\uBC1C \uB048\uC740 \uC774\uBBF8 \uBB36\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826555
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC70, \uC878\uC5C5 \uC568\uBC94 \uB300\uC2E0 \uC624\uB798 \uAC04\uC9C1\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706538
    m_Localized: "\uBCF4\uAC74\uBC18"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706539
    m_Localized: "\uADC0\uAC00\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706540
    m_Localized: "\uCC98\uC74C\uC73C\uB85C {0}\uC5D0\uAC8C \uD138\uC5B4\uB193\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706541
    m_Localized: "\uC9E7\uAC8C, \uC544\uC8FC \uC870\uAE08\uB9CC \uB9D0\uD588\uB2E4. {0}\uB294 \uD55C\uCC38 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460029
    m_Localized: "\uCD5C\uD558\uB9B0: \uB410\uC5B4. \uB124\uAC00 \uADF8\uB807\uAC8C \uB9D0\uD574 \uC8FC\uB294 \uAC83\uB9CC\uC73C\uB85C \uCDA9\uBD84\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460028
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026{0}. \uB108\uB791 \uC788\uC73C\uBA74, \uB098\uB3C4 \uC880 \uAD1C\uCC2E\uC740 \uC0AC\uB78C\uC774 \uB420 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460027
    m_Localized: "{0}: \uC9C4\uC9DC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460026
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC544\uBB34\uB3C4 \uB204\uAD6C\uB97C \uAC00\uB450\uC9C0 \uC54A\uACE0, \uC544\uBB34\uB3C4 \uB204\uAD6C\uB97C \uB0B4\uCAD3\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uAC70 \uC9C4\uC9DC\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460025
    m_Localized: "\uD558\uB9B0\uC774 \uD55C\uCC38 \uBC14\uB2E5\uC744 \uBCF4\uB2E4\uAC00 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460024
    m_Localized: "{0}: \uC790\uACA9 \uC598\uAE30\uB294 \uADF8\uB9CC\uD574. \uC5EC\uAE30\uB294 \uADF8\uB7F0 \uAC78\uB85C \uC0AC\uB78C \uC548 \uB0B4\uBCF4\uB0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460023
    m_Localized: "\uB0A8\uC544 \uB2EC\uB77C\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460022
    m_Localized: "\uD558\uB9B0\uC740 \uAC1C\uB358 \uB2F4\uC694\uB97C \uB2E4\uC2DC \uD3C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460021
    m_Localized: "{0}: \uADF8\uB7EC\uB2C8\uAE4C. \uB0B4\uAC00 \uC815\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460020
    m_Localized: "\uCD5C\uD558\uB9B0: \u2026\uC65C. \uB108\uB294 \uC81C\uC77C \uB098\uB97C \uB0B4\uBCF4\uB0B4\uB3C4 \uB418\uB294 \uC0AC\uB78C\uC774\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460019
    m_Localized: "\uD558\uB9B0\uC740 \uBD09\uC9C0\uB97C \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4. \uBC1B\uC9C0\uB3C4, \uBC00\uC5B4\uB0B4\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460018
    m_Localized: "{0}: \uC774\uAC70 \uBC1B\uC544. \uB204\uAC00 \uBA3C\uC800 \uBE60\uC838\uC57C \uD558\uB294\uC9C0\uB294 \uB124\uAC00 \uC815\uD558\uB294 \uAC70 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460017
    m_Localized: "\uB0B4 \uBAAB\uC758 \uC2DD\uB7C9\uACFC \uBB3C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460016
    m_Localized: "\uCD5C\uD558\uB9B0: \uAD1C\uCC2E\uC544. \uB098 \uAC19\uC544\uB3C4 \uADF8\uB798. \uC6D0\uB798 \uC5EC\uAE30 \uC788\uC744 \uC790\uACA9\uB3C4 \uC5C6\uC5C8\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460015
    m_Localized: "\uCD5C\uD558\uB9B0: \uC5EC\uAE30\uC11C \uB204\uAD6C \uD558\uB098 \uBE60\uC838\uC57C \uD55C\uB2E4\uBA74 \uADF8\uAC74 \uB098\uC796\uC544. \uB2E4\uB4E4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294 \uAC70 \uC54C\uC544. \uBC25 \uBA39\uC744 \uB54C \uB098\uB791 \uB208 \uC548 \uB9C8\uC8FC\uCE58\uB294 \uAC83\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460014
    m_Localized: "\uCD5C\uD558\uB9B0: \uBA39\uC744 \uAC70 \uBAA8\uC790\uB77C\uBA74 \uC81C\uC77C \uBA3C\uC800 \uBE60\uC838\uC57C \uD558\uB294 \uAC74 \uB098\uC796\uC544. \uB2E4\uB4E4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294 \uAC70 \uC54C\uC544. \uB9D0 \uC548 \uD574\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460013
    m_Localized: "\uCD5C\uD558\uB9B0: \uB098 \uAC08\uAC8C. \uB9C8\uD2B8 \uCABD\uC774\uB4E0 \uC5B4\uB514\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460012
    m_Localized: "\uCD5C\uD558\uB9B0\uC774 \uBCF5\uB3C4 \uB05D, \uB298 \uC790\uB358 \uC790\uB9AC\uC5D0\uC11C \uB2F4\uC694\uB97C \uAC1C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826556
    m_Localized: "\uB9D0\uC740 \uD55C\uB9C8\uB514\uB3C4 \uC5C6\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uADF8\uAC74 \uBD84\uBA85\uD788, \uAC00\uB974\uCCD0 \uC8FC\uB294 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706542
    m_Localized: "{0}: \u2026\uC65C \uC774\uC81C \uB9D0\uD574. \uBC14\uBCF4\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706543
    m_Localized: "\uADF8 \uBB34\uB9AC\uB97C \uB611\uBC14\uB85C \uB9C8\uC8FC \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706544
    m_Localized: "{0}: \uC57D\uC18D\uD588\uB2E4? \uB3C4\uB9DD\uAC00\uBA74 \uC8FD\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460007
    m_Localized: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uB3C4\uC11C\uC2E4 \uCC45\uC0C1 \uC704\uC5D0 \uC9C0\uB3C4 \uD55C \uC7A5\uC774 \uBC18\uB4EF\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uC608\uC9C0\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460006
    m_Localized: "\uC1A1\uC608\uC9C0: \uACE0\uB9C8\uC6CC. \uADFC\uB370 \uB098\uB294 \uB098\uB97C \uBABB \uBBFF\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460005
    m_Localized: "\uC608\uC9C0\uB294 \uC791\uAC8C \uC6C3\uC5C8\uB2E4. \uBBF8\uC548\uD574\uD558\uB294 \uC6C3\uC74C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460004
    m_Localized: "\uC1A1\uC608\uC9C0: {0}, \uB108\uB791 \uC788\uC73C\uBA74\u2026 \uBB54\uAC00 \uC544\uC9C1 \uB0A8\uC544 \uC788\uB294 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460003
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uADF8 \uB9D0, \uC608\uC804\uC5D0 \uB4E3\uACE0 \uC2F6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460002
    m_Localized: "\uC608\uC9C0\uAC00 \uCC98\uC74C\uC73C\uB85C \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460001
    m_Localized: "{0}: \uC774\uBC88\uC5D4 \uB124\uAC00 \uBCF4\uACE0\uB9CC \uC788\uB294 \uAC70 \uC544\uB2C8\uC796\uC544. \uC5EC\uAE30 \uC788\uC796\uC544. \uADF8\uAC78\uB85C \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454460000
    m_Localized: "\uB0A8\uC544 \uB2EC\uB77C\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459999
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uD55C \uBC88\uB9CC \uB354 \uC788\uC5B4 \uBCFC\uAC8C. \uC774\uBC88\uC5D4 \uBE60\uC9C0\uC9C0 \uC54A\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459998
    m_Localized: "\uC608\uC9C0\uB294 \uC2A4\uCF00\uCE58\uBD81\uC744 \uAF2D \uC548\uC558\uB2E4. \uC9D0\uC744 \uB2E4\uC2DC \uD480\uC9C0\uB294 \uC54A\uC558\uC9C0\uB9CC, \uC77C\uC5B4\uC11C\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459997
    m_Localized: "{0}: \uC774\uAC70 \uB124 \uBAAB. \uADF8\uB9AC\uACE0 \uC9C0\uB3C4\uB294 \uB124\uAC00 \uADF8\uB838\uC796\uC544. \uADF8\uAC8C \uC65C \uC4F8\uBAA8\uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459996
    m_Localized: "\uB0B4 \uBAAB\uC758 \uC2DD\uB7C9\uACFC \uBB3C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459995
    m_Localized: "\uC1A1\uC608\uC9C0: \uC608\uC804\uCC98\uB7FC \uADF8\uB0E5\u2026 \uC870\uC6A9\uD788 \uBE60\uC9C0\uBA74 \uB3FC. \uADF8\uAC74 \uC798\uD558\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459994
    m_Localized: "\uC1A1\uC608\uC9C0: \uB2E4\uB4E4 \uBC14\uC058\uAC8C \uC6C0\uC9C1\uC774\uB294\uB370, \uB098\uB9CC \uC790\uB9AC \uCC28\uC9C0\uD558\uACE0 \uC788\uC796\uC544. \uB098\uB294 \uADF8\uB9BC\uBC16\uC5D0 \uBABB \uADF8\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459993
    m_Localized: "\uC1A1\uC608\uC9C0: \uBA39\uC744 \uAC83\uB3C4 \uC5C6\uB294\uB370 \uC4F8\uBAA8\uC5C6\uB294 \uC0AC\uB78C\uAE4C\uC9C0 \uC788\uC73C\uBA74 \uC548 \uB418\uC796\uC544. \uB098\uB294 \uADF8\uB9BC\uBC16\uC5D0 \uBABB \uADF8\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459992
    m_Localized: "\uC1A1\uC608\uC9C0: \uB098 \uC5EC\uAE30 \uC788\uB294 \uAC70, \uB2E4\uB4E4 \uBD88\uD3B8\uD558\uC796\uC544. \uCC98\uC74C\uBD80\uD130 \uADF8\uB7AC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459991
    m_Localized: "\uC1A1\uC608\uC9C0\uAC00 \uB3C4\uC11C\uC2E4 \uAD6C\uC11D\uC5D0\uC11C \uC9D0\uC744 \uC2F8\uACE0 \uC788\uC5C8\uB2E4. \uC2A4\uCF00\uCE58\uBD81 \uD55C \uAD8C, \uC5F0\uD544 \uBA87 \uC790\uB8E8, \uBB3C \uD55C \uBCD1."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826557
    m_Localized: "\uACB0\uAD6D \uC544\uBB34\uAC83\uB3C4 \uC4F0\uC9C0 \uC54A\uACE0 \uACF5\uCC45\uC744 \uB3CC\uB824\uC8FC\uC5C8\uB2E4. \uB2E4\uB9CC \uCCAB \uC7A5 \uD55C\uAC00\uC6B4\uB370 \uC5F0\uD544 \uC790\uAD6D \uD558\uB098\uAC00 \uAFB9 \uB20C\uB824 \uC788\uC5C8\uB2E4. \uBB34\uC5B8\uAC00\uB97C \uC4F0\uB824\uB2E4 \uBA48\uCD98 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706545
    m_Localized: "\uC624\uB298\uC740 \uC880\u2026 \uB2E4\uC74C\uC5D0 \uAC00\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706546
    m_Localized: "{0}: \uCE58. \uADF8\uB7FC \uB0B4\uC77C\uC740 \uBB34\uC870\uAC74\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459987
    m_Localized: "\uBCF4\uB0B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459986
    m_Localized: "\uB3C4\uD604\uC740 \uD604\uAD00 \uD2C8\uC73C\uB85C \uBE60\uC838\uB098\uAC14\uB2E4. \uAD50\uBB38 \uCC3D\uC0B4\uC758 \uD30C\uB780 \uB9AC\uBCF8\uC774 \uD558\uB098 \uB298\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459985
    m_Localized: "\uB3C4\uD604: \uB9E8\uB0A0 \uC5B8\uC820\uAC00\uB798\uC694. \uC5B8\uC820\uAC00\uB294 \uC548 \uC640\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459984
    m_Localized: "\uB3C4\uD604\uC740 \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459983
    m_Localized: "\uB3C4\uD604: {0} \uB204\uB098\uB791 \uC788\uC73C\uBA74\uC694\u2026 \uC9C4\uC9DC\uB85C \uCC3E\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694. \uC5C4\uB9C8\uB3C4, \uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459982
    m_Localized: "\uB3C4\uD604: \u2026\uAE30\uC5B5\uD558\uACE0 \uC788\uC5C8\uC5B4\uC694? \uAE4C\uBA39\uC740 \uC904 \uC54C\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459981
    m_Localized: "\uB3C4\uD604\uC758 \uC5B4\uAE68\uAC00 \uB0B4\uB824\uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459980
    m_Localized: "{0}: \uC5C4\uB9C8 \uCC3E\uC73C\uB7EC \uAC00\uB294 \uAC74, \uAC19\uC774 \uAC00\uAE30\uB85C \uD588\uC796\uC544. \uD63C\uC790 \uB9D0\uACE0. \uC57D\uC18D\uD588\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459979
    m_Localized: "\uB0A8\uC544 \uB2EC\uB77C\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459978
    m_Localized: "\uB3C4\uD604: \u2026\uADF8\uB7FC \uC774\uBC88 \uC8FC \uB9DD\uC740 \uC81C\uAC00 \uB2E4 \uBCFC\uAC8C\uC694. \uB300\uC2E0 \uB204\uB098\uB3C4 \uC800 \uC880 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459977
    m_Localized: "\uB3C4\uD604\uC740 \uBD09\uC9C0\uB97C \uBC1B\uC544 \uB4E4\uACE0 \uD55C\uCC38 \uC11C \uC788\uC5C8\uB2E4. \uC6B4\uB3D9\uD654 \uB048\uC744 \uB2E4\uC2DC \uD480\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459976
    m_Localized: "{0}: \uC774\uAC70 \uBA39\uC5B4. \uADF8\uB9AC\uACE0 \uAC00\uC9C0 \uB9C8. \uB124\uAC00 \uC5C6\uC73C\uBA74 \uCC3D\uAC00 \uC790\uB9AC\uAC00 \uBE44\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459975
    m_Localized: "\uB0B4 \uBAAB\uC758 \uC2DD\uB7C9\uACFC \uBB3C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459974
    m_Localized: "\uB3C4\uD604: \uB204\uB098\uB294 \uB9E8\uB0A0 \uC800 \uC548 \uBCF4\uC796\uC544\uC694. \uC788\uC73C\uB098 \uC5C6\uC73C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459973
    m_Localized: "\uB3C4\uD604: \uC5EC\uAE30 \uC788\uC5B4 \uBD24\uC790 \uC800 \uD560 \uC77C\uB3C4 \uC5C6\uC796\uC544\uC694. \uB9E8\uB0A0 \uCC3D\uAC00\uC5D0 \uC549\uC544\uB9CC \uC788\uACE0. \uADF8\uB7F4 \uBC14\uC5D4 \uC5C4\uB9C8 \uCC3E\uC73C\uB7EC \uAC08\uB798\uC694. \uB300\uD53C\uC18C \uCABD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459972
    m_Localized: "\uB3C4\uD604: \uC5EC\uAE30 \uC788\uC5B4 \uBD24\uC790 \uBA39\uC744 \uAC83\uB3C4 \uC5C6\uC796\uC544\uC694. \uC800 \uD558\uB098 \uC5C6\uC73C\uBA74 \uC880 \uB0AB\uC8E0. \uADF8\uB9AC\uACE0 \uC5C4\uB9C8 \uCC3E\uC73C\uB7EC \uAC08 \uAC70\uC608\uC694. \uB300\uD53C\uC18C \uCABD\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459971
    m_Localized: "\uB3C4\uD604: \u2026\uAE7C\uC5B4\uC694? \uC870\uC6A9\uD788 \uAC00\uB824\uACE0 \uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459970
    m_Localized: "\uB3C4\uD604\uC774 \uC6B4\uB3D9\uD654 \uB048\uC744 \uB9E4\uACE0 \uC788\uC5C8\uB2E4. \uAC00\uBC29\uC774 \uBD88\uB8E9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459969
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB3C4\uD604\uC758 \uC790\uB9AC\uAC00 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uD604\uAD00 \uCABD\uC5D0\uC11C \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826558
    m_Localized: "\uC120\uBC30\uB294 \uADF8 \uB9D0\uC744 \uB2E4 \uB4E3\uACE0\uB3C4 \uD45C\uC815\uC774 \uBCC0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB9CC \uC9D0 \uB048\uC744 \uC954 \uC190\uAC00\uB77D \uB9C8\uB514\uAC00 \uD558\uC597\uAC8C \uC9C8\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706547
    m_Localized: "\uC885\uC774 \uC6B8\uB838\uB2E4. {0}\uAC00 \uB2E4\uB978 \uBC18 \uCABD\uC73C\uB85C \uC190\uC744 \uD754\uB4E4\uBA70 \uB6F0\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459966
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uAF2D \uC548\uC558\uB2E4. \uC18C\uB3C5\uC57D \uB0C4\uC0C8\uAC00 \uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459965
    m_Localized: "{0}: \uB530\uB2D8, \uAF2D \uCC3E\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459964
    m_Localized: "\uBCF4\uB0B4 \uB4DC\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459963
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC57D \uC0C1\uC790 \uBC18\uC744 \uB0A8\uAE30\uACE0, \uD574\uAC00 \uB728\uAE30 \uC804\uC5D0 \uAD50\uBB38\uC744 \uB098\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459962
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBBF8\uC548\uD574. \uB108\uB294 \uC798\uD558\uACE0 \uC788\uC5B4. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459961
    m_Localized: "\uB0B4 \uB9D0\uC740 \uC120\uC0DD\uB2D8\uC758 \uACC4\uC0B0\uC744 \uC774\uAE30\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459960
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: {0}. \uB108 \uBCF4\uACE0 \uC788\uC73C\uBA74, \uC774\uC0C1\uD558\uAC8C \uB0B4\uC77C \uACC4\uC0B0\uC744 \uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459959
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uADF8 \uC22B\uC790\uB97C \uBE7C\uBA39\uC5C8\uB124. \uB0B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459958
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC190\uC744 \uBA48\uCDC4\uB2E4. \uC624\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459957
    m_Localized: "{0}: \uC120\uC0DD\uB2D8\uC774 \uAC00\uBA74 \uB2E4\uC74C\uC5D0 \uB2E4\uCE58\uB294 \uC0AC\uB78C\uC740 \uB204\uAC00 \uBD10\uC694. \uACC4\uC0B0\uC5D0 \uADF8\uAC83\uB3C4 \uB123\uC5B4 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459956
    m_Localized: "\uB0A8\uC544 \uB2EC\uB77C\uACE0 \uC124\uB4DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459955
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \u2026\uBC18\uCE59\uC774\uC57C, \uC774\uAC70. \uBC1B\uC73C\uBA74 \uAC08 \uC218\uAC00 \uC5C6\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459954
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uBD09\uC9C0\uB97C \uD55C\uCC38 \uBCF4\uB2E4\uAC00, \uB098\uB220 \uB193\uC740 \uC57D \uC0C1\uC790\uB97C \uB3C4\uB85C \uD55C \uBB34\uB354\uAE30\uB85C \uD569\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459953
    m_Localized: "{0}: \uC774\uAC70 \uC81C \uBAAB\uC774\uC5D0\uC694. \uC120\uC0DD\uB2D8 \uC5C6\uC73C\uBA74 \uC57D \uACC4\uC0B0\uC740 \uB204\uAC00 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459952
    m_Localized: "\uB0B4 \uBAAB\uC758 \uC2DD\uB7C9\uACFC \uBB3C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459951
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uADF8\uB9AC\uACE0\u2026 \uB538 \uC788\uB294 \uCABD\uC73C\uB85C \uAC00 \uBCF4\uACE0 \uC2F6\uC5B4. \uC5EC\uAE30\uC11C \uC544\uBB34\uB3C4 \uB098\uB97C \uBD99\uC7A1\uC744 \uC774\uC720\uAC00 \uC5C6\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459950
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC694\uC998 \uBCF4\uAC74\uC2E4 \uBB38 \uB450\uB4DC\uB9AC\uB294 \uC0AC\uB78C\uC774 \uC5C6\uB354\uB77C. \uB2E4\uB4E4 \uC54C\uC544\uC11C \uC798 \uC9C0\uB0B4. \uACC4\uC0B0\uD574 \uBCF4\uBA74 \uADF8\uB798. \uC5EC\uAE34 \uB098 \uC5C6\uC774\uB3C4 \uB3CC\uC544\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459949
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uC774\uB807\uAC8C \uBC84\uD2F0\uB2E4\uAC00 \uB2E4 \uAC19\uC774 \uAD76\uC5B4. \uC785 \uD558\uB098 \uC904\uBA74 \uB108\uD76C\uAC00 \uBA70\uCE60 \uB354 \uAC00. \uACC4\uC0B0\uD574 \uBCF4\uBA74 \uADF8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459948
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBC18\uC740 \uB450\uACE0 \uAC00. \uB098\uBA38\uC9C0 \uBC18\uC740 \uB0B4\uAC00 \uB4E4\uACE0 \uAC08 \uC218 \uC788\uC744 \uB9CC\uD07C\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459947
    m_Localized: "\uC544\uCE68, \uBC15 \uC120\uC0DD\uB2D8\uC774 \uBCF4\uAC74\uC2E4 \uC57D\uC7A5\uC744 \uBE44\uC6B0\uACE0 \uC788\uC5C8\uB2E4. \uC57D \uC0C1\uC790\uB4E4\uC744 \uB450 \uBB34\uB354\uAE30\uB85C \uB098\uB204\uC5B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826559
    m_Localized: "\uB0B4\uC77C\uB3C4, \uBAA8\uB808\uB3C4, \uB9E1\uAE30\uB294 \uC77C\uC774 \uC788\uC73C\uBA74 \uC120\uBC30\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC77C \uAC83\uC774\uB2E4. \uADF8\uB9AC\uACE0 \uACE7\uC798 \uD574\uB0BC \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459945
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB2C8\uAE4C \uC774\uBC88\uC5D4 \uC81C\uB300\uB85C \uBA54\uC790. \u2026\uB098\uAC00\uBA74, \uC5B4\uB514\uB4E0 \uADF8 \uAC00\uBC29 \uBA54\uACE0 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459944
    m_Localized: "{0}: \uC800\uB3C4 \uADF8\uB7AC\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459943
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC218\uD559\uC5EC\uD589 \uC778\uC194\uD558\uBA74 \uADF8\uAC8C \uC77C\uC774\uC57C. \uB2E4\uB4E4 \uAC00\uBC29\uC744 \uC5B4\uAE68\uC5D0\uB9CC \uAC78\uACE0 \uC624\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459942
    m_Localized: "{0}: \uC120\uC0DD\uB2D8 \uC774\uB7F0 \uAC83\uB3C4 \uC54C\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459941
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB4A4\uC5D0\uC11C \uB048\uC744 \uB2F9\uACA8 \uC8FC\uC5C8\uB2E4. \uBAB8\uC774 \uD55C\uACB0 \uACE7\uAC8C \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459940
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uD5C8\uB9AC\uB048\uC744 \uC870\uC5EC\uC57C \uD574. \uBB34\uAC8C\uB294 \uC5B4\uAE68\uAC00 \uC544\uB2C8\uB77C \uACE8\uBC18\uC73C\uB85C \uC9C0\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459939
    m_Localized: "\uCC98\uC74C \uBA54\uC5B4 \uBCF4\uB2C8, \uD559\uAD50 \uAC00\uBC29\uBCF4\uB2E4 \uD6E8\uC52C \uBB34\uAC70\uC6B4\uB370 \uC774\uC0C1\uD558\uAC8C \uB35C \uD798\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459938
    m_Localized: "\uC5B4\uAE68\uB048\uC740 \uC548\uC804\uBCA8\uD2B8\uB97C \uC798\uB77C \uC37C\uB2E4. \uB4F1\uC5D0 \uB2FF\uB294 \uC790\uB9AC\uC5D0\uB294 \uCCB4\uC721\uAD00 \uB9E4\uD2B8 \uC870\uAC01\uC744 \uB367\uB314\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459937
    m_Localized: "\uAC00\uC0AC\uC2E4 \uC7AC\uBD09\uD2C0 \uC55E\uC5D0\uC11C \uC0AC\uD758\uC744 \uBCF4\uB0C8\uB2E4. \uC54C\uB8E8\uBBF8\uB284 \uC758\uC790 \uB2E4\uB9AC \uB450 \uAC1C\uB97C \uAD6C\uBD80\uB824 \uD2C0\uC744 \uB9CC\uB4E4\uACE0, \uB450\uAEBC\uC6B4 \uCEE4\uD2BC \uCC9C\uC73C\uB85C \uC8FC\uBA38\uB2C8\uB97C \uC9C0\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826560
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uB9D0\uC744 \uD558\uACE0 \uC7A0\uAE50, \uC790\uAE30 \uBB34\uB98E \uC544\uB798\uB97C \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459935
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC138\uC0C1\uC774 \uC774\uB807\uAC8C \uB410\uB294\uB370\uB3C4, \uC544\uCE68\uC774 \uC624\uBA74 \uBB3C\uC774 \uC788\uB2E4. \uC774\uB7F0 \uAC8C \uD558\uB098\uC529 \uB298\uC5B4\uB098\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459934
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB798. \uADF8\uB9AC\uACE0 \uC774\uC81C \uD558\uB098 \uB354 \uC0DD\uACBC\uB2E4. \uC544\uCE68\uC774 \uC624\uBA74 \uBB3C\uC774 \uC788\uB2E4\uB294 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459933
    m_Localized: "{0}: \uC548 \uBC14\uB00C\uB294 \uAC8C \uC788\uB2E4\uB294 \uAC70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459932
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8 \uBB38\uC7A5 \uAE30\uC5B5\uB098? \uBB3C\uC740 1\uAE30\uC555\uC5D0\uC11C 100\uB3C4\uC5D0 \uB053\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459931
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB2F9\uBC88\uC740 \uACC4\uC18D. \uAE30\uACC4\uB3C4 \uC544\uD50C \uB54C\uAC00 \uC788\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459930
    m_Localized: "{0}: \uC774\uC81C \uC815\uC218 \uB2F9\uBC88 \uC548 \uD574\uB3C4 \uB3FC\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459929
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC544\uBB34\uB3C4 \uC548 \uAE7C\uB294\uB370 \uBB3C\uC774 \uC0DD\uACBC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459928
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uCEF5\uC5D0 \uBB3C\uC744 \uBC1B\uC544 \uD587\uBE5B\uC5D0 \uBE44\uCDB0 \uBCF4\uC558\uB2E4. \uC544\uBB34\uAC83\uB3C4 \uB5A0\uB2E4\uB2C8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459927
    m_Localized: "\uC790\uC804\uAC70 \uBC1C\uC804\uAE30\uC5D0 \uC774\uC5B4 \uB454 \uAE30\uACC4\uAC00 \uBC24\uC0C8 \uD63C\uC790\uC11C \uBE57\uBB3C\uC744 \uAC78\uB7EC \uB193\uC740 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459926
    m_Localized: "\uD50C\uB77C\uC2A4\uD2F1 \uD1B5 \uB450 \uAC1C \uC0AC\uC774\uB85C \uD638\uC2A4\uAC00 \uC774\uC5B4\uC838 \uC788\uACE0, \uC544\uB798 \uD1B5\uC5D0 \uB9D1\uC740 \uBB3C\uC774 \uBC18\uCBE4 \uCC28 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459925
    m_Localized: "\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uB2C8 \uACFC\uD559\uC2E4\uC5D0\uC11C \uB0AE\uAC8C \uC6C5\uC6C5\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826561
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC218\uAC74 \uD55C \uC7A5\uC744 \uC811\uC5B4 \uC591\uB3D9\uC774 \uC704\uC5D0 \uAC78\uCCD0 \uB450\uC5C8\uB2E4. \uBE57\uBB3C\uC740 \uC815\uC218\uD558\uBA74 \uB9C8\uC2E4 \uBB3C\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459923
    m_Localized: "\uC591\uB3D9\uC774\uB294 \uADF8\uB0E5 \uC591\uB3D9\uC774\uB85C \uB0A8\uC558\uB2E4. \uBC14\uB78C\uC774 \uBD88\uC790, \uAE61\uD1B5\uC774 \uB610 \uB2EC\uADF8\uB77D\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459922
    m_Localized: "\uB098\uB294 \uB9E4\uC9C1 \uB69C\uAED1\uC744 \uB2E4\uC2DC \uB2EB\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459921
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5BC\uAD74\uC744 \uADF8\uB824 \uB193\uC73C\uBA74\u2026 \uBC24\uB9C8\uB2E4 \uC800\uAE30 \uB204\uAC00 \uC11C \uC788\uB294 \uAC83 \uAC19\uC744 \uAC70\uC57C. \uC6B0\uB9AC\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459920
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC0AC\uB78C \uAC19\uC73C\uB77C\uACE0 \uC138\uC6B0\uB294 \uAC70 \uC544\uB2C8\uC796\uC544. \uC800\uAC83\uB4E4 \uBC1C\uC744 \uC7A0\uAE50 \uBD99\uC7A1\uC544 \uB450\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459919
    m_Localized: "{0}: \uC65C\uC694? \uADF8\uB798\uC57C \uB354 \uC0AC\uB78C \uAC19\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459918
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uAC74 \uD558\uC9C0 \uB9D0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459917
    m_Localized: "\uB098\uB294 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uB9E4\uC9C1\uC744 \uAEBC\uB0C8\uB2E4. \uC591\uB3D9\uC774\uC5D0 \uB208\uC774\uB77C\uB3C4 \uADF8\uB824 \uB123\uC744\uAE4C \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459916
    m_Localized: "\uAD50\uBB38 \uC55E \uCCA0\uCC45\uC5D0 \uADF8\uAC83\uC744 \uB2E8\uB2E8\uD788 \uB3D9\uC5EC\uB9F8\uB2E4. \uBA40\uB9AC\uC11C \uBCF4\uBA74, \uB204\uAC00 \uC11C \uC788\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459915
    m_Localized: "\uBA38\uB9AC \uC790\uB9AC\uC5D0\uB294 \uCC0C\uADF8\uB7EC\uC9C4 \uC591\uB3D9\uC774\uB97C \uC50C\uC6E0\uB2E4. \uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uC18D\uC5D0 \uB9E4\uB2E8 \uAE61\uD1B5\uC774 \uB2EC\uADF8\uB77D\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459914
    m_Localized: "\uB9C8\uB300 \uC790\uB8E8\uC5D0 \uB0A1\uC740 \uCCB4\uC721\uBCF5\uC744 \uCC44\uC6B0\uACE0, \uB300\uAC78\uB808 \uC790\uB8E8 \uB450 \uAC1C\uB97C \uC2ED\uC790\uB85C \uBB36\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826562
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uB0B4\uC77C\uB3C4 \uD558\uC790. \uD560\uC218\uB85D \uB298 \uAC70\uC57C. \uAD6D\uC5B4\uB3C4, \uC694\uB9AC\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459912
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC624\uB298\uBD80\uD130 \uC5EC\uAE30\uB97C \uC791\uC5C5\uB300\uB77C\uACE0 \uBD80\uB974\uC790. \uC774\uB984\uC744 \uBD99\uC774\uBA74 \uADF8\uAC8C \uC0DD\uAE30\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459911
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC5F4\uC1E0\uB294 \uAE4E\uC9C0 \uB9D0\uACE0. \uC77C\uB2E8\uC740 \uC758\uC790 \uB2E4\uB9AC\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459910
    m_Localized: "\uB3C4\uD604: \uC774\uAC70\u2026 \uC904\uCE7C \uB9DE\uC8E0? \uD615\uC774 \uC774\uAC78\uB85C \uC5F4\uC1E0 \uAE4E\uB294 \uAC70 \uBCF8 \uC801 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459909
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC190\uBC14\uB2E5\uC73C\uB85C \uCC45\uC0C1 \uC704\uB97C \uC4F8\uC5C8\uB2E4. \uD1B1\uBC25 \uB300\uC2E0 \uBA3C\uC9C0\uAC00 \uBB3B\uC5B4 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459908
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uADF8\uB7EC\uB124. \uB098\uB3C4 \uADF8 \uC2DC\uAC04\uC5D4 \uAD50\uBB34\uC2E4\uC5D0\uC11C \uC878\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459907
    m_Localized: "{0}: \uAE30\uC220 \uC2DC\uAC04\uC5D4 \uB2E4\uB4E4 \uC7A4\uC73C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459906
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \uC774\uAC8C \uB2E4 \uAE30\uC220\uC2E4\uC5D0 \uC788\uC5C8\uB2E4\uACE0? \uB098\uB294 \uD55C \uBC88\uB3C4 \uBABB \uBD24\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459905
    m_Localized: "\uAE30\uC220 \uC120\uC0DD\uB2D8 \uC0AC\uBB3C\uD568\uC5D0\uC11C \uB098\uC628 \uACF5\uAD6C\uB97C \uD558\uB098\uC529 \uBCBD\uC5D0 \uAC78\uC5C8\uB2E4. \uB9DD\uCE58, \uD1B1, \uD39C\uCE58, \uC774\uB984 \uBAA8\uB97C \uC904\uCE7C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891454459904
    m_Localized: "\uCC3D\uACE0 \uAD6C\uC11D\uC758 \uCCA0\uC81C \uCC45\uC0C1 \uB450 \uAC1C\uB97C \uBD99\uC774\uACE0, \uB2E4\uB9AC\uB9C8\uB2E4 \uB098\uBB34\uD1A0\uB9C9\uC744 \uAD34\uC5B4 \uB192\uC774\uB97C \uB9DE\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826563
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uADF8 \uBB38\uC7A5 \uC544\uB798\uC5D0 \uC5F0\uD544\uB85C \uBC11\uC904\uC744 \uADF8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654426
    m_Localized: "{0}: \uADF8\uB7FC \uC81C\uC77C \uC790\uC2E0 \uC788\uB294 \uACFC\uBAA9\uC740?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654427
    m_Localized: "\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706318
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8: \u2026{0}, \uB108 \uADF8\uAC70 \uC88B\uC544\uD558\uB294\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706317
    m_Localized: "\uC624\uB298\uC740 \uC544\uBB34\uAC83\uB3C4 \uACE0\uCE58\uB824 \uD558\uC9C0 \uC54A\uACE0 \uB0B4 \uB9C8\uC74C\uC744 \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBD24\uB2E4. \uC774\uC0C1\uD558\uAC8C \uB35C \uBB34\uC11C\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706316
    m_Localized: "\uADF8\uB9AC\uACE0 \uAC00\uBC29\uC5D0\uC11C \uB0A8\uC740 \uAE30\uD0C0 \uC904 \uD55C \uAFB8\uB7EC\uBBF8\uB97C \uAEBC\uB0B4 \uB0B4 \uC190\uC5D0 \uC950\uC5EC \uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706315
    m_Localized: "\uC120\uBC30\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826508
    m_Localized: "\uADF8\uB798\uB3C4 \uAE09\uC2DD\uC740 \uAC00\uB054 \uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uC55E\uC5D0 \uB098\uD0C0\uB0AC\uB2E4. \uBC16\uC5D0\uC11C, \uC81C \uBC29\uC2DD\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654433
    m_Localized: "{0}: \uC544 \uB9DE\uB2E4, \uC624\uB298 \uB3D9\uC544\uB9AC \uC2E0\uCCAD \uB9C8\uAC10\uC774\uC796\uC544. \uB108 \uC5B4\uB514 \uB123\uC5C8\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654434
    m_Localized: "\uC721\uC0C1\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654435
    m_Localized: "\uC694\uB9AC\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654436
    m_Localized: "\uACFC\uD559\uD0D0\uAD6C\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654437
    m_Localized: "\uB3C4\uC11C\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706314
    m_Localized: "{0}: \uC798 \uAC00\uC694, \uC120\uBC30."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706313
    m_Localized: "\uBCF4\uB0B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706312
    m_Localized: "\uCD5C\uD558\uB9B0: \uC751. \uB108\uB3C4. \uADF8\uB9AC\uACE0 \uBBF8\uC548. \uC774\uBC88\uC5D4 \uC9C4\uC9DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706311
    m_Localized: "{0}: \u2026\uC870\uC2EC\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826507
    m_Localized: "\uADF8\uB0A0 \uC800\uB141, \uAD1C\uD788 \uAE09\uC2DD\uC2E4 \uB4B7\uBB38 \uCABD\uC744 \uBA87 \uBC88 \uB3CC\uC544\uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654443
    m_Localized: "\uAD50\uBB38 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4. \uB9DE\uC740\uD3B8\uC5D0\uC11C \uB0AF\uC775\uC740 \uBB34\uB9AC\uAC00 \uAC78\uC5B4\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654444
    m_Localized: "\uAC19\uC740 \uC911\uD559\uAD50\uC5D0\uC11C \uC62C\uB77C\uC628 \uC560\uB4E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC774\uCABD\uAE4C\uC9C0 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654445
    m_Localized: "{0}\uC758 \uD45C\uC815\uC774 \uAD73\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654446
    m_Localized: "{0}: \u2026\uC7E4\uB124 \uB610 \uADF8\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654447
    m_Localized: "\"\uAD1C\uCC2E\uC544.\" \uD558\uACE0 \uC6C3\uC5B4\uB118\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654448
    m_Localized: "\uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uD558\uB294 \uAC74 \uC0DD\uAC01\uBCF4\uB2E4 \uC26C\uC6E0\uB2E4. \uB298 \uADF8\uB7AC\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654449
    m_Localized: "\uACE0\uAC1C\uB97C \uC219\uC774\uACE0 \uAC78\uC74C\uC744 \uC7AC\uCD09\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654450
    m_Localized: "\uC2E0\uD638\uAC00 \uBC14\uB00C\uC790\uB9C8\uC790 \uBA3C\uC800 \uAC74\uB11C\uB2E4. \uB4A4\uB97C \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706310
    m_Localized: "\uBCF4\uB0B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706309
    m_Localized: "\uD558\uB9B0\uC740 \uADF8\uB0A0 \uBC24 \uAD50\uBB38\uC744 \uB098\uC130\uB2E4. \uB4A4\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706308
    m_Localized: "\uC1A1\uC608\uC9C0: \u2026\uC751. \uB108\uB3C4. \uC77C\uAE30 \uACC4\uC18D \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706307
    m_Localized: "{0}: \uC5B4\uB514 \uAC00\uB4E0, \uADF8\uB9BC\uC740 \uACC4\uC18D \uADF8\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826506
    m_Localized: "\uC0B4\uC544 \uC788\uC5C8\uAD6C\uB098. \uADF8 \uACE8\uBAA9\uC5D0\uC11C \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uAD6C\uB098. \uADF8\uAC83\uB9CC\uC73C\uB85C \uC870\uAE08 \uB9C8\uC74C\uC774 \uB193\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654456
    m_Localized: "\uBA40\uB9AC\uC11C \uAD6C\uAE09\uCC28 \uC0AC\uC774\uB80C\uC774 \uAE38\uAC8C \uC6B8\uB838\uB2E4. \uC624\uB298 \uC544\uCE68\uC5D0\uB9CC \uBC8C\uC368 \uC138 \uBC88\uC9F8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654457
    m_Localized: "{0}: \uC694\uC998 \uC5F4\uBCD1 \uB3C8\uB300. \uC606 \uBC18 \uC560\uB3C4 \uACB0\uC11D\uD588\uB2E4\uB358\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654458
    m_Localized: "{0}: \uC544\uBB34\uD2BC! \uBC29\uACFC \uD6C4\uC5D0 \uB5A1\uBCF6\uC774 \uCF5C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654459
    m_Localized: "\uCF5C. \uC218\uC5C5 \uB05D\uB098\uACE0 \uAD50\uBB38 \uC55E\uC5D0\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706306
    m_Localized: "\uBCF4\uB0B4 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706305
    m_Localized: "\uB3C4\uD604\uC774 \uACF5\uCC45\uC744 \uAEBC\uB0B4 \uD55C \uC7A5\uC744 \uCC22\uC5B4 \uB0B4\uAC8C \uC8FC\uC5C8\uB2E4. \uC6B4\uB3D9\uC7A5 \uADF8\uB9BC\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706304
    m_Localized: "{0}: \uC870\uC2EC\uD574. \uD070\uAE38 \uB9D0\uACE0 \uACE8\uBAA9\uC73C\uB85C. \uB124 \uACF5\uCC45\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 2291159929208832
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8: \uBD95\uB300\uB294 \uC0B6\uC544\uC11C \uB2E4\uC2DC \uC368. \uC78A\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 2293898142826505
    m_Localized: "\uB204\uAC00 \uB450\uACE0 \uAC14\uB294\uC9C0\uB294 \uB05D\uB0B4 \uC54C \uC218 \uC5C6\uC5C8\uB2E4. \uCABD\uC9C0\uB294 \uBC29\uC1A1\uC2E4 \uBCBD, \uB2E4\uB978 \uC774\uB984\uB4E4 \uC606\uC5D0 \uBD99\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654465
    m_Localized: "\uC218\uC5C5\uC740 \uC774\uC0C1\uD558\uAC8C \uAE38\uC5C8\uB2E4. \uBE48\uC790\uB9AC\uAC00 \uBA87 \uAC1C \uB354 \uB298\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654466
    m_Localized: "\uBC29\uACFC \uD6C4, \uCCB4\uC721\uBD80\uC7A5 \uC2EC\uBD80\uB984\uC73C\uB85C \uCCB4\uC721\uAD00 \uCC3D\uACE0\uC5D0 \uACF5\uC744 \uAC16\uB2E4 \uB193\uC73C\uB7EC \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654467
    m_Localized: "\uB4F1 \uB4A4\uC5D0\uC11C \uBB38\uC774 \uB2EB\uD788\uB294 \uC18C\uB9AC. \uADF8\uB9AC\uACE0 \uBC14\uAE65\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uAC78\uB9AC\uB294 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1947891458654468
    m_Localized: "\"\uC57C, \uC5F4\uC5B4 \uC918.\" \uB300\uB2F5 \uB300\uC2E0 \uBA40\uC5B4\uC9C0\uB294 \uC6C3\uC74C\uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160004706548
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160042455040
    m_Localized: "\uADF8\uB9AC\uACE0 \uD559\uAD50\uAC00 \uC870\uC6A9\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2291160042455041
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2291160042455042
