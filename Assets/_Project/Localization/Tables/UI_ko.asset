    m_Localized: "{0}: \uC54C \uC218 \uC5C6\uB294 \uD589\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283278
    m_Localized: "{0}: \uC774 \uC2DC\uAC04\uB300\uC5D0 \uD560 \uC218 \uC5C6\uB294 \uD589\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283279
    m_Localized: "{0}: \uAC15\uC81C \uD734\uC2DD \uC704\uBC18 (\uD53C\uB85C\xB7\uC2A4\uD2B8\uB808\uC2A4\xB7\uC218\uBA74 \uBD80\uCC44)"
