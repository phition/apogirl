      m_Items: []
  - m_Id: 1306936288231428
    m_Localized: "\uC81C\uBAA9 \"(\uC81C\uBAA9 \u2014 \uC9C1\uC811 \uC785\uB825)\"\uACFC \uBA54\uBAA8\xB7\uBC29\uD5A5\uC131\uC744 \uACE0\uCE5C \uB4A4 \uBD99\uC774\uC138\uC694. \uBB38\uC11C \uB9E8 \uC544\uB798\uC5D0 \uBD99\uACE0, \uCEE4\uBC0B\uC740 \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1306936288231429
    m_Localized: "\uBD99\uC774\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1306936288231430
    m_Localized: "#{0}\uC744 \uBD99\uC600\uC2B5\uB2C8\uB2E4 \u2192 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1306936288231431
    m_Localized: "\uCD08\uC548\uC744 \uB0A8\uACBC\uC2B5\uB2C8\uB2E4 \u2192 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1445737610362880
    m_Localized: "{1}, \uB108\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uD76C\uB9DD\uC774 \uB290\uAEF4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1445737664888832
    m_Localized: "{1}, \uB108\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uD76C\uB9DD\uC774 \uB290\uAEF4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1445737664888833
    m_Localized: "{0} \uB204\uB098\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uD76C\uB9DD\uC774 \uB290\uAEF4\uC838\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1445737664888834
    m_Localized: "{1}, \uB108\uB791 \uAC19\uC774 \uC788\uC73C\uBA74\u2026 \uD76C\uB9DD\uC774 \uB290\uAEF4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1445737664888835
    m_Localized: "{2}. \uB108\uB791 \uC788\uC73C\uBA74, \uD76C\uB9DD \uAC19\uC740 \uAC8C \uB290\uAEF4\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 1445737664888836
    m_Localized: "(\uCE60\uD310\uC5D0) {0}, \uAC19\uC774 \uC788\uC73C\uBA74 \uD76C\uB9DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532032
    m_Localized: "{given:\uC740/\uB294} \uC9C0\uAE08\uB3C4 \uC798 \uC6C3\uB294\uB2E4. \uADF8 \uC6C3\uC74C\uC5D0 \uAE30\uB300\uC5B4 \uBC84\uD2F4 \uC0AC\uB78C\uC774, {given} \uB9D0\uACE0\uB3C4 \uC5EC\uB7FF\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532033
    m_Localized: "{given}\uC758 \uB18D\uB2F4\uC740 \uC7AC\uAC74 \uCEA0\uD504\uC5D0\uC11C\uB3C4 \uC720\uBA85\uD588\uB2E4. \uB2E4\uB9CC \uC774\uC81C\uB294, \uC6C3\uACE0 \uC2F6\uC744 \uB54C\uB9CC \uC6C3\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532034
    m_Localized: "\uC9C0\uAE08\uB3C4 \uAC00\uB054 '\uAD1C\uCC2E\uC544'\uAC00 \uBA3C\uC800 \uB098\uC628\uB2E4. \uADF8\uB7EC\uBA74 {given:\uC740/\uB294} \uC7A0\uAE50 \uBA48\uCDC4\uB2E4\uAC00, \uC9C4\uC9DC \uB300\uB2F5\uC744 \uB367\uBD99\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532035
    m_Localized: "\uC0AC\uC9C4 \uC18D\uC758 {given:\uC740/\uB294} \uC544\uC9C1 \uB298 \uC6C3\uACE0 \uC788\uB2E4. \uADF8 \uC6C3\uC74C \uB4A4\uC758 \uC5BC\uAD74\uC744 \uC544\uB294 \uC0AC\uB78C\uC740 \uC544\uC9C1 \uB9CE\uC9C0 \uC54A\uB2E4. \uADF8\uB798\uB3C4 \uD55C \uBA85\uC740 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532036
    m_Localized: "{given:\uC740/\uB294} \uC9C0\uAE08\uB3C4 \uAC78\uC74C\uC774 \uBE60\uB974\uB2E4. \uC5B4\uB290 \uAC74\uBB3C\uC5D0 \uB4E4\uC5B4\uAC00\uB4E0 \uCD9C\uAD6C\uBD80\uD130 \uD655\uC778\uD558\uB294 \uBC84\uB987\uB3C4 \uADF8\uB300\uB85C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532037
    m_Localized: "\uC7AC\uAC74 \uCEA0\uD504\uC758 \uB300\uD53C \uD6C8\uB828\uC5D0\uC11C, \uBB38\uC744 \uC81C\uC77C \uBA3C\uC800 \uC5F4\uACE0 \uC81C\uC77C \uB9C8\uC9C0\uB9C9\uC5D0 \uB2EB\uB294 \uC77C\uC740 \uB298 {given:\uC774/\uAC00} \uB9E1\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532038
    m_Localized: "\uC694\uC998 {given:\uC740/\uB294} \uC77C\uBD80\uB7EC \uCC9C\uCC9C\uD788 \uAC77\uB294\uB2E4. \uC606 \uC0AC\uB78C\uACFC \uBCF4\uD3ED\uC774 \uB9DE\uC744 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532039
    m_Localized: "\uC544\uC9C1\uB3C4 \uAC00\uB054, \uC774\uC720 \uC5C6\uC774 \uAC78\uC74C\uC774 \uBE68\uB77C\uC9C4\uB2E4. \uADF8\uB7F4 \uB54C\uBA74 {given:\uC740/\uB294} \uD6A1\uB2E8\uBCF4\uB3C4 \uC55E\uC5D0\uC11C \uC2E0\uD638\uB97C \uD55C \uBC88 \uB354 \uAE30\uB2E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532040
    m_Localized: "{given:\uC740/\uB294} \uC9C0\uAE08\uB3C4 \uC0AC\uB78C\uC758 \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uB294\uB2E4. \uADF8 \uB208\uC774 \uBB34\uC11C\uC6E0\uB358 \uB0A0\uC774 \uC788\uC5C8\uB2E4\uB294 \uAC83\uB3C4 \uC78A\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532041
    m_Localized: "{given:\uC740/\uB294} \uADF8\uB0A0 \uC544\uCE68\uC758 \uC790\uC2E0\uC5D0\uAC8C \uC798\uD588\uB2E4\uACE0 \uB9D0\uD574 \uC900\uB2E4. \uC774\uAE34 \uB0A0\uC774 \uC544\uB2C8\uB77C, \uC790\uAE30\uB97C \uC9C0\uC6B0\uC9C0 \uC54A\uC740 \uB0A0\uC774\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532042
    m_Localized: "{given:\uC740/\uB294} \uC774\uC81C \uB208\uC744 \uAC10\uACE0 \uC2F6\uC744 \uB550 \uAC10\uB294\uB2E4. \uADF8\uB798\uB3C4 \uBCFC \uAC83\uC740 \uB05D\uAE4C\uC9C0 \uBCF8\uB2E4. \uB458 \uB2E4 \uD560 \uC904 \uC54C\uAC8C \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532043
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68\uC758 \uB208\uBE5B\uC744 {given:\uC740/\uB294} \uC544\uC9C1 \uAC00\uB054 \uAFC8\uC5D0\uC11C \uBCF8\uB2E4. \uAE68\uC5B4\uB098\uBA74 \uBD88\uC744 \uCF1C\uACE0, \uBC29 \uC548\uC744 \uD55C \uBC88 \uB458\uB7EC\uBCF8\uB2E4. \uBB38\uC774 \uC5F4\uB824 \uC788\uB294 \uAC78 \uD655\uC778\uD560 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532044
    m_Localized: "\uADF8\uB0A0 \uC544\uCE68 \uD6A1\uB2E8\uBCF4\uB3C4\uC5D0\uC11C \uCC98\uC74C \uAEBC\uB0B8 \uC774\uC57C\uAE30\uB97C, {given:\uC740/\uB294} \uC774\uC81C \uC870\uAE08\uC529 \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C\uB3C4 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532045
    m_Localized: "{given:\uC740/\uB294} \uC774\uC81C \uD798\uB4E0 \uC77C\uC744 \uD63C\uC790 \uB4E4\uACE0 \uC788\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB0A0 \uC544\uCE68, \uD55C \uC0AC\uB78C\uC5D0\uAC8C \uB9D0\uD574 \uBCF8 \uB355\uBD84\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532046
    m_Localized: "{given:\uC740/\uB294} \uC9C0\uAE08\uB3C4 \uD55C \uBC88\uC5D0 \uB2E4 \uB9D0\uD558\uC9C0 \uBABB\uD55C\uB2E4. \uB300\uC2E0 \uC870\uAE08\uC529, \uB4E4\uC5B4 \uC904 \uC0AC\uB78C\uC5D0\uAC8C. \uADF8\uAC70\uBA74 \uCDA9\uBD84\uD558\uB2E4\uB294 \uAC78 \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532047
    m_Localized: "\uD138\uC5B4\uB193\uC740 \uAC74 \uADF8\uB0A0 \uC544\uCE68 \uD55C \uBC88\uBFD0\uC774\uC5C8\uB2E4. \uADF8 \uB4A4\uC758 \uC774\uC57C\uAE30\uB294 \uC544\uC9C1 {given}\uC758 \uC77C\uAE30\uC7A5 \uC548\uC5D0 \uC788\uB2E4. \uC5B8\uC820\uAC00 \uAEBC\uB0BC \uC218 \uC788\uB3C4\uB85D, \uBC84\uB9AC\uC9C0 \uC54A\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532048
    m_Localized: "\uCC98\uC74C\uC73C\uB85C, \uC544\uD504\uB2E4\uACE0 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532049
    m_Localized: "\uC6C3\uC9C0 \uC54A\uACE0, \uC548 \uAD1C\uCC2E\uC558\uB2E4\uACE0 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532050
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uB4A4\uB97C \uB3CC\uC544\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532051
    m_Localized: "\uBB38 \uC55E\uC5D0\uC11C \uAC78\uC74C\uC744 \uBA48\uCD94\uACE0, \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532052
    m_Localized: "\uBCF8 \uAC83\uC744, \uCC98\uC74C\uC73C\uB85C \uB9D0\uB85C \uAEBC\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532053
    m_Localized: "\uADF8 \uC560 \uC55E\uC5D0\uC11C, \uD558\uACE0 \uC2F6\uB358 \uB9D0\uC744 \uB05D\uAE4C\uC9C0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532054
    m_Localized: "'\u2026\uB2E4\uC74C\uC5D0 \uAC00\uC790\uACE0 \uD588\uC796\uC544. \uC774\uBC88\uC5D4 \uC9C4\uC9DC \uAC00\uC790.' {friend:\uC774/\uAC00} \uCF54\uB97C \uCC21\uADF8\uB9AC\uBA70 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532055
    m_Localized: "\uADF8\uD574\uB97C \uC5B4\uB5BB\uAC8C \uBC84\uD17C\uB290\uB0D0\uACE0 \uBB3C\uC73C\uBA74, {given:\uC740/\uB294} \uB298 \uAC19\uC740 \uB300\uB2F5\uC744 \uD55C\uB2E4. \uB0B4\uC77C\uC774 \uC62C \uAC70\uB77C\uACE0, \uC774\uC0C1\uD558\uAC8C \uBBFF\uC5B4\uC84C\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532056
    m_Localized: "{given:\uC740/\uB294} \uC544\uC9C1\uB3C4 \uAC00\uB054 \uB0B4\uC77C\uC774 \uBB34\uC12D\uB2E4. \uADF8\uB798\uB3C4 \uB9E4\uC77C \uC544\uCE68, \uCEE4\uD2BC\uC744 \uC5F0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532057
    m_Localized: "\uD76C\uB9DD \uAC19\uC740 \uAC74 \uB05D\uB0B4 \uC798 \uBAA8\uB974\uACA0\uB2E4\uACE0 {given:\uC740/\uB294} \uB9D0\uD55C\uB2E4. \uB2E4\uB9CC \uC0B4\uC544 \uC788\uB2E4\uB294 \uAC83, \uADF8\uAC74 \uC774\uC81C \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532058
    m_Localized: "\uC798\uD558\uB294 \uC544\uC774\uC77C\uC218\uB85D \uC26C\uB294 \uBC95\uC744 \uBAA8\uB974\uB354\uB77C. \uC624\uB298\uC740 \uC219\uC81C \uC5C6\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532059
    m_Localized: "\uC911\uAC04\uC774\uB77C\uB294 \uAC74, \uC5B4\uB290 \uCABD\uC73C\uB85C\uB4E0 \uAC08 \uC218 \uC788\uB2E4\uB294 \uB73B\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532060
    m_Localized: "\uC810\uC218\uB294 \uBB3B\uC9C0 \uC54A\uC744\uAC8C. \uC5B4\uC81C\uBCF4\uB2E4 \uD55C \uC904 \uB354 \uC77D\uC5C8\uC73C\uBA74 \uADF8\uAC78\uB85C \uB410\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449096463532061
    m_Localized: "\uC0DD\uD65C\uAE30\uB85D\uBD80\uAC00 \uBE44\uC5B4 \uC788\uC5B4\uC11C \uC88B\uB2E4. \uCC98\uC74C\uBD80\uD130 \uAC19\uC774 \uC801\uC73C\uBA74 \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1473436307439616
    m_Localized: "\uC5BB\uC744 \uC218 \uC788\uB294 \uAC83"
    m_Metadata:
      m_Items: []
  - m_Id: 1473436370354176
    m_Localized: "\uC6B4\uC774 \uC88B\uC73C\uBA74 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059156062208
    m_Localized: "\uBCF4\uAD00\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171072
    m_Localized: "\uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171073
    m_Localized: "\uC7A5\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171074
    m_Localized: "\uC18C\uBAA8\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171075
    m_Localized: "\uAE30\uD638\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171076
    m_Localized: "\uAE30\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171077
    m_Localized: "\uBB3C\uAC74"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171078
    m_Localized: "\uC544\uC9C1 \uBCF4\uAD00\uD55C \uBB3C\uAC74\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171079
    m_Localized: "\uCC29\uC6A9 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171080
    m_Localized: "\uB0B4\uAD6C {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171081
    m_Localized: "\uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171082
    m_Localized: "\uAC00\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171083
    m_Localized: "\uB3C4\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171084
    m_Localized: "\uB9E8\uC190"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171085
    m_Localized: "\uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171086
    m_Localized: "\uBC30\uB0AD(Tab)\uC5D0\uC11C \uC7A5\uBE44\uB97C \uACE0\uB978 \uB4A4 \uC774 \uCE78\uC744 \uB204\uB974\uBA74 \uCC39\uB2C8\uB2E4. \uC6B0\uD074\uB9AD\uD558\uBA74 \uBC97\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171087
    m_Localized: "{0} \uC7A5\uCC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171088
    m_Localized: "\uC9C0\uAE08 \uC9D0\uC774 \uC0C8 \uAC00\uBC29\uC5D0 \uB2E4 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171089
    m_Localized: "\uAC00\uBC29\uC740 \uBC97\uC744 \uC218 \uC5C6\uC5B4\uC694. \uB2E4\uB978 \uAC00\uBC29\uC73C\uB85C \uBC14\uAFD4 \uBA54\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1478059223171090
    m_Localized: "\uC88C\uD074\uB9AD \uC0B4\uD3B4\uBCF4\uAE30\xB7\uACE0\uB974\uAE30 (\uACE0\uB978 \uB4A4 \uBE48\uCE78\uC744 \uB204\uB974\uBA74 \uC62E\uAE30\uAE30) \xB7 \uC6B0\uD074\uB9AD \uBC14\uB85C \uC4F0\uAE30/\uC7A5\uCC29/\uBC84\uB9AC\uAE30 \xB7 Shift+\uC6B0\uD074\uB9AD \uBC84\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
