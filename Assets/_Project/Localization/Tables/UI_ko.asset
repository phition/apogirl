  - m_Id: 1727283325
    m_Localized: "\uACC4\uD68D \uB2E8\uACC4\uC5D0\uC11C\uB9CC \uC800\uC7A5\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283326
    m_Localized: "\uBA54\uB274"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283327
    m_Localized: "\uD0C0\uC774\uD2C0\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283328
    m_Localized: "\uAE00\uC790 \uD06C\uAE30: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283329
    m_Localized: "\uC791\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283330
    m_Localized: "\uBCF4\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283331
    m_Localized: "\uD06C\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283332
    m_Localized: "\uC774\uBC88 \uC8FC\uB294 \uC5B4\uB5BB\uAC8C \uBCF4\uB0BC \uC0DD\uAC01\uC774\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283333
    m_Localized: "\uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0. \uD558\uB8E8\uD558\uB8E8 \uBC84\uD2F0\uB294 \uAC83\uB3C4 \uACF5\uBD80\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283334
    m_Localized: "\uAD50\uACFC\uC11C\uB294 \uB3C4\uC11C\uAD00\uC5D0 \uC544\uC9C1 \uB0A8\uC544 \uC788\uC744 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283335
    m_Localized: "\uBC24\uC5D0\uB294 \uC18C\uB9AC\uAC00 \uBA40\uB9AC \uAC04\uB2E4. \uC870\uC2EC\uD558\uB834."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283336
    m_Localized: "\uACC4\uD68D\uC744 \uB2E4\uC2DC \uBCF4\uB834. \uC26C\uC5B4\uC57C \uD560 \uB54C \uC26C\uC9C0 \uC54A\uC73C\uBA74 \uD0C8\uC774 \uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283337
    m_Localized: "\uB208 \uBC11\uC774 \uD02D\uD558\uAD6C\uB098. \uC624\uB298 \uBC24\uC5D4 \uAF2D \uC790\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283338
    m_Localized: "\u2026\uB2E4\uB140\uC624\uB834."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283339
    m_Localized: "\uB514\uBC84\uADF8 (F1)"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283340
    m_Localized: "\uC790\uC6D0 +10"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283341
    m_Localized: "\uC804 \uB2A5\uB825\uCE58 +10"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283342
    m_Localized: "\uC218\uBA74 \uBD80\uCC44 +1"
    m_Metadata:
      m_Items: []
