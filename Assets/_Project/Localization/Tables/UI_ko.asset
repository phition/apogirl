    m_Metadata:
      m_Items: []
  - m_Id: 12156220489733
    m_Localized: "A/D \uC774\uB3D9 \xB7 Shift \uB2EC\uB9AC\uAE30 \xB7 Ctrl \uC6C5\uD06C\uB9AC\uAE30 \xB7 E \uC0C1\uD638\uC791\uC6A9 (\uC218\uC0C9\uC740 \uAE38\uAC8C) \xB7 \uBB38 \uC55E W \uC0B4\uD53C\uAE30 \xB7 S \uB4E3\uAE30 \xB7 Space \uC228\uAE30 \xB7 Q \uACF5\uACA9/\uBC00\uCE58\uAE30 \xB7 1~4 \uD035\uC2AC\uB86F \xB7 F \uC190\uC804\uB4F1 \xB7 Tab \uBC30\uB0AD"
