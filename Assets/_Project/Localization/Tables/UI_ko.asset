    m_Localized: "{0}: \uC5F0\uC18D \uCD9C\uC815 (\uC218\uBA74 \uBD80\uCC44 +2)"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283281
    m_Localized: "\uACE0\uAC15\uB3C4 \uC8FC\uAC04: \uD0D0\uD5D8\uC774 \uB9CE\uC544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283282
    m_Localized: "{0}: \uC218\uBA74 \uBD80\uCC44\uAC00 \uC313\uC778 \uCC44 \uBC24 \uD0D0\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283283
    m_Localized: "\uC608\uC0C1 \uC218\uBA74 \uBD80\uCC44: {0} \u2192 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283284
    m_Localized: "\uC9C0\uB09C\uC8FC \uBCF5\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283285
    m_Localized: "\uD504\uB9AC\uC14B \uC800\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283286
    m_Localized: "\uD504\uB9AC\uC14B"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283287
    m_Localized: "\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283288
    m_Localized: "{0}\uC8FC\uCC28 \uB8E8\uD2F4"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283289
    m_Localized: "\uD504\uB9AC\uC14B\uC744 \uC800\uC7A5\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283290
    m_Localized: "\uD504\uB9AC\uC14B\uC740 \uCD5C\uB300 {0}\uAC1C\uAE4C\uC9C0 \uC800\uC7A5\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283291
    m_Localized: "\uC800\uC7A5\uB41C \uD504\uB9AC\uC14B\uC774 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283292
    m_Localized: "\uBD88\uB7EC\uC624\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283293
    m_Localized: "\uC0AD\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283294
    m_Localized: "\uD55C \uC8FC \uC2E4\uD589 \u25B6"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283295
    m_Localized: "\uC9C4\uD589 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283296
    m_Localized: "\uC7A0\uAE34 \uCE78\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283297
    m_Localized: "\uC774 \uC2DC\uAC04\uB300\uC5D0\uB294 \uD560 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283298
    m_Localized: "\uBA3C\uC800 \uC624\uB978\uCABD\uC5D0\uC11C \uD589\uB3D9\uC744 \uACE0\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283299
    m_Localized: "\uBCF4\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283300
