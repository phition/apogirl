  - m_Id: 150809064259715
    m_Localized: '? ? ?'
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259716
    m_Localized: "{0}\uC8FC\uCC28\uC5D0 \uCC98\uC74C \uBD04 \xB7 {1}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259717
    m_Localized: "\uC544\uC9C1 \uBCF8 \uC5D4\uB529\uC774 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259718
    m_Localized: "52\uC8FC\uCC28\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259719
    m_Localized: "\uC9C0\uAE08 \uC0C1\uD0DC\uB85C \uAD6C\uC870 \uC5D4\uB529"
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259720
    m_Localized: "\uBC30\uB4DC \uC5D4\uB529"
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259721
    m_Localized: "\uC5D4\uB529 \uD310\uC815 \uBBF8\uB9AC\uBCF4\uAE30: {0} (\uC810\uC218 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 150809064259722
    m_Localized: "{0}\uC8FC \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 169172251459584
    m_Localized: "\uAE09\uC2DD\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151360
    m_Localized: "\uB3C4\uC11C\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151361
    m_Localized: "\uACFC\uD559\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151362
    m_Localized: "\uCCB4\uC721\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151363
    m_Localized: "\uAD50\uBB34\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151364
    m_Localized: "\uC5ED\uD560 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151365
    m_Localized: "\uACBD\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151366
    m_Localized: "\uC694\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151367
    m_Localized: "\uAC04\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151368
    m_Localized: "\uACF5\uBD80 \uCE5C\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151369
    m_Localized: "\uD604\uAD00\xB7\uAD50\uBB34\uC2E4. \uBC24 \uC2B5\uACA9\xB7\uB0AE \uCE68\uC785 \uBC29\uC5B4 +6"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151370
    m_Localized: "\uC774\uD2C0\uC5D0 \uD55C \uBC88 \uC2DD\uB7C9 1 \uC808\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151371
    m_Localized: "\uBCF4\uAC74\uC2E4. \uAC10\uC5FC\xB7\uC120\uC0DD\uB2D8 \uBCD1\uC138 \uC9C4\uD589 \u22121/\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151372
    m_Localized: "\uAD50\uC721 \uC131\uC7A5 +8%"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151373
    m_Localized: "\uD569\uB958\uD55C \uB3D9\uB8CC\uB97C \uB20C\uB7EC \uC5ED\uD560\uC744 \uBC14\uAFBC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151374
    m_Localized: "\uAE68\uC5B4\uB09C \uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151375
    m_Localized: "\uC190\uB5A8\uB9BC\uC774 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4. {given:\uC740/\uB294} \uC2A4\uC2A4\uB85C \uBCF4\uAC74\uC2E4 \uBB38\uC744 \uAC78\uC5B4 \uC7A0\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151376
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uBB38 \uB108\uBA38\uC5D0\uC11C \uBC24\uC0C8 \uC2DC\uB97C \uC77D\uC5B4 \uC8FC\uC5C8\uB2E4. \uBB38\uC740 \uB05D\uAE4C\uC9C0 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uACE0, \uBAA9\uC18C\uB9AC\uB3C4 \uB05D\uAE4C\uC9C0 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151377
    m_Localized: "\uBD04\uC774 \uC654\uC744 \uB54C, \uBCF4\uAC74\uC2E4 \uCC3D\uAC00\uC5D0\uB294 {given}\uC758 \uC77C\uAE30\uC7A5\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uC7A5\uC5D0\uB294 '\uACE0\uB9C8\uC6CC\uC694'\uB77C\uACE0\uB9CC \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151378
    m_Localized: "\uBAB8\uC774 \uC73C\uC2AC\uC73C\uC2AC\uD558\uB2E4. \uBB3C\uB9B0 \uC790\uB9AC\uAC00 \uD654\uB048\uAC70\uB9B0\uB2E4. \uC120\uC0DD\uB2D8\uD55C\uD14C\uB294 \uC544\uC9C1 \uB9D0 \uBABB \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151379
    m_Localized: "\uAE30\uCE68\uC774 \uBA4E\uC9C8 \uC54A\uB294\uB2E4. \uBC24\uB9C8\uB2E4 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC774\uB9C8\uB97C \uC9DA\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151380
    m_Localized: "\uD39C\uC744 \uC954 \uC190\uC774 \uB5A8\uB9B0\uB2E4. \uAE00\uC528\uAC00 \uC790\uAFB8 \uBE44\uB6A4\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151381
    m_Localized: "\uC5BC\uAD74\uC774 \uBD89\uAD6C\uB098. \uC0C1\uCC98 \uC880 \uB2E4\uC2DC \uBCF4\uC790. \uC228\uAE30\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151382
    m_Localized: "\uC190\uC774 \uB5A8\uB9AC\uB294\uAD6C\uB098. \uC774\uBC88 \uC8FC\uB294 \uC57D\uBD80\uD130 \uCC59\uAE34\uB2E4. \uB2E4\uB978 \uAC74 \uB2E4 \uBBF8\uB904\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151383
    m_Localized: "(\uAE30\uCE68) \uAD1C\uCC2E\uB2E4. \uAC10\uAE30\uACA0\uC9C0. \u2026\uC218\uC5C5\uC740 \uD574\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151384
    m_Localized: "\uC624\uB298\uC740 \uC549\uC544\uC11C \uD558\uC790. \uCE60\uD310 \uAE00\uC528\uB294 \uB124\uAC00 \uC368 \uC8FC\uB834."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151385
    m_Localized: "\uACC4\uD68D\uC740\u2026 \uC774\uC81C \uB124\uAC00 \uC138\uC6CC \uBCF4\uAC70\uB77C. \uB09C \uC606\uC5D0\uC11C \uBCF4\uAE30\uB9CC \uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151386
    m_Localized: "\uBE44\uAC00 \uC624\uB294\uAD6C\uB098. \uBE57\uC18C\uB9AC\uAC00 \uBC1C\uC18C\uB9AC\uB97C \uB36E\uC5B4 \uC900\uB2E4. \uB098\uAC08 \uAC70\uBA74 \uC624\uB298\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151387
    m_Localized: "\uB354\uC704\uAC00 \uC2EC\uD558\uB2E4. \uBB3C\uC744 \uC544\uAEF4\uC57C \uD55C\uB2E4. \uC74C\uC2DD\uB3C4 \uAE08\uBC29 \uC0C1\uD558\uB2C8 \uC870\uC2EC\uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151388
    m_Localized: "\uD55C\uD30C\uB2E4. \uBC24\uC5D0\uB294 \uB2F4\uC694\uB97C \uB450 \uACB9\uC73C\uB85C \uB36E\uC5B4\uB77C. \uAC10\uAE30\uB77C\uB3C4 \uAC78\uB9AC\uBA74 \uD070\uC77C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151389
    m_Localized: "\uBD04 \uD55C \uCCA0\uC744 \uBC84\uD17C\uB2E4. \uCC98\uC74C \uCC3D\uACE0 \uBB38\uC744 \uC5F4\uC5C8\uC744 \uB54C \uB108\uB294 \uB9D0 \uD55C\uB9C8\uB514 \uBABB \uD558\uB358 \uC544\uC774\uC600\uC9C0. \uC9C0\uAE08\uC740 \uACC4\uD68D\uD45C\uB97C \uBA3C\uC800 \uB4E4\uACE0 \uC624\uB294\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151390
    m_Localized: "\uD798\uB4E0 \uBD04\uC774\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC6B0\uB9AC\uB294 \uC544\uC9C1 \uC5EC\uAE30 \uC788\uB2E4. \uADF8\uAC70\uBA74 \uCDA9\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151391
    m_Localized: "\uC18C\uAE08\uC5D0 \uC808\uC5EC \uBCF8\uB2E4 (\uC694\uB9AC \uD310\uC815)"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151392
    m_Localized: "\uC0C1\uD55C \uAC83\uC740 \uBC84\uB9B0\uB2E4 (\uC2DD\uB7C9 \u22124)"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151393
    m_Localized: "\uAC10\uAE30\uC57D\uC744 \uBA39\uACE0 \uC77C\uCC0D \uC794\uB2E4 (\uC57D\uD488 1)"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151394
    m_Localized: "\uBC84\uD2F4\uB2E4 (\uCCB4\uB825 \u22128, \uD53C\uB85C +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151395
    m_Localized: "\uC9C0\uBD95\uC744 \uB9C9\uB294\uB2E4 (\uC790\uC7AC 1, \uBC29\uC5B4\uB3C4 +1)"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151396
    m_Localized: "\uC591\uB3D9\uC774\uB85C \uBE57\uBB3C\uC744 \uBC1B\uB294\uB2E4 (\uBE57\uBB3C +5, \uD53C\uB85C +4)"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151397
    m_Localized: "\uB354\uC704\uC5D0 \uC0C1\uD558\uB294 \uC74C\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151398
    m_Localized: "\uAE09\uC2DD\uC2E4 \uAD6C\uC11D\uC5D0\uC11C \uC2DC\uD07C\uD55C \uB0C4\uC0C8\uAC00 \uB09C\uB2E4. \uC0AC\uD758 \uB0B4\uB0B4 \uC774\uC5B4\uC9C4 \uB354\uC704\uC5D0 \uC2DD\uB7C9 \uC77C\uBD80\uAC00 \uC0C1\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151399
    m_Localized: "\uD55C\uD30C\uC758 \uBC24"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151400
    m_Localized: "\uCC3D\uD2C8\uC73C\uB85C \uB4E4\uC5B4\uC624\uB294 \uBC14\uB78C\uC5D0 \uC774\uAC00 \uB531\uB531 \uBD80\uB52A\uCE5C\uB2E4. \uBAA9\uC774 \uB530\uB054\uAC70\uB9AC\uACE0 \uBAB8\uC774 \uBB34\uAC81\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151401
    m_Localized: "\uC0C8\uB294 \uCC9C\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151402
    m_Localized: "\uBC24\uC0C8 \uB0B4\uB9B0 \uBE44\uC5D0 \uAD50\uC2E4 \uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0CC\uB2E4. \uB9E4\uD2B8\uB9AC\uC2A4 \uD55C\uCABD\uC774 \uC816\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151403
    m_Localized: "\uB9D1\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151404
    m_Localized: "\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151405
    m_Localized: "\uD3ED\uC5FC"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151406
    m_Localized: "\uD55C\uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151407
    m_Localized: "\uD0D0\uD5D8 \uC18C\uC74C \uAC10\uC18C \xB7 \uC2B5\uACA9 \uD655\uB960 \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151408
    m_Localized: "\uBB3C \uC18C\uBAA8 +1/\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151409
    m_Localized: "\uB9E4\uC77C \uC2A4\uD2B8\uB808\uC2A4 +2"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151410
    m_Localized: "\uB0A0\uC528: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151411
    m_Localized: "\uAD6C\uC870\uAE4C\uC9C0 {0}\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151412
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151413
    m_Localized: "\uC99D\uC0C1: \uBBF8\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151414
    m_Localized: "\uC99D\uC0C1: \uAE30\uCE68\uC774 \uBA4E\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151415
    m_Localized: "\uC99D\uC0C1: \uC190\uC774 \uB5A8\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151416
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151417
    m_Localized: "\uC120\uC0DD\uB2D8: \uC7A6\uC740 \uAE30\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151418
    m_Localized: "\uC120\uC0DD\uB2D8: \uC5F4\uC774 \uC624\uB974\uB0B4\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151419
    m_Localized: "\uC120\uC0DD\uB2D8: \uAC70\uC758 \uB204\uC6CC \uC9C0\uB0C4"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151420
    m_Localized: "\uC120\uC0DD\uB2D8: \uC758\uC2DD\uC774 \uD750\uB824\uC9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151421
    m_Localized: "\uBB3C\uB838\uB2E4. \uC751\uAE09 \uCC98\uCE58\uB97C \uBABB \uD574 \uC0C1\uCC98\uAC00 \uD654\uB048\uAC70\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151422
    m_Localized: "\uBB3C\uB838\uC9C0\uB9CC \uBC14\uB85C \uC0C1\uCC98\uB97C \uC9DC\uB0B4\uACE0 \uC18C\uB3C5\uD588\uB2E4. \uB2E4\uD589\uD788 \uD06C\uAC8C \uBC88\uC9C0\uC9C0\uB294 \uC54A\uC740 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151423
    m_Localized: "\uBB34\uC804\uC73C\uB85C \uB4E4\uC740 \uC815\uBCF4: \uC7A0\uAE34 \uBC29 {0} \xB7 \uAC15\uC81C\uB85C \uC5F4 \uC218 \uC788\uB294 \uBC29 {1} \xB7 \uB9CC\uB0A0 \uC218 \uC788\uB294 \uC0AC\uB78C\xB7\uBB3C\uAC74 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151424
    m_Localized: "\uB0A0\uC528: {0} \u2014 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151425
    m_Localized: "{0}\uB9C9 \uD3C9\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151426
    m_Localized: "\uAC00\uC7A5 \uB9CE\uC774 \uC790\uB780 \uAC83: {0} +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151427
    m_Localized: "{0}\uC8FC\uCC28 ~ {1}\uC8FC\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151428
    m_Localized: "\uAC10\uC5FC +25"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151429
    m_Localized: "\uC120\uC0DD\uB2D8 \uC7AC\uAC10\uC5FC / \uC9C4\uD589 +25"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151430
    m_Localized: "\uB0A0\uC528 \uBC14\uAFB8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 169172331151431
    m_Localized: "\uAD6C\uC870 \uACF5\uC9C0 \uD1A0\uAE00"
    m_Metadata:
      m_Items: []
  - m_Id: 173977321619456
    m_Localized: "\uB9E4\uBBF8\uAC00 \uC6B4\uB2E4. \uC138\uC0C1\uC774 \uC774\uB807\uAC8C \uB410\uB294\uB370\uB3C4 \uC5EC\uB984\uC740 \uC81C\uB54C \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689728
    m_Localized: "\uBCF4\uAC74 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC190\uB4F1\uC758 \uAE01\uD78C \uC790\uAD6D\uC744 \uBCF4\uACE0 \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4. \uC794\uC18C\uB9AC\uAC00 \uC774\uB807\uAC8C \uBC18\uAC00\uC6B8 \uC904\uC740 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689729
    m_Localized: "\uD559\uC0DD\uC99D \uC0AC\uC9C4 \uC18D {friend}\uB294 \uC6C3\uACE0 \uC788\uB2E4. \uC0AC\uC9C4 \uCC0D\uB358 \uB0A0, \uC55E\uBA38\uB9AC\uAC00 \uB9DD\uD588\uB2E4\uACE0 \uD22C\uB35C\uAC70\uB838\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689730
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB2E4 \uC54C\uAC8C \uB410\uB2E4. \uC774\uC0C1\uD558\uAC8C, \uC9D0\uC744 \uD558\uB098 \uB0B4\uB824\uB193\uC740 \uAE30\uBD84\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689731
    m_Localized: "\uADF8 \uC560\uAC00 \uAC19\uC740 \uC9C0\uBD95 \uC544\uB798\uC5D0\uC11C \uC794\uB2E4. \uC544\uC9C1 \uB208\uC744 \uB9C8\uC8FC\uCE58\uAE30\uAC00 \uC5B4\uB835\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689732
    m_Localized: "\uBC24\uC0C8 \uCC3D\uBB38\uC774 \uB35C\uCEF9\uAC70\uB838\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uC6B4\uB3D9\uC7A5\uC774 \uD638\uC218\uAC00 \uB3FC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689733
    m_Localized: "\uB354\uC6B4 \uB0A0\uC5D4 \uB0AE\uC5D0 \uC26C\uACE0 \uC800\uB141\uC5D0 \uC6C0\uC9C1\uC774\uC790. \uBB3C\uC740 \uB109\uB109\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689734
    m_Localized: "\u2026\uB124 \uC798\uBABB\uC774 \uC544\uB2C8\uC57C. \uBA87 \uBC88\uC774\uACE0 \uB9D0\uD560 \uAC70\uB2E4. \uB124 \uC798\uBABB\uC774 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689735
    m_Localized: "\uC5EC\uB984 \uD55C \uCCA0. \uC6B0\uB9AC \uC2DD\uAD6C\uAC00 \uB298\uC5C8\uACE0, \uD559\uAD50\uAC00 \uC870\uAE08 \uB354 \uC9D1 \uAC19\uC544\uC84C\uB2E4. \uB108\uB294 \uC774\uC81C \uB2E4\uB978 \uC0AC\uB78C\uC758 \uC774\uB984\uC744 \uBA3C\uC800 \uBD80\uB974\uB294\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689736
    m_Localized: "\uC774\uBC88 \uC5EC\uB984\uC5D0 \uB124 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uB2E4. \uB2A6\uC5B4\uC11C \uBBF8\uC548\uD558\uB2E4. \uADF8\uB798\uB3C4 \uB4E4\uB824\uC918\uC11C \uACE0\uB9D9\uB2E4. \uADF8 \uCC3D\uACE0 \uBB38\uC740, \uC774\uC81C \uC548\uC5D0\uC11C\uB3C4 \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689737
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uC57D\uC7A5\uC744 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689738
    m_Localized: "\uD3B8\uC758\uC810 \uC55E\uC5D0\uC11C {friend}\uC758 \uD559\uC0DD\uC99D\uC744 \uC8FC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689739
    m_Localized: "\uC7A0\uAE34 \uC9D1 \uBB38 \uC55E\uC5D0 \uD1B5\uC870\uB9BC\uC744 \uB450\uACE0 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689740
    m_Localized: "\uC120\uC0DD\uB2D8\uC5D0\uAC8C \uADF8\uB0A0 \uCC3D\uACE0\uC5D0 \uAC07\uD78C \uC774\uC720\uB97C \uC774\uC57C\uAE30\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689741
    m_Localized: "\uBC29\uAD00\uD588\uB358 \uB3D9\uCC3D\uC744 \uAC70\uC810\uC5D0 \uBC1B\uC544\uB4E4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689742
    m_Localized: "\uD0DC\uD48D\uACFC \uC2B5\uACA9\uC774 \uACB9\uCE5C \uC5EC\uB984\uC758 \uB05D\uC744 \uBC84\uD17C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689743
    m_Localized: "\uC0C8\uBCBD\uB3D9 \uBE4C\uB77C \uACE8\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689744
    m_Localized: "\uC0C8\uBCBD\uC5ED (\uC9C0\uD558\uCCA0)"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689745
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689746
    m_Localized: "\uC1A1\uC608\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689747
    m_Localized: "\uCD5C\uD558\uB9B0"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689748
    m_Localized: "\uBC84\uC2A4 \uC815\uB958\uC7A5 \uC758\uC790 \uBC11. \uB04A\uC5B4\uC9C4 \uAC00\uBC29\uB048, \uC561\uC815\uC774 \uAC70\uBBF8\uC904\uCC98\uB7FC \uAE68\uC9C4 \uD734\uB300\uD3F0, \uADF8\uB9AC\uACE0 \uB0AF\uC775\uC740 \uC0AC\uC9C4\uC774 \uBD99\uC740 \uD559\uC0DD\uC99D."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689749
    m_Localized: "\uD559\uC0DD\uC99D\uC744 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689750
    m_Localized: "\uB9CC\uC9C0\uC9C0 \uBABB\uD558\uACE0 \uADF8\uB300\uB85C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689751
    m_Localized: "102\uD638 \uD604\uAD00\uBB38. \uC548\uCABD\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB04C\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4\uAC00, \uC774\uCABD \uBC1C\uC18C\uB9AC\uC5D0 \uB69D \uBA48\uCD98\uB2E4. \uB204\uAD70\uAC00 \uC228\uC8FD\uC774\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689752
    m_Localized: "\uBB38 \uC55E\uC5D0 \uD1B5\uC870\uB9BC\uACFC \uBB3C\uC744 \uB450\uACE0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689753
    m_Localized: "\uC870\uC6A9\uD788 \uB450 \uBC88 \uB178\uD06C\uD574 \uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689754
    m_Localized: "\uBAA8\uB978 \uCC99 \uC9C0\uB098\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689755
    m_Localized: "\uC637\uC7A5 \uBB38\uD2C8\uC73C\uB85C \uB0AF\uC775\uC740 \uC5BC\uAD74. \uD559\uAD50 \uBCF4\uAC74\uC2E4\uC5D0\uC11C \uBCF8 \uC801 \uC788\uB294 \uC0AC\uB78C\uC774\uB2E4. \uC190\uC5D0 \uAC00\uC704\uB97C \uC954 \uCC44 \uC774\uCABD\uC744 \uB178\uB824\uBCF4\uB2E4\uAC00, \uAD50\uBCF5\uC744 \uBCF4\uACE0 \uC190\uC744 \uB0B4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689756
    m_Localized: "\"\uD559\uAD50\uC5D0 \uC120\uC0DD\uB2D8\uC774 \uACC4\uC138\uC694. \uAC19\uC774 \uAC00\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689757
    m_Localized: "\uC704\uCE58\uB9CC \uC54C\uB824 \uC8FC\uACE0 \uBA3C\uC800 \uB3CC\uC544\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689758
    m_Localized: "\uC9C0\uD558 \uC124\uBE44\uC2E4 \uBC29\uC1A1 \uC7A5\uBE44\uC5D0 \uB179\uC74C \uBC84\uD2BC\uC774 \uB20C\uB9B0 \uCC44 \uBA48\uCDB0 \uC788\uB2E4. \uC7AC\uC0DD \uBC84\uD2BC\uC5D0 \uC190\uC744 \uB300\uBA74, \uADF8\uB0A0\uC758 \uB9C8\uC9C0\uB9C9 \uC548\uB0B4 \uBC29\uC1A1\uC774 \uB4E4\uB9B4 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689759
    m_Localized: "\uC7AC\uC0DD\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689760
    m_Localized: "\uC9C0\uAE08\uC740 \uB4E3\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689761
    m_Localized: "\uC2B9\uAC15\uC7A5 \uC606 \uC0AC\uBB34\uC2E4 \uAD6C\uC11D\uC5D0 \uAD50\uBCF5 \uCC28\uB9BC\uC758 \uC5EC\uC790\uC544\uC774\uAC00 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uB2E4. \uACE0\uAC1C\uB97C \uB4E0 \uC5BC\uAD74\uC744 \uBCF4\uB294 \uC21C\uAC04 \uC228\uC774 \uBA4E\uC5C8\uB2E4. \uAC19\uC740 \uC911\uD559\uAD50, \uADF8 \uBB34\uB9AC \uC606\uC5D0 \uB298 \uC11C \uC788\uB358 \uC544\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689762
    m_Localized: "\"\u2026\uC77C\uC5B4\uB098. \uAC19\uC774 \uAC00.\""
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689763
    m_Localized: "\uBB3C\uACFC \uBA39\uC744 \uAC83\uB9CC \uB450\uACE0 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 173977711689764
    m_Localized: "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB3CC\uC544\uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 178089090105344
    m_Localized: "\uC740\uD589\uC78E\uC774 \uC6B4\uB3D9\uC7A5\uC744 \uB36E\uC5C8\uB2E4. \uB0C4\uC0C8\uAC00 \uC9C0\uB3C5\uD558\uB2E4. \uADF8\uB798\uB3C4 \uC608\uC058\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019904
    m_Localized: "\uAD6C\uC870\uB300\uAC00 \uC628\uB2E4. 52\uC8FC\uC9F8. \uC190\uAC00\uB77D\uC73C\uB85C \uBA87 \uBC88\uC774\uB098 \uC138\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC120\uC0DD\uB2D8 \uC5BC\uAD74\uC744 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019905
    m_Localized: "\uADF8 \uC560\uB97C \uB2E4\uC2DC \uBD24\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uC791\uC558\uB2E4. \uB098\uB294 \uC0DD\uAC01\uBCF4\uB2E4 \uD06C\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019906
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uAE30\uCE68\uC744 \uD55C\uB2E4. \uBC24\uC0C8. \uB098\uB294 \uC544\uBB34\uAC83\uB3C4 \uD560 \uC218 \uC5C6\uB2E4\uB294 \uAC8C \uC81C\uC77C \uBB34\uC12D\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019907
    m_Localized: "\uC815\uC218\uC7A5. \uC5F0\uAD6C\uB3D9. \uB77C\uB514\uC624\uC5D0\uC11C \uB4E4\uC740 \uB2E8\uC5B4\uB4E4\uC744 \uB178\uD2B8\uC5D0 \uC801\uACE0 \uB610 \uC801\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019908
    m_Localized: "22\uC8FC. \uACC4\uD68D\uC744 \uC138\uC6B0\uC790. \uAD6C\uC870\uB300\uAC00 \uC654\uC744 \uB54C \uB124\uAC00 \uAC74\uAC15\uD558\uAC8C \uC625\uC0C1\uC5D0 \uC11C \uC788\uB3C4\uB85D."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019909
    m_Localized: "\u2026\uBB34\uB9AC\uD558\uC9C0 \uB9C8\uB77C. \uB098 \uB54C\uBB38\uC5D0 \uB124\uAC00 \uB2E4\uCE58\uBA74, \uADF8\uAC8C \uC81C\uC77C \uC544\uD504\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019910
    m_Localized: "\uAD1C\uCC2E\uB2E4. \uB124\uAC00 \uC633\uC544. \uB098\uB294 \uBB38 \uB108\uBA38\uC5D0\uC11C\uB3C4 \uC218\uC5C5\uD560 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019911
    m_Localized: "\uAC00\uC744\uC774 \uC9C0\uB098\uAC14\uB2E4. \uB108\uB294 \uADF8 \uC560\uB97C \uB2E4\uC2DC \uB9C8\uC8FC\uD588\uACE0, \uAD6C\uC870 \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uACE0\u2026 \uB098\uB294 \uB108\uC5D0\uAC8C \uBB34\uAC70\uC6B4 \uC9D0\uC744 \uD558\uB098 \uB354 \uC5B9\uC5C8\uB2E4. \uBBF8\uC548\uD558\uB2E4. \uADF8\uB9AC\uACE0 \uACE0\uB9D9\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019912
    m_Localized: "\uB108\uB294 \uB098\uB97C \uC0B4\uB9AC\uACA0\uB2E4\uACE0 \uD588\uC9C0. \uC120\uC0DD\uC73C\uB85C\uC11C \uB9D0\uB9AC\uACE0 \uC2F6\uB2E4. \uC0AC\uB78C\uC73C\uB85C\uC11C\uB294\u2026 \uACE0\uB9D9\uB2E4. \uC815\uB9D0\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019913
    m_Localized: "\uBB38 \uB108\uBA38\uC5D0\uC11C \uD558\uB294 \uD3C9\uAC00\uB2E4. \uB124\uAC00 \uAC70\uB9AC\uB97C \uB454 \uAC74 \uC633\uC740 \uC120\uD0DD\uC774\uC57C. \uC0B4\uC544\uB0A8\uB294 \uBC95\uC744 \uBC30\uC6B4 \uAC70\uB2E4. \uADF8\uAC78\uB85C \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019914
    m_Localized: "\uB77C\uB514\uC624\uB85C \uAD6C\uC870 \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019915
    m_Localized: "\uB9C8\uD2B8\uC5D0\uC11C \uADF8 \uC560\uB97C \uB2E4\uC2DC \uB9C8\uC8FC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019916
    m_Localized: "\uB9C8\uD2B8\uC758 \uC5B4\uB978\uB4E4\uACFC \uC190\uC744 \uC7A1\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019917
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uAE30\uCE68\uC774 \uC2DC\uC791\uB41C \uBC24\uC744 \uAE30\uC5B5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019918
    m_Localized: "\uC9C0\uB098\uAC00\uB358 \uC720\uB791\uC790\uC640 \uBE75\uC744 \uB098\uB234\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019919
    m_Localized: "\uCD08\uACA8\uC6B8\uC758 \uB300\uC2B5\uACA9\uC744 \uB118\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019920
    m_Localized: "\uC0C8\uBCBD\uB9C8\uD2B8 \xB7 \uBB3C\uB958\uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019921
    m_Localized: "\uC0C8\uBCBD\uB3D9 \uD30C\uCD9C\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019922
    m_Localized: "\uC720\uB791\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019923
    m_Localized: "\uC0AC\uBB34\uC2E4 \uBB38\uC744 \uC5F4\uC790 \uC5B4\uB978 \uC14B\uC774 \uB3D9\uC2DC\uC5D0 \uC774\uCABD\uC744 \uB3CC\uC544\uBD24\uB2E4. \uC190\uC5D0 \uAC01\uBAA9. \uAC00\uC6B4\uB370 \uB0A8\uC790\uAC00 \uC190\uC744 \uB4E4\uC5B4 \uB2E4\uB978 \uB458\uC744 \uB9D0\uB838\uB2E4. \"\uD559\uC0DD\uC774\uB124. \uD63C\uC790\uC57C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019924
    m_Localized: "\"\uD559\uAD50\uC5D0\uC11C \uC654\uC5B4\uC694. \uC774\uC57C\uAE30 \uC880 \uD574\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019925
    m_Localized: "\uCC9C\uCC9C\uD788 \uB4B7\uAC78\uC74C\uC9C8 \uCCD0 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019926
    m_Localized: "\uCC3D\uACE0 \uC0AC\uBB34\uC2E4 \uC548, \uB2F4\uC694\uB97C \uB450\uB978 \uC5EC\uC790\uC544\uC774\uAC00 \uD1B5\uC870\uB9BC\uC744 \uC138\uACE0 \uC788\uB2E4. \uACE0\uAC1C\uB97C \uB4E0 \uC5BC\uAD74. \uCD5C\uD558\uB9B0\uC774\uC5C8\uB2E4. \uC190\uC774 \uC800\uC808\uB85C \uC8FC\uBA39\uC744 \uC950\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019927
    m_Localized: "\uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uACE0 \uADF8 \uC55E\uC5D0 \uC120\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019928
    m_Localized: "\uBB38\uC744 \uB2EB\uACE0 \uB3CC\uC544\uC120\uB2E4 (\uC9C0\uAE08\uC740 \uC544\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019929
    m_Localized: "\uC99D\uAC70\uBB3C \uBCF4\uAD00\uC2E4 \uC120\uBC18 \uC704\uC5D0 \uC11C\uB958\uCCA0\uC774 \uD3BC\uCCD0\uC838 \uC788\uB2E4. '\uAE34\uAE09 \uCD9C\uC785 \uD1B5\uC81C \uD611\uC870 \uC694\uCCAD \u2014 \uC0C8\uBCBD\uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9'. \uB0A0\uC9DC\uB294 \uC0AC\uD0DC \uB2F7\uC0C8 \uC804."
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019930
    m_Localized: "\uC11C\uB958\uCCA0\uC744 \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 178089153019931
    m_Localized: "\uADF8\uB300\uB85C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 180982430056448
    m_Localized: "\uC785\uAE40\uC774 \uD558\uC597\uB2E4. \uAD6C\uC870\uAE4C\uC9C0 \uB0A8\uC740 \uC8FC\uB97C \uC138\uB294 \uBC84\uB987\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582400
    m_Localized: "\uAD6C\uC870\uAE4C\uC9C0 \uBA87 \uC8FC. \uC120\uC0DD\uB2D8 \uAE30\uCE68\uC740 \uB9E4\uC77C \uC870\uAE08\uC529 \uAE4A\uC5B4\uC9C4\uB2E4. \uC2DC\uACC4\uAC00 \uB450 \uAC1C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582401
    m_Localized: "\uC5F0\uAD6C\uB3D9 \uC9C0\uD558\uC5D0\uC11C \uAC00\uC838\uC628 \uD30C\uC77C. \uC54C\uC544\uB4E4\uC744 \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uAC00 \uBC18\uC774\uB2E4. \uADF8\uB798\uB3C4 \uB9E4\uC77C \uBC24 \uC77D\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582402
    m_Localized: "\uC120\uC0DD\uB2D8 \uC5F4\uC774 \uB0B4\uB838\uB2E4. \uC0AC\uD758\uC9F8. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC218\uCCA9\uC5D0 \uCC98\uC74C\uC73C\uB85C '\uC815\uC0C1'\uC774\uB77C\uACE0 \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582403
    m_Localized: "\uC2E4\uD328\uD588\uB2E4. \uADF8\uB798\uB3C4 \uC120\uC0DD\uB2D8\uC740 \uC6C3\uC5C8\uB2E4. \uD574 \uBD24\uC73C\uB2C8 \uB410\uB2E4\uACE0. \uAE30\uB85D\uC740 \uB0A8\uB294\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582404
    m_Localized: "\uACC4\uD68D\uC740 \uB124\uAC00 \uC138\uC6CC\uB77C. \uB09C \uC606\uC5D0\uC11C \uACE0\uAC1C\uB9CC \uB044\uB355\uC774\uB9C8. \uC798\uD558\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582405
    m_Localized: "\uB2E4\uB9AC\uB294 \uD558\uB098\uC9C0\uB9CC \uC228\uC740 \uB450 \uBC30\uB85C \uC26C\uC5B4\uC9C0\uB294\uAD6C\uB098. \uC790, \uB2E4\uC74C \uC218\uC5C5\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582406
    m_Localized: "\uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9 \uC9C0\uD558\uC5D0\uC11C \uAE30\uB85D\uC744 \uCC3E\uC544\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582407
    m_Localized: "\uC120\uC0DD\uB2D8\uC744 \uB0AB\uAC8C \uD558\uB824\uACE0 \uB9C8\uC9C0\uB9C9 \uCC98\uCE58\uB97C \uC2DC\uB3C4\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582408
    m_Localized: "\uBE48 \uAC15\uB2F9\uC5D0\uC11C \uC878\uC5C5\uC2DD\uC744 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582409
    m_Localized: "\uAD6C\uC870 \uC804\uB0A0 \uBC24, \uBAA8\uB450 \uC625\uC0C1\uC5D0 \uBAA8\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582410
    m_Localized: "\uC0C8\uBCBD\uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582411
    m_Localized: "\uC9C0\uD558 \uAE30\uB85D\uC2E4 \uCE90\uBE44\uB2DB \uB9E8 \uC544\uB798 \uCE78. '\uD734\uBA74 \uC0C1\uD0DC \uAC10\uC5FC \uCD94\uC801 \uAD00\uCC30 \u2014 \uB300\uC678\uBE44'\uB77C\uACE0 \uC801\uD78C \uB450\uAEBC\uC6B4 \uD30C\uC77C\uCCA0\uACFC \uC678\uC7A5 \uD558\uB4DC. \uB204\uAD70\uAC00 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC815\uB9AC\uD574 \uB454 \uD754\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582412
    m_Localized: "\uD30C\uC77C\uACFC \uD558\uB4DC\uB97C \uBAA8\uB450 \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582413
    m_Localized: "\uC9C0\uAE08\uC740 \uB450\uACE0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582414
    m_Localized: "\uC2E4\uD5D8\uB300 \uC704 \uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0 \uAE09\uD558\uAC8C \uD718\uAC08\uAE34 \uBA54\uBAA8. '\uC815\uC218 \uACF5\uC815 \uC2DC\uB8CC B-7, \uBC18\uC751 \uC774\uC0C1. \uBCF4\uACE0\uD588\uC73C\uB098 \uBB35\uC0B4.' \uADF8 \uC544\uB798 \uB0A0\uC9DC\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582415
    m_Localized: "\uBA54\uBAA8\uB97C \uBCA0\uAEF4 \uC801\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582416
    m_Localized: "\uADF8\uB300\uB85C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582417
    m_Localized: "\uC5D4\uB529\uC744 \uBCF8 \uC801\uC774 \uC788\uC5B4\uC694. \uC2DC\uC791 \uBCF4\uB108\uC2A4\uB97C \uD558\uB098 \uACE0\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582418
    m_Localized: "\uBCF4\uB108\uC2A4 \uC5C6\uC774 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582419
    m_Localized: "\uB2E8\uB828\uB41C \uBAB8"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582420
    m_Localized: "\uCCB4\uB825\xB7\uADFC\uB825\xB7\uBBFC\uCCA9 +5"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582421
    m_Localized: "\uBA3C\uC800 \uC77D\uC740 \uCC45"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582422
    m_Localized: "\uC9C0\uB825 +5, \uAC10\uC218\uC131 +3, \uC778\uBB38\xB7\uC758\uD559 Lv1"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582423
    m_Localized: "\uC228\uACA8 \uB454 \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 180982484582424
    m_Localized: "\uC2DD\uB7C9\xB7\uBB3C +12, \uC758\uC57D\uD488 +4, \uB4F1\uC0B0 \uBC30\uB0AD"
    m_Metadata:
      m_Items: []
  - m_Id: 190216773320704
    m_Localized: "\uC0DD\uC874 \uC0C1\uD0DC \uD68C\uBCF5 (\uCCB4\uB825\xB7\uBC30\uACE0\uD514\xB7\uAC08\uC99D)"
    m_Metadata:
      m_Items: []
  - m_Id: 233296838803456
    m_Localized: "\uCC98\uCE58\uC2E4 \uAD6C\uC11D\uC758 \uBCF4\uB0C9 \uC0C1\uC790. \uC5F4\uC5B4 \uBCF4\uB2C8 \uC544\uC9C1 \uCC28\uAC11\uB2E4. \uD608\uC561 \uD329 \uB450 \uAC1C, \uB77C\uBCA8\uC740 B\uD615\uACFC O\uD615."
    m_Metadata:
      m_Items: []
  - m_Id: 233296897523712
    m_Localized: "\uBCF4\uB0C9 \uC0C1\uC790\uC9F8 \uCC59\uAE34\uB2E4 (\uD608\uC561 \uD329)"
    m_Metadata:
      m_Items: []
  - m_Id: 233296897523713
    m_Localized: "\uC9C0\uAE08\uC740 \uB450\uACE0 \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 347641254002688
    m_Localized: "\uC0AC\uB78C\uC5D0\uAC8C \uB4E4\uCF1C \uCAD3\uACA8\uB0AC\uB2E4. \uCC59\uAE34 \uAC83\uC740 \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 347641908314112
    m_Localized: "\uC0AC\uB78C\uC5D0\uAC8C \uBD99\uC7A1\uD600 \uBC30\uB0AD\uC744 \uD1B5\uC9F8\uB85C \uBE7C\uC557\uACBC\uB2E4. \uBE48\uC190\uC73C\uB85C \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 347641908314113
    m_Localized: "\uC0AC\uB78C\uC5D0\uAC8C \uBD99\uC7A1\uD600 \uBC30\uB0AD\uC744 \uBE7C\uC557\uAE30\uACE0 \uD06C\uAC8C \uB2E4\uCCE4\uB2E4. \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uC654\uB294\uC9C0 \uC798 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 347641908314114
    m_Localized: "\uADF8\uB0A0 \uC774\uD6C4, \uB0AE\uC5D0 \uBC16\uC73C\uB85C \uB098\uC11C\uB294 \uAC83\uC774 \uBB34\uC12D\uB2E4. (\uB0AE \uD0D0\uD5D8 \uC2A4\uD2B8\uB808\uC2A4 \uC99D\uAC00)"
    m_Metadata:
      m_Items: []
  - m_Id: 347641908314115
    m_Localized: "\uC5B4\uB978 \uBAA9\uC18C\uB9AC. \"\uC5EC\uAE34 \uC6B0\uB9AC \uAD6C\uC5ED\uC774\uC57C. \uB098\uAC00.\" \uB4F1\uC744 \uB5A0\uBC00\uB824 \uAC74\uBB3C \uBC16\uC73C\uB85C \uCAD3\uACA8\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 347641908314116
    m_Localized: "\uBC30\uB0AD\uB048\uC774 \uB4A4\uC5D0\uC11C \uB09A\uC544\uCC44\uC84C\uB2E4. \"\uAC00\uC9C4 \uAC70 \uB2E4 \uB450\uACE0 \uAC00.\" \uBE48\uC190\uC73C\uB85C \uCAD3\uACA8\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 347641908314117
    m_Localized: "\uBC30\uB0AD\uC744 \uBE7C\uC557\uACBC\uB2E4. \uADF8\uB2E4\uC74C\uC740\u2026 \uAE30\uC5B5\uC774 \uB04A\uACBC\uB2E4. \uC815\uC2E0\uC744 \uCC28\uB838\uC744 \uB54C\uB294 \uAC74\uBB3C \uBC16\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 357718740451328
    m_Localized: "\uB2E4\uC74C \uB0AE \uD0D0\uD5D8: \uC0DD\uC874\uC790 (\uB204\uB97C \uB54C\uB9C8\uB2E4 \uC704\uD611\u2192\uAC15\uD0C8\u2192\uAD6C\uD0C0\u2192\uC5C6\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 366026239000576
    m_Localized: "\uB204\uAD70\uAC00 \uBA38\uBB3C\uB2E4 \uAC04 \uD754\uC801\uC774 \uC788\uC5C8\uB2E4. \uBE44\uC5B4 \uC788\uB358 \uACF3\uC5D0 \uBB3C\uAC74\uC774 \uC870\uAE08 \uB2E4\uC2DC \uCC44\uC6CC\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915136
    m_Localized: "\uAE61\uD328\uB4E4\uC744 \uB9C9\uC544 \uB0C8\uB2E4. (\uCE68\uC785 {0} / \uBC29\uC5B4 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915137
    m_Localized: "\uB9C9\uC9C0 \uBABB\uD588\uB2E4. \uC2DD\uB7C9\xB7\uBB3C\xB7\uC57D\uC744 \uBE7C\uC557\uAE30\uACE0 \uB2E4\uCCE4\uB2E4. (\uCE68\uC785 {0} / \uBC29\uC5B4 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915138
    m_Localized: "\uC228\uC5B4\uC11C \uB118\uACBC\uB2E4. \uADF8\uB4E4\uC774 \uB4A4\uC9C0\uACE0 \uAC04 \uC790\uB9AC\uC5D0\uC11C \uBB3C\uC790\uAC00 \uC870\uAE08 \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915139
    m_Localized: "\uC228\uC740 \uACF3\uC774 \uB4E4\uCF30\uB2E4. \uC2DD\uB7C9\xB7\uBB3C\xB7\uC57D\uC744 \uBE7C\uC557\uAE30\uACE0 \uB2E4\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915140
    m_Localized: "\uBB3C\uC790 \uC77C\uBD80\uB97C \uB0B4\uC8FC\uACE0 \uB3CC\uB824\uBCF4\uB0C8\uB2E4. \uC544\uBB34\uB3C4 \uB2E4\uCE58\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915141
    m_Localized: "\uB2E4\uCE5C \uC0AC\uB78C: {0}. \uB450 \uC8FC \uB3D9\uC548 \uB9E1\uC740 \uC77C\uC744 \uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915142
    m_Localized: "\uCE74\uC6B4\uD130 \uB4A4\uC5D0 \uB204\uAC00 \uC790\uACE0 \uAC04 \uD754\uC801\uC774 \uC788\uB2E4. \uBE44\uC5B4 \uC788\uB358 \uC120\uBC18\uC5D0 \uBB3C\uAC74\uC774 \uBA87 \uAC1C \uB2E4\uC2DC \uB193\uC5EC \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915143
    m_Localized: "\uC57D\uC7A5 \uC55E\uC5D0 \uBE48 \uC0C1\uC790\uAC00 \uC313\uC5EC \uC788\uB2E4. \uB204\uAD70\uAC00 \uC815\uB9AC\uD558\uACE0 \uAC04 \uB4EF, \uBA87 \uCE78\uC5D0 \uC57D\uC774 \uB2E4\uC2DC \uB4E4\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915144
    m_Localized: "\uD604\uAD00\uBB38\uC774 \uC5F4\uB824 \uC788\uACE0 \uAC70\uC2E4\uC5D0 \uC774\uBD88\uC774 \uAE54\uB824 \uC788\uB2E4. \uBA70\uCE60 \uBA38\uBB38 \uC0AC\uB78C\uC774 \uB450\uACE0 \uAC04 \uBB3C\uAC74\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915145
    m_Localized: "\uC2B9\uAC15\uC7A5 \uAD6C\uC11D\uC5D0 \uAEBC\uC9C4 \uBAA8\uB2E5\uBD88 \uC790\uAD6D. \uB204\uAD70\uAC00 \uC9D0\uC744 \uD480\uC5C8\uB2E4\uAC00 \uC11C\uB458\uB7EC \uB5A0\uB09C \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915146
    m_Localized: "\uCC3D\uACE0 \uBB38\uC5D0 \uC0C8 \uC790\uBB3C\uC1E0 \uC790\uAD6D\uC774 \uC788\uB2E4. \uB2E4\uB978 \uBB34\uB9AC\uAC00 \uC62E\uACA8 \uB454 \uBB3C\uAC74\uC774 \uC544\uC9C1 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915147
    m_Localized: "\uCC45\uC0C1 \uC704\uC5D0 \uB0AF\uC120 \uC190\uC804\uB4F1\uACFC \uCABD\uC9C0. \uB204\uAD70\uAC00 \uC5EC\uAE30\uC11C \uBC24\uC744 \uBCF4\uB0B4\uACE0 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 366026301915148
    m_Localized: "\uD38C\uD504\uC2E4 \uBC14\uB2E5\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uC5B4\uC9C0\uB7FD\uB2E4. \uB204\uAD70\uAC00 \uBA38\uBB3C\uB2E4 \uAC00\uBA74\uC11C \uBB3C\uD1B5 \uBA87 \uAC1C\uB97C \uB450\uACE0 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382558822219776
    m_Localized: "\uB09C\uC774\uB3C4\uB97C \uACE0\uB974\uC138\uC694. \uC2DC\uC791\uD55C \uB4A4\uC5D0\uB294 \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134336
    m_Localized: "\uC774\uC57C\uAE30 \uC911\uC2EC"
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134337
    m_Localized: "\uC774\uC57C\uAE30\uB97C \uB530\uB77C\uAC00\uACE0 \uC2F6\uC740 \uBD84\uAED8. \uC18C\uBAA8 \xD70.75, \uD0D0\uD5D8 \uD53C\uD574 \xD70.6, \uC0AC\uB78C\uC758 \uC704\uD611 \xD70.7, \uAC10\uC5FC \uC9C4\uD589 \xD70.6. \uB9E4\uC8FC \uD55C \uBC88 \uADF8 \uC8FC\uB97C \uB418\uB3CC\uB9B4 \uC218 \uC788\uACE0, \uD0D0\uD5D8\uC744 \uC790\uB3D9 \uC218\uC0C9\uC73C\uB85C \uB9E1\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4(\uBCF4\uC0C1 70%)."
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134338
    m_Localized: "\uD45C\uC900"
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134339
    m_Localized: "\uC0B4\uC544\uB0A8\uAE30 \uD798\uB4E0 \uC138\uACC4. \uACC4\uD68D \uD558\uB098\uD558\uB098\uAC00 \uC0DD\uC0AC\uB97C \uAC00\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134340
    m_Localized: "\uD558\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134341
    m_Localized: "\uB354 \uAC00\uD639\uD55C \uC138\uACC4. \uD0D0\uD5D8 \uD53C\uD574 \xD71.4, \uC0AC\uB78C\uC758 \uC704\uD611 \xD71.3, \uAC10\uC5FC \uC9C4\uD589 \xD71.3, \uC218\uD655 \xD70.9."
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134342
    m_Localized: "\uC774\uBC88 \uC8FC \uB418\uB3CC\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134343
    m_Localized: "\uD55C \uC8FC \uC804\uC73C\uB85C \uB418\uB3CC\uB838\uB2E4. \uC774\uBC88 \uC8FC\uB294 \uB2E4\uC2DC \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134344
    m_Localized: "\uC790\uB3D9 \uC218\uC0C9 \uB9E1\uAE30\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 382558885134345
    m_Localized: "\uC790\uB3D9 \uC218\uC0C9: \uC9C1\uC811 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uACE0 \uACB0\uACFC\uB9CC \uBC1B\uB294\uB2E4. \uC5BB\uB294 \uC790\uC6D0 {0}%."
    m_Metadata:
      m_Items: []
  - m_Id: 389735670628352
    m_Localized: "\uD63C\uC7A3\uB9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 389735741931520
    m_Localized: "(\uBB38\uC740 \uBC16\uC5D0\uC11C \uC7A0\uACA8 \uC788\uB2E4. \uC9C0\uAE08\uC740 \uBC84\uD2F0\uB294 \uC218\uBC16\uC5D0 \uC5C6\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 389735741931521
    m_Localized: "(\uD558\uB8E8, \uB610 \uD558\uB8E8. \uBB38\uD2C8\uC758 \uBE5B\uC774 \uBC1D\uC544\uC84C\uB2E4 \uC5B4\uB450\uC6CC\uC9C4\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 421717267988480
    m_Localized: "\uCE68\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680256
    m_Localized: "\uC57D\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680257
    m_Localized: "\uC2E4\uD5D8\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680258
    m_Localized: "\uC57D\uD488\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680259
    m_Localized: "\uD53C\uC544\uB178"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680260
    m_Localized: "\uC545\uAE30\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680261
    m_Localized: "\uC870\uB9AC\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680262
    m_Localized: "\uAC00\uC2A4\uB808\uC778\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680263
    m_Localized: "\uCEF4\uD4E8\uD130 \uCC45\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680264
    m_Localized: "\uC7A5\uBE44 \uB799"
    m_Metadata:
      m_Items: []
  - m_Id: 421717347680265
    m_Localized: "\uBC29\uC1A1 \uCF58\uC194"
    m_Metadata:
      m_Items: []
  - m_Id: 421931714363392
    m_Localized: "\uBE57\uBB3C(\uC815\uC218 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277952
    m_Localized: "\uACFC\uD559\xB7\uD654\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277953
    m_Localized: "\uC74C\uC545"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277954
    m_Localized: "\uBD80\uC0C1: \uC758\uC57D\uD488\uC73C\uB85C \uCE58\uB8CC\uD558\uAE30 \uC804\uAE4C\uC9C0 \uCCB4\uB825\uC774 \uD68C\uBCF5\uB418\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277955
    m_Localized: "\uD06C\uAC8C \uB2E4\uCCE4\uB2E4. \uC758\uC57D\uD488\uC73C\uB85C \uCE58\uB8CC\uD558\uAE30 \uC804\uAE4C\uC9C0\uB294 \uC26C\uC5B4\uB3C4 \uB0AB\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277956
    m_Localized: "\uD06C\uAC8C \uB2E4\uCCE4\uB2E4. \uC9C0\uC800\uBD84\uD55C \uACF3\uC774\uB77C \uC0C1\uCC98\uAC00 \uB367\uB0A0 \uAC83 \uAC19\uB2E4. \uC758\uC57D\uD488\uC73C\uB85C \uCE58\uB8CC\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277957
    m_Localized: "\uC591\uD638\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277958
    m_Localized: "\uACFC\uD559\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277959
    m_Localized: "\uC74C\uC545\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277960
    m_Localized: "\uAC00\uC0AC \uC2E4\uC2B5\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277961
    m_Localized: "\uCEF4\uD4E8\uD130\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 421931777277962
    m_Localized: "\uBC29\uC1A1\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 424816003006464
    m_Localized: "\uC694\uB9AC \uC644\uC131: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 424816070115328
    m_Localized: "\uC8FC\uBA39\uBC25\uACFC \uC8FD"
    m_Metadata:
      m_Items: []
  - m_Id: 424816070115329
    m_Localized: "\uB41C\uC7A5\uAD6D"
    m_Metadata:
      m_Items: []
  - m_Id: 424816070115330
    m_Localized: "\uB530\uB73B\uD55C \uC815\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 427324008054784
    m_Localized: "\uB4E0\uB4E0\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552256
    m_Localized: "\uBC30\uBD80\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552257
    m_Localized: "\uBCF4\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552258
    m_Localized: "\uD5C8\uAE30\uC9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552259
    m_Localized: "\uAD76\uC8FC\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552260
    m_Localized: "\uB109\uB109\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552261
    m_Localized: "\uCD09\uCD09\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552262
    m_Localized: "\uBAA9\uB9C8\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552263
    m_Localized: "\uD0C8\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552264
    m_Localized: "\uD3EC\uB9CC"
    m_Metadata:
      m_Items: []
  - m_Id: 427324083552265
    m_Localized: "\uC218\uBD84"
    m_Metadata:
      m_Items: []
  - m_Id: 432515390390272
    m_Localized: "\uC57D\uAC04 \uB2E4\uCCE4\uC9C0\uB9CC, \uC751\uAE09 \uCE58\uB8CC\uB85C \uC798 \uB9C8\uBB34\uB9AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 432515461693440
    m_Localized: "\uC57D\uAC04 \uB2E4\uCCE4\uC9C0\uB9CC, \uC190\uC5D0 \uC775\uC740 \uC751\uAE09 \uCE58\uB8CC\uB85C \uAE08\uBC29 \uB9C8\uBB34\uB9AC\uD588\uB2E4. \uD749\uD130\uB3C4 \uB0A8\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 432515461693441
    m_Localized: "\uBD80\uC0C1\uC744 \uCE58\uB8CC\uD588\uB2E4. \uC774\uC81C \uC26C\uBA74 \uB0AB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782942814208
    m_Localized: "{0} \uD3C9\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340160
    m_Localized: "\uC0C8 \uC138\uB825: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340161
    m_Localized: "\uC138\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340162
    m_Localized: "{0} \xB7 {1} {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340163
    m_Localized: "\uC801\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340164
    m_Localized: "\uACBD\uACC4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340165
    m_Localized: "\uC911\uB9BD"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340166
    m_Localized: "\uD638\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340167
    m_Localized: "\uB3D9\uB9F9"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340168
    m_Localized: "\uAD00\uACC4: {0} (\uD3C9\uD310 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340169
    m_Localized: "\uC9C0\uAE08 \uBC1B\uB294 \uC601\uD5A5"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340170
    m_Localized: "\uCD5C\uADFC \uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340171
    m_Localized: "{0}\uC8FC \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340172
    m_Localized: "\uC5F0\uB77D\uC774 \uB738\uD574\uC838 \uC0AC\uC774\uAC00 \uC870\uAE08 \uBA40\uC5B4\uC84C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340173
    m_Localized: "\uAC70\uB798: {0} \uC8FC\uACE0 {1} \uBC1B\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340174
    m_Localized: "\uAC70\uB798: {0} \uC8FC\uACE0 {1} \uBC1B\uAE30 (\uB2E4\uC74C \uC8FC \uB3C4\uCC29)"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340175
    m_Localized: "\uAC70\uB798\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340176
    m_Localized: "\uC544\uC9C1 \uC774 \uAC70\uB798\uB97C \uD560 \uB9CC\uD07C \uAC00\uAE5D\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340177
    m_Localized: "\uC544\uC9C1 \uB2E4\uC74C \uAC70\uB798 \uB54C\uAC00 \uC544\uB2C8\uB2E4. (\uC6B4\uBC18\uC740 2\uC8FC\uC5D0 \uD55C \uBC88, \uB3D9\uB9F9\uC774\uBA74 \uD55C \uBC88\uC5D0 \uB450 \uAC00\uC9C0)"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340178
    m_Localized: "\uB0B4\uC904 \uBB3C\uC790\uAC00 \uBAA8\uC790\uB77C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340179
    m_Localized: "\uAC70\uB798\uB294 \uC8FC\uAC04 \uACC4\uD68D \uC911\uC5D0\uB9CC \uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340180
    m_Localized: "\uC0AC\uAC70\uB9AC \uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340181
    m_Localized: "\uD559\uAD50 \uC55E \uD070 \uC0AC\uAC70\uB9AC\uB97C \uADFC\uAC70\uC9C0\uB85C \uC0BC\uC740 \uC57D\uD0C8 \uD328\uAC70\uB9AC. \uB2F4\uC7A5\uC5D0 \uD398\uC778\uD2B8\uB85C \uD45C\uC2DC\uB97C \uB0A8\uAE30\uACE0, \uC57D\uD55C \uACF3\uBD80\uD130 \uD134\uB2E4. \uB450\uBAA9\uC740 '\uAC15\uCCA0'\uC774\uB77C\uACE0 \uBD88\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340182
    m_Localized: "\uC6B0\uB9AC\uB97C \uB2E4\uC74C \uD45C\uC801\uC73C\uB85C \uCC0D\uC5C8\uB2E4. \uBC24\uC774 \uBB34\uC12D\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340183
    m_Localized: "\uD559\uAD50\uB97C \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB2E4. \uC544\uC9C1\uC740 \uC190\uB300\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340184
    m_Localized: "\uD1B5\uD589\uC138\uB97C \uBC1B\uB294 \uB300\uC2E0 \uC190\uB300\uC9C0 \uC54A\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340185
    m_Localized: "\uD1B5\uD589\uC138\uB9CC \uB0B4\uBA74 \uAE38\uC744 \uD130 \uC900\uB2E4. \uAC00\uB054 \uC18C\uC2DD\uB3C4 \uD758\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340186
    m_Localized: "'\uD559\uAD50 \uC560\uB4E4\uC740 \uAC74\uB4DC\uB9AC\uC9C0 \uB9C8'\uB77C\uB294 \uB9D0\uC774 \uC0AC\uAC70\uB9AC\uC5D0 \uB3CC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340187
    m_Localized: "\uBC24 \uC2B5\uACA9\uC774 \uC7A6\uACE0 \uAC70\uC138\uB2E4. \uB0AE \uCE68\uC785\uACFC \uB0AE \uD0D0\uD5D8\uC5D0\uC11C \uB9C8\uC8FC\uCE60 \uC77C\uB3C4 \uB9CE\uC544\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340188
    m_Localized: "\uC9C0\uCF1C\uBCF4\uB294 \uC911. \uC544\uC9C1 \uD2B9\uBCC4\uD55C \uC77C\uC740 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340189
    m_Localized: "\uD734\uC804: \uC2B5\uACA9\xB7\uCE68\uC785\xB7\uB0AE \uD0D0\uD5D8 \uC2B5\uACA9\uC774 \uC870\uAE08 \uC904\uC5B4\uB4E0\uB2E4. \uB300\uC2E0 \uB9E4\uC8FC \uC2DD\uB7C9 3\uC744 \uD1B5\uD589\uC138\uB85C \uB0B8\uB2E4. \uC0AC\uAC70\uB9AC\uC5D0\uC11C \uC2DD\uB7C9\uACFC \uC790\uC7AC\uB97C \uB9DE\uBC14\uAFC0 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340190
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340191
    m_Localized: "\uC0C8\uBCBD\uB9C8\uD2B8\uC640 \uBB3C\uB958\uCC3D\uACE0\uC5D0 \uC790\uB9AC \uC7A1\uC740 \uC5B4\uB978 \uC0DD\uC874\uC790 \uC5F4\uD55C \uBA85. \uBB3C\uB958\uCC3D\uACE0 \uBC18\uC7A5\uC774\uB358 \uC815 \uBC18\uC7A5\uC774 \uC774\uB048\uB2E4. \uBA39\uC744 \uAC83\uC740 \uB9CE\uACE0 \uC57D\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340192
    m_Localized: "\uB9C8\uD2B8 \uADFC\uCC98\uC5D0 \uAC00\uBA74 \uBB38\uBD80\uD130 \uAC78\uC5B4 \uC7A0\uADFC\uB2E4. \uAE38\uBAA9\uC5D0\uC11C \uC6B0\uB9AC\uB97C \uB9C9\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340193
    m_Localized: "\uC6B0\uB9AC\uB97C \uBBFF\uC9C0 \uC54A\uB294\uB2E4. \uAC70\uB798 \uC598\uAE30\uB294 \uAEBC\uB0B4\uC9C0\uB3C4 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340194
    m_Localized: "\uC11C\uB85C \uD544\uC694\uD55C \uB9CC\uD07C\uB9CC. \uC790\uC7AC\uB77C\uBA74 \uC2DD\uB7C9\uACFC \uBC14\uAFD4 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340195
    m_Localized: "\uC815 \uBC18\uC7A5\uC774 \uBB34\uC804\uC744 \uAE30\uB2E4\uB9B0\uB2E4. \uC57D\uC774\uB77C\uBA74 \uC5B8\uC81C\uB4E0 \uD658\uC601\uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340196
    m_Localized: "'\uD559\uAD50 \uC560\uB4E4'\uC740 \uC774\uC81C \uB9C8\uD2B8 \uC2DD\uAD6C\uB2E4. \uD2B8\uB7ED\uB3C4 \uBE4C\uB824 \uC904 \uC218 \uC788\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340197
    m_Localized: "\uC0AC\uC774\uAC00 \uB098\uC058\uB2E4: \uB0AE \uD0D0\uD5D8\uC5D0\uC11C \uC0AC\uB78C\uACFC \uBD80\uB52A\uCE60 \uC77C\uC774 \uC870\uAE08 \uB298\uC5B4\uB09C\uB2E4. \uAC70\uB798\uB294 \uB9C9\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340198
    m_Localized: "\uD55C \uBC88\uC5D0 \uD55C \uAC00\uC9C0\uC529 \uBB3C\uAC74\uC744 \uBC14\uAFC0 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340199
    m_Localized: "\uAC00\uAE4C\uC6B4 \uC0AC\uC774: \uAC19\uC740 \uAC12\uC5D0 \uB354 \uB109\uB109\uD788 \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340200
    m_Localized: "\uB3D9\uB9F9: \uC218\uD559\uC5EC\uD589 \uB54C \uD2B8\uB7ED\uC744 \uBE4C\uB9B4 \uC218 \uC788\uACE0, \uD55C \uBC88\uC5D0 \uB450 \uAC00\uC9C0\uB97C \uBC14\uAFC0 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340201
    m_Localized: "\uB9C8\uD2B8 \uC0AC\uBB34\uC2E4\uC5D0\uC11C \uC815 \uBC18\uC7A5\uACFC \uC774\uC57C\uAE30\uB97C \uB098\uB234\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340202
    m_Localized: "\uB9C8\uD2B8 \uC0AC\uB78C\uB4E4\uACFC \uB9C8\uC8FC\uCCE4\uC9C0\uB9CC \uBB3C\uB7EC\uB0AC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340203
    m_Localized: "\uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uD568\uAED8 \uACE0\uAE30\uB97C \uAD6C\uC6E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340204
    m_Localized: "\uD2B8\uB7ED\uC744 \uBE4C\uB824 \uBC14\uB2E4\uC5D0 \uB2E4\uB140\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340205
    m_Localized: "\uC4F8 \uB9CC\uD55C \uC790\uC7AC\uB97C \uC300\uACFC \uD1B5\uC870\uB9BC\uC73C\uB85C \uBC14\uAFBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340206
    m_Localized: "\uC790\uC7AC\uB97C \uC2DD\uB7C9\uC73C\uB85C \uBC14\uAFE8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340207
    m_Localized: "\uC57D\uC774 \uADC0\uD55C \uB9C8\uD2B8\uC5D0 \uC758\uC57D\uD488\uC744 \uAC74\uB124\uACE0 \uC2DD\uB7C9\uC744 \uB109\uB109\uD788 \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340208
    m_Localized: "\uC758\uC57D\uD488\uC744 \uAC74\uB124\uACE0 \uC2DD\uB7C9\uC744 \uBC1B\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340209
    m_Localized: "\uC2DD\uB7C9\uC744 \uC8FC\uACE0 \uBC1C\uC804\uAE30 \uC5F0\uB8CC\uB97C \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340210
    m_Localized: "\uC2DD\uB7C9\uC744 \uC8FC\uACE0 \uC5F0\uB8CC\uB97C \uBC1B\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340211
    m_Localized: "\uBB3C\uB958\uCC3D\uACE0\uC758 \uC0DD\uC218\uB97C \uC790\uC7AC\uC640 \uBC14\uAFBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340212
    m_Localized: "\uC790\uC7AC\uB97C \uC0DD\uC218\uB85C \uBC14\uAFE8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340213
    m_Localized: UBC
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340214
    m_Localized: "\uC61B \uBC29\uC1A1\uAD6D \uAC74\uBB3C\uC5D0 \uBAA8\uC778 \uC0DD\uC874\uC790\uB4E4. \uB77C\uB514\uC624 DJ\uAC00 \uBC24\uB9C8\uB2E4 \uBC29\uC1A1\uC744 \uB0B4\uBCF4\uB0B8\uB2E4. \uCCB4\uC721\uACF5\uC6D0 \uB300\uD53C\uC18C\uC5D0\uC11C \uC62E\uACA8 \uC628 \uC0AC\uB78C\uB4E4\uB3C4 \uC5EC\uAE30 \uC788\uB2E4\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340215
    m_Localized: "\uC6B0\uB9AC \uC8FC\uD30C\uC218\uB97C \uB9C9\uC558\uB2E4. \uBC29\uC1A1\uC774 \uB4E4\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340216
    m_Localized: "\uC6B0\uB9AC \uC0AC\uC5F0\uC740 \uC77D\uC5B4 \uC8FC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340217
    m_Localized: "\uBC29\uC1A1\uC740 \uB4E4\uB9AC\uC9C0\uB9CC, \uC6B0\uB9AC\uC5D0\uAC8C \uD558\uB294 \uB9D0\uC740 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340218
    m_Localized: "DJ\uAC00 \uAC00\uB054 '\uD559\uAD50 \uCE5C\uAD6C\uB4E4'\uC5D0\uAC8C \uC548\uBD80\uB97C \uC804\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340219
    m_Localized: "\uAD6C\uC870 \uC18C\uC2DD\uC774 \uB4E4\uC5B4\uC624\uBA74 \uAC00\uC7A5 \uBA3C\uC800 \uC54C\uB824 \uC8FC\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340220
    m_Localized: "\uBA40\uB2E4. \uBC29\uC1A1\uC740 \uC704\uC548\uC774 \uB418\uC9C0\uB9CC \uADF8 \uC774\uC0C1\uC740 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340221
    m_Localized: "\uBC24 \uBC29\uC1A1\uC774 \uC704\uC548\uC774 \uB41C\uB2E4(\uB9E4\uC8FC \uC2A4\uD2B8\uB808\uC2A4 \u22122). \uC704\uD5D8 \uACBD\uBCF4 \uB355\uC5D0 \uBC24 \uC2B5\uACA9\uC774 \uC544\uC8FC \uC870\uAE08 \uC904\uC5B4\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340222
    m_Localized: "\uB3D9\uB9F9: \uAD6C\uC870\uB300\uC640\uC758 \uAD50\uC2E0\uC744 \uB098\uB220 \uC8FC\uACE0, \uD55C \uBC88\uC5D0 \uB450 \uAC00\uC9C0\uB97C \uBC14\uAFC0 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340223
    m_Localized: "\uBC1C\uC804\uAE30 \uC5F0\uB8CC\uB97C \uBCF4\uB0B4\uBA74, \uC6B4\uBC18\uC870\uAC00 \uB2E4\uC74C \uC8FC\uC5D0 \uC758\uC57D\uD488\uC744 \uAD50\uBB38 \uC55E\uC5D0 \uB450\uACE0 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340224
    m_Localized: "\uC5F0\uB8CC\uB97C \uBCF4\uB0B4\uACE0 \uC758\uC57D\uD488\uC744 \uBD80\uD0C1\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340225
    m_Localized: "\uC548\uD14C\uB098 \uBD80\uD488\uC744 \uBCF4\uB0B4\uBA74, \uB2E4\uC74C \uC8FC\uC5D0 \uC0DD\uC218\uB97C \uBCF4\uB0B4 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 464782997340226
    m_Localized: "\uBD80\uD488\uC744 \uBCF4\uB0B4\uACE0 \uC0DD\uC218\uB97C \uBD80\uD0C1\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466107957248
    m_Localized: "\uD559\uAD50 \uB2F4\uC7A5\uC5D0 \uBD89\uC740 \uD45C\uC2DC\uAC00 \uC0DD\uACBC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677504
    m_Localized: "\uD45C\uC2DC\uB97C \uC9C0\uC6B0\uACE0 \uAD50\uBB38\uC744 \uB9C9\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677505
    m_Localized: "\uC804\uAC08\uC744 \uBC1B\uACE0 \uC2DD\uB7C9\uC744 \uB0B4\uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677506
    m_Localized: "\uC870\uAC74\uC744 \uAC78\uACE0 \uD1B5\uD589\uC138\uB97C \uD765\uC815\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677507
    m_Localized: "\uD765\uC815\uD558\uB2E4 \uC595\uBCF4\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677508
    m_Localized: "\uD1B5\uD589\uC138\uB97C \uAC70\uC808\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677509
    m_Localized: "\uB2F4\uC7A5\uC744 \uBCF4\uAC15\uD574 \uB9DE\uC130\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677510
    m_Localized: "\uAC00\uAC8C \uC720\uB9AC\uBB38\uC5D0\uC11C \uBC29\uC1A1 \uC804\uB2E8\uC9C0\uB97C \uCC3E\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 468466166677511
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBB34\uC804\uAE30\uB85C \uCC98\uC74C \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624523726848
    m_Localized: "DJ \uC0C8\uBCBD\uC758 \uBC29\uC1A1\uC5D0 \uCC98\uC74C \uB300\uB2F5\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641408
    m_Localized: "3\uBC88 \uCC44\uB110\uB85C DJ\uC640 \uB530\uB85C \uC774\uC57C\uAE30\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641409
    m_Localized: "\uC548\uD14C\uB098 \uBD80\uD488\uC744 \uADF8\uB0E5 \uBCF4\uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641410
    m_Localized: "\uAC15\uBCC0\uC5D0\uC11C \uC6B4\uBC18\uC870 \uBBFC\uADDC\uB97C \uCC3E\uC544 \uB370\uB824\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641411
    m_Localized: "\uBBFC\uADDC\uB97C \uCC3E\uC73C\uB7EC \uAC15\uBCC0\uAE4C\uC9C0 \uB098\uAC14\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641412
    m_Localized: "\uBB34\uC804\uC73C\uB85C \uBBFC\uADDC\uC5D0\uAC8C \uB3CC\uC544\uC62C \uAE38\uC744 \uC54C\uB824 \uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641413
    m_Localized: "\uBBFC\uADDC \uC218\uC0C9 \uBD80\uD0C1\uC744 \uAC70\uC808\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641414
    m_Localized: "DJ \uBC29\uC1A1\uC73C\uB85C \uB354\uBD88\uC5B4 \uB9C8\uD2B8 \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641415
    m_Localized: "\uB9C8\uD2B8 \uC0AC\uBB34\uC2E4\uC5D0\uC11C \uCCAB \uAC70\uB798\uB97C \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641416
    m_Localized: "\uC815 \uBC18\uC7A5\uACFC \uC11C\uB85C \uB3D5\uAE30\uB85C \uC57D\uC18D\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624586641417
    m_Localized: "\uC815 \uBC18\uC7A5\uC758 \uC81C\uC548\uC744 \uAC70\uC808\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224320
    m_Localized: "\uAC08\uB4F1\uC744 \uB204\uADF8\uB7EC\uB728\uB9AC\uB824 \uC758\uC57D\uD488\uC744 \uBCF4\uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224321
    m_Localized: "\uB9C8\uD2B8 \uCC3D\uACE0\uB97C \uAC19\uC774 \uC9C0\uCF30\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224322
    m_Localized: "\uB2E4\uCE58\uBA74\uC11C\uB3C4 \uB9C8\uD2B8 \uCC3D\uACE0\uB97C \uC9C0\uCF30\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224323
    m_Localized: "\uC0AC\uAC70\uB9AC\uC5D0\uC11C \uB2F4\uD310\uC744 \uC9C0\uC5B4 \uCC3D\uACE0\uB97C \uC9C0\uCF30\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224324
    m_Localized: "\uB9C8\uD2B8\uAC00 \uD138\uB9AC\uB294 \uAC78 \uB450\uACE0 \uBCF4\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224325
    m_Localized: "\uC624 \uC528\uAC00 \uC228\uAE34 \uC57D\uC744 \uC815 \uBC18\uC7A5\uC5D0\uAC8C \uC54C\uB838\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224326
    m_Localized: "\uB9C8\uD2B8 \uCC3D\uACE0\uC5D0\uC11C \uC6B0\uBE44\uB4E4\uACFC \uB9DE\uC130\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224327
    m_Localized: "\uAC15\uCCA0\uC5D0\uAC8C \uACA8\uC6B8 \uBAAB\uC744 \uD55C \uBC88 \uB354 \uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224328
    m_Localized: "\uAC15\uCCA0\uC5D0\uAC8C '\uC6D0\uCE59'\uC73C\uB85C \uB9DE\uC11C \uC778\uC815\uBC1B\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224329
    m_Localized: "\uAC15\uCCA0\uC5D0\uAC8C \uB9DE\uC130\uB2E4\uAC00 \uC595\uBCF4\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224330
    m_Localized: "\uD1B5\uD589\uC138 \uC57D\uC18D\uC744 \uB04A\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224331
    m_Localized: "\uAD50\uBB38 \uC548\uCABD\uC5D0 \uAC15\uCCA0\uC758 \uACBD\uACE0\uC7A5\uC774 \uBC15\uD614\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224332
    m_Localized: "\uB2A6\uAC8C\uB098\uB9C8 \uC2DD\uB7C9\uC744 \uBCF4\uB0B4 \uD654\uD574\uB97C \uCCAD\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224333
    m_Localized: "\uB2E4\uCE5C \uC5B4\uB9B0 \uC870\uC9C1\uC6D0 \uC900\uC744 \uCE58\uB8CC\uD574 \uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224334
    m_Localized: "\uB2E4\uCE5C \uC900\uC5D0\uAC8C \uBA39\uC744 \uAC83\uC744 \uC950\uC5EC \uBCF4\uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224335
    m_Localized: "\uCCD0\uB4E4\uC5B4\uC628 \uC6B0\uBE44\uB4E4\uACFC \uB9DE\uC130\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224336
    m_Localized: "\uCCD0\uB4E4\uC5B4\uC628 \uC6B0\uBE44\uB4E4\uC744 \uD53C\uD574 \uC228\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 471624599224337
    m_Localized: "\uCCD0\uB4E4\uC5B4\uC628 \uC6B0\uBE44\uB4E4\uC5D0\uAC8C \uBB3C\uC790\uB97C \uB0B4\uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676819410944
    m_Localized: "\uB5A0\uB0A8"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131200
    m_Localized: "\uC774\uBBF8 \uB5A0\uB09C \uC138\uB825\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131201
    m_Localized: "\uB0A8\uCABD\uC73C\uB85C \uB5A0\uB0AC\uB2E4. \uB2E4\uB978 \uD5EC\uAE30\uB97C \uAE30\uB2E4\uB9B0\uB2E4\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131202
    m_Localized: "\uC0AC\uAC70\uB9AC\uC5D0 \uB354\uB294 \uC6B0\uBE44\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131203
    m_Localized: "\uBC29\uC1A1\uC774 \uB04A\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131204
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD55C\uD30C \uB0A0 \uB2F4\uC7A5\uC5D0 \uAC19\uC774 \uC11C\uAE30\uB85C \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131205
    m_Localized: "\uAC15\uCCA0\uC5D0\uAC8C \uACA8\uC6B8 \uC2DD\uB7C9\uC744 \uB098\uB220 \uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131206
    m_Localized: "\uC900\uC774 \uAC15\uCCA0 \uC55E\uC744 \uB9C9\uC544\uC130\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131207
    m_Localized: "\uAD6C\uC870 \uBA85\uB2E8\uC744 \uC57D\uC18D\uD558\uACE0 \uCD5C\uD6C4\uD1B5\uCCA9\uC744 \uAC70\uB480\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131208
    m_Localized: "\uCD5C\uD6C4\uD1B5\uCCA9 \uC55E\uC5D0\uC11C \uC124\uB4DD\uD558\uC9C0 \uBABB\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131209
    m_Localized: "\uD559\uAD50\uB97C \uBE44\uC6B0\uB77C\uB294 \uCD5C\uD6C4\uD1B5\uCCA9\uC744 \uAC70\uBD80\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131210
    m_Localized: "\uD2B8\uB7ED\uC744 \uD0C0\uACE0 \uB0A8\uCABD\uC73C\uB85C \uB5A0\uB0AC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131211
    m_Localized: "\uBBFC\uADDC\uAC00 \uC790\uC804\uAC70\uB85C \uC57D\uD488 \uC0C1\uC790\uB97C \uAC00\uC838\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131212
    m_Localized: "\uAD6C\uC870\uB300 \uCC44\uB110\uC744 \uC5F0\uACB0\uD574 \uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 474676878131213
    m_Localized: "\uB3C4\uD604\uC758 \uC5B4\uBA38\uB2C8\uB97C \uCC3E\uC544 \uBB34\uC804\uC744 \uC774\uC5B4 \uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 482287274967040
    m_Localized: "\uADF8 \uB4A4\uC758 \uC774\uC57C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270208
    m_Localized: "\uC0AC\uAC70\uB9AC\uB294 \uB05D\uAE4C\uC9C0 \uC0AC\uAC70\uB9AC \uD30C\uC758 \uAC83\uC774\uC5C8\uB2E4. \uD5EC\uAE30 \uCC3D\uBC16\uC73C\uB85C \uC2E0\uD638\uB4F1\uC758 \uBD89\uC740 \uD45C\uC2DC\uAC00 \uC810\uCC98\uB7FC \uC791\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270209
    m_Localized: "\uD1B5\uD589\uC138\uB294 \uAD6C\uC870 \uC804\uB0A0\uAE4C\uC9C0 \uAF2C\uBC15\uAF2C\uBC15 \uB0C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uB0A0 \uC544\uCE68, \uC0AC\uAC70\uB9AC \uC815\uB958\uC7A5\uC5D0 \uD1B5\uC870\uB9BC \uD558\uB098\uAC00 \uAC70\uAFB8\uB85C \uB193\uC5EC \uC788\uC5C8\uB2E4. \uBC1B\uC740 \uAC74 \uAE30\uC5B5\uD55C\uB2E4\uB294 \uB73B\uC774\uC5C8\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270210
    m_Localized: "\uC0AC\uAC70\uB9AC\uC758 \uBD89\uC740 \uD45C\uC2DC\uB294 \uBD04\uBE44\uC5D0 \uC53B\uACA8 \uB098\uAC14\uB2E4. \uAC15\uCCA0\uC774 \uC5B4\uB514\uB85C \uAC14\uB294\uC9C0\uB294 \uC544\uBB34\uB3C4 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270211
    m_Localized: "\uADF8\uB0A0 \uAC15\uCCA0 \uC55E\uC744 \uB9C9\uC544\uC130\uB358 \uC544\uC774 \uB355\uBD84\uC5D0, \uB9C8\uC9C0\uB9C9 \uACA8\uC6B8\uC740 \uC870\uC6A9\uD788 \uC9C0\uB098\uAC14\uB2E4. \uC0AC\uAC70\uB9AC \uD30C\uB294 \uAD6C\uC870 \uBA85\uB2E8\uC5D0 \uC544\uC774\uB4E4 \uC774\uB984\uBD80\uD130 \uC62C\uB824 \uB2EC\uB77C\uACE0 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270212
    m_Localized: "\uC0AC\uAC70\uB9AC\uC758 \uBCF5\uC2F1 \uCCB4\uC721\uAD00 \uAC04\uD310\uC774 \uB2E4\uC2DC \uAC78\uB838\uB2E4\uACE0 \uD588\uB2E4. '\uC560\uB4E4\uC740 \uC548 \uAC74\uB4DC\uB9B0\uB2E4.' \uADF8 \uC544\uB798 \uAC15\uCCA0\uC758 \uC774\uB984\uC774 \uC791\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270213
    m_Localized: "\uC0C8\uBCBD\uB9C8\uD2B8\uC758 \uC154\uD130\uB294 \uB05D\uB0B4 \uB2E4\uC2DC \uC62C\uB77C\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270214
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC758 \uD2B8\uB7ED\uC740 \uB0A8\uCABD \uB3C4\uB85C \uC5B4\uB518\uAC00\uC5D0\uC11C \uB2E4\uB978 \uD5EC\uAE30\uB97C \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270215
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8 \uC0AC\uB78C\uB4E4\uC740 \uB0A8\uCABD\uC73C\uB85C \uAC14\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4. \uCC3D\uACE0\uAC00 \uD138\uB9AC\uB358 \uB0A0\uC758 \uC77C\uC740, \uB05D\uB0B4 \uC11C\uB85C \uAEBC\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270216
    m_Localized: "\uBD04\uC5D0 \uB0A8\uCABD \uB300\uD53C\uC18C\uC5D0\uC11C \uC815 \uBC18\uC7A5\uC758 \uC5FD\uC11C\uAC00 \uC654\uB2E4. \uD2B8\uB7ED \uC55E\uC5D0\uC11C \uCC0D\uC740 \uC0AC\uC9C4 \uD55C \uC7A5. '\uACE0\uAE30 \uAD7D\uC790. \uC57D\uC18D.'"
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270217
    m_Localized: "\uAC00\uB054 \uB77C\uB514\uC624\uB97C \uCF1C\uBA74, 98.3\uC5D0 \uC544\uC9C1 \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB0A8\uC544 \uC788\uB294 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270218
    m_Localized: "UBC\uAC00 \uB118\uACA8\uC900 \uBA85\uB2E8 \uB355\uC5D0, \uAD6C\uC870\uB300\uB294 \uD55C \uC0AC\uB78C\uB3C4 \uBE60\uB728\uB9AC\uC9C0 \uC54A\uACE0 \uC774\uB984\uC744 \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270219
    m_Localized: "\uBBFC\uADDC\uB294 \uAD6C\uC870\uB300 \uC6B4\uBC18\uC870\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4. \uC774\uC81C \uC790\uC804\uAC70 \uB300\uC2E0 \uD2B8\uB7ED\uC744 \uBAAC\uB2E4\uACE0 \uD588\uB2E4. \uBC30\uC218\uB85C \uC55E\uC744 \uC9C0\uB0A0 \uB54C\uB9C8\uB2E4 \uACBD\uC801\uC744 \uB450 \uBC88 \uC6B8\uB9B0\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270220
    m_Localized: "DJ \uC0C8\uBCBD\uC740 \uAD6C\uC870 \uB4A4\uC5D0\uB3C4 \uBC29\uC1A1\uC744 \uD588\uB2E4. \uB2E4\uC2DC \uC5F0 \uCCAB \uBC29\uC1A1\uC758 \uCCAB \uC0AC\uC5F0\uC740 '\uC0C8\uBCBD\uACE0\uB4F1\uD559\uAD50 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C'\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270221
    m_Localized: "\uB3C4\uD604\uC740 \uAD6C\uC870 \uB4A4\uC5D0\uB3C4 \uC5B4\uBA38\uB2C8\uB97C \uCC3E\uC558\uB2E4. \uAE38 \uC798 \uCC3E\uB294 \uC0AC\uB78C\uC758 \uC544\uB4E4\uB2F5\uAC8C, \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270222
    m_Localized: "\uB3C4\uD604\uC740 \uB0A8\uCABD \uB300\uD53C\uC18C\uC5D0\uC11C \uC5B4\uBA38\uB2C8\uB97C \uB9CC\uB0AC\uB2E4. \uCC98\uC74C \uD55C \uB9D0\uC774 '\uB3C4\uC2DC\uB77D \uB2E4 \uBA39\uC5C8\uC5B4'\uC600\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270223
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC784\uC2DC \uC9C4\uB8CC\uC18C\uC5D0\uC11C \uB2E4\uC2DC \uC57D\uC7A5\uC744 \uC5F4\uC5C8\uB2E4. \uBD95\uB300 \uB450 \uB864\uB85C \uC2DC\uC791\uD588\uB358 \uC57D\uC7A5\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270224
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC9C4\uB8CC\uC18C\uC5D0\uC11C \uC758\uC871 \uB9CC\uB4DC\uB294 \uBC95\uC744 \uAC00\uB974\uCCE4\uB2E4. \uCCAB \uC124\uACC4\uB3C4\uB294 \uD559\uAD50 \uCE60\uD310 \uC55E\uC5D0\uC11C \uC7B0 \uCE58\uC218 \uADF8\uB300\uB85C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270225
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uBBF8\uC220\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD588\uB2E4. \uCCAB \uADF8\uB9BC\uC740 \uD559\uAD50 \uD3C9\uBA74\uB3C4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270226
    m_Localized: "\uC1A1\uC608\uC9C0\uB294 \uBB38 \uC55E\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. {given:\uACFC/\uC640} \uAC19\uC740 \uB0A0, \uAC19\uC740 \uBB38\uC73C\uB85C \uB098\uAC14\uB2E4. \uCE5C\uAD6C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270227
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uB2E4\uB978 \uB300\uD53C\uC18C\uB85C \uAC14\uB2E4. \uADF8 \uB4A4\uC758 \uC77C\uC740, \uAC01\uC790\uC758 \uBAAB\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270228
    m_Localized: "\uCD5C\uD558\uB9B0\uACFC\uB294 \uD55C\uCC38 \uB4A4\uC5D0 \uB2E4\uC2DC \uB9CC\uB0AC\uB2E4. \uAC19\uC740 \uBC18 \uC560\uB4E4\uCC98\uB7FC, \uCC98\uC74C\uBD80\uD130. \uC11C\uD234\uB800\uC9C0\uB9CC \uB3C4\uB9DD\uCE58\uC9C0\uB294 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270229
    m_Localized: "\uCD5C\uD558\uB9B0\uACFC\uB294 \uB2E4\uC2DC \uB9CC\uB098\uC9C0 \uC54A\uC558\uB2E4. \uBBF8\uC6CC\uD558\uC9C0\uB3C4, \uAE30\uB2E4\uB9AC\uC9C0\uB3C4 \uC54A\uC558\uB2E4. \uADF8\uAC78\uB85C \uCDA9\uBD84\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270230
    m_Localized: "\uC900\uC740 \uC6B0\uBE44\uB97C \uB2E4\uC2DC \uC785\uC9C0 \uC54A\uC558\uB2E4. \uAD6C\uC870 \uBA85\uB2E8\uC5D0\uB294 \uADF8\uB0E5 '\uC900'\uC774\uB77C\uACE0 \uC801\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270231
    m_Localized: "\uACC4\uC808\uB9C8\uB2E4 \uC18C\uD48D\uC744 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270232
    m_Localized: "\uC6B0\uB9AC\uB07C\uB9AC \uC218\uD559\uC5EC\uD589\uC744 \uB2E4\uB140\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270233
    m_Localized: "\uB2F4\uC7A5\uC5D0 \uBD89\uC740 \uD45C\uC2DC\uAC00 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270234
    m_Localized: "\uB77C\uB514\uC624 \uB108\uBA38\uC758 \uBAA9\uC18C\uB9AC\uC640 \uC774\uC57C\uAE30\uB97C \uB098\uB234\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270235
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC758\uC871\uC744 \uB51B\uACE0 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270236
    m_Localized: "\uB354\uBD88\uC5B4 \uB9C8\uD2B8\uC640 \uC190\uC744 \uC7A1\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270237
    m_Localized: "\uAC15\uBCC0\uC5D0\uC11C \uBBFC\uADDC\uB97C \uCC3E\uC544 \uB370\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270238
    m_Localized: "\uCD5C\uD558\uB9B0\uC744 \uD559\uAD50\uB85C \uB370\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 482287346270239
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD55C\uD30C\uC758 \uBC24\uC744 \uBC84\uD17C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 556800675168256
    m_Localized: "\uC6B0\uD074\uB9AD: \uBC16\uC73C\uB85C \uB098\uAC00\uAE30 ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 556801501446144
    m_Localized: "\uC6B0\uD074\uB9AD: \uAC74\uBB3C\uB85C \uB4E4\uC5B4\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 556801501446145
    m_Localized: "\uBB34\uB108\uC9C4 \uACC4\uB2E8 (\uC9C0\uB098\uAC08 \uC218 \uC5C6\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 556801501446146
    m_Localized: "\uACC4\uB2E8\uC774 \uBB34\uB108\uC838 \uC788\uB2E4. \uB2E4\uB978 \uCABD \uACC4\uB2E8\uC73C\uB85C \uB3CC\uC544\uAC00\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 556801501446147
    m_Localized: "\uC9C4\uC785\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 556801501446148
    m_Localized: "\uD0C8\uCD9C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 657464403181568
    m_Localized: "\uC0DD\uD65C\uAE30\uB85D\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729088
    m_Localized: "\uAC70\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729089
    m_Localized: "\uC8FC\uAC04 \uACC4\uD68D"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729090
    m_Localized: "\uC9C4\uD589 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729091
    m_Localized: "\u2715"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729092
    m_Localized: "\uC0DD\uD65C\uAE30\uB85D\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729093
    m_Localized: "\uAC70\uC810 \uC0C1\uD669"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729094
    m_Localized: "\uC774\uBC88 \uC8FC \uACC4\uD68D"
    m_Metadata:
      m_Items: []
  - m_Id: 657465472729095
    m_Localized: "Tab \uC5F4\uAE30\xB7\uB2EB\uAE30 \xB7 Esc \uB2EB\uAE30 \xB7 \uC624\uB978\uCABD \uD074\uB9AD \uBE44\uC6B0\uAE30"
    m_Metadata:
      m_Items: []
