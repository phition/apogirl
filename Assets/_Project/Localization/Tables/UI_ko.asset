    m_Metadata:
      m_Items: []
  - m_Id: 2234842116014080
    m_Localized: "\uB204\uB974\uBA74 \uACC4\uD68D \uBCF4\uB4DC\uC5D0\uC11C \uC774 \uC77C\uC744 \uACE0\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122944
    m_Localized: "\uB204\uB974\uBA74 \uACC4\uD68D \uBCF4\uB4DC\uB97C \uC5F0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122945
    m_Localized: "\uB204\uB974\uBA74 \uC5ED\uD560 \uCE78\uC73C\uB85C \uB0B4\uB824\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122946
    m_Localized: "\uBC1C\uC804\uAE30\uAC00 \uBA48\uCDC4\uC5B4. \uACE0\uCCD0 \uB450\uC9C0 \uC54A\uC73C\uBA74 \uB0C9\uC7A5\uACE0\uB3C4 \uAEBC\uC9C4\uB2E8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122947
    m_Localized: "\uBB3C\uC774 \uC774\uBC88 \uC8FC\uB97C \uBABB \uB118\uACA8. \uBC1B\uC544 \uB454 \uBE57\uBB3C\uBD80\uD130 \uB053\uC5EC \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122948
    m_Localized: "\uBA39\uC744 \uAC8C \uC774\uBC88 \uC8FC\uB97C \uBABB \uBC84\uD168. \uB0AE\uC5D0 \uC2DD\uB7C9\uC744 \uAD6C\uD558\uB7EC \uB098\uAC00 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122949
    m_Localized: "\uB9C8\uC2E4 \uBB3C\uC774 \uBAA8\uC790\uB77C. \uBB3C\uBD80\uD130 \uCC3E\uC73C\uB7EC \uB098\uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122950
    m_Localized: "\uBC16\uC774 \uBD80\uCA4D \uC2DC\uB044\uB7EC\uC6CC\uC84C\uC5B4. \uAD50\uBB38\uC744 \uB354 \uB9C9\uC544 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122951
    m_Localized: "\uC9C0\uAE08 \uC2B5\uACA9\uC774 \uC624\uBA74 \uBC84\uD2F0\uAE30 \uC5B4\uB824\uC6CC. \uBC24\uC5D0 \uBC88\uC744 \uC11C \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122952
    m_Localized: "\uD568\uC815 \uD558\uB098\uB9CC \uB193\uC544 \uB46C\uB3C4 \uBC24\uC774 \uD6E8\uC52C \uB35C \uBB34\uC11C\uC6B8 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122953
    m_Localized: "\uD5C8\uC218\uC544\uBE44\uAC00 \uC4F0\uB7EC\uC84C\uB354\uB77C. \uB2E4\uC2DC \uC138\uC6CC \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122954
    m_Localized: "\uC774\uBC88 \uC8FC\uB294 \uBC84\uD168\uB3C4 \uB2E4\uC74C \uC8FC\uAC00 \uBE60\uB4EF\uD574. \uBA39\uC744 \uAC78 \uBBF8\uB9AC \uAD6C\uD574 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122955
    m_Localized: "\uC2DD\uB7C9\uC774 \uB0A8\uC544\uC11C \uC0C1\uD558\uACA0\uAD6C\uB098. \uD55C \uC8FC\uB97C \uC2DC\uC791\uD560 \uB54C \uC2DD\uB2E8\uC744 \uB109\uB109\uD788 \uC7A1\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122956
    m_Localized: "\uD560 \uC77C \uC5C6\uC774 \uC549\uC544 \uC788\uB294 \uC544\uC774\uAC00 \uC788\uC5B4. \uB9E1\uAE38 \uC77C\uC744 \uCC3E\uC544 \uC8FC\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122957
    m_Localized: "\uBC30\uD130\uB9AC\uAC00 \uC81C\uBC95 \uBAA8\uC600\uB124. \uBC1C\uC804 \uC6A9\uB7C9\uC744 \uB298\uB9B4 \uC218 \uC788\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122958
    m_Localized: "\uBE57\uBB3C\uC774 \uAF64 \uBAA8\uC600\uC5B4. \uB053\uC5EC \uB450\uBA74 \uB4E0\uB4E0\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2234842183122959
    m_Localized: "\uAE61\uD1B5 \uACBD\uBCF4\uB77C\uB3C4 \uB2EC\uC544 \uB450\uBA74 \uC7A0\uC774 \uC880 \uD3B8\uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2250886620659712
    m_Localized: "\u25C0 \uC138\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 2250886687768576
    m_Localized: "\u25B6 \uC811\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2250886687768577
    m_Localized: "\uC54C\uAC8C \uB41C \uBC14\uAE65 \uC138\uB825\uC758 \uD3C9\uD310\xB7\uADFC\uD669\xB7\uC601\uD5A5\uACFC \uAC70\uB798 \uC0C1\uD0DC. \uCE74\uB4DC\uB97C \uB204\uB974\uBA74 \uAC70\uB798 \uD654\uBA74\uC774 \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2254563355934720
    m_Localized: "\uB204\uB974\uBA74 \uC774 \uC138\uB825\uC758 \uAC70\uB798 \uD654\uBA74\uC774 \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886016
    m_Localized: "\uD3C9\uD310 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886017
    m_Localized: "{0}\uAE4C\uC9C0 +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886018
    m_Localized: "\uB354 \uAC00\uAE4C\uC6CC\uC9C8 \uC218 \uC5C6\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886019
    m_Localized: "\uC9C0\uAE08 \uAC70\uB798 {0}\uAC74 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886020
    m_Localized: "\uB2E4\uC74C \uAC70\uB798\uAE4C\uC9C0 {0}\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886021
    m_Localized: "\uB0B4\uC904 \uBB3C\uC790\uAC00 \uBAA8\uC790\uB77C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886022
    m_Localized: "{0} \uB2E8\uACC4\uBD80\uD130 \uAC70\uB798\uD560 \uC218 \uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886023
    m_Localized: "\uAC70\uB798\uB294 \uACC4\uD68D \uC911\uC5D0\uB9CC"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886024
    m_Localized: "\uAC70\uB798\uD558\uC9C0 \uC54A\uB294 \uC138\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886025
    m_Localized: "\uB5A0\uB09C \uC138\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886026
    m_Localized: "\uAC70\uB798 \uD654\uBA74 \u25B8"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886027
    m_Localized: "\uC790\uC138\uD788 \u25B8"
    m_Metadata:
      m_Items: []
  - m_Id: 2254563980886028
    m_Localized: "\uBB34\uC804 \uAC70\uB798 \uB3C4\uCC29 \uC608\uC815: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575573028864
    m_Localized: "\uC120\uC0DD\uB2D8 \uCD94\uCC9C"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943424
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uC9C0\uAE08 \uC790\uB9AC\uC5D0 \uC5C6\uB2E4. \uC774\uBC88 \uC8FC\uB294 \uC9C1\uC811 \uC9DC \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943425
    m_Localized: "\uC544\uC9C1 \uC120\uC0DD\uB2D8\uC744 \uB9CC\uB098\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943426
    m_Localized: "\uACE0\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943427
    m_Localized: "\uACE0\uC815: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943428
    m_Localized: "\uB3D9\uC544\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943429
    m_Localized: "\uACE0\uC815 \uC2DC\uAC04\uD45C\uC5D0 \uB123\uC5C8\uB2E4. \uC120\uC0DD\uB2D8 \uCD94\uCC9C\uC744 \uB204\uB97C \uB54C\uB9C8\uB2E4 \uC774 \uCE78\uC5D0 \uB4E4\uC5B4\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943430
    m_Localized: "\uACE0\uC815 \uC2DC\uAC04\uD45C\uC5D0\uC11C \uBE90\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943431
    m_Localized: "\uACE0\uC815\uD560 \uD589\uB3D9\uC744 \uBA3C\uC800 \uCE78\uC5D0 \uB123\uC5B4 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943432
    m_Localized: "\uD0D0\uD5D8\uACFC \uC81C\uC791\uC740 \uACE0\uC815\uD560 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943433
    m_Localized: "\uC120\uC0DD\uB2D8 \uBA54\uBAA8"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943434
    m_Localized: "\uACE0\uC815 \uC2DC\uAC04\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943435
    m_Localized: "{0}\uC5D0 \uAC00 \uBCF4\uC790. \uBB54\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943436
    m_Localized: "{0}\uC5D0 \uB204\uAC00 \uC788\uB294 \uAC83 \uAC19\uC544. \uB9CC\uB098\uB7EC \uAC00 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943437
    m_Localized: "{0} \uD0D0\uD5D8 \u2014 \uD55C \uC8FC\uC5D0 \uD55C \uBC88\uC740 \uB098\uAC00 \uBD10\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943438
    m_Localized: "{0}: {1}\uC694\uC77C\uCBE4 \uBC14\uB2E5\uB098. \uADF8 \uC804\uC5D0 \uAD6C\uD574 \uC624\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943439
    m_Localized: "{0}: \uB2E4\uC74C \uC8FC\uAC00 \uBE60\uB4EF\uD574. \uBBF8\uB9AC \uAD6C\uD574 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943440
    m_Localized: "\uC57D\uC774 \uBAA8\uC790\uB77C. {0}\uC5D0\uC11C \uC758\uC57D\uD488\uC744 \uCC3E\uC544\uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943441
    m_Localized: "\uC26C\uB294 \uC2DC\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943442
    m_Localized: "\uD0D0\uD5D8 \uB2E4\uC74C\uC5D4 \uC26C\uC5B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943443
    m_Localized: "\uB9CC\uB4E4\uB358 \uAC83\uC744 \uB9C8\uC800 \uB9CC\uB4E4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943444
    m_Localized: "{0} \u2014 \uC228 \uB3CC\uB9B4 \uC2DC\uAC04\uB3C4 \uC788\uC5B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943445
    m_Localized: "\uB098 \uB54C\uBB38\uC5D0 \uBBF8\uC548\uD558\uAD6C\uB098. \uC7A0\uAE50 \uACC1\uC5D0 \uC788\uC5B4 \uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943446
    m_Localized: "{0} \u2014 \uC694\uC998 \uB9C8\uC74C\uC774 \uBA40\uC5B4\uC9C4 \uAC83 \uAC19\uC544. \uC774\uC57C\uAE30 \uC880 \uB098\uB220 \uBCF4\uB834."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943447
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uBC14\uB78C \uC880 \uC42C\uC790. \uB9CE\uC774 \uC9C0\uCCD0 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943448
    m_Localized: "\uB2E4\uCE5C \uB370\uBD80\uD130 \uCE58\uB8CC\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943449
    m_Localized: "\uAC10\uC5FC\uC774 \uC62C\uB77C\uC624\uACE0 \uC788\uC5B4. \uCC98\uCE58\uBD80\uD130 \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943450
    m_Localized: "{0} \u2014 \uAC70\uC810\uC744 \uC870\uAE08\uC529 \uB2E4\uC838 \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943451
    m_Localized: "\uBE57\uBB3C\uC774 \uB9CE\uC774 \uBAA8\uC600\uC5B4. \uD55C \uBC88 \uB354 \uB053\uC5EC \uB450\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943452
    m_Localized: "{0} \u2014 {1} \uCABD\uC73C\uB85C \uD0A4\uC6CC \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943453
    m_Localized: "{0} \u2014 \uB0B4\uAC00 \uC9C1\uC811 \uAC00\uB974\uCCD0 \uC904\uAC8C. ({1})"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943454
    m_Localized: "{0}\uC694\uC77C\uC5D4 \uB108\uBB34 \uBB34\uB9AC\uC57C. \uC26C\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943455
    m_Localized: "\uC57D\uBD80\uD130 \uAD6C\uD574 \uC624\uC790. \uAC10\uC5FC\uC740 \uBBF8\uB8E8\uBA74 \uC548 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943456
    m_Localized: "\uBA39\uC744 \uAC8C \uBC14\uB2E5\uB098\uAE30 \uC804\uC5D0 \uB098\uAC00\uC57C \uD574. \uC774\uBC88 \uC8FC\uB294 \uD0D0\uD5D8\uC744 \uB298\uB838\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943457
    m_Localized: "{0}\uC5D0 \uAC00 \uBCFC \uC77C\uC774 \uC788\uC744 \uAC83 \uAC19\uC544. \uC774\uBC88 \uC8FC\uC5D0 \uB123\uC5B4 \uB480\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943458
    m_Localized: "\uB108\uBB34 \uBAB0\uC544\uCE58\uC9C0 \uC54A\uAC8C \uC26C\uB294 \uB0A0\uC744 \uB123\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943459
    m_Localized: "\uC774\uBC88 \uC8FC\uB294\u2026 \uB098\uB3C4 \uC870\uAE08 \uC2E0\uC138\uB97C \uC9C8\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943460
    m_Localized: "\uC774\uB807\uAC8C \uC9DC \uBD24\uC5B4. \uB9C8\uC74C\uC5D0 \uC548 \uB4DC\uB294 \uCE78\uC740 \uACE0\uCCD0\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943461
    m_Localized: "\uBB34\uB9AC\uD558\uC9C0 \uC54A\uB294 \uC120\uC5D0\uC11C \uC9DC \uBD24\uC5B4. \uB124 \uC0DD\uAC01\uB300\uB85C \uBC14\uAFD4\uB3C4 \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943462
    m_Localized: "\uD55C \uC8FC \uACC4\uD68D\uC774\uC57C. \uCE78\uC744 \uB04C\uC5B4\uC11C \uC62E\uACA8\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943463
    m_Localized: "\uB418\uB3CC\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943464
    m_Localized: "\uB2E4\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943465
    m_Localized: "\uC804\uBD80 \uBE44\uC6B0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943466
    m_Localized: "\uB418\uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943467
    m_Localized: "\uB2E4\uC2DC \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943468
    m_Localized: "\uACC4\uD68D\uC744 \uBAA8\uB450 \uBE44\uC6E0\uB2E4. (\uB418\uB3CC\uB9AC\uAE30\uB85C \uC0B4\uB9B4 \uC218 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943469
    m_Localized: "\uC9D1\uC5C8\uB2E4: {0} \u2014 \uB123\uC744 \uCE78\uC744 \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943470
    m_Localized: "\uCE78\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uC608\uC0C1 \uD53C\uB85C\xB7\uC2A4\uD2B8\uB808\uC2A4\uC640 \uAE4C\uB2ED\uC774 \uBCF4\uC785\uB2C8\uB2E4. \uCE78\uC744 \uB04C\uC5B4 \uC62E\uAE30\uACE0, \uBE48\uC190\uC73C\uB85C \uB204\uB974\uBA74 \uADF8 \uD589\uB3D9\uC744 \uC9D1\uC2B5\uB2C8\uB2E4. Ctrl+Z \uB418\uB3CC\uB9AC\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943471
    m_Localized: "{0}\uC694\uC77C {1} \xB7 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943472
    m_Localized: "\uBE48 \uCE78 (\uC26C\uB294 \uAC83\uC73C\uB85C \uBD04)"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943473
    m_Localized: "\uC120\uC0DD\uB2D8: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943474
    m_Localized: "\uD53C\uB85C {0}\u2192{1} \xB7 \uC2A4\uD2B8\uB808\uC2A4 {2}\u2192{3} \xB7 \uC218\uBA74 \uBD80\uCC44 {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943475
    m_Localized: "\uD53C\uB85C {0}\u2192{1} \xB7 \uC2A4\uD2B8\uB808\uC2A4 {2}\u2192{3} \xB7 \uC218\uBA74 \uBD80\uCC44 {4} (\uD0D0\uD5D8\uC740 \uB300\uB7B5)"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943476
    m_Localized: "{0}\uC694\uC77C {1} \xB7 "
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943477
    m_Localized: "\uD53C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943478
    m_Localized: "\uC2A4\uD2B8\uB808\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943479
    m_Localized: "\uC218\uBA74 \uBD80\uCC44"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943480
    m_Localized: "\uC774\uBC88 \uC8FC \uB2A5\uB825\uCE58 \uBCC0\uD654 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 2301575635943481
    m_Localized: "\uC8FC \uB05D: \uD53C\uB85C {0} \xB7 \uC2A4\uD2B8\uB808\uC2A4 {1} \xB7 \uC218\uBA74 \uBD80\uCC44 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 2325182634278912
    m_Localized: "\uBE57\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097280180224
    m_Localized: "\uB3C4\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094784
    m_Localized: "\uCD9C\uC815 \uB54C \uBC30\uD130\uB9AC 1\uAC1C\uB85C \uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094785
    m_Localized: "\uC804\uB825 \uC5C6\uC74C (\uBC30\uD130\uB9AC \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094786
    m_Localized: "\uB0B4\uAD6C {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094787
    m_Localized: "\uC804\uB825 {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094788
    m_Localized: "\uC190\uC804\uB4F1 \uC804\uB825\uC774 \uBC14\uB2E5\uB0AC\uB2E4. \uAC74\uC804\uC9C0\uAC00 \uC788\uC5B4\uC57C \uCF24 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094789
    m_Localized: "\uC804\uB825\uC774 \uBC14\uB2E5\uB098 \uB2E4\uB978 \uBE5B\uC73C\uB85C \uBC14\uAFD4 \uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094790
    m_Localized: "\uAC74\uC804\uC9C0\uB97C \uAC08\uC544 \uB07C\uC6E0\uB2E4. ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094791
    m_Localized: "\uC1E0\uC9C0\uB81B\uB300\uAC00 \uD718\uC5B4 \uBD80\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2344097343094792
    m_Localized: "\uBCF4\uD638\uAD6C\uAC00 \uD574\uC838 \uB5A8\uC5B4\uC838 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2359219042140160
    m_Localized: "\u25C0 \uBCF4\uAD00\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 2359219113443328
    m_Localized: "\u25B6 \uC811\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2359219113443329
    m_Localized: "\uAC70\uC810 \uC790\uC6D0\uACFC \uCC3D\uACE0\uC5D0 \uC313\uC778 \uC7A5\uBE44\xB7\uC18C\uBAA8\uD488\xB7\uAE30\uD638\uD488\uC744 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2370145661239296
    m_Localized: "\uBC31: \uB098\uAC00\uB294 \uAE38\uC740 \uC774 \uCE35 {0} \uB05D."
    m_Metadata:
      m_Items: []
  - m_Id: 2370145728348160
    m_Localized: "\uBC31: \uB098\uAC00\uB294 \uAE38\uC740 {0}\uCE35 {1} \uB05D."
    m_Metadata:
      m_Items: []
  - m_Id: 2370145728348161
    m_Localized: "\uBC31: \uD55C\uCABD\uC73C\uB85C\uB9CC \uC5F4\uB9AC\uB294 \uBB38, \uC774 \uCE35 {0} \uB05D."
    m_Metadata:
      m_Items: []
  - m_Id: 2370145728348162
    m_Localized: "\uBC31: \uD55C\uCABD\uC73C\uB85C\uB9CC \uC5F4\uB9AC\uB294 \uBB38\uC740 \uC9C0\uD558 {0} {1} \uB05D."
    m_Metadata:
      m_Items: []
  - m_Id: 2370145728348163
    m_Localized: "\uBC31: \uC5EC\uAE30\uC120 \uB4E4\uC5B4\uC628 \uBB38\uC774 \uB098\uAC00\uB294 \uAE38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2370145728348164
    m_Localized: "\uBC31: \uD559\uAD50\uB294 {0} \uB05D\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 2396539090911232
    m_Localized: "\uADF8\uD574 \uACA8\uC6B8 \uAD50\uBB38 \uC55E\uC5D0\uC11C \uD1B5\uC870\uB9BC\uC744 \uBC1B\uC544 \uAC04 \uCD5C\uD558\uB9B0\uC740, \uBD04\uC5D0 \uB2E4\uB978 \uB300\uD53C\uC18C \uBA85\uB2E8\uC5D0\uC11C \uC774\uB984\uC73C\uB85C \uBC1C\uACAC\uB418\uC5C8\uB2E4. \uBE48 \uD1B5\uC870\uB9BC \uAE61\uD1B5 \uD558\uB098\uAC00 \uAD50\uBB38 \uAE30\uB465 \uC544\uB798 \uB193\uC5EC \uC788\uB358 \uB0A0\uC774 \uC788\uC5C8\uB2E4. \uADF8\uAC8C \uADF8 \uC560\uC758 \uB2F5\uC7A5\uC774\uC5C8\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2396539170603008
    m_Localized: "\uADF8\uD574 \uACA8\uC6B8, \uAD50\uBB38\uC740 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uCD5C\uD558\uB9B0\uC774 \uADF8 \uB4A4\uB85C \uC5B4\uB514\uB85C \uAC14\uB294\uC9C0\uB294 \uBAA8\uB978\uB2E4. \uBB38\uC744 \uB2EB\uC740 \uAC74 \uB098\uC600\uACE0, \uADF8 \uBB34\uAC8C\uB3C4 \uB0B4 \uBAAB\uC73C\uB85C \uB4E4\uACE0 \uC654\uB2E4. \uD6C4\uD68C\uC778\uC9C0 \uC544\uB2CC\uC9C0\uB294 \uC544\uC9C1 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2527281498308608
    m_Localized: "(\uB2E4\uB978 \uB0B4\uAD6C {0}\uAC1C)"
    m_Metadata:
      m_Items: []
  - m_Id: 2527281578000384
    m_Localized: "\uB4E4\uC5B4\uAC08 \uACF3"
    m_Metadata:
      m_Items: []
  - m_Id: 2527281578000385
    m_Localized: "\uC815\uBB38 \uC9C4\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 2527281578000386
    m_Localized: "\uD6C4\uBB38 \uC9C4\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 2527281578000387
    m_Localized: "\uC9C4\uC785\uB85C\uB97C \uAC78\uC5B4 \uC815\uBB38\uC73C\uB85C \uB4E4\uC5B4\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2527281578000388
    m_Localized: "\uC9C0\uB09C\uBC88\uC5D0 \uC1E0\uC9C0\uB81B\uB300\uB85C \uC5F4\uC5B4 \uB454 \uD0C8\uCD9C\uB85C\uB85C \uB4E4\uC5B4\uAC04\uB2E4. \uD0C8\uCD9C\uB85C \uB05D\uC5D0\uC11C \uC2DC\uC791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2528105465135104
    m_Localized: "\uBC24 \uD0D0\uD5D8\uC5D0 \uB098\uAC04 \uC0AC\uC774 \uC2B5\uACA9\uC774 \uC654\uACE0, \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC774 \uB9C9\uC544 \uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2528105528049664
    m_Localized: "\uBC24 \uD0D0\uD5D8\uC5D0 \uB098\uAC04 \uC0AC\uC774 \uC2B5\uACA9\uC5D0 \uB6AB\uB838\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2528105528049665
    m_Localized: "\uB3CC\uC544\uC640 \uBCF4\uB2C8, \uB0B4\uAC00 \uC5C6\uB294 \uC0AC\uC774 \uC2B5\uACA9\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2532048031203328
    m_Localized: "{0}\uC8FC {1}\uC77C ({2}) \uBCF4\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 2532048098312192
    m_Localized: "{0} \xB7 {1} \u2014 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 2532048098312193
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 2532048098312194
    m_Localized: "\uCE68\uC785\uC744 \uB9C9\uC544 \uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2532048098312195
    m_Localized: "\uCE68\uC785\uC5D0 \uB6AB\uB838\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340707958784
    m_Localized: "\uC2DD\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067648
    m_Localized: "\uC625\uC0C1\uC5D0 \uC591\uB3D9\uC774 \uD143\uBC2D\uC744 \uAFB8\uB838\uB2E4 \u2014 \uB0A0\uB9C8\uB2E4 \uC870\uAE08\uC529 \uC790\uB77C\uACE0, \uC0B4\uB9BC \uB9E1\uC740 \uC0AC\uB78C\uC774 \uC544\uCE68\uB9C8\uB2E4 \uAC70\uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067649
    m_Localized: "\uC625\uC0C1\uC5D0 \uC591\uB3D9\uC774 \uD143\uBC2D\uC744 \uAFB8\uB838\uB2E4. \uACA8\uC6B8\uB9CC \uC544\uB2C8\uBA74 \uB0A0\uB9C8\uB2E4 \uC870\uAE08\uC529 \uC790\uB784 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067650
    m_Localized: "\uD143\uBC2D \uC704\uC5D0 \uBE44\uB2D0\uC744 \uC50C\uC6CC \uD558\uC6B0\uC2A4\uB97C \uC138\uC6E0\uB2E4 \u2014 \uB354 \uB9CE\uC774 \uC790\uB77C\uACE0, \uACA8\uC6B8\uC5D0\uB3C4 \uBC18\uC740 \uC790\uB780\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067651
    m_Localized: "\uD143\uBC2D \uC704\uC5D0 \uBE44\uB2D0\uD558\uC6B0\uC2A4\uB97C \uC138\uC6E0\uB2E4. \uBC14\uB78C\uC774 \uB9C9\uD788\uB2C8 \uACA8\uC6B8\uC5D0\uB3C4 \uC870\uAE08\uC740 \uC790\uB784 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067652
    m_Localized: "\uBE44\uB2D0\uD558\uC6B0\uC2A4\uC5D0 \uC2A4\uD504\uB9C1\uD074\uB7EC\uB97C \uB2EC\uC558\uB2E4 \u2014 \uC804\uAE30\uC640 \uBE57\uBB3C\uC774 \uC788\uC73C\uBA74 \uC544\uCE68\uB9C8\uB2E4 \uBB3C\uC744 \uBFCC\uB824 \uB354 \uC790\uB780\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067653
    m_Localized: "\uBE44\uB2D0\uD558\uC6B0\uC2A4 \uCC9C\uC7A5\uC5D0 \uC2A4\uD504\uB9C1\uD074\uB7EC\uB97C \uB2EC\uC558\uB2E4. \uC804\uAE30\uC640 \uBE57\uBB3C\uB9CC \uC788\uC73C\uBA74 \uC544\uCE68\uB9C8\uB2E4 \uBB3C\uC744 \uBFCC\uB824 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067654
    m_Localized: "\uC0B4\uB9BC \uB9E1\uC740 \uC0AC\uB78C\uC774 \uBE57\uBB3C\uC744 \uC870\uAE08 \uAC78\uB800\uB2E4 (\uC2DD\uC218 +{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067655
    m_Localized: "\uD143\uBC2D\uC5D0\uC11C \uAC70\uB480\uB2E4 (\uC2DD\uB7C9 +{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067656
    m_Localized: "\uC2A4\uD504\uB9C1\uD074\uB7EC\uB97C \uB3CC\uB9B0 \uBC2D\uC5D0\uC11C \uAC70\uB480\uB2E4 (\uC2DD\uB7C9 +{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067657
    m_Localized: "\uC804\uAE30\uAC00 \uB04A\uACA8 \uC2A4\uD504\uB9C1\uD074\uB7EC\uAC00 \uBA48\uCDC4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067658
    m_Localized: "\uC2A4\uD504\uB9C1\uD074\uB7EC"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067659
    m_Localized: "\uC544\uCE68\uB9C8\uB2E4 \uBC2D \uC2DD\uB7C9 \uAC70\uB450\uAE30 (\uBAAB {0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067660
    m_Localized: "\uC544\uCE68\uB9C8\uB2E4 \uBE57\uBB3C \uC870\uAE08 \uAC70\uB974\uAE30 (\uBAAB {0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2550340775067661
    m_Localized: "\uC2A4\uD504\uB9C1\uD074\uB7EC\uAC00 \uBA48\uCDC4\uB2E4 \u2014 \uC804\uAE30\uAC00 \uBAA8\uC790\uB780\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2554474936942592
    m_Localized: "\uD55C \uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2554475004051456
    m_Localized: "\uB2EC\uB77C\uC9C4 \uAC83"
    m_Metadata:
      m_Items: []
  - m_Id: 2554475004051457
    m_Localized: "\uC0AC\uB78C\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2554475004051458
    m_Localized: "\uAC70\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 2578784573472768
    m_Localized: "\uB17C\uBB38\uC744 \uC77D\uC5C8\uB2E4: {0} \u2014 {1} \uC218\uC5C5 {2}\uBC88\uB9CC\uD07C \uC775\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2578784632193024
    m_Localized: "\uB17C\uBB38: \uB4E4\uACE0 \uB3CC\uC544\uAC00 \uC77D\uC73C\uBA74 {0} \uC218\uC5C5 {1}\uBC88\uB9CC\uD07C \uC775\uD78C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2578784632193025
    m_Localized: "{1}\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504243159040
    m_Localized: "\uB300\uD559\uC218\uD559\uB2A5\uB825\uC2DC\uD5D8 \uBAA8\uC758\uD3C9\uAC00 \uBB38\uC81C\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267904
    m_Localized: "\uC81C {0} \uAD50\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267905
    m_Localized: "{0} \uC601\uC5ED"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267906
    m_Localized: "\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267907
    m_Localized: "\uC218\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267908
    m_Localized: "\uC601\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267909
    m_Localized: "\uC0AC\uD68C\uD0D0\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267910
    m_Localized: "\uACFC\uD559\uD0D0\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267911
    m_Localized: "\uC131\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267912
    m_Localized: "\u25CB {0}\uBB38\uD56D, \uBB38\uD56D\uB2F9 {1}\uC810. \uC54C\uB9DE\uC740 \uB2F5\uC758 \uBC88\uD638\uB97C \uB20C\uB7EC \uD45C\uC2DC\uD558\uC2DC\uC624. \uB2E4\uC2DC \uB204\uB974\uBA74 \uC9C0\uC6CC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267913
    m_Localized: "\uD45C\uC2DC\uD55C \uB2F5 {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267914
    m_Localized: "\uB2E4\uC74C \uAD50\uC2DC \u25B6"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267915
    m_Localized: "\uB2F5\uC548\uC9C0\uB97C \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267916
    m_Localized: "\uAC00\uCC44\uC810 \uACB0\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267917
    m_Localized: "{0} / {1} \uBB38\uD56D \xB7 {2}\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267918
    m_Localized: "{0}\uBC88 \uC815\uB2F5: {1}\uBC88"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267919
    m_Localized: "\uCD1D\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267920
    m_Localized: "{0}\uC810 / {1}\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267921
    m_Localized: "\u25CB \uD45C\uC2DC\uB294 \uB9DE\uC740 \uBB38\uD56D, \xD7 \uD45C\uC2DC\uB294 \uD2C0\uB9B0 \uBB38\uD56D. \uD45C\uC2DC\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uC815\uB2F5 \uBC88\uD638\uAC00 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2628504310267922
    m_Localized: "\uC2DC\uD5D8\uC9C0\uB97C \uB36E\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499594981376
    m_Localized: "\uCEF4\uD4E8\uD130\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090240
    m_Localized: "PC\uD1B5\uC2E0 \uC811\uC18D (\u260E 01420)"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090241
    m_Localized: "\uCEF4\uD4E8\uD130\uAC00 \uBA4E\uC5C8\uB2E4. \uB2E4\uC74C \uC8FC\uC5D0 \uB2E4\uC2DC \uD574 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090242
    m_Localized: "\uCEF4\uD4E8\uD130\uAC00 \uCF1C\uC9C0\uC9C0 \uC54A\uB294\uB2E4. \uB2E4\uC74C \uC8FC\uC5D0 \uB2E4\uC2DC \uD574 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090243
    m_Localized: "\uC9C0\uAE08\uC740 \uCEF4\uD4E8\uD130\uB97C \uC4F8 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090244
    m_Localized: "\uC120\uD0DD> "
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090245
    m_Localized: "\uC804\uD654 \uAC70\uB294 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090246
    m_Localized: "\uCD08\uAE30 \uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090247
    m_Localized: "\uC811\uC18D \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090248
    m_Localized: "{0} \uB2D8, \uC5B4\uC11C \uC624\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090249
    m_Localized: "\uC54C \uC218 \uC5C6\uB294 \uBA85\uB839\uC785\uB2C8\uB2E4.  H = \uB3C4\uC6C0\uB9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090250
    m_Localized: "({0}/{1}\uCABD)  N \uB2E4\uC74C \xB7 B \uC55E"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090251
    m_Localized: "\uBC88\uD638\uB97C \uCE58\uACE0 [Enter]  \xB7  H \uB3C4\uC6C0\uB9D0  \xB7  X \uC811\uC18D \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090252
    m_Localized: "\uBC88\uD638 = \uC77D\uAE30  \xB7  P \uC55E \uD654\uBA74  \xB7  T \uCC98\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090253
    m_Localized: "\uBC88\uD638 = \uC77D\uAE30  \xB7  W \uAE00\uC4F0\uAE30  \xB7  P \uC55E \uD654\uBA74  \xB7  T \uCC98\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090254
    m_Localized: "P \uC55E \uD654\uBA74  \xB7  T \uCC98\uC74C  \xB7  X \uC811\uC18D \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090255
    m_Localized: "\uBC88\uD638 = \uAC08\uB798  \xB7  S \uB0B1\uB9D0 = \uCC3E\uAE30  \xB7  P \uC55E \uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090256
    m_Localized: "\uBE48 \uC904\uC5D0\uC11C [Enter] = \uADF8\uB9CC\uB450\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090257
    m_Localized: "/Q = \uB098\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090258
    m_Localized: "\uACF5\uC9C0\uC0AC\uD56D"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090259
    m_Localized: "\uC5F4\uB9B0 \uAC8C\uC2DC\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090260
    m_Localized: "\uB300\uD654\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090261
    m_Localized: "\uB3C4\uC6C0\uB9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090262
    m_Localized: "\uC0DD\uC874 \uBC31\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090263
    m_Localized: "\uC5EC\uB7EC \uD559\uAD50\uC5D0\uC11C \uC62C\uB77C\uC628 \uAE00\uC744 \uAC08\uB798\uBCC4\uB85C \uC5EE\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090264
    m_Localized: "\uAE00 {0}\uD3B8"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090265
    m_Localized: "[!] = \uC55E\uC77C\uC774 \uC801\uD78C \uAE00\uC785\uB2C8\uB2E4. \uAC00\uB824 \uC77D\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090266
    m_Localized: "'{0}' \uCC3E\uC740 \uAE00 {1}\uD3B8"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090267
    m_Localized: "\uCC3E\uC740 \uAE00\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090268
    m_Localized: "\uAE00\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090269
    m_Localized: "\uC81C\uBAA9 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090270
    m_Localized: "\uC62C\uB9B0\uC774 : {0}   \uB0A0\uC9DC : {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090271
    m_Localized: "\uC5F4\uB9B0 \uAC8C\uC2DC\uD310 \u2015 \uAE00\uC4F0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090272
    m_Localized: "\uC81C\uBAA9\uC744 \uCE58\uACE0 [Enter], \uC774\uC5B4\uC11C \uB0B4\uC6A9\uC744 \uD55C \uC904 \uCE58\uACE0 [Enter]\uB97C \uB204\uB974\uBA74 \uC62C\uB77C\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090273
    m_Localized: "\uC81C\uBAA9> "
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090274
    m_Localized: "\uB0B4\uC6A9> "
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090275
    m_Localized: "\uAE00\uC744 \uC62C\uB838\uC2B5\uB2C8\uB2E4. \uB204\uAD70\uAC00 \uC77D\uAE30\uB97C."
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090276
    m_Localized: "{0}\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090277
    m_Localized: "\uB9D0> "
    m_Metadata:
      m_Items: []
  - m_Id: 2637499662090278
    m_Localized: '{0}> {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2651567055716352
    m_Localized: '{0:00}.{1:00}'
    m_Metadata:
      m_Items: []
  - m_Id: 2658166222635008
    m_Localized: "\uC624\uB298\uC740 \uBC14\uB78C\uC774 \uB35C \uCC28\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132480
    m_Localized: "\uCE60\uD310 \uC9C0\uC6B0\uB294 \uBC84\uB987\uC740 \uC548 \uC5C6\uC5B4\uC9C0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132481
    m_Localized: "\uBAA9\uBC1C\uB3C4 \uC774\uC81C \uC190\uC5D0 \uC775\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132482
    m_Localized: "\uC870\uC6A9\uD55C \uB0A0\uC774 \uC81C\uC77C \uACE0\uB9C8\uC6B4 \uB0A0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132483
    m_Localized: "\uBC25\uC740 \uBA39\uC5C8\uB2C8? \uADF8\uAC8C \uC81C\uC77C \uBA3C\uC800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132484
    m_Localized: "\u2026\uC7A0\uAE50\uB9CC \uC549\uC544 \uC788\uC790. \uBA38\uB9AC\uAC00 \uBB34\uAC81\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132485
    m_Localized: "\uAD1C\uCC2E\uB2E4. \uC870\uAE08 \uC9C0\uCCE4\uC744 \uBFD0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132486
    m_Localized: "\uB124\uAC00 \uC788\uC5B4\uC11C \uD559\uAD50\uAC00 \uD559\uAD50 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132487
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC70, \uC798\uD558\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132488
    m_Localized: "\uBC30\uC5D0\uC11C \uC18C\uB9AC\uAC00 \uB098\uB3C4 \uBAA8\uB978 \uCC99\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132489
    m_Localized: "\uB09C \uAD1C\uCC2E\uC73C\uB2C8 \uB108\uD76C \uBA3C\uC800 \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132490
    m_Localized: "\uBAA9\uC774 \uC880 \uB9C8\uB974\uB124. \uBB3C\uC740 \uC544\uAEF4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132491
    m_Localized: "\uBD84\uD544 \uAC00\uB8E8\uB97C \uB9C8\uC2E0 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132492
    m_Localized: "\uC544\uAE4C \uCC3D\uBC16\uC5D0\uC11C \uBB50\uAC00 \uC6C0\uC9C1\uC600\uC5B4. \u2026\uC0C8\uC600\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132493
    m_Localized: "\uADF8 \uB9CC\uD654 \uACB0\uB9D0, \uB0B4\uAC00 \uB9DE\uD790 \uC218 \uC788\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132494
    m_Localized: "\uBCF5\uB3C4 \uB05D\uAE4C\uC9C0 \uB6F0\uBA74 \uBA87 \uCD08\uC77C\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132495
    m_Localized: "\uC624\uB298\uC740 \uBB34\uC11C\uC6B4 \uC18C\uB9AC \uC548 \uB0AC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132496
    m_Localized: "\uB098 \uD0A4 \uC880 \uD070 \uAC83 \uAC19\uC9C0 \uC54A\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132497
    m_Localized: "\uC790\uAFB8 \uBB38 \uCABD\uC744 \uBCF4\uAC8C \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132498
    m_Localized: "\u2026\uC5B4\uC82F\uBC24\uC5D0 \uB610 \uADF8 \uAFC8 \uAFE8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132499
    m_Localized: "\uC5EC\uAE30 \uC624\uAE38 \uC798\uD55C \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132500
    m_Localized: "\uB2E4\uC74C\uC5D0 \uB098\uAC08 \uB550 \uB098\uB3C4 \uAF2D \uBD88\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132501
    m_Localized: "\uBC30\uACE0\uD504\uB2E4\u2026 \uB77C\uBA74 \uB0C4\uC0C8\uAC00 \uADF8\uB9BD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132502
    m_Localized: "\uAF2C\uB974\uB975 \uC18C\uB9AC \uB4E4\uC5C8\uC5B4? \uB098 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132503
    m_Localized: "\uC774\uC628\uC74C\uB8CC \uD55C \uBAA8\uAE08\uB9CC \uC788\uC73C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132504
    m_Localized: "\uC785\uC774 \uBC14\uC9DD\uBC14\uC9DD \uB9D0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132505
    m_Localized: "\uC190\uC740 \uC53B\uACE0 \uB2E4\uB2C8\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132506
    m_Localized: "\uBD95\uB300\uAC00 \uC880 \uB354 \uC788\uC73C\uBA74 \uC88B\uACA0\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132507
    m_Localized: "\uC7A0\uC740 \uC57D\uC774\uC57C. \uC798 \uC790 \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132508
    m_Localized: "\uC18C\uB3C5\uC57D \uB0C4\uC0C8\uAC00 \uB098\uB294 \uAC74 \uC88B\uC740 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132509
    m_Localized: "\uC6B0\uB9AC \uC560\uB3C4 \uC5B4\uB518\uAC00\uC5D0\uC11C \uC798 \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132510
    m_Localized: "\uC7A0\uAE50\uB9CC\u2026 \uC228 \uC880 \uB3CC\uB9B4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132511
    m_Localized: "\uC190\uC774 \uB5A8\uB9AC\uBA74 \uC548 \uB418\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132512
    m_Localized: "\uC6B0\uB9AC \uC560\uB4E4, \uB2E4\uB4E4 \uAE30\uD2B9\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132513
    m_Localized: "\uB108\uD76C \uC5BC\uAD74 \uBCF4\uBA74 \uD798\uC774 \uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132514
    m_Localized: "\uC18D\uC774 \uBE44\uBA74 \uC57D\uB3C4 \uBABB \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132515
    m_Localized: "\uBB50\uB77C\uB3C4 \uC880 \uC539\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132516
    m_Localized: "\uBB3C\uC740 \uC870\uAE08\uC529 \uC790\uC8FC \uB9C8\uC154\uC57C \uD558\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132517
    m_Localized: "\uC624\uB298\uC740 \uCEE4\uD53C\uBCF4\uB2E4 \uBB3C\uC774 \uBA3C\uC800\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132518
    m_Localized: "\u2026\uCC3D\uBB38 \uBA3C\uC9C0\uC5D0 \uADF8\uB9BC \uADF8\uB824\uB3C4 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132519
    m_Localized: "\uC624\uB298\uC740 \uD558\uB298 \uC0C9\uC774 \uC608\uBED0."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132520
    m_Localized: "\uC0C9\uC5F0\uD544\uC774 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132521
    m_Localized: "\uC5EC\uAE30, \uC870\uC6A9\uD574\uC11C \uC88B\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132522
    m_Localized: "\uD0A4\uB9C1 \uC18C\uB9AC\uAC00 \uB098\uBA74 \uC880 \uC548\uC2EC\uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132523
    m_Localized: "\u2026\uBBF8\uC548, \uC880 \uBA4D\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132524
    m_Localized: "\uC790\uAFB8 \uADF8\uB0A0\uC774 \uC0DD\uAC01\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132525
    m_Localized: "\uB098, \uC5EC\uAE30 \uC788\uC5B4\uB3C4 \uB418\uB294 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132526
    m_Localized: "\uAC19\uC774 \uC788\uC73C\uB2C8\uAE4C \uB35C \uBB34\uC11C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132527
    m_Localized: "\u2026\uBC30\uC5D0\uC11C \uC18C\uB9AC \uB0AC\uC5B4. \uBBF8\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132528
    m_Localized: "\uB098\uB294 \uC870\uAE08\uB9CC \uBA39\uC5B4\uB3C4 \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132529
    m_Localized: "\uBAA9\uC774 \uB9D0\uB77C\uC11C \uBAA9\uC18C\uB9AC\uAC00 \uC548 \uB098\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132530
    m_Localized: "\uBB3C\u2026 \uD55C \uBAA8\uAE08\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132531
    m_Localized: "\uBA3C\uC9C0 \uC880 \uBD10. \uCCAD\uC18C\uB294 \uB204\uAC00 \uD574?"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132532
    m_Localized: "\uBA38\uB9AC\uB048 \uD558\uB098\uAC00 \uC774\uB807\uAC8C \uADC0\uD560 \uC904\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132533
    m_Localized: "\uBB58 \uBD10. \uADF8\uB0E5 \uC11C \uC788\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132534
    m_Localized: "\uC5EC\uAE30 \uC0DD\uAC01\uBCF4\uB2E4 \uC9C0\uB0BC \uB9CC\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132535
    m_Localized: "\uAC70\uC6B8\uC774 \uC5C6\uC73C\uB2C8 \uB0B4 \uC5BC\uAD74\uB3C4 \uC78A\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132536
    m_Localized: "\u2026\uB9D0 \uAC78\uC9C0 \uB9C8. \uC9C0\uAE08\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132537
    m_Localized: "\uC7A0\uC744 \uBABB \uC7A4\uC5B4. \uADF8\uAC8C \uB2E4\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132538
    m_Localized: "\u2026\uC5EC\uAE30 \uC788\uB294 \uAC70, \uB098\uC058\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132539
    m_Localized: "\uBE5A\uC9C4 \uAC74 \uC548 \uC78A\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132540
    m_Localized: "\uBC30\uACE0\uD504\uB2E4\uB294 \uB9D0, \uC548 \uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132541
    m_Localized: "\u2026\uBB50 \uBA39\uC744 \uAC70 \uB0A8\uC558\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132542
    m_Localized: "\uC785\uC220\uC774 \uB2E4 \uD144\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132543
    m_Localized: "\uBB3C \uC880 \uC544\uAEF4 \uB9C8\uC154. \uB098\uB3C4 \uADF8\uB7F4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132544
    m_Localized: "\uBCF5\uB3C4\uB294 \uB0B4\uAC00 \uD55C \uBC88 \uB3CC\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132545
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBA3C\uC9C0\uB294 \uB0B4\uAC00 \uD138\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132546
    m_Localized: "\uAE30\uD0C0 \uC904\uC774 \uD558\uB098 \uB04A\uC5B4\uC84C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132547
    m_Localized: "\uC624\uB298\uC740 \uC870\uC6A9\uD558\uB124. \uC88B\uC740 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132548
    m_Localized: "\uBB38\uB2E8\uC18D\uC740 \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132549
    m_Localized: "\u2026\uC7A0\uAE50 \uD63C\uC790 \uC788\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132550
    m_Localized: "\uBCC4\uAC70 \uC544\uB0D0. \uC880 \uD53C\uACE4\uD574\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132551
    m_Localized: "\uD6C4\uBC30\uB4E4 \uB355\uC5D0 \uBC84\uD2F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132552
    m_Localized: "\uC5EC\uAE34 \uC9C0\uD0AC \uB9CC\uD55C \uB370\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132553
    m_Localized: "\uBC30\uB294 \uC880 \uACE0\uD504\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132554
    m_Localized: "\uB09C \uB098\uC911\uC5D0 \uBA39\uC5B4\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132555
    m_Localized: "\uBB3C \uD55C \uBAA8\uAE08\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132556
    m_Localized: "\uBAA9\uC774 \uD0C0\uC11C \uB178\uB798\uB294 \uBABB \uD558\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132557
    m_Localized: "\uBC14\uB78C \uBC29\uD5A5\uC774 \uBC14\uB00C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132558
    m_Localized: "\uC9C0\uBD95 \uC788\uB294 \uACF3\uB3C4 \uB098\uC058\uC9C0 \uC54A\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132559
    m_Localized: "\uC2E0\uBC1C \uB048\uC740 \uB298 \uBB36\uC5B4 \uB46C\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132560
    m_Localized: "\uC9C0\uB3C4\uB294 \uC811\uC5B4\uC11C \uD488\uC5D0 \uB123\uB294 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132561
    m_Localized: "\uC870\uC6A9\uD55C \uAC74\uBB3C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132562
    m_Localized: "\u2026\uB108\uBB34 \uC624\uB798 \uBA38\uBB3C\uB800\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132563
    m_Localized: "\uBCBD\uC774 \uC881\uAC8C \uB290\uAEF4\uC9C0\uB294 \uB0A0\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132564
    m_Localized: "\uB5A0\uB0A0 \uB54C \uC778\uC0AC\uB294 \uD558\uACE0 \uAC00\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132565
    m_Localized: "\uC774 \uD559\uAD50, \uC9C0\uB3C4\uC5D0 \uBCC4\uD45C\uB97C \uCCD0 \uB480\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132566
    m_Localized: "\uBC43\uC18D\uC774 \uBE44\uC5C8\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132567
    m_Localized: "\uAC77\uB358 \uB54C\uBCF4\uB2E8 \uB0AB\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132568
    m_Localized: "\uBB3C\uD1B5\uC774 \uAC00\uBCCD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132569
    m_Localized: "\uBAA9\uC774 \uCE7C\uCE7C\uD558\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132570
    m_Localized: "\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132571
    m_Localized: "(\uCC3D\uD2C0\uC5D0\uC11C \uAF2C\uB9AC\uB97C \uD754\uB4E0\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132572
    m_Localized: "(\uBC1C\uCE58\uC5D0 \uBAB8\uC744 \uBE44\uBE48\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132573
    m_Localized: "(\uD558\uD488\uC744 \uD55C\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132574
    m_Localized: "(\uADC0\uB97C \uCAD1\uAE0B \uC138\uC6B4\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132575
    m_Localized: "(\uCC45\uC0C1 \uBC11\uC5D0 \uB4E4\uC5B4\uAC00 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132576
    m_Localized: "(\uD138\uC744 \uC138\uC6B0\uACE0 \uBB38 \uCABD\uC744 \uBCF8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132577
    m_Localized: "(\uBB34\uB98E\uC5D0 \uC55E\uBC1C\uC744 \uC62C\uB9B0\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132578
    m_Localized: "\uADF8\uB989\uADF8\uB989."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132579
    m_Localized: "(\uBE48 \uADF8\uB987\uC744 \uC55E\uBC1C\uB85C \uBBFC\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132580
    m_Localized: "\uB0D0\uC544\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132581
    m_Localized: "(\uBB3C\uADF8\uB987 \uC55E\uC5D0 \uC549\uC544 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132582
    m_Localized: "(\uD600\uB97C \uB0B4\uBC00\uACE0 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2658166298132583
    m_Localized: "\uC804\uAE30\uAC00 \uBAA8\uC790\uB77C \uCEF4\uD4E8\uD130\uAC00 \uCF1C\uC9C0\uC9C0 \uC54A\uB294\uB2E4. (\uC5EC\uC720 \uC804\uB825 {0} \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 2690047429328896
    m_Localized: "\uC774\uBC88 \uC6B4\uBC18\uC5D0\uB294 \uC774\uBBF8 \uC774 \uBB3C\uAC74\uC744 \uBC14\uAFE8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2690047509020672
    m_Localized: "\uAC00\uAE4C\uC6B4 \uC0AC\uC774: \uBC1B\uB294 \uC591 +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 2691292227452928
    m_Localized: "\uBA39\uC744 \uAC83\uC774 \uC544\uC26C\uC6B4 \uC0AC\uAC70\uB9AC \uD328\uAC70\uB9AC\uC5D0\uAC8C \uC2DD\uB7C9\uC744 \uAC74\uB124\uACE0, \uB72F\uC5B4 \uBAA8\uC740 \uACE0\uCCA0\uACFC \uBAA9\uC7AC\uB97C \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2691292336504832
    m_Localized: "\uC2DD\uB7C9\uC744 \uAC74\uB124\uACE0 \uC790\uC7AC\uB97C \uBC1B\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2691292336504833
    m_Localized: "\uC4F8 \uB9CC\uD55C \uC790\uC7AC\uB97C \uB118\uAE30\uACE0 \uC2DD\uB7C9\uC744 \uBC1B\uB294\uB2E4. \uAC12\uC740 \uBC15\uD558\uAC8C \uCCD0 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2691292336504834
    m_Localized: "\uC790\uC7AC\uB97C \uB118\uAE30\uACE0 \uC2DD\uB7C9\uC744 \uBC1B\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2696120508891136
    m_Localized: "\uC7A0\uAE34 \uCE78\uC774\uB77C \uBC14\uAFC0 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2696120576000000
    m_Localized: "\uAC15\uC81C \uD734\uC2DD: \uC4F0\uB7EC\uC9C4 \uB4A4\uB77C \uC26C\uC5B4\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2739017098739712
    m_Localized: "\uAE00\uC744 \uBCF4\uB0B4\uB294 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2739017178431488
    m_Localized: "\uD68C\uC120\uC774 \uBD88\uC548\uC815\uD569\uB2C8\uB2E4. \uAE00\uC740 \uC774 \uCEF4\uD4E8\uD130\uC5D0\uB9CC \uB0A8\uACA8 \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2739017178431489
    m_Localized: "\uC800\uCABD\uC5D0\uC11C \uAE00\uC744 \uBC1B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uAE00\uC740 \uC774 \uCEF4\uD4E8\uD130\uC5D0\uB9CC \uB0A8\uACA8 \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2739017178431490
    m_Localized: "\uC62C\uB9B4 \uC218 \uC5C6\uB294 \uB9D0\uC774 \uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uAE00\uC744 \uC62C\uB9AC\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2739017178431491
    m_Localized: "\uB2E4\uB978 \uD559\uAD50\uC758 \uAE00\uC744 \uBC1B\uC544 \uC624\uB294 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2739017178431492
    m_Localized: "\uB2E4\uB978 \uD559\uAD50\uC5D0\uC11C \uC62C\uB77C\uC628 \uAE00 {0}\uD3B8\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2739017178431493
    m_Localized: "\uD68C\uC120\uC774 \uBD88\uC548\uC815\uD569\uB2C8\uB2E4. \uC774 \uCEF4\uD4E8\uD130\uC5D0 \uC788\uB294 \uAE00\uB9CC \uBCF4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763883417600
    m_Localized: "\uAD6C\uC870\uC758 \uB0A0"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303680
    m_Localized: "\uB3CC\uC544\uBCF4\uB294 \uBC24"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303681
    m_Localized: "\uADF8 \uB4A4\uC758 \uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303682
    m_Localized: "{0} \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303683
    m_Localized: "\uD568\uAED8\uD55C \uC0AC\uB78C\uB4E4, \uADF8 \uB4A4"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303684
    m_Localized: "\uADF8 \uBC16\uC758 \uC18C\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303685
    m_Localized: "\uBE44\uC6CC \uB454 \uC790\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303686
    m_Localized: "\uC790\uB9AC\uAC00 \uBAA8\uC790\uB784 \uB9CC\uD07C"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303687
    m_Localized: "\uD55C \uC0AC\uB78C\uC529 \uC774\uB984\uC774 \uBD88\uB838\uB2E4. \uB300\uB2F5\uD558\uB294 \uBAA9\uC18C\uB9AC\uAC00 \uB04A\uC774\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303688
    m_Localized: "\uD63C\uC790 \uC120 \uC625\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303689
    m_Localized: "\uD5EC\uAE30 \uBB38\uC774 \uC5F4\uB838\uC744 \uB54C, \uC625\uC0C1\uC5D0 \uC120 \uAC74 {given} \uD55C \uC0AC\uB78C\uC774\uC5C8\uB2E4. \uC544\uB2C8, \uD55C \uC0AC\uB78C\uACFC \uC120\uC0DD\uB2D8\uC758 \uADF8\uB9BC\uC790\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303690
    m_Localized: "\uD504\uB85C\uD3A0\uB7EC \uC18C\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303691
    m_Localized: "\uB0A8\uC740 \uC9C8\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303692
    m_Localized: "\uADF8 1\uB144\uC744 \uD55C \uBB38\uC7A5\uC73C\uB85C \uB9D0\uD560 \uC218\uAC00 \uC5C6\uC5C8\uB2E4. \uBB34\uC11C\uC6E0\uACE0, \uC6C3\uC5C8\uACE0, \uBC30\uACE0\uD320\uB2E4. \uB2E4 \uB9DE\uB294 \uB9D0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303693
    m_Localized: "\uB178\uD2B8\uB97C \uB36E\uC744 \uB54C\uB9C8\uB2E4, \uC774 \uC77C\uC744 \uC2DC\uC791\uD55C \uAC8C \uC0AC\uB78C\uC774\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uB354 \uBB34\uAC70\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303694
    m_Localized: "\uAC00\uB054 \uCC3D\uACE0 \uAFC8\uC744 \uAFE8\uB2E4. \uAFC8\uC18D\uC5D0\uC11C\uB3C4 \uBB38\uC740 \uC548\uC5D0\uC11C \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303695
    m_Localized: "\uD5EC\uAE30 \uC18C\uB9AC\uAC00 \uBA40\uC5B4\uC9C4 \uBC24, \uD559\uAD50\uB294 \uC544\uC8FC \uC870\uC6A9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303696
    m_Localized: "\uD5EC\uAE30 \uCC3D\uC5D0 \uC774\uB9C8\uB97C \uB300\uACE0, {given:\uC740/\uB294} \uD559\uAD50 \uC9C0\uBD95\uC774 \uAD6C\uB984\uC5D0 \uBB3B\uD790 \uB54C\uAE4C\uC9C0 \uBCF4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303697
    m_Localized: "\uD5EC\uAE30\uAC00 \uB5A0\uC624\uB974\uC790 \uC625\uC0C1\uC774 \uC791\uC544\uC84C\uB2E4. \uC190\uC744 \uD754\uB4DC\uB294 \uC0AC\uB78C\uC774 \uC810\uC774 \uB420 \uB54C\uAE4C\uC9C0, {given:\uC740/\uB294} \uB208\uC744 \uB5BC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303698
    m_Localized: "\uD5EC\uAE30 \uC548\uC740 \uC2DC\uB044\uB7EC\uC6E0\uB2E4. \uC544\uBB34\uB3C4 \uC6B8\uC9C0 \uC54A\uC558\uB294\uB370, \uB2E4\uB4E4 \uB208\uC774 \uBE68\uAC30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303699
    m_Localized: "\uADF8\uB9AC\uACE0 \uD559\uAD50\uC758 \uB0A0\uB4E4\uC774 \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303700
    m_Localized: "\uBB38\uC744 \uB2EB\uC544 \uB454 \uCC44\uB85C\uB3C4, \uD558\uB8E8\uB294 \uD558\uB8E8\uC529 \uC9C0\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303701
    m_Localized: "\uD5EC\uAE30\uAC00 \uB0B4\uB824\uC549\uC740 \uACF3\uC5D0\uC11C, \uB2E4\uC74C \uB0A0\uB4E4\uC774 \uC2DC\uC791\uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303702
    m_Localized: "\uC9C0\uAE08\uAE4C\uC9C0 \uBCF4\uB0B8 1\uB144: {0}\uAC00\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303703
    m_Localized: "\uADF8 \uB4A4\uC758 \uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303704
    m_Localized: "\uB3CC\uC544\uBCF4\uB294 \uBC24"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303705
    m_Localized: "\uAD6C\uC870\uC758 \uB0A0"
    m_Metadata:
      m_Items: []
  - m_Id: 3253763967303706
    m_Localized: "\uB05D\uB098 \uBC84\uB9B0 \uC774\uC57C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 3261802959093760
    m_Localized: "\uAE30\uB85D \uC5D4\uB529"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396928
    m_Localized: "\uAC00\uC7A5 \uBA3C\uC800 \uB2FF\uB294 \uC190"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396929
    m_Localized: "\uAD6C\uC870 \uCEA0\uD504\uC5D0\uC11C {given:\uC740/\uB294} \uB4E4\uAC83\uC744 \uB4DC\uB294 \uC77C\uBD80\uD130 \uC790\uC6D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396930
    m_Localized: "\uC751\uAE09\uAD6C\uC870 \uACFC\uC815 \uCCAB \uC2E4\uC2B5 \uB0A0, \uAD50\uAD00\uC774 \uBB3C\uC5C8\uB2E4. \"\uBD95\uB300\uB294 \uC5B4\uB514\uC11C \uBC30\uC6E0\uB2C8?\" \"\uBCF4\uAC74\uC2E4\uC5D0\uC11C\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396931
    m_Localized: "10\uB144 \uD6C4, \uC7AC\uAC74 \uB3C4\uC2DC\uC5D0\uC11C \uAD6C\uAE09\uCC28\uAC00 \uAC00\uC7A5 \uBA3C\uC800 \uB2FF\uB294 \uACE8\uBAA9\uC5D0\uB294 \uB298 {given:\uC774/\uAC00} \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396932
    m_Localized: "\uBCF4\uAC74\uC2E4\uC744 \uC9C0\uD0A4\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396933
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uAD6C\uC870 \uCEA0\uD504\uC5D0\uC11C\uB3C4 \uD770 \uAC00\uC6B4\uC744 \uBC97\uC9C0 \uC54A\uC558\uB2E4. {given:\uC740/\uB294} \uADF8 \uC606\uC5D0\uC11C \uC57D \uC0C1\uC790\uB97C \uC815\uB9AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396934
    m_Localized: "\uAC04\uD638\uD559\uACFC\uB97C \uB9C8\uCE58\uB358 \uB0A0, \uBC15 \uC120\uC0DD\uB2D8\uC774 \uB0A1\uC740 \uCCAD\uC9C4\uAE30\uB97C \uAC74\uB138\uB2E4. \"\uC774\uC81C \uB124 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396935
    m_Localized: "\uB2E4\uC2DC \uBB38\uC744 \uC5F0 \uC0C8\uBCBD\uACE0 \uBCF4\uAC74\uC2E4. \uC57D\uC7A5 \uB9E8 \uC704 \uCE78\uC5D0\uB294 \uADF8\uD574\uC758 \uC57D\uD488 \uC7A5\uBD80\uAC00 \uAF42\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396936
    m_Localized: "\uD55C \uADF8\uB987\uC758 \uC628\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396937
    m_Localized: "\uC7AC\uAC74 \uCEA0\uD504\uC758 \uBC30\uC2DD \uC904\uC740 \uAE38\uC5C8\uB2E4. {given:\uC740/\uB294} \uAD6D\uC790\uB97C \uB4E4\uACE0 \uD55C \uC0AC\uB78C\uC529 \uC774\uB984\uC744 \uBB3C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396938
    m_Localized: "\uD1B5\uC870\uB9BC\uACFC \uBE57\uBB3C\uB85C \uB053\uC774\uB358 \uAD6D\uC774 \uBA87 \uB144 \uB4A4 \uC791\uC740 \uC2DD\uB2F9\uC758 \uCCAB \uBA54\uB274\uAC00 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396939
    m_Localized: "\uAC04\uD310 \uC5C6\uB294 \uADF8 \uC2DD\uB2F9 \uBA54\uB274\uD310\uC5D0\uB294 \uAC12 \uB300\uC2E0 \uC774\uB807\uAC8C \uC801\uD600 \uC788\uC5C8\uB2E4. '\uBC30\uACE0\uD504\uBA74 \uADF8\uB0E5 \uC624\uC138\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396940
    m_Localized: "\uC528\uC557\uC744 \uC2EC\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396941
    m_Localized: "\uC625\uC0C1 \uBE44\uB2D0\uD558\uC6B0\uC2A4\uC5D0\uC11C \uBC1B\uC544 \uB454 \uC528\uC557 \uBD09\uD22C\uB97C, {given:\uC740/\uB294} \uAD6C\uC870 \uD5EC\uAE30\uC5D0\uC11C\uB3C4 \uD488\uC5D0 \uC548\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396942
    m_Localized: "\uC7AC\uAC74 \uB18D\uC5C5 \uC2DC\uD5D8\uC7A5\uC758 \uCCAB \uC218\uD655 \uB0A0, \uC0AC\uB78C\uB4E4\uC740 \uC0C1\uCD94 \uD55C \uC7A5\uC744 \uB098\uB220 \uBA39\uC73C\uBA70 \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396943
    m_Localized: "\uBD04\uB9C8\uB2E4 {given:\uC740/\uB294} \uD559\uAD50 \uC625\uC0C1 \uD759\uC744 \uD55C \uC90C\uC529 \uAC00\uC838\uB2E4 \uC0C8 \uBC2D\uC5D0 \uC11E\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396944
    m_Localized: "\uB9D1\uC740 \uBB3C\uC744 \uB9CC\uB4DC\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396945
    m_Localized: "\uD398\uD2B8\uBCD1 \uBAA8\uB798 \uD544\uD130\uB85C \uC2DC\uC791\uD55C \uC77C\uC740 \uC815\uC218\uC7A5 \uC5F0\uAD6C\uB3D9\uC5D0\uC11C \uC8FC\uC6B4 \uB178\uD2B8\uB85C \uC774\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396946
    m_Localized: "\uADF8 \uB178\uD2B8\uC758 \uC8FC\uC778\uC740 \uB05D\uB0B4 \uB9CC\uB098\uC9C0 \uBABB\uD588\uB2E4. {given:\uC740/\uB294} \uADF8 \uC0AC\uB78C\uC774 \uB05D\uB0B4\uC9C0 \uBABB\uD55C \uC815\uC218 \uC124\uACC4\uB97C \uC774\uC5B4\uBC1B\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396947
    m_Localized: "\u300C\uC544\uBE60 \uD798\uB0B4\u300D CD\uC758 \uC8FC\uC778\uC740 \uADF8 \uC5F0\uAD6C\uB3D9\uC758 \uC5F0\uAD6C\uC6D0\uC774\uC5C8\uB2E4. {given:\uC740/\uB294} \uADF8 \uC0AC\uB78C\uC774 \uB05D\uB0B4\uC9C0 \uBABB\uD55C \uC815\uC218 \uC124\uACC4\uB97C \uC774\uC5B4\uBC1B\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396948
    m_Localized: "10\uB144 \uD6C4, \uB3C4\uC2DC\uC758 \uC218\uB3C4\uAF2D\uC9C0\uC5D0\uC11C \uB2E4\uC2DC \uB9C8\uC2E4 \uC218 \uC788\uB294 \uBB3C\uC774 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396949
    m_Localized: "\uADF8 \uACA8\uC6B8\uC758 \uB178\uB798"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396950
    m_Localized: "\uC74C\uC545\uC2E4\uC5D0\uC11C \uB9DE\uCDB0 \uBCF4\uB358 \uB178\uB798\uB294 \uAD6C\uC870 \uCEA0\uD504\uC758 \uBC24\uB9C8\uB2E4 \uB2E4\uC2DC \uBD88\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396951
    m_Localized: "{given}\uC758 \uCCAB \uC74C\uBC18\uC5D0\uB294 \uD559\uAD50 \uC625\uC0C1\uC5D0\uC11C \uB179\uC74C\uD55C \uBC14\uB78C \uC18C\uB9AC\uAC00 \uB4E4\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396952
    m_Localized: "\uACF5\uC5F0\uC774 \uB05D\uB098\uBA74 {given:\uC740/\uB294} \uB298 \uAC19\uC740 \uB9D0\uC744 \uD588\uB2E4. \"\uC774 \uB178\uB798\uB294 \uAC19\uC774 \uBC84\uD2F4 \uC0AC\uB78C\uB4E4 \uAC70\uC608\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396953
    m_Localized: "\uBB38\uC744 \uB450\uB4DC\uB824 \uC8FC\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396954
    m_Localized: "\uAD6C\uC870 \uCEA0\uD504\uC5D0\uB294 \uBC24\uB9C8\uB2E4 \uC7A0\uB4E4\uC9C0 \uBABB\uD558\uB294 \uC544\uC774\uB4E4\uC774 \uC788\uC5C8\uB2E4. {given:\uC740/\uB294} \uADF8 \uC606\uC5D0 \uC549\uC544 \uB9D0\uC5C6\uC774 \uAE30\uB2E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396955
    m_Localized: "\uC0C1\uB2F4 \uACF5\uBD80\uB97C \uB9C8\uCE5C {given:\uC740/\uB294} \uC0C1\uB2F4\uC2E4 \uBB38\uC5D0 \uC774\uB807\uAC8C \uC368 \uBD99\uC600\uB2E4. '\uB178\uD06C\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396956
    m_Localized: "\uC0C1\uB2F4 \uACF5\uBD80\uB97C \uB9C8\uCE5C {given:\uC740/\uB294} \uC0C1\uB2F4\uC2E4 \uBB38\uC5D0 \uC774\uB807\uAC8C \uC368 \uBD99\uC600\uB2E4. '\uBB34\uC12D\uB2E4\uACE0 \uB9D0\uD574\uB3C4 \uB429\uB2C8\uB2E4. \uC5EC\uAE30\uC11C\uB294 \uADF8 \uB9D0\uBD80\uD130 \uC2DC\uC791\uD569\uB2C8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396957
    m_Localized: "\uCC98\uC74C \uC628 \uC544\uC774\uAC00 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC73C\uBA74, {given:\uC740/\uB294} \uCC3D\uBB38\uC744 \uC5F4\uACE0 \uAC19\uC774 \uD558\uB298\uC744 \uBCF4\uC558\uB2E4. \uC625\uC0C1\uC5D0\uC11C \uBC30\uC6B4 \uC77C\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396958
    m_Localized: "\uC0AC\uAC70\uB9AC\uC758 \uD611\uC0C1\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396959
    m_Localized: "\uAC15\uCCA0\uB3C4 \uC815 \uBC18\uC7A5\uB3C4 DJ \uC0C8\uBCBD\uB3C4, {given}\uC758 \uB9D0\uC774\uB77C\uBA74 \uB05D\uAE4C\uC9C0 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396960
    m_Localized: "\uC7AC\uAC74 \uC758\uD68C\uAC00 \uCC98\uC74C \uC5F4\uB9B0 \uB0A0, \uC138 \uC138\uB825\uC758 \uC790\uB9AC \uD55C\uAC00\uC6B4\uB370\uC5D0 {given}\uC758 \uC790\uB9AC\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396961
    m_Localized: "\uD611\uC0C1\uC774 \uB9C9\uD788\uBA74 {given:\uC740/\uB294} \uB298 \uAC19\uC740 \uAC83\uC744 \uBB3C\uC5C8\uB2E4. \"\uC774 \uC57D\uC18D, \uC77C\uC8FC\uC77C \uB4A4\uC5D0\uB3C4 \uC9C0\uD0AC \uC218 \uC788\uC5B4\uC694?\""
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396962
    m_Localized: "\uB2E4\uC2DC \uB2EC\uB9AC\uB294 \uD2B8\uB799"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396963
    m_Localized: "\uBCF5\uB3C4\uB97C \uB2EC\uB824 \uBE60\uC838\uB098\uC624\uB358 \uB2E4\uB9AC\uB85C, {given:\uC740/\uB294} \uAD6C\uC870 \uCEA0\uD504\uC758 \uC6B4\uB3D9\uC7A5\uC744 \uB9E4\uC77C \uB3CC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396964
    m_Localized: "\uC7AC\uAC74 \uB4A4 \uCC98\uC74C \uC5F4\uB9B0 \uCCB4\uC721\uB300\uD68C\uC5D0\uC11C {given:\uC740/\uB294} \uACB0\uC2B9\uC120\uC744 \uAC00\uC7A5 \uBA3C\uC800 \uC9C0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396965
    m_Localized: "\uD559\uAD50\uC5D0\uC11C \uBC30\uC6B4 \uAC74 \uB3C4\uB9DD\uCE58\uB294 \uBC95\uC774 \uC544\uB2C8\uB77C \uC228 \uACE0\uB974\uB294 \uBC95\uC774\uC5C8\uB2E4. \uCD9C\uBC1C\uC120\uC5D0 \uC124 \uB54C\uB9C8\uB2E4 {given:\uC740/\uB294} \uADF8\uAC78 \uB5A0\uC62C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396966
    m_Localized: "\uAE30\uB85D\uD558\uB294 \uB208"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396967
    m_Localized: "{given}\uC758 \uB178\uD2B8\uC5D0\uB294 \uB2E4 \uC787\uC9C0 \uBABB\uD55C \uC870\uAC01\uB4E4\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uD559\uAD50, \uD734\uBA74\uC5F4, \uADF8\uB9AC\uACE0 \uADF8 \uCCAB \uC8FC."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396968
    m_Localized: "\uAE30\uC790\uAC00 \uB41C {given:\uC740/\uB294} \uADF8 \uC870\uAC01\uC744 \uB4E4\uACE0 \uBA87 \uB144 \uB3D9\uC548 \uC0AC\uB78C\uB4E4\uC744 \uCC3E\uC544\uB2E4\uB154\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396969
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC870\uAC01\uC740 \uB05D\uB0B4 \uCC3E\uC9C0 \uBABB\uD588\uB2E4. \uADF8\uB798\uB3C4 \uAE30\uC0AC\uC758 \uB9C8\uC9C0\uB9C9 \uC904\uC740 \uC774\uB807\uAC8C \uB05D\uB0AC\uB2E4. '\uC6B0\uB9AC\uB294 \uC544\uC9C1 \uBB3B\uACE0 \uC788\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396970
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uAC78\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396971
    m_Localized: "\uB300\uAC78\uB808 \uC790\uB8E8\uB85C \uB9CC\uB4E0 \uBAA9\uBC1C, \uADF8\uB9AC\uACE0 \uC190\uC218 \uAE4E\uC740 \uC758\uC871. {given}\uC758 \uCCAB \uD658\uC790\uB294 \uC724 \uC120\uC0DD\uB2D8\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396972
    m_Localized: "\uC7AC\uD65C \uCE58\uB8CC\uB97C \uBC30\uC6B4 {given:\uC740/\uB294} \uC0AC\uB78C\uB4E4\uC774 \uB2E4\uC2DC \uC11C\uB294 \uB0A0\uC744 \uACC1\uC5D0\uC11C \uC9C0\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396973
    m_Localized: "\uB204\uAD70\uAC00 \uCC98\uC74C\uC73C\uB85C \uD63C\uC790 \uC11C\uB294 \uB0A0\uC774\uBA74, {given:\uC740/\uB294} \uADF8 \uC6B4\uB3D9\uC7A5\uC744 \uB5A0\uC62C\uB838\uB2E4. \uC190\uC218 \uAE4E\uC740 \uC758\uC871\uC73C\uB85C \uB05D\uAE4C\uC9C0 \uC11C\uC11C \uC190\uC744 \uD754\uB4E4\uB358 \uC0AC\uB78C\uC744."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396974
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC740 \uC9C0\uAE08\uB3C4 \uADF8 \uCCAB \uC758\uC871\uC744 \uAD50\uBB34\uC2E4 \uC11C\uB78D\uC5D0 \uB123\uC5B4 \uB450\uC5C8\uB2E4. \"\uB0B4\uAC00 \uBC1B\uC740 \uC120\uBB3C \uC911\uC5D0 \uC81C\uC77C \uC88B\uC740 \uAC70\uC57C. \uB450 \uBC88\uC9F8\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396975
    m_Localized: "\uC5EC\uB35F \uC7A5\uC758 CD"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396976
    m_Localized: "\uBC29\uC1A1\uBC18 \uC9C4\uC5F4\uC7A5\uC758 CD \uC5EC\uB35F \uC7A5\uC744, {given:\uC740/\uB294} \uAD6C\uC870 \uD5EC\uAE30\uC5D0 \uAC00\uC7A5 \uBA3C\uC800 \uC2E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396977
    m_Localized: "\uC7AC\uAC74 \uB3C4\uC2DC \uACE8\uBAA9\uC5D0 \uC791\uC740 \uC74C\uBC18 \uAC00\uAC8C\uAC00 \uC5F4\uB838\uB2E4. \uAC00\uAC8C \uC774\uB984\uC740 \u300C\uC0C8\uBCBD 2\uC2DC \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8\u300D\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396978
    m_Localized: "{given:\uC740/\uB294} \uBA87 \uB144\uC5D0 \uAC78\uCCD0 CD \uC8FC\uC778\uB4E4\uC744 \uCC3E\uC544 \uD55C \uC7A5\uC529 \uB3CC\uB824\uC8FC\uC5C8\uB2E4. \uB05D\uB0B4 \uC8FC\uC778\uC744 \uCC3E\uC9C0 \uBABB\uD55C \uD55C \uC7A5\uC740 \uAC00\uAC8C\uC5D0\uC11C \uB9E4\uC77C \uD2C0\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396979
    m_Localized: "\uAE09\uC2DD\uC774\uC758 \uC8FC\uCE58\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396980
    m_Localized: "\uAE09\uC2DD\uC774\uB294 \uAD6C\uC870 \uD5EC\uAE30 \uC548\uC5D0\uC11C\uB3C4 {given}\uC758 \uBB34\uB98E\uC5D0\uC11C \uB0B4\uB824\uC624\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396981
    m_Localized: "\uC218\uC758\uB300\uB97C \uB9C8\uCE5C {given:\uC740/\uB294} \uC7AC\uAC74 \uB3C4\uC2DC\uC758 \uCCAB \uB3D9\uBB3C\uBCD1\uC6D0 \uBB38\uC744 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3261803030396982
    m_Localized: "\uB300\uAE30\uC2E4 \uCC3D\uAC00 \uC790\uB9AC\uB294 \uB298 \uBE44\uC6CC \uB450\uC5C8\uB2E4. \uD138\uC774 \uD76C\uB057\uD574\uC9C4 \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uAC00 \uB0AE\uC7A0\uC744 \uC790\uB294 \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159115976704
    m_Localized: "\uC0C8\uBCBD\uC758 \uBAA9\uC18C\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236224
    m_Localized: "\uAD6C\uC870 \uB4A4, DJ \uC0C8\uBCBD\uC774 \uBB34\uC804\uC73C\uB85C {given:\uC744/\uB97C} \uBD88\uB800\uB2E4. \"\uC774\uBC88\uC5D4 \uB124\uAC00 \uB9C8\uC774\uD06C \uC55E\uC5D0 \uC549\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236225
    m_Localized: "\uC7AC\uAC74 \uB77C\uB514\uC624\uC758 \uC0C8\uBCBD \uC2DC\uAC04, {given:\uC740/\uB294} \uB9E4\uC77C \uC0AC\uB78C \uCC3E\uB294 \uC18C\uC2DD\uACFC \uB0A0\uC528\uC640 \uB178\uB798 \uD55C \uACE1\uC744 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236226
    m_Localized: "\uCCAB \uBC29\uC1A1\uC758 \uCCAB \uB9C8\uB514\uB294 \uD559\uAD50 \uBC29\uC1A1\uC2E4\uC5D0\uC11C \uD558\uB358 \uADF8\uB300\uB85C\uC600\uB2E4. \"\uB4E4\uB9AC\uB098\uC694? \uC5EC\uAE30\uB294 \uC0C8\uBCBD\uACE0\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236227
    m_Localized: "\uCCAB \uBC29\uC1A1\uC758 \uCCAB \uACE1\uC740 \uBC29\uC1A1\uBC18 \uC9C4\uC5F4\uC7A5\uC5D0\uC11C \uAC00\uC838\uC628 CD\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236228
    m_Localized: "\uB2E4\uC2DC \uC9D3\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236229
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C \uC313\uACE0 \uCC3D\uBB38\uC744 \uB9C9\uB358 \uC190\uC774, \uC774\uBC88\uC5D0\uB294 \uCC3D\uC744 \uB0B4\uB294 \uBC95\uC744 \uBC30\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236230
    m_Localized: "{given:\uC774/\uAC00} \uC124\uACC4\uD55C \uCCAB \uAC74\uBB3C\uC740 \uC791\uC740 \uD559\uAD50\uC600\uB2E4. \uBAA8\uB4E0 \uAD50\uC2E4\uC5D0 \uBB38\uC774 \uB450 \uAC1C\uC529 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236231
    m_Localized: "\uC900\uACF5\uC2DD \uB0A0, {given:\uC740/\uB294} \uCC3D\uACE0 \uBB38\uACE0\uB9AC\uB97C \uC9C1\uC811 \uB3CC\uB824 \uBCF4\uC558\uB2E4. \uC548\uC5D0\uC11C\uB3C4, \uBC16\uC5D0\uC11C\uB3C4 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236232
    m_Localized: "\uB2E4\uC2DC \uD3BC\uCE5C \uAD50\uACFC\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236233
    m_Localized: "\uC218\uB2A5\uB0A0 \uD63C\uC790 \uD480\uC5C8\uB358 \uC2DC\uD5D8\uC9C0\uB97C, {given:\uC740/\uB294} \uAD6C\uC870 \uCEA0\uD504\uC5D0\uC11C\uB3C4 \uBC84\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236234
    m_Localized: "\uB2E4\uC2DC \uC5F4\uB9B0 \uCCAB \uB300\uD559 \uC785\uC2DC\uC5D0\uC11C {given:\uC740/\uB294} \uADF8\uD574 \uAC00\uC7A5 \uC5B4\uB9B0 \uD569\uACA9\uC790 \uC911 \uD558\uB098\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236235
    m_Localized: "\uC5F0\uAD6C\uC2E4 \uBCBD\uC5D0\uB294 \uCC44\uC810\uD55C \uBAA8\uC758\uACE0\uC0AC \uD55C \uC7A5\uC774 \uBD99\uC5B4 \uC788\uB2E4. \uC810\uC218 \uC606\uC5D0 \uC724 \uC120\uC0DD\uB2D8 \uAE00\uC528\uAC00 \uC788\uB2E4. '\uB05D\uAE4C\uC9C0 \uC549\uC544 \uC788\uC5C8\uC74C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236236
    m_Localized: "\uB9E8 \uC55E\uC5D0 \uC120 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236237
    m_Localized: "\uAD6C\uC870 \uCEA0\uD504\uC758 \uC0AC\uB78C\uB4E4\uC740 {given}\uC758 \uC190\uC5D0 \uB4E4\uB9B0 \uB0A1\uC740 \uBABD\uB465\uC774\uB97C \uC624\uB798 \uBC14\uB77C\uBCF4\uC558\uB2E4. {given:\uC740/\uB294} \uADF8 \uBB34\uAC8C\uB97C \uC54C\uACE0 \uC788\uC5C8\uB2E4. \uADF8\uB798\uC11C \uC124\uBA85\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236238
    m_Localized: "\uC2A4\uBB34 \uC0B4\uC774 \uB418\uB358 \uD574, {given:\uC740/\uB294} \uBB34\uB108\uC9C4 \uB3D9\uB124\uB97C \uB418\uCC3E\uB294 \uC7AC\uAC74 \uBC29\uC704\uB300\uC5D0 \uC790\uC6D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236239
    m_Localized: "\uBD84\uB300\uC6D0\uB4E4\uC5D0\uAC8C {given:\uC774/\uAC00} \uCC98\uC74C \uAC00\uB974\uCE5C \uAC83\uC740 \uC2F8\uC6B0\uB294 \uBC95\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uB3CC\uC544\uC624\uB294 \uAE38\uC744 \uBA3C\uC800 \uD655\uC778\uD558\uB294 \uBC95\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236240
    m_Localized: "\uBC24\uC744 \uAC77\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236241
    m_Localized: "\uC190\uC804\uB4F1\uC774 \uC5C6\uC5B4\uB3C4 {given:\uC740/\uB294} \uC5B4\uB450\uC6B4 \uBCF5\uB3C4\uC758 \uACC4\uB2E8 \uC218\uB97C \uC140 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236242
    m_Localized: "\uC7AC\uAC74 \uAD6C\uC870\uB300\uC758 \uC57C\uAC04 \uC218\uC0C9\uC870\uC5D0\uC11C, \uAC00\uC7A5 \uC5B4\uB450\uC6B4 \uAD6C\uC5ED\uC740 \uB298 {given}\uC758 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236243
    m_Localized: "\uC0C8\uBCBD\uC5D0 \uB3CC\uC544\uC628 {given:\uC740/\uB294} \uBB34\uC804\uAE30\uC5D0 \uC9E7\uAC8C \uB9D0\uD588\uB2E4. \"\uC804\uC6D0 \uADC0\uD658.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236244
    m_Localized: "\uD559\uAD50\uB97C \uAE30\uC5B5\uD558\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236245
    m_Localized: "{given:\uC740/\uB294} 1\uB144 \uB3D9\uC548 \uD559\uAD50 \uBC16\uC73C\uB85C \uAC70\uC758 \uB098\uAC00\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uD559\uAD50\uC758 \uBAA8\uB4E0 \uBB38\uACFC \uCC3D\uACFC \uBC30\uAD00\uC744 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236246
    m_Localized: "\uC0C8\uBCBD\uACE0\uAC00 \uB2E4\uC2DC \uBB38\uC744 \uC5F4\uB358 \uB0A0, \uD589\uC815\uC2E4 \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB294 {given:\uC774/\uAC00} \uBC1B\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236247
    m_Localized: "\uC878\uC5C5\uC2DD \uB0A0\uB9C8\uB2E4 {given:\uC740/\uB294} \uCCB4\uC721\uAD00 \uCC3D\uACE0 \uBB38\uC744 \uD65C\uC9DD \uC5F4\uC5B4 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236248
    m_Localized: "\uC774\uB984\uC744 \uBD88\uB7EC \uC900 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236249
    m_Localized: "{given:\uC774/\uAC00} \uCC3E\uC544 \uB370\uB824\uC624\uAC70\uB098 \uB3CC\uC544\uAC08 \uAE38\uC744 \uC54C\uB824 \uC900 \uC0AC\uB78C\uB4E4\uC758 \uC774\uB984\uC774 \uB178\uD2B8 \uD55C \uC7A5\uC744 \uCC44\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236250
    m_Localized: "\uC7AC\uAC74 \uB4A4 {given:\uC740/\uB294} \uD769\uC5B4\uC9C4 \uAC00\uC871\uC744 \uC787\uB294 \uC0AC\uB78C \uCC3E\uAE30 \uC13C\uD130\uC5D0\uC11C \uC77C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236251
    m_Localized: "\uC13C\uD130 \uBCBD\uC5D0\uB294 \uC774\uB984 \uD558\uB098\uAC00 \uC774\uC5B4\uC9C8 \uB54C\uB9C8\uB2E4 \uC885\uC774\uD559\uC774 \uD558\uB098\uC529 \uAC78\uB838\uB2E4. \uCCAB \uC885\uC774\uD559\uC740 \uD559\uAD50\uC5D0\uC11C \uC811\uC740 \uAC83\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3282159661236252
    m_Localized: "\uC13C\uD130 \uBCBD\uC5D0\uB294 \uC774\uB984 \uD558\uB098\uAC00 \uC774\uC5B4\uC9C8 \uB54C\uB9C8\uB2E4 \uC885\uC774\uD559\uC774 \uD558\uB098\uC529 \uAC78\uB838\uB2E4. \uCCAB \uC885\uC774\uD559\uC740 \uB3C4\uD604\uC758 \uC5B4\uBA38\uB2C8 \uBAAB\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804366376960
    m_Localized: "\uB04A\uAE34 \uC120\uC744 \uC787\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788992
    m_Localized: "\uCEF4\uD4E8\uD130\uC2E4\uC758 \uBAA8\uB380 \uC18C\uB9AC\uB294 \uAD6C\uC870 \uB4A4\uC5D0\uB3C4 \uC624\uB798 \uADC0\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788993
    m_Localized: "{given:\uC740/\uB294} \uBB34\uB108\uC9C4 \uAE30\uC9C0\uAD6D\uC744 \uD558\uB098\uC529 \uB2E4\uC2DC \uC138\uC6B0\uB294 \uD1B5\uC2E0 \uBCF5\uAD6C\uBC18\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788994
    m_Localized: "\uC7AC\uAC74 \uB3C4\uC2DC\uC5D0 \uCC98\uC74C \uC5F4\uB9B0 \uAC8C\uC2DC\uD310\uC758 \uCCAB \uAE00\uC740 {given:\uC774/\uAC00} \uC37C\uB2E4. '\uC0C8\uBCBD\uACE0\uC5D0\uC11C \uBC84\uD2F4 \uC0AC\uB78C\uB4E4, \uC5EC\uAE30 \uBAA8\uC5EC\uC694.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788995
    m_Localized: "\uBC1C\uC18C\uB9AC \uC5C6\uB294 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788996
    m_Localized: "1\uB144 \uB3D9\uC548 {given:\uC740/\uB294} \uAC70\uC758 \uD55C \uBC88\uB3C4 \uB4E4\uD0A4\uC9C0 \uC54A\uC558\uB2E4. \uD559\uAD50 \uBC16\uC758 \uB204\uAD6C\uB3C4 {given:\uC774/\uAC00} \uB2E4\uB140\uAC04 \uC904 \uBAB0\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788997
    m_Localized: "\uADF8 \uC774\uC57C\uAE30\uB97C \uB4E4\uC740 \uAD6C\uC870\uB300\uAC00 {given:\uC744/\uB97C} \uC815\uCC30\uBC18\uC73C\uB85C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788998
    m_Localized: "{given:\uC740/\uB294} \uC9C0\uAE08\uB3C4 \uBB38\uC744 \uC5F4\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uADC0\uB97C \uB304\uB2E4. \uADF8 \uBC84\uB987 \uB355\uBD84\uC5D0 \uB9CE\uC740 \uC0AC\uB78C\uC774 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504788999
    m_Localized: "\uD55C \uBC88\uB3C4 \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uC740 \uC0AC\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789000
    m_Localized: "\uC11C\uB978 \uBC88 \uB118\uAC8C \uD559\uAD50 \uBC16\uC744 \uB2E4\uB140\uC624\uACE0\uB3C4, {given:\uC740/\uB294} \uD55C \uBC88\uB3C4 \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789001
    m_Localized: "\uC7AC\uB09C \uC548\uC804 \uAD50\uAD00\uC774 \uB41C {given:\uC740/\uB294} \uCCAB \uC218\uC5C5\uB9C8\uB2E4 \uCE60\uD310\uC5D0 \uC138 \uC904\uC744 \uC37C\uB2E4. \uC0B4\uD540\uB2E4. \uB4E3\uB294\uB2E4. \uB3CC\uC544\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789002
    m_Localized: "\uC218\uB8CC\uC2DD \uB0A0 \uC544\uC774\uB4E4\uC774 \uBB3C\uC5C8\uB2E4. \"\uBB34\uC12D\uC9C0 \uC54A\uC558\uC5B4\uC694?\" \"\uB9E4\uBC88 \uBB34\uC11C\uC6E0\uC5B4. \uADF8\uB798\uC11C \uB9E4\uBC88 \uB3CC\uC544\uC654\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789003
    m_Localized: "\uC0C8\uBCBD\uB3D9 \uC9C0\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789004
    m_Localized: "{given}\uC758 \uC77C\uAE30\uC7A5 \uB4A4\uCABD\uC5D0\uB294 \uC0C8\uBCBD\uB3D9\uC758 \uACE8\uBAA9\uACFC \uACC4\uB2E8\uACFC \uB9C9\uD78C \uBB38\uC774 \uBE7C\uACE1\uD788 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789005
    m_Localized: "\uAD6C\uC870\uB300\uB294 \uADF8 \uC9C0\uB3C4\uB97C \uBCA0\uAEF4 \uAC14\uB2E4. \uAE4A\uC740 \uACF3\uAE4C\uC9C0 \uADF8\uB824\uC9C4 \uC9C0\uB3C4\uB294 \uADF8\uAC83 \uD558\uB098\uBFD0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789006
    m_Localized: "\uBA87 \uB144 \uB4A4 \uB2E4\uC2DC \uADF8\uB9B0 \uB3C4\uC2DC \uC9C0\uB3C4\uC758 \uADC0\uD241\uC774\uC5D0 \uC791\uC740 \uAE00\uC528\uAC00 \uC788\uC5C8\uB2E4. '\uCC98\uC74C \uADF8\uB9B0 \uC0AC\uB78C: \uC0C8\uBCBD\uACE0 \uD559\uC0DD.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789007
    m_Localized: "\uB354\uBD88\uC5B4 \uC7A5\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789008
    m_Localized: "\uC2DD\uB7C9\uACFC \uC57D\uACFC \uAC74\uC804\uC9C0\uB97C, {given:\uC740/\uB294} 1\uB144 \uB3D9\uC548 \uB204\uAD6C\uBCF4\uB2E4 \uB9CE\uC774 \uBC14\uAFB8\uACE0 \uB098\uB234\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789009
    m_Localized: "\uC815 \uBC18\uC7A5\uACFC \uD568\uAED8 \uC5F0 \uC7A5\uD130\uC5D0\uB294 \uAC12 \uB300\uC2E0 '\uD544\uC694\uD55C \uB9CC\uD07C'\uC774\uB77C\uB294 \uD33B\uB9D0\uC774 \uAC78\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789010
    m_Localized: "\uC7A5\uBD80 \uB9E8 \uC55E\uC7A5\uC5D0\uB294 \uCCAB \uAC70\uB798\uAC00 \uC801\uD600 \uC788\uB2E4. \uC11C\uB85C \uBBFF\uAE30 \uC2DC\uC791\uD55C \uB0A0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789011
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD1B5\uC870\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789012
    m_Localized: "\uCC2C\uC7A5\uC774 \uBE48 \uC8FC\uAC00 \uC5EC\uB7EC \uBC88 \uC788\uC5C8\uB2E4. \uADF8\uB54C\uB9C8\uB2E4 {given:\uC740/\uB294} \uAC00\uC7A5 \uC791\uC740 \uBAAB\uC744 \uC790\uAE30 \uC55E\uC5D0 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789013
    m_Localized: "\uC7AC\uAC74 \uCEA0\uD504\uC758 \uAD6C\uD638 \uC2DD\uB7C9 \uCC3D\uACE0 \uC5F4\uC1E0\uB294 {given:\uC774/\uAC00} \uB9E1\uC558\uB2E4. \uC544\uBB34\uB3C4 \uBD88\uD3C9\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789014
    m_Localized: "\uBC30\uAE09 \uC904 \uB9E8 \uB05D\uC5D0 \uC120 \uC544\uC774\uC5D0\uAC8C\uB3C4, {given:\uC740/\uB294} \uB298 \uAC19\uC740 \uD06C\uAE30\uC758 \uBAAB\uC744 \uAC74\uB138\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789015
    m_Localized: "\uBB34\uAC8C\uB97C \uB4E0 \uCC44\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789016
    m_Localized: "\uD5EC\uAE30\uC5D0 \uC624\uB974\uAE30 \uC804, {given:\uC740/\uB294} \uC190\uBC14\uB2E5\uC744 \uC624\uB798 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4. \uC53B\uC5B4\uB3C4 \uB0A8\uB294 \uAC83\uC774 \uC788\uB2E4\uB294 \uAC78 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789017
    m_Localized: "\uBA87 \uB144\uC774 \uC9C0\uB098\uB3C4 {given:\uC740/\uB294} \uADF8 1\uB144\uC744 \uBCC0\uBA85\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC774\uC720\uAC00 \uC788\uC5C8\uB2E4\uACE0\uB3C4, \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\uACE0\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789018
    m_Localized: "\uBB34\uC11C\uC6C0\uC744 \uBC84\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uC11C \uADF8 \uC77C\uC740 \uB05D\uB0B4 \uC26C\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789019
    m_Localized: "\uC65C \uADF8\uB7AC\uB294\uC9C0 \uC54C\uC558\uAE30\uC5D0, \uBA48\uCDB0\uC57C \uD560 \uB54C \uBA48\uCD9C \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789020
    m_Localized: "\uBB34\uAC70\uC6B4 \uB0A0\uC774\uBA74 \uB204\uAD70\uAC00\uB97C \uCC3E\uC544\uAC00 \uC774\uC57C\uAE30\uD588\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uAC00\uB974\uCCD0 \uC900 \uB300\uB85C. \uB3CC\uC740 \uADF8\uB300\uB85C\uC600\uC9C0\uB9CC, \uD63C\uC790 \uB4DC\uB294 \uB0A0\uC740 \uC904\uC5B4\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789021
    m_Localized: "\uADF8 \uB3CC\uC744 \uB0B4\uB824\uB193\uC9C0 \uC54A\uC740 \uCC44\uB85C, \uC2DC\uAC04\uC740 \uD758\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789022
    m_Localized: "5\uB144 \uD6C4, {given:\uC740/\uB294} \uAC19\uC740 \uC77C\uC744 \uACAA\uC740 \uC544\uC774\uB4E4\uC5D0\uAC8C \uD3B8\uC9C0\uB97C \uC4F4\uB2E4. '\uCC3D\uACE0 \uBB38\uC740 \uC548\uC5D0\uC11C\uB3C4 \uC5F4\uB824. \uB124\uAC00 \uB2EB\uC740 \uBB38\uB3C4, \uB124\uAC00 \uB2E4\uC2DC \uC5F4 \uC218 \uC788\uC5B4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789023
    m_Localized: "\uADF8\uD574\uC758 \uC774\uC720\uB4E4\uC744 {given:\uC740/\uB294} \uD55C \uBC88\uB3C4 \uAEBC\uB0B4 \uB193\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789024
    m_Localized: "\uB2E4 \uADF8\uB7F4 \uB9CC\uD588\uB2E4\uACE0, \uC2A4\uC2A4\uB85C\uC5D0\uAC8C \uBA87 \uBC88\uC774\uACE0 \uB9D0\uD588\uB2E4. \uB9D0\uD560\uC218\uB85D \uBB38\uC740 \uB2E8\uB2E8\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789025
    m_Localized: "10\uB144 \uD6C4, {given:\uC740/\uB294} \uCC98\uC74C\uC73C\uB85C \uB204\uAD70\uAC00\uC5D0\uAC8C \uADF8 1\uB144\uC744 \uC774\uC57C\uAE30\uD588\uB2E4. \uB2A6\uC5C8\uC9C0\uB9CC, \uC2DC\uC791\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789026
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uB9E4\uC77C \uBB38 \uC55E\uC5D0 \uC549\uC544 \uB9D0\uD588\uB2E4. \uB300\uB2F5\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB41C\uB2E4\uACE0. \uD558\uB098\uB9CC, \uB4E4\uACE0 \uC788\uB294 \uAC83 \uD558\uB098\uB9CC \uB0B4\uB824\uB193\uC73C\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789027
    m_Localized: "\uB4E4\uD0A4\uC9C0 \uC54A\uACE0 \uB2E4\uB140\uC628 \uD0D0\uD5D8 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789028
    m_Localized: "\uAE4A\uC740 \uACF3\uAE4C\uC9C0 \uB0B4\uB824\uAC00 \uBCF8 \uC9C0\uC5ED {0}\uACF3"
    m_Metadata:
      m_Items: []
  - m_Id: 3286804504789029
    m_Localized: "\uC138\uB825\uACFC\uC758 \uAC70\uB798 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 3340077777567744
    m_Localized: "\uBC29\uAE08 \uAE00\uC744 \uC62C\uB838\uC2B5\uB2C8\uB2E4. {0}\uCD08 \uB4A4\uC5D0 \uB2E4\uC2DC \uC62C\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uAE00\uC740 \uC774 \uCEF4\uD4E8\uD130\uC5D0\uB9CC \uB0A8\uACA8 \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3340077857259520
    m_Localized: "\uC0C8\uB85C \uC774\uC5B4\uC9C4 \uD68C\uC120\uC740 {0}\uCD08 \uB4A4\uBD80\uD130 \uAE00\uC774 \uAC74\uB108\uAC11\uB2C8\uB2E4. \uC774\uBC88 \uAE00\uC740 \uC774 \uCEF4\uD4E8\uD130\uC5D0\uB9CC \uB0A8\uACA8 \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3382945057619968
    m_Localized: "R \uC2E0\uACE0  \xB7  P \uC55E \uD654\uBA74  \xB7  T \uCC98\uC74C  \xB7  X \uC811\uC18D \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998464
    m_Localized: "\uC774 \uAE00\uC744 \uC2E0\uACE0\uD569\uB2C8\uAE4C?  Y = \uC2E0\uACE0\uD569\uB2C8\uB2E4  \xB7  \uB2E4\uB978 \uBA85\uB839 = \uADF8\uB9CC\uB461\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998465
    m_Localized: "\uC2E0\uACE0\uB97C \uBCF4\uB0B4\uB294 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998466
    m_Localized: "\uC2E0\uACE0\uD588\uC2B5\uB2C8\uB2E4. \uC774 \uAE00\uC740 \uC774\uC81C \uBCF4\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998467
    m_Localized: "\uBC29\uAE08 \uC2E0\uACE0\uD588\uC2B5\uB2C8\uB2E4. {0}\uCD08 \uB4A4\uC5D0 \uB2E4\uC2DC \uC2E0\uACE0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998468
    m_Localized: "\uC0C8\uB85C \uC774\uC5B4\uC9C4 \uD68C\uC120\uC740 {0}\uCD08 \uB4A4\uBD80\uD130 \uC2E0\uACE0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998469
    m_Localized: "\uC800\uCABD\uC5D0\uC11C \uC2E0\uACE0\uB97C \uBC1B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3382945367998470
    m_Localized: "\uD68C\uC120\uC774 \uBD88\uC548\uC815\uD569\uB2C8\uB2E4. \uC2E0\uACE0\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
