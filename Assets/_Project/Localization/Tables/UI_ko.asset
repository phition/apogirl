  - m_Id: 104237345554450
    m_Localized: "\uC8FC\uD30C\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554451
    m_Localized: "\uC751\uAE09 \uAC10\uAC01"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554452
    m_Localized: "\uADF8\uB9BC\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554453
    m_Localized: "\uBC29\uC5B4\uB3C4 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554454
    m_Localized: "\uC704\uD611\uB3C4 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554455
    m_Localized: "\uC2DC\uC124 \uAC1C\uBC29: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554456
    m_Localized: "\uC804\uB825\uC774 \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554457
    m_Localized: "\uC783\uC740 \uAC83: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554458
    m_Localized: "\uBC24 \uC2B5\uACA9\uC744 \uB9C9\uC544 \uB0C8\uB2E4. (\uC2B5\uACA9 {0} vs \uBC29\uC5B4 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554459
    m_Localized: "\uBC24 \uC2B5\uACA9\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uB6AB\uB838\uB2E4. (\uC2B5\uACA9 {0} vs \uBC29\uC5B4 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554460
    m_Localized: "\uC77C\uAE30: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554461
    m_Localized: "\uCD9C\uC815 \uC900\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554462
    m_Localized: "\uB0AE: \uB300\uBD80\uBD84 \uC7A0\uB4E4\uC5B4 \uC788\uB2E4. \uAE68\uC6B0\uC9C0 \uC54A\uB294 \uAC83\uC774 \uD575\uC2EC. \uD574\uAC00 \uC9C0\uBA74 \uBAA8\uB450 \uAE68\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554463
    m_Localized: "\uBC24: \uAE68\uC5B4\uB098 \uB3CC\uC544\uB2E4\uB2CC\uB2E4. \uC5B4\uB461\uACE0, \uB300\uC2E0 \uC0AC\uB78C\uC740 \uC5C6\uB2E4. \uC0C8\uBCBD\uAE4C\uC9C0 \uBC84\uD2F0\uBA74 \uB3CC\uC544\uC62C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554464
    m_Localized: "\uC608\uC0C1 \uD53C\uB85C +{0} \xB7 \uC2A4\uD2B8\uB808\uC2A4 +{1}~{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554465
    m_Localized: "\uBC24 \uD0D0\uD5D8\uC740 \uC218\uBA74 \uBD80\uCC44 +1. \uB2E4\uC74C \uB0A0 \uB0AE\uC740 \uAC15\uC81C \uD734\uC2DD."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554466
    m_Localized: "\uC4F0\uB7EC\uC9C0\uBA74 \uBC30\uB0AD\uACFC \uAC00\uC838\uAC04 \uC7A5\uBE44\uB97C \uBAA8\uB450 \uC783\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554467
    m_Localized: "\uCD9C\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554468
    m_Localized: "\uBC30\uB0AD"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554469
    m_Localized: "\uC8FC\uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554470
    m_Localized: "\uB3C4\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554471
    m_Localized: "\uBC29\uC5B4\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554472
    m_Localized: "\uD035\uC2AC\uB86F"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554473
    m_Localized: "\uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554474
    m_Localized: "{0}\xD7{1} \uCE78"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554475
    m_Localized: "\uD0C0\uACA9 {0} \xB7 \uB0B4\uAD6C\uB3C4 {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554476
    m_Localized: "\uD53C\uD574 \u2212{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554477
    m_Localized: "\uB3C4\uAD6C \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554478
    m_Localized: "\uC190\uC804\uB4F1"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554479
    m_Localized: "\uC1E0\uC9C0\uB81B\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554480
    m_Localized: "\uC154\uD130\uAC00 \uB0B4\uB824\uC838 \uC788\uB2E4. \uB0AE\uC5D0\uB294 \uC5F4 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554481
    m_Localized: "\uC7A0\uACA8 \uC788\uB2E4. \uC1E0\uC9C0\uB81B\uB300\uAC00 \uC788\uC73C\uBA74 \uC5F4 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554482
    m_Localized: "\uC1E0\uC9C0\uB81B\uB300\uB85C \uC5B5\uC9C0\uB85C \uC5F4\uC5C8\uB2E4. \uC18C\uB9AC\uAC00 \uCEF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554483
    m_Localized: "\uC190\uC804\uB4F1\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554484
    m_Localized: "\uC4F0\uB7EC\uB728\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554485
    m_Localized: "\uB9DE\uD614\uB2E4! \uC7A0\uAE50 \uBE44\uD2C0\uAC70\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554486
    m_Localized: "\uBB34\uAE30\uAC00 \uBD80\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554487
    m_Localized: "{0} \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554488
    m_Localized: '{0} ({1})'
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554489
    m_Localized: "\uB9E8\uC190 (Q \uBC00\uCE58\uAE30)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554490
    m_Localized: "E: \uB2E4\uAC00\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554491
    m_Localized: "E: \uC1E0\uC9C0\uB81B\uB300\uB85C \uCD9C\uAD6C \uC5F4\uAE30 (\uD070 \uC18C\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554492
    m_Localized: "{0} \u2014 \uC154\uD130\uAC00 \uB0B4\uB824\uC838 \uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554493
    m_Localized: "E: {0} \uBB38\uC744 \uC1E0\uC9C0\uB81B\uB300\uB85C \uC5F0\uB2E4 (\uD070 \uC18C\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554494
    m_Localized: "{0} \u2014 \uC7A0\uACA8 \uC788\uB2E4 (\uC1E0\uC9C0\uB81B\uB300 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554495
    m_Localized: "A/D\uB85C \uAC77\uB294\uB2E4. \uB2EC\uB9AC\uBA74(Shift) \uBE60\uB974\uC9C0\uB9CC \uC2DC\uB044\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554496
    m_Localized: "Ctrl\uC744 \uB204\uB978 \uCC44 \uAC78\uC73C\uBA74 \uC870\uC6A9\uD788 \uC6C0\uC9C1\uC778\uB2E4. \uC7A0\uB4E0 \uBB34\uB9AC \uADFC\uCC98\uC5D0\uC11C\uB294 \uC6C5\uD06C\uB9AC\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554497
    m_Localized: "\uC0C1\uC790\xB7\uC0AC\uBB3C\uD568 \uC55E\uC5D0\uC11C E\uB97C \uAE38\uAC8C \uB20C\uB7EC \uC218\uC0C9\uD55C\uB2E4. \uC218\uC0C9 \uC911\uC5D0\uB294 \uBB34\uBC29\uBE44\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554498
    m_Localized: "Tab\uC73C\uB85C \uBC30\uB0AD\uC744 \uC5F0\uB2E4. \uCE78\uACFC \uBB34\uAC8C\uAC00 \uD55C\uC815\uB418\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554499
    m_Localized: "\uC0AC\uBB3C\uD568\uC774\uB098 \uCC45\uC0C1 \uC55E\uC5D0\uC11C Space\uB85C \uC228\uC744 \uC218 \uC788\uB2E4. \uD55C \uBC88 \uC228\uC5B4 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554500
    m_Localized: "\uBCF5\uB3C4 \uB05D \uBCF8\uAD00 \uCC3D\uACE0 \uBB38(\uCD08\uB85D\uC0C9)\uC5D0\uC11C E\uB85C \uB4E4\uC5B4\uAC00\uBA74 \uB05D\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554501
    m_Localized: "\uAD50\uC2E4 \uAD6C\uC11D, \uCC45\uC0C1 \uBC11\uC5D0 \uC911\uD559\uC0DD \uD558\uB098\uAC00 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uB2E4. \uC774\uCABD\uC744 \uBCF4\uB354\uB2C8 \uC228\uC744 \uBA48\uCD98\uB2E4. \"\u2026\uC0AC\uB78C, \uB9DE\uC8E0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554502
    m_Localized: "\uAC19\uC774 \uAC00\uC790\uACE0 \uC190\uC744 \uB0B4\uBBFC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554503
    m_Localized: "\uBB3C\uACFC \uACFC\uC790\uB97C \uAC74\uB124\uACE0, \uAC70\uC810 \uC704\uCE58\uB97C \uC54C\uB824 \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554504
    m_Localized: "\uC870\uC6A9\uD788 \uBB38\uC744 \uB2EB\uACE0 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554505
    m_Localized: "\uAD50\uBB34\uC2E4 \uB9E8 \uC548\uCABD \uCE90\uBE44\uB2DB. \uACF5\uBB38 \uCCA0 \uC0AC\uC774\uC5D0 \uC0AC\uD0DC \uC0AC\uD758 \uC804 \uB0A0\uC9DC\uC758 \uC11C\uB958\uAC00 \uB07C\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554506
    m_Localized: "\uC11C\uB958\uB97C \uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554507
    m_Localized: "\uB450\uACE0 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554508
    m_Localized: "\uC9C4\uB8CC\uC2E4 \uCC45\uC0C1 \uC704, \uC758\uC0AC\uAC00 \uD718\uAC08\uACA8 \uC4F4 \uBA54\uBAA8. \"\uBC1C\uC5F4 \uD6C4 2\uC8FC \uBB34\uC99D\uC0C1, \uC774\uD6C4 \uC7AC\uBC1C\uC5F4 \uC0AC\uB840\u2026\""
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554509
    m_Localized: "\uBA54\uBAA8\uB97C \uCC59\uAE34\uB2E4 (\uB2E8\uC11C)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554510
    m_Localized: "\uC9C0\uAE08\uC740 \uADF8\uB0E5 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554511
    m_Localized: "\uCCB4\uC721\uAD00 \u2192 \uBCF8\uAD00 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554512
    m_Localized: "\uD559\uAD50 \uC55E \uD3B8\uC758\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554513
    m_Localized: "\uC0C8\uBCBD\uC57D\uAD6D \xB7 \uC5F0\uC138\uC758\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554514
    m_Localized: "\uCCB4\uC721 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554515
    m_Localized: "\uD3B8\uC758\uC810 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554516
    m_Localized: "\uD3B8\uC758\uC810 \uC0AC\uBB34\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554517
    m_Localized: "\uC870\uC81C\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554518
    m_Localized: "{0}\uCE35 \uC9C4\uB8CC\uC2E4 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554519
    m_Localized: "\uC57D\uD488\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554520
    m_Localized: "\uC624\uB298\uB3C4 \uC0B4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554521
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBB38\uC744 \uC5F4\uC5B4 \uC92C\uB2E4. \uC77C\uC8FC\uC77C \uB9CC\uC5D0 \uC0AC\uB78C \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554522
    m_Localized: "\uACF5\uBD80\uB97C \uB2E4\uC2DC \uC2DC\uC791\uD588\uB2E4. \uC774\uC0C1\uD558\uAC8C \uC548\uC2EC\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554523
    m_Localized: "\uBAB8\uC774 \uBB34\uAC81\uB2E4. \uB0B4\uC77C\uC740 \uC880 \uC26C\uC5B4\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554524
    m_Localized: "\uC790\uAFB8 \uADF8 \uCC3D\uACE0 \uAFC8\uC744 \uAFBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554525
    m_Localized: "\uBA39\uC744 \uAC83\uC774 \uC904\uC5B4\uB4E0\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC790\uAE30 \uBAAB\uC744 \uB35C\uC5B4 \uC8FC\uB294 \uAC78 \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554526
    m_Localized: "\uBC24\uC744 \uB108\uBB34 \uB9CE\uC774 \uC0DC\uB2E4. \uB208\uC744 \uAC10\uC73C\uBA74 \uC5B4\uB460 \uC18D \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554527
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uBCF5\uB3C4\uB97C \uAC78\uC5C8\uB2E4. \uBC1C\uC18C\uB9AC\uAC00 \uC870\uAE08 \uC6B0\uC2A4\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554528
    m_Localized: "\uB3C4\uD604\uC774\uAC00 \uC624\uB298 \uCC98\uC74C\uC73C\uB85C \uC6C3\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554529
    m_Localized: "\uBCF4\uB0B4\uC9C0\uC9C0 \uC54A\uB294 \uBA54\uC2DC\uC9C0\uB97C \uB610 \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554530
    m_Localized: "\uBC24\uC0C8 \uBB38\uC744 \uC9C0\uCF30\uB2E4. \uC544\uC9C1 \uBB34\uB108\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554531
    m_Localized: "\uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uB6AB\uB838\uB2E4. \uB2E4\uC2DC \uC313\uC544\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554532
    m_Localized: "\uCC3D\uBC16 \uBC9A\uB098\uBB34\uC5D0 \uAF43\uC774 \uD53C\uC5C8\uB2E4. \uC544\uBB34\uB3C4 \uBCF4\uC9C0 \uC54A\uB294\uB370\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554533
    m_Localized: "\uB0AE\uC774 \uAE38\uC5B4\uC84C\uB2E4. \uB354\uC704\uAC00 \uC2DC\uC791\uB418\uB824 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554534
    m_Localized: "\uB0B4\uC77C\uC740 \uC870\uAE08 \uB354 \uB098\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554535
    m_Localized: "\uB9D0\uC744 \uD558\uC9C0 \uC54A\uC740 \uB0A0\uC774 \uB298\uC5B4 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554536
    m_Localized: "\uBD04\uC774 \uB05D\uB0AC\uB2E4. \uC6B0\uB9AC\uB294 \uC544\uC9C1 \uC5EC\uAE30 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554537
    m_Localized: "\uC624\uB298 \uACC4\uD68D\uC740 \uC5B4\uB54C? \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554538
    m_Localized: "\uCCAB \uC8FC\uC57C. \uBA3C\uC800 \uCC3D\uACE0\uAE4C\uC9C0 \uBB34\uC0AC\uD788 \uAC00\uB294 \uAC83\uB9CC \uC0DD\uAC01\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554539
    m_Localized: "\uBA39\uC744 \uAC8C \uC5BC\uB9C8 \uC548 \uB0A8\uC558\uC5B4. \uC774\uBC88 \uC8FC\uC5D4 \uD55C \uBC88 \uB098\uAC00\uC57C \uD560 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554540
    m_Localized: "\uBC24\uC744 \uB108\uBB34 \uC0C8\uC6E0\uC5B4. \uBC24 \uD734\uC2DD\uC73C\uB85C \uBE5A\uBD80\uD130 \uAC1A\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554541
    m_Localized: "\uC5BC\uAD74\uC774 \uC548 \uC88B\uC544. \uB9C8\uC74C \uB2E4\uC2A4\uB9AC\uB294 \uC2DC\uAC04\uB3C4 \uACC4\uD68D\uC5D0 \uB123\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554542
    m_Localized: "\uBAA9\uBC1C\u2026 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4. \uC790\uC7AC\uAC00 2\uAC1C \uC788\uC73C\uBA74 \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554543
    m_Localized: "\uBC29\uC1A1\uC2E4 \uBC1C\uC804\uAE30. \uACF5\uD559 \uACF5\uBD80\uB97C \uD574 \uB450\uBA74 \uACE0\uCE60 \uC218 \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554544
    m_Localized: "\uBC24\uC5D0 \uBB38 \uAE01\uB294 \uC18C\uB9AC\uAC00 \uC7A6\uC544\uC84C\uC5B4. \uBC14\uB9AC\uCF00\uC774\uB4DC\uB098 \uC57C\uAC04 \uACBD\uACC4\uB97C \uB123\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554545
    m_Localized: "\uB3C4\uD604\uC774\uB3C4 \uAC19\uC774 \uACC4\uD68D\uC5D0 \uB123\uC5B4 \uC8FC\uC790. \uADF8 \uC560\uB3C4 \uBB54\uAC00 \uD558\uACE0 \uC2F6\uC5B4 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554546
    m_Localized: "\uBC24 \uD0D0\uD5D8\uC740 \uD559\uAD50 \uC548\uC5D0\uC11C \uBA3C\uC800 \uC5F0\uC2B5\uD558\uC790. \uC190\uC804\uB4F1 \uC78A\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554547
    m_Localized: "\uBD04\uC758 \uB9C8\uC9C0\uB9C9 \uC8FC\uC57C. \uC774\uC0C1\uD558\uAC8C \uC870\uC6A9\uD558\uB2E4. \uBB38\uB2E8\uC18D \uB2E8\uB2E8\uD788 \uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554548
    m_Localized: "\uAD50\uACFC\uC11C\uB294 \uAC70\uC9D3\uB9D0\uC744 \uC548 \uD574. \uC624\uB298\uB3C4 \uD55C \uC904\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554549
    m_Localized: "\uD55C\uC11C\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554550
    m_Localized: "\uCE5C\uAD6C\uAC00 \uBD80\uB974\uB294 \uB0B4 \uC774\uB984\uC740? (\uAE30\uBCF8: \uD55C\uC11C\uC9C4)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554551
    m_Localized: "\uD734\uB300\uD3F0 \uC54C\uB9BC \u2014 \uC800\uC7A5\uB41C \uCE5C\uAD6C\uC758 \uC5F0\uB77D\uCC98 \uC774\uB984\uC740? (\uC2E4\uC81C \uCE5C\uAD6C \uC774\uB984\uB3C4 \uC88B\uC544\uC694. \uC774 \uC778\uBB3C\uC740 \uC774\uC57C\uAE30 \uC18D\uC5D0\uC11C \uC704\uD5D8\uC5D0 \uCC98\uD560 \uC218 \uC788\uC5B4\uC694.)"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554552
    m_Localized: "\uB0B4 \uC0DD\uC77C\uC740?"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554553
    m_Localized: "\uB0B4 \uB124 \uAE00\uC790\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554554
    m_Localized: "{0}\uC6D4"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554555
    m_Localized: "{0}\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554556
    m_Localized: "\uD559\uAD50\uC0DD\uD65C\uAE30\uB85D\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554557
    m_Localized: "\uC131\uBA85: {0}   \uC0DD\uB144\uC6D4\uC77C: {1}\uC6D4 {2}\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554558
    m_Localized: "\uC131\uACA9 \uC720\uD615: {0}   \uD608\uC561\uD615: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554559
    m_Localized: "\uBC30\uCE58\uACE0\uC0AC: {0}   \uC790\uC2E0 \uC788\uB294 \uACFC\uBAA9: {1}   \uB3D9\uC544\uB9AC: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554560
    m_Localized: "\uD2B9\uAE30\xB7\uD2B9\uC131: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554561
    m_Localized: "\uB2A5\uB825\uCE58 \uD569\uACC4 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554562
    m_Localized: "\uC5F0\uB77D\uCC98: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554563
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554564
    m_Localized: "A\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554565
