    m_Localized: "\uBD07\uC744 \uB3CC\uB9AC\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1305170565939211
    m_Localized: "\uBD07 \uC124\uC815(bot_strategies.json)\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08\uC740 \uC5D0\uB514\uD130\uC5D0\uC11C\uB9CC \uB3CC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1305170565939212
    m_Localized: "\uC804\uB7B5\uC744 \uD558\uB098 \uC774\uC0C1 \uACE0\uB974\uC138\uC694."
    m_Metadata:
