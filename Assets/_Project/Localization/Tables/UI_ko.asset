  - m_Id: 1727283305
    m_Localized: "{0}\uC77C\uCC28 {1} \xB7 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283306
    m_Localized: "\uAC15\uC81C \uD734\uC2DD\uC744 \uC5B4\uAE30\uACE0 \uBB34\uB9AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283307
    m_Localized: "\uC26C\uC9C0 \uC54A\uACE0 \uC5F0\uB2EC\uC544 \uCD9C\uC815\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283308
    m_Localized: "\uBB34\uC0AC\uD788 \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283309
    m_Localized: "\uC4F0\uB7EC\uC84C\uB2E4. \uBC30\uB0AD\uC744 \uC783\uACE0 \uAC00\uAE4C\uC2A4\uB85C \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1727283310
    m_Localized: "\uC218\uBA74 \uBD80\uCC44 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283311
    m_Localized: "\uC591\uC2EC\uC758 \uBB34\uAC8C {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283312
    m_Localized: "{0} \uC219\uB828\uB3C4 \uC0C1\uC2B9!"
    m_Metadata:
      m_Items: []
  - m_Id: 1727283313
    m_Localized: "\uB208\uC5D0 \uB744\uB294 \uBCC0\uD654\uB294 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
