    m_Metadata:
      m_Items: []
  - m_Id: 104237345554556
    m_Localized: "\uD559\uAD50\uC0DD\uD65C\uAE30\uB85D\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554557
    m_Localized: "\uC131\uBA85: {0}   \uC0DD\uB144\uC6D4\uC77C: {1}\uC6D4 {2}\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554558
    m_Localized: "\uC131\uACA9 \uC720\uD615: {0}   \uD608\uC561\uD615: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 104237345554559
    m_Localized: "\uBC30\uCE58\uACE0\uC0AC: {0}   \uC790\uC2E0 \uC788\uB294 \uACFC\uBAA9: {1}   \uB3D9\uC544\uB9AC: {2}"
