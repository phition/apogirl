      m_Items: []
  - m_Id: 1305170565939207
    m_Localized: "\uCDE8\uC18C\uD558\uB294 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1305170565939208
    m_Localized: "\uBD07 \uC2E4\uD589\uC744 \uCDE8\uC18C\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1305170565939209
    m_Localized: "{0}\uD310 \uC644\uB8CC ({1}\uCD08) \u2192 {2}"
