    m_Localized: "\uBC24 \uD0D0\uD5D8 \xB7 \uB2E4\uC74C \uB0A0 \uB0AE\uC740 \uAC15\uC81C \uD734\uC2DD \xB7 \uC218\uBA74 \uBD80\uCC44 +1"
