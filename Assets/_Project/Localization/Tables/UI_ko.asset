    m_Metadata:
      m_Items: []
  - m_Id: 709646951399424
    m_Localized: "\uC7A5\uBE44 \uC8FC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 709646951399425
    m_Localized: "\uAE30\uBCF8 \uC7A5\uBE44 \uD55C \uBC8C (\uAC00\uBC29\xB7\uD30C\uC774\uD504\xB7\uC190\uC804\uB4F1\xB7\uD328\uB529\xB7\uBD95\uB300\xB7\uAC04\uC2DD)"
    m_Metadata:
      m_Items: []
  - m_Id: 812842147397632
    m_Localized: "{0}\uC8FC\uCC28 \xB7 {2}\uC6D4 {3}\uC77C \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335616
    m_Localized: "{0}\uC6D4\uC758 \uD55C \uC7A5\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335617
    m_Localized: "\uC624\uB298\uC758 \uBAB8"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335618
    m_Localized: "\uB098\uB294 \uC9C0\uAE08 \uC774\uB9CC\uD07C"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335619
    m_Localized: "\uBAA8\uC740 \uC2A4\uD2F0\uCEE4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335620
    m_Localized: "\uC544\uC9C1"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335621
    m_Localized: "\uC120\uC0DD\uB2D8\uC758 \uD55C\uB9C8\uB514"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335622
    m_Localized: "\uC2F8\uC6C0 \uC2E4\uB825 {0} \xB7 \uBC84\uD2F8 \uC218 \uC788\uB294 \uC2A4\uD2B8\uB808\uC2A4 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335623
    m_Localized: "\uAD1C\uCC2E\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335624
    m_Localized: "\uC5EC\uAE30\uC800\uAE30 \uC544\uD504\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335625
    m_Localized: "\uC704\uD5D8\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335626
    m_Localized: "\uAC00\uBFD0\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335627
    m_Localized: "\uC870\uAE08 \uD53C\uACE4\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335628
    m_Localized: "\uC9C0\uCCE4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335629
    m_Localized: "\uD55C\uACC4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335630
    m_Localized: "\uB9C8\uC74C\uC774 \uD3B8\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335631
    m_Localized: "\uBC84\uD2F8 \uB9CC\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335632
    m_Localized: "\uB0A0\uC774 \uC11C \uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335633
    m_Localized: "\uBB34\uB108\uC9C0\uAE30 \uC9C1\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335634
    m_Localized: "\uAE68\uB057\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335635
    m_Localized: "\uAF2C\uC9C8\uAF2C\uC9C8\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335636
    m_Localized: "\uB354\uB7FD\uB2E4 (\uC0C1\uCC98\uAC00 \uB367\uB0A0 \uC218 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335637
    m_Localized: "\uCCB4\uB825 \u2014 \uBAB8\uC758 \uBC14\uD0D5. \uC2F8\uC6C0 \uC2E4\uB825\uC5D0 \uBCF4\uD0DC\uC9C0\uACE0, \uC0DD\uC874 \uAE30\uC220 \uC218\uC5C5\uACFC \uBC84\uD168\uC57C \uD558\uB294 \uC120\uD0DD\uC9C0\uC5D0\uC11C \uC4F0\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335638
    m_Localized: "\uADFC\uB825 \u2014 \uD0D0\uD5D8\uC5D0\uC11C \uB4E4\uACE0 \uC62C \uC218 \uC788\uB294 \uBB34\uAC8C\uAC00 \uB298\uACE0, \uC2F8\uC6C0 \uC2E4\uB825(\uBB34\uAE30\xB7\uBC00\uCE58\uAE30)\uC5D0 \uD06C\uAC8C \uBCF4\uD0DC\uC9C4\uB2E4. \uD798\uC73C\uB85C \uB9C9\uC544\uC11C\uB294 \uC120\uD0DD\uC9C0\uC5D0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335639
    m_Localized: "\uBBFC\uCCA9 \u2014 \uC2F8\uC6C0 \uC2E4\uB825\uC5D0 \uBCF4\uD0DC\uC9C0\uACE0, \uC790\uB3D9 \uC218\uC0C9 \uB54C \uC4F0\uB7EC\uC9C8 \uC704\uD5D8\uC744 \uC904\uC778\uB2E4. \uD638\uC2E0\uC220 \uC218\uC5C5 \uD310\uC815\uACFC \uC7AC\uBE68\uB9AC \uD53C\uD558\uB294 \uC120\uD0DD\uC9C0\uC5D0\uC11C \uC4F0\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335640
    m_Localized: "\uC9C0\uB825 \u2014 \uAD6D\uC5B4\xB7\uC751\uAE09\xB7\uACF5\uD559\xB7\uACFC\uD559 \uC218\uC5C5\uACFC \uBC24 \uACF5\uBD80, \uC815\uC218\xB7\uC804\uB825 \uBCF5\uAD6C\xB7\uAC10\uC5FC \uCE58\uB8CC\uC758 \uC131\uACF5\uB960\uC744 \uB192\uC778\uB2E4. \uC5B4\uB5A4 \uC9C4\uB85C\uB85C \uC774\uC5B4\uC9C8\uC9C0\uC5D0\uB3C4 \uC601\uD5A5\uC744 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335641
    m_Localized: "\uC190\uC7AC\uC8FC \u2014 \uD0D0\uD5D8\uC5D0\uC11C \uC0C1\uC790\uB97C \uB354 \uBE68\uB9AC \uB4A4\uC9C4\uB2E4. \uC694\uB9AC\xB7\uACF5\uD559\xB7\uC0DD\uC874 \uC218\uC5C5, \uBAA9\uBC1C\xB7\uC758\uC871 \uB9CC\uB4E4\uAE30, \uC804\uB825 \uBCF5\uAD6C \uD310\uC815\uC5D0 \uC4F0\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335642
    m_Localized: "\uC758\uC9C0 \u2014 \uBC84\uD2F8 \uC218 \uC788\uB294 \uC2A4\uD2B8\uB808\uC2A4\uC758 \uD55C\uACC4\uB97C \uB192\uC778\uB2E4. \uB9C8\uC74C \uC218\uC5C5 \uD310\uC815\uACFC \uBB34\uC11C\uC6B4 \uC21C\uAC04\uC744 \uACAC\uB514\uB294 \uC120\uD0DD\uC9C0\uC5D0\uC11C \uC4F0\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335643
    m_Localized: "\uAC10\uC218\uC131 \u2014 \uC74C\uC545 \uC218\uC5C5 \uD310\uC815\uC5D0 \uC4F0\uC774\uACE0, \uC0AC\uB78C\uC758 \uB9C8\uC74C\uC744 \uC77D\uB294 \uC21C\uAC04\uACFC \uC0AC\uB78C\uC744 \uB3CC\uBCF4\uB294 \uC9C4\uB85C\uC5D0 \uC601\uD5A5\uC744 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335644
    m_Localized: "\uD1B5\uC194 \u2014 \uC0AC\uB78C\uB4E4\uC744 \uC774\uB04C\uACE0 \uC124\uB4DD\uD558\uB294 \uC120\uD0DD\uC9C0\uC5D0\uC11C \uC4F0\uC778\uB2E4. \uB3D9\uB8CC\uAC00 \uC5EC\uB7FF\uC77C \uB54C \uC5B4\uB5A4 \uC9C4\uB85C\uB85C \uC774\uC5B4\uC9C8\uC9C0\uC5D0\uB3C4 \uC601\uD5A5\uC744 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335645
    m_Localized: "\uC751\uAE09\uCC98\uCE58\xB7\uC758\uD559 \u2014 \uB2E8\uACC4\uB9C8\uB2E4 \uAC10\uC5FC\uACFC \uC120\uC0DD\uB2D8 \uBCD1\uC138\uAC00 \uB354\uB514\uAC8C \uC9C4\uD589\uB418\uACE0, \uB2E4\uCE5C \uB4A4 \uC751\uAE09 \uCC98\uCE58\uB85C \uBD80\uC0C1\uC744 \uB9C9\uC744 \uAC00\uB2A5\uC131\uC774 \uCEE4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335646
    m_Localized: "\uC0DD\uC874 \uAE30\uC220 \u2014 \uC0DD\uC874 \uAE30\uC220 \uC218\uC5C5\uC5D0\uC11C \uC5BB\uB294 \uAC83\uC774 \uB298\uACE0, \uBC14\uAE65\uC5D0\uC11C \uBC84\uD2F0\uB294 \uC791\uC5C5 \uD310\uC815\uC5D0 \uBCF4\uD0DC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335647
    m_Localized: "\uACF5\uD559\xB7\uC218\uB9AC \u2014 \uACF5\uD559 \uC218\uC5C5\uACFC \uBAA9\uBC1C\xB7\uC758\uC871 \uB9CC\uB4E4\uAE30, \uC804\uB825 \uBCF5\uAD6C \uAC19\uC740 \uC81C\uC791\xB7\uC218\uB9AC \uD310\uC815\uC5D0 \uBCF4\uD0DC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335648
    m_Localized: "\uC804\uC220\xB7\uD638\uC2E0\uC220 \u2014 \uB2E8\uACC4\uB9C8\uB2E4 \uC2F8\uC6C0 \uC2E4\uB825\uC774 \uC624\uB974\uACE0, \uD0D0\uD5D8\uC5D0\uC11C \uBB34\uAE30\uB97C \uB2E4\uC2DC \uD718\uB450\uB974\uAE30\uAE4C\uC9C0\uC758 \uD2C8\uC774 \uC9E7\uC544\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335649
    m_Localized: "\uC694\uB9AC\xB7\uC601\uC591 \u2014 \uC694\uB9AC \uC218\uC5C5\uC5D0\uC11C \uB9CC\uB4DC\uB294 \uC74C\uC2DD\uC774 \uC88B\uC544\uC838 \uD3EC\uB9CC\xB7\uC218\uBD84\uACFC \uB2A5\uB825\uCE58\uC5D0 \uB354 \uBCF4\uD0E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335650
    m_Localized: "\uC5B4\uD559\xB7\uC778\uBB38\xB7\uAE30\uB85D \u2014 \uAD6D\uC5B4 \uC218\uC5C5 \uD310\uC815\uC5D0 \uBCF4\uD0DC\uC9C0\uACE0, \uAE30\uB85D\uACFC \uAC00\uB974\uCE68\uC5D0 \uAD00\uD55C \uC9C4\uB85C\uB85C \uC774\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335651
    m_Localized: "\uC2EC\uB9AC\xB7\uBA85\uC0C1 \u2014 \uB2E8\uACC4\uB9C8\uB2E4 \uBC84\uD2F8 \uC218 \uC788\uB294 \uC2A4\uD2B8\uB808\uC2A4\uC758 \uD55C\uACC4\uAC00 \uC624\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335652
    m_Localized: "\uACFC\uD559 \u2014 \uC815\uC218\uC640 \uC57D\uD488\uC744 \uB2E4\uB8E8\uB294 \uD6A8\uC728\uC744 \uB192\uC778\uB2E4. \uAC70\uCC98\uB97C \uAD50\uC2E4\uB85C \uC62E\uAE30\uBA74 \uBC30\uC6B8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 812842340335653
    m_Localized: "\uC74C\uC545 \u2014 \uC2A4\uD2B8\uB808\uC2A4\uC640 \uB9C8\uC74C\uC758 \uC0C1\uCC98\uB97C \uB2EC\uB798\uB294 \uB370 \uB3C4\uC6C0\uC774 \uB41C\uB2E4. \uAC70\uCC98\uB97C \uAD50\uC2E4\uB85C \uC62E\uAE30\uBA74 \uBC30\uC6B8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 813338551664640
    m_Localized: "\uC624\uB298\uB3C4 \uC798 \uBC84\uD17C\uB2E4. \uADF8\uAC70\uBA74 \uCDA9\uBD84\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356416
    m_Localized: "\uC694\uC998 \uACC4\uB2E8\uC744 \uC624\uB974\uB294 \uBC1C\uAC78\uC74C\uC774 \uAC00\uBCBC\uC6CC\uC84C\uB354\uB77C. \uAFB8\uC900\uD568\uC774 \uBAB8\uC5D0 \uBD99\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356417
    m_Localized: "\uBB34\uAC70\uC6B4 \uAC78 \uBC88\uCA4D \uB4DC\uB294 \uAC78 \uBD24\uC5B4. \uADF8\uB798\uB3C4 \uD5C8\uB9AC\uB294 \uC544\uAEF4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356418
    m_Localized: "\uBAB8\uC774 \uB9CE\uC774 \uBE68\uB77C\uC84C\uB2E4. \uB3C4\uB9DD\uCE58\uB294 \uAC83\uB3C4 \uC2E4\uB825\uC774\uC57C. \uBD80\uB044\uB7EC\uC6CC\uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356419
    m_Localized: "\uC774\uBC88 \uC8FC\uC5D0 \uC9C8\uBB38\uC774 \uB298\uC5C8\uB2E4. \uBAA8\uB974\uB294 \uAC78 \uBB3B\uB294 \uAC8C \uC81C\uC77C \uBE68\uB9AC \uD06C\uB294 \uAE38\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356420
    m_Localized: "\uC190\uC774 \uC57C\uBB34\uC9C0\uB2E4. \uACE0\uCCD0 \uB193\uC740 \uAC78 \uBCF4\uBA74 \uB9C8\uC74C\uC774 \uB193\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356421
    m_Localized: "\uD798\uB4E0 \uC8FC\uC600\uB294\uB370\uB3C4 \uB05D\uAE4C\uC9C0 \uD574\uB0C8\uAD6C\uB098. \uADF8 \uBC84\uD300\uC774 \uB124 \uD798\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356422
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C \uD45C\uC815\uC744 \uBA3C\uC800 \uC0B4\uD53C\uB354\uB77C. \uADF8 \uB9C8\uC74C, \uC783\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356423
    m_Localized: "\uC0AC\uB78C\uB4E4\uC774 \uB124 \uB9D0\uC744 \uB4E3\uAE30 \uC2DC\uC791\uD588\uC5B4. \uC55E\uC5D0 \uC124 \uB54C\uC77C\uC218\uB85D \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356424
    m_Localized: "\uC798 \uBA39\uACE0 \uC798 \uAC77\uB294 \uC544\uC774. \uADF8\uAC8C \uC9C0\uAE08\uC740 \uC81C\uC77C \uD070 \uC7AC\uB2A5\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356425
    m_Localized: "\uD798\uC774 \uC88B\uC740 \uAC74 \uC54C\uC9C0\uB9CC, \uD63C\uC790 \uB2E4 \uB4E4\uB824\uACE0 \uD558\uC9C0\uB294 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356426
    m_Localized: "\uB208\uCE58\uB3C4 \uBC1C\uB3C4 \uBE60\uB974\uB2E4. \uADF8 \uB355\uC5D0 \uC6B0\uB9AC\uAC00 \uC5EC\uAE30 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 813338631356427
    m_Localized: "\uC0DD\uAC01\uC774 \uAE4A\uC740 \uC544\uC774\uB2E4. \uB2F5\uC774 \uB2A6\uC5B4\uB3C4 \uAD1C\uCC2E\uC544, \uB05D\uAE4C\uC9C0 \uC0DD\uAC01\uD574 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 813338635550720
    m_Localized: "\uBB50\uB4E0 \uC190\uC73C\uB85C \uD574\uACB0\uD574 \uB0B4\uB294 \uC544\uC774. \uC774 \uD559\uAD50\uAC00 \uC870\uAE08\uC529 \uC0AC\uB78C \uC0AC\uB294 \uACF3\uC774 \uB418\uC5B4 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 813338635550721
    m_Localized: "\uC27D\uAC8C \uAEBE\uC774\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB798\uB3C4 \uAC00\uB054\uC740 \uAE30\uB300\uB3C4 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 813338635550722
    m_Localized: "\uB9C8\uC74C\uC774 \uB530\uB73B\uD55C \uC544\uC774\uB2E4. \uB124 \uB355\uC5D0 \uB2E4\uB4E4 \uD55C \uBC88 \uB354 \uC6C3\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 813338635550723
    m_Localized: "\uC0AC\uB78C\uC744 \uBAA8\uC73C\uB294 \uD798\uC774 \uC788\uB2E4. \uADF8 \uD798\uC744 \uB108 \uC790\uC2E0\uC744 \uC704\uD574\uC11C\uB3C4 \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 813679439527936
    m_Localized: "\uC751\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414016
    m_Localized: "\uC0DD\uC874"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414017
    m_Localized: "\uACF5\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414018
    m_Localized: "\uD638\uC2E0"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414019
    m_Localized: "\uC694\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414020
    m_Localized: "\uC778\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414021
    m_Localized: "\uB9C8\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414022
    m_Localized: "\uACFC\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 813679523414023
    m_Localized: "\uC74C\uC545"
    m_Metadata:
      m_Items: []
  - m_Id: 840816280223744
    m_Localized: "\uB108\uBB34 \uC5B4\uB450\uC6CC \uBB38\uD2C8 \uB108\uBA38\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4. \uADC0\uB97C \uAE30\uC6B8\uC5EC \uBCF4\uC790 (S)"
    m_Metadata:
      m_Items: []
  - m_Id: 850124631982080
    m_Localized: "\uC228\uB294 \uC911\u2026 (Space\uB97C \uACC4\uC18D \uB204\uB974\uACE0 \uC788\uAE30)"
    m_Metadata:
      m_Items: []
  - m_Id: 850124749422592
    m_Localized: "\uC7A0\uB4E4\uC5B4 \uC788\uB2E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 850124749422593
    m_Localized: "\uAE5C\uBE61 \uC7A0\uB4E4\uC5C8\uB2E4 \u2014 Space\uB97C \uC5F0\uD0C0\uD574 \uAE68\uC5B4\uB098\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 850124749422594
    m_Localized: "\uAE34\uC7A5\uC774 \uD480\uB824 \uAE5C\uBE61 \uC7A0\uB4E4\uC5B4 \uBC84\uB838\uB2E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 850124749422595
    m_Localized: "\uBC88\uCA4D \uB208\uC744 \uB5B4\uB2E4! \uC5BC\uB9C8\uB098 \uC794 \uAC70\uC9C0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 850124749422596
    m_Localized: "\uC228\uC774 \uCC28\uC11C \uB354\uB294 \uBABB \uD558\uACA0\uB2E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 850124749422597
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB108"
    m_Metadata:
      m_Items: []
  - m_Id: 852042074832896
    m_Localized: "\uC73D! \uBB3C\uB9AC\uB294 \uC544\uD514\uC5D0 \uBC88\uCA4D \uAE7C\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 878903676911616
    m_Localized: "\uC120\uBC30\uB294 \uAD6C\uC870 \uBA85\uB2E8\uC5D0 '\uC0C8\uBCBD\uACE0 2\uD559\uB144'\uC73C\uB85C \uC801\uD614\uB2E4. \uB300\uD53C\uC18C\uC5D0\uC11C\uB3C4 \uB9E1\uAE30\uB294 \uC77C\uC774\uBA74 \uB9D0\uC5C6\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0, \uACE7\uC798 \uD574\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 878903735631872
    m_Localized: "\uC0AC\uAC70\uB9AC\uC758 \uADF8\uB0A0 \uC774\uD6C4\uB85C \uC120\uBC30\uB294 \uB298 \uBC18 \uAC78\uC74C \uB4A4\uC5D0\uC11C \uAC78\uC5C8\uB2E4. \uB300\uD53C\uC18C\uC5D0\uC11C\uB3C4. \uADF8\uAC8C \uC120\uBC30\uAC00 \uB300\uB2F5\uD558\uB294 \uBC29\uC2DD\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 878903735631873
    m_Localized: "\uC120\uBC30\uB294 \uB05D\uAE4C\uC9C0 \uC774\uB984\uC744 \uC4F0\uC9C0 \uC54A\uC558\uB2E4. \uB300\uD53C\uC18C \uBA85\uB2E8\uC758 \uADF8 \uCE78\uC5D0\uB294 \uC9C0\uAE08\uB3C4 '2\uD559\uB144'\uACFC \uB3D9\uADF8\uB77C\uBBF8 \uD558\uB098\uBFD0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 878903735631874
    m_Localized: "\uB300\uD53C\uC18C\uC5D0\uC11C \uC120\uBC30\uC758 \uC6C3\uC74C\uC18C\uB9AC\uB97C \uB450 \uBC88\uC9F8\uB85C \uB4E4\uC5C8\uB2E4. \uC544\uC774\uB4E4\uC5D0\uAC8C \uACF5 \uCC28\uB294 \uBC95\uC744 \uAC00\uB974\uCE58\uB2E4\uAC00. \uC774\uB984\uC740 \uC5EC\uC804\uD788 \uC544\uBB34\uB3C4 \uBAB0\uB790\uB2E4. \uB2E4\uB4E4 \uADF8\uB0E5 \uC120\uBC30\uB77C\uACE0 \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887651883565056
    m_Localized: "\uAC80\uC9C4\uAD00\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uADF8\uB7F0\uB370 \uC724 \uC120\uC0DD\uB2D8\uC740 \uD5EC\uAE30 \uBB38 \uC55E\uC5D0\uC11C \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4. \uBC15 \uC120\uC0DD\uB2D8\uC774 \uADF8 \uC606\uC5D0 \uB098\uB780\uD788 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948608
    m_Localized: "'\uC5B4\uB978\uB4E4\uC758 \uCC45\uC784\uC774\uC8E0.' \uBC15 \uC120\uC0DD\uB2D8\uC774 \uC6C3\uC5C8\uB2E4. \uC625\uC0C1\uC758 \uB450 \uC0AC\uB78C\uC740 \uD5EC\uAE30\uAC00 \uC810\uC774 \uB420 \uB54C\uAE4C\uC9C0 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948609
    m_Localized: "\uD55C \uB2EC \uB4A4, \uB450 \uBC88\uC9F8 \uD5EC\uAE30\uC5D0\uC11C \uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uB0B4\uB838\uB2E4. \uADF8 \uACA8\uC6B8\uC758 \uAE30\uB85D\uC740 \uD6D7\uB0A0 \uD734\uBA74\uC5F4 \uCE58\uB8CC\uC81C \uC5F0\uAD6C\uC758 \uCCAB \uB2E8\uC11C\uAC00 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948610
    m_Localized: "\uD5EC\uAE30 \uBB38\uC774 \uC5F4\uB9AC\uACE0 {friend:\uC774/\uAC00} \uB0B4\uB838\uB2E4. \uAC80\uC9C4\uAD00\uC5D0\uAC8C \uC81C \uD0D1\uC2B9\uD45C\uB97C \uB3CC\uB824\uC8FC\uBA70 \uC6C3\uC5C8\uB2E4. '\uB098\uB294 \uB2E4\uC74C \uAC70 \uD0C8\uAC8C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948611
    m_Localized: "\uBB38\uC774 \uB2EB\uD788\uAE30 \uC9C1\uC804, {given:\uC740/\uB294} \uD5EC\uAE30\uC5D0\uC11C \uB6F0\uC5B4\uB0B4\uB838\uB2E4. \uBB34\uB98E\uC774 \uC625\uC0C1 \uBC14\uB2E5\uC5D0 \uB2FF\uC558\uB2E4. {friend:\uC774/\uAC00} \uC6B8\uBA74\uC11C \uC6C3\uC5C8\uB2E4. '\uB108 \uC9C4\uC9DC \uBC14\uBCF4\uC57C.'"
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948612
    m_Localized: "\uD55C \uB2EC\uC740 \uAE08\uBC29 \uAC14\uB2E4. \uB458\uC740 \uADF8\uB3D9\uC548 \uB5A1\uBCF6\uC774 \uAC00\uAC8C\uB97C \uC5B4\uB514\uB85C \uD560\uC9C0 \uC11C\uB978 \uBC88\uCBE4 \uB2E4\uC2DC \uC815\uD588\uB2E4. \uB450 \uBC88\uC9F8 \uD5EC\uAE30\uC5D0\uB294 \uB098\uB780\uD788 \uD0D4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948613
    m_Localized: "\uAC80\uC9C4\uC774 \uB05D\uB0AC\uB2E4. \uD558\uB9B0\uC740 \uD5EC\uAE30 \uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4. '\uBA3C\uC800 \uAC00. \uB098\uB294 \uC5EC\uAE30 \uD55C \uB2EC \uB354 \uC788\uC5B4\uB3C4 \uB3FC.'"
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948614
    m_Localized: "\uC120\uBC30\uAC00 \uB9D0\uC5C6\uC774 \uD558\uB9B0 \uC606 \uACC4\uB2E8\uCC38\uC5D0 \uC549\uC558\uB2E4. \uAC00\uBC29\uB3C4 \uB0B4\uB824\uB193\uC558\uB2E4. \uD5EC\uAE30\uAC00 \uB5A0\uB098\uB294 \uB3D9\uC548 \uB458\uC740 \uD55C \uBC88\uB3C4 \uC11C\uB85C\uB97C \uBCF4\uC9C0 \uC54A\uC558\uC9C0\uB9CC, \uC77C\uC5B4\uC11C\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948615
    m_Localized: "\uD55C \uB2EC \uB4A4 \uB450 \uBC88\uC9F8 \uD5EC\uAE30\uC5D0\uC11C, \uD558\uB9B0\uC740 \uCC98\uC74C\uC73C\uB85C \uBA3C\uC800 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4. \uC120\uBC30\uB294 \uADF8 \uBC18 \uAC78\uC74C \uB4A4\uC5D0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652042948616
    m_Localized: "'\uC774\uBC88\uC5D4 \uC81C\uAC00 \uACE0\uB97C\uAC8C\uC694.' \uC1A1\uC608\uC9C0\uAC00 \uD5EC\uAE30 \uBB38 \uC55E\uC5D0\uC11C \uBB3C\uB7EC\uC130\uB2E4. \uBAA9\uC18C\uB9AC\uB294 \uB5A8\uB838\uC9C0\uB9CC, \uB204\uAC00 \uB300\uC2E0 \uC815\uD574 \uC8FC\uC9C0 \uC54A\uC740 \uCCAB \uC120\uD0DD\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337216
    m_Localized: "\uC120\uBC30\uAC00 \uC1A1\uC608\uC9C0\uC758 \uAC00\uBC29\uC744 \uB4E4\uC5B4 \uC8FC\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uADF8\uB300\uB85C \uC606\uC5D0 \uB0A8\uC558\uB2E4. \uB450 \uC0AC\uB78C\uC740 \uD5EC\uAE30\uAC00 \uC0AC\uB77C\uC9C8 \uB54C\uAE4C\uC9C0 \uC190\uC744 \uD754\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337217
    m_Localized: "\uD55C \uB2EC \uB4A4, \uC1A1\uC608\uC9C0\uB294 \uB450 \uBC88\uC9F8 \uD5EC\uAE30\uC5D0\uC11C \uB0B4\uB9AC\uC790\uB9C8\uC790 \uCE60\uD310\uC5D0 \uC368 \uB450\uC5C8\uB358 \uADF8 \uB9D0\uC744 \uC9C1\uC811 \uD574 \uC8FC\uC5C8\uB2E4. \uACE0\uB9C8\uC6E0\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337218
    m_Localized: "\uC120\uBC30\uB294 \uAC80\uC9C4\uD45C\uB97C \uBC1B\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC774\uACE0, \uC625\uC0C1 \uBB3C\uD0F1\uD06C \uCABD\uC73C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337219
    m_Localized: "\uD5EC\uAE30\uAC00 \uB5A0\uC624\uB97C \uB54C, \uC120\uBC30\uB294 \uC625\uC0C1\uC758 \uADF8 \uCE58\uC988\uC0C9 \uACE0\uC591\uC774\uB97C \uD488\uC5D0 \uC548\uACE0 \uC788\uC5C8\uB2E4. \uADC0 \uB05D\uC774 \uC798\uB9B0 \uACE0\uC591\uC774. \uC120\uBC30\uAC00 \uC6C3\uB294 \uAC78, \uADF8\uB54C \uCC98\uC74C \uC81C\uB300\uB85C \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337220
    m_Localized: "\uD55C \uB2EC \uB4A4 \uB450 \uBC88\uC9F8 \uD5EC\uAE30. \uAC80\uC9C4\uAD00\uC740 \uD55C\uCC38 \uB9DD\uC124\uC774\uB2E4\uAC00, \uACE0\uC591\uC774 \uBAAB\uC758 \uAC80\uC9C4\uD45C\uB97C \uD55C \uC7A5 \uB354 \uC37C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337221
    m_Localized: "\uAC80\uC9C4\uAD00\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. {given:\uC740/\uB294} \uD5EC\uAE30\uC5D0 \uC624\uB974\uC9C0 \uC54A\uC558\uB2E4. \uBB38 \uC55E\uC5D0\uC11C {friend:\uC774/\uAC00} \uBA87 \uBC88\uC774\uACE0 \uC774\uB984\uC744 \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337222
    m_Localized: "\uC724 \uC120\uC0DD\uB2D8\uC774 \uBAA9\uBC1C\uC744 \uC9DA\uACE0 \uC606\uC5D0 \uC130\uB2E4. \uD558\uB9B0\uB3C4 \uD314\uC9F1\uC744 \uB080 \uCC44 \uBC18 \uAC78\uC74C \uB4A4\uC5D0 \uC130\uB2E4. '\uB450 \uBC88\uC740 \uC5C6\uC5B4.' \uD558\uB9B0\uC774 \uD5EC\uAE30\uB97C \uBCF4\uBA70 \uC911\uC5BC\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337223
    m_Localized: "\uC14B\uC774 \uBC84\uD2F4 \uD55C \uB2EC\uC740, \uD63C\uC790 \uAC07\uD600 \uC788\uB358 \uC77C\uC8FC\uC77C\uBCF4\uB2E4 \uC9E7\uC558\uB2E4. \uB450 \uBC88\uC9F8 \uD5EC\uAE30\uC5D0\uB294 \uC14B\uC774 \uB098\uB780\uD788 \uD0D4\uB2E4. \uBB38\uC740 \uC774\uBC88\uC5D0\uB3C4, \uC6B0\uB9AC\uAC00 \uC5F4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337224
    m_Localized: "\uB300\uD53C\uC18C \uBA85\uB2E8\uC758 '2\uD559\uB144' \uCE78 \uC606\uC5D0\uB294 \uC9C0\uAE08\uB3C4 \uC791\uC740 \uACE0\uC591\uC774 \uBC1C\uC790\uAD6D\uC774 \uADF8\uB824\uC838 \uC788\uB2E4. \uC120\uBC30\uAC00 \uB9D0\uC5C6\uC774 \uADF8\uB824 \uB123\uC740 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337225
    m_Localized: "\uD5EC\uAE30\uB294 \uBE48\uC790\uB9AC\uB97C \uC2E3\uACE0 \uB5A0\uB0AC\uB2E4. \uADF8 \uC790\uB9AC\uB97C \uCC44\uC6B8 \uC0AC\uB78C\uC740, \uB05D\uB0B4 \uC625\uC0C1\uC5D0 \uC624\uB974\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 887652051337226
    m_Localized: "\uB0A8\uC740 \uC790\uB9AC\uC5D0\uB294 \uC0AC\uAC70\uB9AC\uC758 \uC544\uC774\uAC00 \uD0D4\uB2E4. \uAC15\uCCA0\uC740 \uC0AC\uAC70\uB9AC \uD55C\uBCF5\uD310\uC5D0\uC11C \uBAA8\uC790\uB97C \uBC97\uC5B4 \uD754\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416914788352
    m_Localized: "\uC0AC\uB78C\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091520
    m_Localized: "\uC0AC\uB78C\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091521
    m_Localized: "\uC544\uC9C1 \uACC1\uC5D0 \uC544\uBB34\uB3C4 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091522
    m_Localized: "\uBA39\uC744 \uAC83\xB7\uC57D\xB7\uC88B\uC544\uD558\uB294 \uBB3C\uAC74\uC740 '\uD55C \uC8FC \uC2E4\uD589'\uC744 \uB204\uB974\uBA74 \uBA3C\uC800 \uB098\uB220 \uC904 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091523
    m_Localized: "\uB2F4\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091524
    m_Localized: "\uBD80\uC0C1 (\uC55E\uC73C\uB85C {0}\uC8FC)"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091525
    m_Localized: "\uB9CE\uC774 \uC9C0\uCCD0 \uC788\uB2E4. \uB9E1\uC740 \uC77C\uC744 \uBC18\uBC16\uC5D0 \uD574\uB0B4\uC9C0 \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091526
    m_Localized: "\uC5B4\uB518\uAC00 \uB0A0\uC774 \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091527
    m_Localized: "\uC544\uC9C1\uC740 \uB370\uBA74\uB370\uBA74\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091528
    m_Localized: "\uACC1\uC5D0 \uC788\uB294 \uAC8C \uD3B8\uD574 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091529
    m_Localized: "\uBA3C\uC800 \uB9D0\uC744 \uAC78\uC5B4 \uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091530
    m_Localized: "\uC11C\uB85C \uB4F1\uC744 \uB9E1\uAE38 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091531
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB208\uC744 \uC798 \uB9C8\uC8FC\uCE58\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091532
    m_Localized: "\uC120\uC0DD\uB2D8\uC740 \uC544\uC9C1 '\uB2F4\uC784'\uC758 \uC5BC\uAD74\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091533
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uAC00\uB054 \uB18D\uB2F4\uC744 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091534
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uD798\uB4E0 \uC598\uAE30\uB3C4 \uAEBC\uB0B4 \uB193\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091535
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uBBFF\uB294\uB2E4. \uB098\uB3C4 \uADF8\uB807\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091536
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB9D0\uC744 \uC544\uB080\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091537
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB298 \uC815\uC911\uD558\uB2E4. \uC870\uAE08 \uBA40\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091538
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB0B4 \uC190\uBD80\uD130 \uC0B4\uD3B4\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091539
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uCEE4\uD53C \uC598\uAE30\uB97C \uD558\uBA70 \uC6C3\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091540
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC774\uC81C \uB0A0 '\uC6B0\uB9AC \uC560'\uB77C\uACE0 \uBD80\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091541
    m_Localized: "\uB3C4\uD604\uC774 \uAD1C\uD788 \uD241\uBA85\uC2A4\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091542
    m_Localized: "\uB3C4\uD604\uC774 \uC5B4\uB978\uC778 \uCC99 \uB9D0\uC744 \uC904\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091543
    m_Localized: "\uB3C4\uD604\uC774 \uC878\uC878 \uB530\uB77C\uB2E4\uB2CC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091544
    m_Localized: "\uB3C4\uD604\uC774 \uB9CC\uD654 \uC598\uAE30\uB97C \uB298\uC5B4\uB193\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091545
    m_Localized: "\uB3C4\uD604\uC774 \uB098\uB97C \uB204\uB098\uCC98\uB7FC \uC758\uC9C0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091546
    m_Localized: "\uC608\uC9C0\uAC00 \uB0B4 \uB208\uCE58\uB97C \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091547
    m_Localized: "\uC608\uC9C0\uB294 \uC544\uC9C1 \uC870\uC6A9\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091548
    m_Localized: "\uC608\uC9C0\uAC00 \uBA3C\uC800 \uC778\uC0AC\uB97C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091549
    m_Localized: "\uC608\uC9C0\uAC00 \uC790\uAE30 \uC598\uAE30\uB97C \uC870\uAE08\uC529 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091550
    m_Localized: "\uC608\uC9C0\uB294 \uC774\uC81C \uB0B4 \uD3B8\uC774\uB2E4. \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091551
    m_Localized: "\uD558\uB9B0\uC774 \uD314\uC9F1\uC744 \uB07C\uACE0 \uBE44\uCF1C \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091552
    m_Localized: "\uD558\uB9B0\uC740 \uC5EC\uC804\uD788 \uB3C4\uB3C4\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091553
    m_Localized: "\uD558\uB9B0\uC774 \uBE44\uAF2C\uC9C0 \uC54A\uACE0 \uB300\uB2F5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091554
    m_Localized: "\uD558\uB9B0\uC774 \uBA38\uB9AC\uB97C \uBB36\uC5B4 \uB2EC\uB77C\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091555
    m_Localized: "\uD558\uB9B0\uC774 \uACE0\uB9D9\uB2E4\uB294 \uB9D0\uC744 \uD560 \uC904 \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091556
    m_Localized: "\uC120\uBC30\uAC00 \uD63C\uC790 \uC788\uACE0 \uC2F6\uC5B4 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091557
    m_Localized: "\uC120\uBC30\uB294 \uB9D0\uC218\uAC00 \uC801\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091558
    m_Localized: "\uC120\uBC30\uAC00 \uAC00\uB054 \uCF67\uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091559
    m_Localized: "\uC120\uBC30\uAC00 \uBC29\uC1A1\uBC18 \uC2DC\uC808 \uC598\uAE30\uB97C \uD574 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091560
    m_Localized: "\uC120\uBC30\uAC00 \uB098\uB97C \uC704\uD574 \uAE30\uD0C0\uB97C \uCCD0 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091561
    m_Localized: "\uC720\uB791\uC790\uAC00 \uC9D0\uC744 \uAFB8\uB824 \uB454 \uCC44\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091562
    m_Localized: "\uC720\uB791\uC790\uB294 \uD544\uC694\uD55C \uB9D0\uB9CC \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091563
    m_Localized: "\uC720\uB791\uC790\uAC00 \uAC00\uB054 \uAE38 \uC598\uAE30\uB97C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091564
    m_Localized: "\uC720\uB791\uC790\uAC00 \uC9C0\uB3C4\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC801\uC5B4 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091565
    m_Localized: "\uC720\uB791\uC790\uAC00 \uC774\uBC88\uC5D4 \uB5A0\uB098\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091566
    m_Localized: "\uACE0\uC591\uC774\uAC00 \uBA40\uCC0D\uC774\uC11C \uB178\uB824\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091567
    m_Localized: "\uACE0\uC591\uC774\uAC00 \uBC25\uB54C\uB9CC \uB098\uD0C0\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091568
    m_Localized: "\uACE0\uC591\uC774\uAC00 \uC606\uC5D0\uC11C \uC878\uAE30\uB3C4 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091569
    m_Localized: "\uACE0\uC591\uC774\uAC00 \uB2E4\uB9AC\uC5D0 \uBAB8\uC744 \uBE44\uBE48\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091570
    m_Localized: "\uACE0\uC591\uC774\uAC00 \uBB34\uB98E \uC704\uC5D0\uC11C \uC7A0\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091571
    m_Localized: "\uC774\uBC88 \uC8FC \uC2DD\uB2E8\xB7\uBC30\uBD84"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091572
    m_Localized: "\uC544\uB798\uB294 \uC2DD\uB2E8\uACFC\uB294 \uB530\uB85C \uCC59\uACA8 \uC8FC\uB294 \uBAAB\uC774\uB2E4. \uD55C \uC0AC\uB78C\uC5D0\uAC8C \uC885\uB958\uB9C8\uB2E4 \uD55C \uC8FC\uC5D0 \uD558\uB098. \uACE0\uB978 \uAC83\uC740 '\uBC30\uBD84\uD558\uACE0 \uC2E4\uD589'\uC744 \uB20C\uB7EC\uC57C \uB098\uAC04\uB2E4. \u2665\uB294 \uADF8 \uC0AC\uB78C\uC774 \uC88B\uC544\uD558\uB294 \uBB3C\uAC74."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091573
    m_Localized: "\uC2DD\uB7C9 {0} \xB7 \uC2DD\uC218 {1} \xB7 \uC758\uC57D\uD488 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091574
    m_Localized: "\uACC4\uD68D\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091575
    m_Localized: "\uBC30\uBD84 \uC5C6\uC774 \uC2E4\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091576
    m_Localized: "\uBC30\uBD84\uD558\uACE0 \uC2E4\uD589 ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091577
    m_Localized: "\uCC3D\uACE0\uC5D0 \uC904 \uB9CC\uD55C \uBB3C\uAC74\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091578
    m_Localized: ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091579
    m_Localized: "\uC2A4\uD2B8\uB808\uC2A4 {0} \xB7 \uD3EC\uB9CC {1} \xB7 \uC218\uBD84 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091580
    m_Localized: "\uBA39\uC744 \uAC83"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091581
    m_Localized: "\uB9C8\uC2E4 \uAC83"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091582
    m_Localized: "\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091583
    m_Localized: "\uC120\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091584
    m_Localized: "\uC2DD\uB7C9 1: \uD3EC\uB9CC\uC774 \uC624\uB974\uACE0 \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uC870\uAE08 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091585
    m_Localized: "\uC2DD\uC218 1: \uC218\uBD84\uC774 \uC624\uB974\uACE0 \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uC870\uAE08 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091586
    m_Localized: "\uC758\uC57D\uD488 1: \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uC900\uB2E4. \uB2E4\uCE5C \uC0AC\uB78C\uC740 \uBD80\uC0C1\uC774 \uD55C \uC8FC \uBE68\uB9AC \uB0AB\uACE0 \uB354 \uACE0\uB9C8\uC6CC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091587
    m_Localized: "\uC120\uBB3C: \uC88B\uC544\uD558\uB294 \uBB3C\uAC74\uC774\uBA74 \uD6E8\uC52C \uAE30\uBED0\uD55C\uB2E4. \uAC19\uC740 \uBB3C\uAC74\uC744 2\uC8FC \uC548\uC5D0 \uB610 \uC8FC\uBA74 \uD6A8\uACFC\uAC00 \uBC18."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091588
    m_Localized: "\uC9C0\uAE08 \uACC1\uC5D0 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091589
    m_Localized: "\uC774\uBC88 \uC8FC\uC5D0 \uC774\uBBF8 \uC92C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091590
    m_Localized: "\uC2DD\uB7C9\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091591
    m_Localized: "\uC2DD\uC218\uAC00 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091592
    m_Localized: "\uC758\uC57D\uD488\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091593
    m_Localized: "\uADF8 \uBB3C\uAC74\uC774 \uCC3D\uACE0\uC5D0 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091594
    m_Localized: "\uACC4\uD68D \uB2E8\uACC4\uC5D0\uC11C\uB9CC \uC904 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091595
    m_Localized: '{0}: "{1}"'
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091596
    m_Localized: "\u2026\uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091597
    m_Localized: "\uCC59\uACA8 \uC918\uC11C \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091598
    m_Localized: "\uC774\uAC70 \uB098 \uC918\uB3C4 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091599
    m_Localized: "\uC120\uC0DD\uB2D8\uC774 \uBC1B\uC544\uB3C4 \uB418\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091600
    m_Localized: "\uACE0\uB9D9\uB2E4. \uB108\uB3C4 \uAF2D \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091601
    m_Localized: "\u2026\uC774\uB7F0 \uAC83\uAE4C\uC9C0. \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091602
    m_Localized: "\uC774\uAC78 \uC5B4\uB514\uC11C \uAD6C\uD588\uB2C8? \uC544\uAEF4 \uC4F8\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091603
    m_Localized: "\uC5B4\uBA38, \uB098\uAE4C\uC9C0 \uCC59\uAE30\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091604
    m_Localized: "\uACE0\uB9C8\uC6CC. \uB108\uB294 \uB2E4\uCE5C \uB370 \uC5C6\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091605
    m_Localized: "\uB355\uBD84\uC5D0 \uC624\uB298\uC740 \uC880 \uBC84\uD2F0\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091606
    m_Localized: "\uC138\uC0C1\uC5D0, \uC774\uAC70 \uC5BC\uB9C8 \uB9CC\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091607
    m_Localized: "\uC5B4, \uC5B4. \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091608
    m_Localized: "\uB098 \uC774\uB7F0 \uAC70 \uC5C6\uC5B4\uB3C4 \uB418\uB294\uB370\u2026 \uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091609
    m_Localized: "\uC9C4\uC9DC \uB098 \uC918?"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091610
    m_Localized: "\uC640, \uC774\uAC70 \uC5B4\uB514\uC11C \uB0AC\uC5B4?!"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091611
    m_Localized: "\u2026\uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091612
    m_Localized: "\uB098 \uAC19\uC740 \uAC83\uAE4C\uC9C0 \uCC59\uACA8 \uC918\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091613
    m_Localized: "\uC798 \uBA39\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091614
    m_Localized: "\uC774\uAC70\u2026 \uAC00\uBC29\uC5D0 \uB2EC\uC544\uB3C4 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091615
    m_Localized: "\uBB50, \uBC1B\uC544\uB294 \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091616
    m_Localized: "\u2026\uACE0\uB9D9\uB2E4\uACE0 \uD574\uC57C \uD558\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091617
    m_Localized: "\uD765. \uB9C8\uCE68 \uD544\uC694\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091618
    m_Localized: "\uC774\uB7F0 \uAC70 \uC544\uC9C1 \uC788\uC5C8\uAD6C\uB098. \u2026\uACE0\uB9C8\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091619
    m_Localized: "\uACE0\uB9C8\uC6CC, \uD6C4\uBC30."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091620
    m_Localized: "\uC798 \uBC1B\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091621
    m_Localized: "\uB108\uB3C4 \uC880 \uC26C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091622
    m_Localized: "\uC774\uAC70\uBA74 \uD55C \uACE1 \uCE60 \uC218 \uC788\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091623
    m_Localized: "\u2026\uC2E0\uC138 \uC9C0\uB294\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091624
    m_Localized: "\uACE0\uB9D9\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091625
    m_Localized: "\uB2E4\uC74C\uC5D4 \uB0B4\uAC00 \uAC1A\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091626
    m_Localized: "\uD5C8. \uC774\uAC78 \uB2E4 \uAE30\uC5B5\uD588\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091627
    m_Localized: "\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091628
    m_Localized: "(\uB0C4\uC0C8\uB97C \uB9E1\uB294\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091629
    m_Localized: "(\uAF2C\uB9AC\uB97C \uD55C \uBC88 \uD754\uB4E0\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091630
    m_Localized: "\uB0D0\uC544\uC544\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091631
    m_Localized: "\uC624\uB298\uB3C4 \uBB34\uC0AC\uD788 \uC9C0\uB098\uAC00\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091632
    m_Localized: "\uD544\uC694\uD55C \uAC70 \uC788\uC73C\uBA74 \uB9D0\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091633
    m_Localized: "\uAC19\uC774 \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091634
    m_Localized: "\uC190 \uC53B\uC5C8\uB2C8? \uC0C1\uCC98\uB294 \uC791\uC744 \uB54C \uC7A1\uC544\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091635
    m_Localized: "\uC120\uC0DD\uB2D8 \uB2E4\uB9AC, \uC694\uC998\uC740 \uB0B4\uAC00 \uBD10 \uB4DC\uB9AC\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091636
    m_Localized: "\uCEE4\uD53C \uD55C \uC794\uB9CC \uC788\uC73C\uBA74 \uBC24\uB3C4 \uC0C8\uC6B8 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091637
    m_Localized: "\uB098 \uC624\uB298 \uB9DD\uBCF4\uAE30 \uC798\uD588\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091638
    m_Localized: "\uBC16\uC5D0 \uB098\uAC00\uBA74 \uB098\uB3C4 \uB370\uB824\uAC00. \uC9D0\uC740 \uB0B4\uAC00 \uB4E4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091639
    m_Localized: "\uADF8 \uB9CC\uD654 \uB2E4\uC74C \uAD8C, \uC5B4\uB518\uAC00 \uC788\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091640
    m_Localized: "\uC625\uC0C1\uC5D0\uC11C \uBCF4\uB2C8\uAE4C \uC624\uB298\uC740 \uC870\uC6A9\uD558\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091641
    m_Localized: "\uC774\uBC88\uC5D4\u2026 \uB098\uB3C4 \uADF8\uB0E5 \uBCF4\uACE0\uB9CC \uC788\uC9C4 \uC54A\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091642
    m_Localized: "\uAC00\uBC29 \uD0A4\uB9C1, \uC544\uC9C1 \uC798 \uB2EC\uB824 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091643
    m_Localized: "\uACC4\uD68D \uADF8\uB807\uAC8C \uC9DC\uBA74 \uB108\uB9CC \uACE0\uC0DD\uD574. \uC880 \uB098\uB220."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091644
    m_Localized: "\uB0B4\uAC00 \uC65C \uC5EC\uAE30 \uC788\uB294\uC9C0 \uB098\uB3C4 \uBAA8\uB974\uACA0\uB2E4. \uADFC\uB370 \uB098\uC058\uC9C4 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091645
    m_Localized: "\uBA38\uB9AC \uC880 \uC815\uB9AC\uD558\uACE0 \uC2F6\uC740\uB370. \uAC70\uC6B8 \uC5C6\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091646
    m_Localized: "\uBC29\uC1A1\uC2E4 \uC7A5\uBE44, \uC804\uAE30\uB9CC \uB4E4\uC5B4\uC624\uBA74 \uC0B4\uB9B4 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091647
    m_Localized: "\uC870\uC6A9\uD55C \uBC24\uC5D4 \uAE30\uD0C0 \uC0DD\uAC01\uC774 \uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091648
    m_Localized: "\uD6C4\uBC30, \uBB34\uB9AC\uD558\uC9C0 \uB9C8. \uC120\uBC30\uAC00 \uD558\uB294 \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091649
    m_Localized: "\uB2E4\uB9AC \uAC74\uB108 \uAE38\uC740 \uC544\uC9C1 \uB9C9\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091650
    m_Localized: "\uC624\uB798 \uBA38\uBB34\uB294 \uAC74 \uB0B4 \uCCB4\uC9C8\uC774 \uC544\uB2CC\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091651
    m_Localized: "\uC9C0\uB3C4\uC5D0 \uB610 \uD558\uB098 \uC801\uC5B4 \uB480\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091652
    m_Localized: "\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091653
    m_Localized: "(\uCC3D\uD2C0\uC5D0\uC11C \uD558\uD488\uC744 \uD55C\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091654
    m_Localized: "(\uBE48 \uADF8\uB987 \uC55E\uC5D0 \uC549\uC544 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091655
    m_Localized: "\uC774\uBC88 \uC8FC\uB294 \uBB58 \uD574 \uBCFC\uAE4C? \uB108\uB77C\uBA74 \uC798\uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091656
    m_Localized: "\uC5B4\uC81C\uB294 \uC798 \uC7A4\uB2C8? \uC5BC\uAD74\uC774 \uC880 \uB098\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091657
    m_Localized: "\uB2E4 \uAC19\uC774 \uBC84\uD2F0\uACE0 \uC788\uB2E4\uB294 \uAC70, \uC120\uC0DD\uB2D8\uC740 \uADF8\uAC8C \uC81C\uC77C \uAE30\uBED0."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091658
    m_Localized: "\uBB34\uB9AC\uD558\uC9C0 \uB9C8. \uB2E4 \uB108 \uB355\uBD84\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091659
    m_Localized: "{0}\uC640(\uACFC) \uC870\uAE08 \uB354 \uAC00\uAE4C\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091660
    m_Localized: "{0}\uC640(\uACFC) \uC870\uAE08 \uC11C\uBA39\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1063416986091661
    m_Localized: "\uACE0\uC591\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1084388040523776
    m_Localized: "\uC131\uC2E4\uD788 \uC0DD\uD65C\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518720
    m_Localized: "\uCCB4\uB825\uC774 \uC88B\uACE0 \uAFB8\uC900\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518721
    m_Localized: "\uD798\uC774 \uC88B\uC544 \uAD82\uC740\uC77C\uC744 \uB9E1\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518722
    m_Localized: "\uBAB8\uC774 \uB0A0\uB798\uACE0 \uD310\uB2E8\uC774 \uBE60\uB984."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518723
    m_Localized: "\uD559\uC2B5 \uD0DC\uB3C4\uAC00 \uC131\uC2E4\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518724
    m_Localized: "\uC190\uC7AC\uC8FC\uAC00 \uC88B\uC544 \uC218\uB9AC\uC5D0 \uB2A5\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518725
    m_Localized: "\uC5B4\uB824\uC6C0 \uC18D\uC5D0\uC11C\uB3C4 \uB048\uAE30\uAC00 \uC788\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518726
    m_Localized: "\uC8FC\uBCC0\uC744 \uC798 \uC0B4\uD54C."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518727
    m_Localized: "\uC55E\uC7A5\uC11C\uB294 \uD0DC\uB3C4\uAC00 \uBCF4\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518728
    m_Localized: "\uC694\uC998 \uB9CE\uC774 \uCEF8\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uB2E4 \uBCF4\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518729
    m_Localized: "\uB124\uAC00 \uC6B0\uB9AC \uBC18\uC774\uB77C\uC11C \uB2E4\uD589\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1084388191518730
    m_Localized: "\uC878\uC5C5\uC2DD \uB0A0, \uC774 \uB9D0\uC744 \uAF2D \uC9C1\uC811 \uD574 \uC8FC\uACE0 \uC2F6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1091013577031680
    m_Localized: "\uBD84\uC704\uAE30 \uBA54\uC774\uCEE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1091013732220928
    m_Localized: "\uC815\uCC30"
    m_Metadata:
      m_Items: []
  - m_Id: 1091013732220929
    m_Localized: "\uC815\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 1091013732220930
    m_Localized: "\uD734\uC2DD \uD68C\uBCF5 +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 1091013732220931
    m_Localized: "\uC625\uC0C1\xB7\uBC29\uC1A1\uC2E4. \uD0D0\uD5D8 \uC2A4\uD2B8\uB808\uC2A4 \u221210%, \uC218\uC0C9 \uC18D\uB3C4 +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 1091013732220932
    m_Localized: "\uACF5\uD559 \uD310\uC815 \uC131\uACF5\uB960 +8%"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519496396800
    m_Localized: "\uC0B4\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780352
    m_Localized: "\uACF5\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780353
    m_Localized: "\uC704\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780354
    m_Localized: "\uAC00\uC0AC\uC2E4\xB7\uAE09\uC2DD\uC2E4 (\uAC00\uC0AC\uC2E4\uC744 \uB4A4\uC838\uC57C \uB9E1\uAE38 \uC218 \uC788\uB2E4). \uC774\uD2C0\uC5D0 \uD55C \uBC88 \uC2DD\uB7C9 1 \uC808\uC57D, \uC544\uCE68\uB9C8\uB2E4 \uBE57\uBB3C\uC744 \uC870\uAE08 \uAC70\uB974\uACE0 \uD143\uBC2D\xB7\uBE44\uB2D0\uD558\uC6B0\uC2A4\uB97C \uAC70\uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780355
    m_Localized: "\uAD50\uC2E4\xB7\uB3C4\uC11C\uC2E4\xB7\uACFC\uD559\uC2E4. \uAD50\uC721 \uC131\uC7A5 +8%"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780356
    m_Localized: "\uC74C\uC545\uC2E4\xB7\uCCB4\uC721\uAD00. \uD734\uC2DD \uD68C\uBCF5 +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780357
    m_Localized: "\uC790\uB9AC\uAC00 \uAF49 \uCC28 \uAC70\uB4E4\uAE30\uB9CC \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780358
    m_Localized: "\uB9E1\uC740 \uC77C\uC744 \uD560 \uBC29\uC774 \uC544\uC9C1 \uC5C6\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780359
    m_Localized: "\uBCF4\uAC74\uC2E4\uC774 \uD3B8\uD574 \uBCF4\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780360
    m_Localized: "\uB192\uC740 \uB370\uC11C \uBA40\uB9AC \uBCF4\uB294 \uAC78 \uC88B\uC544\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780361
    m_Localized: "\uB204\uAD70\uAC00 \uACC1\uC5D0 \uC788\uC5B4 \uC8FC\uB294 \uC77C\uC774 \uC798 \uB9DE\uB294 \uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780362
    m_Localized: "\uC870\uC6A9\uD55C \uBC29\uC5D0\uC11C \uCC45\uC7A5\uC744 \uB118\uAE30\uB294 \uC18C\uB9AC\uAC00 \uD3B8\uD574 \uBCF4\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780363
    m_Localized: "\uC190\uC774 \uBE60\uB974\uB2E4. \uB9D0\uC5C6\uC774 \uC77C\uC744 \uB05D\uB0B4 \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780364
    m_Localized: "\uC774 \uB3D9\uB124 \uAE38\uC744 \uC798 \uC548\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780365
    m_Localized: "\uBB38 \uC55E\uC5D0 \uC11C \uC788\uC73C\uBA74 \uB4E0\uB4E0\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1109519655780366
    m_Localized: "\uAE30\uD0C0\uB97C \uB9CC\uC9C0\uC791\uAC70\uB9B4 \uB54C \uD45C\uC815\uC774 \uD480\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1116635040858112
    m_Localized: "\uC625\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651112103936
    m_Localized: "\uB2E4\uCE5C \uC0AC\uB78C\uC744 \uC81C\uB300\uB85C \uB215\uD790 \uACF3\uC774 \uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018496
    m_Localized: "\uC5B4\uB514 \uC870\uC6A9\uD55C \uB370\uAC00 \uC5C6\uC744\uAE4C \uD558\uACE0 \uC911\uC5BC\uAC70\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018497
    m_Localized: "\uB2E4\uCE5C \uC0AC\uB78C\uC744 \uC81C\uB300\uB85C \uB215\uD790 \uB370\uAC00 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018498
    m_Localized: "\u2026\uC5B4\uB514 \uC870\uC6A9\uD55C \uB370 \uC5C6\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018499
    m_Localized: "{0} \uD568\uAED8 \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018500
    m_Localized: "\uAC19\uC774 \uD558\uB2C8\uAE4C \uB35C \uD798\uB4DC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018501
    m_Localized: "\uC624\uB298\uC740 \uC880 \uC624\uB798 \uAC19\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018502
    m_Localized: "(\uB9D0\uC5C6\uC774 \uC606\uC790\uB9AC\uB97C \uB0B4\uC900\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018503
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uB530\uB77C\uC628 \uAC70, \uC798\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018504
    m_Localized: "\uC9C8\uBB38 \uC788\uC73C\uBA74 \uC544\uBB34 \uB54C\uB098 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018505
    m_Localized: "\uAC00\uB974\uCE58\uB294 \uAC8C \uC544\uC9C1\uB3C4 \uC990\uAC81\uB124. \uB2E4\uD589\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018506
    m_Localized: "\uBD95\uB300\uB294 \uC774\uB807\uAC8C \uAC10\uB294 \uAC70\uC57C. \uCC9C\uCC9C\uD788."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018507
    m_Localized: "\uC190\uC774 \uB9CE\uC774 \uB298\uC5C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018508
    m_Localized: "\uAC19\uC774 \uC788\uC73C\uB2C8\uAE4C \uB9C8\uC74C\uC774 \uC880 \uB193\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018509
    m_Localized: "\uC774 \uB0C4\uC0C8, \uC2EB\uC9C0 \uC54A\uC544. \uC77C\uD558\uB358 \uB370 \uAC19\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018510
    m_Localized: "\uB2E4\uCE5C \uC0AC\uB78C \uC0DD\uAE30\uBA74 \uBC14\uB85C \uBD88\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018511
    m_Localized: "\uB098\uB3C4 \uB3C4\uC6B8\uB798! \uBB50 \uD558\uBA74 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018512
    m_Localized: "\uAC19\uC774 \uD558\uB2C8\uAE4C \uD558\uB098\uB3C4 \uC548 \uBB34\uC11C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018513
    m_Localized: "\uC774\uAC70 \uB2E4 \uD558\uBA74 \uB098 \uCE6D\uCC2C\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018514
    m_Localized: "\uC800\uAE30 \uBD10, \uC800 \uBA40\uB9AC \uC9C0\uBD95 \uC704\uC5D0 \uC0C8 \uC788\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018515
    m_Localized: "\uB192\uC740 \uB370 \uC788\uC73C\uBA74 \uB2E4 \uBCF4\uC5EC. \uB0B4\uAC00 \uB9DD \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018516
    m_Localized: "\u2026\uC5EC\uAE30 \uC788\uC5B4\uB3C4 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018517
    m_Localized: "(\uC870\uC6A9\uD788 \uC606\uC5D0 \uC549\uB294\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018518
    m_Localized: "\uAC19\uC774 \uC788\uC73C\uB2C8\uAE4C \uC880 \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018519
    m_Localized: "\uC18C\uB9AC \uB0B4\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB294 \uACF3, \uC88B\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018520
    m_Localized: "\u2026\uB098, \uC5EC\uAE30 \uC788\uB294 \uAC8C \uC88B\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018521
    m_Localized: "\u2026\uB098\uB294 \uB0B4 \uD560 \uC77C\uB9CC \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018522
    m_Localized: "\uAC70\uAE30 \uB46C. \uB0B4\uAC00 \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018523
    m_Localized: "\uB531\uD788 \uB108 \uB54C\uBB38\uC5D0 \uD558\uB294 \uAC74 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018524
    m_Localized: "\uC774 \uC815\uB3C4\uB294 \uAE08\uBC29 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018525
    m_Localized: "\uC190\uC744 \uB180\uB9AC\uB294 \uAC8C \uCC28\uB77C\uB9AC \uD3B8\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018526
    m_Localized: "\uD6C4\uBC30, \uC190 \uC880 \uBE4C\uB824\uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018527
    m_Localized: "\uB458\uC774 \uD558\uB2C8\uAE4C \uAE08\uBC29 \uB05D\uB098\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018528
    m_Localized: "\uC26C\uC5C4\uC26C\uC5C4 \uD574. \uC544\uC9C1 \uAE38\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018529
    m_Localized: "\uC5EC\uAE34 \uB0B4\uAC00 \uC9C0\uD0AC\uAC8C. \uAC71\uC815 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018530
    m_Localized: "\uD55C \uACE1 \uB4E4\uC744\uB798? \uC9E7\uC740 \uAC70."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018531
    m_Localized: "\u2026\uAC70\uB4E4\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018532
    m_Localized: "\uC190\uC774 \uBE60\uB974\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018533
    m_Localized: "\uC774\uB7F0 \uAC83\uB3C4 \uC624\uB79C\uB9CC\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018534
    m_Localized: "\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018535
    m_Localized: "(\uBC1C\uCE58\uC5D0\uC11C \uBAB8\uC744 \uB9CC\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1120651175018536
    m_Localized: "(\uAF2C\uB9AC\uB85C \uB2E4\uB9AC\uB97C \uD22D \uCE5C\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894502707200
    m_Localized: "{0} \uD0D0\uD5D8\uC744 \uB098\uAC00 \uC790\uB9AC\uC5D0 \uC5C6\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787584
    m_Localized: "{0} \uBC16\uC5D0 \uB098\uAC14\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787585
    m_Localized: "{0} \uB3CC\uC544\uC654\uB2E4: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787586
    m_Localized: "{0} \uBE48\uC190\uC73C\uB85C \uB3CC\uC544\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787587
    m_Localized: "\uAC00\uBCBC\uC6B4 \uC0C1\uCC98"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787588
    m_Localized: "\uB2E4\uCCD0\uC11C \uB3CC\uC544\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787589
    m_Localized: "{0} \uAD6C\uD574 \uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787590
    m_Localized: "\uC624\uB298\uC740 \uD5C8\uD0D5\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787591
    m_Localized: "\uC774\uAC83 \uBD10, {0}. \uB0B4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787592
    m_Localized: "{0}\uD55C\uD14C \uC8FC\uB824\uACE0 {1} \uC8FC\uC6E0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787593
    m_Localized: "\uB3D9\uB8CC {0}\uBA85\uC774 \uAD6C\uD574 \uC628 \uAC83: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1122894590787594
    m_Localized: "\uBE48\uC190"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577001619456
    m_Localized: "\uAC00\uBCBC\uC6B4 \uC0C1\uCC98 (\uC774\uBC88 \uC8FC\uB294 \uBC16\uC5D0 \uB098\uAC00\uC9C0 \uC54A\uB294\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699840
    m_Localized: "{0} \uC774\uBC88 \uC8FC \uBC16\uC5D0 \uB098\uAC00 \uBCF4\uACE0 \uC2F6\uC5B4 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699841
    m_Localized: "{0} \uC774\uBC88 \uC8FC\uB294 \uAC70\uC810\uC5D0 \uB0A8\uAE30\uB85C \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699842
    m_Localized: "\uB450 \uC8FC \uB0B4\uB9AC \uBD99\uC7A1\uC73C\uBA74 \uB2F5\uB2F5\uD574\uD560 \uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699843
    m_Localized: "\uC9C0\uAE08 \uBC16\uC5D0 \uB098\uAC00 \uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699844
    m_Localized: "\uC774\uBC88 \uC8FC\uB294 \uB0A8\uC544 \uC918"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699845
    m_Localized: "\uC5ED\uC2DC \uB2E4\uB140\uC640\uB3C4 \uB3FC"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699846
    m_Localized: "\xB7 \uC678\uCD9C"
    m_Metadata:
      m_Items: []
  - m_Id: 1124577089699847
    m_Localized: "\uC774\uBC88 \uC8FC \uC678\uCD9C\uD558\uB294 \uB3D9\uB8CC\uAC00 \uC788\uC73C\uBA74 \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246046744576
    m_Localized: "\uD2B9\uAE30 \xB7 {0}: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659136
    m_Localized: "\uD2B9\uAE30 \xB7 {0}: \uB9C8\uC74C\uC774 \uBA40\uC5B4\uC838 \uC7A0\uC2DC \uAEBC\uC838 \uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659137
    m_Localized: "\uC544\uAEF4 \uC4F0\uB294 \uC190"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659138
    m_Localized: "\uCE58\uB8CC\uC5D0 \uC4F0\uB294 \uC758\uC57D\uD488\uC774 \uD558\uB098 \uB35C \uB4E0\uB2E4 (2\uAC1C \uC774\uC0C1 \uB4DC\uB294 \uCE58\uB8CC)"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659139
    m_Localized: "\uBC24\uB208"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659140
    m_Localized: "\uBC24 \uC2B5\uACA9\uC5D0 \uB6AB\uB824\uB3C4 \uD53C\uD574\uAC00 \uC870\uAE08 \uC904\uC5B4\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659141
    m_Localized: "\uACC1\uC5D0 \uC788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659142
    m_Localized: "\uD55C \uC8FC\uAC00 \uB05D\uB0A0 \uB54C \uB9C8\uC74C\uC774 \uC870\uAE08 \uAC00\uB77C\uC549\uB294\uB2E4 (\uC2A4\uD2B8\uB808\uC2A4 \u22123)"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659143
    m_Localized: "\uB3D9\uB124 \uC0AC\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659144
    m_Localized: "\uC0AC\uAC70\uB9AC \uD30C\uC5D0 \uBC14\uCE58\uB294 \uBAAB\uC774 \uC904\uC5B4\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659145
    m_Localized: "\uB4E0\uB4E0\uD55C \uB4F1"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659146
    m_Localized: "\uC2B5\uACA9\uACFC \uCE68\uC785\uC744 \uB9C9\uC744 \uB54C \uBC29\uC5B4\uB3C4 +10"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659147
    m_Localized: "\uBE60\uC838\uB098\uAC00\uB294 \uAE38"
    m_Metadata:
      m_Items: []
  - m_Id: 1134246109659148
    m_Localized: "\uAE4A\uC740 \uACF3\uC5D0\uC11C \uBE60\uC838\uB098\uAC00\uB294 \uAE38\uC744 \uBBF8\uB9AC \uC548\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1151196416196608
    m_Localized: "{0}, \uB098 \uB300\uC2E0 \uB2E4\uCCE4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1151196470722560
    m_Localized: "{0}, \uB9D0\uC218\uAC00 \uC904\uC5C8\uB2E4. \uC9D0\uC744 \uAFB8\uB9AC\uB294 \uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1151196470722561
    m_Localized: "{0}, \uC55E\uC744 \uB9C9\uC544\uC11C\uB2E4 \uB2E4\uCCE4\uB2E4. \uB450 \uC8FC \uB3D9\uC548 \uB9E1\uC740 \uC77C\uC744 \uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676855615488
    m_Localized: "\uB3C4\uD604\uC740 \uC5B4\uBA38\uB2C8\uB97C \uCC3E\uB294 \uB3D9\uC548\uC5D0\uB3C4 \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88 \uD3B8\uC9C0\uB97C \uBCF4\uB0C8\uB2E4. \uB9E8 \uB05D\uC5D0\uB294 \uB298 \uC791\uC740 \uB3D9\uADF8\uB77C\uBBF8\uC640 \uC138\uBAA8\uAC00 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4. \uB204\uB098\uB9CC \uC544\uB294 \uD45C\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112960
    m_Localized: "\uB3C4\uD604\uC740 \uAD6C\uC870 \uB4A4 \uB2E4\uB978 \uB300\uD53C\uC18C\uB85C \uC62E\uACA8 \uAC14\uB2E4. \uC5F0\uB77D\uC740 \uB738\uD588\uB2E4. \uC5B4\uBA38\uB2C8\uB97C \uACC4\uC18D \uCC3E\uACE0 \uC788\uB2E4\uB294 \uC18C\uC2DD\uB9CC, \uB204\uAD70\uAC00\uB97C \uD1B5\uD574 \uC804\uD574 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112961
    m_Localized: "\uD559\uAD50\uB97C \uB5A0\uB09C \uB3C4\uD604\uC758 \uC18C\uC2DD\uC740 \uB05D\uB0B4 \uB4E3\uC9C0 \uBABB\uD588\uB2E4. \uAD50\uBB38 \uCC3D\uC0B4\uC758 \uD30C\uB780 \uB9AC\uBCF8\uB9CC\uC774 \uAD6C\uC870 \uB0A0\uAE4C\uC9C0 \uBC14\uB78C\uC5D0 \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112962
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uC9C4\uB8CC\uC18C \uBB38 \uC606\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC801\uC5B4 \uB450\uC5C8\uB2E4. '\uACAC\uC2B5'. \uD68C\uC9C4 \uD45C\uC758 \uC544\uCE68 \uD55C \uC904\uC740 \uC544\uC9C1\uB3C4 \uB0B4 \uAE00\uC528\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112963
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC740 \uB2E4\uB978 \uB3C4\uC2DC\uC758 \uC9C4\uB8CC\uC18C\uB85C \uAC14\uB2E4. \uC9E7\uC740 \uC5FD\uC11C\uAC00 \uD55C \uBC88 \uC654\uB2E4. \uC57D\uC740 \uC544\uAEF4 \uC4F0\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112964
    m_Localized: "\uBC15 \uC120\uC0DD\uB2D8\uC774 \uB0A8\uAE30\uACE0 \uAC04 \uC57D \uC0C1\uC790 \uBC18\uC740 \uB9C8\uC9C0\uB9C9 \uC8FC\uAE4C\uC9C0 \uC6B0\uB9AC\uB97C \uBC84\uD2F0\uAC8C \uD588\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uB538\uC744 \uCC3E\uC558\uAE30\uB97C, \uC9C0\uAE08\uB3C4 \uBC14\uB780\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112965
    m_Localized: "\uC1A1\uC608\uC9C0\uC758 \uCCAB \uC804\uC2DC\uD68C \uBCBD\uC5D0\uB294 \uC5BC\uAD74 \uC5C6\uB294 \uADF8\uB9BC\uC774 \uD55C \uC7A5 \uAC78\uB838\uB2E4. \uB2F4\uC694\uB97C \uB36E\uACE0 \uB098\uB780\uD788 \uB204\uC6B4 \uC0AC\uB78C\uB4E4. \uC81C\uBAA9\uC740 '\uADF8 \uAD50\uC2E4'."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112966
    m_Localized: "\uC1A1\uC608\uC9C0\uC640\uB294 \uAD6C\uC870 \uB4A4 \uC5F0\uB77D\uC774 \uB04A\uACBC\uB2E4. \uAC00\uB054 \uBBF8\uC220\uAD00 \uC55E\uC744 \uC9C0\uB098\uBA74 \uADF8 \uC560 \uC774\uB984\uC744 \uCC3E\uC544\uBCF4\uAC8C \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112967
    m_Localized: "\uB3C4\uC11C\uC2E4 \uCC45\uC0C1 \uC704\uC5D0 \uB0A8\uC740 \uC608\uC9C0\uC758 \uC9C0\uB3C4\uB294 \uD0D0\uD5D8 \uB54C\uB9C8\uB2E4 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uACE0 \uB2E4\uB154\uB2E4. \uAE38\uC774 \uD558\uB098\uB3C4 \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112968
    m_Localized: "\uCD5C\uD558\uB9B0\uC740 \uAD6C\uC870 \uB4A4\uC5D0\uB3C4 \uAC00\uB054 \uC5F0\uB77D\uC744 \uD574 \uC654\uB2E4. \uC0AC\uACFC\uB294 \uB354 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uB300\uC2E0 \uC548\uBD80\uB97C \uBB3C\uC5C8\uB2E4. \uADF8\uAC8C \uB354 \uC5B4\uB824\uC6B4 \uC77C\uC774\uB77C\uB294 \uAC78, \uB458 \uB2E4 \uC54C\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112969
    m_Localized: "\uCD5C\uD558\uB9B0\uACFC\uB294 \uAD6C\uC870 \uB4A4 \uD55C \uBC88\uB3C4 \uB9C8\uC8FC\uCE58\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uC77C\uC740 \uADF8 \uC77C\uB300\uB85C, \uAC01\uC790\uC758 \uC790\uB9AC\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112970
    m_Localized: "\uD558\uB9B0\uC740 \uADF8\uB0A0 \uAD50\uBB38\uC744 \uB098\uC11C\uACE0 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4. \uB9C8\uD2B8 \uCABD \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uADF8 \uC560\uB97C \uBD24\uB2E4\uB294 \uB9D0\uC774 \uB4E4\uB838\uB2E4. \uC0B4\uC544 \uC788\uC5C8\uB2E4. \uADF8\uAC70\uBA74 \uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112971
    m_Localized: "\uC120\uBC30\uB294 \uB300\uD53C\uC18C\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uC0AC\uB78C\uB4E4 \uC55E\uC5D0\uC11C \uAE30\uD0C0\uB97C \uCCE4\uB2E4. \uC785\uC740 \uB2E4\uBB38 \uCC44\uB85C. \uB9E8 \uC55E\uC790\uB9AC\uB294 \uB298 \uBE44\uC6CC \uB450\uC5C8\uB2E4. \uB204\uAD6C \uC790\uB9AC\uC778\uC9C0\uB294 \uC544\uBB34\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112972
    m_Localized: "\uC120\uBC30\uB294 \uB2E4\uB978 \uB300\uD53C\uC18C\uB85C \uC62E\uACA8 \uAC04 \uB4A4\uB85C \uC18C\uC2DD\uC774 \uC5C6\uC5C8\uB2E4. \uB9E1\uAE34 \uC77C\uC774 \uC788\uB2E4\uBA74, \uC5B4\uB514\uC11C\uB4E0 \uB9D0\uC5C6\uC774 \uD574\uB0B4\uACE0 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112973
    m_Localized: "\uC120\uBC30\uAC00 \uBC15\uC544 \uB454 \uD310\uC790\uB294 \uAD6C\uC870 \uB0A0 \uC544\uCE68\uAE4C\uC9C0 \uD604\uAD00\uC744 \uC9C0\uCF30\uB2E4. \uC120\uBC30\uB294 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uC9C0\uB9CC, \uADF8 \uD310\uC790\uB294 \uB05D\uAE4C\uC9C0 \uBE60\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112974
    m_Localized: "\uBC31\uC758 \uB098\uCE68\uBC18\uC740 \uC9C0\uAE08\uB3C4 \uCC45\uC0C1 \uC11C\uB78D\uC5D0 \uC788\uB2E4. \uB0A8\uCABD \uC5B4\uB290 \uB300\uD53C\uC18C\uC5D0\uC11C \uB204\uAD70\uAC00 '\uBC31 \uC544\uC800\uC528'\uB97C \uD06C\uAC8C \uBD80\uB974\uB294 \uC18C\uB9AC\uB97C \uB4E4\uC5C8\uB2E4\uB294 \uB9D0\uC774 \uB3CC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1155676931112975
    m_Localized: "\uC878\uC5C5\uC7A5\uC740 \uD559\uAD50\uC7A5 \uC9C1\uC778 \uC5C6\uC774, \uB2F4\uC784 \uB3C4\uC7A5\uB9CC \uCC0D\uD600 \uC788\uC5C8\uB2E4. \uC724 \uC120\uC0DD\uB2D8\uC774 \uC0C8\uBCBD\uB9C8\uB2E4 \uBD93\uD39C\uC73C\uB85C \uC4F4 \uADF8 \uC885\uC774\uB294 \uC9C0\uAE08\uB3C4 \uC561\uC790 \uC548\uC5D0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409490145280
    m_Localized: "\uC74C\uC545\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059840
    m_Localized: "\uC74C\uC545\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059841
    m_Localized: "{0} / {1} \uACE1"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059842
    m_Localized: '? ? ?'
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059843
    m_Localized: "\uC544\uC9C1 \uB4E4\uC740 \uACE1\uC774 \uC5C6\uC5B4\uC694. \uD0D0\uD5D8\uC5D0\uC11C CD\uB97C \uCC3E\uC544 \uBC29\uC1A1\uBC18 \uCF58\uC194\uC5D0\uC11C \uD2C0\uC5B4 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059844
    m_Localized: "\uB4E3\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059845
    m_Localized: "\uBA48\uCD94\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059846
    m_Localized: "\uC74C\uC6D0 \uC900\uBE44 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059847
    m_Localized: "\uB3CC\uC544\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059848
    m_Localized: "CD \uC9C4\uC5F4\uC7A5 {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059849
    m_Localized: "CD \uD50C\uB808\uC774\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059850
    m_Localized: "\uBC29\uC1A1\uBC18 CD \uD50C\uB808\uC774\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059851
    m_Localized: "\uAC74\uC804\uC9C0\uB85C \uB3C4\uB294 \uD734\uB300\uC6A9 \uD50C\uB808\uC774\uC5B4. \uACE0\uB978 \uACE1\uC740 \uD0D0\uD5D8\uC744 \uB5A0\uB098\uAE30 \uC804\uAE4C\uC9C0 \uD750\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059852
    m_Localized: "\uC544\uC9C1 CD\uAC00 \uC5C6\uB2E4. \uD0D0\uD5D8\uD558\uB2E4 \uBCF4\uBA74 \uB204\uAD70\uAC00 \uB450\uACE0 \uAC04 CD\uAC00 \uC788\uC744\uC9C0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059853
    m_Localized: "\uD2C0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059854
    m_Localized: "\uC7AC\uC0DD \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059855
    m_Localized: "\uB044\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059856
    m_Localized: "{0}\uC8FC\uCC28\uC5D0 \uCC3E\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059857
    m_Localized: "\uBE48 \uCE78"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059858
    m_Localized: "CD\uB97C \uD55C \uC7A5 \uCC59\uACBC\uB2E4 \u2014 \u300C{0}\u300D"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059859
    m_Localized: "\uCC59\uAE34\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059860
    m_Localized: "\uADF8\uB300\uB85C \uB454\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059861
    m_Localized: "\uBD04, \uAD50\uC815\uC5D0\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059862
    m_Localized: "3\uD559\uB144 \uBC29\uC1A1\uBC18 \uC120\uBC30 \xB7 \uCF00\uC774\uC2A4\uC5D0 \"\uC878\uC5C5 \uBC29\uC1A1\uC6A9\""
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059863
    m_Localized: "\uC74C\uC545\uC2E4 \uD53C\uC544\uB178 \uC758\uC790 \uB69C\uAED1 \uC18D, \uC545\uBCF4 \uC0AC\uC774\uC5D0 CD \uD55C \uC7A5. \uCF00\uC774\uC2A4\uC5D0 \uB9E4\uC9C1\uC73C\uB85C \"\uC878\uC5C5 \uBC29\uC1A1\uC6A9 \u2014 \uD2C0\uAE30 \uC804\uC5D0 \uBCFC\uB968 \uBA3C\uC800 \uC904\uC774\uAE30!\". \uC878\uC5C5\uC2DD, \uD588\uC5B4\uC57C \uD588\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059864
    m_Localized: "\uC0C8\uBCBD 2\uC2DC \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059865
    m_Localized: "\uC57C\uAC04 \uC54C\uBC14\uC0DD \xB7 \uC190\uAE00\uC528 \uACE1 \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059866
    m_Localized: "\uACC4\uC0B0\uB300 \uBC11 \uBD84\uC2E4\uBB3C \uC0C1\uC790. \uC6B0\uC0B0, \uC7A5\uAC11, \uADF8\uB9AC\uACE0 CD \uD55C \uC7A5. \uACE1 \uBAA9\uB85D \uB9E8 \uC544\uB798\uC5D0 \uC791\uC740 \uAE00\uC528\uB85C \"\uC190\uB2D8 \uC5C6\uC744 \uB54C\uB9CC\". \uD615\uAD11\uB4F1 \uC544\uB798 \uD63C\uC790 \uB4E3\uB358 \uB178\uB798\uC600\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059867
    m_Localized: "\uC5C4\uB9C8 \uAC00\uAC8C\uC5D0\uC11C \uD2C0 \uAC83"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059868
    m_Localized: "\uC57D\uC0AC\uC758 \uB538 \xB7 \uD558\uD2B8 \uC2A4\uD2F0\uCEE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059869
    m_Localized: "\uB300\uAE30\uC2E4 \uC7A1\uC9C0\uAF42\uC774 \uB4A4\uC5D0 \uB07C\uC5B4 \uC788\uB358 CD. \uD558\uD2B8 \uC2A4\uD2F0\uCEE4 \uC606\uC5D0 \uB3D9\uAE00\uB3D9\uAE00\uD55C \uAE00\uC528\uB85C \"\uC5C4\uB9C8 \uAC00\uAC8C\uC5D0\uC11C \uD2C0 \uAC83! \uC190\uB2D8\uB4E4 \uAE30\uBD84 \uC88B\uC544\uC9C0\uB77C\uACE0\". \uC57D\uC0AC \uC120\uC0DD\uB2D8\uC740 \uC774\uAC78 \uD2C0\uC5B4 \uC92C\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059870
    m_Localized: "\uC625\uD0D1 \uD569\uC8FC\uC2E4 \uB370\uBAA8"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059871
    m_Localized: "\uBC34\uB4DC \uD558\uB358 \uB300\uD559\uC0DD \xB7 \uC9C1\uC811 \uC4F4 \uC81C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059872
    m_Localized: "\uAD00\uB9AC\uC2E4 \uAE08\uACE0 \uC606 \uAD6C\uC11D, \uBA3C\uC9C0 \uC313\uC778 \uBC34\uB4DC \uC7A5\uBE44 \uCF00\uC774\uC2A4 \uC704\uC5D0 \uACF5CD \uD55C \uC7A5. \uB124\uC784\uD39C\uC73C\uB85C \"\uB370\uBAA8 3\uBC88 \u2014 \uC774\uBC88\uC5D4 \uC9C4\uC9DC \uBCF4\uCEEC \uC548 \uD2C0\uB9BC\". \uB204\uAD70\uAC00\uC758 \uCCAB \uC568\uBC94\uC774\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059873
    m_Localized: "\uC6D4\uC694\uC77C \uBC84\uD2F0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059874
    m_Localized: "\uCD9C\uD1F4\uADFC\uD558\uB358 \uD68C\uC0AC\uC6D0 \xB7 \uC0AC\uC6D0\uC99D \uB048\uC774 \uAC10\uAE34 \uCF00\uC774\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059875
    m_Localized: "\uBE44\uC0C1 \uB300\uD53C \uCC3D\uACE0 \uC0AC\uBB3C\uD568 \uC704, \uC0AC\uC6D0\uC99D \uB048\uC774 \uCE6D\uCE6D \uAC10\uAE34 CD. \uCF00\uC774\uC2A4 \uC548\uCABD \uCABD\uC9C0\uC5D0 \"\uC6D4\uC694\uC77C \uBC84\uD2F0\uAE30. 2\uD638\uC120 \uD658\uC2B9\uAE4C\uC9C0 \uB531 4\uACE1\". \uADF8 \uC0AC\uB78C\uC758 \uC6D4\uC694\uC77C\uC740 \uC5B4\uB5BB\uAC8C \uB410\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059876
    m_Localized: "\uB9E4\uC7A5 \uC74C\uC545 Vol.3"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059877
    m_Localized: "\uB9C8\uD2B8 \uB9E4\uC7A5 \uBC29\uC1A1 \xB7 \uC5C5\uBB34\uC6A9 \uC2A4\uD0EC\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059878
    m_Localized: "\uB0C9\uB3D9 \uCC3D\uACE0 \uC548\uCABD \uC120\uBC18, \uC1A1\uC7A5 \uB354\uBBF8 \uBC11\uC5D0 CD \uD55C \uC7A5. \"\uB9E4\uC7A5 \uC74C\uC545 Vol.3 \u2014 \uC624\uD6C4 2\uC2DC~5\uC2DC\" \uB3C4\uC7A5\uC774 \uBE44\uB6A4\uAC8C \uCC0D\uD600 \uC788\uB2E4. \uC774\uB807\uAC8C \uBC1D\uC740 \uB178\uB798\uAC00 \uC544\uC9C1 \uC788\uC5C8\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059879
    m_Localized: "\uAD50\uB300 \uB05D\uB098\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059880
    m_Localized: "\uC80A\uC740 \uC21C\uACBD \xB7 \uC219\uC9C1 \uC77C\uC9C0 \uC0AC\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059881
    m_Localized: "\uC9C0\uD558 \uBCF4\uD638\uC2E4 \uC0AC\uBB3C\uD568, \uC219\uC9C1 \uC77C\uC9C0 \uC0AC\uC774\uC5D0 \uB07C\uC6B4 CD. \uD45C\uC9C0\uC5D0 \uBCFC\uD39C\uC73C\uB85C \"\uAD50\uB300 \uB05D\uB098\uBA74 \uB4E3\uAE30\". \uC77C\uC9C0\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5\uC740 \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059882
    m_Localized: "\uC544\uBE60 \uD798\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059883
    m_Localized: "\uC5F0\uAD6C\uC6D0 \xB7 \uC544\uC774\uAC00 \uADF8\uB9B0 \uADF8\uB9BC \uC2A4\uD2F0\uCEE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1160409553059884
    m_Localized: "\uC57D\uD488 \uC800\uC7A5\uACE0 \uC548 \uC5F0\uAD6C\uC6D0 \uCC45\uC0C1 \uC11C\uB78D\uC5D0 \uB3D9\uC694 CD \uD55C \uC7A5. \uD06C\uB808\uD30C\uC2A4\uB85C \uADF8\uB9B0 \uD574\uB2D8 \uC2A4\uD2F0\uCEE4 \uC606\uC5D0 \uC090\uB6A4\uBE7C\uB6A4\uD55C \uAE00\uC528\uB85C \"\uC544\uBE60 \uD798\uB0B4\". \uC11C\uB78D\uC744 \uD55C\uCC38 \uC5F4\uC5B4 \uB454 \uCC44\uB85C \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1166621279535104
    m_Localized: "\uC6B0\uD074\uB9AD: \uB179\uC2A8 \uBC29\uD654\uBB38 \u2014 \uCC28\uAC00\uC6B4 \uBC14\uB78C\uC774 \uC0C8\uC5B4 \uB098\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643968
    m_Localized: "\uC6B0\uD074\uB9AD: \uBC29\uD654\uBB38\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30 (\uAC74\uBB3C \uC548)"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643969
    m_Localized: "\uC6B0\uD074\uB9AD: \uBE44\uC0C1\uAD6C\uB85C \uB098\uAC00\uAE30 (\uB2E4\uC2DC \uB4E4\uC5B4\uC62C \uC218 \uC5C6\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643970
    m_Localized: "\uC190\uC7A1\uC774 \uC5C6\uB294 \uCCA0\uBB38 (\uC548\uC5D0\uC11C\uB9CC \uC5F4\uB9B0\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643971
    m_Localized: "\uC6B0\uD074\uB9AD: \uACC4\uB2E8 \uB0B4\uB824\uAC00\uAE30 (\uC9C0\uD558 {0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643972
    m_Localized: "\uC6B0\uD074\uB9AD: \uACC4\uB2E8 \uC62C\uB77C\uAC00\uAE30 (\uC9C0\uD558 {0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643973
    m_Localized: "\uC190\uC7A1\uC774\uAC00 \uC5C6\uB2E4. \uC548\uC5D0\uC11C\uB9CC \uC5F4\uB9AC\uB294 \uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643974
    m_Localized: "\uB098\uAC00\uBA74 \uC774 \uBB38\uC740 \uB4F1 \uB4A4\uC5D0\uC11C \uC7A0\uAE34\uB2E4. \uC815\uB9D0 \uB098\uAC08\uAE4C? (\uD55C \uBC88 \uB354 \uB204\uB974\uAE30)"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643975
    m_Localized: "\uCCA0\uCEE5. \uBB38\uC774 \uB4F1 \uB4A4\uC5D0\uC11C \uC7A0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643976
    m_Localized: "\uACF5\uAE30\uAC00 \uCC28\uAC11\uB2E4. \uC18C\uB9AC\uAC00 \uC6B8\uB9B0\uB2E4. \uB4E4\uC5B4\uC628 \uBB38\uC744 \uC78A\uC9C0 \uB9D0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643977
    m_Localized: "\uC720\uB791\uC790\uAC00 \uB9D0\uD588\uC5C8\uB2E4. \uC774\uB7F0 \uB370\uB294 \uC9C0\uD558 {0} {1} \uB05D\uC5D0 \uBE44\uC0C1\uAD6C\uAC00 \uC788\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643978
    m_Localized: "\uC11C\uCABD"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643979
    m_Localized: "\uB3D9\uCABD"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643980
    m_Localized: "\uC9C0\uD558 {0} \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643981
    m_Localized: "\uBE4C\uB77C \uC9C0\uD558 \uC8FC\uCC28\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643982
    m_Localized: "\uC5ED\uBB34 \uAD6C\uC5ED\xB7\uD658\uAE30 \uD1B5\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643983
    m_Localized: "\uD558\uC5ED\uC7A5\xB7\uB0C9\uB3D9 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643984
    m_Localized: "\uC9C0\uD558 \uBCF4\uAD00\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1166621346643985
    m_Localized: "\uBC30\uAD00 \uAC24\uB7EC\uB9AC\xB7\uC57D\uD488 \uC800\uC7A5\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1172559659024384
    m_Localized: "\uAE09\uC2DD\uC774 \uBA3C\uC800 \uD138\uC744 \uC138\uC6CC \uC54C\uB824 \uC92C\uB2E4. \uB355\uBD84\uC5D0 \uB35C \uC783\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1172559717744640
    m_Localized: "\uC9C0\uCE5C \uBC24, \uAE09\uC2DD\uC774 \uBB34\uB98E\uC5D0 \uC62C\uB77C\uC640 \uC7A0\uB4E4\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1172559717744641
    m_Localized: "\uAE09\uC2DD\uC774 \uBA3C\uC800 \uD138\uC744 \uC138\uC6B0\uACE0 \uB0AE\uAC8C \uC6B8\uC5C8\uB2E4. \uB355\uBD84\uC5D0 \uD55C\uBC1C \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1172559717744642
    m_Localized: "\uBC24\uC774\uBA74 \uCC3D\uD2C0\uC5D0\uC11C \uBC14\uAE65\uC744 \uC9C0\uD0A8\uB2E4. \uC9C0\uCE5C \uB0A0\uC5D4 \uBB34\uB98E\uC5D0 \uC62C\uB77C\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1172559717744643
    m_Localized: "\uAE09\uC2DD\uC740 \uAD6C\uC870 \uD5EC\uAE30\uC5D0 \uAC00\uBC29\uC9F8 \uC2E4\uB824 \uC654\uB2E4. \uB300\uD53C\uC18C\uC5D0\uC11C\uB3C4 \uBC25\uB54C\uB97C \uC54C\uB9AC\uB294 \uAC74 \uB298 \uAE09\uC2DD\uC774 \uBA3C\uC800\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1172559717744644
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB0B4 \uACC1\uC5D0 \uC788\uC5C8\uB358 \uAC74 \uAE09\uC2DD\uC774\uC5C8\uB2E4. \uB300\uD53C\uC18C \uCE68\uC0C1 \uB044\uD2B8\uBA38\uB9AC, \uAE09\uC2DD\uC774 \uBAB8\uC744 \uB9CC \uC790\uB9AC\uB9CC\uD07C\uC740 \uB298 \uB530\uB73B\uD588\uB2E4. \uD63C\uC790\uAC00 \uC544\uB2C8\uC5C8\uB2E4\uB294 \uAC78, \uB098\uB294 \uADF8 \uBB34\uAC8C\uB85C \uAE30\uC5B5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1176257965604864
    m_Localized: "\uB3D9\uC544\uB9AC\xB7\uBC29\uC1A1\xB7\uC18C\uD48D(\uC218\uD559\uC5EC\uD589)\uC740 \uD55C \uC8FC\uC5D0 \uD55C \uBC88\uC529\uB9CC \uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325120
    m_Localized: "{0} \uB3D9\uC544\uB9AC \uC2DC\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325121
    m_Localized: "{0} \uC88B\uC544\uD558\uB294 \uD65C\uB3D9\uC774\uB77C \uC2E0\uC774 \uB0AC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325122
    m_Localized: "{0} \uB530\uB85C \uD560 \uC774\uC57C\uAE30\uAC00 \uC788\uB294 \uB208\uCE58\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325123
    m_Localized: "\uD55C \uD310 \uB354!"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325124
    m_Localized: "\u266A"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325125
    m_Localized: "\uD558\uB098, \uB458!"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325126
    m_Localized: "\uC5EC\uAE30 \uBD10 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325127
    m_Localized: "\uC774\uBC88 \uC8FC \uB3D9\uC544\uB9AC \uAC19\uC774 \uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325128
    m_Localized: "\uC774\uBC88 \uC8FC \uB3D9\uC544\uB9AC\uB294 \uC774 \uC0AC\uB78C\uACFC \u2713"
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325129
    m_Localized: "\uBCF4\uB4DC\uAC8C\uC784\uC744 \uC88B\uC544\uD558\uB294 \uB208\uCE58\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325130
    m_Localized: "\uB178\uB798\uD560 \uB54C \uD45C\uC815\uC774 \uD480\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325131
    m_Localized: "\uBAB8\uC744 \uC6C0\uC9C1\uC774\uBA74 \uAE30\uBD84\uC774 \uB098\uC544\uC9C0\uB294 \uC0AC\uB78C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1176258024325132
    m_Localized: "\uB204\uAD6C\uC5D0\uAC8C \uBB58 \uAC00\uB974\uCE60 \uB54C \uC2E0\uC774 \uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1205895400013824
    m_Localized: "\uBC29\uC1A1 \uB108\uBA38\uC5D0\uC11C \uB204\uAD70\uAC00 \uB300\uB2F5\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1205895450345472
    m_Localized: "\uBC29\uC1A1\uC774 \uBA40\uB9AC \uD37C\uC84C\uB2E4. \uC774\uBC88 \uC8FC \uBC24\uC740 \uC870\uAE08 \uB354 \uC870\uC2EC\uD574\uC57C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1205895450345473
    m_Localized: "\uD559\uAD50 \uBC29\uC1A1\uC744 \uB4E3\uACE0 \uC815 \uBC18\uC7A5\uC774 \uBB34\uC804\uC744 \uAC78\uC5B4\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1205895450345474
    m_Localized: "\uD559\uAD50\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uC6B0\uB9AC \uBC29\uC1A1\uC744 \uB0B4\uBCF4\uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1205895450345475
    m_Localized: "\uBC29\uC1A1\uC73C\uB85C CD \uD55C \uACE1\uC744 \uD2C0\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1205895450345476
    m_Localized: "\uBC29\uC1A1\uC73C\uB85C \uC0DD\uC874 \uC815\uBCF4\uB97C \uB098\uB234\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1205895450345477
    m_Localized: "DJ\uAC00 \uBCF4\uB0B8 \uC0AC\uC5F0\uC744 \uBC29\uC1A1\uC73C\uB85C \uC77D\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1210402246770688
    m_Localized: "\uC804\uB825 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1210402246770689
    m_Localized: "\uBC30\uD130\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1214015329288192
    m_Localized: "\uC7A5\uB9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202752
    m_Localized: "\uD3ED\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202753
    m_Localized: "\uAE4A\uC740 \uACF3 \uB9E8 \uC544\uB798\uCE35\uC774 \uBB3C\uC5D0 \uC7A0\uAE34\uB2E4 \xB7 \uC7A0\uAE34 \uD0C8\uCD9C\uAD6C\uAC00 \uC5F4\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202754
    m_Localized: "1\uCE35 \uAE4A\uC740 \uBB38\uACFC 1\uCE35 \uBCF4\uC870 \uD0C8\uCD9C\uAD6C\uAC00 \uB208\uC5D0 \uB9C9\uD78C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202755
    m_Localized: "\uC7A5\uB9C8 \u2014 \uAE4A\uC740 \uACF3 \uB9E8 \uC544\uB798\uCE35\uC774 \uBB3C\uC5D0 \uC7A0\uACBC\uB2E4. \uAC78\uC74C\uC774 \uB290\uB824\uC9C0\uACE0 \uBB3C\uC18C\uB9AC\uAC00 \uD06C\uB2E4. \uADF8 \uCE35 \uBE44\uC0C1\uAD6C\uB294 \uBB3C\uC5D0 \uB9C9\uD614\uC9C0\uB9CC, \uD3C9\uC18C \uC7A0\uAE34 \uD0C8\uCD9C\uAD6C\uAC00 \uBB3C\uC5D0 \uBC00\uB824 \uC5F4\uB824 \uC788\uC744\uC9C0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202756
    m_Localized: "\uD3ED\uC124 \u2014 1\uCE35 \uAE4A\uC740 \uBB38\uACFC 1\uCE35 \uCABD\uBB38\uC774 \uB208\uC5D0 \uD30C\uBB3B\uD614\uB2E4. \uAE4A\uC740 \uACF3\uC740 2\uCE35\uC758 \uB2E4\uB978 \uBB38\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202757
    m_Localized: "\uC7A5\uB9C8\uCCA0\uC774\uB2E4. \uC544\uB798\uCE35\uC5D0\uC11C \uBB3C \uD750\uB974\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202758
    m_Localized: "\uB208\uC774 \uBB34\uB98E\uAE4C\uC9C0 \uC313\uC600\uB2E4. 1\uCE35 \uBB38 \uBA87 \uAC1C\uB294 \uC4F8 \uC218 \uC5C6\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1214015392202759
    m_Localized: "\uBB3C\uC774 \uBB34\uB98E\uAE4C\uC9C0 \uCC28 \uC788\uB2E4. \uAC78\uC74C\uB9C8\uB2E4 \uCCA8\uBC99\uC778\uB2E4."
