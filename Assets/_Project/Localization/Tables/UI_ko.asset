      m_Items: []
  - m_Id: 1483188936654863
    m_Localized: "\uBC1B\uB294 \uD53C\uD574 \u2212{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 1483188936654864
    m_Localized: "\uBC29\uC5B4\uAD6C\uB294 \uCD9C\uC815 \uC900\uBE44\uC5D0\uC11C \uC785\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1483188936654865
    m_Localized: "\uADC0\uD658\uD558\uBA74 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1483188936654866
    m_Localized: "\uB204\uAD70\uAC00 \uC88B\uC544\uD560 \uAC83 \uAC19\uB2E4. \uB3D9\uB8CC\uC5D0\uAC8C \uC120\uBB3C\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1483188936654867
    m_Localized: "{0}\xD7{1}\uCE78 \xB7 {2}kg"
    m_Metadata:
      m_Items: []
  - m_Id: 1483188936654868
    m_Localized: "\uADC0\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 1484859511160832
    m_Localized: "\uBC29\uC5B4\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409852575744
    m_Localized: "\uC544\uC9C1 \uB530\uB85C \uCC59\uACA8 \uC904 \uC0AC\uB78C\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490304
    m_Localized: "\uC774\uBC88 \uC8FC \uC2DD\uB2E8 \xB7 {0}\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490305
    m_Localized: "\uC2DD\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490306
    m_Localized: "\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490307
    m_Localized: '{0} ({1})'
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490308
    m_Localized: "\uC774\uBC88 \uC8FC {0}\uAC1C \uD544\uC694 \xB7 \uCC3D\uACE0 {1}\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490309
    m_Localized: "\uC544\uCE68\uB9C8\uB2E4 \uD55C \uC0AC\uB78C \uD3EC\uB9CC +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490310
    m_Localized: "\uC544\uCE68\uB9C8\uB2E4 \uD55C \uC0AC\uB78C \uC218\uBD84 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490311
    m_Localized: "\uAD04\uD638\uB294 \uD55C \uC0AC\uB78C \uD558\uB8E8 \uC18C\uBE44. \uC544\uCE68\uB9C8\uB2E4 \uB2E4 \uAC19\uC774 \uBA39\uB294\uB2E4 (\uC2DD\uB7C9 1 = \uD3EC\uB9CC +{0}, \uBB3C 1 = \uC218\uBD84 +{1}), \uBC24\uC774 \uB418\uAE30 \uC804 \uD3EC\uB9CC\xB7\uC218\uBD84 \u2212{2}. \uBAA8\uC790\uB77C \uC2DD\uB2E8\uC744 \uBABB \uC9C0\uD0A8 \uB0A0\uC740 \uBAA8\uB450 \uC2A4\uD2B8\uB808\uC2A4 +{3}~{4}. \uD5C8\uAE30\xB7\uAC08\uC99D\uB9CC\uD07C \uCD5C\uB300 \uCCB4\uB825\xB7\uC2A4\uD0DC\uBBF8\uB108\uAC00 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490312
    m_Localized: "\uC544\uAEF4 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490313
    m_Localized: "\uCC59\uACA8 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1572409915490314
    m_Localized: "\uC798 \uBA39\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1576148999094272
    m_Localized: "(\uACA8\uC6B8 \xD7{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1591389845733376
    m_Localized: "\uC8FC\uBA38\uB2C8 (Tab)"
    m_Metadata:
      m_Items: []
  - m_Id: 1591389996728320
    m_Localized: "\uC8FC\uBA38\uB2C8\uC5D0 \uC790\uB9AC\uAC00 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1591389996728321
    m_Localized: "Tab\uC73C\uB85C \uC8FC\uBA38\uB2C8\uB97C \uC5F0\uB2E4. \uAC00\uBC29\uC774 \uC5C6\uC5B4 \uCE78\uC774 \uC801\uACE0, \uBB34\uAC8C\uB3C4 \uD55C\uC815\uB418\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1825728261013504
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uAD00\uB9AC\uC2E4 \uAE08\uACE0\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733760
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733761
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uC5ED\uBB34 \uC124\uBE44\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733762
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uBE44\uC0C1 \uB300\uD53C \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733763
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uB300\uD615 \uB0C9\uB3D9 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733764
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uBC18\uD488 \uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733765
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uC99D\uAC70\uBB3C \uBCF4\uAD00\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733766
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uC784\uC2DC \uBCF4\uD638\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733767
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uC57D\uD488 \uC800\uC7A5\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733768
    m_Localized: "\uC9C0\uD558 {1}\uCE35 \uD38C\uD504\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733769
    m_Localized: "\uBB34\uAC70\uC6B4 \uCCA0\uBB38\uC774\uB2E4. \uAE38\uAC8C \uBC00\uC5B4\uC57C \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733770
    m_Localized: "\uBC16\uC5D0\uC11C \uBE57\uC7A5\uC774 \uAC78\uB824 \uC788\uB2E4. \uAE38\uAC8C \uB20C\uB7EC \uD480\uC5B4\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733771
    m_Localized: "\uCCA0\uBB38\uC774 \uCFF5 \uD558\uACE0 \uC5F4\uB838\uB2E4. \uC18C\uB9AC\uAC00 \uBCF5\uB3C4\uB97C \uB530\uB77C \uC6B8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733772
    m_Localized: "\uBE57\uC7A5\uC744 \uD480\uC5C8\uB2E4. \uB204\uAC00, \uC65C \uC774 \uBB38\uC744 \uBC16\uC5D0\uC11C \uAC78\uC5B4 \uC7A0\uAC14\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733773
    m_Localized: "\uC6B0\uD074\uB9AD \uAE38\uAC8C: {0} \uD070 \uCCA0\uBB38\uC744 \uBC00\uC5B4 \uC5F0\uB2E4 (\uC18C\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733774
    m_Localized: "\uC6B0\uD074\uB9AD \uAE38\uAC8C: {0} \uD070 \uCCA0\uBB38\uC744 \uC1E0\uC9C0\uB81B\uB300\uB85C \uBE44\uD2C0\uC5B4 \uC5F0\uB2E4 (\uC18C\uC74C, \uBE60\uB974\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1825728319733775
    m_Localized: "\uC6B0\uD074\uB9AD \uAE38\uAC8C: {0} \uBE57\uC7A5\uC744 \uD47C\uB2E4 (\uC870\uC6A9\uD788)"
    m_Metadata:
      m_Items: []
  - m_Id: 1847793265426432
    m_Localized: "\uC81C\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970495729664
    m_Localized: "\uC81C\uC791 \uC911\uC778 \uCE78\uC774\uC5D0\uC694. \uC55E\uC758 \uCC29\uC218 \uCE78\uC744 \uBE44\uC6B0\uBA74 \uD480\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838528
    m_Localized: "\uC774 \uC81C\uC791\uC740 \uB4A4 \uCE78\uAE4C\uC9C0 \uC774\uC5B4\uC838\uC694. \uC8FC \uB05D\uC744 \uB118\uAC70\uB098 \uC7A0\uAE34 \uCE78\uACFC \uACB9\uCCD0\uC11C \uB193\uC744 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838529
    m_Localized: "\uC8FC\uC6B4 \uC7A1\uB3D9\uC0AC\uB2C8\uB85C \uB2E4\uC74C \uD0D0\uD5D8 \uC7A5\uBE44\uB97C \uB9CC\uB4E0\uB2E4. \uAD50\uC2E4\uC744 \uC5F4\uC218\uB85D \uB9CC\uB4E4 \uC218 \uC788\uB294 \uAC83\uC774 \uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838530
    m_Localized: "2\uCE78 \xB7 \uB2E4\uC74C \uCE78\uAE4C\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838531
    m_Localized: "3\uCE78 \xB7 \uB450 \uCE78 \uB354"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838532
    m_Localized: "\uB2E4\uC74C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838533
    m_Localized: "{0} \uC788\uC5B4\uC57C \uD574\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838534
    m_Localized: "\uCC3D\uACE0\uC5D0 \uC774\uBBF8 {0}\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838535
    m_Localized: "\uC190\uC9C8\uD560 \uB2F3\uC740 \uBB34\uAE30\uAC00 \uC5C6\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838536
    m_Localized: "{0} \uB9CC\uB4E4\uAE30 \uC2DC\uC791 \u2014 {1}\uCE78 \uB0A8\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838537
    m_Localized: "{0} \uB9CC\uB4DC\uB294 \uC911 \u2014 {1}\uCE78 \uB0A8\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838538
    m_Localized: "{0} \uC644\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838539
    m_Localized: "{0} \uC644\uC131 \u2014 \uC798 \uB9CC\uB4E4\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838540
    m_Localized: "{0} \uB9CC\uB4E4\uAE30 \uC2E4\uD328 \u2014 \uC7AC\uB8CC \uC77C\uBD80\uB97C \uAC74\uC84C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838541
    m_Localized: "\uC7AC\uB8CC\uAC00 \uBAA8\uC790\uB77C {0} \uB9CC\uB4E4\uAE30\uB97C \uC2DC\uC791\uD558\uC9C0 \uBABB\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838542
    m_Localized: "{0} \uC190\uC9C8\uC744 \uB9C8\uCCE4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838543
    m_Localized: "{0} \uB9CC\uB4E4\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838544
    m_Localized: "{0} \uC798 \uB9CC\uB4E4\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1866970562838545
    m_Localized: "{0} \uB9CC\uB4E4\uAE30\uC5D0 \uC2E4\uD328\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1891594700865536
    m_Localized: "\uCC3D\uACE0 \uD55C\uCABD\uC5D0 \uC791\uC5C5\uB300\uB97C \uB193\uC558\uB2E4 \u2014 \uC774\uC81C \uBB54\uAC00 \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1891594856054784
    m_Localized: "\uCC3D\uACE0 \uD55C\uCABD\uC5D0 \uC791\uC5C5\uB300\uB97C \uB193\uC558\uB2E4. \uC774\uC81C \uBB54\uAC00\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1901595708375040
    m_Localized: "\uB3C4\uAD6C 2"
    m_Metadata:
      m_Items: []
  - m_Id: 1901595783872512
    m_Localized: "\uB3C4\uAD6C 1"
    m_Metadata:
      m_Items: []
  - m_Id: 1901595783872513
    m_Localized: "\uB3C4\uAD6C 2"
    m_Metadata:
      m_Items: []
  - m_Id: 2000877404831744
    m_Localized: "\uC791\uC5C5\uB300\uC5D0 \uBC14\uC774\uC2A4\uC640 \uACF5\uAD6C\uD310\uC744 \uB2EC\uC558\uB2E4 \u2014 \uC774\uC81C \uB354 \uB2E8\uB2E8\uD55C \uAC83\uB3C4 \uB9CC\uB4E4 \uC218 \uC788\uACA0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2000877476134912
    m_Localized: "\uC791\uC5C5\uB300\uC5D0 \uBC14\uC774\uC2A4\uC640 \uACF5\uAD6C\uD310\uC744 \uB2EC\uC558\uB2E4. \uC774\uC81C \uB354 \uB2E8\uB2E8\uD55C \uAC83\uB3C4 \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2000877476134913
    m_Localized: "\uBD80\uD488\uC744 \uBAA8\uC544 \uC190\uC804\uB4F1 \uD558\uB098\uB97C \uC0B4\uB824 \uB0C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2000877476134914
    m_Localized: "\uCEF4\uD4E8\uD130\uC2E4\uC5D0\uC11C \uBD80\uD488\uC744 \uBAA8\uC544 \uC190\uC804\uB4F1 \uD558\uB098\uB97C \uC0B4\uB824 \uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2000877476134915
    m_Localized: "\uBA40\uB9AC \uBE44\uCDA4"
    m_Metadata:
      m_Items: []
  - m_Id: 2004154531987456
    m_Localized: "\uD398\uD2B8\uBCD1\uC5D0 \uBAA8\uB798\uC640 \uC22F\uC744 \uCC44\uC6CC \uD544\uD130\uB97C \uC138\uC6E0\uB2E4 \u2014 \uBE57\uBB3C\uC744 \uC870\uAE08\uC529 \uAC78\uB7EC \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484928
    m_Localized: "\uD398\uD2B8\uBCD1\uC5D0 \uBAA8\uB798\uC640 \uC22F\uC744 \uCC44\uC6CC \uD544\uD130\uB97C \uC138\uC6E0\uB2E4. \uBE57\uBB3C\uC744 \uC870\uAE08\uC529 \uAC78\uB7EC \uC904 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484929
    m_Localized: "\uAC00\uC0AC\uC2E4\uC5D0 \uB053\uC784 \uC815\uC218\uB300\uB97C \uAFB8\uB838\uB2E4 \u2014 \uC5F0\uB8CC\uAC00 \uC788\uC73C\uBA74 \uD55C \uBC88\uC5D0 \uB354 \uB9CE\uC774 \uAC70\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484930
    m_Localized: "\uAC00\uC0AC\uC2E4\uC5D0 \uB053\uC784 \uC815\uC218\uB300\uB97C \uAFB8\uB838\uB2E4. \uC5F0\uB8CC\uB9CC \uC788\uC73C\uBA74 \uD55C \uBC88\uC5D0 \uB354 \uB9CE\uC740 \uBB3C\uC744 \uAC70\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484931
    m_Localized: "\uACFC\uD559\uC2E4\uC758 \uC790\uB3D9 \uC815\uC218\uAE30\uAC00 \uB3CC\uAE30 \uC2DC\uC791\uD588\uB2E4 \u2014 \uC804\uAE30\uAC00 \uC788\uC73C\uBA74 \uC544\uCE68\uB9C8\uB2E4 \uBE57\uBB3C\uC744 \uAC70\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484932
    m_Localized: "\uACFC\uD559\uC2E4\uC758 \uC790\uB3D9 \uC815\uC218\uAE30\uAC00 \uC6C5\uC6C5 \uB3CC\uAE30 \uC2DC\uC791\uD588\uB2E4. \uC804\uAE30\uB9CC \uC788\uC73C\uBA74 \uC544\uCE68\uB9C8\uB2E4 \uBE57\uBB3C\uC744 \uAC78\uB7EC \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484933
    m_Localized: "\uC815\uC218\uAE30\uAC00 \uBC24\uC0C8 \uBE57\uBB3C\uC744 \uAC78\uB800\uB2E4 (\uC2DD\uC218 +{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2004154607484934
    m_Localized: "\uC804\uAE30\uAC00 \uB04A\uACA8 \uC815\uC218\uAE30\uAC00 \uBA48\uCDC4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798292746240
    m_Localized: "\uAD50\uBB38 \uD5C8\uC218\uC544\uBE44\uAC00 \uBB34\uB9AC \uC77C\uBD80\uB97C \uBD99\uC7A1\uC544 \uB450\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049408
    m_Localized: "\uAD50\uBB38 \uD5C8\uC218\uC544\uBE44\uAC00 \uBB34\uB9AC\uC5D0 \uBC00\uB824 \uC4F0\uB7EC\uC84C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049409
    m_Localized: "\uAD50\uBB38 \uC55E\uC5D0 \uD5C8\uC218\uC544\uBE44\uB97C \uC138\uC6E0\uB2E4 \u2014 \uBC24\uC5D0 \uBAB0\uB824\uC624\uB294 \uBB34\uB9AC \uC77C\uBD80\uB97C \uBD99\uC7A1\uC544 \uB458 \uAC83\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049410
    m_Localized: "\uB9C8\uB300\uC640 \uBE57\uC790\uB8E8, \uC591\uB3D9\uC774\uB85C \uAD50\uBB38 \uC55E\uC5D0 \uD5C8\uC218\uC544\uBE44\uB97C \uC138\uC6E0\uB2E4. \uBC24\uC5D0 \uBAB0\uB824\uC624\uB294 \uBB34\uB9AC \uC77C\uBD80\uB294 \uC800\uAE30\uC5D0 \uBD99\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049411
    m_Localized: "\uAD50\uBB38 \uD5C8\uC218\uC544\uBE44\uC5D0 \uC790\uBA85\uC885\uC744 \uB2EC\uC558\uB2E4 \u2014 \uAE61\uD1B5 \uACBD\uBCF4\uC640 \uD568\uAED8 \uC6B8\uB824 \uB354 \uB9CE\uC774 \uBD99\uC7A1\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049412
    m_Localized: "\uAD50\uBB38 \uD5C8\uC218\uC544\uBE44\uC5D0 \uC790\uBA85\uC885\uC744 \uB2EC\uC558\uB2E4. \uAE61\uD1B5 \uACBD\uBCF4\uC640 \uD568\uAED8 \uC6B8\uB824 \uBB34\uB9AC\uB97C \uB354 \uC624\uB798 \uBD99\uC7A1\uC544 \uB458 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049413
    m_Localized: "\uBAB0\uB824\uB4E0 \uBB34\uB9AC \uC77C\uBD80\uAC00 \uAD50\uBB38 \uC55E \uD5C8\uC218\uC544\uBE44\uC5D0 \uBD99\uC5C8\uB2E4. (\uC2B5\uACA9 \uC138\uAE30 \u2212{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049414
    m_Localized: "\uAD50\uBB38 \uD5C8\uC218\uC544\uBE44\uAC00 \uC4F0\uB7EC\uC84C\uB2E4. \uB2E4\uC2DC \uC138\uC6B8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798364049415
    m_Localized: "\uCC59\uAE38 \uAC83 \u2014 \uBC30\uB0AD {0}/{1}\uCE78"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243712
    m_Localized: "\uB204\uB974\uBA74 \uD558\uB098 \uCC59\uAE30\uACE0, \uC6B0\uD074\uB9AD\uD558\uBA74 \uD558\uB098 \uBE80\uB2E4. \uC4F0\uAC70\uB098 \uBC84\uB9B0 \uAC83\uB9CC \uCC3D\uACE0\uC5D0\uC11C \uBE60\uC9C0\uACE0, \uC4F0\uB7EC\uC9C0\uBA74 \uBAA8\uB450 \uC783\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243713
    m_Localized: "\uC138\uC6B0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243714
    m_Localized: "\uC138\uC6B0\uBA74 {0}\uCD08 \uB3D9\uC548 \uB2EC\uADF8\uB77D\uAC70\uB824 \uAC10\uC5FC\uC790\uB97C \uB048\uB2E4 \xB7 \uC0AC\uB78C\uC740 \uC18D\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243715
    m_Localized: "\uC138\uC6B0\uACE0 {1}\uCD08 \uB4A4 \uC6B8\uB824 {0}\uCD08 \uB3D9\uC548 \uAC10\uC5FC\uC790\uB97C \uB048\uB2E4 \xB7 \uC0AC\uB78C\uC740 \uC18D\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243716
    m_Localized: "\uB0AE\uC5D0 \uC18C\uB9AC\uB97C \uB0B4\uBA74 \uC7A0\uB4E0 \uBB34\uB9AC\uAE4C\uC9C0 \uAE68\uC6B8 \uC218 \uC788\uB2E4. \uADF8\uB798\uB3C4 \uC138\uC6B0\uB824\uBA74 \uD55C \uBC88 \uB354."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243717
    m_Localized: "\uD5C8\uC218\uC544\uBE44\uB97C \uC138\uC6E0\uB2E4. \uBE48 \uAE61\uD1B5\uC774 \uB2EC\uADF8\uB77D\uAC70\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243718
    m_Localized: "\uD5C8\uC218\uC544\uBE44\uB97C \uC138\uC6E0\uB2E4. \uACE7 \uC790\uBA85\uC885\uC774 \uC6B8\uB9B4 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2010798368243719
    m_Localized: "\uD5C8\uC218\uC544\uBE44\uAC00 \uB118\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2016874186686464
    m_Localized: "\uC124\uACC4\uB3C4 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2016874257989632
    m_Localized: "\uC124\uACC4\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 2016874257989633
    m_Localized: "\uC904\uB9C8\uB2E4 \uC55E \uB2E8\uACC4\uB97C \uB9CC\uB4E4\uBA74 \uB2E4\uC74C \uB2E8\uACC4\uAC00 \uC5F4\uB9B0\uB2E4. \uC5F4\uB9B0 \uCE78\uC744 \uB204\uB974\uBA74 \uADF8 \uCE74\uB4DC\uB97C \uACE0\uB978\uB2E4. (Esc \uB2EB\uAE30)"
