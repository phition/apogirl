    m_Metadata:
      m_Items: []
  - m_Id: 1727283350
    m_Localized: "\uB2E4\uC74C \uD0D0\uD5D8: \uC131\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 12156153380864
    m_Localized: "\uBB34\uC0AC\uD788 \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12156220489728
    m_Localized: "\uD574\uAC00 \uC9C4 \uB4A4\uC5D0\uC57C \uAE68\uC5B4\uB09C \uB188\uB4E4 \uC0AC\uC774\uB97C \uBE60\uC838\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12156220489729
    m_Localized: "\uC4F0\uB7EC\uC84C\uB2E4. \uBC30\uB0AD\uC744 \uC783\uACE0 \uAC00\uAE4C\uC2A4\uB85C \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12156220489730
    m_Localized: "\uAC00\uC838\uC628 \uBB3C\uAC74: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 12156220489731
    m_Localized: "\uD0D0\uD5D8 \uBC29\uC2DD \uC804\uD658 (\uC2E4\uC2DC\uAC04/\uC790\uB3D9)"
    m_Metadata:
      m_Items: []
  - m_Id: 12156220489732
    m_Localized: "\uBC30\uB0AD (Tab)"
    m_Metadata:
      m_Items: []
  - m_Id: 12156220489733
    m_Localized: "A/D \uC774\uB3D9 \xB7 Shift \uB2EC\uB9AC\uAE30 \xB7 Ctrl \uC6C5\uD06C\uB9AC\uAE30 \xB7 E \uC0C1\uD638\uC791\uC6A9 (\uC218\uC0C9\uC740 \uAE38\uAC8C) \xB7 \uBB38 \uC55E W \uC0B4\uD53C\uAE30 \xB7 S \uB4E3\uAE30 \xB7 Space \uC228\uAE30(\uAE38\uAC8C) \xB7 Q \uACF5\uACA9/\uBC00\uCE58\uAE30 \xB7 1~4 \uD035\uC2AC\uB86F \xB7 F \uC190\uC804\uB4F1 \xB7 Tab \uBC30\uB0AD"
    m_Metadata:
