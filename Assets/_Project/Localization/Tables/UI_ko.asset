  - m_Id: 1300070002868238
    m_Localized: "\uCE78: \uC785\uB825 \uB4A4 Enter \xB7 \uB9C8\uC6B0\uC2A4 \uD720 \xB11\uB2E8\uACC4 \xB7 Shift+\uD720 \xB110\uB2E8\uACC4 \xB7 \uB178\uB780 \uCE78 = \uBC14\uB010 \uAC12"
    m_Metadata:
      m_Items: []
  - m_Id: 1300070002868239
    m_Localized: "\uC9C0\uAE08 \uD310 \uB09C\uC774\uB3C4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120335618048
    m_Localized: "\uC800\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115520
    m_Localized: "\uC218\uCE58\uB294 balance_overrides.json, \uD0D0\uD5D8 \uC218\uD655\uC740 \uCF58\uD150\uCE20 JSON\uC5D0 \uC4F0\uACE0 \uC5D0\uC14B\uC744 \uB2E4\uC2DC \uB9CC\uB4E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115521
    m_Localized: "\uC800\uC7A5\uC740 \uC5D0\uB514\uD130\uC5D0\uC11C\uB9CC \uB41C\uB2E4. \uBE4C\uB4DC\uC5D0\uC11C\uB294 \uB0B4\uBCF4\uB0B4\uAE30\uB97C \uC4F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115522
    m_Localized: "\uAE30\uBCF8\uAC12\uC73C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115523
    m_Localized: "\uB36E\uC5B4\uC4F0\uAE30 \uD30C\uC77C\uC744 \uBE44\uC6B0\uACE0 \uC218\uCE58\uB97C BalanceConfig.cs \uAE30\uBCF8\uAC12\uC73C\uB85C (\uD0D0\uD5D8 \uC218\uD655 JSON\uC740 \uADF8\uB300\uB85C)"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115524
    m_Localized: "\uD55C \uBC88 \uB354 \uB204\uB974\uBA74 \uB36E\uC5B4\uC4F0\uAE30 \uD30C\uC77C\uC744 \uBE44\uC6B0\uACE0 \uC218\uCE58\uB97C \uCF54\uB4DC \uAE30\uBCF8\uAC12\uC73C\uB85C \uB418\uB3CC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115525
    m_Localized: "\uB36E\uC5B4\uC4F0\uAE30 \uD30C\uC77C\uC744 \uBE44\uC6E0\uACE0 \uC218\uCE58\uB97C \uCF54\uB4DC \uAE30\uBCF8\uAC12\uC73C\uB85C \uB418\uB3CC\uB838\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115526
    m_Localized: "\uB0B4\uBCF4\uB0B4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115527
    m_Localized: "\uBC14\uB010 \uAC12\uC744 persistentDataPath/BalanceLab/\uC5D0 \uD30C\uC77C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115528
    m_Localized: "\uC800\uC7A5\uD588\uC2B5\uB2C8\uB2E4: \uB36E\uC5B4\uC4F0\uAE30 \uC218\uCE58 {0}\uAC1C \xB7 \uD0D0\uD5D8 \uBAA8\uB378 {1}\uACF3"
    m_Metadata:
      m_Items: []
  - m_Id: 1303120411115529
    m_Localized: "\uB0B4\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4: \uC218\uCE58 {0}\uAC1C \xB7 \uD0D0\uD5D8 \uBAA8\uB378 {1}\uACF3 \u2192 {2}"
    m_Metadata:
      m_Items: []
