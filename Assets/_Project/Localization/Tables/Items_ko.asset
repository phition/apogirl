      m_Items: []
  - m_Id: 409775610544139
    m_Localized: "\uBC1C\uC804\uAE30 \uC5F0\uB8CC\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 409775610544140
    m_Localized: "\uBB34\uC804\uAE30 \uBD80\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 409775610544141
    m_Localized: "\uBC1B\uC544 \uB454 \uBB3C(\uC815\uC218 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260748054528
    m_Localized: "\uBB38\uACE0\uBCF8 \uC18C\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969088
    m_Localized: "\uBE68\uAC04 \uBCFC\uD39C"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969089
    m_Localized: "\uBBF9\uC2A4\uCEE4\uD53C"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969090
    m_Localized: "\uD578\uB4DC\uD06C\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969091
    m_Localized: "\uB9CC\uD654\uCC45"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969092
    m_Localized: "\uC774\uC628\uC74C\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969093
    m_Localized: "\uC778\uD615 \uD0A4\uB9C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969094
    m_Localized: "\uC2A4\uD2F0\uCEE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969095
    m_Localized: "\uBA38\uB9AC\uB048\xB7\uD540"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969096
    m_Localized: "\uB9BD\uBC24"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969097
    m_Localized: "\uAE30\uD0C0 \uC545\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969098
    m_Localized: "\uAE30\uD0C0 \uC904"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969099
    m_Localized: "\uB0A1\uC740 \uC9C0\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969100
    m_Localized: "\uC0AC\uD0D5"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969101
    m_Localized: "\uCC38\uCE58\uCE94"
    m_Metadata:
      m_Items: []
  - m_Id: 1051260810969102
    m_Localized: "\uACE0\uC591\uC774 \uAC04\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 1471032707006464
    m_Localized: "\uC190\uB54C \uBB3B\uC740 \uBB38\uACE0\uBCF8. \uB204\uAD70\uAC00 \uBC24\uC0C8 \uC77D\uB358 \uD754\uC801\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032778309632
    m_Localized: "\uCC44\uC810\uD560 \uB54C \uC4F0\uB358 \uBE68\uAC04 \uBCFC\uD39C. \uC544\uC9C1 \uC789\uD06C\uAC00 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503936
    m_Localized: "\uB178\uB780 \uBD09\uC9C0 \uBBF9\uC2A4\uCEE4\uD53C. \uC9C0\uCE5C \uC5B4\uB978\uC774 \uBC18\uAE38 \uB9DB."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503937
    m_Localized: "\uD2BC \uC190\uC5D0 \uBC14\uB974\uB294 \uC791\uC740 \uD29C\uBE0C."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503938
    m_Localized: "\uBAA8\uC11C\uB9AC\uAC00 \uB2F3\uC740 \uB9CC\uD654\uCC45. \uBA87 \uAD8C\uC9F8\uC778\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503939
    m_Localized: "\uC6B4\uB3D9\uD558\uACE0 \uB098\uC11C \uB9C8\uC2DC\uB358 \uC774\uC628\uC74C\uB8CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503940
    m_Localized: "\uAC00\uBC29\uC5D0 \uB2EC\uB824 \uC788\uB358 \uC791\uC740 \uC778\uD615 \uD0A4\uB9C1."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503941
    m_Localized: "\uBC18\uC9DD\uC774\uB294 \uC2A4\uD2F0\uCEE4 \uD55C \uC7A5. \uC4F8\uBAA8\uB294 \uC5C6\uC9C0\uB9CC \uC608\uC058\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503942
    m_Localized: "\uBA38\uB9AC\uB048\uACFC \uC2E4\uD540 \uBA87 \uAC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503943
    m_Localized: "\uAC08\uB77C\uC9C4 \uC785\uC220\uC5D0 \uBC14\uB974\uB294 \uB9BD\uBC24."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503944
    m_Localized: "\uC5F0\uD544 \uBA54\uBAA8\uAC00 \uBE7C\uACE1\uD55C \uAE30\uD0C0 \uC545\uBCF4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503945
    m_Localized: "\uD3EC\uC7A5\uB3C4 \uC548 \uB72F\uC740 \uAE30\uD0C0 \uC904 \uD55C \uC138\uD2B8."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503946
    m_Localized: "\uB3D9\uB124 \uAE38\uC774 \uADF8\uB824\uC9C4 \uB0A1\uC740 \uC9C0\uB3C4. \uB204\uAD70\uAC00 \uD45C\uC2DC\uB97C \uD574 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503947
    m_Localized: "\uC54C\uB85D\uB2EC\uB85D\uD55C \uC0AC\uD0D5 \uBA87 \uC54C."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503948
    m_Localized: "\uAE30\uB984\uC5D0 \uC7A0\uAE34 \uCC38\uCE58\uCE94. \uACE0\uC591\uC774\uAC00 \uB0C4\uC0C8\uB97C \uB9E1\uC744\uC9C0\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503949
    m_Localized: "\uC9DC \uBA39\uC774\uB294 \uACE0\uC591\uC774 \uAC04\uC2DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503950
    m_Localized: "\uC0C1\uCC98\uB97C \uB2E6\uB294 \uC18C\uB3C5\uC57D \uD55C \uBCD1."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503951
    m_Localized: "\uBCF4\uAC74\uC2E4\uC5D0\uC11C \uB098\uC628 \uAC70\uC988\uC640 \uC19C."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503952
    m_Localized: "\uACFC\uD559\uC2E4 \uC18C\uB3C5\uC6A9 \uC5D0\uD0C4\uC62C."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503953
    m_Localized: "\uB77C\uBCA8\uC774 \uBC18\uCBE4 \uC9C0\uC6CC\uC9C4 \uC2E4\uD5D8\uC6A9 \uC57D\uD488. \uC4F8 \uB370\uAC00 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503954
    m_Localized: "\uACFC\uD559 \uC2DC\uAC04\uC5D0 \uC4F0\uB358 \uC54C\uCF54\uC62C\uB7A8\uD504. \uC5F0\uB8CC\uAC00 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503955
    m_Localized: "\uC74C\uC545\uC2E4\uC5D0\uC11C \uB098\uC628 \uC545\uAE30 \uC904. \uBB36\uB294 \uB370 \uC4F8 \uB9CC\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503956
    m_Localized: "\uBD80\uC11C\uC9C4 \uBCF4\uBA74\uB300\uC5D0\uC11C \uB5BC\uC5B4 \uB0B8 \uC1E0\uB9C9\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503957
    m_Localized: "\uC544\uC9C1 \uB72F\uC9C0 \uC54A\uC740 \uC300 \uBD09\uC9C0. \uAF64 \uBB35\uC9C1\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503958
    m_Localized: "\uD734\uB300\uC6A9 \uBC84\uB108\uC5D0 \uB07C\uC6B0\uB294 \uBD80\uD0C4\uAC00\uC2A4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503959
    m_Localized: "\uAC00\uC0AC\uC2E4 \uBC18\uC9C7\uACE0\uB9AC. \uBC14\uB298\uACFC \uC2E4\uC774 \uB4E4\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503960
    m_Localized: "\uAE30\uD310\uACFC \uBD80\uD488 \uBA87 \uAC1C. \uACE0\uCE60 \uB54C \uC4F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503961
    m_Localized: "\uB458\uB458 \uB9D0\uB9B0 \uC804\uC120 \uBB49\uCE58."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503962
    m_Localized: "\uBC1C\uC804\uAE30\uC5D0 \uB123\uC744 \uC5F0\uB8CC\uAC00 \uB4E0 \uD1B5. \uD754\uB4E4\uBA74 \uCD9C\uB801\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503963
    m_Localized: "\uBB34\uC804\uAE30\uC5D0\uC11C \uB5BC\uC5B4 \uB0B8 \uBD80\uD488\uACFC \uBC30\uD130\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503964
    m_Localized: "\uBC1B\uC544 \uB454 \uBB3C. \uADF8\uB0E5 \uB9C8\uC2DC\uBA74 \uD0C8\uC774 \uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503965
    m_Localized: "\uC624\uB798 \uB450\uC5B4\uB3C4 \uC0C1\uD558\uC9C0 \uC54A\uB294 \uD1B5\uC870\uB9BC."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503966
    m_Localized: "\uBC14\uC0AD\uD55C \uACFC\uC790 \uD55C \uBD09\uC9C0. \uBA39\uC73C\uBA74 \uAE30\uBD84\uC774 \uC870\uAE08 \uD480\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503967
    m_Localized: "\uB69C\uAED1\uC744 \uB530\uC9C0 \uC54A\uC740 \uC0DD\uC218."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503968
    m_Localized: "\uC0C1\uCC98\uB97C \uAC10\uB294 \uBD95\uB300. \uADF8 \uC790\uB9AC\uC5D0\uC11C \uD53C\uB97C \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503969
    m_Localized: "\uC9C4\uD1B5\uC81C \uBA87 \uC54C. \uD1B5\uC99D\uACFC \uAE34\uC7A5\uC774 \uD568\uAED8 \uAC00\uB77C\uC549\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503970
    m_Localized: "\uC4F8 \uB9CC\uD55C \uACE0\uCCA0\uACFC \uC790\uC7AC. \uD06C\uACE0 \uBB34\uAC81\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503971
    m_Localized: "\uC544\uC9C1 \uD798\uC774 \uB0A8\uC740 \uAC74\uC804\uC9C0. \uBAA8\uC544 \uB450\uBA74 \uC804\uB825\uC744 \uB298\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503972
    m_Localized: "\uAD50\uACFC\uC11C. \uACF5\uBD80\uD558\uAC70\uB098 \uC815\uBCF4\uB97C \uC5BB\uB294 \uB370 \uC4F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503973
    m_Localized: "\uB728\uAC70\uC6B4 \uBB3C\uB9CC \uC788\uC73C\uBA74 \uB418\uB294 \uCEF5\uB77C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503974
    m_Localized: "\uB2EC\uB2EC\uD55C \uC74C\uB8CC\uC218 \uD55C \uCE94."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503975
    m_Localized: "\uD544\uC694\uD55C \uAC83\uC774 \uB2E4 \uB4E0 \uAD6C\uAE09\uC0C1\uC790. \uADC0\uD55C \uBB3C\uAC74\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503976
    m_Localized: "\uAC10\uC5FC\uC744 \uB9C9\uB294 \uD56D\uC0DD\uC81C. \uD568\uBD80\uB85C \uC4F0\uAE30 \uC544\uAE5D\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503977
    m_Localized: "\uC601\uC591\uC81C \uD55C \uD1B5."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503978
    m_Localized: "\uBB34\uC5C7\uC774\uB4E0 \uBD99\uC774\uB294 \uB355\uD2B8 \uD14C\uC774\uD504."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503979
    m_Localized: "\uBD88\uC774 \uBD99\uB294 \uB77C\uC774\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503980
    m_Localized: "\uB9E4\uC77C \uBA54\uACE0 \uB2E4\uB2C8\uB358 \uCC45\uAC00\uBC29."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503981
    m_Localized: "\uCE78\uC774 \uB9CE\uC740 \uB4F1\uC0B0 \uBC30\uB0AD. \uD6E8\uC52C \uB9CE\uC774 \uB4E4\uC5B4\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503982
    m_Localized: "\uB9C8\uD2B8 \uC7A5\uBC14\uAD6C\uB2C8. \uC791\uC9C0\uB9CC \uC5C6\uB294 \uAC83\uBCF4\uB2E4 \uB0AB\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503983
    m_Localized: "\uCCAD\uC18C\uD568\uC758 \uB300\uAC78\uB808. \uCC14\uB7EC\uC11C \uBC00\uC5B4\uB0B8\uB2E4. \uAE08\uBC29 \uBD80\uB7EC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503984
    m_Localized: "\uBB35\uC9C1\uD55C \uC1E0\uD30C\uC774\uD504. \uC624\uB798 \uBC84\uD2F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503985
    m_Localized: "\uC54C\uB8E8\uBBF8\uB284 \uC57C\uAD6C\uBC29\uB9DD\uC774. \uC138\uAC8C \uD718\uB450\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503986
    m_Localized: "\uC5B4\uB450\uC6B4 \uACF3\uC744 \uBE44\uCD94\uB294 \uC190\uC804\uB4F1 (F)."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503987
    m_Localized: "\uC7A0\uAE34 \uBB38\uACFC \uC0C1\uC790\uB97C \uBE44\uC9D1\uC5B4 \uC5EC\uB294 \uC1E0\uC9C0\uB81B\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503988
    m_Localized: "\uCCB4\uC721 \uC2DC\uAC04\uC5D0 \uC4F0\uB358 \uBCF4\uD638\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503989
    m_Localized: "\uB450\uD23C\uD55C \uACA8\uC6B8 \uD328\uB529. \uBB3C\uB824\uB3C4 \uB35C \uB2E4\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503990
    m_Localized: "\uACBD\uCC30\uC774 \uB0A8\uAE30\uACE0 \uAC04 \uC9C4\uC555 \uC870\uB07C."
    m_Metadata:
      m_Items: []
  - m_Id: 1471032782503991
    m_Localized: "\uC811\uC5C8\uB2E4 \uD3B4\uB294 \uACBD\uCC30 \uC0BC\uB2E8\uBD09."
    m_Metadata:
      m_Items: []
  - m_Id: 1854814383521792
    m_Localized: "\uB048 \uC8FC\uBA38\uB2C8 \uAC00\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853440
    m_Localized: "\uCC9C \uC870\uAC01\uACFC \uB048\uC73C\uB85C \uAFF0\uB9E8 \uC791\uC740 \uAC00\uBC29. \uAC00\uBCCD\uACE0 \uC870\uC6A9\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853441
    m_Localized: "\uB367\uB304 \uBC30\uB0AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853442
    m_Localized: "\uCC45\uAC00\uBC29\uC5D0 \uCC9C\uC744 \uB367\uB300\uACE0 \uC8FC\uBA38\uB2C8\uB97C \uB298\uB9B0 \uBC30\uB0AD."
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853443
    m_Localized: "\uB098\uBB34 \uBABD\uB465\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853444
    m_Localized: "\uBD80\uC11C\uC9C4 \uCC45\uC0C1 \uB2E4\uB9AC\uB97C \uB2E4\uB4EC\uC740 \uBABD\uB465\uC774. \uAE08\uBC29 \uB2F3\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853445
    m_Localized: "\uD14C\uC774\uD504 \uAC10\uC740 \uBABD\uB465\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853446
    m_Localized: "\uBABD\uB465\uC774\uC5D0 \uD14C\uC774\uD504\uB97C \uB2E8\uB2E8\uD788 \uAC10\uC544 \uC190\uC7A1\uC774\uC640 \uBA38\uB9AC\uB97C \uBCF4\uAC15\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853447
    m_Localized: "\uC7A1\uC9C0 \uBCF4\uD638\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853448
    m_Localized: "\uB450\uAEBC\uC6B4 \uC7A1\uC9C0\uB97C \uD314\uACFC \uC815\uAC15\uC774\uC5D0 \uD14C\uC774\uD504\uB85C \uAC10\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853449
    m_Localized: "\uB9E4\uD2B8 \uB367\uB304 \uBCF4\uD638\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 1854814433853450
    m_Localized: "\uCCB4\uC721\uAD00 \uB9E4\uD2B8\uB97C \uC798\uB77C \uB367\uB304 \uBCF4\uD638\uAD6C. \uC870\uAE08 \uBB34\uAC81\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1988721292623872
    m_Localized: "\uD504\uB808\uC784 \uBC30\uB0AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344128
    m_Localized: "\uB367\uB304 \uBC30\uB0AD\uC5D0 \uC1E0 \uD2C0\uC744 \uB300\uC5B4 \uD06C\uAC8C \uB113\uD614\uB2E4. \uB9CE\uC774 \uB4E4\uC5B4\uAC00\uC9C0\uB9CC \uBB34\uAC81\uACE0 \uB35C\uCEF9\uAC70\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344129
    m_Localized: "\uCCA0\uADFC \uB367\uB304 \uBABD\uB465\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344130
    m_Localized: "\uBABD\uB465\uC774 \uBA38\uB9AC\uC5D0 \uCCA0\uADFC\uC744 \uAC10\uC544 \uBB36\uC5C8\uB2E4. \uD55C \uBC88\uC5D0 \uB118\uC5B4\uB728\uB9AC\uC9C0\uB9CC \uBB34\uAC81\uACE0 \uC2DC\uB044\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344131
    m_Localized: "\uCCA0\uD310 \uB367\uB304 \uC870\uB07C"
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344132
    m_Localized: "\uB9E4\uD2B8 \uBCF4\uD638\uAD6C \uC548\uC5D0 \uC587\uC740 \uCCA0\uD310\uC744 \uB367\uB314\uB2E4. \uC798 \uB9C9\uC544 \uC8FC\uC9C0\uB9CC \uBB34\uAC81\uACE0 \uAC78\uC744 \uB54C \uC18C\uB9AC\uAC00 \uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344133
    m_Localized: "\uD5E4\uB4DC\uB79C\uD134"
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344134
    m_Localized: "\uC190\uC804\uB4F1\uC744 \uBA38\uB9AC\uB760\uC5D0 \uACE0\uC815\uD588\uB2E4. \uB354 \uBA40\uB9AC \uBE44\uCD94\uACE0, \uBC1C\uCE58\uB97C \uBE44\uCDB0 \uB35C \uB208\uC5D0 \uB748\uB2E4 (F)."
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344135
    m_Localized: "\uB79C\uD134 \uBA40\uD2F0\uD234"
    m_Metadata:
      m_Items: []
  - m_Id: 1988721351344136
    m_Localized: "\uD5E4\uB4DC\uB79C\uD134\uACFC \uC1E0\uC9C0\uB81B\uB300\uB97C \uD558\uB098\uB85C \uBB36\uC5C8\uB2E4. \uB3C4\uAD6C \uCE78 \uD558\uB098\uB85C \uBE44\uCD94\uACE0 \uBE44\uC9D1\uC5B4 \uC5F0\uB2E4 (F)."
    m_Metadata:
      m_Items: []
  - m_Id: 1998642188926976
    m_Localized: "\uD734\uB300 \uD5C8\uC218\uC544\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 1998642243452928
    m_Localized: "\uB9C8\uB300\uC5D0 \uD5CC \uC637\uC744 \uCC44\uC6B0\uACE0 \uC591\uB3D9\uC774\uB97C \uC5B9\uC5C8\uB2E4. \uC138\uC6CC \uB450\uBA74 \uBE48 \uAE61\uD1B5\uC774 \uB2EC\uADF8\uB77D\uAC70\uB824 \uAC10\uC5FC\uC790\uB97C \uB048\uB2E4. \uC0AC\uB78C\uC740 \uC18D\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1998642243452929
    m_Localized: "\uC6B8\uB9AC\uB294 \uD5C8\uC218\uC544\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 1998642243452930
    m_Localized: "\uC790\uBA85\uC885\uC744 \uB2E8 \uD5C8\uC218\uC544\uBE44. \uC138\uC6B0\uACE0 \uC870\uAE08 \uB4A4\uC5D0 \uC6B8\uB824, \uB354 \uBA40\uB9AC\uC11C \uB354 \uC624\uB798 \uAC10\uC5FC\uC790\uB97C \uB048\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
